theorem qsqrt2_aut_sqrt_two {
    qsqrt2_aut(Real.0, Real.1) = qsqrt2(Real.0, -Real.1)
}

theorem qsqrt2_aut_fixes_real_part(a: Real) {
    qsqrt2_aut(a, Real.0) = qsqrt2(a, Real.0)
