theorem two_generated_ideal_subset_of_contains_generators[R: CommRing](
    a: R, b: R, contains: R -> Bool
) {
    is_ideal(contains) and contains(a) and contains(b)
        implies ideal_subset(two_generated_ideal[R](a, b), contains)
