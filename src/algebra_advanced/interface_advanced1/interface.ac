define spec_comap[R: CommRing, S: CommRing](f: RingHom[R, S], p: Spec[S]) -> Spec[R] {
    Spec[R].of_prime(prime_ideal_preimage(f, p.point))
}

theorem spec_comap_point[R: CommRing, S: CommRing](f: RingHom[R, S], p: Spec[S]) {
    spec_comap(f, p).point = prime_ideal_preimage(f, p.point)
}

theorem spec_comap_contains_eq[R: CommRing, S: CommRing](f: RingHom[R, S], p: Spec[S], x: R) {
    spec_comap(f, p).point.contains(x) = p.point.contains(f.hom(x))
}

theorem spec_comap_preimage_basic_open[R: CommRing, S: CommRing](f: RingHom[R, S], a: R) {
    set_preimage(spec_comap(f), Spec[R].basic_open(a)) = Spec[S].basic_open(f.hom(a))
}

theorem spec_comap_preimage_vanishing[R: CommRing, S: CommRing](f: RingHom[R, S], i: Ideal[R]) {
    set_preimage(spec_comap(f), Spec[R].vanishing(i)) =
        Spec[S].vanishing(ideal_image(f, i))
}

theorem spec_comap_preimage_zariski_closed[R: CommRing, S: CommRing](
    f: RingHom[R, S], c: Set[Spec[R]]
) {
    spec_zariski_closed(c) implies spec_zariski_closed(set_preimage(spec_comap(f), c))
}

theorem spec_comap_preimage_basic_open_zariski_open[R: CommRing, S: CommRing](
    f: RingHom[R, S], a: R
) {
    spec_zariski_open(set_preimage(spec_comap(f), Spec[R].basic_open(a)))
}

theorem spec_comap_preimage_zariski_open[R: CommRing, S: CommRing](
    f: RingHom[R, S], u: Set[Spec[R]]
) {
    spec_zariski_open(u) implies spec_zariski_open(set_preimage(spec_comap(f), u))
}

theorem spec_vanishing_indexed_sum[R: CommRing, I](family: I -> Ideal[R]) {
    Spec[R].vanishing(ideal_indexed_sum(family)) = indexed_intersection(spec_vanishing_family(family))
}

define spec_vanishing_compl_family[R: CommRing, I](family: I -> Ideal[R], i: I) -> Set[Spec[R]] {
    Spec[R].vanishing(family(i)).c
}

theorem spec_vanishing_indexed_sum_compl[R: CommRing, I](family: I -> Ideal[R]) {
    Spec[R].vanishing(ideal_indexed_sum(family)).c =
        indexed_union(spec_vanishing_compl_family(family))
}

theorem spec_zariski_open_indexed_union_vanishing_compl[R: CommRing, I](family: I -> Ideal[R]) {
    spec_zariski_open(indexed_union(spec_vanishing_compl_family(family)))
}

theorem spec_vanishing_union_subset_product[R: CommRing](i: Ideal[R], j: Ideal[R]) {
    Spec[R].vanishing(i).union(Spec[R].vanishing(j)).subset(
        Spec[R].vanishing(ideal_product(i, j)))
}

theorem spec_vanishing_product_subset_union[R: CommRing](i: Ideal[R], j: Ideal[R]) {
    Spec[R].vanishing(ideal_product(i, j)).subset(
        Spec[R].vanishing(i).union(Spec[R].vanishing(j)))
}

theorem spec_vanishing_product_eq_union[R: CommRing](i: Ideal[R], j: Ideal[R]) {
    Spec[R].vanishing(ideal_product(i, j)) =
        Spec[R].vanishing(i).union(Spec[R].vanishing(j))
}

theorem spec_vanishing_product_eq_intersection[R: CommRing](i: Ideal[R], j: Ideal[R]) {
    Spec[R].vanishing(ideal_product(i, j)) = Spec[R].vanishing(i.intersection(j))
}

theorem zmod_typeclass_add_eq(n: Nat, x: Zmod[n], y: Zmod[n]) {
    x + y = zmod_add(n, x, y)
}

theorem zmod_typeclass_zero_eq(n: Nat) {
    Zero.0[Zmod[n]] = zmod_zero(n)
}

theorem zmod_typeclass_neg_eq(n: Nat, x: Zmod[n]) {
    -x = zmod_neg(n, x)
}

theorem zmod_typeclass_mul_eq(n: Nat, x: Zmod[n], y: Zmod[n]) {
    x * y = zmod_mul(n, x, y)
}

theorem zmod_typeclass_one_eq(n: Nat) {
    One.1[Zmod[n]] = zmod_one(n)
}

theorem zmod_typeclass_add_mk(n: Nat, a: Int, b: Int) {
    zmod_mk(n, a) + zmod_mk(n, b) = zmod_mk(n, a + b)
}

theorem zmod_typeclass_neg_mk(n: Nat, a: Int) {
    -zmod_mk(n, a) = zmod_mk(n, -a)
}

theorem zmod_typeclass_mul_mk(n: Nat, a: Int, b: Int) {
    zmod_mk(n, a) * zmod_mk(n, b) = zmod_mk(n, a * b)
}

theorem zmod_typeclass_zero_mk(n: Nat) {
    Zero.0[Zmod[n]] = zmod_mk(n, Int.0)
}

theorem zmod_typeclass_one_mk(n: Nat) {
    One.1[Zmod[n]] = zmod_mk(n, Int.1)
}

theorem zmod_typeclass_add_associative(n: Nat, x: Zmod[n], y: Zmod[n], z: Zmod[n]) {
    Add.add(x, Add.add(y, z)) = Add.add(Add.add(x, y), z)
}

theorem zmod_typeclass_add_commutative(n: Nat, x: Zmod[n], y: Zmod[n]) {
    Add.add(x, y) = Add.add(y, x)
}

theorem zmod_typeclass_add_zero_left(n: Nat, x: Zmod[n]) {
    Add.add(Zero.0[Zmod[n]], x) = x
}

theorem zmod_typeclass_add_zero_right(n: Nat, x: Zmod[n]) {
    Add.add(x, Zero.0[Zmod[n]]) = x
}

theorem zmod_typeclass_add_neg_right(n: Nat, x: Zmod[n]) {
    Add.add(x, Neg.neg(x)) = Zero.0[Zmod[n]]
}

theorem zmod_typeclass_mul_associative(n: Nat, x: Zmod[n], y: Zmod[n], z: Zmod[n]) {
    Mul.mul(x, Mul.mul(y, z)) = Mul.mul(Mul.mul(x, y), z)
}

theorem zmod_typeclass_mul_commutative(n: Nat, x: Zmod[n], y: Zmod[n]) {
    Mul.mul(x, y) = Mul.mul(y, x)
}

theorem zmod_typeclass_mul_one_left(n: Nat, x: Zmod[n]) {
    Mul.mul(One.1[Zmod[n]], x) = x
}

theorem zmod_typeclass_mul_one_right(n: Nat, x: Zmod[n]) {
    Mul.mul(x, One.1[Zmod[n]]) = x
}

theorem zmod_typeclass_mul_add_left(n: Nat, x: Zmod[n], y: Zmod[n], z: Zmod[n]) {
    Mul.mul(x, Add.add(y, z)) = Add.add(Mul.mul(x, y), Mul.mul(x, z))
}

theorem zmod_typeclass_mul_add_right(n: Nat, x: Zmod[n], y: Zmod[n], z: Zmod[n]) {
    Mul.mul(Add.add(x, y), z) = Add.add(Mul.mul(x, z), Mul.mul(y, z))
}

theorem zmod_typeclass_mul_zero_right(n: Nat, x: Zmod[n]) {
    Mul.mul(x, Zero.0[Zmod[n]]) = Zero.0[Zmod[n]]
}

theorem zmod_typeclass_mul_zero_left(n: Nat, x: Zmod[n]) {
    Mul.mul(Zero.0[Zmod[n]], x) = Zero.0[Zmod[n]]
}

