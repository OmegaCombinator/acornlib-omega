theorem group_hom_comp_injective[G: Group, H: Group, K: Group](f: GroupHom[H, K], g: GroupHom[G, H]) {
    is_injective_fn(f.hom) and is_injective_fn(g.hom) implies is_injective_fn(compose_group_hom(f, g).hom)
