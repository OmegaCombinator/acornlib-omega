theorem predicate_pullback_eq_imp_eq_of_surjective[A, B](f: A -> B, p: B -> Bool, q: B -> Bool) {
    is_surjective_fn(f) and predicate_pullback(f, p) = predicate_pullback(f, q) implies p = q
