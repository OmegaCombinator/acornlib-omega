theorem relation_pushforward_union[A, B](f: A -> B, r: (A, A) -> Bool, s: (A, A) -> Bool) {
    relation_pushforward(f, relation_union(r, s)) =
    relation_union(relation_pushforward(f, r), relation_pushforward(f, s))
