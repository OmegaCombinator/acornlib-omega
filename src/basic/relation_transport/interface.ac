theorem predicate_pushforward_eq_imp_eq_of_injective[A, B](f: A -> B, p: A -> Bool, q: A -> Bool) {
    is_injective_fn(f) and predicate_pushforward(f, p) = predicate_pushforward(f, q) implies p = q
