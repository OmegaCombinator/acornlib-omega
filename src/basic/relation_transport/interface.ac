theorem compose_preserves_binary_op[A, B, C](
    f: B -> C,
    g: A -> B,
    op_a: (A, A) -> A,
    op_b: (B, B) -> B,
    op_c: (C, C) -> C
) {
    preserves_binary_op(f, op_b, op_c) and preserves_binary_op(g, op_a, op_b) implies
    preserves_binary_op(compose(f, g), op_a, op_c)
