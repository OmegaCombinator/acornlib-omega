theorem compose_preserves_unary_op[A, B, C](f: B -> C, g: A -> B, op_a: A -> A, op_b: B -> B, op_c: C -> C) {
    preserves_unary_op(f, op_b, op_c) and preserves_unary_op(g, op_a, op_b) implies
    preserves_unary_op(compose(f, g), op_a, op_c)
