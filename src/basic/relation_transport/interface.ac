theorem relation_pushforward_intersection_subset[A, B](f: A -> B, r: (A, A) -> Bool, s: (A, A) -> Bool) {
    relation_subset(
        relation_pushforward(f, relation_intersection(r, s)),
        relation_intersection(relation_pushforward(f, r), relation_pushforward(f, s))
