theorem relation_pullback_intersection[A, B](f: A -> B, r: (B, B) -> Bool, s: (B, B) -> Bool) {
    relation_pullback(f, relation_intersection(r, s)) =
    relation_intersection(relation_pullback(f, r), relation_pullback(f, s))
