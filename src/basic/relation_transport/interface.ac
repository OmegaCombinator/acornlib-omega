theorem predicate_pullback_eq_iff_of_bijection[A, B](f: A -> B, p: B -> Bool, q: B -> Bool) {
    is_bijection_fn(f) implies (predicate_pullback(f, p) = predicate_pullback(f, q)) = (p = q)
