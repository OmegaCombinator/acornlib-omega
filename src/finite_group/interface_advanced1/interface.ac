typeclass G: FiniteGroup extends Group {
    /// A list containing all elements of the group.
    elements: List[G]

    /// Every group element appears in the elements list.
    all_group_elements_in_elements(g: G) {
        G.elements.contains_every
    }
    /// The elements list contains no duplicates.
    unique_elements_list {
        G.elements.is_unique
    }
}

attributes G: FiniteGroup {
    /// The number of elements in the group.
    let order: Nat = G.elements.length
}

theorem subsemigroup_of_finite_group_is_finite[G: FiniteGroup](s: Subsemigroup[G]) {
    finite_constraint(s.contains)
}

theorem subsemigroup_as_set_is_finite[G: FiniteGroup](s: Subsemigroup[G]) {
    s.as_set.is_finite
}

theorem subsemigroup_as_set_cardinality_at_most_group_order[G: FiniteGroup](s: Subsemigroup[G]) {
    s.as_set.cardinality_at_most(G.order)
}

theorem subsemigroup_of_finite_group_is_finitely_generated[G: FiniteGroup](s: Subsemigroup[G]) {
    subsemigroup_is_finitely_generated(s)
}

theorem submonoid_of_finite_group_is_finite[G: FiniteGroup](s: Submonoid[G]) {
    finite_constraint(s.contains)
}

theorem submonoid_as_set_is_finite[G: FiniteGroup](s: Submonoid[G]) {
    s.as_set.is_finite
}

theorem submonoid_as_set_cardinality_at_most_group_order[G: FiniteGroup](s: Submonoid[G]) {
    s.as_set.cardinality_at_most(G.order)
}

theorem submonoid_of_finite_group_is_finitely_generated[G: FiniteGroup](s: Submonoid[G]) {
    submonoid_is_finitely_generated(s)
}

theorem subgroup_of_finite_group_is_finite[G: FiniteGroup](s: Subgroup[G]) {
    finite_constraint(s.contains)
}

theorem subgroup_as_set_is_finite[G: FiniteGroup](s: Subgroup[G]) {
    s.as_set.is_finite
}

theorem subgroup_as_set_cardinality_at_most_group_order[G: FiniteGroup](s: Subgroup[G]) {
    s.as_set.cardinality_at_most(G.order)
}

theorem subgroup_of_finite_group_is_finitely_generated[G: FiniteGroup](s: Subgroup[G]) {
    subgroup_is_finitely_generated(s)
}

structure FiniteSubgroup[G: FiniteGroup] {
    /// A list containing all elements of the subgroup.
    elements: List[G]
} constraint {
    elements.is_unique and subgroup_constraint(elements.contains)
}

let finite_subgroup_as_subgroup[G: FiniteGroup](s: FiniteSubgroup[G]) -> result: Subgroup[G] satisfy {
    Subgroup.new(s.elements.contains) = Option.some(result)
}

attributes FiniteSubgroup[G: FiniteGroup] {
    /// The number of elements in the subgroup.
    define order(self) -> Nat {
        self.elements.length
    }

    /// The subgroup determined by the elements of this finite subgroup.
    let as_subgroup: FiniteSubgroup[G] -> Subgroup[G] = finite_subgroup_as_subgroup

    /// Membership predicate.
    define contains(self, x: G) -> Bool {
        self.as_subgroup.contains(x)
    }

    /// The subset of group elements belonging to this finite subgroup.
    define as_set(self) -> Set[G] {
        self.as_subgroup.as_set
    }
}

theorem finite_subgroup_as_subgroup_contains_eq[G: FiniteGroup](s: FiniteSubgroup[G], x: G) {
    s.as_subgroup.contains(x) = s.elements.contains(x)
}

theorem finite_subgroup_contains_as_subgroup_eq[G: FiniteGroup](s: FiniteSubgroup[G], x: G) {
    s.contains(x) = s.as_subgroup.contains(x)
}

theorem finite_subgroup_contains_eq[G: FiniteGroup](s: FiniteSubgroup[G], x: G) {
    s.contains(x) = s.elements.contains(x)
}

theorem finite_subgroup_elements_contains_as_subgroup_eq[G: FiniteGroup](s: FiniteSubgroup[G], x: G) {
    s.elements.contains(x) = s.as_subgroup.contains(x)
}

theorem finite_subgroup_as_set_contains_eq[G: FiniteGroup](s: FiniteSubgroup[G], x: G) {
    s.as_set.contains(x) = s.elements.contains(x)
}

theorem finite_subgroup_as_set_contains_finite_subgroup_eq[G: FiniteGroup](s: FiniteSubgroup[G], x: G) {
    s.as_set.contains(x) = s.contains(x)
}

theorem finite_subgroup_elements_contains_as_set_eq[G: FiniteGroup](s: FiniteSubgroup[G], x: G) {
    s.elements.contains(x) = s.as_set.contains(x)
}

theorem finite_subgroup_as_set_eq_list_set[G: FiniteGroup](s: FiniteSubgroup[G]) {
    s.as_set = list_set(s.elements)
}

theorem finite_subgroup_as_set_is_finite[G: FiniteGroup](s: FiniteSubgroup[G]) {
    s.as_set.is_finite
}

let finite_subgroup_as_finite_set[G: FiniteGroup](s: FiniteSubgroup[G]) -> result: FiniteSet[G] satisfy {
    FiniteSet.new(s.as_set) = Option.some(result)
}

theorem finite_subgroup_as_finite_set_as_set[G: FiniteGroup](s: FiniteSubgroup[G]) {
    finite_subgroup_as_finite_set(s).as_set = s.as_set
}

theorem finite_subgroup_as_finite_set_contains_eq[G: FiniteGroup](s: FiniteSubgroup[G], x: G) {
    finite_subgroup_as_finite_set(s).contains(x) = s.elements.contains(x)
}

attributes FiniteSubgroup[G: FiniteGroup] {
    /// The finite set of elements of this finite subgroup.
    let as_finite_set: FiniteSubgroup[G] -> FiniteSet[G] = finite_subgroup_as_finite_set
}

theorem identity_list_is_unique[G: FiniteGroup] {
    List.singleton[G](G.1).is_unique
}

theorem identity_meets_identity_constraint[G: FiniteGroup] {
    identity_constraint(List.singleton[G](G.1).contains)
}

theorem identity_meets_closure_constraint[G: FiniteGroup] {
    closure_constraint(List.singleton[G](G.1).contains)
}

theorem identity_meets_inverse_constraint[G: FiniteGroup] {
    inverse_constraint(List.singleton[G](G.1).contains)
}

theorem identity_meets_subgroup_constraint[G: FiniteGroup] {
    subgroup_constraint(List.singleton[G](G.1).contains)
}

theorem identity_meets_fs_constraint[G: FiniteGroup] {
    FiniteSubgroup.constraint(List.singleton[G](G.1))
}

let isg[G: FiniteGroup]: FiniteSubgroup[G] satisfy {
    FiniteSubgroup.new(List.singleton[G](G.1)) = Option.some(isg)
}

theorem subgroup_has_order_at_most_G_order[G: FiniteGroup](s: FiniteSubgroup[G]) {
    s.order <= G.order
}

theorem finite_subgroup_as_set_cardinality_is_order[G: FiniteGroup](s: FiniteSubgroup[G]) {
    s.as_set.cardinality_is(s.order)
}

theorem finite_subgroup_as_finite_set_cardinality_is_order[G: FiniteGroup](s: FiniteSubgroup[G]) {
    s.as_finite_set.cardinality_is(s.order)
}

theorem finite_subgroup_order_eq_cardinality[G: FiniteGroup](s: FiniteSubgroup[G], n: Nat) {
    s.as_finite_set.cardinality_is(n) implies n = s.order
}

theorem finite_subgroup_as_set_cardinality_at_most_group_order[G: FiniteGroup](s: FiniteSubgroup[G]) {
    s.as_set.cardinality_at_most(G.order)
}

theorem finite_subgroup_order_pos[G: FiniteGroup](s: FiniteSubgroup[G]) {
    s.order > Nat.0
}

theorem all_elements_have_order_at_most_G[G: FiniteGroup](g: G) {
    exists (n: Nat) {
        n > 0 and n <= G.order and g.pow(n) = G.1
    }
}

theorem all_elements_have_finite_order[G: FiniteGroup](g: G) {
    has_finite_order(g)
}

theorem pow_mod_order[G: Group](g: G, m: Nat, k: Nat) {
    m > 0 and g.pow(m) = G.1 implies g.pow(k.mod(m)) = g.pow(k)
}

theorem inverse_is_power[G: Group](g: G, m: Nat) {
    m > 0 and g.pow(m) = G.1 implies g.inverse = g.pow(m - 1)
}

theorem cyclic_powers_contains[G: FiniteGroup](g: G, k: Nat) {
    map(G.order.range, g.pow).unique.contains(g.pow(k))
}

theorem cyclic_subgroup_constraint[G: FiniteGroup](g: G) {
    FiniteSubgroup.constraint(map(G.order.range, g.pow).unique)
}

let cyclic_subgroup_of[G: FiniteGroup](g: G) -> result: FiniteSubgroup[G] satisfy {
    FiniteSubgroup.new(map(G.order.range, g.pow).unique) = Option.some(result)
}

theorem cyclic_subgroup_elements_eq[G: FiniteGroup](g: G) {
    cyclic_subgroup_of(g).elements = map(G.order.range, g.pow).unique
}

theorem cyclic_subgroup_order_pos[G: FiniteGroup](g: G) {
    cyclic_subgroup_of(g).order > Nat.0
}

theorem cyclic_subgroup_contains_power[G: FiniteGroup](g: G, k: Nat) {
    cyclic_subgroup_of(g).contains(g.pow(k))
}

theorem cyclic_subgroup_order_le_of_contains_generator[G: FiniteGroup](g: G, s: FiniteSubgroup[G]) {
    s.contains(g) implies cyclic_subgroup_of(g).order <= s.order
}

theorem cyclic_subgroup_order_le_period[G: FiniteGroup](g: G, m: Nat) {
    m > Nat.0 and g.pow(m) = G.1 implies cyclic_subgroup_of(g).order <= m
}

theorem no_positive_period_below_cyclic_subgroup_order[G: FiniteGroup](g: G, k: Nat) {
    k > Nat.0 and k < cyclic_subgroup_of(g).order implies g.pow(k) != G.1
}

theorem pow_cyclic_subgroup_order_eq_identity[G: FiniteGroup](g: G) {
    g.pow(cyclic_subgroup_of(g).order) = G.1
}

theorem pow_mod_cyclic_subgroup_order[G: FiniteGroup](g: G, k: Nat) {
    g.pow(k.mod(cyclic_subgroup_of(g).order)) = g.pow(k)
}

theorem inverse_eq_power_cyclic_subgroup_order_pred[G: FiniteGroup](g: G) {
    g.inverse = g.pow(cyclic_subgroup_of(g).order - Nat.1)
}

theorem pow_add_cyclic_subgroup_order[G: FiniteGroup](g: G, k: Nat) {
    g.pow(k + cyclic_subgroup_of(g).order) = g.pow(k)
}

theorem cyclic_subgroup_as_set_contains_power[G: FiniteGroup](g: G, k: Nat) {
    cyclic_subgroup_of(g).as_set.contains(g.pow(k))
}

theorem cyclic_subgroup_as_finite_set_contains_power[G: FiniteGroup](g: G, k: Nat) {
    cyclic_subgroup_of(g).as_finite_set.contains(g.pow(k))
}

theorem cyclic_subgroup_contains_generator[G: FiniteGroup](g: G) {
    cyclic_subgroup_of(g).contains(g)
}

theorem cyclic_subgroup_as_set_contains_generator[G: FiniteGroup](g: G) {
    cyclic_subgroup_of(g).as_set.contains(g)
}

theorem cyclic_subgroup_as_finite_set_contains_generator[G: FiniteGroup](g: G) {
    cyclic_subgroup_of(g).as_finite_set.contains(g)
}

theorem cyclic_subgroup_as_subgroup_is_finitely_generated[G: FiniteGroup](g: G) {
    subgroup_is_finitely_generated(cyclic_subgroup_of(g).as_subgroup)
}

attributes G: FiniteGroup {
    /// The trivial subgroup containing only the identity element.
    let identity_subgroup: FiniteSubgroup[G] = isg[G]

    /// The cyclic subgroup generated by this element.
    // TODO: prove this actually is the subgroup you'd expect, not a degenerate case.
    define cyclic_subgroup(self) -> FiniteSubgroup[G] {
        cyclic_subgroup_of(self)
    }
}

theorem filter_preserves_unique[T](list: List[T], f: T -> Bool) {
    list.is_unique implies list.filter(f).is_unique
}

let finite_stabilizer[G: FiniteGroup, X](a: MulAction[G, X], x: X) -> result: FiniteSubgroup[G] satisfy {
    FiniteSubgroup.new(G.elements.filter(stabilizer(a, x).contains)) = Option.some(result)
}

theorem finite_stabilizer_contains_eq[G: FiniteGroup, X](
    a: MulAction[G, X],
    x: X,
    g: G
) {
    finite_stabilizer(a, x).contains(g) = stabilizer(a, x).contains(g)
}

theorem finite_stabilizer_fixes_eq[G: FiniteGroup, X](
    a: MulAction[G, X],
    x: X,
    g: G
) {
    finite_stabilizer(a, x).contains(g) = (a.act(g, x) = x)
}

theorem finite_stabilizer_as_set_cardinality_is_order[G: FiniteGroup, X](
    a: MulAction[G, X],
    x: X
) {
    finite_stabilizer(a, x).as_set.cardinality_is(finite_stabilizer(a, x).order)
}

theorem orbit_action_eq_iff_finite_stabilizer_left_coset[G: FiniteGroup, X](
    a: MulAction[G, X],
    x: X,
    g: G,
    k: G
) {
    (a.act(g, x) = a.act(k, x)) = finite_stabilizer(a, x).contains(g.inverse * k)
}

define finite_orbit_list[G: FiniteGroup, X](a: MulAction[G, X], x: X) -> List[X] {
    map[G, X](G.elements, function(g: G) { a.act(g, x) }).unique
}

theorem finite_orbit_list_set_eq_orbit[G: FiniteGroup, X](a: MulAction[G, X], x: X) {
    list_set(finite_orbit_list(a, x)) = orbit(a, x)
}

theorem finite_orbit_cardinality_is_length[G: FiniteGroup, X](a: MulAction[G, X], x: X) {
    orbit(a, x).cardinality_is(finite_orbit_list(a, x).length)
}

theorem same_left_coset_contains_symmetric[G: Group](s: Subgroup[G], a: G, b: G) {
    s.contains(a.inverse * b) implies s.contains(b.inverse * a)
}

theorem same_left_coset_contains_transitive[G: Group](s: Subgroup[G], a: G, b: G, c: G) {
    s.contains(a.inverse * b) and s.contains(b.inverse * c) implies s.contains(a.inverse * c)
}

theorem same_left_coset_contains_membership_eq[G: Group](s: Subgroup[G], a: G, b: G, y: G) {
    s.contains(a.inverse * b) implies s.contains(a.inverse * y) = s.contains(b.inverse * y)
}

define finite_left_coset_contains[G: FiniteGroup](s: FiniteSubgroup[G], a: G, y: G) -> Bool {
    s.contains(a.inverse * y)
}

define finite_left_coset_set[G: FiniteGroup](s: FiniteSubgroup[G], a: G) -> Set[G] {
    Set[G].new(finite_left_coset_contains(s, a))
}

theorem finite_left_coset_set_contains_eq[G: FiniteGroup](s: FiniteSubgroup[G], a: G, y: G) {
    finite_left_coset_set(s, a).contains(y) = s.contains(a.inverse * y)
}

theorem finite_left_coset_set_contains_representative[G: FiniteGroup](s: FiniteSubgroup[G], a: G) {
    finite_left_coset_set(s, a).contains(a)
}

theorem finite_left_coset_set_eq_of_contains_quotient[G: FiniteGroup](s: FiniteSubgroup[G], a: G, b: G) {
    s.contains(a.inverse * b) implies finite_left_coset_set(s, a) = finite_left_coset_set(s, b)
}

theorem finite_left_coset_set_eq_implies_contains_quotient[G: FiniteGroup](s: FiniteSubgroup[G], a: G, b: G) {
    finite_left_coset_set(s, a) = finite_left_coset_set(s, b) implies s.contains(a.inverse * b)
}

theorem finite_left_coset_set_eq_iff_contains_quotient[G: FiniteGroup](s: FiniteSubgroup[G], a: G, b: G) {
    (finite_left_coset_set(s, a) = finite_left_coset_set(s, b)) = s.contains(a.inverse * b)
}

define finite_left_coset_representatives[G: FiniteGroup](s: FiniteSubgroup[G]) -> List[Set[G]] {
    map[G, Set[G]](G.elements, function(a: G) { finite_left_coset_set(s, a) }).unique
}

theorem finite_left_coset_representatives_contains_coset[G: FiniteGroup](s: FiniteSubgroup[G], a: G) {
    finite_left_coset_representatives(s).contains(finite_left_coset_set(s, a))
}

theorem finite_orbit_action_eq_iff_finite_stabilizer_left_coset_set_eq[G: FiniteGroup, X](
    a: MulAction[G, X],
    x: X,
    g: G,
    k: G
) {
    (a.act(g, x) = a.act(k, x)) =
        (finite_left_coset_set(finite_stabilizer(a, x), g) = finite_left_coset_set(finite_stabilizer(a, x), k))
}

theorem finite_subgroup_left_mul_image_cardinality_is_order[G: FiniteGroup](s: FiniteSubgroup[G], a: G) {
    set_image[G, G](s.as_set, function(h: G) { a * h }).cardinality_is(s.order)
}

theorem finite_left_coset_set_cardinality_is_order[G: FiniteGroup](s: FiniteSubgroup[G], a: G) {
    finite_left_coset_set(s, a).cardinality_is(s.order)
}

theorem finite_left_cosets_equal_or_disjoint[G: FiniteGroup](s: FiniteSubgroup[G], a: G, b: G) {
    finite_left_coset_set(s, a) = finite_left_coset_set(s, b) or
    finite_left_coset_set(s, a).is_disjoint(finite_left_coset_set(s, b))
}

theorem finite_left_coset_representatives_is_unique[G: FiniteGroup](s: FiniteSubgroup[G]) {
    finite_left_coset_representatives(s).is_unique
}

theorem finite_left_coset_representative_cardinality_is_order[G: FiniteGroup](s: FiniteSubgroup[G], c: Set[G]) {
    finite_left_coset_representatives(s).contains(c) implies c.cardinality_is(s.order)
}

theorem finite_left_coset_representatives_union_covers_universal[G: FiniteGroup](s: FiniteSubgroup[G]) {
    set_list_union[G](finite_left_coset_representatives(s)) = Set[G].universal_set
}

theorem finite_group_universal_set_cardinality_is_order[G: FiniteGroup] {
    Set[G].universal_set.cardinality_is(G.order)
}

theorem finite_left_coset_representatives_all_cardinality_is_order[G: FiniteGroup](s: FiniteSubgroup[G]) {
    set_list_all_cardinality_is[G](finite_left_coset_representatives(s), s.order)
}

theorem finite_left_coset_representatives_pairwise_disjoint[G: FiniteGroup](s: FiniteSubgroup[G]) {
    set_list_pairwise_disjoint[G](finite_left_coset_representatives(s))
}

theorem finite_left_coset_representatives_union_cardinality[G: FiniteGroup](s: FiniteSubgroup[G]) {
    set_list_union[G](finite_left_coset_representatives(s)).cardinality_is(
        s.order * finite_left_coset_representatives(s).length)
}

theorem finite_left_coset_representatives_order_product_eq_group_order[G: FiniteGroup](s: FiniteSubgroup[G]) {
    s.order * finite_left_coset_representatives(s).length = G.order
}

theorem finite_subgroup_order_divides_group_order_witness[G: FiniteGroup](s: FiniteSubgroup[G]) {
    exists(k: Nat) { s.order * k = G.order }
}

theorem finite_subgroup_order_divides_group_order[G: FiniteGroup](s: FiniteSubgroup[G]) {
    s.order.divides(G.order)
}

theorem finite_cyclic_subgroup_order_divides_group_order[G: FiniteGroup](g: G) {
    cyclic_subgroup_of(g).order.divides(G.order)
}

define action_is_add_hom[G: Group, M: AddCommGroup](act: (G, M) -> M) -> Bool {
    forall(g: G) {
        is_add_group_hom(function(x: M) { act(g, x) })
    }
}

define is_add_representation[G: Group, M: AddCommGroup](act: (G, M) -> M) -> Bool {
    is_mul_action(act) and action_is_add_hom(act)
}

structure AddRepresentation[G: Group, M: AddCommGroup] {
    /// The action map.
    act: (G, M) -> M
} constraint {
    is_add_representation(act)
}

let add_rep_mul_action[G: Group, M: AddCommGroup](r: AddRepresentation[G, M]) -> result: MulAction[G, M] satisfy {
    MulAction[G, M].new(r.act) = Option.some(result)
}

theorem add_rep_mul_action_act[G: Group, M: AddCommGroup](r: AddRepresentation[G, M]) {
    add_rep_mul_action(r).act = r.act
}

theorem add_rep_one[G: Group, M: AddCommGroup](r: AddRepresentation[G, M], x: M) {
    r.act(G.1, x) = x
}

theorem add_rep_mul[G: Group, M: AddCommGroup](r: AddRepresentation[G, M], g: G, h: G, x: M) {
    r.act(g * h, x) = r.act(g, r.act(h, x))
}

theorem add_rep_act_is_add_hom[G: Group, M: AddCommGroup](r: AddRepresentation[G, M], g: G) {
    is_add_group_hom(function(x: M) { r.act(g, x) })
}

theorem add_rep_act_add[G: Group, M: AddCommGroup](r: AddRepresentation[G, M], g: G, x: M, y: M) {
    r.act(g, x + y) = r.act(g, x) + r.act(g, y)
}

theorem add_rep_act_zero[G: Group, M: AddCommGroup](r: AddRepresentation[G, M], g: G) {
    r.act(g, M.0) = M.0
}

theorem add_rep_act_neg[G: Group, M: AddCommGroup](r: AddRepresentation[G, M], g: G, x: M) {
    r.act(g, -x) = -r.act(g, x)
}

theorem add_rep_inv_apply_apply[G: Group, M: AddCommGroup](r: AddRepresentation[G, M], g: G, x: M) {
    r.act(g.inverse, r.act(g, x)) = x
}

theorem add_rep_apply_inv_apply[G: Group, M: AddCommGroup](r: AddRepresentation[G, M], g: G, x: M) {
    r.act(g, r.act(g.inverse, x)) = x
}

define add_rep_action_map[G: Group, M: AddCommGroup](r: AddRepresentation[G, M], g: G, x: M) -> M {
    r.act(g, x)
}

theorem add_rep_action_map_apply[G: Group, M: AddCommGroup](r: AddRepresentation[G, M], g: G, x: M) {
    add_rep_action_map(r, g, x) = r.act(g, x)
}

theorem add_rep_action_map_one[G: Group, M: AddCommGroup](r: AddRepresentation[G, M]) {
    add_rep_action_map(r, G.1) = identity_fn[M]
}

theorem add_rep_action_map_mul[G: Group, M: AddCommGroup](r: AddRepresentation[G, M], g: G, h: G) {
    add_rep_action_map(r, g * h) = compose(add_rep_action_map(r, g), add_rep_action_map(r, h))
}

theorem add_rep_action_map_inverse_apply_apply[G: Group, M: AddCommGroup](
    r: AddRepresentation[G, M], g: G, x: M
) {
    add_rep_action_map(r, g.inverse, add_rep_action_map(r, g, x)) = x
}

theorem add_rep_action_map_apply_inverse_apply[G: Group, M: AddCommGroup](
    r: AddRepresentation[G, M], g: G, x: M
) {
    add_rep_action_map(r, g, add_rep_action_map(r, g.inverse, x)) = x
}

theorem add_rep_action_map_is_injective[G: Group, M: AddCommGroup](r: AddRepresentation[G, M], g: G) {
    is_injective_fn(add_rep_action_map(r, g))
}

theorem add_rep_action_map_is_surjective[G: Group, M: AddCommGroup](r: AddRepresentation[G, M], g: G) {
    is_surjective_fn(add_rep_action_map(r, g))
}

theorem add_rep_action_map_is_bijection[G: Group, M: AddCommGroup](r: AddRepresentation[G, M], g: G) {
    is_bijection_fn(add_rep_action_map(r, g))
}

let add_rep_action_hom[G: Group, M: AddCommGroup](r: AddRepresentation[G, M], g: G) -> result: AddGroupHom[M, M] satisfy {
    AddGroupHom.new(add_rep_action_map(r, g)) = Option.some(result)
}

theorem add_rep_action_hom_hom[G: Group, M: AddCommGroup](r: AddRepresentation[G, M], g: G) {
    add_rep_action_hom(r, g).hom = add_rep_action_map(r, g)
}

theorem add_rep_action_hom_apply[G: Group, M: AddCommGroup](
    r: AddRepresentation[G, M], g: G, x: M
) {
    add_rep_action_hom(r, g).hom(x) = r.act(g, x)
}

theorem add_rep_ext[G: Group, M: AddCommGroup](
    r: AddRepresentation[G, M],
    s: AddRepresentation[G, M]
) {
    (forall(g: G, x: M) { r.act(g, x) = s.act(g, x) }) implies r = s
}

let trivial_add_action[G: Group, M: AddCommGroup]: (G, M) -> M = function(g: G, x: M) {
    x
}

theorem trivial_add_action_is_mul_action[G: Group, M: AddCommGroup] {
    is_mul_action(trivial_add_action[G, M])
}

theorem trivial_add_action_is_add_hom[G: Group, M: AddCommGroup] {
    action_is_add_hom(trivial_add_action[G, M])
}

theorem trivial_add_action_is_add_representation[G: Group, M: AddCommGroup] {
    is_add_representation(trivial_add_action[G, M])
}

let trivial_add_representation[G: Group, M: AddCommGroup]: AddRepresentation[G, M] satisfy {
    AddRepresentation[G, M].new(trivial_add_action[G, M]) = Option.some(trivial_add_representation)
}

theorem trivial_add_representation_act[G: Group, M: AddCommGroup](g: G, x: M) {
    trivial_add_representation[G, M].act(g, x) = x
}

define is_invariant_subset[G: Group, M: AddCommGroup](r: AddRepresentation[G, M], s: Set[M]) -> Bool {
    forall(g: G, x: M) {
        s.contains(x) implies s.contains(r.act(g, x))
    }
}

theorem universal_set_is_invariant_subset[G: Group, M: AddCommGroup](r: AddRepresentation[G, M]) {
    is_invariant_subset(r, Set[M].universal_set)
}

define add_rep_acts_trivially[G: Group, M: AddCommGroup](r: AddRepresentation[G, M], g: G) -> Bool {
    forall(x: M) {
        r.act(g, x) = x
    }
}

theorem add_rep_one_acts_trivially[G: Group, M: AddCommGroup](r: AddRepresentation[G, M]) {
    add_rep_acts_trivially(r, G.1)
}

define is_faithful_add_representation[G: Group, M: AddCommGroup](r: AddRepresentation[G, M]) -> Bool {
    forall(g: G) {
        add_rep_acts_trivially(r, g) implies g = G.1
    }
}

define is_module_linear_add_representation[G: Group, R: Ring, M: AddCommGroup](
    rep: AddRepresentation[G, M],
    m: Module[R, M]
) -> Bool {
    forall(g: G, c: R, x: M) {
        rep.act(g, m.smul(c, x)) = m.smul(c, rep.act(g, x))
    }
}

theorem module_linear_add_rep_smul[G: Group, R: Ring, M: AddCommGroup](
    rep: AddRepresentation[G, M],
    m: Module[R, M],
    g: G,
    c: R,
    x: M
) {
    is_module_linear_add_representation(rep, m) implies
        rep.act(g, m.smul(c, x)) = m.smul(c, rep.act(g, x))
}

theorem module_linear_add_rep_smul_add[G: Group, R: Ring, M: AddCommGroup](
    rep: AddRepresentation[G, M],
    m: Module[R, M],
    g: G,
    c: R,
    x: M,
    y: M
) {
    is_module_linear_add_representation(rep, m) implies
        rep.act(g, m.smul(c, x + y)) = m.smul(c, rep.act(g, x)) + m.smul(c, rep.act(g, y))
}

theorem module_linear_add_rep_lin_comb[G: Group, R: Ring, M: AddCommGroup](
    rep: AddRepresentation[G, M],
    m: Module[R, M],
    g: G,
    c1: R,
    c2: R,
    x: M,
    y: M
) {
    is_module_linear_add_representation(rep, m) implies
        rep.act(g, m.smul(c1, x) + m.smul(c2, y))
            = m.smul(c1, rep.act(g, x)) + m.smul(c2, rep.act(g, y))
}

theorem module_linear_add_rep_smul_neg[G: Group, R: Ring, M: AddCommGroup](
    rep: AddRepresentation[G, M],
    m: Module[R, M],
    g: G,
    c: R,
    x: M
) {
    is_module_linear_add_representation(rep, m) implies
        rep.act(g, m.smul(-c, x)) = m.smul(-c, rep.act(g, x))
}

theorem module_linear_add_rep_smul_zero[G: Group, R: Ring, M: AddCommGroup](
    rep: AddRepresentation[G, M],
    m: Module[R, M],
    g: G,
    c: R
) {
    is_module_linear_add_representation(rep, m) implies
        rep.act(g, m.smul(c, M.0)) = m.smul(c, M.0)
}

structure RingModuleRepresentation[G: Group, R: Ring, M: AddCommGroup] {
    /// The underlying additive representation.
    rep: AddRepresentation[G, M]
    /// The compatible R-module structure.
    module: Module[R, M]
} constraint {
    is_module_linear_add_representation(rep, module)
}

theorem ring_module_rep_smul[G: Group, R: Ring, M: AddCommGroup](
    p: RingModuleRepresentation[G, R, M],
    g: G,
    c: R,
    x: M
) {
    p.rep.act(g, p.module.smul(c, x)) = p.module.smul(c, p.rep.act(g, x))
}

theorem ring_module_rep_lin_comb[G: Group, R: Ring, M: AddCommGroup](
    p: RingModuleRepresentation[G, R, M],
    g: G,
    c1: R,
    c2: R,
    x: M,
    y: M
) {
    p.rep.act(g, p.module.smul(c1, x) + p.module.smul(c2, y))
        = p.module.smul(c1, p.rep.act(g, x)) + p.module.smul(c2, p.rep.act(g, y))
}

theorem trivial_add_representation_is_module_linear[G: Group, R: Ring, M: AddCommGroup](
    m: Module[R, M]
) {
    is_module_linear_add_representation(trivial_add_representation[G, M], m)
}

theorem finite_orbit_list_length_eq_finite_stabilizer_cosets[G: FiniteGroup, X](
    a: MulAction[G, X],
    x: X
) {
    finite_orbit_list[G, X](a, x).length =
        finite_left_coset_representatives[G](finite_stabilizer[G, X](a, x)).length
}

theorem finite_stabilizer_order_mul_finite_orbit_list_length_eq_group_order[G: FiniteGroup, X](
    a: MulAction[G, X],
    x: X
) {
    finite_stabilizer[G, X](a, x).order * finite_orbit_list[G, X](a, x).length = G.order
}

theorem orbit_eq_of_intersection[G: Group, X](a: MulAction[G, X], x: X, y: X, z: X) {
    orbit(a, x).contains(z) and orbit(a, y).contains(z) implies orbit(a, x) = orbit(a, y)
}

theorem orbit_eq_or_disjoint[G: Group, X](a: MulAction[G, X], x: X, y: X) {
    orbit(a, x) = orbit(a, y) or orbit(a, x).is_disjoint(orbit(a, y))
}

theorem orbit_relation_is_transitive[G: Group, X](a: MulAction[G, X]) {
    is_transitive(orbit_relation(a))
}

theorem orbit_relation_is_equivalence[G: Group, X](a: MulAction[G, X]) {
    is_equivalence(orbit_relation(a))
}

theorem orbit_eq_equivalence_class[G: Group, X](a: MulAction[G, X], x: X) {
    equivalence_class(orbit_relation(a), x) = orbit(a, x)
}

theorem orbit_covers[G: Group, X](a: MulAction[G, X], x: X) {
    orbit(a, x).contains(x)
}

theorem orbit_stabilizer_order_mul_cardinality[G: FiniteGroup, X](
    a: MulAction[G, X],
    x: X,
    n: Nat
) {
    orbit(a, x).cardinality_is(n) implies finite_stabilizer(a, x).order * n = G.order
}

define list_prod[G: Group](t: List[G]) -> G {
    match t {
        List.nil {
            G.1
        }
        List.cons(head, tail) {
            head * list_prod(tail)
        }
    }
}

theorem list_prod_nil[G: Group] {
    list_prod(List.nil[G]) = G.1
}

theorem list_prod_cons[G: Group](head: G, tail: List[G]) {
    list_prod(List.cons(head, tail)) = head * list_prod(tail)
}

define const_list[G](x: G, n: Nat) -> List[G] {
    match n {
        Nat.zero {
            List.nil[G]
        }
        Nat.suc(m) {
            List.cons(x, const_list(x, m))
        }
    }
}

theorem list_prod_const[G: Group](x: G, n: Nat) {
    list_prod(const_list(x, n)) = x.pow(n)
}

define rotate[G](t: List[G]) -> List[G] {
    match t {
        List.nil {
            List.nil[G]
        }
        List.cons(head, tail) {
            tail.append(head)
        }
    }
}

theorem rotate_nil[G] {
    rotate(List.nil[G]) = List.nil[G]
}

theorem rotate_cons[G](head: G, tail: List[G]) {
    rotate(List.cons(head, tail)) = tail.append(head)
}

theorem append_length[T](items: List[T], item: T) {
    items.append(item).length = items.length + 1
}

theorem rotate_length[G](t: List[G]) {
    rotate(t).length = t.length
}

theorem ne_zero_ne_one_imp_lt_one(a: Nat) {
    a != Nat.0 and a != Nat.1 implies Nat.1 < a
}

theorem prime_divisor_one_or_self(p: Nat, d: Nat) {
    p.is_prime and d.divides(p) implies d = Nat.1 or d = p
}

theorem prime_power_period_implies_order[G: FiniteGroup](g: G, p: Nat) {
    p.is_prime and g != G.1 and g.pow(p) = G.1 implies cyclic_subgroup_of(g).order = p
}

define iterate[T](f: T -> T, n: Nat, x: T) -> T {
    match n {
        Nat.zero {
            x
        }
        Nat.suc(m) {
            f(iterate(f, m, x))
        }
    }
}

theorem iterate_zero[T](f: T -> T, x: T) {
    iterate(f, Nat.0, x) = x
}

theorem iterate_suc[T](f: T -> T, n: Nat, x: T) {
    iterate(f, n.suc, x) = f(iterate(f, n, x))
}

theorem iterate_one[T](f: T -> T, x: T) {
    iterate(f, Nat.1, x) = f(x)
}

theorem iterate_add[T](f: T -> T, a: Nat, b: Nat, x: T) {
    iterate(f, a + b, x) = iterate(f, b, iterate(f, a, x))
}

theorem iterate_comm[T](f: T -> T, n: Nat, x: T) {
    iterate(f, n, f(x)) = f(iterate(f, n, x))
}

theorem lt_imp_mod_self(a: Nat, m: Nat) {
    a < m implies a.mod(m) = a
}

theorem mod_self_zero(m: Nat) {
    m != Nat.0 implies m.mod(m) = Nat.0
}

theorem mod_add_self(a: Nat, m: Nat) {
    m != Nat.0 and a < m implies (a + m).mod(m) = a
}

theorem mul_add_mod(q: Nat, r: Nat, m: Nat) {
    m != Nat.0 implies (q * m + r).mod(m) = r.mod(m)
}

theorem mod_add_mod(a: Nat, k: Nat, m: Nat) {
    m != Nat.0 implies (a.mod(m) + k).mod(m) = (a + k).mod(m)
}

define rotate_iter[G](t: List[G], n: Nat) -> List[G] {
    iterate(rotate[G], n, t)
}

theorem rotate_iter_zero[G](t: List[G]) {
    rotate_iter(t, Nat.0) = t
}

theorem rotate_iter_suc[G](t: List[G], n: Nat) {
    rotate_iter(t, n.suc) = rotate(rotate_iter(t, n))
}

theorem rotate_iter_one[G](t: List[G]) {
    rotate_iter(t, Nat.1) = rotate(t)
}

theorem rotate_iter_add[G](t: List[G], a: Nat, b: Nat) {
    rotate_iter(t, a + b) = rotate_iter(rotate_iter(t, a), b)
}

theorem rotate_iter_length[G](t: List[G], n: Nat) {
    rotate_iter(t, n).length = t.length
}

theorem get_idx_cons_zero[G](h: G, t: List[G]) {
    List.cons(h, t).get_idx(Nat.0) = Option.some(h)
}

theorem get_idx_cons_suc[G](h: G, t: List[G], m: Nat) {
    List.cons(h, t).get_idx(m.suc) = t.get_idx(m)
}

theorem get_idx_nil[G](i: Nat) {
    List.nil[G].get_idx(i) = Option.none[G]
}

theorem append_get_idx_left[G](xs: List[G], x: G, i: Nat) {
    i < xs.length implies xs.append(x).get_idx(i) = xs.get_idx(i)
}

theorem append_get_idx_right[G](xs: List[G], x: G) {
    xs.append(x).get_idx(xs.length) = Option.some(x)
}

theorem rotate_get_idx[G](t: List[G], p: Nat, i: Nat) {
    t.length = p and p != Nat.0 and i < p implies
        rotate(t).get_idx(i) = t.get_idx((i + Nat.1).mod(p))
}

theorem rotate_iter_get_idx[G](t: List[G], p: Nat, k: Nat, i: Nat) {
    t.length = p and p != Nat.0 and i < p implies
        rotate_iter(t, k).get_idx(i) = t.get_idx((i + k).mod(p))
}

theorem rotate_p_id[G](t: List[G], p: Nat) {
    t.length = p and p != Nat.0 implies rotate_iter(t, p) = t
}

theorem const_list_append[G](x: G, m: Nat) {
    const_list(x, m).append(x) = const_list(x, m + Nat.1)
}

theorem const_rotate_fixed[G](x: G, n: Nat) {
    n != Nat.0 implies rotate(const_list(x, n)) = const_list(x, n)
}

define head_of[G: Group](t: List[G]) -> G {
    match t {
        List.nil {
            G.1
        }
        List.cons(h, rest) {
            h
        }
    }
}

theorem rotate_fixed_imp_const[G: Group](t: List[G]) {
    rotate(t) = t implies t = const_list(head_of(t), t.length)
}

theorem rotate_fixed_imp_exists_const[G: Group](t: List[G]) {
    rotate(t) = t implies exists(x: G) {
        t = const_list(x, t.length)
    }
}

theorem period_add[G](t: List[G], a: Nat, b: Nat) {
    rotate_iter(t, a) = t and rotate_iter(t, b) = t implies rotate_iter(t, a + b) = t
}

theorem period_mul[G](t: List[G], a: Nat, q: Nat) {
    rotate_iter(t, a) = t implies rotate_iter(t, a * q) = t
}

theorem period_sub[G](t: List[G], a: Nat, b: Nat) {
    b <= a and rotate_iter(t, a) = t and rotate_iter(t, b) = t implies rotate_iter(t, a - b) = t
}

theorem period_imp_mod_period[G](t: List[G], a: Nat, m: Nat) {
    m != Nat.0 and rotate_iter(t, a) = t and rotate_iter(t, m) = t implies
        rotate_iter(t, a.mod(m)) = t
}

define period_witness[G](t: List[G], d: Nat) -> Bool {
    d != Nat.0 and rotate_iter(t, d) = t
}

theorem period_witness_unfold[G](t: List[G], d: Nat) {
    period_witness(t, d) = (d != Nat.0 and rotate_iter(t, d) = t)
}

theorem minimal_period_le_any[G](t: List[G], m: Nat, a: Nat) {
    is_min(period_witness(t), m) and period_witness(t, a) implies m <= a
}

theorem minimal_period_divides_any[G](t: List[G], a: Nat, m: Nat) {
    is_min(period_witness(t), m) and rotate_iter(t, a) = t implies m.divides(a)
}

theorem period_lt_prime_imp_fixed[G](t: List[G], p: Nat, k: Nat) {
    t.length = p and p.is_prime and k > Nat.0 and k < p and
    rotate_iter(t, p) = t and rotate_iter(t, k) = t
    implies rotate(t) = t
}

theorem map_pointwise_eq[T, U](items: List[T], f: T -> U, g: T -> U) {
    (forall(x: T) { items.contains(x) implies f(x) = g(x) }) implies map(items, f) = map(items, g)
}

define const_fn[G](x: G) -> Nat -> G {
    function(k: Nat) { x }
}

theorem const_fn_apply[G](x: G, n: Nat) {
    const_fn(x)(n) = x
}

theorem map_range_const[G](x: G, p: Nat) {
    map[Nat, G](p.range, const_fn(x)) = const_list(x, p)
}

theorem unique_cons_of_contains[T](head: T, tail: List[T]) {
    tail.contains(head) implies List.cons(head, tail).unique = tail.unique
}

theorem const_list_unique_suc[G](x: G, m: Nat) {
    const_list(x, m.suc).unique = List.singleton(x)
}

theorem const_list_unique_pos[G](x: G, p: Nat) {
    p != Nat.0 implies const_list(x, p).unique = List.singleton(x)
}

theorem all_iterates_fixed[G](t: List[G], k: Nat) {
    rotate(t) = t implies rotate_iter(t, k) = t
}

define rotation_orbit_list[G](t: List[G], p: Nat) -> List[List[G]] {
    map[Nat, List[G]](p.range, function(k: Nat) { rotate_iter(t, k) }).unique
}

define rotation_orbit_set[G](t: List[G], p: Nat) -> Set[List[G]] {
    list_set(rotation_orbit_list(t, p))
}

theorem rotation_orbit_list_eq_singleton[G](t: List[G], p: Nat) {
    t.length = p and p != Nat.0 and rotate(t) = t implies
        rotation_orbit_list(t, p) = List.singleton(t)
}

theorem range_map_unique[G](t: List[G], p: Nat) {
    t.length = p and p.is_prime and rotate_iter(t, p) = t and rotate(t) != t implies
        map[Nat, List[G]](p.range, function(k: Nat) { rotate_iter(t, k) }).is_unique
}

theorem rotation_orbit_list_length_eq_p[G](t: List[G], p: Nat) {
    t.length = p and p.is_prime and rotate_iter(t, p) = t and rotate(t) != t implies
        rotation_orbit_list(t, p).length = p
}

theorem rotation_orbit_list_length_1_or_p[G](t: List[G], p: Nat) {
    t.length = p and p.is_prime and rotate_iter(t, p) = t implies
        (rotation_orbit_list(t, p).length = Nat.1 or rotation_orbit_list(t, p).length = p)
}

theorem length_zero_imp_nil_local[T](list: List[T]) {
    list.length = Nat.0 implies list = List.nil[T]
}

theorem flatten_list_cons[T](xs: List[T], rest: List[List[T]]) {
    flatten_list(List.cons(xs, rest)) = xs + flatten_list(rest)
}

theorem all_lists_member_length[T](items: List[T], n: Nat, t: List[T]) {
    all_lists_unique(items, n).contains(t) implies t.length = n
}

theorem flatten_list_contains_of_member_contains[T](xss: List[List[T]], xs: List[T], u: T) {
    xss.contains(xs) and xs.contains(u) implies flatten_list(xss).contains(u)
}

theorem all_lists_contains_of_length_entries[T](items: List[T], n: Nat, t: List[T]) {
    t.length = n and (forall(x: T) { t.contains(x) implies items.contains(x) }) implies all_lists_unique(items, n).contains(t)
}

define const_fn_gen[T, U](x: U) -> T -> U {
    function(k: T) { x }
}

theorem const_fn_gen_apply[T, U](x: U, k: T) {
    const_fn_gen[T, U](x)(k) = x
}

define list_len[T](xs: List[T]) -> Nat {
    xs.length
}

theorem list_len_apply[T](xs: List[T]) {
    list_len(xs) = xs.length
}

theorem sum_const_mul[T](c: Nat, items: List[T]) {
    sum[Nat](map[T, Nat](items, const_fn_gen[T, Nat](c))) = c * items.length
}

theorem flatten_list_length[T](xss: List[List[T]]) {
    flatten_list(xss).length = sum[Nat](map[List[T], Nat](xss, list_len[T]))
}

define cons_all[T](x: T, items: List[T], k: Nat) -> List[List[T]] {
    prepend_all(x, all_lists_unique(items, k))
}

define cons_all_len[T](x: T, items: List[T], k: Nat) -> Nat {
    list_len(cons_all(x, items, k))
}

define cons_all_fn[T](items: List[T], k: Nat) -> T -> List[List[T]] {
    function(x: T) { cons_all(x, items, k) }
}

theorem cons_all_fn_apply[T](x: T, items: List[T], k: Nat) {
    cons_all_fn(items, k)(x) = cons_all(x, items, k)
}

theorem cons_all_len_eq_all_lists_card[T](x: T, items: List[T], k: Nat) {
    cons_all_len(x, items, k) = all_lists_unique(items, k).length
}

define prepend_all_fn[T](items: List[T], k: Nat) -> T -> List[List[T]] {
    function(x: T) { prepend_all(x, all_lists_unique(items, k)) }
}

theorem prepend_all_fn_apply[T](x: T, items: List[T], k: Nat) {
    prepend_all_fn(items, k)(x) = prepend_all(x, all_lists_unique(items, k))
}

theorem prepend_all_length[T](x: T, ts: List[List[T]]) {
    prepend_all(x, ts).length = ts.length
}

theorem cons_all_list_len[T](x: T, items: List[T], k: Nat) {
    list_len(cons_all(x, items, k)) = cons_all_len(x, items, k)
}

define list_len_comp[T](f: T -> List[List[T]], x: T) -> Nat {
    list_len(f(x))
}

theorem prepend_all_fn_len_eq_card[T](x: T, items: List[T], k: Nat) {
    list_len_comp(prepend_all_fn(items, k), x) = all_lists_unique(items, k).length
}

theorem sum_map_map_length[T](items: List[T], f: T -> List[List[T]]) {
    sum[Nat](map[List[List[T]], Nat](map[T, List[List[T]]](items, f), list_len[List[T]])) =
        sum[Nat](map[T, Nat](items, function(x: T) { list_len_comp(f, x) }))
}

theorem all_lists_cardinality[T](items: List[T], n: Nat) {
    all_lists_unique(items, n).length = items.length.pow(n)
}

define x_tuple[G: Group](u: List[G]) -> List[G] {
    List.cons(list_prod(u).inverse, u)
}

define x_list[G: FiniteGroup](p: Nat) -> List[List[G]] {
    map[List[G], List[G]](all_lists_unique(G.elements, p - Nat.1), x_tuple[G])
}

define x_set[G: FiniteGroup](p: Nat) -> Set[List[G]] {
    list_set(x_list[G](p))
}

theorem x_tuple_length[G: Group](u: List[G]) {
    x_tuple(u).length = u.length + Nat.1
}

theorem x_tuple_prod_one[G: Group](u: List[G]) {
    list_prod(x_tuple(u)) = G.1
}

theorem x_list_member_prod_one[G: FiniteGroup](p: Nat, t: List[G]) {
    x_list[G](p).contains(t) implies list_prod(t) = G.1
}

theorem x_list_member_length[G: FiniteGroup](p: Nat, t: List[G]) {
    p.is_prime and x_list[G](p).contains(t) implies t.length = p
}

theorem mul_eq_one_imp_left_inverse[G: Group](a: G, b: G) {
    a * b = G.1 implies a = b.inverse
}

theorem x_list_member_of_length_prod_one[G: FiniteGroup](p: Nat, t: List[G]) {
    p.is_prime and t.length = p and list_prod(t) = G.1 implies x_list[G](p).contains(t)
}

define conjugation_act[G: Group](g: G, x: G) -> G {
    g * x * g.inverse
}

theorem conjugation_act_one[G: Group](x: G) {
    conjugation_act(G.1, x) = x
}

theorem conjugation_act_mul[G: Group](g: G, h: G, x: G) {
    conjugation_act(g * h, x) = conjugation_act(g, conjugation_act(h, x))
}

theorem conjugation_action_identity_constraint[G: Group] {
    action_identity_constraint(conjugation_act[G])
}

theorem conjugation_action_mul_constraint[G: Group] {
    action_mul_constraint(conjugation_act[G])
}

theorem conjugation_is_mul_action[G: Group] {
    is_mul_action(conjugation_act[G])
}

let conjugation_action[G: Group]: MulAction[G, G] satisfy {
    MulAction.new(conjugation_act[G]) = Option.some(conjugation_action)
}

theorem conjugation_action_act[G: Group](g: G, x: G) {
    conjugation_action[G].act(g, x) = g * x * g.inverse
}

theorem conjugation_act_fixed_iff_commutes[G: Group](g: G, x: G) {
    conjugation_act(g, x) = x iff g * x = x * g
}

theorem conjugation_act_one_value[G: Group](g: G) {
    conjugation_act(g, G.1) = G.1
}

theorem conjugation_act_mul_value[G: Group](g: G, x: G, y: G) {
    conjugation_act(g, x * y) = conjugation_act(g, x) * conjugation_act(g, y)
}

theorem conjugation_act_inverse[G: Group](g: G, x: G) {
    conjugation_act(g, x.inverse) = conjugation_act(g, x).inverse
}

theorem conjugation_act_self[G: Group](x: G) {
    conjugation_act(x, x) = x
}

theorem conjugation_act_inverse_arg[G: Group](g: G, x: G) {
    conjugation_act(g.inverse, conjugation_act(g, x)) = x
}

theorem conjugation_act_arg_inverse[G: Group](g: G, x: G) {
    conjugation_act(g, conjugation_act(g.inverse, x)) = x
}

theorem conjugation_act_injective[G: Group](g: G, x: G, y: G) {
    conjugation_act(g, x) = conjugation_act(g, y) implies x = y
}

theorem conjugation_act_surjective[G: Group](g: G, y: G) {
    exists(x: G) { conjugation_act(g, x) = y }
}

theorem conjugation_act_inverse_arg_eq[G: Group](g: G, x: G) {
    conjugation_act(g.inverse, x) = g.inverse * x * g
}

theorem conjugation_act_self_inverse[G: Group](x: G) {
    conjugation_act(x, x.inverse) = x.inverse
}

theorem conjugation_action_orbit_contains_iff[G: Group](x: G, y: G) {
    orbit(conjugation_action[G], x).contains(y) iff exists(g: G) {
        g * x * g.inverse = y
    }
}

theorem conjugation_action_orbit_contains_self[G: Group](x: G) {
    orbit(conjugation_action[G], x).contains(x)
}

theorem conjugation_action_stabilizer_contains_iff[G: Group](x: G, g: G) {
    stabilizer(conjugation_action[G], x).contains(g) iff g * x = x * g
}

theorem conjugation_action_stabilizer_of_commutes[G: Group](x: G, g: G) {
    g * x = x * g implies stabilizer(conjugation_action[G], x).contains(g)
}

theorem conjugation_action_stabilizer_commutes[G: Group](x: G, g: G) {
    stabilizer(conjugation_action[G], x).contains(g) implies g * x = x * g
}

theorem conjugation_action_stabilizer_contains_one[G: Group](x: G) {
    stabilizer(conjugation_action[G], x).contains(G.1)
}

theorem conjugation_action_stabilizer_contains_self[G: Group](x: G) {
    stabilizer(conjugation_action[G], x).contains(x)
}

theorem conjugation_action_stabilizer_contains_inverse[G: Group](x: G) {
    stabilizer(conjugation_action[G], x).contains(x.inverse)
}

theorem conjugation_action_stabilizer_mul[G: Group](x: G, g: G, h: G) {
    stabilizer(conjugation_action[G], x).contains(g) and
        stabilizer(conjugation_action[G], x).contains(h) implies
        stabilizer(conjugation_action[G], x).contains(g * h)
}

theorem conjugation_action_stabilizer_inverse[G: Group](x: G, g: G) {
    stabilizer(conjugation_action[G], x).contains(g) implies
        stabilizer(conjugation_action[G], x).contains(g.inverse)
}

theorem conjugation_action_orbit_symmetric[G: Group](x: G, y: G) {
    orbit(conjugation_action[G], x).contains(y) implies
        orbit(conjugation_action[G], y).contains(x)
}

theorem conjugation_act_inverse_witness[G: Group](g: G, x: G) {
    conjugation_act(g.inverse, conjugation_act(g, x)) = x
}

theorem conjugation_action_orbit_one_eq[G: Group](y: G) {
    orbit(conjugation_action[G], G.1).contains(y) iff y = G.1
}

theorem conjugation_act_self_inverse_arg[G: Group](x: G) {
    conjugation_act(x.inverse, x) = x
}

theorem conjugation_action_conjugate_inverse_witness[G: Group](g: G, x: G, y: G) {
    g * x * g.inverse = y implies g.inverse * y * g = x
}

theorem conjugation_action_orbit_contains_conjugate[G: Group](g: G, h: G) {
    orbit(conjugation_action[G], h).contains(g * h * g.inverse)
}

define is_central_element[G: Group](x: G) -> Bool {
    forall(g: G) {
        g * x = x * g
    }
}

theorem is_central_element_one[G: Group] {
    is_central_element[G](G.1)
}

theorem is_central_element_mul[G: Group](x: G, y: G) {
    is_central_element(x) and is_central_element(y) implies is_central_element(x * y)
}

theorem is_central_element_inv[G: Group](x: G) {
    is_central_element(x) implies is_central_element(x.inverse)
}

theorem is_central_element_subgroup_constraint[G: Group] {
    subgroup_constraint(is_central_element[G])
}

let finite_center[G: FiniteGroup]: FiniteSubgroup[G] satisfy {
