theorem same_left_coset_raw_reflexive[G: Group](s: Subgroup[G], a: G) { s.contains(a.inverse * a) }

theorem same_left_coset_raw_symmetric[G: Group](s: Subgroup[G], a: G, b: G) { s.contains(a.inverse * b) implies s.contains(b.inverse * a) }

theorem same_left_coset_raw_transitive[G: Group](s: Subgroup[G], a: G, b: G, c: G) { s.contains(a.inverse * b) and s.contains(b.inverse * c) implies s.contains(a.inverse * c) }

theorem left_coset_intersection_witness_implies_same_representative_raw[G: Group](s: Subgroup[G], a: G, b: G, x: G) { s.contains(a.inverse * x) and s.contains(b.inverse * x) implies s.contains(a.inverse * b) }

theorem same_representative_implies_left_coset_membership_eq_raw[G: Group](s: Subgroup[G], a: G, b: G, y: G) { s.contains(a.inverse * b) implies s.contains(a.inverse * y) = s.contains(b.inverse * y) }

define finite_left_coset_set[G: FiniteGroup](s: FiniteSubgroup[G], a: G) -> Set[G] {
    Set[G].new(function(y: G) { s.contains(a.inverse * y) })
}

theorem finite_left_coset_set_contains_eq_local[G: FiniteGroup](s: FiniteSubgroup[G], a: G, y: G) {
    finite_left_coset_set[G](s, a).contains(y) = s.contains(a.inverse * y)
}

theorem same_representative_left_coset_membership_eq_clause[G: Group](s: Subgroup[G], a: G, b: G, y: G) { s.contains(a.inverse * b) implies s.contains(a.inverse * y) = s.contains(b.inverse * y) }

theorem left_mul_is_injective_fn[G: Group](a: G) {
    is_injective_fn[G, G](function(h: G) { a * h })
}

theorem finite_subgroup_left_mul_image_cardinality_is_order[G: FiniteGroup](s: FiniteSubgroup[G], a: G) {
    set_image[G, G](s.as_set, function(h: G) { a * h }).cardinality_is(s.order)
}

theorem left_coset_intersection_witness_same_representative_clause[G: Group](s: Subgroup[G], a: G, b: G, x: G) { s.contains(a.inverse * x) and s.contains(b.inverse * x) implies s.contains(a.inverse * b) }

theorem left_mul_subgroup_left_coset_injective_raw[G: Group](s: Subgroup[G], a: G, h1: G, h2: G) { s.contains(h1) and s.contains(h2) and a * h1 = a * h2 implies h1 = h2 }

theorem left_coset_representative_mem_raw_clause[G: Group](s: Subgroup[G], a: G) { s.contains(a.inverse * a) }

theorem left_mul_subgroup_image_mem_clause[G: Group](s: Subgroup[G], a: G, h: G) { s.contains(h) implies s.contains(a.inverse * (a * h)) = true }

theorem left_mul_subgroup_left_coset_injective_clause[G: Group](s: Subgroup[G], a: G, h1: G, h2: G) { s.contains(h1) and s.contains(h2) and a * h1 = a * h2 implies h1 = h2 }

theorem left_coset_elem_has_subgroup_preimage_raw[G: Group](s: Subgroup[G], a: G, y: G) { s.contains(a.inverse * y) implies exists(h: G) { s.contains(h) and a * h = y } }

theorem left_coset_elem_has_subgroup_preimage_clause[G: Group](s: Subgroup[G], a: G, y: G) { s.contains(a.inverse * y) implies exists(h: G) { s.contains(h) and a * h = y } }

theorem left_mul_subgroup_into_left_coset_raw[G: Group](s: Subgroup[G], a: G, h: G) { s.contains(h) implies s.contains(a.inverse * (a * h)) }

theorem left_mul_subgroup_into_left_coset_clause[G: Group](s: Subgroup[G], a: G, h: G) { s.contains(h) implies s.contains(a.inverse * (a * h)) }

theorem intersecting_left_cosets_equal_raw[G: Group](s: Subgroup[G], a: G, b: G) { exists(x: G) { s.contains(a.inverse * x) and s.contains(b.inverse * x) } implies forall(y: G) { s.contains(a.inverse * y) = s.contains(b.inverse * y) } }

theorem left_cosets_equal_or_disjoint_raw[G: Group](s: Subgroup[G], a: G, b: G) { (forall(y: G) { s.contains(a.inverse * y) = s.contains(b.inverse * y) }) or not(exists(x: G) { s.contains(a.inverse * x) and s.contains(b.inverse * x) }) }

theorem intersecting_left_cosets_pointwise_equal_clause[G: Group](s: Subgroup[G], a: G, b: G) { exists(x: G) { s.contains(a.inverse * x) and s.contains(b.inverse * x) } implies forall(y: G) { s.contains(a.inverse * y) = s.contains(b.inverse * y) } }

theorem left_cosets_equal_or_disjoint_raw_clause[G: Group](s: Subgroup[G], a: G, b: G) { (forall(y: G) { s.contains(a.inverse * y) = s.contains(b.inverse * y) }) or not(exists(x: G) { s.contains(a.inverse * x) and s.contains(b.inverse * x) }) }

theorem finite_left_mul_image_member_implies_left_coset_set_member[G: FiniteGroup](s: FiniteSubgroup[G], a: G, y: G) {
    set_image[G, G](s.as_set, function(h: G) { a * h }).contains(y) implies finite_left_coset_set[G](s, a).contains(y)
}

theorem finite_left_coset_set_member_implies_left_mul_image_member[G: FiniteGroup](s: FiniteSubgroup[G], a: G, y: G) {
    finite_left_coset_set[G](s, a).contains(y) implies set_image[G, G](s.as_set, function(h: G) { a * h }).contains(y)
}

theorem finite_left_mul_image_contains_eq_left_coset_set_contains[G: FiniteGroup](s: FiniteSubgroup[G], a: G, y: G) {
    set_image[G, G](s.as_set, function(h: G) { a * h }).contains(y) = finite_left_coset_set[G](s, a).contains(y)
}

theorem finite_subgroup_left_mul_image_eq_left_coset_set[G: FiniteGroup](s: FiniteSubgroup[G], a: G) {
    set_image[G, G](s.as_set, function(h: G) { a * h }) = finite_left_coset_set[G](s, a)
}

theorem finite_left_coset_set_cardinality_is_order[G: FiniteGroup](s: FiniteSubgroup[G], a: G) {
    finite_left_coset_set[G](s, a).cardinality_is(s.order)
}

theorem finite_left_coset_sets_pointwise_eq_from_raw[G: FiniteGroup](s: FiniteSubgroup[G], a: G, b: G) {
    (forall(y: G) { s.as_subgroup.contains(a.inverse * y) = s.as_subgroup.contains(b.inverse * y) }) implies
    forall(y: G) { finite_left_coset_set[G](s, a).contains(y) = finite_left_coset_set[G](s, b).contains(y) }
}

theorem finite_left_coset_sets_eq_from_raw_pointwise[G: FiniteGroup](s: FiniteSubgroup[G], a: G, b: G) {
    (forall(y: G) { s.as_subgroup.contains(a.inverse * y) = s.as_subgroup.contains(b.inverse * y) }) implies
    finite_left_coset_set[G](s, a) = finite_left_coset_set[G](s, b)
}

theorem finite_left_coset_sets_disjoint_from_raw_none[G: FiniteGroup](s: FiniteSubgroup[G], a: G, b: G) {
    not(exists(x: G) { s.as_subgroup.contains(a.inverse * x) and s.as_subgroup.contains(b.inverse * x) }) implies
    finite_left_coset_set[G](s, a).is_disjoint(finite_left_coset_set[G](s, b))
}

theorem finite_left_cosets_equal_or_disjoint[G: FiniteGroup](s: FiniteSubgroup[G], a: G, b: G) {
    finite_left_coset_set[G](s, a) = finite_left_coset_set[G](s, b) or
    finite_left_coset_set[G](s, a).is_disjoint(finite_left_coset_set[G](s, b))
}

theorem finite_left_coset_set_contains_representative[G: FiniteGroup](s: FiniteSubgroup[G], a: G) {
    finite_left_coset_set[G](s, a).contains(a)
}

theorem finite_left_cosets_cover_universal[G: FiniteGroup](s: FiniteSubgroup[G]) {
    list_indexed_union[G, G](G.elements, function(a: G) { finite_left_coset_set[G](s, a) }) = Set[G].universal_set
}

define finite_left_coset_representatives[G: FiniteGroup](s: FiniteSubgroup[G]) -> List[Set[G]] {
    map[G, Set[G]](G.elements, function(a: G) { finite_left_coset_set[G](s, a) }).unique
}

theorem finite_left_coset_representatives_is_unique[G: FiniteGroup](s: FiniteSubgroup[G]) {
    finite_left_coset_representatives[G](s).is_unique
}

theorem finite_left_coset_representatives_contains_coset[G: FiniteGroup](s: FiniteSubgroup[G], a: G) {
    finite_left_coset_representatives[G](s).contains(finite_left_coset_set[G](s, a))
}

theorem finite_left_coset_representatives_cover_universal[G: FiniteGroup](s: FiniteSubgroup[G]) {
    list_indexed_union[G, Set[G]](
        finite_left_coset_representatives[G](s),
        function(c: Set[G]) { c }
    ) = Set[G].universal_set
}

theorem finite_left_coset_representative_cardinality_is_order[G: FiniteGroup](s: FiniteSubgroup[G], c: Set[G]) {
    finite_left_coset_representatives[G](s).contains(c) implies c.cardinality_is(s.order)
}

theorem finite_left_coset_representatives_distinct_disjoint[G: FiniteGroup](s: FiniteSubgroup[G], c: Set[G], d: Set[G]) {
    finite_left_coset_representatives[G](s).contains(c) and
    finite_left_coset_representatives[G](s).contains(d) and
    c != d
    implies c.is_disjoint(d)
}

theorem finite_group_universal_set_cardinality_is_order[G: FiniteGroup] {
    Set[G].universal_set.cardinality_is(G.order)
}

theorem finite_left_coset_representatives_all_cardinality_is_order[G: FiniteGroup](s: FiniteSubgroup[G]) {
    set_list_all_cardinality_is[G](finite_left_coset_representatives[G](s), s.order)
}

theorem finite_left_coset_representatives_pairwise_disjoint[G: FiniteGroup](s: FiniteSubgroup[G]) {
    set_list_pairwise_disjoint[G](finite_left_coset_representatives[G](s))
}

theorem finite_left_coset_representatives_recursively_disjoint[G: FiniteGroup](s: FiniteSubgroup[G]) {
    set_list_recursively_disjoint[G](finite_left_coset_representatives[G](s))
}

theorem finite_left_coset_representatives_union_cardinality[G: FiniteGroup](s: FiniteSubgroup[G]) {
    set_list_union[G](finite_left_coset_representatives[G](s)).cardinality_is(s.order * finite_left_coset_representatives[G](s).length)
}

theorem finite_left_coset_representatives_recursive_union_covers_universal[G: FiniteGroup](s: FiniteSubgroup[G]) {
    set_list_union[G](finite_left_coset_representatives[G](s)) = Set[G].universal_set
}

theorem finite_left_coset_representatives_order_product_eq_group_order[G: FiniteGroup](s: FiniteSubgroup[G]) {
    s.order * finite_left_coset_representatives[G](s).length = G.order
}

theorem top100_071_lagrange_theorem[G: FiniteGroup](s: FiniteSubgroup[G]) {
    s.order.divides(G.order)
}

theorem top100_074_mathematical_induction(p: Nat -> Bool) {
    (p(Nat.0) and forall(n: Nat) { p(n) implies p(n.suc) })
    implies
    forall(n: Nat) { p(n) }
}

theorem top100_078_cauchy_schwarz(a: Nat -> Real, b: Nat -> Real, n: Nat) {
    finite_dot(a, b, n) * finite_dot(a, b, n) <=
        finite_square_sum(a, n) * finite_square_sum(b, n)
}

theorem top100_079_intermediate_value(
    f: Real -> Real, lower: Real, upper: Real, target: Real
) {
    continuous(f) and lower <= upper and f(lower) <= target and target <= f(upper)
    implies exists(point: Real) {
        lower <= point and point <= upper and f(point) = target
    }
}

theorem top100_080_fundamental_theorem_of_arithmetic(n: Nat) {
    Nat.1 <= n implies exists(factors: List[Nat]) {
        product[Nat](factors) = n and all_prime(factors) and
        forall(other: List[Nat]) {
            product[Nat](other) = n and all_prime(other) implies
            is_permutation[Nat](factors, other)
        }
    }
}

theorem top100_085_divisibility_by_3_rule(digits: List[Int]) {
    Int.3.divides(int_read_digits_acc(digits, Int.0)) =
    Int.3.divides(int_digit_sum(digits))
}

define coeff_tail(c: Nat -> Real, i: Nat) -> Real {
    c(i.suc)
}

define coeff_eval(c: Nat -> Real, x: Real, n: Nat) -> Real {
    match n {
        Nat.zero {
            Real.0
        }
        Nat.suc(pred) {
            c(Nat.0) + x * coeff_eval(coeff_tail(c), x, pred)
        }
    }
}

define coeff_quotient(c: Nat -> Real, a: Real, n: Nat, i: Nat) -> Real {
    match n {
        Nat.zero {
            Real.0
        }
        Nat.suc(pred) {
            match i {
                Nat.zero {
                    coeff_eval(coeff_tail(c), a, pred)
                }
                Nat.suc(ipred) {
                    coeff_quotient(coeff_tail(c), a, pred, ipred)
                }
            }
        }
    }
}

define coeff_mul_x_minus_a(q: Nat -> Real, a: Real, x: Real, n: Nat) -> Real {
    coeff_eval(q, x, n) * (x - a)
}

theorem coeff_quotient_zero_index(c: Nat -> Real, a: Real, n: Nat) {
    coeff_quotient(c, a, n.suc, Nat.0) = coeff_eval(coeff_tail(c), a, n)
}

define coeff_divisible_by_x_minus_a(c: Nat -> Real, a: Real, n: Nat) -> Bool {
    exists(q: Nat -> Real) {
        forall(x: Real) {
            coeff_eval(c, x, n) = coeff_mul_x_minus_a(q, a, x, n)
        }
    }
}

theorem real_add_sub_cancel_left(a: Real, x: Real) {
    a + (x - a) = x
}

theorem real_mul_sub_split(a: Real, x: Real, t: Real) {
    x * t = a * t + (x - a) * t
}

theorem coeff_tail_quotient(c: Nat -> Real, a: Real, n: Nat) {
    coeff_tail(coeff_quotient(c, a, n.suc), Nat.0) = coeff_quotient(coeff_tail(c), a, n, Nat.0) and
    coeff_tail(coeff_quotient(c, a, n.suc)) = coeff_quotient(coeff_tail(c), a, n)
}

define coeff_remainder_at(c: Nat -> Real, a: Real, x: Real, n: Nat) -> Bool {
    coeff_eval(c, x, n) = coeff_eval(c, a, n) + (x - a) * coeff_eval(coeff_quotient(c, a, n), x, n)
}

define coeff_remainder_property(a: Real, x: Real, n: Nat) -> Bool {
    forall(c: Nat -> Real) {
        coeff_remainder_at(c, a, x, n)
    }
}

theorem coeff_remainder_property_apply(a: Real, x: Real, n: Nat, c: Nat -> Real) {
    coeff_remainder_property(a, x, n) implies coeff_remainder_at(c, a, x, n)
}

theorem coeff_remainder_property_intro(a: Real, x: Real, n: Nat) {
    (forall(c: Nat -> Real) { coeff_remainder_at(c, a, x, n) }) implies
    coeff_remainder_property(a, x, n)
}

theorem coeff_remainder_property_all(a: Real, x: Real, n: Nat) {
    coeff_remainder_property(a, x, n)
}

theorem top100_089_remainder_theorem(c: Nat -> Real, a: Real, x: Real, n: Nat) {
    coeff_eval(c, x, n) = coeff_eval(c, a, n) + (x - a) * coeff_eval(coeff_quotient(c, a, n), x, n)
}

theorem coeff_factor_theorem_forward(c: Nat -> Real, a: Real, n: Nat) {
    coeff_eval(c, a, n) = Real.0 implies coeff_divisible_by_x_minus_a(c, a, n)
}

theorem coeff_factor_theorem_reverse(c: Nat -> Real, a: Real, n: Nat) {
    coeff_divisible_by_x_minus_a(c, a, n) implies coeff_eval(c, a, n) = Real.0
}

theorem top100_089_factor_theorem(c: Nat -> Real, a: Real, n: Nat) {
    coeff_eval(c, a, n) = Real.0 = coeff_divisible_by_x_minus_a(c, a, n)
}

theorem top100_094_law_of_cosines(a: Point2[Real], b: Point2[Real], c: Point2[Real]) {
    b != a and c != a implies
    b.dist_sq(c) =
        a.dist_sq(b) + a.dist_sq(c) -
        (Real.1 + Real.1) * (point2_norm(b.sub(a)) * point2_norm(c.sub(a)) *
            cos_angle(b.sub(a), c.sub(a)))
}

theorem top100_096_inclusion_exclusion[T](s: FiniteSet[T], t: FiniteSet[T],
    n_s: Nat, n_t: Nat, n_inter: Nat) {
    s.cardinality_is(n_s) and
    t.cardinality_is(n_t) and
    fs_intersection[T](s, t).cardinality_is(n_inter)
    implies fs_union[T](s, t).cardinality_is(n_s + n_t - n_inter)
}
