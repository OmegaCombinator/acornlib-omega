theorem unique_pairwise_implies_recursively_disjoint_cons_step[K](head: Set[K], tail: List[Set[K]]) {
    (tail.is_unique and set_list_pairwise_disjoint[K](tail) implies set_list_recursively_disjoint[K](tail)) and
