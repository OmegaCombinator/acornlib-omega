structure Fin[n: Nat] {
    value: Nat
} constraint {
    value < n
}

let fin_self(n: Nat, x: Fin[n]) -> result: Fin[n] satisfy {
    result = x
}

attributes Fin[n: Nat] {
    /// Expose the ambient bound in a family-dependent attribute body.
    define bound(self) -> Nat {
        n
    }

    /// Rewrap through a top-level dependent satisfy function.
    define again(self) -> Fin[n] {
        fin_self(n, self)
    }
}

theorem value_lt_bound(n: Nat, x: Fin[n]) {
    x.value < n
}

theorem new_round_trip(n: Nat, x: Nat, y: Fin[n]) {
    Fin[n].new(x) = Option.some(y) implies y.value = x
}

theorem new_self(n: Nat, a: Fin[n]) {
    Fin[n].new(a.value) = Option.some(a)
}

theorem fin_new_some_imp_lt(n: Nat, k: Nat, i: Fin[n]) {
    Fin[n].new(k) = Option.some(i) implies k < n
}

theorem fin_new_some_iff_lt(n: Nat, k: Nat) {
    (exists(i: Fin[n]) { Fin[n].new(k) = Option.some(i) }) = (k < n)
}

theorem fin_new_exists_of_lt(n: Nat, k: Nat) {
    k < n implies exists(i: Fin[n]) {
        Fin[n].new(k) = Option.some(i)
    }
}

theorem ext(n: Nat, a: Fin[n], b: Fin[n]) {
    a.value = b.value implies a = b
}

theorem attribute_round_trip(n: Nat, x: Fin[n]) {
    x.bound = n and x.again = x
}

theorem fin_bound_eq(n: Nat, x: Fin[n]) {
    x.bound = n
}

theorem fin_again_eq(n: Nat, x: Fin[n]) {
    x.again = x
}

let fin_last(n: Nat) -> result: Fin[n.suc] satisfy {
    Fin[n.suc].new(n) = Option.some(result)
}

let fin_zero(n: Nat) -> result: Fin[n.suc] satisfy {
    Fin[n.suc].new(Nat.0) = Option.some(result)
}

let fin_cast_suc(n: Nat, x: Fin[n]) -> result: Fin[n.suc] satisfy {
    Fin[n.suc].new(x.value) = Option.some(result)
}

let fin_succ(n: Nat, x: Fin[n]) -> result: Fin[n.suc] satisfy {
    Fin[n.suc].new(x.value.suc) = Option.some(result)
}

define fin_skip_value(n: Nat, removed: Fin[n.suc], x: Fin[n]) -> Nat {
    if x.value < removed.value {
        x.value
    } else {
        x.value.suc
    }
}

define fin_skip(n: Nat, removed: Fin[n.suc], x: Fin[n]) -> Fin[n.suc] {
    if x.value < removed.value {
        fin_cast_suc(n, x)
    } else {
        fin_succ(n, x)
    }
}

attributes Fin[n: Nat] {
    /// True if this element is the final element of the finite initial segment.
    define is_last(self) -> Bool {
        self.value.suc = n
    }

    /// The standard inclusion into the next finite initial segment.
    define cast_suc(self) -> Fin[n.suc] {
        fin_cast_suc(n, self)
    }

    /// The increasing inclusion into `Fin[n + 1]` omitting `removed`.
    define skip(self, removed: Fin[n.suc]) -> Fin[n.suc] {
        fin_skip(n, removed, self)
    }
}

theorem fin_last_value(n: Nat) {
    fin_last(n).value = n
}

theorem fin_last_is_last(n: Nat) {
    fin_last(n).is_last
}

theorem fin_is_last_iff_value_suc_eq(n: Nat, x: Fin[n]) {
    x.is_last = (x.value.suc = n)
}

theorem fin_cast_suc_value(n: Nat, x: Fin[n]) {
    fin_cast_suc(n, x).value = x.value
}

theorem fin_zero_value(n: Nat) {
    fin_zero(n).value = Nat.0
}

theorem fin_zero_new(n: Nat) {
    Fin[n.suc].new(Nat.0) = Option.some(fin_zero(n))
}

theorem fin_last_new(n: Nat) {
    Fin[n.suc].new(n) = Option.some(fin_last(n))
}

define fin_of_nat_suc(n: Nat, k: Nat) -> Fin[n.suc] {
    match Fin[n.suc].new(k) {
        Option.none {
            fin_zero(n)
        }
        Option.some(i) {
            i
        }
    }
}

theorem fin_of_nat_suc_new_of_lt(n: Nat, k: Nat) {
    k < n.suc implies Fin[n.suc].new(k) = Option.some(fin_of_nat_suc(n, k))
}

theorem fin_of_nat_suc_value_of_lt(n: Nat, k: Nat) {
    k < n.suc implies fin_of_nat_suc(n, k).value = k
}

theorem fin_succ_value(n: Nat, x: Fin[n]) {
    fin_succ(n, x).value = x.value.suc
}

theorem fin_skip_value_eq(n: Nat, removed: Fin[n.suc], x: Fin[n]) {
    fin_skip(n, removed, x).value = fin_skip_value(n, removed, x)
}

theorem fin_skip_ne_removed(n: Nat, removed: Fin[n.suc], x: Fin[n]) {
    fin_skip(n, removed, x) != removed
}

define fin_enum_suc(n: Nat) -> List[Fin[n.suc]] {
    map[Nat, Fin[n.suc]](n.suc.range, fin_of_nat_suc(n))
}

theorem fin_enum_suc_length(n: Nat) {
    fin_enum_suc(n).length = n.suc
}

theorem fin_enum_suc_get_idx(n: Nat, k: Nat) {
    k < n.suc implies fin_enum_suc(n).get_idx(k) = Option.some(fin_of_nat_suc(n, k))
}

theorem fin_enum_suc_get_idx_value(n: Nat, k: Nat, i: Fin[n.suc]) {
    k < n.suc and fin_enum_suc(n).get_idx(k) = Option.some(i) implies i.value = k
}

theorem fin_enum_suc_contains(n: Nat, i: Fin[n.suc]) {
    fin_enum_suc(n).contains(i)
}

theorem fin_enum_suc_contains_iff(n: Nat, i: Fin[n.suc]) {
    fin_enum_suc(n).contains(i) = true
}

theorem fin_enum_suc_map_contains_witness[T](n: Nat, f: Fin[n.suc] -> T, y: T) {
    map[Fin[n.suc], T](fin_enum_suc(n), f).contains(y) implies exists(i: Fin[n.suc]) {
        fin_enum_suc(n).contains(i) and f(i) = y
    }
}

theorem fin_enum_suc_filter_contains_iff(n: Nat, p: Fin[n.suc] -> Bool, i: Fin[n.suc]) {
    fin_enum_suc(n).filter(p).contains(i) = p(i)
}

theorem fin_enum_suc_filter_contains_pred(n: Nat, p: Fin[n.suc] -> Bool, i: Fin[n.suc]) {
    fin_enum_suc(n).filter(p).contains(i) implies p(i)
}

theorem fin_enum_suc_filter_contains_of_pred(n: Nat, p: Fin[n.suc] -> Bool, i: Fin[n.suc]) {
    p(i) implies fin_enum_suc(n).filter(p).contains(i)
}

theorem fin_enum_suc_is_unique(n: Nat) {
    fin_enum_suc(n).is_unique
}

define fin_value_list[T: LinearOrder](n: Nat, f: Fin[n.suc] -> T) -> List[T] {
    map(fin_enum_suc(n), f)
}

theorem fin_value_list_contains[T: LinearOrder](n: Nat, f: Fin[n.suc] -> T, i: Fin[n.suc]) {
    fin_value_list[T](n, f).contains(f(i))
}

theorem fin_value_list_witness[T: LinearOrder](n: Nat, f: Fin[n.suc] -> T, y: T) {
    fin_value_list[T](n, f).contains(y) implies exists(i: Fin[n.suc]) { f(i) = y }
}

define fin_function_max[T: LinearOrder](n: Nat, f: Fin[n.suc] -> T) -> T {
    match fin_value_list(n, f) {
        List.nil {
            f(fin_zero(n))
        }
        List.cons(head, tail) {
            list_max(head, tail)
        }
    }
}

theorem fin_value_list_cons[T: LinearOrder](n: Nat, f: Fin[n.suc] -> T) {
    exists(head: T, tail: List[T]) {
        fin_value_list[T](n, f) = List.cons(head, tail)
    }
}

theorem fin_function_max_is_upper_bound[T: LinearOrder](
    n: Nat, f: Fin[n.suc] -> T, i: Fin[n.suc]
) {
    f(i) <= fin_function_max[T](n, f)
}

theorem fin_function_max_attained[T: LinearOrder](n: Nat, f: Fin[n.suc] -> T) {
    exists(i: Fin[n.suc]) { f(i) = fin_function_max[T](n, f) }
}

theorem fin_function_max_le[T: LinearOrder](n: Nat, f: Fin[n.suc] -> T, b: T) {
    (forall(i: Fin[n.suc]) { f(i) <= b }) implies fin_function_max[T](n, f) <= b
}

define fin_of_nat_option(n: Nat, k: Nat) -> Option[Fin[n]] {
    Fin[n].new(k)
}

define fin_value_or_zero[A: Zero](n: Nat, f: Fin[n] -> A, k: Nat) -> A {
    match fin_of_nat_option(n, k) {
        Option.none {
            A.0
        }
        Option.some(i) {
            f(i)
        }
    }
}

theorem fin_value_or_zero_value[A: Zero](n: Nat, f: Fin[n] -> A, i: Fin[n]) {
    fin_value_or_zero[A](n, f, i.value) = f(i)
}

define fin_pointwise_add[A: Add](n: Nat, f: Fin[n] -> A, g: Fin[n] -> A, i: Fin[n]) -> A {
    f(i) + g(i)
}

define fin_zero_function[A: Zero](n: Nat, i: Fin[n]) -> A {
    A.0
}

define nat_zero_function[A: Zero](k: Nat) -> A {
    A.0
}

define fin_sum[A: AddCommMonoid](n: Nat, f: Fin[n] -> A) -> A {
    partial(fin_value_or_zero[A](n, f), n)
}

theorem fin_sum_apply[A: AddCommMonoid](n: Nat, f: Fin[n] -> A) {
    fin_sum[A](n, f) = partial(fin_value_or_zero[A](n, f), n)
}

theorem fin_value_or_zero_add[A: AddCommMonoid](n: Nat, f: Fin[n] -> A, g: Fin[n] -> A, k: Nat) {
    fin_value_or_zero[A](n, fin_pointwise_add[A](n, f, g), k) =
        fin_value_or_zero[A](n, f, k) + fin_value_or_zero[A](n, g, k)
}

theorem fin_sum_add[A: AddCommMonoid](n: Nat, f: Fin[n] -> A, g: Fin[n] -> A) {
    fin_sum[A](n, fin_pointwise_add[A](n, f, g)) = fin_sum[A](n, f) + fin_sum[A](n, g)
}

theorem fin_sum_pointwise_eq[A: AddCommMonoid](n: Nat, f: Fin[n] -> A, g: Fin[n] -> A) {
    (forall(i: Fin[n]) { f(i) = g(i) }) implies fin_sum[A](n, f) = fin_sum[A](n, g)
}

theorem fin_sum_zero_of_bound_zero[A: AddCommMonoid](n: Nat, f: Fin[n] -> A) {
    n = Nat.0 implies fin_sum[A](n, f) = A.0
}

theorem partial_nat_zero_function[A: AddCommMonoid](n: Nat) {
    partial(nat_zero_function[A], n) = A.0
}

theorem fin_value_or_zero_zero_function[A: AddCommMonoid](n: Nat, k: Nat) {
    fin_value_or_zero[A](n, fin_zero_function[A](n), k) = nat_zero_function[A](k)
}

theorem fin_sum_zero_function[A: AddCommMonoid](n: Nat) {
    fin_sum[A](n, fin_zero_function[A](n)) = A.0
}

theorem fin_value_or_zero_of_not_lt[A: Zero](n: Nat, f: Fin[n] -> A, k: Nat) {
    not k < n implies fin_value_or_zero[A](n, f, k) = A.0
}

theorem fin_value_or_zero_of_fin_of_nat_suc[A: Zero](n: Nat, f: Fin[n.suc] -> A, k: Nat) {
    k < n.suc implies fin_value_or_zero[A](n.suc, f, k) = f(fin_of_nat_suc(n, k))
}

define fin_of_nat_suc_apply[A](n: Nat, f: Fin[n.suc] -> A, k: Nat) -> A {
    f(fin_of_nat_suc(n, k))
}

theorem map_fin_enum_suc_eq_range_apply[A](n: Nat, f: Fin[n.suc] -> A) {
    map[Fin[n.suc], A](fin_enum_suc(n), f) = map[Nat, A](n.suc.range, fin_of_nat_suc_apply[A](n, f))
}

theorem fin_sum_suc_eq_sum_fin_enum_suc[A: AddCommMonoid](n: Nat, f: Fin[n.suc] -> A) {
    fin_sum[A](n.suc, f) = sum(map(fin_enum_suc(n), f))
}

define nat_single_nonzero[A: Zero](value: A, target: Nat, k: Nat) -> A {
    if k = target {
        value
    } else {
        A.0
    }
}

theorem partial_nat_single_nonzero_zero_before[A: AddCommMonoid](value: A, target: Nat, n: Nat) {
    n <= target implies partial[A](nat_single_nonzero[A](value, target), n) = A.0
}

theorem partial_nat_single_nonzero_of_lt[A: AddCommMonoid](value: A, target: Nat, n: Nat) {
    target < n implies partial[A](nat_single_nonzero[A](value, target), n) = value
}

theorem fin_sum_single_nonzero[A: AddCommMonoid](n: Nat, f: Fin[n] -> A, target: Fin[n]) {
    (forall(i: Fin[n]) { i != target implies f(i) = A.0 }) implies
        fin_sum[A](n, f) = f(target)
}

theorem sum_fin_enum_suc_eq_fin_sum[A: AddCommMonoid](n: Nat, f: Fin[n.suc] -> A) {
    sum(map(fin_enum_suc(n), f)) = fin_sum[A](n.suc, f)
}

theorem map_fin_singleton[A](n: Nat, f: Fin[n] -> A, i: Fin[n]) {
    map(List.singleton(i), f) = List.singleton(f(i))
}

theorem sum_map_fin_singleton[A: AddCommMonoid](n: Nat, f: Fin[n] -> A, i: Fin[n]) {
    sum(map(List.singleton(i), f)) = f(i)
}

theorem sum_map_fin_append[A: AddCommMonoid](n: Nat, left: List[Fin[n]], right: List[Fin[n]], f: Fin[n] -> A) {
    sum(map(left + right, f)) = sum(map(left, f)) + sum(map(right, f))
}

theorem fin_sum_suc_map_enum_bridge[A: AddCommMonoid](n: Nat, f: Fin[n.suc] -> A) {
    fin_sum[A](n.suc, f) = sum(map(fin_enum_suc(n), f)) and
    sum(map(fin_enum_suc(n), f)) = fin_sum[A](n.suc, f)
}

define fin_succ_apply[A](n: Nat, f: Fin[n.suc] -> A, i: Fin[n]) -> A {
    f(fin_succ(n, i))
}

theorem fin_value_or_zero_succ_index[A: Zero](n: Nat, f: Fin[n.suc] -> A, k: Nat) {
    k < n implies fin_value_or_zero[A](n.suc, f, k.suc) =
        fin_value_or_zero[A](n, fin_succ_apply[A](n, f), k)
}

theorem fin_sum_suc_split_zero[A: AddCommMonoid](n: Nat, f: Fin[n.suc] -> A) {
    fin_sum[A](n.suc, f) = f(fin_zero(n)) + fin_sum[A](n, fin_succ_apply[A](n, f))
}

define fin_vector_zero[A: Zero](n: Nat, i: Fin[n]) -> A {
    A.0
}

define fin_vector_add[A: Add](n: Nat, v: Fin[n] -> A, w: Fin[n] -> A, i: Fin[n]) -> A {
    v(i) + w(i)
}

define fin_vector_neg[A: Neg](n: Nat, v: Fin[n] -> A, i: Fin[n]) -> A {
    -v(i)
}

define fin_vector_sub[A: AddGroup](n: Nat, v: Fin[n] -> A, w: Fin[n] -> A, i: Fin[n]) -> A {
    v(i) - w(i)
}

define fin_vector_smul[R: Ring, M: AddCommGroup](
    carrier: Module[R, M], n: Nat, r: R, v: Fin[n] -> M, i: Fin[n]
) -> M {
    carrier.smul(r, v(i))
}

theorem fin_vector_ext[A](n: Nat, v: Fin[n] -> A, w: Fin[n] -> A) {
    (forall(i: Fin[n]) { v(i) = w(i) }) implies v = w
}

theorem fin_vector_zero_apply[A: Zero](n: Nat, i: Fin[n]) {
    fin_vector_zero[A](n, i) = A.0
}

theorem fin_vector_eq_apply[A](n: Nat, v: Fin[n] -> A, w: Fin[n] -> A, i: Fin[n]) {
    v = w implies v(i) = w(i)
}

theorem fin_vector_add_apply[A: Add](n: Nat, v: Fin[n] -> A, w: Fin[n] -> A, i: Fin[n]) {
    fin_vector_add[A](n, v, w, i) = v(i) + w(i)
}

theorem fin_vector_neg_apply[A: Neg](n: Nat, v: Fin[n] -> A, i: Fin[n]) {
    fin_vector_neg[A](n, v, i) = -v(i)
}

theorem fin_vector_sub_apply[A: AddGroup](n: Nat, v: Fin[n] -> A, w: Fin[n] -> A, i: Fin[n]) {
    fin_vector_sub[A](n, v, w, i) = v(i) - w(i)
}

theorem fin_vector_smul_apply[R: Ring, M: AddCommGroup](
    carrier: Module[R, M], n: Nat, r: R, v: Fin[n] -> M, i: Fin[n]
) {
    fin_vector_smul[R, M](carrier, n, r, v, i) = carrier.smul(r, v(i))
}

theorem fin_vector_add_assoc_at[A: AddSemigroup](
    n: Nat, u: Fin[n] -> A, v: Fin[n] -> A, w: Fin[n] -> A, i: Fin[n]
) {
    fin_vector_add[A](n, u, fin_vector_add[A](n, v, w), i) =
        fin_vector_add[A](n, fin_vector_add[A](n, u, v), w, i)
}

theorem fin_vector_add_comm_at[A: AddCommSemigroup](n: Nat, v: Fin[n] -> A, w: Fin[n] -> A, i: Fin[n]) {
    fin_vector_add[A](n, v, w, i) = fin_vector_add[A](n, w, v, i)
}

theorem fin_vector_add_zero_right_at[A: AddMonoid](n: Nat, v: Fin[n] -> A, i: Fin[n]) {
    fin_vector_add[A](n, v, fin_vector_zero[A](n), i) = v(i)
}

theorem fin_vector_add_zero_left_at[A: AddMonoid](n: Nat, v: Fin[n] -> A, i: Fin[n]) {
    fin_vector_add[A](n, fin_vector_zero[A](n), v, i) = v(i)
}

theorem fin_vector_add_neg_right_at[A: AddGroup](n: Nat, v: Fin[n] -> A, i: Fin[n]) {
    fin_vector_add[A](n, v, fin_vector_neg[A](n, v), i) = fin_vector_zero[A](n, i)
}

theorem fin_vector_add_neg_left_at[A: AddGroup](n: Nat, v: Fin[n] -> A, i: Fin[n]) {
    fin_vector_add[A](n, fin_vector_neg[A](n, v), v, i) = fin_vector_zero[A](n, i)
}

theorem fin_vector_sub_eq_add_neg_at[A: AddGroup](n: Nat, v: Fin[n] -> A, w: Fin[n] -> A, i: Fin[n]) {
    fin_vector_sub[A](n, v, w, i) = fin_vector_add[A](n, v, fin_vector_neg[A](n, w), i)
}

theorem fin_vector_smul_one_at[R: Ring, M: AddCommGroup](carrier: Module[R, M], n: Nat, v: Fin[n] -> M, i: Fin[n]) {
    fin_vector_smul[R, M](carrier, n, R.1, v, i) = v(i)
}

theorem fin_vector_smul_zero_left_at[R: Ring, M: AddCommGroup](carrier: Module[R, M], n: Nat, v: Fin[n] -> M, i: Fin[n]) {
    fin_vector_smul[R, M](carrier, n, R.0, v, i) = M.0
}

theorem fin_vector_smul_zero_right_coord[R: Ring, M: AddCommGroup](carrier: Module[R, M], n: Nat, r: R, i: Fin[n]) {
    carrier.smul(r, M.0) = M.0
}

theorem fin_vector_smul_neg_coord[R: Ring, M: AddCommGroup](carrier: Module[R, M], n: Nat, r: R, v: Fin[n] -> M, i: Fin[n]) {
    carrier.smul(r, -v(i)) = -fin_vector_smul[R, M](carrier, n, r, v, i)
}

theorem fin_vector_smul_neg_left_at[R: Ring, M: AddCommGroup](carrier: Module[R, M], n: Nat, r: R, v: Fin[n] -> M, i: Fin[n]) {
    fin_vector_smul[R, M](carrier, n, -r, v, i) =
        fin_vector_neg[M](n, fin_vector_smul[R, M](carrier, n, r, v), i)
}

theorem fin_vector_smul_add_left_at[R: Ring, M: AddCommGroup](
    carrier: Module[R, M], n: Nat, r: R, s: R, v: Fin[n] -> M, i: Fin[n]
) {
    fin_vector_smul[R, M](carrier, n, r + s, v, i) =
        fin_vector_add[M](n, fin_vector_smul[R, M](carrier, n, r, v), fin_vector_smul[R, M](carrier, n, s, v), i)
}

theorem fin_vector_smul_add_right_at[R: Ring, M: AddCommGroup](
    carrier: Module[R, M], n: Nat, r: R, v: Fin[n] -> M, w: Fin[n] -> M, i: Fin[n]
) {
    fin_vector_smul[R, M](carrier, n, r, fin_vector_add[M](n, v, w), i) =
        fin_vector_add[M](n, fin_vector_smul[R, M](carrier, n, r, v), fin_vector_smul[R, M](carrier, n, r, w), i)
}

theorem fin_vector_smul_assoc_at[R: Ring, M: AddCommGroup](
    carrier: Module[R, M], n: Nat, r: R, s: R, v: Fin[n] -> M, i: Fin[n]
) {
    fin_vector_smul[R, M](carrier, n, r * s, v, i) =
        fin_vector_smul[R, M](carrier, n, r, fin_vector_smul[R, M](carrier, n, s, v), i)
}

theorem fin_vector_smul_zero_right_at[R: Ring, M: AddCommGroup](carrier: Module[R, M], n: Nat, r: R, i: Fin[n]) {
    fin_vector_smul[R, M](carrier, n, r, fin_vector_zero[M](n), i) = fin_vector_zero[M](n, i)
}

theorem fin_vector_smul_neg_right_at[R: Ring, M: AddCommGroup](carrier: Module[R, M], n: Nat, r: R, v: Fin[n] -> M, i: Fin[n]) {
    fin_vector_smul[R, M](carrier, n, r, fin_vector_neg[M](n, v), i) =
        fin_vector_neg[M](n, fin_vector_smul[R, M](carrier, n, r, v), i)
}

theorem fin_vector_add_assoc[A: AddSemigroup](n: Nat, u: Fin[n] -> A, v: Fin[n] -> A, w: Fin[n] -> A) {
    fin_vector_add[A](n, u, fin_vector_add[A](n, v, w)) =
        fin_vector_add[A](n, fin_vector_add[A](n, u, v), w)
}

theorem fin_vector_add_comm[A: AddCommSemigroup](n: Nat, v: Fin[n] -> A, w: Fin[n] -> A) {
    fin_vector_add[A](n, v, w) = fin_vector_add[A](n, w, v)
}

theorem fin_vector_add_zero_right[A: AddMonoid](n: Nat, v: Fin[n] -> A) {
    fin_vector_add[A](n, v, fin_vector_zero[A](n)) = v
}

theorem fin_vector_add_zero_left[A: AddMonoid](n: Nat, v: Fin[n] -> A) {
    fin_vector_add[A](n, fin_vector_zero[A](n), v) = v
}

theorem fin_vector_add_neg_right[A: AddGroup](n: Nat, v: Fin[n] -> A) {
    fin_vector_add[A](n, v, fin_vector_neg[A](n, v)) = fin_vector_zero[A](n)
}

theorem fin_vector_add_neg_left[A: AddGroup](n: Nat, v: Fin[n] -> A) {
    fin_vector_add[A](n, fin_vector_neg[A](n, v), v) = fin_vector_zero[A](n)
}

theorem fin_vector_sub_eq_add_neg[A: AddGroup](n: Nat, v: Fin[n] -> A, w: Fin[n] -> A) {
    fin_vector_sub[A](n, v, w) = fin_vector_add[A](n, v, fin_vector_neg[A](n, w))
}

theorem fin_vector_smul_one[R: Ring, M: AddCommGroup](carrier: Module[R, M], n: Nat, v: Fin[n] -> M) {
    fin_vector_smul[R, M](carrier, n, R.1, v) = v
}

theorem fin_vector_smul_zero_left[R: Ring, M: AddCommGroup](carrier: Module[R, M], n: Nat, v: Fin[n] -> M) {
    fin_vector_smul[R, M](carrier, n, R.0, v) = fin_vector_zero[M](n)
}

theorem fin_vector_smul_zero_right[R: Ring, M: AddCommGroup](carrier: Module[R, M], n: Nat, r: R) {
    fin_vector_smul[R, M](carrier, n, r, fin_vector_zero[M](n)) = fin_vector_zero[M](n)
}

theorem fin_vector_smul_neg[R: Ring, M: AddCommGroup](carrier: Module[R, M], n: Nat, r: R, v: Fin[n] -> M) {
    fin_vector_smul[R, M](carrier, n, r, fin_vector_neg[M](n, v)) =
        fin_vector_neg[M](n, fin_vector_smul[R, M](carrier, n, r, v))
}

structure Matrix[A, m: Nat, n: Nat] {
    /// The entry function of the matrix.
    entry: (Fin[m], Fin[n]) -> A
}

define matrix_entry[A](m: Nat, n: Nat, a: Matrix[A, m, n], i: Fin[m], j: Fin[n]) -> A {
    a.entry(i, j)
}

define matrix_zero_entry[A: Zero](m: Nat, n: Nat, i: Fin[m], j: Fin[n]) -> A {
    A.0
}

define matrix_zero[A: Zero](m: Nat, n: Nat) -> Matrix[A, m, n] {
    Matrix[A, m, n].new(matrix_zero_entry[A](m, n))
}

define matrix_add_entry[A: Add](m: Nat, n: Nat, a: Matrix[A, m, n], b: Matrix[A, m, n], i: Fin[m], j: Fin[n]) -> A {
    a.entry(i, j) + b.entry(i, j)
}

define matrix_add[A: Add](m: Nat, n: Nat, a: Matrix[A, m, n], b: Matrix[A, m, n]) -> Matrix[A, m, n] {
    Matrix[A, m, n].new(matrix_add_entry[A](m, n, a, b))
}

define matrix_neg_entry[A: Neg](m: Nat, n: Nat, a: Matrix[A, m, n], i: Fin[m], j: Fin[n]) -> A {
    -a.entry(i, j)
}

define matrix_neg[A: Neg](m: Nat, n: Nat, a: Matrix[A, m, n]) -> Matrix[A, m, n] {
    Matrix[A, m, n].new(matrix_neg_entry[A](m, n, a))
}

define matrix_sub_entry[A: AddGroup](m: Nat, n: Nat, a: Matrix[A, m, n], b: Matrix[A, m, n], i: Fin[m], j: Fin[n]) -> A {
    a.entry(i, j) - b.entry(i, j)
}

define matrix_sub[A: AddGroup](m: Nat, n: Nat, a: Matrix[A, m, n], b: Matrix[A, m, n]) -> Matrix[A, m, n] {
    Matrix[A, m, n].new(matrix_sub_entry[A](m, n, a, b))
}

define matrix_smul_entry[R: Ring, M: AddCommGroup](
    carrier: Module[R, M], m: Nat, n: Nat, r: R, a: Matrix[M, m, n], i: Fin[m], j: Fin[n]
) -> M {
    carrier.smul(r, a.entry(i, j))
}

define matrix_smul[R: Ring, M: AddCommGroup](
    carrier: Module[R, M], m: Nat, n: Nat, r: R, a: Matrix[M, m, n]
) -> Matrix[M, m, n] {
    Matrix[M, m, n].new(matrix_smul_entry[R, M](carrier, m, n, r, a))
}

define matrix_transpose_entry[A](m: Nat, n: Nat, a: Matrix[A, m, n], j: Fin[n], i: Fin[m]) -> A {
    a.entry(i, j)
}

define matrix_transpose[A](m: Nat, n: Nat, a: Matrix[A, m, n]) -> Matrix[A, n, m] {
    Matrix[A, n, m].new(matrix_transpose_entry[A](m, n, a))
}

define matrix_row[A](m: Nat, n: Nat, a: Matrix[A, m, n], i: Fin[m], j: Fin[n]) -> A {
    a.entry(i, j)
}

define matrix_col[A](m: Nat, n: Nat, a: Matrix[A, m, n], j: Fin[n], i: Fin[m]) -> A {
    a.entry(i, j)
}

define matrix_mul_term[S: Semiring](
    m: Nat,
    n: Nat,
    p: Nat,
    a: Matrix[S, m, n],
    b: Matrix[S, n, p],
    i: Fin[m],
    j: Fin[p],
    k: Fin[n]
) -> S {
    matrix_entry[S](m, n, a, i, k) * matrix_entry[S](n, p, b, k, j)
}

define matrix_mul_entry[S: Semiring](
    m: Nat,
    n: Nat,
    p: Nat,
    a: Matrix[S, m, n],
    b: Matrix[S, n, p],
    i: Fin[m],
    j: Fin[p]
) -> S {
    fin_sum[S](n, matrix_mul_term[S](m, n, p, a, b, i, j))
}

define matrix_mul[S: Semiring](m: Nat, n: Nat, p: Nat, a: Matrix[S, m, n], b: Matrix[S, n, p]) -> Matrix[S, m, p] {
    Matrix[S, m, p].new(matrix_mul_entry[S](m, n, p, a, b))
}

define matrix_one_entry[S: Semiring](n: Nat, i: Fin[n], j: Fin[n]) -> S {
    if i = j {
        S.1
    } else {
        S.0
    }
}

define matrix_one[S: Semiring](n: Nat) -> Matrix[S, n, n] {
    Matrix[S, n, n].new(matrix_one_entry[S](n))
}

define square_matrix_mul[S: Semiring](n: Nat, a: Matrix[S, n, n], b: Matrix[S, n, n]) -> Matrix[S, n, n] {
    matrix_mul[S](n, n, n, a, b)
}

define matrix_pow[S: Semiring](n: Nat, a: Matrix[S, n, n], exp: Nat) -> Matrix[S, n, n] {
    match exp {
        Nat.zero {
            matrix_one[S](n)
        }
        Nat.suc(k) {
            square_matrix_mul[S](n, a, matrix_pow[S](n, a, k))
        }
    }
}

define matrix_minor_entry[A](n: Nat, a: Matrix[A, n.suc, n.suc], row: Fin[n.suc], col: Fin[n.suc], i: Fin[n], j: Fin[n]) -> A {
    matrix_entry[A](n.suc, n.suc, a, fin_skip(n, row, i), fin_skip(n, col, j))
}

define matrix_minor[A](n: Nat, a: Matrix[A, n.suc, n.suc], row: Fin[n.suc], col: Fin[n.suc]) -> Matrix[A, n, n] {
    Matrix[A, n, n].new(matrix_minor_entry[A](n, a, row, col))
}

define matrix_cofactor_sign[R: Ring](n: Nat, row: Fin[n], col: Fin[n]) -> R {
    alternating_sign[R](row.value + col.value)
}

define matrix_cofactor_with[R: Ring](n: Nat, det_small: Matrix[R, n, n] -> R, a: Matrix[R, n.suc, n.suc], row: Fin[n.suc], col: Fin[n.suc]) -> R {
    matrix_cofactor_sign[R](n.suc, row, col) * det_small(matrix_minor[R](n, a, row, col))
}

define matrix_laplace_row_term[R: Ring](n: Nat, det_small: Matrix[R, n, n] -> R, a: Matrix[R, n.suc, n.suc], row: Fin[n.suc], col: Fin[n.suc]) -> R {
    matrix_entry[R](n.suc, n.suc, a, row, col) * matrix_cofactor_with[R](n, det_small, a, row, col)
}

define matrix_laplace_row[R: Ring](n: Nat, det_small: Matrix[R, n, n] -> R, a: Matrix[R, n.suc, n.suc], row: Fin[n.suc]) -> R {
    fin_sum[R](n.suc, matrix_laplace_row_term[R](n, det_small, a, row))
}

define matrix_laplace_first_row_term[R: Ring](n: Nat, det_small: Matrix[R, n, n] -> R, a: Matrix[R, n.suc, n.suc], col: Fin[n.suc]) -> R {
    matrix_laplace_row_term[R](n, det_small, a, fin_zero(n), col)
}

define matrix_laplace_first_row[R: Ring](n: Nat, det_small: Matrix[R, n, n] -> R, a: Matrix[R, n.suc, n.suc]) -> R {
    matrix_laplace_row[R](n, det_small, a, fin_zero(n))
}

define matrix_zero_det_function[R: Ring](n: Nat, a: Matrix[R, n, n]) -> R {
    R.0
}

define list_index_or_zero[I](items: List[I], item: I) -> Nat {
    match items {
        List.nil {
            Nat.0
        }
        List.cons(head, tail) {
            if head = item {
                Nat.0
            } else {
                list_index_or_zero[I](tail, item).suc
            }
        }
    }
}

define determinant_list[R: Ring, I](entry: (I, I) -> R, rows: List[I], cols: List[I]) -> R {
    match rows {
        List.nil {
            R.1
        }
        List.cons(row, tail_rows) {
            sum[R](map[I, R](cols, function(col: I) {
                entry(row, col) *
                    alternating_sign[R](list_index_or_zero[I](cols, col)) *
                    determinant_list[R, I](entry, tail_rows, cols.remove_one(col))
            }))
        }
    }
}

define square_matrix_entry_function[A](n: Nat, a: Matrix[A, n, n], row: Fin[n], col: Fin[n]) -> A {
    matrix_entry[A](n, n, a, row, col)
}

define matrix_det_list[R: Ring](n: Nat, a: Matrix[R, n, n], rows: List[Fin[n]], cols: List[Fin[n]]) -> R {
    determinant_list[R, Fin[n]](square_matrix_entry_function[R](n, a), rows, cols)
}

attributes Matrix[A, m: Nat, n: Nat] {
    /// The entry at row `i` and column `j`.
    define at(self, i: Fin[m], j: Fin[n]) -> A {
        matrix_entry[A](m, n, self, i, j)
    }

    /// The transpose of this matrix.
    define transpose(self) -> Matrix[A, n, m] {
        matrix_transpose[A](m, n, self)
    }

    /// The `i`th row of this matrix.
    define row(self, i: Fin[m], j: Fin[n]) -> A {
        matrix_row[A](m, n, self, i, j)
    }

    /// The `j`th column of this matrix.
    define col(self, j: Fin[n], i: Fin[m]) -> A {
        matrix_col[A](m, n, self, j, i)
    }
}

attributes Matrix[A: Zero, m: Nat, n: Nat] {
    /// The zero matrix.
    let zero: Matrix[A, m, n] = matrix_zero[A](m, n)
}

attributes Matrix[A: Add, m: Nat, n: Nat] {
    /// The pointwise sum of two matrices.
    define add(self, other: Matrix[A, m, n]) -> Matrix[A, m, n] {
        matrix_add[A](m, n, self, other)
    }
}

attributes Matrix[A: Neg, m: Nat, n: Nat] {
    /// The pointwise additive inverse of a matrix.
    define neg(self) -> Matrix[A, m, n] {
        matrix_neg[A](m, n, self)
    }
}

attributes Matrix[A: AddGroup, m: Nat, n: Nat] {
    /// The pointwise difference of two matrices.
    define sub(self, other: Matrix[A, m, n]) -> Matrix[A, m, n] {
        matrix_sub[A](m, n, self, other)
    }
}

attributes Matrix[S: Semiring, m: Nat, n: Nat] {
    /// Matrix multiplication with a compatible right factor.
    define mul(self, p: Nat, other: Matrix[S, n, p]) -> Matrix[S, m, p] {
        matrix_mul[S](m, n, p, self, other)
    }
}

instance Matrix[A: Add, m: Nat, n: Nat]: Add {
    let add = Matrix[A, m, n].add
}

instance Matrix[A: Zero, m: Nat, n: Nat]: Zero {
    let 0 = Matrix[A, m, n].zero
}

instance Matrix[A: Neg, m: Nat, n: Nat]: Neg {
    let neg = Matrix[A, m, n].neg
}

theorem matrix_entry_self[A](m: Nat, n: Nat, a: Matrix[A, m, n], i: Fin[m], j: Fin[n]) {
    matrix_entry[A](m, n, a, i, j) = a.entry(i, j)
}

theorem matrix_ext[A](m: Nat, n: Nat, a: Matrix[A, m, n], b: Matrix[A, m, n]) {
    (forall(i: Fin[m], j: Fin[n]) { matrix_entry[A](m, n, a, i, j) = matrix_entry[A](m, n, b, i, j) }) implies a = b
}

theorem matrix_entry_zero[A: Zero](m: Nat, n: Nat, i: Fin[m], j: Fin[n]) {
    matrix_entry[A](m, n, matrix_zero[A](m, n), i, j) = A.0
}

theorem matrix_entry_add[A: Add](m: Nat, n: Nat, a: Matrix[A, m, n], b: Matrix[A, m, n], i: Fin[m], j: Fin[n]) {
    matrix_entry[A](m, n, a + b, i, j) = matrix_entry[A](m, n, a, i, j) + matrix_entry[A](m, n, b, i, j)
}

theorem matrix_entry_neg[A: Neg](m: Nat, n: Nat, a: Matrix[A, m, n], i: Fin[m], j: Fin[n]) {
    matrix_entry[A](m, n, -a, i, j) = -matrix_entry[A](m, n, a, i, j)
}

theorem matrix_entry_sub[A: AddGroup](m: Nat, n: Nat, a: Matrix[A, m, n], b: Matrix[A, m, n], i: Fin[m], j: Fin[n]) {
    matrix_entry[A](m, n, matrix_sub[A](m, n, a, b), i, j) = matrix_entry[A](m, n, a, i, j) - matrix_entry[A](m, n, b, i, j)
}

theorem matrix_entry_smul[R: Ring, M: AddCommGroup](
    carrier: Module[R, M], m: Nat, n: Nat, r: R, a: Matrix[M, m, n], i: Fin[m], j: Fin[n]
) {
    matrix_entry[M](m, n, matrix_smul[R, M](carrier, m, n, r, a), i, j) = carrier.smul(r, matrix_entry[M](m, n, a, i, j))
}

theorem matrix_entry_transpose[A](m: Nat, n: Nat, a: Matrix[A, m, n], i: Fin[m], j: Fin[n]) {
    matrix_entry[A](n, m, matrix_transpose[A](m, n, a), j, i) = matrix_entry[A](m, n, a, i, j)
}

theorem matrix_row_entry[A](m: Nat, n: Nat, a: Matrix[A, m, n], i: Fin[m], j: Fin[n]) {
    matrix_row[A](m, n, a, i, j) = matrix_entry[A](m, n, a, i, j)
}

theorem matrix_col_entry[A](m: Nat, n: Nat, a: Matrix[A, m, n], j: Fin[n], i: Fin[m]) {
    matrix_col[A](m, n, a, j, i) = matrix_entry[A](m, n, a, i, j)
}

theorem matrix_entry_mul[S: Semiring](m: Nat, n: Nat, p: Nat, a: Matrix[S, m, n], b: Matrix[S, n, p], i: Fin[m], j: Fin[p]) {
    matrix_entry[S](m, p, matrix_mul[S](m, n, p, a, b), i, j) = fin_sum[S](n, matrix_mul_term[S](m, n, p, a, b, i, j))
}

theorem matrix_entry_one_diag[S: Semiring](n: Nat, i: Fin[n]) {
    matrix_entry[S](n, n, matrix_one[S](n), i, i) = S.1
}

theorem matrix_entry_one_off_diag[S: Semiring](n: Nat, i: Fin[n], j: Fin[n]) {
    i != j implies matrix_entry[S](n, n, matrix_one[S](n), i, j) = S.0
}

theorem matrix_transpose_one[S: Semiring](n: Nat) {
    matrix_transpose[S](n, n, matrix_one[S](n)) = matrix_one[S](n)
}

theorem matrix_mul_one_right[S: Semiring](m: Nat, n: Nat, a: Matrix[S, m, n]) {
    matrix_mul[S](m, n, n, a, matrix_one[S](n)) = a
}

theorem matrix_mul_one_left[S: Semiring](m: Nat, n: Nat, a: Matrix[S, m, n]) {
    matrix_mul[S](m, m, n, matrix_one[S](m), a) = a
}

theorem matrix_entry_square_mul[S: Semiring](n: Nat, a: Matrix[S, n, n], b: Matrix[S, n, n], i: Fin[n], j: Fin[n]) {
    matrix_entry[S](n, n, square_matrix_mul[S](n, a, b), i, j) = fin_sum[S](n, matrix_mul_term[S](n, n, n, a, b, i, j))
}

theorem matrix_entry_minor[A](n: Nat, a: Matrix[A, n.suc, n.suc], row: Fin[n.suc], col: Fin[n.suc], i: Fin[n], j: Fin[n]) {
    matrix_entry[A](n, n, matrix_minor[A](n, a, row, col), i, j) =
        matrix_entry[A](n.suc, n.suc, a, fin_skip(n, row, i), fin_skip(n, col, j))
}

theorem matrix_minor_zero[A: Zero](n: Nat, row: Fin[n.suc], col: Fin[n.suc]) {
    matrix_minor[A](n, matrix_zero[A](n.suc, n.suc), row, col) = matrix_zero[A](n, n)
}

theorem matrix_minor_add[A: Add](n: Nat, a: Matrix[A, n.suc, n.suc], b: Matrix[A, n.suc, n.suc], row: Fin[n.suc], col: Fin[n.suc]) {
    matrix_minor[A](n, a + b, row, col) = matrix_minor[A](n, a, row, col) + matrix_minor[A](n, b, row, col)
}

theorem matrix_minor_neg[A: Neg](n: Nat, a: Matrix[A, n.suc, n.suc], row: Fin[n.suc], col: Fin[n.suc]) {
    matrix_minor[A](n, -a, row, col) = -matrix_minor[A](n, a, row, col)
}

theorem matrix_minor_sub[A: AddGroup](n: Nat, a: Matrix[A, n.suc, n.suc], b: Matrix[A, n.suc, n.suc], row: Fin[n.suc], col: Fin[n.suc]) {
    matrix_minor[A](n, matrix_sub[A](n.suc, n.suc, a, b), row, col) = matrix_sub[A](n, n, matrix_minor[A](n, a, row, col), matrix_minor[A](n, b, row, col))
}

theorem matrix_minor_smul[R: Ring, M: AddCommGroup](carrier: Module[R, M], n: Nat, r: R, a: Matrix[M, n.suc, n.suc], row: Fin[n.suc], col: Fin[n.suc]) {
    matrix_minor[M](n, matrix_smul[R, M](carrier, n.suc, n.suc, r, a), row, col) =
        matrix_smul[R, M](carrier, n, n, r, matrix_minor[M](n, a, row, col))
}

theorem matrix_minor_transpose[A](n: Nat, a: Matrix[A, n.suc, n.suc], row: Fin[n.suc], col: Fin[n.suc]) {
    matrix_minor[A](n, matrix_transpose[A](n.suc, n.suc, a), row, col) = matrix_transpose[A](n, n, matrix_minor[A](n, a, col, row))
}

theorem matrix_cofactor_with_eq[R: Ring](n: Nat, det_small: Matrix[R, n, n] -> R, a: Matrix[R, n.suc, n.suc], row: Fin[n.suc], col: Fin[n.suc]) {
    matrix_cofactor_with[R](n, det_small, a, row, col) =
        matrix_cofactor_sign[R](n.suc, row, col) * det_small(matrix_minor[R](n, a, row, col))
}

theorem matrix_laplace_row_term_eq[R: Ring](n: Nat, det_small: Matrix[R, n, n] -> R, a: Matrix[R, n.suc, n.suc], row: Fin[n.suc], col: Fin[n.suc]) {
    matrix_laplace_row_term[R](n, det_small, a, row, col) =
        matrix_entry[R](n.suc, n.suc, a, row, col) * matrix_cofactor_with[R](n, det_small, a, row, col)
}

theorem matrix_laplace_first_row_eq_row[R: Ring](n: Nat, det_small: Matrix[R, n, n] -> R, a: Matrix[R, n.suc, n.suc]) {
    matrix_laplace_first_row[R](n, det_small, a) = matrix_laplace_row[R](n, det_small, a, fin_zero(n))
}

theorem matrix_cofactor_with_zero_det[R: Ring](n: Nat, a: Matrix[R, n.suc, n.suc], row: Fin[n.suc], col: Fin[n.suc]) {
    matrix_cofactor_with[R](n, matrix_zero_det_function[R](n), a, row, col) = R.0
}

theorem matrix_laplace_row_term_zero_det[R: Ring](n: Nat, a: Matrix[R, n.suc, n.suc], row: Fin[n.suc], col: Fin[n.suc]) {
    matrix_laplace_row_term[R](n, matrix_zero_det_function[R](n), a, row, col) = R.0
}

theorem matrix_laplace_row_zero_det[R: Ring](n: Nat, a: Matrix[R, n.suc, n.suc], row: Fin[n.suc]) {
    matrix_laplace_row[R](n, matrix_zero_det_function[R](n), a, row) = R.0
}

theorem matrix_laplace_first_row_zero_det[R: Ring](n: Nat, a: Matrix[R, n.suc, n.suc]) {
    matrix_laplace_first_row[R](n, matrix_zero_det_function[R](n), a) = R.0
}

theorem matrix_laplace_row_term_zero_matrix[R: Ring](n: Nat, det_small: Matrix[R, n, n] -> R, row: Fin[n.suc], col: Fin[n.suc]) {
    matrix_laplace_row_term[R](n, det_small, matrix_zero[R](n.suc, n.suc), row, col) = R.0
}

theorem matrix_laplace_row_zero_matrix[R: Ring](n: Nat, det_small: Matrix[R, n, n] -> R, row: Fin[n.suc]) {
    matrix_laplace_row[R](n, det_small, matrix_zero[R](n.suc, n.suc), row) = R.0
}

theorem matrix_laplace_first_row_zero_matrix[R: Ring](n: Nat, det_small: Matrix[R, n, n] -> R) {
    matrix_laplace_first_row[R](n, det_small, matrix_zero[R](n.suc, n.suc)) = R.0
}

theorem determinant_list_nil_rows[R: Ring, I](entry: (I, I) -> R, cols: List[I]) {
    determinant_list[R, I](entry, List.nil[I], cols) = R.1
}

theorem list_index_or_zero_nil[I](item: I) {
    list_index_or_zero[I](List.nil[I], item) = Nat.0
}

theorem list_index_or_zero_cons_self[I](head: I, tail: List[I]) {
    list_index_or_zero[I](List.cons(head, tail), head) = Nat.0
}

theorem list_index_or_zero_cons_other[I](head: I, tail: List[I], item: I) {
    head != item implies list_index_or_zero[I](List.cons(head, tail), item) = list_index_or_zero[I](tail, item).suc
}

theorem determinant_list_cons_rows[R: Ring, I](entry: (I, I) -> R, row: I, tail_rows: List[I], cols: List[I]) {
    determinant_list[R, I](entry, List.cons(row, tail_rows), cols) =
        sum[R](map[I, R](cols, function(col: I) {
            entry(row, col) *
                alternating_sign[R](list_index_or_zero[I](cols, col)) *
                determinant_list[R, I](entry, tail_rows, cols.remove_one(col))
        }))
}

theorem matrix_det_list_nil_rows[R: Ring](n: Nat, a: Matrix[R, n, n], cols: List[Fin[n]]) {
    matrix_det_list[R](n, a, List.nil[Fin[n]], cols) = R.1
}

theorem matrix_det_list_cons_rows[R: Ring](n: Nat, a: Matrix[R, n, n], row: Fin[n], tail_rows: List[Fin[n]], cols: List[Fin[n]]) {
    matrix_det_list[R](n, a, List.cons(row, tail_rows), cols) =
        sum[R](map[Fin[n], R](cols, function(col: Fin[n]) {
            square_matrix_entry_function[R](n, a)(row, col) *
                alternating_sign[R](list_index_or_zero[Fin[n]](cols, col)) *
                determinant_list[R, Fin[n]](square_matrix_entry_function[R](n, a), tail_rows, cols.remove_one(col))
        }))
}

theorem matrix_mul_inner_zero[S: Semiring](m: Nat, n: Nat, p: Nat, a: Matrix[S, m, n], b: Matrix[S, n, p], i: Fin[m], j: Fin[p]) {
    n = Nat.0 implies matrix_entry[S](m, p, matrix_mul[S](m, n, p, a, b), i, j) = S.0
}

theorem matrix_mul_zero_left_row[S: Semiring](m: Nat, n: Nat, p: Nat, a: Matrix[S, m, n], b: Matrix[S, n, p], i: Fin[m], j: Fin[p]) {
    (forall(k: Fin[n]) { matrix_entry[S](m, n, a, i, k) = S.0 }) implies matrix_entry[S](m, p, matrix_mul[S](m, n, p, a, b), i, j) = S.0
}

theorem matrix_mul_zero_right_col[S: Semiring](m: Nat, n: Nat, p: Nat, a: Matrix[S, m, n], b: Matrix[S, n, p], i: Fin[m], j: Fin[p]) {
    (forall(k: Fin[n]) { matrix_entry[S](n, p, b, k, j) = S.0 }) implies matrix_entry[S](m, p, matrix_mul[S](m, n, p, a, b), i, j) = S.0
}

theorem matrix_mul_zero_left[S: Semiring](m: Nat, n: Nat, p: Nat, b: Matrix[S, n, p]) {
    matrix_mul[S](m, n, p, matrix_zero[S](m, n), b) = matrix_zero[S](m, p)
}

theorem matrix_mul_zero_right[S: Semiring](m: Nat, n: Nat, p: Nat, a: Matrix[S, m, n]) {
    matrix_mul[S](m, n, p, a, matrix_zero[S](n, p)) = matrix_zero[S](m, p)
}

theorem square_matrix_mul_zero_left[S: Semiring](n: Nat, a: Matrix[S, n, n]) {
    square_matrix_mul[S](n, matrix_zero[S](n, n), a) = matrix_zero[S](n, n)
}

theorem square_matrix_mul_zero_right[S: Semiring](n: Nat, a: Matrix[S, n, n]) {
    square_matrix_mul[S](n, a, matrix_zero[S](n, n)) = matrix_zero[S](n, n)
}

theorem matrix_entry_mul_add_right[S: Semiring](
    m: Nat, n: Nat, p: Nat, a: Matrix[S, m, n], b: Matrix[S, n, p], c: Matrix[S, n, p], i: Fin[m], j: Fin[p]
) {
    matrix_entry[S](m, p, matrix_mul[S](m, n, p, a, b + c), i, j) =
        matrix_entry[S](m, p, matrix_mul[S](m, n, p, a, b), i, j) + matrix_entry[S](m, p, matrix_mul[S](m, n, p, a, c), i, j)
}

theorem matrix_mul_add_right[S: Semiring](
    m: Nat, n: Nat, p: Nat, a: Matrix[S, m, n], b: Matrix[S, n, p], c: Matrix[S, n, p]
) {
    matrix_mul[S](m, n, p, a, b + c) = matrix_mul[S](m, n, p, a, b) + matrix_mul[S](m, n, p, a, c)
}

theorem matrix_entry_mul_add_left[S: Semiring](
    m: Nat, n: Nat, p: Nat, a: Matrix[S, m, n], b: Matrix[S, m, n], c: Matrix[S, n, p], i: Fin[m], j: Fin[p]
) {
    matrix_entry[S](m, p, matrix_mul[S](m, n, p, a + b, c), i, j) =
        matrix_entry[S](m, p, matrix_mul[S](m, n, p, a, c), i, j) + matrix_entry[S](m, p, matrix_mul[S](m, n, p, b, c), i, j)
}

theorem matrix_mul_add_left[S: Semiring](
    m: Nat, n: Nat, p: Nat, a: Matrix[S, m, n], b: Matrix[S, m, n], c: Matrix[S, n, p]
) {
    matrix_mul[S](m, n, p, a + b, c) = matrix_mul[S](m, n, p, a, c) + matrix_mul[S](m, n, p, b, c)
}

define matrix_transpose_mul_rev_term[R: CommRing](m: Nat, n: Nat, p: Nat, a: Matrix[R, m, n], b: Matrix[R, n, p], i: Fin[m], j: Fin[p], k: Fin[n]) -> R {
    matrix_mul_term[R](p, n, m, matrix_transpose[R](n, p, b), matrix_transpose[R](m, n, a), j, i, k)
}

define matrix_transpose_mul_orig_term[R: CommRing](m: Nat, n: Nat, p: Nat, a: Matrix[R, m, n], b: Matrix[R, n, p], i: Fin[m], j: Fin[p], k: Fin[n]) -> R {
    matrix_mul_term[R](m, n, p, a, b, i, j, k)
}

theorem matrix_transpose_mul_term_eq[R: CommRing](m: Nat, n: Nat, p: Nat, a: Matrix[R, m, n], b: Matrix[R, n, p], i: Fin[m], j: Fin[p], k: Fin[n]) {
    matrix_transpose_mul_rev_term[R](m, n, p, a, b, i, j, k) = matrix_transpose_mul_orig_term[R](m, n, p, a, b, i, j, k)
}

theorem matrix_entry_transpose_mul[R: CommRing](m: Nat, n: Nat, p: Nat, a: Matrix[R, m, n], b: Matrix[R, n, p], i: Fin[m], j: Fin[p]) {
    matrix_entry[R](p, m, matrix_transpose[R](m, p, matrix_mul[R](m, n, p, a, b)), j, i) =
        matrix_entry[R](p, m, matrix_mul[R](p, n, m, matrix_transpose[R](n, p, b), matrix_transpose[R](m, n, a)), j, i)
}

theorem matrix_transpose_mul[R: CommRing](m: Nat, n: Nat, p: Nat, a: Matrix[R, m, n], b: Matrix[R, n, p]) {
    matrix_transpose[R](m, p, matrix_mul[R](m, n, p, a, b)) =
        matrix_mul[R](p, n, m, matrix_transpose[R](n, p, b), matrix_transpose[R](m, n, a))
}

theorem matrix_transpose_square_mul[R: CommRing](n: Nat, a: Matrix[R, n, n], b: Matrix[R, n, n]) {
    matrix_transpose[R](n, n, square_matrix_mul[R](n, a, b)) =
        square_matrix_mul[R](n, matrix_transpose[R](n, n, b), matrix_transpose[R](n, n, a))
}

theorem square_matrix_mul_one_right[S: Semiring](n: Nat, a: Matrix[S, n, n]) {
    square_matrix_mul[S](n, a, matrix_one[S](n)) = a
}

theorem square_matrix_mul_one_left[S: Semiring](n: Nat, a: Matrix[S, n, n]) {
    square_matrix_mul[S](n, matrix_one[S](n), a) = a
}

theorem square_matrix_mul_add_right[S: Semiring](n: Nat, a: Matrix[S, n, n], b: Matrix[S, n, n], c: Matrix[S, n, n]) {
    square_matrix_mul[S](n, a, b + c) = square_matrix_mul[S](n, a, b) + square_matrix_mul[S](n, a, c)
}

theorem square_matrix_mul_add_left[S: Semiring](n: Nat, a: Matrix[S, n, n], b: Matrix[S, n, n], c: Matrix[S, n, n]) {
    square_matrix_mul[S](n, a + b, c) = square_matrix_mul[S](n, a, c) + square_matrix_mul[S](n, b, c)
}

theorem matrix_add_associative[A: AddSemigroup](m: Nat, n: Nat, a: Matrix[A, m, n], b: Matrix[A, m, n], c: Matrix[A, m, n]) {
    a + (b + c) = (a + b) + c
}

theorem matrix_add_commutative[A: AddCommSemigroup](m: Nat, n: Nat, a: Matrix[A, m, n], b: Matrix[A, m, n]) {
    a + b = b + a
}

theorem matrix_add_identity_right[A: AddMonoid](m: Nat, n: Nat, a: Matrix[A, m, n]) {
    a + matrix_zero[A](m, n) = a
}

theorem matrix_add_identity_left[A: AddMonoid](m: Nat, n: Nat, a: Matrix[A, m, n]) {
    matrix_zero[A](m, n) + a = a
}

theorem matrix_inverse_right[A: AddGroup](m: Nat, n: Nat, a: Matrix[A, m, n]) {
    a + -a = matrix_zero[A](m, n)
}

theorem matrix_sub_eq_add_neg[A: AddGroup](m: Nat, n: Nat, a: Matrix[A, m, n], b: Matrix[A, m, n]) {
    matrix_sub[A](m, n, a, b) = a + -b
}

theorem matrix_transpose_transpose[A](m: Nat, n: Nat, a: Matrix[A, m, n]) {
    matrix_transpose[A](n, m, matrix_transpose[A](m, n, a)) = a
}

theorem matrix_row_transpose[A](m: Nat, n: Nat, a: Matrix[A, m, n], j: Fin[n], i: Fin[m]) {
    matrix_row[A](n, m, matrix_transpose[A](m, n, a), j, i) = matrix_col[A](m, n, a, j, i)
}

theorem matrix_col_transpose[A](m: Nat, n: Nat, a: Matrix[A, m, n], i: Fin[m], j: Fin[n]) {
    matrix_col[A](n, m, matrix_transpose[A](m, n, a), i, j) = matrix_row[A](m, n, a, i, j)
}

theorem matrix_row_transpose_vector[A](m: Nat, n: Nat, a: Matrix[A, m, n], j: Fin[n]) {
    matrix_row[A](n, m, matrix_transpose[A](m, n, a), j) = matrix_col[A](m, n, a, j)
}

theorem matrix_col_transpose_vector[A](m: Nat, n: Nat, a: Matrix[A, m, n], i: Fin[m]) {
    matrix_col[A](n, m, matrix_transpose[A](m, n, a), i) = matrix_row[A](m, n, a, i)
}

theorem matrix_row_zero[A: Zero](m: Nat, n: Nat, i: Fin[m]) {
    matrix_row[A](m, n, matrix_zero[A](m, n), i) = fin_vector_zero[A](n)
}

theorem matrix_col_zero[A: Zero](m: Nat, n: Nat, j: Fin[n]) {
    matrix_col[A](m, n, matrix_zero[A](m, n), j) = fin_vector_zero[A](m)
}

theorem matrix_row_add[A: Add](m: Nat, n: Nat, a: Matrix[A, m, n], b: Matrix[A, m, n], i: Fin[m]) {
    matrix_row[A](m, n, a + b, i) = fin_vector_add[A](n, matrix_row[A](m, n, a, i), matrix_row[A](m, n, b, i))
}

theorem matrix_col_add[A: Add](m: Nat, n: Nat, a: Matrix[A, m, n], b: Matrix[A, m, n], j: Fin[n]) {
    matrix_col[A](m, n, a + b, j) = fin_vector_add[A](m, matrix_col[A](m, n, a, j), matrix_col[A](m, n, b, j))
}

theorem matrix_row_neg[A: Neg](m: Nat, n: Nat, a: Matrix[A, m, n], i: Fin[m]) {
    matrix_row[A](m, n, -a, i) = fin_vector_neg[A](n, matrix_row[A](m, n, a, i))
}

theorem matrix_col_neg[A: Neg](m: Nat, n: Nat, a: Matrix[A, m, n], j: Fin[n]) {
    matrix_col[A](m, n, -a, j) = fin_vector_neg[A](m, matrix_col[A](m, n, a, j))
}

theorem matrix_row_sub[A: AddGroup](m: Nat, n: Nat, a: Matrix[A, m, n], b: Matrix[A, m, n], i: Fin[m]) {
    matrix_row[A](m, n, matrix_sub[A](m, n, a, b), i) = fin_vector_sub[A](n, matrix_row[A](m, n, a, i), matrix_row[A](m, n, b, i))
}

theorem matrix_col_sub[A: AddGroup](m: Nat, n: Nat, a: Matrix[A, m, n], b: Matrix[A, m, n], j: Fin[n]) {
    matrix_col[A](m, n, matrix_sub[A](m, n, a, b), j) = fin_vector_sub[A](m, matrix_col[A](m, n, a, j), matrix_col[A](m, n, b, j))
}

theorem matrix_row_smul[R: Ring, M: AddCommGroup](carrier: Module[R, M], m: Nat, n: Nat, r: R, a: Matrix[M, m, n], i: Fin[m]) {
    matrix_row[M](m, n, matrix_smul[R, M](carrier, m, n, r, a), i) =
        fin_vector_smul[R, M](carrier, n, r, matrix_row[M](m, n, a, i))
}

theorem matrix_col_smul[R: Ring, M: AddCommGroup](carrier: Module[R, M], m: Nat, n: Nat, r: R, a: Matrix[M, m, n], j: Fin[n]) {
    matrix_col[M](m, n, matrix_smul[R, M](carrier, m, n, r, a), j) =
        fin_vector_smul[R, M](carrier, m, r, matrix_col[M](m, n, a, j))
}

theorem matrix_transpose_zero[A: Zero](m: Nat, n: Nat) {
    matrix_transpose[A](m, n, matrix_zero[A](m, n)) = matrix_zero[A](n, m)
}

theorem matrix_transpose_add[A: Add](m: Nat, n: Nat, a: Matrix[A, m, n], b: Matrix[A, m, n]) {
    matrix_transpose[A](m, n, a + b) = matrix_transpose[A](m, n, a) + matrix_transpose[A](m, n, b)
}

theorem matrix_transpose_neg[A: Neg](m: Nat, n: Nat, a: Matrix[A, m, n]) {
    matrix_transpose[A](m, n, -a) = -matrix_transpose[A](m, n, a)
}

theorem matrix_transpose_sub[A: AddGroup](m: Nat, n: Nat, a: Matrix[A, m, n], b: Matrix[A, m, n]) {
    matrix_transpose[A](m, n, matrix_sub[A](m, n, a, b)) = matrix_sub[A](n, m, matrix_transpose[A](m, n, a), matrix_transpose[A](m, n, b))
}

theorem matrix_smul_one_entry[R: Ring, M: AddCommGroup](carrier: Module[R, M], m: Nat, n: Nat, a: Matrix[M, m, n], i: Fin[m], j: Fin[n]) {
    matrix_entry[M](m, n, matrix_smul[R, M](carrier, m, n, R.1, a), i, j) = matrix_entry[M](m, n, a, i, j)
}

theorem matrix_smul_zero_left_entry[R: Ring, M: AddCommGroup](carrier: Module[R, M], m: Nat, n: Nat, a: Matrix[M, m, n], i: Fin[m], j: Fin[n]) {
    matrix_entry[M](m, n, matrix_smul[R, M](carrier, m, n, R.0, a), i, j) = M.0
}

theorem matrix_smul_zero_left[R: Ring, M: AddCommGroup](carrier: Module[R, M], m: Nat, n: Nat, a: Matrix[M, m, n]) {
    matrix_smul[R, M](carrier, m, n, R.0, a) = matrix_zero[M](m, n)
}

theorem matrix_smul_zero_right[R: Ring, M: AddCommGroup](carrier: Module[R, M], m: Nat, n: Nat, r: R) {
    matrix_smul[R, M](carrier, m, n, r, matrix_zero[M](m, n)) = matrix_zero[M](m, n)
}

theorem matrix_smul_add_left[R: Ring, M: AddCommGroup](carrier: Module[R, M], m: Nat, n: Nat, r: R, s: R, a: Matrix[M, m, n]) {
    matrix_smul[R, M](carrier, m, n, r + s, a) = matrix_smul[R, M](carrier, m, n, r, a) + matrix_smul[R, M](carrier, m, n, s, a)
}

theorem matrix_smul_add_right[R: Ring, M: AddCommGroup](carrier: Module[R, M], m: Nat, n: Nat, r: R, a: Matrix[M, m, n], b: Matrix[M, m, n]) {
    matrix_smul[R, M](carrier, m, n, r, a + b) = matrix_smul[R, M](carrier, m, n, r, a) + matrix_smul[R, M](carrier, m, n, r, b)
}

theorem matrix_smul_assoc[R: Ring, M: AddCommGroup](carrier: Module[R, M], m: Nat, n: Nat, r: R, s: R, a: Matrix[M, m, n]) {
    matrix_smul[R, M](carrier, m, n, r * s, a) = matrix_smul[R, M](carrier, m, n, r, matrix_smul[R, M](carrier, m, n, s, a))
}

theorem matrix_smul_neg_left[R: Ring, M: AddCommGroup](carrier: Module[R, M], m: Nat, n: Nat, r: R, a: Matrix[M, m, n]) {
    matrix_smul[R, M](carrier, m, n, -r, a) = -matrix_smul[R, M](carrier, m, n, r, a)
}

theorem matrix_smul_neg_right[R: Ring, M: AddCommGroup](carrier: Module[R, M], m: Nat, n: Nat, r: R, a: Matrix[M, m, n]) {
    matrix_smul[R, M](carrier, m, n, r, -a) = -matrix_smul[R, M](carrier, m, n, r, a)
}

theorem matrix_pow_zero[S: Semiring](n: Nat, a: Matrix[S, n, n]) {
    matrix_pow[S](n, a, Nat.0) = matrix_one[S](n)
}

theorem matrix_pow_suc[S: Semiring](n: Nat, a: Matrix[S, n, n], k: Nat) {
    matrix_pow[S](n, a, k.suc) = square_matrix_mul[S](n, a, matrix_pow[S](n, a, k))
}

theorem matrix_pow_one_unfold[S: Semiring](n: Nat, a: Matrix[S, n, n]) {
    matrix_pow[S](n, a, Nat.1) = square_matrix_mul[S](n, a, matrix_one[S](n))
}

theorem matrix_pow_one[S: Semiring](n: Nat, a: Matrix[S, n, n]) {
    matrix_pow[S](n, a, Nat.1) = a
}

theorem matrix_entry_pow_suc[S: Semiring](n: Nat, a: Matrix[S, n, n], k: Nat, i: Fin[n], j: Fin[n]) {
    matrix_entry[S](n, n, matrix_pow[S](n, a, k.suc), i, j) =
        fin_sum[S](n, matrix_mul_term[S](n, n, n, a, matrix_pow[S](n, a, k), i, j))
}

theorem matrix_pow_two_unfold[S: Semiring](n: Nat, a: Matrix[S, n, n]) {
    matrix_pow[S](n, a, Nat.2) = square_matrix_mul[S](n, a, square_matrix_mul[S](n, a, matrix_one[S](n)))
}

theorem matrix_pow_zero_matrix_suc[S: Semiring](n: Nat, k: Nat) {
    matrix_pow[S](n, matrix_zero[S](n, n), k.suc) = matrix_zero[S](n, n)
}

theorem matrix_transpose_pow_zero[S: Semiring](n: Nat, a: Matrix[S, n, n]) {
    matrix_transpose[S](n, n, matrix_pow[S](n, a, Nat.0)) = matrix_one[S](n)
}

theorem matrix_transpose_pow_suc_unfold[R: CommRing](n: Nat, a: Matrix[R, n, n], k: Nat) {
    matrix_transpose[R](n, n, matrix_pow[R](n, a, k.suc)) =
        square_matrix_mul[R](n, matrix_transpose[R](n, n, matrix_pow[R](n, a, k)), matrix_transpose[R](n, n, a))
}

theorem matrix_pow_transpose_suc_unfold[S: Semiring](n: Nat, a: Matrix[S, n, n], k: Nat) {
    matrix_pow[S](n, matrix_transpose[S](n, n, a), k.suc) =
        square_matrix_mul[S](n, matrix_transpose[S](n, n, a), matrix_pow[S](n, matrix_transpose[S](n, n, a), k))
}

theorem matrix_transpose_pow_one[S: Semiring](n: Nat, a: Matrix[S, n, n]) {
    matrix_transpose[S](n, n, matrix_pow[S](n, a, Nat.1)) =
        matrix_pow[S](n, matrix_transpose[S](n, n, a), Nat.1)
}

theorem matrix_add_semigroup_law[A: AddSemigroup](m: Nat, n: Nat, a: Matrix[A, m, n], b: Matrix[A, m, n], c: Matrix[A, m, n]) {
    Add.add(a, Add.add(b, c)) = Add.add(Add.add(a, b), c)
}

instance Matrix[A: AddSemigroup, m: Nat, n: Nat]: AddSemigroup

/// Matrix addition is commutative.
theorem matrix_add_comm_semigroup_law[A: AddCommSemigroup](m: Nat, n: Nat, a: Matrix[A, m, n], b: Matrix[A, m, n]) {
    Add.add(a, b) = Add.add(b, a)
}

instance Matrix[A: AddCommSemigroup, m: Nat, n: Nat]: AddCommSemigroup

/// The zero matrix is a right identity for matrix addition.
theorem matrix_add_monoid_right_law[A: AddMonoid](m: Nat, n: Nat, a: Matrix[A, m, n]) {
    Add.add(a, Zero.0[Matrix[A, m, n]]) = a
}

theorem matrix_add_monoid_left_law[A: AddMonoid](m: Nat, n: Nat, a: Matrix[A, m, n]) {
    Add.add(Zero.0[Matrix[A, m, n]], a) = a
}

instance Matrix[A: AddMonoid, m: Nat, n: Nat]: AddMonoid

/// Matrices over an additive commutative monoid form an additive commutative monoid.

instance Matrix[A: AddCommMonoid, m: Nat, n: Nat]: AddCommMonoid

/// Matrix negation gives a right additive inverse.
theorem matrix_add_group_inverse_law[A: AddGroup](m: Nat, n: Nat, a: Matrix[A, m, n]) {
    Add.add(a, Neg.neg(a)) = Zero.0[Matrix[A, m, n]]
}

instance Matrix[A: AddGroup, m: Nat, n: Nat]: AddGroup

/// Matrices over an additive commutative group form an additive commutative group.

instance Matrix[A: AddCommGroup, m: Nat, n: Nat]: AddCommGroup

/// The entry function of a matrix with two rows exchanged.
define matrix_swap_rows_entry[A](m: Nat, n: Nat, a: Matrix[A, m, n], i: Fin[m], j: Fin[m], r: Fin[m], c: Fin[n]) -> A {
    if r = i {
        matrix_entry[A](m, n, a, j, c)
    } else {
        if r = j {
            matrix_entry[A](m, n, a, i, c)
        } else {
            matrix_entry[A](m, n, a, r, c)
        }
    }
}

define matrix_swap_rows[A](m: Nat, n: Nat, a: Matrix[A, m, n], i: Fin[m], j: Fin[m]) -> Matrix[A, m, n] {
    Matrix[A, m, n].new(matrix_swap_rows_entry[A](m, n, a, i, j))
}

theorem matrix_entry_swap_rows[A](m: Nat, n: Nat, a: Matrix[A, m, n], i: Fin[m], j: Fin[m], r: Fin[m], c: Fin[n]) {
    matrix_entry[A](m, n, matrix_swap_rows[A](m, n, a, i, j), r, c) =
        matrix_swap_rows_entry[A](m, n, a, i, j, r, c)
}

define matrix2_00[R](n: Nat, a: Matrix[R, n.suc.suc, n.suc.suc]) -> R {
    matrix_entry[R](n.suc.suc, n.suc.suc, a, fin_zero(n.suc), fin_zero(n.suc))
}

define matrix2_01[R](n: Nat, a: Matrix[R, n.suc.suc, n.suc.suc]) -> R {
    matrix_entry[R](n.suc.suc, n.suc.suc, a, fin_zero(n.suc), fin_succ(n.suc, fin_zero(n)))
}

define matrix2_10[R](n: Nat, a: Matrix[R, n.suc.suc, n.suc.suc]) -> R {
    matrix_entry[R](n.suc.suc, n.suc.suc, a, fin_succ(n.suc, fin_zero(n)), fin_zero(n.suc))
}

define matrix2_11[R](n: Nat, a: Matrix[R, n.suc.suc, n.suc.suc]) -> R {
    matrix_entry[R](n.suc.suc, n.suc.suc, a, fin_succ(n.suc, fin_zero(n)), fin_succ(n.suc, fin_zero(n)))
}

define matrix2_trace[R: Ring](n: Nat, a: Matrix[R, n.suc.suc, n.suc.suc]) -> R {
    matrix2_00[R](n, a) + matrix2_11[R](n, a)
}

define matrix2_det_entries[R: Ring](n: Nat, a: Matrix[R, n.suc.suc, n.suc.suc]) -> R {
    matrix2_00[R](n, a) * matrix2_11[R](n, a) - matrix2_01[R](n, a) * matrix2_10[R](n, a)
}

define char_poly_2x2[R: Ring](n: Nat, a: Matrix[R, n.suc.suc, n.suc.suc], lam: R) -> R {
    (matrix2_00[R](n, a) - lam) * (matrix2_11[R](n, a) - lam) - matrix2_01[R](n, a) * matrix2_10[R](n, a)
}

define char_poly_2x2_standard[R: Ring](n: Nat, a: Matrix[R, n.suc.suc, n.suc.suc], lam: R) -> R {
    lam * lam - matrix2_trace[R](n, a) * lam + matrix2_det_entries[R](n, a)
}

define cayley_hamilton_lhs[R: Ring](n: Nat, a: Matrix[R, n.suc.suc, n.suc.suc]) -> Matrix[R, n.suc.suc, n.suc.suc] {
    square_matrix_mul[R](n.suc.suc, a, a) -
        matrix_smul[R, R](ring_as_module[R], n.suc.suc, n.suc.suc, matrix2_trace[R](n, a), a) +
        matrix_smul[R, R](ring_as_module[R], n.suc.suc, n.suc.suc, matrix2_det_entries[R](n, a), matrix_one[R](n.suc.suc))
}

define matrix2_vec[R](n: Nat, x0: R, x1: R, i: Fin[n]) -> R {
    if i.value = Nat.0 {
        x0
    } else {
        x1
    }
}

define matrix_det_suc[R: Ring](n: Nat, a: Matrix[R, n.suc, n.suc]) -> R {
    matrix_det_list[R](n.suc, a, fin_enum_suc(n), fin_enum_suc(n))
}

theorem matrix_det_suc_unfold[R: Ring](n: Nat, a: Matrix[R, n.suc, n.suc]) {
    matrix_det_suc[R](n, a) = matrix_det_list[R](n.suc, a, fin_enum_suc(n), fin_enum_suc(n))
}

theorem matrix_det_suc_enum_length(n: Nat) {
    fin_enum_suc(n).length = n.suc
}

theorem matrix_det_suc_enum_contains(n: Nat, i: Fin[n.suc]) {
    fin_enum_suc(n).contains(i)
}

theorem matrix_det_suc_enum_is_unique(n: Nat) {
    fin_enum_suc(n).is_unique
}

theorem fin_enum_suc_zero_eq_singleton_zero {
    fin_enum_suc(Nat.0) = List.singleton(fin_zero(Nat.0))
}

theorem sum_singleton_ring[R: Ring](x: R) {
    sum[R](List.singleton(x)) = x
}

theorem sum_map_zero_ring[T, R: Ring](items: List[T], f: T -> R) {
    (forall(item: T) { f(item) = R.0 }) implies sum[R](map[T, R](items, f)) = R.0
}

theorem matrix_det_list_zero_cons_rows[R: Ring](n: Nat, row: Fin[n], tail_rows: List[Fin[n]], cols: List[Fin[n]]) {
    matrix_det_list[R](n, matrix_zero[R](n, n), List.cons(row, tail_rows), cols) = R.0
}

theorem determinant_list_singleton[R: Ring, I](entry: (I, I) -> R, item: I) {
    determinant_list[R, I](entry, List.singleton(item), List.singleton(item)) = entry(item, item)
}

theorem matrix_det_list_singleton[R: Ring](n: Nat, a: Matrix[R, n, n], item: Fin[n]) {
    matrix_det_list[R](n, a, List.singleton(item), List.singleton(item)) = matrix_entry[R](n, n, a, item, item)
}

theorem matrix_det_list_singleton_transpose[R: Ring](n: Nat, a: Matrix[R, n, n], item: Fin[n]) {
    matrix_det_list[R](n, matrix_transpose[R](n, n, a), List.singleton(item), List.singleton(item)) =
        matrix_det_list[R](n, a, List.singleton(item), List.singleton(item))
}

theorem matrix_det_suc_zero_eq_det_list_singleton[R: Ring](n: Nat, a: Matrix[R, n.suc, n.suc]) {
    n = Nat.0 implies matrix_det_suc[R](n, a) = matrix_det_list[R](n.suc, a, List.singleton(fin_zero(n)), List.singleton(fin_zero(n)))
}

theorem matrix_det_suc_zero_eq_entry[R: Ring](n: Nat, a: Matrix[R, n.suc, n.suc]) {
    n = Nat.0 implies matrix_det_suc[R](n, a) = matrix_entry[R](n.suc, n.suc, a, fin_zero(n), fin_zero(n))
}

theorem matrix_det_suc_zero[R: Ring](n: Nat) {
    matrix_det_suc[R](n, matrix_zero[R](n.suc, n.suc)) = R.0
}

theorem matrix_det_suc_one_by_one_identity[R: Ring] {
    matrix_det_suc[R](Nat.0, matrix_one[R](Nat.0.suc)) = R.1
}

theorem fin_enum_suc_one_eq_two {
    fin_enum_suc(Nat.1) = List.cons(fin_zero(Nat.1), List.cons(fin_last(Nat.1), List.nil[Fin[Nat.1.suc]]))
}

theorem determinant_list_singleton_row_col[R: Ring, I](entry: (I, I) -> R, row: I, col: I) {
    determinant_list[R, I](entry, List.singleton(row), List.singleton(col)) = entry(row, col)
}

define two_row_list[I](r: I, r2: I) -> List[I] {
    List.cons(r, List.cons(r2, List.nil[I]))
}

define two_col_list[I](c: I, c2: I) -> List[I] {
    List.cons(c, List.cons(c2, List.nil[I]))
}

define det_two_two_term[R: Ring, I](entry: (I, I) -> R, r: I, r2: I, cols: List[I], col: I) -> R {
    entry(r, col) * alternating_sign[R](list_index_or_zero[I](cols, col)) *
        determinant_list[R, I](entry, List.cons(r2, List.nil[I]), cols.remove_one(col))
}

theorem determinant_list_two_two[R: Ring, I](entry: (I, I) -> R, r: I, r2: I, c: I, c2: I) {
    c != c2 implies
        determinant_list[R, I](entry, two_row_list(r, r2), two_col_list(c, c2)) =
            entry(r, c) * entry(r2, c2) - entry(r, c2) * entry(r2, c)
}

theorem matrix_det_suc_two_by_two[R: Ring](a: Matrix[R, Nat.1.suc, Nat.1.suc]) {
    matrix_det_suc[R](Nat.1, a) =
        matrix_entry[R](Nat.1.suc, Nat.1.suc, a, fin_zero(Nat.1), fin_zero(Nat.1)) *
            matrix_entry[R](Nat.1.suc, Nat.1.suc, a, fin_last(Nat.1), fin_last(Nat.1)) -
        matrix_entry[R](Nat.1.suc, Nat.1.suc, a, fin_zero(Nat.1), fin_last(Nat.1)) *
            matrix_entry[R](Nat.1.suc, Nat.1.suc, a, fin_last(Nat.1), fin_zero(Nat.1))
}

theorem sub_neg_rev[R: CommRing](a: R, b: R) {
    a - b = -(b - a)
}

theorem sub_self_zero[R: CommRing](x: R) {
    x - x = R.0
}

theorem add_regroup_mid[R: CommRing](a: R, b: R, c: R, d: R) {
    a + (b + (c + d)) = a + (c + (b + d))
}

theorem add_sub_fold4[R: CommRing](a: R, b: R, c: R, d: R) {
    a + (-b) + (-c) + d = a - b - c + d
}

theorem sub_factor[R: CommRing](x: R, y: R, z: R) {
    x * y - x * z = x * (y - z)
}

theorem mul_comm4[R: CommRing](a: R, b: R, c: R, d: R) {
    a * b * c * d = a * c * b * d
}

theorem mul_comm3[R: CommRing](a: R, b: R, c: R) {
    a * b * c = a * c * b
}

theorem sub_split_pair[R: CommRing](a: R, b: R, c: R, d: R) {
    (a + b) - (c + d) = (a - c) + (b - d)
}

theorem expand_sum_prod[R: CommRing](x: R, y: R, z: R, w: R) {
    (x + y) * (z + w) = x * z + x * w + y * z + y * w
}

theorem expand_diff_prod[R: CommRing](x: R, y: R, z: R, w: R) {
    (x - y) * (z - w) = x * z - x * w - y * z + y * w
}

theorem sub_factor_right[R: CommRing](x: R, y: R, w: R) {
    x * w - y * w = (x - y) * w
}

theorem det2_mul_identity[R: CommRing](a00: R, a01: R, a10: R, a11: R, b00: R, b01: R, b10: R, b11: R) {
    (a00 * b00 + a01 * b10) * (a10 * b01 + a11 * b11) -
        (a00 * b01 + a01 * b11) * (a10 * b00 + a11 * b10) =
        (a00 * a11 - a01 * a10) * (b00 * b11 - b01 * b10)
}

theorem fin_sum_two_suc[R: AddCommMonoid](f: Fin[Nat.1.suc] -> R) {
    fin_sum[R](Nat.1.suc, f) = f(fin_zero(Nat.1)) + f(fin_last(Nat.1))
}

theorem matrix_entry_mul_two_by_two[R: CommRing](a: Matrix[R, Nat.1.suc, Nat.1.suc], b: Matrix[R, Nat.1.suc, Nat.1.suc], i: Fin[Nat.1.suc], j: Fin[Nat.1.suc]) {
    matrix_entry[R](Nat.1.suc, Nat.1.suc, matrix_mul[R](Nat.1.suc, Nat.1.suc, Nat.1.suc, a, b), i, j) =
        matrix_entry[R](Nat.1.suc, Nat.1.suc, a, i, fin_zero(Nat.1)) *
            matrix_entry[R](Nat.1.suc, Nat.1.suc, b, fin_zero(Nat.1), j) +
        matrix_entry[R](Nat.1.suc, Nat.1.suc, a, i, fin_last(Nat.1)) *
            matrix_entry[R](Nat.1.suc, Nat.1.suc, b, fin_last(Nat.1), j)
}

theorem matrix_det_suc_two_by_two_mul[R: CommRing](a: Matrix[R, Nat.1.suc, Nat.1.suc], b: Matrix[R, Nat.1.suc, Nat.1.suc]) {
    matrix_det_suc[R](Nat.1, matrix_mul[R](Nat.1.suc, Nat.1.suc, Nat.1.suc, a, b)) =
        matrix_det_suc[R](Nat.1, a) * matrix_det_suc[R](Nat.1, b)
}

theorem determinant_list_zero_row_head[R: Ring, I](entry: (I, I) -> R, row: I, tail: List[I], cols: List[I]) {
    (forall(col: I) { entry(row, col) = R.0 }) implies
        determinant_list(entry, List.cons(row, tail), cols) = R.0
}

theorem determinant_list_zero_row_anywhere[R: Ring, I](entry: (I, I) -> R, rows: List[I], cols: List[I], row: I) {
    rows.contains(row) and (forall(col: I) { entry(row, col) = R.0 }) implies
        determinant_list(entry, rows, cols) = R.0
}

theorem matrix_det_suc_zero_row[R: Ring](n: Nat, a: Matrix[R, n.suc, n.suc], row: Fin[n.suc]) {
    (forall(col: Fin[n.suc]) { matrix_entry[R](n.suc, n.suc, a, row, col) = R.0 }) implies
        matrix_det_suc[R](n, a) = R.0
}

theorem matrix_det_suc_two_by_two_identity[R: Ring] {
    matrix_det_suc[R](Nat.1, matrix_one[R](Nat.1.suc)) = R.1
}

theorem sub_zero_right[R: Ring](x: R) {
    x - R.0 = x
}

theorem matrix_det_suc_two_by_two_transpose[R: CommRing](a: Matrix[R, Nat.1.suc, Nat.1.suc]) {
    matrix_det_suc[R](Nat.1, matrix_transpose[R](Nat.1.suc, Nat.1.suc, a)) = matrix_det_suc[R](Nat.1, a)
}

theorem matrix_det_suc_two_by_two_swap_rows[R: CommRing](a: Matrix[R, Nat.1.suc, Nat.1.suc]) {
    matrix_det_suc[R](Nat.1, matrix_swap_rows[R](Nat.1.suc, Nat.1.suc, a, fin_zero(Nat.1), fin_last(Nat.1))) =
        -matrix_det_suc[R](Nat.1, a)
}

theorem matrix_det_suc_two_by_two_equal_rows[R: CommRing](a: Matrix[R, Nat.1.suc, Nat.1.suc]) {
    (forall(col: Fin[Nat.1.suc]) {
        matrix_entry[R](Nat.1.suc, Nat.1.suc, a, fin_zero(Nat.1), col) =
            matrix_entry[R](Nat.1.suc, Nat.1.suc, a, fin_last(Nat.1), col)
    }) implies matrix_det_suc[R](Nat.1, a) = R.0
}

theorem matrix_det_suc_two_by_two_upper_triangular[R: Ring](a: Matrix[R, Nat.1.suc, Nat.1.suc]) {
    matrix_entry[R](Nat.1.suc, Nat.1.suc, a, fin_last(Nat.1), fin_zero(Nat.1)) = R.0 implies
        matrix_det_suc[R](Nat.1, a) =
            matrix_entry[R](Nat.1.suc, Nat.1.suc, a, fin_zero(Nat.1), fin_zero(Nat.1)) *
                matrix_entry[R](Nat.1.suc, Nat.1.suc, a, fin_last(Nat.1), fin_last(Nat.1))
}

define flip_entry[R: Ring, I](entry: (I, I) -> R, c: I, r: I) -> R {
    entry(r, c)
}

theorem alternating_sign_mul_comm[R: Ring](a: Nat, b: Nat) {
    alternating_sign[R](a) * alternating_sign[R](b) = alternating_sign[R](b) * alternating_sign[R](a)
}

theorem alternating_sign_suc_comm[R: Ring](a: Nat, b: Nat) {
    alternating_sign[R](a.suc) * alternating_sign[R](b) =
        alternating_sign[R](b.suc) * alternating_sign[R](a)
}

theorem sum_map_zero_fn[T, A: AddCommMonoid](items: List[T], f: T -> A) {
    (forall(item: T) { f(item) = A.0 }) implies sum[A](map[T, A](items, f)) = A.0
}

theorem sum_map_add_fn[T, A: AddCommMonoid](items: List[T], f: T -> A, g: T -> A) {
    sum[A](map[T, A](items, function(y: T) { f(y) + g(y) })) =
        sum[A](map[T, A](items, f)) + sum[A](map[T, A](items, g))
}

theorem sum_map_sum_exchange[T, A: AddCommMonoid](xs: List[T], ys: List[T], h: T -> T -> A) {
    sum[A](map[T, A](xs, function(x: T) {
        sum[A](map[T, A](ys, function(y: T) { h(x, y) }))
    })) = sum[A](map[T, A](ys, function(y: T) {
        sum[A](map[T, A](xs, function(x: T) { h(x, y) }))
    }))
}

theorem unique_cons_not_contains_head[T](head: T, tail: List[T]) {
    List.cons(head, tail).is_unique implies not tail.contains(head)
}

define det_row_sum_term[R: Ring, I](entry: (I, I) -> R, row: I, tail_rows: List[I], cols: List[I], col: I) -> R {
    entry(row, col) * alternating_sign[R](list_index_or_zero[I](cols, col)) *
        determinant_list[R, I](entry, tail_rows, cols.remove_one(col))
}

theorem determinant_list_cons_rows_term[R: Ring, I](entry: (I, I) -> R, row: I, tail_rows: List[I], cols: List[I]) {
    determinant_list[R, I](entry, List.cons(row, tail_rows), cols) =
        sum[R](map[I, R](cols, det_row_sum_term[R, I](entry, row, tail_rows, cols)))
}

theorem remove_one_length_suc[T](list: List[T], item: T) {
    list.contains(item) implies list.remove_one(item).length.suc = list.length
}

theorem sum_map_scalar_mul[T, R: Ring](items: List[T], c: R, f: T -> R) {
    c * sum[R](map[T, R](items, f)) = sum[R](map[T, R](items, function(x: T) { c * f(x) }))
}

theorem determinant_list_pointwise[R: Ring, I](e1: (I, I) -> R, e2: (I, I) -> R, rows: List[I], cols: List[I]) {
    (forall(r: I, c: I) { e1(r, c) = e2(r, c) }) implies
        determinant_list[R, I](e1, rows, cols) = determinant_list[R, I](e2, rows, cols)
}

theorem nat_suc_eq_cancel(a: Nat, b: Nat) {
    a.suc = b.suc implies a = b
}

theorem prod_exchange_comm[R: CommRing](a: R, b: R, s1: R, s2: R, s3: R, s4: R) {
    s1 * s2 = s3 * s4 implies (a * s1) * (b * s2) = (b * s3) * (a * s4)
}

define det_transpose_pred[R: CommRing, I](entry: (I, I) -> R, n: Nat) -> Bool {
    forall(rows2: List[I], cols2: List[I]) {
        if rows2.length = cols2.length and rows2.length <= n and rows2.is_unique and cols2.is_unique {
            determinant_list[R, I](entry, rows2, cols2) =
                determinant_list[R, I](flip_entry[R, I](entry), cols2, rows2)
        }
    }
}

theorem det_transpose_step[R: CommRing, I](entry: (I, I) -> R, k: Nat) {
    true_below(det_transpose_pred[R, I](entry), k) implies
        forall(rows2: List[I], cols2: List[I]) {
            if rows2.length = cols2.length and rows2.length <= k and rows2.is_unique and cols2.is_unique {
                match rows2 {
                    List.nil {
                        determinant_list[R, I](entry, List.nil[I], cols2) =
                            determinant_list[R, I](flip_entry[R, I](entry), cols2, List.nil[I])
                    }
                    List.cons(head, tail) {
                        match cols2 {
                            List.nil {
                                determinant_list[R, I](entry, List.cons(head, tail), List.nil[I]) =
                                    determinant_list[R, I](flip_entry[R, I](entry), List.nil[I], List.cons(head, tail))
                            }
                            List.cons(c, cs) {
                                determinant_list[R, I](entry, List.cons(head, tail), List.cons(c, cs)) =
                                    determinant_list[R, I](flip_entry[R, I](entry), List.cons(c, cs), List.cons(head, tail))
                            }
                        }
                    }
                }
            }
        }
}

define determinant_diagonal[R: Ring, I](entry: (I, I) -> R, rows: List[I], cols: List[I]) -> R {
    match rows {
        List.nil {
            R.1
        }
        List.cons(row, tail_rows) {
            match cols {
                List.nil {
                    R.1
                }
                List.cons(col, tail_cols) {
                    entry(row, col) * determinant_diagonal[R, I](entry, tail_rows, tail_cols)
                }
            }
        }
    }
}

theorem list_index_or_zero_zero_iff_head[I](head: I, tail: List[I], x: I) {
    List.cons(head, tail).contains(x) and list_index_or_zero[I](List.cons(head, tail), x) = Nat.0 implies x = head
}

theorem list_index_or_zero_remove_after[I](list: List[I], x: I, c: I) {
    list.contains(x) and list.contains(c) and x != c and
        list_index_or_zero[I](list, c) < list_index_or_zero[I](list, x) implies
        list_index_or_zero[I](list.remove_one(x), c) = list_index_or_zero[I](list, c)
}

theorem list_index_or_zero_remove_before[I](list: List[I], x: I, c: I) {
    list.contains(x) and list.contains(c) and x != c and
        list_index_or_zero[I](list, x) < list_index_or_zero[I](list, c) implies
        list_index_or_zero[I](list.remove_one(x), c).suc = list_index_or_zero[I](list, c)
}

theorem list_index_or_zero_injective_unique[I](list: List[I], x: I, y: I) {
    list.is_unique and list.contains(x) and list.contains(y) and
        list_index_or_zero[I](list, x) = list_index_or_zero[I](list, y) implies x = y
}

define triangular_condition[R: Ring, I](entry: (I, I) -> R, rows: List[I], cols: List[I]) -> Bool {
    forall(r: I, c: I) {
        rows.contains(r) and cols.contains(c) and
        list_index_or_zero[I](rows, r) > list_index_or_zero[I](cols, c) implies entry(r, c) = R.0
    }
}

theorem triangular_preserved_first[R: Ring, I](entry: (I, I) -> R, head: I, tail: List[I], c: I, cs: List[I]) {
    List.cons(head, tail).is_unique and List.cons(c, cs).is_unique and
    triangular_condition[R, I](entry, List.cons(head, tail), List.cons(c, cs)) implies
        triangular_condition[R, I](entry, tail, cs)
}

theorem triangular_preserved_remove[R: Ring, I](entry: (I, I) -> R, head: I, tail: List[I], cols: List[I], x: I) {
    List.cons(head, tail).is_unique and cols.is_unique and
    triangular_condition[R, I](entry, List.cons(head, tail), cols) and cols.contains(x) implies
        triangular_condition[R, I](entry, tail, cols.remove_one(x))
}

theorem remove_one_comm[T](list: List[T], x: T, y: T) {
    list.remove_one(x).remove_one(y) = list.remove_one(y).remove_one(x)
}

theorem alternating_sign_add[R: Ring](m: Nat, n: Nat) {
    alternating_sign[R](m) * alternating_sign[R](n) = alternating_sign[R](m + n)
}

theorem sum_double_remove_flip[T, R: Ring](cols: List[T], f: T -> T -> R) {
    cols.is_unique implies
    (sum[R](map[T, R](cols, function(x: T) {
        sum[R](map[T, R](cols.remove_one(x), function(y: T) { f(x, y) }))
    })) = sum[R](map[T, R](cols, function(x: T) {
        sum[R](map[T, R](cols.remove_one(x), function(y: T) { f(y, x) }))
    })))
}

theorem sum_map_neg[T, R: Ring](items: List[T], f: T -> R) {
    sum[R](map[T, R](items, function(x: T) { -(f(x)) })) = -(sum[R](map[T, R](items, f)))
}

theorem det_swap_sign_pair[R: Ring, I](cols: List[I], x: I, y: I) {
    cols.is_unique and cols.contains(x) and cols.contains(y) and x != y implies
    alternating_sign[R](list_index_or_zero[I](cols, x)) *
        alternating_sign[R](list_index_or_zero[I](cols.remove_one(x), y)) =
    -(alternating_sign[R](list_index_or_zero[I](cols, y)) *
        alternating_sign[R](list_index_or_zero[I](cols.remove_one(y), x)))
}

define det_two_row_term[R: Ring, I](entry: (I, I) -> R, r1: I, r2: I, rs: List[I], cols: List[I], x: I, y: I) -> R {
    entry(r1, x) * alternating_sign[R](list_index_or_zero[I](cols, x)) *
        entry(r2, y) * alternating_sign[R](list_index_or_zero[I](cols.remove_one(x), y)) *
        determinant_list[R, I](entry, rs, cols.remove_one(x).remove_one(y))
}

theorem determinant_list_two_rows[R: Ring, I](entry: (I, I) -> R, r1: I, r2: I, rs: List[I], cols: List[I]) {
    determinant_list[R, I](entry, List.cons(r1, List.cons(r2, rs)), cols) =
        sum[R](map[I, R](cols, function(x: I) {
            sum[R](map[I, R](cols.remove_one(x), function(y: I) {
                det_two_row_term[R, I](entry, r1, r2, rs, cols, x, y)
            }))
        }))
}

theorem swap_term_pair_neg[R: CommRing, I](entry: (I, I) -> R, r1: I, r2: I, rs: List[I], cols: List[I], x: I, y: I) {
    cols.is_unique and cols.contains(x) and cols.remove_one(x).contains(y) implies
    det_two_row_term[R, I](entry, r2, r1, rs, cols, x, y) =
        -(det_two_row_term[R, I](entry, r1, r2, rs, cols, y, x))
}

theorem determinant_list_swap_first_two_rows[R: CommRing, I](entry: (I, I) -> R, r1: I, r2: I, rs: List[I], cols: List[I]) {
    cols.is_unique implies
    determinant_list[R, I](entry, List.cons(r2, List.cons(r1, rs)), cols) =
        -(determinant_list[R, I](entry, List.cons(r1, List.cons(r2, rs)), cols))
}

define det_row_replace_entry[R: Ring, I](entry: (I, I) -> R, r: I, g: (I) -> R, i: I, c: I) -> R {
    if i = r {
        g(c)
    } else {
        entry(i, c)
    }
}

define det_row_fn_add[R: Ring, I](g1: (I) -> R, g2: (I) -> R, c: I) -> R {
    g1(c) + g2(c)
}

define det_row_fn_smul[R: Ring, I](c: R, g: (I) -> R, i: I) -> R {
    c * g(i)
}

theorem determinant_list_row_absent[R: Ring, I](entry: (I, I) -> R, g: (I) -> R, r: I, rows: List[I], cols: List[I]) {
    not rows.contains(r) implies
        determinant_list[R, I](det_row_replace_entry[R, I](entry, r, g), rows, cols) =
            determinant_list[R, I](entry, rows, cols)
}

theorem determinant_list_row_add[R: Ring, I](entry: (I, I) -> R, g1: (I) -> R, g2: (I) -> R, r: I, rows: List[I], cols: List[I]) {
    rows.contains(r) and not rows.remove_one(r).contains(r) implies
        determinant_list[R, I](det_row_replace_entry[R, I](entry, r, det_row_fn_add[R, I](g1, g2)), rows, cols) =
            determinant_list[R, I](det_row_replace_entry[R, I](entry, r, g1), rows, cols) +
                determinant_list[R, I](det_row_replace_entry[R, I](entry, r, g2), rows, cols)
}

theorem determinant_list_row_smul[R: CommRing, I](entry: (I, I) -> R, c: R, g: (I) -> R, r: I, rows: List[I], cols: List[I]) {
    rows.contains(r) and not rows.remove_one(r).contains(r) implies
        determinant_list[R, I](det_row_replace_entry[R, I](entry, r, det_row_fn_smul[R, I](c, g)), rows, cols) =
            c * determinant_list[R, I](det_row_replace_entry[R, I](entry, r, g), rows, cols)
}

define matrix_row_replace[R: Ring](n: Nat, a: Matrix[R, n.suc, n.suc], r: Fin[n.suc], g: (Fin[n.suc]) -> R) -> Matrix[R, n.suc, n.suc] {
    Matrix[R, n.suc, n.suc].new(det_row_replace_entry[R, Fin[n.suc]](square_matrix_entry_function[R](n.suc, a), r, g))
}

theorem matrix_det_suc_row_add[R: Ring](n: Nat, a: Matrix[R, n.suc, n.suc], r: Fin[n.suc], x: (Fin[n.suc]) -> R, y: (Fin[n.suc]) -> R) {
    matrix_det_suc[R](n, matrix_row_replace[R](n, a, r, det_row_fn_add[R, Fin[n.suc]](x, y))) =
        matrix_det_suc[R](n, matrix_row_replace[R](n, a, r, x)) +
            matrix_det_suc[R](n, matrix_row_replace[R](n, a, r, y))
}

theorem matrix_det_suc_row_smul[R: CommRing](n: Nat, a: Matrix[R, n.suc, n.suc], r: Fin[n.suc], c: R, x: (Fin[n.suc]) -> R) {
    matrix_det_suc[R](n, matrix_row_replace[R](n, a, r, det_row_fn_smul[R, Fin[n.suc]](c, x))) =
        c * matrix_det_suc[R](n, matrix_row_replace[R](n, a, r, x))
}

define scale_seq[S: Semiring](c: S, f: Nat -> S) -> (Nat -> S) {
    function(k: Nat) {
        c * f(k)
    }
}

theorem partial_scalar_mul[S: Semiring](c: S, f: Nat -> S, n: Nat) {
    partial(scale_seq[S](c, f), n) = c * partial(f, n)
}

define fin_scale[S: Semiring](n: Nat, c: S, f: Fin[n] -> S) -> (Fin[n] -> S) {
    function(i: Fin[n]) {
        c * f(i)
    }
}

theorem fin_value_or_zero_scale[S: Semiring](n: Nat, c: S, f: Fin[n] -> S, k: Nat) {
    k < n implies fin_value_or_zero[S](n, fin_scale[S](n, c, f), k)
        = c * fin_value_or_zero[S](n, f, k)
}

theorem fin_sum_scalar_mul[S: Semiring](n: Nat, c: S, f: Fin[n] -> S) {
    fin_sum[S](n, fin_scale[S](n, c, f)) = c * fin_sum[S](n, f)
}

define matrix_apply_term[S: Semiring](
    n: Nat, a: Matrix[S, n, n], v: Fin[n] -> S, i: Fin[n], k: Fin[n]
) -> S {
    matrix_entry[S](n, n, a, i, k) * v(k)
}

define matrix_apply[S: Semiring](
    n: Nat, a: Matrix[S, n, n], v: Fin[n] -> S, i: Fin[n]
) -> S {
    fin_sum[S](n, matrix_apply_term[S](n, a, v, i))
}

theorem matrix_apply_eq[S: Semiring](
    n: Nat, a: Matrix[S, n, n], v: Fin[n] -> S, i: Fin[n]
) {
    matrix_apply[S](n, a, v, i) = fin_sum[S](n, matrix_apply_term[S](n, a, v, i))
}

theorem matrix_apply_pointwise_eq[S: Semiring](
    n: Nat, a: Matrix[S, n, n], v: Fin[n] -> S, w: Fin[n] -> S, i: Fin[n]
) {
    (forall(k: Fin[n]) { v(k) = w(k) })
        implies matrix_apply[S](n, a, v, i) = matrix_apply[S](n, a, w, i)
}

define is_nonzero_vector[S: Semiring](n: Nat, v: Fin[n] -> S) -> Bool {
    exists(i: Fin[n]) {
        v(i) != S.0
    }
}

theorem is_nonzero_vector_intro[S: Semiring](n: Nat, v: Fin[n] -> S, i: Fin[n]) {
    v(i) != S.0 implies is_nonzero_vector[S](n, v)
}

theorem is_nonzero_vector_witness[S: Semiring](n: Nat, v: Fin[n] -> S) {
    is_nonzero_vector[S](n, v) implies exists(i: Fin[n]) { v(i) != S.0 }
}

theorem zero_vector_not_nonzero[S: Semiring](n: Nat) {
    not is_nonzero_vector[S](n, fin_vector_zero[S](n))
}

define is_eigenvector[S: Semiring](
    n: Nat, a: Matrix[S, n, n], lam: S, v: Fin[n] -> S
) -> Bool {
    is_nonzero_vector[S](n, v) and forall(i: Fin[n]) {
        matrix_apply[S](n, a, v, i) = lam * v(i)
    }
}

theorem is_eigenvector_nonzero[S: Semiring](
    n: Nat, a: Matrix[S, n, n], lam: S, v: Fin[n] -> S
) {
    is_eigenvector[S](n, a, lam, v) implies is_nonzero_vector[S](n, v)
}

theorem is_eigenvector_apply[S: Semiring](
    n: Nat, a: Matrix[S, n, n], lam: S, v: Fin[n] -> S, i: Fin[n]
) {
    is_eigenvector[S](n, a, lam, v) implies matrix_apply[S](n, a, v, i) = lam * v(i)
}

theorem is_eigenvector_intro[S: Semiring](
    n: Nat, a: Matrix[S, n, n], lam: S, v: Fin[n] -> S
) {
    is_nonzero_vector[S](n, v) and (forall(i: Fin[n]) {
        matrix_apply[S](n, a, v, i) = lam * v(i)
    }) implies is_eigenvector[S](n, a, lam, v)
}

define is_eigenvalue[S: Semiring](n: Nat, a: Matrix[S, n, n], lam: S) -> Bool {
    exists(v: Fin[n] -> S) {
        is_eigenvector[S](n, a, lam, v)
    }
}

theorem is_eigenvalue_intro[S: Semiring](
    n: Nat, a: Matrix[S, n, n], lam: S, v: Fin[n] -> S
) {
    is_eigenvector[S](n, a, lam, v) implies is_eigenvalue[S](n, a, lam)
}

theorem is_eigenvalue_witness[S: Semiring](n: Nat, a: Matrix[S, n, n], lam: S) {
    is_eigenvalue[S](n, a, lam) implies exists(v: Fin[n] -> S) {
        is_eigenvector[S](n, a, lam, v)
    }
}

define matrix_row_fn[S: Semiring](
    n: Nat, a: Matrix[S, n, n], i: Fin[n], k: Fin[n]
) -> S {
    matrix_entry[S](n, n, a, i, k)
}

define matrix_row_sum[S: Semiring](n: Nat, a: Matrix[S, n, n], i: Fin[n]) -> S {
    fin_sum[S](n, matrix_row_fn[S](n, a, i))
}

define is_row_stochastic[S: Semiring](n: Nat, a: Matrix[S, n, n]) -> Bool {
    forall(i: Fin[n]) {
        matrix_row_sum[S](n, a, i) = S.1
    }
}

theorem is_row_stochastic_apply[S: Semiring](
    n: Nat, a: Matrix[S, n, n], i: Fin[n]
) {
    is_row_stochastic[S](n, a) implies matrix_row_sum[S](n, a, i) = S.1
}

theorem is_row_stochastic_intro[S: Semiring](n: Nat, a: Matrix[S, n, n]) {
    (forall(i: Fin[n]) { matrix_row_sum[S](n, a, i) = S.1 })
        implies is_row_stochastic[S](n, a)
}

define ones_vector[S: Semiring](n: Nat, i: Fin[n]) -> S {
    S.1
}

theorem matrix_apply_ones[S: Semiring](n: Nat, a: Matrix[S, n, n], i: Fin[n]) {
    matrix_apply[S](n, a, ones_vector[S](n), i) = matrix_row_sum[S](n, a, i)
}

theorem ones_vector_nonzero[S: Semiring](n: Nat) {
    S.1 != S.0 implies is_nonzero_vector[S](n.suc, ones_vector[S](n.suc))
}

theorem row_stochastic_has_eigenvalue_one[S: Semiring](
    n: Nat, a: Matrix[S, n.suc, n.suc]
) {
    is_row_stochastic[S](n.suc, a) and S.1 != S.0
        implies is_eigenvalue[S](n.suc, a, S.1)
}

theorem matrix_apply_zero[S: Semiring](n: Nat, a: Matrix[S, n, n], i: Fin[n]) {
    matrix_apply[S](n, a, fin_vector_zero[S](n), i) = S.0
}

theorem matrix_apply_add[R: CommRing](
    n: Nat, a: Matrix[R, n, n], v: Fin[n] -> R, w: Fin[n] -> R, i: Fin[n]
) {
    matrix_apply[R](n, a, fin_vector_add[R](n, v, w), i) =
        matrix_apply[R](n, a, v, i) + matrix_apply[R](n, a, w, i)
}

theorem matrix_apply_smul[R: CommRing](
    n: Nat, a: Matrix[R, n, n], c: R, v: Fin[n] -> R, i: Fin[n]
) {
    matrix_apply[R](n, a, fin_vector_smul[R, R](ring_as_module[R], n, c, v), i) =
        c * matrix_apply[R](n, a, v, i)
}

define fin_vector_lin_comb2[S: Semiring](
    n: Nat, s: S, v: Fin[n] -> S, t: S, w: Fin[n] -> S, i: Fin[n]
) -> S {
    s * v(i) + t * w(i)
}

theorem matrix_apply_lin_comb2[R: CommRing](
    n: Nat, a: Matrix[R, n, n], s: R, v: Fin[n] -> R, t: R, w: Fin[n] -> R, i: Fin[n]
) {
    matrix_apply[R](n, a, fin_vector_lin_comb2[R](n, s, v, t, w), i) =
        s * matrix_apply[R](n, a, v, i) + t * matrix_apply[R](n, a, w, i)
}

theorem eigen_combine_equations[R: CommRing](s: R, t: R, lam: R, mu: R, v: R, w: R) {
    s * lam * v + t * mu * w = R.0 and s * lam * v + t * lam * w = R.0
        implies t * (mu - lam) * w = R.0
}

theorem eigenvectors_distinct_eigenvalues_independent[F: Field](
    n: Nat, a: Matrix[F, n, n], lam: F, mu: F, v: Fin[n] -> F, w: Fin[n] -> F
) {
    lam != mu and is_eigenvector[F](n, a, lam, v) and is_eigenvector[F](n, a, mu, w)
        implies forall(s: F, t: F) {
            (forall(i: Fin[n]) { fin_vector_lin_comb2[F](n, s, v, t, w, i) = F.0 })
                implies s = F.0 and t = F.0
        }
}

theorem eigenvectors_independent_at[F: Field](
    n: Nat, a: Matrix[F, n, n], lam: F, mu: F, v: Fin[n] -> F, w: Fin[n] -> F, s: F, t: F
) {
    lam != mu and is_eigenvector[F](n, a, lam, v) and is_eigenvector[F](n, a, mu, w) and
    (forall(i: Fin[n]) { fin_vector_lin_comb2[F](n, s, v, t, w, i) = F.0 })
        implies s = F.0 and t = F.0
}

theorem fin_two_one_value {
    fin_succ(Nat.0.suc, fin_zero(Nat.0)).value = Nat.0.suc
}

theorem fin_two_zero_value {
    fin_zero(Nat.0.suc).value = Nat.0
}

theorem fin_two_one_ne_zero {
    fin_succ(Nat.0.suc, fin_zero(Nat.0)) != fin_zero(Nat.0.suc)
}

theorem fin_sum_two[A: AddCommMonoid](f: Fin[Nat.0.suc.suc] -> A) {
    fin_sum[A](Nat.0.suc.suc, f) =
        f(fin_zero(Nat.0.suc)) + f(fin_succ(Nat.0.suc, fin_zero(Nat.0)))
}

theorem matrix_entry_mul_two[S: Semiring](
    a: Matrix[S, Nat.0.suc.suc, Nat.0.suc.suc],
    b: Matrix[S, Nat.0.suc.suc, Nat.0.suc.suc],
    i: Fin[Nat.0.suc.suc],
    j: Fin[Nat.0.suc.suc]
) {
    matrix_entry[S](Nat.0.suc.suc, Nat.0.suc.suc, square_matrix_mul[S](Nat.0.suc.suc, a, b), i, j) =
        matrix_entry[S](Nat.0.suc.suc, Nat.0.suc.suc, a, i, fin_zero(Nat.0.suc)) *
            matrix_entry[S](Nat.0.suc.suc, Nat.0.suc.suc, b, fin_zero(Nat.0.suc), j) +
        matrix_entry[S](Nat.0.suc.suc, Nat.0.suc.suc, a, i, fin_succ(Nat.0.suc, fin_zero(Nat.0))) *
            matrix_entry[S](Nat.0.suc.suc, Nat.0.suc.suc, b, fin_succ(Nat.0.suc, fin_zero(Nat.0)), j)
}

theorem semiring_four_term_swap[S: Semiring](
    x0: S, x1: S, y00: S, y01: S, y10: S, y11: S, z0: S, z1: S
) {
    (x0 * y00 + x1 * y10) * z0 + (x0 * y01 + x1 * y11) * z1 =
        x0 * (y00 * z0 + y01 * z1) + x1 * (y10 * z0 + y11 * z1)
}

theorem square_matrix_mul_assoc_two[S: Semiring](
    a: Matrix[S, Nat.0.suc.suc, Nat.0.suc.suc],
    b: Matrix[S, Nat.0.suc.suc, Nat.0.suc.suc],
    c: Matrix[S, Nat.0.suc.suc, Nat.0.suc.suc]
) {
    square_matrix_mul[S](Nat.0.suc.suc, square_matrix_mul[S](Nat.0.suc.suc, a, b), c) =
        square_matrix_mul[S](Nat.0.suc.suc, a, square_matrix_mul[S](Nat.0.suc.suc, b, c))
}

define matrix2_entry_at[R](n: Nat, a00: R, a01: R, a10: R, a11: R, i: Fin[n], j: Fin[n]) -> R {
    if i.value = Nat.0 {
        if j.value = Nat.0 {
            a00
        } else {
            a01
        }
    } else {
        if j.value = Nat.0 {
            a10
        } else {
            a11
        }
    }
}

theorem fin_two_zero_ne_one {
    fin_zero(Nat.0.suc) != fin_succ(Nat.0.suc, fin_zero(Nat.0))
}

theorem matrix2_entry_at_zero_zero[R](a00: R, a01: R, a10: R, a11: R) {
    matrix2_entry_at[R](Nat.0.suc.suc, a00, a01, a10, a11, fin_zero(Nat.0.suc), fin_zero(Nat.0.suc)) = a00
}

theorem matrix2_entry_at_zero_one[R](a00: R, a01: R, a10: R, a11: R) {
    matrix2_entry_at[R](Nat.0.suc.suc, a00, a01, a10, a11, fin_zero(Nat.0.suc), fin_succ(Nat.0.suc, fin_zero(Nat.0))) = a01
}

theorem matrix2_entry_at_one_zero[R](a00: R, a01: R, a10: R, a11: R) {
    matrix2_entry_at[R](Nat.0.suc.suc, a00, a01, a10, a11, fin_succ(Nat.0.suc, fin_zero(Nat.0)), fin_zero(Nat.0.suc)) = a10
}

theorem matrix2_entry_at_one_one[R](a00: R, a01: R, a10: R, a11: R) {
    matrix2_entry_at[R](Nat.0.suc.suc, a00, a01, a10, a11, fin_succ(Nat.0.suc, fin_zero(Nat.0)), fin_succ(Nat.0.suc, fin_zero(Nat.0))) = a11
}

define det2_entry[R: Ring](a00: R, a01: R, a10: R, a11: R) -> R {
    a00 * a11 - a01 * a10
}

define det2[R: Ring](a: Matrix[R, Nat.0.suc.suc, Nat.0.suc.suc]) -> R {
    matrix_entry[R](Nat.0.suc.suc, Nat.0.suc.suc, a, fin_zero(Nat.0.suc), fin_zero(Nat.0.suc)) *
        matrix_entry[R](Nat.0.suc.suc, Nat.0.suc.suc, a, fin_succ(Nat.0.suc, fin_zero(Nat.0)), fin_succ(Nat.0.suc, fin_zero(Nat.0))) -
    matrix_entry[R](Nat.0.suc.suc, Nat.0.suc.suc, a, fin_zero(Nat.0.suc), fin_succ(Nat.0.suc, fin_zero(Nat.0))) *
        matrix_entry[R](Nat.0.suc.suc, Nat.0.suc.suc, a, fin_succ(Nat.0.suc, fin_zero(Nat.0)), fin_zero(Nat.0.suc))
}

theorem det2_entry_expanded[R: Ring](a00: R, a01: R, a10: R, a11: R) {
    det2_entry[R](a00, a01, a10, a11) = a00 * a11 - a01 * a10
}

theorem det2_entry_identity[R: Ring] {
    det2_entry[R](R.1, R.0, R.0, R.1) = R.1
}

let real_two: Real = Real.1 + Real.1

/// The real number three.

let real_three: Real = real_two + Real.1

/// The real number four.

let real_four: Real = real_three + Real.1

/// Moving the middle summand of a three-term sum to the front.
theorem add_swap_left[A: AddCommMonoid](a: A, b: A, c: A) {
    a + (b + c) = b + (a + c)
}

theorem det2_concrete {
    det2_entry[Real](Real.1, real_two, real_three, real_four) = -real_two
}

theorem square_matrix_mul_one_right_two[S: Semiring](a: Matrix[S, Nat.0.suc.suc, Nat.0.suc.suc]) {
    square_matrix_mul[S](Nat.0.suc.suc, a, matrix_one[S](Nat.0.suc.suc)) = a
}

theorem square_matrix_mul_one_left_two[S: Semiring](a: Matrix[S, Nat.0.suc.suc, Nat.0.suc.suc]) {
    square_matrix_mul[S](Nat.0.suc.suc, matrix_one[S](Nat.0.suc.suc), a) = a
}

theorem square_matrix_mul_add_right_two[S: Semiring](
    a: Matrix[S, Nat.0.suc.suc, Nat.0.suc.suc],
    b: Matrix[S, Nat.0.suc.suc, Nat.0.suc.suc],
    c: Matrix[S, Nat.0.suc.suc, Nat.0.suc.suc]
) {
    square_matrix_mul[S](Nat.0.suc.suc, a, b + c) =
        square_matrix_mul[S](Nat.0.suc.suc, a, b) + square_matrix_mul[S](Nat.0.suc.suc, a, c)
}

theorem square_matrix_mul_add_left_two[S: Semiring](
    a: Matrix[S, Nat.0.suc.suc, Nat.0.suc.suc],
    b: Matrix[S, Nat.0.suc.suc, Nat.0.suc.suc],
    c: Matrix[S, Nat.0.suc.suc, Nat.0.suc.suc]
) {
    square_matrix_mul[S](Nat.0.suc.suc, a + b, c) =
        square_matrix_mul[S](Nat.0.suc.suc, a, c) + square_matrix_mul[S](Nat.0.suc.suc, b, c)
}

define matrix_apply_vec[S: Semiring](n: Nat, a: Matrix[S, n, n], v: Fin[n] -> S, k: Fin[n]) -> S {
    matrix_apply[S](n, a, v, k)
}

theorem matrix_apply_mul_two[S: Semiring](
    a: Matrix[S, Nat.0.suc.suc, Nat.0.suc.suc],
    b: Matrix[S, Nat.0.suc.suc, Nat.0.suc.suc],
    v: Fin[Nat.0.suc.suc] -> S,
    i: Fin[Nat.0.suc.suc]
) {
    matrix_apply[S](Nat.0.suc.suc, square_matrix_mul[S](Nat.0.suc.suc, a, b), v, i) =
        matrix_apply[S](Nat.0.suc.suc, a, matrix_apply_vec[S](Nat.0.suc.suc, b, v), i)
}

define inv2_entry_00[F: Field](a00: F, a01: F, a10: F, a11: F) -> F {
    det2_entry[F](a00, a01, a10, a11).inverse * a11
}
