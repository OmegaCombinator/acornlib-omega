define value_at[T](xs: List[T], i: Nat, x: T) -> Bool {
    xs.get_idx(i) = Option.some(x)
}

define lt_at[T: LinearOrder](xs: List[T], i: Nat, j: Nat) -> Bool {
    exists(x: T, y: T) {
        value_at(xs, i, x) and value_at(xs, j, y) and x < y
    }
}

define gt_at[T: LinearOrder](xs: List[T], i: Nat, j: Nat) -> Bool {
    lt_at(xs, j, i)
}

define mono_chain[T: LinearOrder](xs: List[T], w: Nat -> Nat, cmp: Nat -> Nat -> Bool, k: Nat) -> Bool {
    forall(a: Nat, b: Nat) {
        a < b and b < k implies
            w(a) < w(b) and w(b) < xs.length and cmp(w(a), w(b))
    }
}

define chain_geq_from[T: LinearOrder](xs: List[T], cmp: Nat -> Nat -> Bool, i: Nat, k: Nat) -> Bool {
    exists(w: Nat -> Nat) {
        w(0) = i and mono_chain(xs, w, cmp, k)
    }
}

define chain_geq[T: LinearOrder](xs: List[T], cmp: Nat -> Nat -> Bool, k: Nat) -> Bool {
    exists(w: Nat -> Nat) {
        mono_chain(xs, w, cmp, k)
    }
}

theorem mono_chain_zero[T: LinearOrder](xs: List[T], w: Nat -> Nat, cmp: Nat -> Nat -> Bool) {
    mono_chain(xs, w, cmp, Nat.0)
}

theorem mono_chain_one[T: LinearOrder](xs: List[T], w: Nat -> Nat, cmp: Nat -> Nat -> Bool) {
    mono_chain(xs, w, cmp, Nat.1)
}

theorem mono_chain_apply[T: LinearOrder](xs: List[T], w: Nat -> Nat, cmp: Nat -> Nat -> Bool, k: Nat, a: Nat, b: Nat) {
    mono_chain(xs, w, cmp, k) and a < b and b < k implies
    w(a) < w(b) and w(b) < xs.length and cmp(w(a), w(b))
}

theorem mono_chain_mono[T: LinearOrder](xs: List[T], w: Nat -> Nat, cmp: Nat -> Nat -> Bool, k: Nat, m: Nat) {
    mono_chain(xs, w, cmp, m) and k <= m implies mono_chain(xs, w, cmp, k)
}

theorem chain_geq_from_zero[T: LinearOrder](xs: List[T], cmp: Nat -> Nat -> Bool, i: Nat) {
    chain_geq_from(xs, cmp, i, Nat.0)
}

theorem chain_geq_from_one[T: LinearOrder](xs: List[T], cmp: Nat -> Nat -> Bool, i: Nat) {
    i < xs.length implies chain_geq_from(xs, cmp, i, Nat.1)
}

theorem get_idx_cons_zero[T](head: T, tail: List[T]) {
    List.cons(head, tail).get_idx(0) = Option.some(head)
}

theorem get_idx_cons_suc[T](head: T, tail: List[T], i: Nat) {
    List.cons(head, tail).get_idx(i.suc) = tail.get_idx(i)
}

theorem option_some_eq_iff[T](x: T, y: T) {
    (Option.some(x) = Option.some(y)) = (x = y)
}

theorem value_at_cons_zero[T](head: T, tail: List[T], v: T) {
    value_at(List.cons(head, tail), 0, v) = (head = v)
}

theorem value_at_cons_suc[T](head: T, tail: List[T], i: Nat, v: T) {
    value_at(List.cons(head, tail), i.suc, v) = value_at(tail, i, v)
}

theorem value_at_det[T](xs: List[T], i: Nat, x: T, y: T) {
    value_at(xs, i, x) and value_at(xs, i, y) implies x = y
}

theorem lt_at_of_values[T: LinearOrder](xs: List[T], i: Nat, j: Nat, x: T, y: T) {
    value_at(xs, i, x) and value_at(xs, j, y) and x < y implies lt_at(xs, i, j)
}

theorem lt_at_trans[T: LinearOrder](xs: List[T], i: Nat, j: Nat, m: Nat) {
    lt_at(xs, i, j) and lt_at(xs, j, m) implies lt_at(xs, i, m)
}

theorem lt_at_trans_forall[T: LinearOrder](xs: List[T]) {
    forall(u: Nat, v: Nat, m: Nat) {
        lt_at(xs, u, v) and lt_at(xs, v, m) implies lt_at(xs, u, m)
    }
}

theorem gt_at_trans_forall[T: LinearOrder](xs: List[T]) {
    forall(u: Nat, v: Nat, m: Nat) {
        gt_at(xs, u, v) and gt_at(xs, v, m) implies gt_at(xs, u, m)
    }
}

theorem get_idx_some_of_lt[T](xs: List[T], i: Nat) {
    i < xs.length implies exists(x: T) {
        xs.get_idx(i) = Option.some(x)
    }
}

theorem chain_length_bound[T: LinearOrder](xs: List[T], w: Nat -> Nat, cmp: Nat -> Nat -> Bool, k: Nat, i: Nat) {
    w(0) = i and i < xs.length and mono_chain(xs, w, cmp, k) implies k <= xs.length
}

define prepend_pos(i: Nat, w: Nat -> Nat) -> Nat -> Nat {
    function(a: Nat) {
        if a = 0 {
            i
        } else {
            w(a - 1)
        }
    }
}

theorem prepend_pos_zero(i: Nat, w: Nat -> Nat) {
    prepend_pos(i, w)(0) = i
}

theorem prepend_pos_suc(i: Nat, w: Nat -> Nat, a: Nat) {
    prepend_pos(i, w)(a.suc) = w(a)
}

theorem prepend_head_case_one[T: LinearOrder](xs: List[T], w: Nat -> Nat, cmp: Nat -> Nat -> Bool, k: Nat, i: Nat, j: Nat, a: Nat, b: Nat) {
    a = Nat.0 and b = Nat.1 and i < j and j < xs.length and cmp(i, j) and w(0) = j
    implies
    prepend_pos(i, w)(a) < prepend_pos(i, w)(b) and
    prepend_pos(i, w)(b) < xs.length and
    cmp(prepend_pos(i, w)(a), prepend_pos(i, w)(b))
}

theorem prepend_head_case_ge_two[T: LinearOrder](xs: List[T], w: Nat -> Nat, cmp: Nat -> Nat -> Bool, k: Nat, i: Nat, j: Nat, a: Nat, b: Nat, b0: Nat) {
    a = Nat.0 and b = b0.suc and b0 != Nat.0 and b < k.suc and i < j and j < xs.length and
    cmp(i, j) and w(0) = j and mono_chain(xs, w, cmp, k) and
    (forall(u: Nat, v: Nat, m: Nat) { cmp(u, v) and cmp(v, m) implies cmp(u, m) })
    implies
    prepend_pos(i, w)(a) < prepend_pos(i, w)(b) and
    prepend_pos(i, w)(b) < xs.length and
    cmp(prepend_pos(i, w)(a), prepend_pos(i, w)(b))
}

theorem prepend_suc_case[T: LinearOrder](xs: List[T], w: Nat -> Nat, cmp: Nat -> Nat -> Bool, k: Nat, i: Nat, j: Nat, a: Nat, b: Nat, a0: Nat, b0: Nat) {
    a = a0.suc and b = b0.suc and a0 < b0 and b0 < k and mono_chain(xs, w, cmp, k)
    implies
    prepend_pos(i, w)(a) < prepend_pos(i, w)(b) and
    prepend_pos(i, w)(b) < xs.length and
    cmp(prepend_pos(i, w)(a), prepend_pos(i, w)(b))
}

theorem prepend_head_any_case[T: LinearOrder](xs: List[T], w: Nat -> Nat, cmp: Nat -> Nat -> Bool, k: Nat, i: Nat, j: Nat, a: Nat, b: Nat) {
    a = Nat.0 and i < j and j < xs.length and cmp(i, j) and w(0) = j and
    mono_chain(xs, w, cmp, k) and a < b and b < k.suc and
    (forall(u: Nat, v: Nat, m: Nat) { cmp(u, v) and cmp(v, m) implies cmp(u, m) })
    implies
    prepend_pos(i, w)(a) < prepend_pos(i, w)(b) and
    prepend_pos(i, w)(b) < xs.length and
    cmp(prepend_pos(i, w)(a), prepend_pos(i, w)(b))
}

theorem prepend_suc_any_case[T: LinearOrder](xs: List[T], w: Nat -> Nat, cmp: Nat -> Nat -> Bool, k: Nat, i: Nat, j: Nat, a: Nat, b: Nat) {
    a != Nat.0 and i < j and j < xs.length and cmp(i, j) and w(0) = j and
    mono_chain(xs, w, cmp, k) and a < b and b < k.suc and
    (forall(u: Nat, v: Nat, m: Nat) { cmp(u, v) and cmp(v, m) implies cmp(u, m) })
    implies
    prepend_pos(i, w)(a) < prepend_pos(i, w)(b) and
    prepend_pos(i, w)(b) < xs.length and
    cmp(prepend_pos(i, w)(a), prepend_pos(i, w)(b))
}

theorem mono_chain_prepend[T: LinearOrder](xs: List[T], w: Nat -> Nat, cmp: Nat -> Nat -> Bool, k: Nat, i: Nat, j: Nat) {
    i < j and j < xs.length and cmp(i, j) and w(0) = j and mono_chain(xs, w, cmp, k) and
    (forall(u: Nat, v: Nat, m: Nat) { cmp(u, v) and cmp(v, m) implies cmp(u, m) })
    implies mono_chain(xs, prepend_pos(i, w), cmp, k.suc)
}

theorem chain_geq_from_prepend[T: LinearOrder](xs: List[T], cmp: Nat -> Nat -> Bool, i: Nat, j: Nat, k: Nat) {
    i < j and j < xs.length and cmp(i, j) and chain_geq_from(xs, cmp, j, k) and
    (forall(u: Nat, v: Nat, m: Nat) { cmp(u, v) and cmp(v, m) implies cmp(u, m) })
    implies chain_geq_from(xs, cmp, i, k.suc)
}

theorem chain_geq_upper_bound[T: LinearOrder](xs: List[T], cmp: Nat -> Nat -> Bool, i: Nat) {
    i < xs.length implies is_upper_bound_of(chain_geq_from(xs, cmp, i), xs.length)
}

let chain_val[T: LinearOrder](xs: List[T], cmp: Nat -> Nat -> Bool, i: Nat) -> m: Nat satisfy {
    (i < xs.length and is_max(chain_geq_from(xs, cmp, i), m)) or
    (not i < xs.length and m = Nat.0)
}

theorem chain_val_apply[T: LinearOrder](xs: List[T], cmp: Nat -> Nat -> Bool, i: Nat) {
    i < xs.length implies is_max(chain_geq_from(xs, cmp, i), chain_val(xs, cmp, i))
}

theorem chain_val_geq_one[T: LinearOrder](xs: List[T], cmp: Nat -> Nat -> Bool, i: Nat) {
    i < xs.length implies Nat.1 <= chain_val(xs, cmp, i)
}

theorem chain_val_step[T: LinearOrder](xs: List[T], cmp: Nat -> Nat -> Bool, i: Nat, j: Nat) {
    i < j and j < xs.length and cmp(i, j) and
    (forall(u: Nat, v: Nat, m: Nat) { cmp(u, v) and cmp(v, m) implies cmp(u, m) })
    implies chain_val(xs, cmp, j).suc <= chain_val(xs, cmp, i)
}

theorem chain_val_bound[T: LinearOrder](xs: List[T], cmp: Nat -> Nat -> Bool, i: Nat, k: Nat) {
    i < xs.length and not chain_geq(xs, cmp, k.suc) implies chain_val(xs, cmp, i) <= k
}

theorem value_at_imp_contains[T](xs: List[T], i: Nat, x: T) {
    value_at(xs, i, x) implies xs.contains(x)
}

theorem count_ge_one_of_value_at[T](xs: List[T], i: Nat, x: T) {
    value_at(xs, i, x) implies xs.count(x) >= Nat.1
}

theorem count_ge_two_of_two_positions[T](xs: List[T], i: Nat, j: Nat, x: T) {
    value_at(xs, i, x) and value_at(xs, j, x) and i != j implies xs.count(x) >= Nat.2
}

theorem is_unique_distinct_values[T](xs: List[T], i: Nat, j: Nat) {
    xs.is_unique and i < xs.length and j < xs.length and i != j implies
    not exists(x: T) { value_at(xs, i, x) and value_at(xs, j, x) }
}

theorem lt_at_total[T: LinearOrder](xs: List[T], i: Nat, j: Nat) {
    xs.is_unique and i < j and j < xs.length implies lt_at(xs, i, j) or lt_at(xs, j, i)
}

define esz_pair[T: LinearOrder](xs: List[T], i: Nat) -> Pair[Nat, Nat] {
    Pair.new(chain_val(xs, lt_at(xs), i), chain_val(xs, gt_at(xs), i))
}

define esz_pair_fn[T: LinearOrder](xs: List[T], idx: Nat) -> Pair[Nat, Nat] {
    esz_pair(xs, idx)
}

theorem esz_pair_first[T: LinearOrder](xs: List[T], i: Nat) {
    esz_pair(xs, i).first = chain_val(xs, lt_at(xs), i)
}

theorem esz_pair_second[T: LinearOrder](xs: List[T], i: Nat) {
    esz_pair(xs, i).second = chain_val(xs, gt_at(xs), i)
}

theorem esz_pair_distinct[T: LinearOrder](xs: List[T], i: Nat, j: Nat) {
    xs.is_unique and i < j and j < xs.length implies esz_pair(xs, i) != esz_pair(xs, j)
}

define shift_one(a: Nat) -> Nat {
    a + 1
}

define box_pair(r: Nat, b: Nat) -> Pair[Nat, Nat] {
    Pair.new(r, shift_one(b))
}

define pair_boxes(r: Nat, s: Nat) -> List[Pair[Nat, Nat]] {
    match r {
        Nat.zero {
            List.nil[Pair[Nat, Nat]]
        }
        Nat.suc(p) {
            pair_boxes(p, s) + map(s.range, box_pair(r))
        }
    }
}

theorem shift_one_pred(a: Nat) {
    Nat.1 <= a implies shift_one(a - 1) = a
}

theorem pred_lt_of_lte(a: Nat, b: Nat) {
    Nat.1 <= a and a <= b implies a - 1 < b
}

theorem pair_boxes_length(r: Nat, s: Nat) {
    pair_boxes(r, s).length = r * s
}

theorem pair_boxes_contains(r: Nat, s: Nat, a: Nat, b: Nat) {
    Nat.1 <= a and a <= r and Nat.1 <= b and b <= s implies
    pair_boxes(r, s).contains(Pair.new(a, b))
}

theorem map_unique_length_le_of_contains[T, U](items: List[T], targets: List[U], f: T -> U) {
    forall(x: T) {
        items.contains(x) implies targets.contains(f(x))
    } implies map(items, f).unique.length <= targets.length
}

theorem pigeonhole_collision_in[T, U](items: List[T], targets: List[U], f: T -> U) {
    items.is_unique and items.length > targets.length and
    forall(x: T) {
        items.contains(x) implies targets.contains(f(x))
    } implies exists(x: T, y: T) {
        items.contains(x) and items.contains(y) and x != y and f(x) = f(y)
    }
}

theorem esz_pigeonhole[T: LinearOrder](r: Nat, s: Nat, xs: List[T]) {
    xs.is_unique and xs.length > r * s and
    not chain_geq(xs, lt_at(xs), r.suc) and
    not chain_geq(xs, gt_at(xs), s.suc)
    implies exists(i: Nat, j: Nat) {
        i < j and j < xs.length and esz_pair(xs, i) = esz_pair(xs, j)
    }
}

theorem erdos_szekeres[T: LinearOrder](r: Nat, s: Nat, xs: List[T]) {
    xs.is_unique and xs.length > r * s implies
    chain_geq(xs, lt_at(xs), r.suc) or chain_geq(xs, gt_at(xs), s.suc)
}

define range_sum[A: AddCommMonoid](f: Nat -> A, n: Nat) -> A {
    match n {
        Nat.zero {
            A.0
        }
        Nat.suc(k) {
            range_sum(f, k) + f(k)
        }
    }
}

theorem range_sum_zero[A: AddCommMonoid](f: Nat -> A) {
    range_sum(f, Nat.0) = A.0
}

theorem range_sum_suc[A: AddCommMonoid](f: Nat -> A, k: Nat) {
    range_sum(f, k.suc) = range_sum(f, k) + f(k)
}

theorem range_sum_one[A: AddCommMonoid](f: Nat -> A) {
    range_sum(f, Nat.1) = f(Nat.0)
}

theorem range_sum_congr[A: AddCommMonoid](f: Nat -> A, g: Nat -> A, n: Nat) {
    (forall(i: Nat) { i < n implies f(i) = g(i) }) implies range_sum(f, n) = range_sum(g, n)
}

theorem range_sum_add[A: AddCommMonoid](f: Nat -> A, g: Nat -> A, n: Nat) {
    range_sum(add_fn(f, g), n) = range_sum(f, n) + range_sum(g, n)
}

define shift_fn[A: AddCommMonoid](f: Nat -> A, a: Nat, i: Nat) -> A {
    f(a + i)
}

theorem range_sum_split[A: AddCommMonoid](f: Nat -> A, m: Nat, n: Nat) {
    range_sum(f, m + n) = range_sum(f, m) + range_sum(shift_fn(f, m), n)
}

theorem shift_fn_zero[A: AddCommMonoid](f: Nat -> A, i: Nat) {
    shift_fn(f, Nat.0, i) = f(i)
}

theorem shift_fn_add[A: AddCommMonoid](f: Nat -> A, a: Nat, b: Nat, i: Nat) {
    shift_fn(shift_fn(f, a), b, i) = shift_fn(f, a + b, i)
}

theorem range_sum_shift_split[A: AddCommMonoid](f: Nat -> A, a: Nat, b: Nat, n: Nat) {
    range_sum(shift_fn(f, a + b), n) = range_sum(shift_fn(shift_fn(f, a), b), n)
}

theorem range_sum_split_twice[A: AddCommMonoid](f: Nat -> A, a: Nat, b: Nat, c: Nat) {
    range_sum(f, a + (b + c)) = (range_sum(f, a) + range_sum(shift_fn(f, a), b))
        + range_sum(shift_fn(shift_fn(f, a), b), c)
}

define zero_fn[A: AddCommMonoid](i: Nat) -> A {
    A.0
}

theorem range_sum_zero_fn[A: AddCommMonoid](n: Nat) {
    range_sum(zero_fn[A], n) = A.0
}

theorem range_sum_le(f: Nat -> Nat, g: Nat -> Nat, n: Nat) {
    (forall(i: Nat) { f(i) <= g(i) }) implies range_sum(f, n) <= range_sum(g, n)
}

theorem range_sum_le_count_mul(f: Nat -> Nat, c: Nat, n: Nat) {
    (forall(i: Nat) { f(i) <= c }) implies range_sum(f, n) <= n * c
}

define two_pow(i: Nat) -> Nat {
    Nat.2.pow(i)
}

theorem two_pow_zero {
    two_pow(Nat.0) = Nat.1
}

theorem two_pow_suc(i: Nat) {
    two_pow(i.suc) = two_pow(i) + two_pow(i)
}

theorem two_pow_positive(i: Nat) {
    Nat.0 < two_pow(i)
}

theorem two_pow_lt_suc(i: Nat) {
    two_pow(i) < two_pow(i.suc)
}

define bit_set(n: Nat, i: Nat) -> Bool {
    two_pow(i) <= n.mod(two_pow(i.suc))
}

theorem bit_set_eq(n: Nat, i: Nat) {
    bit_set(n, i) = (two_pow(i) <= n.mod(two_pow(i.suc)))
}

theorem bit_clear_of_lt(n: Nat, i: Nat) {
    n < two_pow(i) implies not bit_set(n, i)
}

theorem bit_set_of_add(r: Nat, i: Nat) {
    r < two_pow(i) implies bit_set(two_pow(i) + r, i)
}

theorem binary_halves_differ(i: Nat, r: Nat) {
    r < two_pow(i) implies not bit_set(r, i) and bit_set(two_pow(i) + r, i)
}

theorem bit_clear_zero(i: Nat) {
    not bit_set(Nat.0, i)
}

theorem range_sum_binary_split[A: AddCommMonoid](f: Nat -> A, i: Nat) {
    range_sum(f, two_pow(i.suc)) =
        range_sum(f, two_pow(i)) + range_sum(shift_fn(f, two_pow(i)), two_pow(i))
}

theorem range_sum_halves_congr[A: AddCommMonoid](
    f: Nat -> A, g: Nat -> A, i: Nat
) {
    (forall(r: Nat) {
        r < two_pow(i) implies f(two_pow(i) + r) = g(r)
    }) implies range_sum(shift_fn(f, two_pow(i)), two_pow(i)) = range_sum(g, two_pow(i))
}

define is_upper_bound_of(f: Nat -> Bool, b: Nat) -> Bool {
    forall(n: Nat) {
        f(n) implies n <= b
    }
}

theorem is_upper_bound_of_apply(f: Nat -> Bool, b: Nat, n: Nat) {
    is_upper_bound_of(f, b) and f(n) implies n <= b
}

theorem is_upper_bound_of_intro(f: Nat -> Bool, b: Nat) {
    (forall(n: Nat) { f(n) implies n <= b }) implies is_upper_bound_of(f, b)
}

define is_max(f: Nat -> Bool, m: Nat) -> Bool {
    f(m) and is_upper_bound_of(f, m)
}

theorem is_max_apply(f: Nat -> Bool, m: Nat) {
    is_max(f, m) implies f(m)
}

theorem is_max_is_upper_bound(f: Nat -> Bool, m: Nat, n: Nat) {
    is_max(f, m) and f(n) implies n <= m
}

theorem is_max_intro(f: Nat -> Bool, m: Nat) {
    f(m) and is_upper_bound_of(f, m) implies is_max(f, m)
}

theorem has_max(f: Nat -> Bool, witness: Nat, bound: Nat) {
    f(witness) and is_upper_bound_of(f, bound) implies exists(m: Nat) { is_max(f, m) }
}

theorem max_unique(f: Nat -> Bool, m: Nat, m2: Nat) {
    is_max(f, m) and is_max(f, m2) implies m = m2
}

define count_upto(p: Nat -> Bool, n: Nat) -> Nat {
    match n {
        Nat.zero {
            Nat.0
        }
        Nat.suc(k) {
            if p(k) {
                count_upto(p, k) + Nat.1
            } else {
                count_upto(p, k)
            }
        }
    }
}

theorem count_upto_zero(p: Nat -> Bool) {
    count_upto(p, Nat.0) = Nat.0
}

theorem count_upto_suc_true(p: Nat -> Bool, k: Nat) {
    p(k) implies count_upto(p, k.suc) = count_upto(p, k) + Nat.1
}

theorem count_upto_suc_false(p: Nat -> Bool, k: Nat) {
    not p(k) implies count_upto(p, k.suc) = count_upto(p, k)
}

theorem count_upto_suc_bounds(p: Nat -> Bool, k: Nat) {
    count_upto(p, k) <= count_upto(p, k.suc)
        and count_upto(p, k.suc) <= count_upto(p, k) + Nat.1
}

theorem count_upto_le(p: Nat -> Bool, n: Nat) {
    count_upto(p, n) <= n
}

theorem count_upto_mono(p: Nat -> Bool, m: Nat, n: Nat) {
    m <= n implies count_upto(p, m) <= count_upto(p, n)
}

theorem count_upto_mono_pred(p: Nat -> Bool, r: Nat -> Bool, n: Nat) {
    (forall(i: Nat) { i < n implies (p(i) implies r(i)) })
        implies count_upto(p, n) <= count_upto(r, n)
}

define complement_pred(p: Nat -> Bool, i: Nat) -> Bool {
    not p(i)
}

theorem count_upto_complement(p: Nat -> Bool, n: Nat) {
    count_upto(p, n) + count_upto(complement_pred(p), n) = n
}

define all_pred(i: Nat) -> Bool {
    true
}

theorem count_upto_all(n: Nat) {
    count_upto(all_pred, n) = n
}

define none_pred(i: Nat) -> Bool {
    false
}

theorem count_upto_none(n: Nat) {
    count_upto(none_pred, n) = Nat.0
}

theorem nat_div_div(n: Nat, a: Nat, b: Nat) {
    Nat.0 < a and Nat.0 < b implies n.div(a * b) = (n.div(a)).div(b)
}

theorem nat_mod_mul(n: Nat, a: Nat, b: Nat) {
    Nat.0 < a and Nat.0 < b implies
        n.mod(a * b) = (n.div(a)).mod(b) * a + n.mod(a)
}

theorem nat_div_div_comm(n: Nat, a: Nat, b: Nat) {
    Nat.0 < a and Nat.0 < b implies (n.div(a)).div(b) = (n.div(b)).div(a)
}

theorem nat_pow_pos(b: Nat, k: Nat) {
    Nat.0 < b implies Nat.0 < b.pow(k)
}

theorem nat_div_pow_suc(b: Nat, n: Nat, k: Nat) {
    Nat.0 < b implies n.div(b.pow(k.suc)) = (n.div(b.pow(k))).div(b)
}

define nat_digit(b: Nat, n: Nat, k: Nat) -> Nat {
    (n.div(b.pow(k))).mod(b)
}

theorem nat_digit_lt_base(b: Nat, n: Nat, k: Nat) {
    Nat.0 < b implies nat_digit(b, n, k) < b
}

theorem nat_digit_eq_div_sub(b: Nat, n: Nat, k: Nat) {
    Nat.0 < b implies
        (n.div(b.pow(k))).div(b) * b + nat_digit(b, n, k) = n.div(b.pow(k))
}

define eventually_after_nat(p: Nat -> Bool, n0: Nat) -> Bool {
    forall(n: Nat) {
        n0 <= n implies p(n)
    }
}

define eventually_predicate_nat(p: Nat -> Bool) -> Bool {
    exists(n0: Nat) {
        eventually_after_nat(p, n0)
    }
}

define eventually_in_nat_set(s: Set[Nat]) -> Bool {
    eventually_predicate_nat(s.contains)
}

define predicate_and_nat(p: Nat -> Bool, q: Nat -> Bool, n: Nat) -> Bool {
    p(n) and q(n)
}

define predicate_true_nat(n: Nat) -> Bool {
    true
}

theorem eventually_after_nat_at(p: Nat -> Bool, n0: Nat, n: Nat) {
    eventually_after_nat(p, n0) and n0 <= n implies p(n)
}

theorem eventually_predicate_nat_intro(p: Nat -> Bool, n0: Nat) {
    eventually_after_nat(p, n0) implies eventually_predicate_nat(p)
}

theorem eventually_predicate_nat_has_witness(p: Nat -> Bool) {
    eventually_predicate_nat(p) implies exists(n0: Nat) {
        eventually_after_nat(p, n0)
    }
}

theorem eventually_predicate_nat_of_forall(p: Nat -> Bool) {
    (forall(n: Nat) { p(n) }) implies eventually_predicate_nat(p)
}

theorem eventually_predicate_nat_true {
    eventually_predicate_nat(predicate_true_nat)
}

theorem eventually_after_nat_strengthen(p: Nat -> Bool, n0: Nat, n1: Nat) {
    eventually_after_nat(p, n0) and n0 <= n1 implies eventually_after_nat(p, n1)
}

theorem eventually_predicate_nat_monotone(p: Nat -> Bool, q: Nat -> Bool) {
    predicate_subset(p, q) and eventually_predicate_nat(p) implies eventually_predicate_nat(q)
}

theorem eventually_predicate_nat_transport_eq(p: Nat -> Bool, q: Nat -> Bool) {
    p = q and eventually_predicate_nat(p) implies eventually_predicate_nat(q)
}

theorem eventually_predicate_nat_conjunction(p: Nat -> Bool, q: Nat -> Bool) {
    eventually_predicate_nat(p) and eventually_predicate_nat(q)
    implies eventually_predicate_nat(predicate_and_nat(p, q))
}

theorem eventually_predicate_nat_conjunction_left(p: Nat -> Bool, q: Nat -> Bool) {
    eventually_predicate_nat(predicate_and_nat(p, q)) implies eventually_predicate_nat(p)
}

theorem eventually_predicate_nat_conjunction_right(p: Nat -> Bool, q: Nat -> Bool) {
    eventually_predicate_nat(predicate_and_nat(p, q)) implies eventually_predicate_nat(q)
}

theorem eventually_predicate_nat_iff_nat_from_subset(p: Nat -> Bool) {
    eventually_predicate_nat(p) = exists(n0: Nat) {
        nat_from(n0).subset(Set[Nat].new(p))
    }
}

theorem eventually_in_nat_set_iff_nat_from_subset(s: Set[Nat]) {
    eventually_in_nat_set(s) = exists(n0: Nat) {
        nat_from(n0).subset(s)
    }
}

theorem eventually_in_nat_set_of_subset(s: Set[Nat], t: Set[Nat]) {
    s.subset(t) and eventually_in_nat_set(s) implies eventually_in_nat_set(t)
}

theorem eventually_in_nat_set_intersection(s: Set[Nat], t: Set[Nat]) {
    eventually_in_nat_set(s) and eventually_in_nat_set(t) implies eventually_in_nat_set(s.intersection(t))
}

define negate_pred(p: Nat -> Bool, n: Nat) -> Bool {
    not p(n)
}

theorem negate_pred_eq(p: Nat -> Bool, n: Nat) {
    negate_pred(p)(n) = not p(n)
}

define is_least_failure(p: Nat -> Bool, m: Nat) -> Bool {
    is_min(negate_pred(p), m)
}

theorem is_least_failure_fails(p: Nat -> Bool, m: Nat) {
    is_least_failure(p, m) implies not p(m)
}

theorem is_least_failure_holds_below(p: Nat -> Bool, m: Nat, x: Nat) {
    is_least_failure(p, m) and x < m implies p(x)
}

theorem is_least_failure_intro(p: Nat -> Bool, m: Nat) {
    not p(m) and (forall(x: Nat) { x < m implies p(x) }) implies is_least_failure(p, m)
}

theorem least_failure_exists(p: Nat -> Bool, n: Nat) {
    not p(n) implies exists(m: Nat) { is_least_failure(p, m) }
}

theorem least_failure_unique(p: Nat -> Bool, m: Nat, m2: Nat) {
    is_least_failure(p, m) and is_least_failure(p, m2) implies m = m2
}

theorem least_failure_is_least(p: Nat -> Bool, m: Nat, x: Nat) {
    is_least_failure(p, m) and not p(x) implies m <= x
}

theorem least_failure_positive_holds_at_zero(p: Nat -> Bool, m: Nat) {
    is_least_failure(p, m) and Nat.0 < m implies p(Nat.0)
}

theorem least_failure_positive(p: Nat -> Bool, m: Nat) {
    is_least_failure(p, m) and p(Nat.0) implies Nat.0 < m
}

theorem least_failure_lower_bound(p: Nat -> Bool, m: Nat, b: Nat) {
    is_least_failure(p, m) and (forall(x: Nat) { x < b implies p(x) }) implies b <= m
}

theorem add_mod_self(x: Nat, n: Nat) {
    n != Nat.0 implies (x + n).mod(n) = x.mod(n)
}

theorem small_add_mod_self(x: Nat, n: Nat) {
    x < n implies (x + n).mod(n) = x
}

theorem suc_mod_cases(v: Nat, n: Nat, w: Nat) {
    v < n and v.suc.mod(n) = w implies
        (w = v.suc or (v.suc = n and w = Nat.0))
}

theorem mul_swap_inner(a: Nat, b: Nat, c: Nat, d: Nat) {
    (a * b) * (c * d) = (a * c) * (b * d)
}

theorem mul_shift_left(a: Nat, b: Nat, c: Nat) {
    (a * b) * c = (a * c) * b
}

theorem mul_self_mul_self(a: Nat, b: Nat) {
    (a * a) * (b * b) = (a * b) * (a * b)
}

define is_multiplicative(f: Nat -> Nat) -> Bool {
    f(Nat.1) = Nat.1 and forall(m: Nat, n: Nat) {
        m.coprime(n) implies f(m * n) = f(m) * f(n)
    }
}

theorem is_multiplicative_apply(f: Nat -> Nat, m: Nat, n: Nat) {
    is_multiplicative(f) and m.coprime(n) implies f(m * n) = f(m) * f(n)
}

theorem is_multiplicative_one(f: Nat -> Nat) {
    is_multiplicative(f) implies f(Nat.1) = Nat.1
}

theorem is_multiplicative_intro(f: Nat -> Nat) {
    f(Nat.1) = Nat.1 and
    (forall(m: Nat, n: Nat) { m.coprime(n) implies f(m * n) = f(m) * f(n) })
        implies is_multiplicative(f)
}

define is_completely_multiplicative(f: Nat -> Nat) -> Bool {
    f(Nat.1) = Nat.1 and forall(m: Nat, n: Nat) {
        f(m * n) = f(m) * f(n)
    }
}

theorem is_completely_multiplicative_apply(f: Nat -> Nat, m: Nat, n: Nat) {
    is_completely_multiplicative(f) implies f(m * n) = f(m) * f(n)
}

theorem is_completely_multiplicative_one(f: Nat -> Nat) {
    is_completely_multiplicative(f) implies f(Nat.1) = Nat.1
}

theorem is_completely_multiplicative_intro(f: Nat -> Nat) {
    f(Nat.1) = Nat.1 and (forall(m: Nat, n: Nat) { f(m * n) = f(m) * f(n) })
        implies is_completely_multiplicative(f)
}

theorem multiplicative_of_completely_multiplicative(f: Nat -> Nat) {
    is_completely_multiplicative(f) implies is_multiplicative(f)
}

define id_fn(n: Nat) -> Nat {
    n
}

theorem id_fn_completely_multiplicative {
    is_completely_multiplicative(id_fn)
}

define one_fn_nat(n: Nat) -> Nat {
    Nat.1
}

theorem one_fn_completely_multiplicative {
    is_completely_multiplicative(one_fn_nat)
}

define mul_fn_nat(f: Nat -> Nat, g: Nat -> Nat, n: Nat) -> Nat {
    f(n) * g(n)
}

theorem mul_fn_multiplicative(f: Nat -> Nat, g: Nat -> Nat) {
    is_multiplicative(f) and is_multiplicative(g) implies is_multiplicative(mul_fn_nat(f, g))
}

theorem mul_fn_completely_multiplicative(f: Nat -> Nat, g: Nat -> Nat) {
    is_completely_multiplicative(f) and is_completely_multiplicative(g)
        implies is_completely_multiplicative(mul_fn_nat(f, g))
}

theorem multiplicative_mul_one(f: Nat -> Nat, n: Nat) {
    is_multiplicative(f) implies f(Nat.1 * n) = f(n)
}

define is_smooth(n: Nat, b: Nat) -> Bool {
    forall(p: Nat) {
        p.is_prime and p.divides(n) implies p <= b
    }
}

theorem is_smooth_apply(n: Nat, b: Nat, p: Nat) {
    is_smooth(n, b) and p.is_prime and p.divides(n) implies p <= b
}

theorem is_smooth_intro(n: Nat, b: Nat) {
    (forall(p: Nat) { p.is_prime and p.divides(n) implies p <= b }) implies is_smooth(n, b)
}

theorem is_smooth_weaken(n: Nat, b: Nat, c: Nat) {
    is_smooth(n, b) and b <= c implies is_smooth(n, c)
}

theorem is_smooth_of_divides(n: Nat, m: Nat, b: Nat) {
    is_smooth(n, b) and m.divides(n) implies is_smooth(m, b)
}

define is_rough(n: Nat, b: Nat) -> Bool {
    forall(p: Nat) {
        p.is_prime and p.divides(n) implies b < p
    }
}

theorem is_rough_apply(n: Nat, b: Nat, p: Nat) {
    is_rough(n, b) and p.is_prime and p.divides(n) implies b < p
}

theorem is_rough_intro(n: Nat, b: Nat) {
    (forall(p: Nat) { p.is_prime and p.divides(n) implies b < p }) implies is_rough(n, b)
}

theorem is_rough_of_divides(n: Nat, m: Nat, b: Nat) {
    is_rough(n, b) and m.divides(n) implies is_rough(m, b)
}

theorem smooth_rough_common_divisor_is_one(m: Nat, n: Nat, b: Nat, d: Nat) {
    is_smooth(m, b) and is_rough(n, b) and d.divides(m) and d.divides(n) and d != Nat.0
        implies d = Nat.1
}

theorem smooth_rough_coprime(m: Nat, n: Nat, b: Nat) {
    is_smooth(m, b) and is_rough(n, b) and m != Nat.0 implies m.coprime(n)
}

theorem smooth_and_rough_no_prime_factor(n: Nat, b: Nat, p: Nat) {
    is_smooth(n, b) and is_rough(n, b) and p.is_prime implies not p.divides(n)
}

define has_prime_factor_in(n: Nat, lo: Nat, hi: Nat) -> Bool {
    exists(p: Nat) {
        p.is_prime and lo < p and p <= hi and p.divides(n)
    }
}

theorem has_prime_factor_in_intro(n: Nat, lo: Nat, hi: Nat, p: Nat) {
    p.is_prime and lo < p and p <= hi and p.divides(n) implies has_prime_factor_in(n, lo, hi)
}

theorem has_prime_factor_in_witness(n: Nat, lo: Nat, hi: Nat) {
    has_prime_factor_in(n, lo, hi) implies exists(p: Nat) {
        p.is_prime and lo < p and p <= hi and p.divides(n)
    }
}

theorem has_prime_factor_in_widen(n: Nat, lo: Nat, hi: Nat, lo2: Nat, hi2: Nat) {
    has_prime_factor_in(n, lo, hi) and lo2 <= lo and hi <= hi2
        implies has_prime_factor_in(n, lo2, hi2)
}

theorem has_prime_factor_in_of_divides(n: Nat, m: Nat, lo: Nat, hi: Nat) {
    has_prime_factor_in(m, lo, hi) and m.divides(n) implies has_prime_factor_in(n, lo, hi)
}

define all_prime_factors_in(n: Nat, lo: Nat, hi: Nat) -> Bool {
    is_rough(n, lo) and is_smooth(n, hi)
}

theorem all_prime_factors_in_apply(n: Nat, lo: Nat, hi: Nat, p: Nat) {
    all_prime_factors_in(n, lo, hi) and p.is_prime and p.divides(n)
        implies lo < p and p <= hi
}

theorem all_prime_factors_in_intro(n: Nat, lo: Nat, hi: Nat) {
    (forall(p: Nat) { p.is_prime and p.divides(n) implies lo < p and p <= hi })
        implies all_prime_factors_in(n, lo, hi)
}

theorem prime_factor_lands_in_interval(n: Nat, lo: Nat, hi: Nat, lo2: Nat, hi2: Nat) {
    all_prime_factors_in(n, lo, hi) and has_prime_factor_in(n, lo2, hi2)
        implies has_prime_factor_in(n, lo, hi)
}

theorem all_prime_factors_in_of_divides(n: Nat, m: Nat, lo: Nat, hi: Nat) {
    all_prime_factors_in(n, lo, hi) and m.divides(n) implies all_prime_factors_in(m, lo, hi)
}

theorem no_prime_factor_of_empty_interval(n: Nat, lo: Nat, hi: Nat, p: Nat) {
    all_prime_factors_in(n, lo, hi) and hi <= lo and p.is_prime implies not p.divides(n)
}

define range_prod[M: CommMonoid](f: Nat -> M, n: Nat) -> M {
    match n {
        Nat.zero {
            M.1
        }
        Nat.suc(k) {
            range_prod(f, k) * f(k)
        }
    }
}

theorem range_prod_zero[M: CommMonoid](f: Nat -> M) {
    range_prod(f, Nat.0) = M.1
}

theorem range_prod_suc[M: CommMonoid](f: Nat -> M, k: Nat) {
    range_prod(f, k.suc) = range_prod(f, k) * f(k)
}

theorem range_prod_one[M: CommMonoid](f: Nat -> M) {
    range_prod(f, Nat.1) = f(Nat.0)
}

theorem range_prod_congr[M: CommMonoid](f: Nat -> M, g: Nat -> M, n: Nat) {
    (forall(i: Nat) { i < n implies f(i) = g(i) }) implies range_prod(f, n) = range_prod(g, n)
}

define prod_shift_fn[M: CommMonoid](f: Nat -> M, a: Nat, i: Nat) -> M {
    f(a + i)
}

theorem range_prod_split[M: CommMonoid](f: Nat -> M, m: Nat, n: Nat) {
    range_prod(f, m + n) = range_prod(f, m) * range_prod(prod_shift_fn(f, m), n)
}

define pointwise_mul_fn[M: CommMonoid](f: Nat -> M, g: Nat -> M, i: Nat) -> M {
    f(i) * g(i)
}

theorem range_prod_mul[M: CommMonoid](f: Nat -> M, g: Nat -> M, n: Nat) {
    range_prod(pointwise_mul_fn(f, g), n) = range_prod(f, n) * range_prod(g, n)
}

define pointwise_one_fn[M: CommMonoid](i: Nat) -> M {
    M.1
}

theorem range_prod_one_fn[M: CommMonoid](n: Nat) {
    range_prod(pointwise_one_fn[M], n) = M.1
}

theorem range_prod_divides_term(f: Nat -> Nat, n: Nat, k: Nat) {
    k < n implies f(k).divides(range_prod(f, n))
}

theorem range_prod_positive(f: Nat -> Nat, n: Nat) {
    (forall(i: Nat) { i < n implies Nat.0 < f(i) }) implies Nat.0 < range_prod(f, n)
}

define range_set(n: Nat) -> FiniteSet[Nat] {
    fs_from_list(n.range)
}

theorem range_set_contains_eq(n: Nat, x: Nat) {
    range_set(n).contains(x) = (x < n)
}

theorem range_set_contains(n: Nat, x: Nat) {
    x < n implies range_set(n).contains(x)
}

theorem range_set_lt(n: Nat, x: Nat) {
    range_set(n).contains(x) implies x < n
}

theorem range_set_subset(m: Nat, n: Nat) {
    m <= n implies range_set(m).subset_eq(range_set(n))
}

theorem range_set_suc(n: Nat, x: Nat) {
    range_set(n.suc).contains(x) = (range_set(n).contains(x) or x = n)
}

theorem range_set_card(n: Nat) {
    fs_card(range_set(n)) = n
}

theorem range_sum_eq_partial[A: AddCommMonoid](f: Nat -> A, n: Nat) {
    range_sum(f, n) = partial(f, n)
}

theorem range_sum_eq_list_sum[A: AddCommMonoid](f: Nat -> A, n: Nat) {
    range_sum(f, n) = sum(map(n.range, f))
}

theorem range_sum_eq_finite_set_sum[A: AddCommMonoid](f: Nat -> A, n: Nat) {
    range_sum(f, n) = finite_set_sum(range_set(n), f)
}

define row_sum[A: AddCommMonoid](g: Nat -> (Nat -> A), n: Nat, i: Nat) -> A {
    range_sum(g(i), n)
}

define col_fn[A: AddCommMonoid](g: Nat -> (Nat -> A), j: Nat, i: Nat) -> A {
    g(i)(j)
}

define col_sum[A: AddCommMonoid](g: Nat -> (Nat -> A), m: Nat, j: Nat) -> A {
    range_sum(col_fn(g, j), m)
}

theorem col_sum_suc[A: AddCommMonoid](g: Nat -> (Nat -> A), m: Nat) {
    col_sum(g, m.suc) = add_fn(col_sum(g, m), g(m))
}

theorem range_sum_interchange[A: AddCommMonoid](g: Nat -> (Nat -> A), m: Nat, n: Nat) {
    range_sum(row_sum(g, n), m) = range_sum(col_sum(g, m), n)
}

theorem partial_interchange[A: AddCommMonoid](g: Nat -> (Nat -> A), m: Nat, n: Nat) {
    partial(row_sum(g, n), m) = partial(col_sum(g, m), n)
}

define scale_fn[R: Semiring](c: R, f: Nat -> R, i: Nat) -> R {
    c * f(i)
}

theorem range_sum_scale[R: Semiring](c: R, f: Nat -> R, n: Nat) {
    range_sum(scale_fn(c, f), n) = c * range_sum(f, n)
}

define rev_fn[A: AddCommMonoid](f: Nat -> A, n: Nat, i: Nat) -> A {
    f(n - i.suc)
}

theorem rev_fn_suc_below[A: AddCommMonoid](f: Nat -> A, n: Nat, i: Nat) {
    i < n implies rev_fn(f, n.suc, i) = rev_fn(shift_fn(f, Nat.1), n, i)
}

theorem rev_fn_top[A: AddCommMonoid](f: Nat -> A, n: Nat) {
    rev_fn(f, n.suc, n) = f(Nat.0)
}

theorem range_sum_rev[A: AddCommMonoid](f: Nat -> A, n: Nat) {
    range_sum(f, n) = range_sum(rev_fn(f, n), n)
}

theorem partial_rev[A: AddCommMonoid](f: Nat -> A, n: Nat) {
    partial(f, n) = partial(rev_fn(f, n), n)
}

theorem range_sum_scalar_mul[S: Semiring](c: S, f: Nat -> S, n: Nat) {
    c * range_sum(f, n) = range_sum(mul_fn(c, f), n)
}

define const_fn[S: Semiring](c: S, i: Nat) -> S {
    c
}

define semiring_count[S: Semiring](n: Nat) -> S {
    range_sum(const_fn(S.1), n)
}

theorem range_sum_const[S: Semiring](c: S, n: Nat) {
    range_sum(const_fn(c), n) = semiring_count[S](n) * c
}

theorem semiring_count_suc[S: Semiring](n: Nat) {
    semiring_count[S](n.suc) = semiring_count[S](n) + S.1
}

theorem semiring_count_zero[S: Semiring] {
    semiring_count[S](Nat.0) = S.0
}

theorem semiring_count_one[S: Semiring] {
    semiring_count[S](Nat.1) = S.1
}

theorem range_sum_const_congr[S: Semiring](f: Nat -> S, c: S, n: Nat) {
    (forall(i: Nat) { i < n implies f(i) = c })
        implies range_sum(f, n) = semiring_count[S](n) * c
}

theorem range_sum_const_zero[S: Semiring](n: Nat) {
    range_sum(const_fn(S.0), n) = S.0
}

define in_residue_class(m: Nat, a: Nat) -> (Nat -> Bool) {
    function(k: Nat) {
        k.mod(m) = a
    }
}

theorem in_residue_class_apply(m: Nat, a: Nat, k: Nat) {
    in_residue_class(m, a)(k) = (k.mod(m) = a)
}

theorem residue_class_in_block(m: Nat, a: Nat, q: Nat, i: Nat) {
    a < m and i < m implies (in_residue_class(m, a)(q * m + i) = (i = a))
}

theorem count_upto_in_block_before(m: Nat, a: Nat, q: Nat, j: Nat) {
    a < m and j <= a implies count_upto(in_residue_class(m, a), q * m + j)
        = count_upto(in_residue_class(m, a), q * m)
}

theorem count_upto_in_block_after(m: Nat, a: Nat, q: Nat, j: Nat) {
    a < m and a < j and j <= m implies count_upto(in_residue_class(m, a), q * m + j)
        = count_upto(in_residue_class(m, a), q * m) + Nat.1
}

theorem count_upto_block_step(m: Nat, a: Nat, q: Nat) {
    a < m implies count_upto(in_residue_class(m, a), q * m + m)
        = count_upto(in_residue_class(m, a), q * m) + Nat.1
}

theorem count_upto_multiple(m: Nat, a: Nat, q: Nat) {
    a < m implies count_upto(in_residue_class(m, a), q * m) = q
}

theorem count_upto_residue_cases(m: Nat, a: Nat, n: Nat) {
    a < m implies (count_upto(in_residue_class(m, a), n) = n.div(m)
        or count_upto(in_residue_class(m, a), n) = n.div(m) + Nat.1)
}

theorem count_upto_residue_lower(m: Nat, a: Nat, n: Nat) {
    a < m implies n.div(m) <= count_upto(in_residue_class(m, a), n)
}

theorem count_upto_residue_upper(m: Nat, a: Nat, n: Nat) {
    a < m implies count_upto(in_residue_class(m, a), n) <= n.div(m) + Nat.1
}

theorem count_upto_residue_bounds(m: Nat, a: Nat, n: Nat) {
    a < m implies m * count_upto(in_residue_class(m, a), n) <= n + m
        and n <= m * count_upto(in_residue_class(m, a), n) + m
}

define point_fn[A: AddCommMonoid](p: Nat, v: A, a: Nat) -> A {
    if a = p {
        v
    } else {
        A.0
    }
}

theorem point_fn_at[A: AddCommMonoid](p: Nat, v: A) {
    point_fn(p, v, p) = v
}

theorem point_fn_off[A: AddCommMonoid](p: Nat, v: A, a: Nat) {
    a != p implies point_fn(p, v, a) = A.0
}

theorem range_sum_zero_of_vanishes[A: AddCommMonoid](f: Nat -> A, n: Nat) {
    (forall(i: Nat) { i < n implies f(i) = A.0 }) implies range_sum(f, n) = A.0
}

theorem range_sum_point_fn[A: AddCommMonoid](p: Nat, v: A, m: Nat) {
    p < m implies range_sum(point_fn(p, v), m) = v
}

define residue_summand[A: AddCommMonoid](m: Nat, a: Nat, f: Nat -> A, i: Nat) -> A {
    if i.mod(m) = a {
        f(i)
    } else {
        A.0
    }
}

theorem residue_summand_in[A: AddCommMonoid](m: Nat, a: Nat, f: Nat -> A, i: Nat) {
    i.mod(m) = a implies residue_summand(m, a, f, i) = f(i)
}

theorem residue_summand_out[A: AddCommMonoid](m: Nat, a: Nat, f: Nat -> A, i: Nat) {
    i.mod(m) != a implies residue_summand(m, a, f, i) = A.0
}

define residue_range_sum[A: AddCommMonoid](m: Nat, a: Nat, f: Nat -> A, n: Nat) -> A {
    range_sum(residue_summand(m, a, f), n)
}

theorem residue_range_sum_zero[A: AddCommMonoid](m: Nat, a: Nat, f: Nat -> A) {
    residue_range_sum(m, a, f, Nat.0) = A.0
}

theorem residue_range_sum_suc[A: AddCommMonoid](m: Nat, a: Nat, f: Nat -> A, n: Nat) {
    residue_range_sum(m, a, f, n.suc)
        = residue_range_sum(m, a, f, n) + residue_summand(m, a, f, n)
}

define residue_class_sums[A: AddCommMonoid](m: Nat, f: Nat -> A, n: Nat, a: Nat) -> A {
    residue_range_sum(m, a, f, n)
}

define residue_class_delta[A: AddCommMonoid](m: Nat, f: Nat -> A, n: Nat, a: Nat) -> A {
    residue_summand(m, a, f, n)
}

theorem residue_class_delta_eq_point[A: AddCommMonoid](m: Nat, f: Nat -> A, n: Nat) {
    residue_class_delta(m, f, n) = point_fn(n.mod(m), f(n))
}

theorem residue_class_sums_suc[A: AddCommMonoid](m: Nat, f: Nat -> A, n: Nat) {
    residue_class_sums(m, f, n.suc)
        = add_fn(residue_class_sums(m, f, n), residue_class_delta(m, f, n))
}

theorem range_sum_eq_residue_class_sums[A: AddCommMonoid](m: Nat, f: Nat -> A, n: Nat) {
    m != Nat.0 implies range_sum(f, n) = range_sum(residue_class_sums(m, f, n), m)
}

define is_square(n: Nat) -> Bool {
    exists(r: Nat) {
        n = r * r
    }
}

theorem is_square_intro(n: Nat, r: Nat) {
    n = r * r implies is_square(n)
}

theorem is_square_witness(n: Nat) {
    is_square(n) implies exists(r: Nat) { n = r * r }
}

theorem zero_is_square {
    is_square(Nat.0)
}

theorem one_is_square {
    is_square(Nat.1)
}

theorem mul_self_is_square(r: Nat) {
    is_square(r * r)
}

theorem square_mul_square(m: Nat, n: Nat) {
    is_square(m) and is_square(n) implies is_square(m * n)
}

theorem square_of_square(n: Nat) {
    is_square(n) implies is_square(n * n)
}

theorem square_mul_one(n: Nat) {
    is_square(n) implies is_square(n * Nat.1)
}

define is_squarefree(n: Nat) -> Bool {
    forall(d: Nat) {
        is_square(d) and d.divides(n) implies d = Nat.1
    }
}

theorem is_squarefree_apply(n: Nat, d: Nat) {
    is_squarefree(n) and is_square(d) and d.divides(n) implies d = Nat.1
}

theorem is_squarefree_intro(n: Nat) {
    (forall(d: Nat) { is_square(d) and d.divides(n) implies d = Nat.1 }) implies is_squarefree(n)
}

theorem one_is_squarefree {
    is_squarefree(Nat.1)
}

theorem squarefree_and_square_is_one(n: Nat) {
    is_squarefree(n) and is_square(n) implies n = Nat.1
}

theorem squarefree_of_divides(n: Nat, m: Nat) {
    is_squarefree(n) and m.divides(n) implies is_squarefree(m)
}

theorem not_squarefree_of_square_divisor(n: Nat, d: Nat) {
    is_square(d) and d.divides(n) and d != Nat.1 implies not is_squarefree(n)
}

define square_divisor_pred(n: Nat) -> (Nat -> Bool) {
    function(d: Nat) {
        (d * d).divides(n)
    }
}

theorem square_divisor_pred_one(n: Nat) {
    square_divisor_pred(n)(Nat.1)
}

theorem square_divisor_pred_bound(n: Nat, d: Nat) {
    Nat.1 <= n and square_divisor_pred(n)(d) implies d <= n
}

theorem square_divisor_pred_upper_bound(n: Nat) {
    Nat.1 <= n implies is_upper_bound_of(square_divisor_pred(n), n)
}

let square_part(n: Nat) -> result: Nat satisfy {
    Nat.1 <= n implies is_max(square_divisor_pred(n), result)
}

theorem square_part_divides(n: Nat) {
    Nat.1 <= n implies (square_part(n) * square_part(n)).divides(n)
}

theorem square_part_is_greatest(n: Nat, d: Nat) {
    Nat.1 <= n and (d * d).divides(n) implies d <= square_part(n)
}

theorem square_part_pos(n: Nat) {
    Nat.1 <= n implies Nat.1 <= square_part(n)
}

define squarefree_part(n: Nat) -> Nat {
    n.div(square_part(n) * square_part(n))
}

theorem square_squarefree_decomposition(n: Nat) {
    Nat.1 <= n implies square_part(n) * square_part(n) * squarefree_part(n) = n
}

theorem squarefree_part_pos(n: Nat) {
    Nat.1 <= n implies Nat.1 <= squarefree_part(n)
}

theorem squarefree_part_is_squarefree(n: Nat) {
    Nat.1 <= n implies is_squarefree(squarefree_part(n))
}

theorem square_lte_cancel(a: Nat, b: Nat) {
    a * a <= b * b implies a <= b
}

theorem squarefree_part_divides(n: Nat) {
    Nat.1 <= n implies squarefree_part(n).divides(n)
}

theorem squarefree_part_of_squarefree(n: Nat) {
    Nat.1 <= n and is_squarefree(n)
        implies square_part(n) = Nat.1 and squarefree_part(n) = n
}

theorem square_part_of_square(r: Nat) {
    Nat.1 <= r implies
        (square_part(r * r) = r and squarefree_part(r * r) = Nat.1)
}

theorem is_square_iff_squarefree_part_one(n: Nat) {
    Nat.1 <= n implies (is_square(n) = (squarefree_part(n) = Nat.1))
}

theorem square_part_divides_self(n: Nat) {
    Nat.1 <= n implies square_part(n).divides(n)
}

theorem squarefree_of_square_part_one(n: Nat) {
    Nat.1 <= n and square_part(n) = Nat.1 implies is_squarefree(n)
}

theorem is_squarefree_iff_square_part_one(n: Nat) {
    Nat.1 <= n implies (is_squarefree(n) = (square_part(n) = Nat.1))
}

theorem is_squarefree_iff_squarefree_part_self(n: Nat) {
    Nat.1 <= n implies (is_squarefree(n) = (squarefree_part(n) = n))
}

define no_prime_square_divides(n: Nat) -> Bool {
    forall(p: Nat) {
        p.is_prime implies not (p * p).divides(n)
    }
}

theorem no_prime_square_divides_apply(n: Nat, p: Nat) {
    no_prime_square_divides(n) and p.is_prime implies not (p * p).divides(n)
}

theorem no_prime_square_divides_intro(n: Nat) {
    (forall(p: Nat) { p.is_prime implies not (p * p).divides(n) })
        implies no_prime_square_divides(n)
}

theorem no_prime_square_divides_of_squarefree(n: Nat) {
    is_squarefree(n) implies no_prime_square_divides(n)
}

theorem squarefree_of_no_prime_square_divides(n: Nat) {
    no_prime_square_divides(n) implies is_squarefree(n)
}

theorem is_squarefree_iff_no_prime_square_divides(n: Nat) {
    is_squarefree(n) = no_prime_square_divides(n)
}

define diag_fn[A: AddCommMonoid](h: Nat -> (Nat -> A), i: Nat, j: Nat) -> A {
    h(j)(i - j)
}

define diag_sum[A: AddCommMonoid](h: Nat -> (Nat -> A), i: Nat) -> A {
    range_sum(diag_fn(h, i), i.suc)
}

define tri_diag_sum[A: AddCommMonoid](h: Nat -> (Nat -> A), k: Nat) -> A {
    range_sum(diag_sum(h), k.suc)
}

define row_upto_sum[A: AddCommMonoid](h: Nat -> (Nat -> A), k: Nat, a: Nat) -> A {
    range_sum(h(a), (k - a).suc)
}

define tri_row_sum[A: AddCommMonoid](h: Nat -> (Nat -> A), k: Nat) -> A {
    range_sum(row_upto_sum(h, k), k.suc)
}

theorem row_upto_sum_suc[A: AddCommMonoid](h: Nat -> (Nat -> A), k: Nat, a: Nat) {
    a <= k implies row_upto_sum(h, k.suc, a)
        = row_upto_sum(h, k, a) + diag_fn(h, k.suc, a)
}

theorem row_upto_sum_top[A: AddCommMonoid](h: Nat -> (Nat -> A), k: Nat) {
    row_upto_sum(h, k, k) = h(k)(Nat.0)
}

theorem diag_fn_top[A: AddCommMonoid](h: Nat -> (Nat -> A), k: Nat) {
    diag_fn(h, k, k) = h(k)(Nat.0)
}

theorem tri_sum_eq[A: AddCommMonoid](h: Nat -> (Nat -> A), k: Nat) {
    tri_diag_sum(h, k) = tri_row_sum(h, k)
}
