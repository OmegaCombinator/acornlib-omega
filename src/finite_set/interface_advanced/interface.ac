theorem locally_injective_map_is_unique[T, U](items: List[T], f: T -> U) {
    items.is_unique and forall(x: T, y: T) {
        items.contains(x) and items.contains(y) and f(x) = f(y) implies x = y
    }
    implies map[T, U](items, f).is_unique
}

theorem locally_injective_map_preserves_unique_length[T, U](items: List[T], f: T -> U) {
    items.is_unique and forall(x: T, y: T) {
        items.contains(x) and items.contains(y) and f(x) = f(y) implies x = y
    }
    implies map[T, U](items, f).is_unique and map[T, U](items, f).length = items.length
}

theorem finite_list_pigeonhole_into_shorter_list[T, U](items: List[T], targets: List[U], f: T -> U) {
    items.is_unique and items.length > targets.length and
    forall(x: T) {
        items.contains(x) implies targets.contains(f(x))
    } implies exists(x: T, y: T) {
        items.contains(x) and items.contains(y) and x != y and f(x) = f(y)
    }
}

theorem finite_list_local_injection_is_surjective[T, U](items: List[T], targets: List[U], f: T -> U) {
    items.is_unique and targets.is_unique and items.length = targets.length and
    forall(x: T, y: T) {
        items.contains(x) and items.contains(y) and f(x) = f(y) implies x = y
    } and forall(x: T) {
        items.contains(x) implies targets.contains(f(x))
    } implies forall(value: U) {
        targets.contains(value) implies exists(x: T) {
            items.contains(x) and f(x) = value
        }
    }
}

define finite_fiber_contains[T, U](source: FiniteSet[T], f: T -> U, value: U, x: T) -> Bool {
    source.contains(x) and f(x) = value
}

define finite_fiber_set[T, U](source: FiniteSet[T], f: T -> U, value: U) -> Set[T] {
    Set[T].new(finite_fiber_contains(source, f, value))
}

define finite_fiber_set_list[T, U](source: FiniteSet[T], f: T -> U, values: List[U]) -> List[Set[T]] {
    map[U, Set[T]](values, function(value: U) { finite_fiber_set(source, f, value) })
}

theorem finite_fiber_set_contains_eq[T, U](source: FiniteSet[T], f: T -> U, value: U, x: T) {
    finite_fiber_set(source, f, value).contains(x) = (source.contains(x) and f(x) = value)
}

theorem finite_fiber_set_contains_of_source[T, U](source: FiniteSet[T], f: T -> U, x: T) {
    source.contains(x) implies finite_fiber_set(source, f, f(x)).contains(x)
}

theorem finite_fiber_set_list_source_subset_union[T, U](source: FiniteSet[T], f: T -> U, values: List[U]) {
    (forall(x: T) { source.contains(x) implies values.contains(f(x)) }) implies
    source.underlying_set.subset(set_list_union[T](finite_fiber_set_list(source, f, values)))
}

theorem finite_fiber_set_list_exactly_covers_source[T, U](source: FiniteSet[T], f: T -> U, values: List[U]) {
    (forall(x: T) { source.contains(x) implies values.contains(f(x)) }) implies
    set_list_exactly_covers[T](finite_fiber_set_list(source, f, values), source.underlying_set)
}

theorem finite_fiber_set_list_pairwise_disjoint[T, U](source: FiniteSet[T], f: T -> U, values: List[U]) {
    set_list_pairwise_disjoint[T](finite_fiber_set_list(source, f, values))
}

let finite_fiber_partition_values[T, U](source: FiniteSet[T], f: T -> U) -> result: List[U] satisfy {
    fs_from_list(result) = fs_image(source, f) and result.is_unique
}

theorem finite_fiber_partition_values_spec[T, U](source: FiniteSet[T], f: T -> U) {
    fs_from_list(finite_fiber_partition_values(source, f)) = fs_image(source, f) and
    finite_fiber_partition_values(source, f).is_unique
}

define finite_fiber_partition[T, U](source: FiniteSet[T], f: T -> U) -> List[Set[T]] {
    finite_fiber_set_list(source, f, finite_fiber_partition_values(source, f))
}

theorem finite_fiber_partition_values_contains_image[T, U](source: FiniteSet[T], f: T -> U, x: T) {
    source.contains(x) implies finite_fiber_partition_values(source, f).contains(f(x))
}

theorem finite_fiber_partition_values_has_preimage[T, U](source: FiniteSet[T], f: T -> U, value: U) {
    finite_fiber_partition_values(source, f).contains(value) implies exists(x: T) {
        source.contains(x) and value = f(x)
    }
}

theorem finite_fiber_partition_is_unique[T, U](source: FiniteSet[T], f: T -> U) {
    finite_fiber_partition(source, f).is_unique
}

theorem finite_fiber_partition_pairwise_disjoint[T, U](source: FiniteSet[T], f: T -> U) {
    set_list_pairwise_disjoint[T](finite_fiber_partition(source, f))
}

theorem finite_fiber_partition_exactly_covers_source[T, U](source: FiniteSet[T], f: T -> U) {
    set_list_exactly_covers[T](finite_fiber_partition(source, f), source.underlying_set)
}

theorem finite_fiber_partition_is_partition[T, U](source: FiniteSet[T], f: T -> U) {
    set_list_partition_of[T](finite_fiber_partition(source, f), source.underlying_set)
}

theorem finite_fiber_partition_cardinality_is[T, U](source: FiniteSet[T], f: T -> U, n: Nat) {
    set_list_all_cardinality_is[T](finite_fiber_partition(source, f), n)
    implies source.underlying_set.cardinality_is(n * finite_fiber_partition(source, f).length)
}

theorem finite_fiber_partition_cardinality_is_values[T, U](source: FiniteSet[T], f: T -> U,
    n: Nat) {
    (forall(value: U) {
        finite_fiber_partition_values(source, f).contains(value) implies
        finite_fiber_set(source, f, value).cardinality_is(n)
    }) implies source.underlying_set.cardinality_is(n * finite_fiber_partition_values(source, f).length)
}

theorem finite_fiber_partition_image_cardinality_is_values_length[T, U](source: FiniteSet[T],
    f: T -> U) {
    fs_image(source, f).cardinality_is(finite_fiber_partition_values(source, f).length)
}

theorem finite_fiber_partition_constant_fiber_cardinality_by_image[T, U](source: FiniteSet[T],
    f: T -> U, n: Nat, m: Nat) {
    (forall(value: U) {
        finite_fiber_partition_values(source, f).contains(value) implies
        finite_fiber_set(source, f, value).cardinality_is(n)
    }) and fs_image(source, f).cardinality_is(m)
    implies source.underlying_set.cardinality_is(n * m)
}

theorem finite_fiber_partition_value_fiber_nonempty[T, U](source: FiniteSet[T], f: T -> U,
    value: U) {
    finite_fiber_partition_values(source, f).contains(value) implies exists(x: T) {
        finite_fiber_set(source, f, value).contains(x)
    }
}

theorem finite_fiber_partition_values_contains_eq_preimage[T, U](source: FiniteSet[T],
    f: T -> U, value: U) {
    finite_fiber_partition_values(source, f).contains(value) = exists(x: T) {
        source.contains(x) and value = f(x)
    }
}

theorem finite_fiber_partition_value_fiber_nonempty_eq_contains[T, U](source: FiniteSet[T],
    f: T -> U, value: U) {
    finite_fiber_partition_values(source, f).contains(value) = exists(x: T) {
        finite_fiber_set(source, f, value).contains(x)
    }
}

theorem finite_fiber_partition_injective_fiber_eq_singleton_of_preimage[T, U](source: FiniteSet[T],
    f: T -> U, value: U, x: T) {
    (forall(a: T, b: T) {
        source.contains(a) and source.contains(b) and f(a) = f(b) implies a = b
    }) and source.contains(x) and value = f(x) implies
    finite_fiber_set(source, f, value) = Set[T].singleton(x)
}

theorem finite_fiber_partition_injective_value_fiber_is_singleton[T, U](source: FiniteSet[T],
    f: T -> U, value: U) {
    (forall(a: T, b: T) {
        source.contains(a) and source.contains(b) and f(a) = f(b) implies a = b
    }) and finite_fiber_partition_values(source, f).contains(value) implies exists(x: T) {
        source.contains(x) and value = f(x) and finite_fiber_set(source, f, value) = Set[T].singleton(x)
    }
}

theorem finite_fiber_partition_injective_fibers_cardinality_one[T, U](source: FiniteSet[T],
    f: T -> U) {
    (forall(x: T, y: T) {
        source.contains(x) and source.contains(y) and f(x) = f(y) implies x = y
    }) implies forall(value: U) {
        finite_fiber_partition_values(source, f).contains(value) implies
        finite_fiber_set(source, f, value).cardinality_is(Nat.1)
    }
}

theorem finite_fiber_partition_singleton_fibers_cardinality_eq_image[T, U](source: FiniteSet[T],
    f: T -> U, m: Nat) {
    (forall(value: U) {
        finite_fiber_partition_values(source, f).contains(value) implies
        finite_fiber_set(source, f, value).cardinality_is(Nat.1)
    }) and fs_image(source, f).cardinality_is(m) implies source.cardinality_is(m)
}

theorem finite_fiber_partition_image_cardinality_pigeonhole_collision[T, U](source: FiniteSet[T],
    f: T -> U, n_source: Nat, n_image: Nat) {
    source.cardinality_is(n_source) and fs_image(source, f).cardinality_is(n_image) and
    n_image < n_source implies exists(x: T, y: T) {
        x != y and f(x) = f(y)
    }
}

theorem finite_fiber_partition_values_length_pigeonhole_collision[T, U](source: FiniteSet[T],
    f: T -> U, n_source: Nat) {
    source.cardinality_is(n_source) and finite_fiber_partition_values(source, f).length < n_source
    implies exists(x: T, y: T) {
        x != y and f(x) = f(y)
    }
}

theorem finite_fiber_partition_cardinality_by[T, U](source: FiniteSet[T], f: T -> U,
    card: Set[T] -> Nat) {
    set_list_all_cardinality_by[T](finite_fiber_partition(source, f), card)
    implies source.underlying_set.cardinality_is(set_list_cardinality_sum[T](finite_fiber_partition(source, f), card))
}

theorem finite_fiber_partition_cardinality_by_values[T, U](source: FiniteSet[T], f: T -> U,
    card: Set[T] -> Nat) {
    (forall(value: U) {
        finite_fiber_partition_values(source, f).contains(value) implies
        finite_fiber_set(source, f, value).cardinality_is(card(finite_fiber_set(source, f, value)))
    }) implies source.underlying_set.cardinality_is(
        set_list_cardinality_sum[T](finite_fiber_partition(source, f), card))
}

let fs_card[T](s: FiniteSet[T]) -> result: Nat satisfy {
    s.cardinality_is(result)
}

theorem fs_card_eq_of_cardinality_is[T](s: FiniteSet[T], n: Nat) {
    s.cardinality_is(n) implies fs_card(s) = n
}

theorem fs_card_empty[T] {
    fs_card(FiniteSet.empty[T]) = Nat.0
}

theorem fs_card_singleton[T](item: T) {
    fs_card(FiniteSet.empty[T].insert(item)) = Nat.1
}

theorem fs_card_cardinality_is[T](s: FiniteSet[T]) {
    s.cardinality_is(fs_card(s))
}

theorem fs_card_difference_of_subset[T](s: FiniteSet[T], b: FiniteSet[T]) {
    b.subset_eq(s) implies fs_card(fs_difference(s, b)) = fs_card(s) - fs_card(b)
}

theorem fs_card_insert_of_not_contains[T](s: FiniteSet[T], item: T) {
    not s.contains(item) implies fs_card(fs_insert(s, item)) = fs_card(s) + Nat.1
}

theorem fs_card_remove_of_not_contains[T](s: FiniteSet[T], item: T) {
    not s.contains(item) implies fs_card(fs_remove(s, item)) = fs_card(s)
}

theorem fs_remove_cardinality_is_suc[T](s: FiniteSet[T], item: T) {
    s.contains(item) implies s.cardinality_is(fs_card(fs_remove(s, item)) + Nat.1)
}

theorem fs_card_remove_of_contains[T](s: FiniteSet[T], item: T) {
    s.contains(item) implies fs_card(s) = fs_card(fs_remove(s, item)) + Nat.1
}

theorem fs_card_positive_of_contains[T](s: FiniteSet[T], item: T) {
    s.contains(item) implies Nat.0 < fs_card(s)
}

let finite_set_filter[T](s: FiniteSet[T], p: T -> Bool) -> result: FiniteSet[T] satisfy {
    FiniteSet.new(s.underlying_set.intersection(Set[T].new(p))) = Option.some(result)
}

theorem finite_set_filter_underlying_set[T](s: FiniteSet[T], p: T -> Bool) {
    finite_set_filter(s, p).underlying_set = s.underlying_set.intersection(Set[T].new(p))
}

theorem finite_set_filter_contains_eq[T](s: FiniteSet[T], p: T -> Bool, x: T) {
    finite_set_filter(s, p).contains(x) = (s.contains(x) and p(x))
}

theorem finite_set_filter_subset[T](s: FiniteSet[T], p: T -> Bool) {
    finite_set_filter(s, p).subset_eq(s)
}

theorem finite_set_filter_mono_pred[T](s: FiniteSet[T], p: T -> Bool, q: T -> Bool) {
    (forall(x: T) { p(x) implies q(x) }) implies
    finite_set_filter(s, p).subset_eq(finite_set_filter(s, q))
}

theorem finite_set_filter_true[T](s: FiniteSet[T]) {
    finite_set_filter(s, function(y: T) { true }) = s
}

theorem finite_set_filter_false[T](s: FiniteSet[T]) {
    finite_set_filter(s, function(y: T) { false }) = FiniteSet.empty[T]
}

theorem finite_set_filter_idempotent[T](s: FiniteSet[T], p: T -> Bool) {
    finite_set_filter(finite_set_filter(s, p), p) = finite_set_filter(s, p)
}

theorem finite_set_has_unique_list_of_card[T](s: FiniteSet[T]) {
    exists(items: List[T]) {
        fs_from_list(items) = s and items.is_unique and items.length = fs_card(s)
    }
}

theorem finite_set_of_list_property[T](p: FiniteSet[T] -> Bool) {
    (forall(items: List[T]) { items.is_unique implies p(fs_from_list(items)) })
        implies forall(s: FiniteSet[T]) { p(s) }
}

theorem fs_insert_underlying_set[T](s: FiniteSet[T], item: T) {
    fs_insert(s, item).underlying_set = s.underlying_set.insert(item)
}

theorem fs_insert_contains_eq[T](s: FiniteSet[T], item: T, x: T) {
    fs_insert(s, item).contains(x) = (x = item or s.contains(x))
}

theorem fs_insert_contains_item[T](s: FiniteSet[T], item: T) {
    fs_insert(s, item).contains(item)
}

theorem fs_insert_contains_of_contains[T](s: FiniteSet[T], item: T, x: T) {
    s.contains(x) implies fs_insert(s, item).contains(x)
}

theorem fs_insert_of_contains[T](s: FiniteSet[T], item: T) {
    s.contains(item) implies fs_insert(s, item) = s
}

theorem fs_card_insert_le[T](s: FiniteSet[T], item: T) {
    fs_card(fs_insert(s, item)) <= fs_card(s) + Nat.1
}

theorem finite_set_subset_cardinality_at_most[T](s: FiniteSet[T], t: FiniteSet[T], n: Nat) {
    s.subset_eq(t) and t.cardinality_is(n) implies s.cardinality_at_most(n)
}

theorem finite_set_subset_cardinality_at_most_of_at_most[T](s: FiniteSet[T], t: FiniteSet[T], n: Nat) {
    s.subset_eq(t) and t.cardinality_at_most(n) implies s.cardinality_at_most(n)
}

theorem finite_set_subset_eq_of_same_cardinality[T](s: FiniteSet[T], t: FiniteSet[T], n: Nat) {
    s.subset_eq(t) and s.cardinality_is(n) and t.cardinality_is(n) implies s = t
}

theorem cardinality_is_le_of_at_most[K](s: Set[K], m: Nat, n: Nat) {
    s.cardinality_at_most(n) and s.cardinality_is(m) implies m <= n
}

theorem finite_set_cardinality_is_le_of_at_most[T](s: FiniteSet[T], m: Nat, n: Nat) {
    s.cardinality_at_most(n) and s.cardinality_is(m) implies m <= n
}

theorem fs_card_le_of_at_most[T](s: FiniteSet[T], n: Nat) {
    s.cardinality_at_most(n) implies fs_card(s) <= n
}

theorem fs_card_mono[T](s: FiniteSet[T], t: FiniteSet[T]) {
    s.subset_eq(t) implies fs_card(s) <= fs_card(t)
}

theorem fs_card_filter_le[T](s: FiniteSet[T], p: T -> Bool) {
    fs_card(finite_set_filter(s, p)) <= fs_card(s)
}

theorem fs_card_union_ge_left[T](a: FiniteSet[T], b: FiniteSet[T]) {
    fs_card(a) <= fs_card(fs_union(a, b))
}

theorem fs_card_union_ge_right[T](a: FiniteSet[T], b: FiniteSet[T]) {
    fs_card(b) <= fs_card(fs_union(a, b))
}

theorem fs_card_le_of_subset_le[T](s: FiniteSet[T], t: FiniteSet[T], n: Nat) {
    s.subset_eq(t) and fs_card(t) <= n implies fs_card(s) <= n
}

theorem fs_card_eq_of_mutual_subset[T](s: FiniteSet[T], t: FiniteSet[T]) {
    s.subset_eq(t) and t.subset_eq(s) implies fs_card(s) = fs_card(t)
}

theorem fs_card_at_most_self[T](s: FiniteSet[T]) {
    s.cardinality_at_most(fs_card(s))
}

theorem fs_card_image_le[T, U](s: FiniteSet[T], f: T -> U) {
    fs_card(fs_image(s, f)) <= fs_card(s)
}

theorem fs_subset_eq_intro[T](a: FiniteSet[T], b: FiniteSet[T]) {
    (forall(x: T) { a.contains(x) implies b.contains(x) }) implies a.subset_eq(b)
}

theorem fs_intersection_subset_left[T](a: FiniteSet[T], b: FiniteSet[T]) {
    fs_intersection(a, b).subset_eq(a)
}

theorem fs_intersection_subset_right[T](a: FiniteSet[T], b: FiniteSet[T]) {
    fs_intersection(a, b).subset_eq(b)
}

theorem fs_difference_subset[T](a: FiniteSet[T], b: FiniteSet[T]) {
    fs_difference(a, b).subset_eq(a)
}

theorem fs_card_intersection_le_left[T](a: FiniteSet[T], b: FiniteSet[T]) {
    fs_card(fs_intersection(a, b)) <= fs_card(a)
}

theorem fs_card_intersection_le_right[T](a: FiniteSet[T], b: FiniteSet[T]) {
    fs_card(fs_intersection(a, b)) <= fs_card(b)
}

theorem fs_card_difference_le[T](a: FiniteSet[T], b: FiniteSet[T]) {
    fs_card(fs_difference(a, b)) <= fs_card(a)
}

theorem fs_subset_union_of_contains[T](a: FiniteSet[T], b: FiniteSet[T], c: FiniteSet[T]) {
    a.subset_eq(c) and b.subset_eq(c) implies fs_union(a, b).subset_eq(c)
}

theorem fs_card_union_le_of_bounds[T](
    a: FiniteSet[T], b: FiniteSet[T], c: FiniteSet[T]
) {
    a.subset_eq(c) and b.subset_eq(c) implies fs_card(fs_union(a, b)) <= fs_card(c)
}

define has_preimage_in[T, U](t: FiniteSet[T], f: T -> U, y: U) -> Bool {
    exists(x: T) {
        t.contains(x) and f(x) = y
    }
}

theorem has_preimage_in_intro[T, U](t: FiniteSet[T], f: T -> U, y: U, x: T) {
    t.contains(x) and f(x) = y implies has_preimage_in(t, f, y)
}

theorem has_preimage_in_witness[T, U](t: FiniteSet[T], f: T -> U, y: U) {
    has_preimage_in(t, f, y) implies exists(x: T) {
        t.contains(x) and f(x) = y
    }
}

define is_covered_by_image[T, U](s: FiniteSet[U], t: FiniteSet[T], f: T -> U) -> Bool {
    forall(y: U) {
        s.contains(y) implies has_preimage_in(t, f, y)
    }
}

theorem is_covered_by_image_intro[T, U](s: FiniteSet[U], t: FiniteSet[T], f: T -> U) {
    (forall(y: U) {
        s.contains(y) implies has_preimage_in(t, f, y)
    }) implies is_covered_by_image(s, t, f)
}

theorem is_covered_by_image_apply[T, U](s: FiniteSet[U], t: FiniteSet[T], f: T -> U, y: U) {
    is_covered_by_image(s, t, f) and s.contains(y) implies has_preimage_in(t, f, y)
}

theorem covered_by_image_subset[T, U](s: FiniteSet[U], t: FiniteSet[T], f: T -> U) {
    is_covered_by_image(s, t, f) implies s.subset_eq(fs_image(t, f))
}

theorem fs_card_le_of_covered_by_image[T, U](s: FiniteSet[U], t: FiniteSet[T], f: T -> U) {
    is_covered_by_image(s, t, f) implies fs_card(s) <= fs_card(t)
}

theorem fs_from_list_underlying_set[T](items: List[T]) {
    fs_from_list(items).underlying_set = list_set(items)
}

theorem fs_from_list_contains_eq[T](items: List[T], x: T) {
    fs_from_list(items).contains(x) = items.contains(x)
}

theorem fs_insert_contains_self[T](s: FiniteSet[T], item: T) {
    fs_insert(s, item).contains(item)
}

theorem fs_insert_contains_cases[T](s: FiniteSet[T], item: T, x: T) {
    fs_insert(s, item).contains(x) implies x = item or s.contains(x)
}

theorem fs_remove_contains_eq[T](s: FiniteSet[T], item: T, x: T) {
    fs_remove(s, item).contains(x) = (s.contains(x) and x != item)
}

theorem fs_remove_subset[T](s: FiniteSet[T], item: T) {
    fs_remove(s, item).subset_eq(s)
}

theorem finite_set_eq_of_contains_eq[T](a: FiniteSet[T], b: FiniteSet[T]) {
    (forall(x: T) { a.contains(x) = b.contains(x) }) implies a = b
}

theorem fs_two_distinct_members[T](s: FiniteSet[T]) {
    Nat.2 <= fs_card(s) implies exists(a: T, b: T) {
        s.contains(a) and s.contains(b) and a != b
    }
}

theorem fs_card_pos_of_contains[T](s: FiniteSet[T], x: T) {
    s.contains(x) implies Nat.1 <= fs_card(s)
}

theorem fs_card_two_of_distinct_members[T](s: FiniteSet[T], x: T, y: T) {
    s.contains(x) and s.contains(y) and x != y implies Nat.2 <= fs_card(s)
}

theorem fs_member_of_card_pos[T](s: FiniteSet[T]) {
    Nat.1 <= fs_card(s) implies exists(x: T) { s.contains(x) }
}

theorem fs_from_list_nil[T] {
    fs_from_list(List.nil[T]) = FiniteSet.empty[T]
}

theorem fs_from_list_cons[T](head: T, tail: List[T]) {
    fs_from_list(List.cons(head, tail)) = fs_insert(fs_from_list(tail), head)
}

theorem finite_set_list_rep_property[T](p: FiniteSet[T] -> Bool, items: List[T]) {
    p(FiniteSet.empty[T]) and (forall(s: FiniteSet[T], item: T) {
        p(s) implies p(fs_insert(s, item))
    }) implies p(fs_from_list(items))
}

theorem finite_set_induction[T](p: FiniteSet[T] -> Bool) {
    p(FiniteSet.empty[T]) and (forall(s: FiniteSet[T], item: T) {
        p(s) implies p(fs_insert(s, item))
    }) implies forall(s: FiniteSet[T]) { p(s) }
}

theorem finite_set_induction_apply[T](p: FiniteSet[T] -> Bool, s: FiniteSet[T]) {
    p(FiniteSet.empty[T]) and (forall(t: FiniteSet[T], item: T) {
        p(t) implies p(fs_insert(t, item))
    }) implies p(s)
}

define is_empty_or_inhabited[T](s: FiniteSet[T]) -> Bool {
    s = FiniteSet.empty[T] or exists(x: T) { s.contains(x) }
}

theorem is_empty_or_inhabited_empty[T] {
    is_empty_or_inhabited(FiniteSet.empty[T])
}

theorem is_empty_or_inhabited_insert[T](s: FiniteSet[T], item: T) {
    is_empty_or_inhabited(s) implies is_empty_or_inhabited(fs_insert(s, item))
}

theorem finite_set_empty_or_inhabited[T](s: FiniteSet[T]) {
    is_empty_or_inhabited(s)
}

theorem finite_set_has_member_of_ne_empty[T](s: FiniteSet[T]) {
    s != FiniteSet.empty[T] implies exists(x: T) { s.contains(x) }
}

theorem finite_set_has_member_of_positive_card[T](s: FiniteSet[T]) {
    Nat.0 < fs_card(s) implies exists(x: T) { s.contains(x) }
}

define pointwise_le[T](f: T -> Real, g: T -> Real) -> Bool {
    forall(t: T) { f(t) <= g(t) }
}

theorem pointwise_le_at[T](f: T -> Real, g: T -> Real, t: T) {
    pointwise_le(f, g) implies f(t) <= g(t)
}

theorem list_map_sum_le_cons[T](head: T, tail: List[T], f: T -> Real, g: T -> Real) {
    sum[Real](map(tail, f)) <= sum[Real](map(tail, g)) and f(head) <= g(head)
        implies sum[Real](map(List.cons(head, tail), f)) <= sum[Real](map(List.cons(head, tail), g))
}

define list_map_term[T](items: List[T], f: T -> Real, index: Nat) -> Real {
    match items.get_idx(index) {
        Option.none {
            Real.0
        }
        Option.some(item) {
            f(item)
        }
    }
}

theorem list_map_sum_le[T](items: List[T], f: T -> Real, g: T -> Real) {
    pointwise_le(f, g) implies sum[Real](map(items, f)) <= sum[Real](map(items, g))
}

theorem finite_set_sum_le[T](s: FiniteSet[T], f: T -> Real, g: T -> Real) {
    pointwise_le(f, g) implies finite_set_sum(s, f) <= finite_set_sum(s, g)
}

theorem finite_set_sum_nonneg[T](s: FiniteSet[T], f: T -> Real) {
    (forall(item: T) { Real.0 <= f(item) }) implies Real.0 <= finite_set_sum(s, f)
}

theorem finite_set_unique_list_property[T](p: FiniteSet[T] -> Bool, items: List[T]) {
    p(FiniteSet.empty[T]) and (forall(s: FiniteSet[T], item: T) {
        p(s) and not s.contains(item) implies p(fs_insert(s, item))
    }) and items.is_unique implies p(fs_from_list(items))
}

theorem finite_set_strong_induction[T](p: FiniteSet[T] -> Bool, s: FiniteSet[T]) {
    p(FiniteSet.empty[T]) and (forall(t: FiniteSet[T], item: T) {
        p(t) and not t.contains(item) implies p(fs_insert(t, item))
    }) implies p(s)
}

define pair_with_left[T, U](x: T, y: U) -> Pair[T, U] {
    Pair.new(x, y)
}

define pair_with_left_fn[T, U](x: T) -> U -> Pair[T, U] {
    function(y: U) { pair_with_left(x, y) }
}

define list_pair_with_left[T, U](x: T, right: List[U]) -> List[Pair[T, U]] {
    map[U, Pair[T, U]](right, pair_with_left_fn(x))
}

define list_pair_product[T, U](left: List[T], right: List[U]) -> List[Pair[T, U]] {
    match left {
        List.nil {
            List.nil[Pair[T, U]]
        }
        List.cons(head, tail) {
            list_pair_with_left(head, right) + list_pair_product(tail, right)
        }
    }
}

theorem list_pair_with_left_contains_of_contains[T, U](x: T, right: List[U], y: U) {
    right.contains(y) implies list_pair_with_left(x, right).contains(Pair.new(x, y))
}

theorem list_pair_product_contains_left_row[T, U](head: T, tail: List[T],
    right: List[U], p: Pair[T, U]) {
    list_pair_with_left(head, right).contains(p) implies
    list_pair_product(List.cons(head, tail), right).contains(p)
}

theorem list_pair_product_contains_tail_product[T, U](head: T, tail: List[T],
    right: List[U], p: Pair[T, U]) {
    list_pair_product(tail, right).contains(p) implies
    list_pair_product(List.cons(head, tail), right).contains(p)
}

theorem list_pair_product_contains_of_contains[T, U](left: List[T], right: List[U],
    x: T, y: U) {
    left.contains(x) and right.contains(y) implies
    list_pair_product(left, right).contains(Pair.new(x, y))
}

theorem list_pair_with_left_contains_imp_first[T, U](x: T, right: List[U], p: Pair[T, U]) {
    list_pair_with_left(x, right).contains(p) implies p.first = x
}

theorem list_pair_with_left_contains_imp_second[T, U](x: T, right: List[U], p: Pair[T, U]) {
    list_pair_with_left(x, right).contains(p) implies right.contains(p.second)
}

theorem pair_with_left_fn_injective[T, U](x: T) {
    is_injective_fn(pair_with_left_fn[T, U](x))
}

theorem list_pair_with_left_unique[T, U](x: T, right: List[U]) {
    right.is_unique implies list_pair_with_left(x, right).is_unique
}

theorem list_pair_product_contains_pair_imp_left[T, U](left: List[T], right: List[U],
    x: T, y: U) {
    list_pair_product(left, right).contains(Pair.new(x, y)) implies left.contains(x)
}

theorem list_pair_product_contains_pair_imp_right[T, U](left: List[T], right: List[U],
    x: T, y: U) {
    list_pair_product(left, right).contains(Pair.new(x, y)) implies right.contains(y)
}

theorem list_pair_product_contains_imp_left[T, U](left: List[T], right: List[U], p: Pair[T, U]) {
    list_pair_product(left, right).contains(p) implies left.contains(p.first)
}

theorem list_pair_product_contains_imp_right[T, U](left: List[T], right: List[U], p: Pair[T, U]) {
    list_pair_product(left, right).contains(p) implies right.contains(p.second)
}

theorem list_pair_with_left_disjoint_of_ne[T, U](x: T, z: T, right: List[U]) {
    x != z implies forall(p: Pair[T, U]) {
        not (list_pair_with_left(x, right).contains(p) and list_pair_with_left(z, right).contains(p))
    }
}

theorem list_pair_with_left_disjoint_product_of_not_contains[T, U](x: T, left: List[T],
    right: List[U]) {
    not left.contains(x) implies forall(p: Pair[T, U]) {
        not (list_pair_with_left(x, right).contains(p) and list_pair_product(left, right).contains(p))
    }
}

theorem list_pair_product_unique[T, U](left: List[T], right: List[U]) {
    left.is_unique and right.is_unique implies list_pair_product(left, right).is_unique
}

theorem list_pair_with_left_length[T, U](x: T, right: List[U]) {
    list_pair_with_left(x, right).length = right.length
}

theorem list_pair_product_cons_length[T, U](head: T, tail: List[T], right: List[U]) {
    list_pair_product(List.cons(head, tail), right).length =
    right.length + list_pair_product(tail, right).length
}

theorem list_pair_product_length[T, U](left: List[T], right: List[U]) {
    list_pair_product(left, right).length = right.length * left.length
}

theorem list_pair_with_left_filter_length[T, U](x: T, right: List[U], pred: Pair[T, U] -> Bool) {
    list_pair_with_left(x, right).filter(pred).length =
    right.filter(function(y: U) { pred(Pair.new(x, y)) }).length
}

define list_pair_product_row_filter_length_fn[T, U](right: List[U], pred: Pair[T, U] -> Bool) -> (T -> Nat) {
    function(x: T) { list_pair_with_left(x, right).filter(pred).length }
}

theorem list_pair_product_filter_length_sum_rows[T, U](left: List[T], right: List[U],
    pred: Pair[T, U] -> Bool) {
    list_pair_product(left, right).filter(pred).length =
    sum[Nat](map[T, Nat](left, list_pair_product_row_filter_length_fn(right, pred)))
}

define list_pair_product_split_filter_pred[T, U](lp: T -> Bool, rp: U -> Bool) -> (Pair[T, U] -> Bool) {
    function(p: Pair[T, U]) { lp(p.first) and rp(p.second) }
}

theorem list_pair_with_left_split_filter_length_of_left[T, U](x: T, right: List[U],
    lp: T -> Bool, rp: U -> Bool) {
    lp(x) implies list_pair_with_left(x, right).filter(
        list_pair_product_split_filter_pred(lp, rp)).length = right.filter(rp).length
}

theorem list_pair_with_left_split_filter_length_of_not_left[T, U](x: T, right: List[U],
    lp: T -> Bool, rp: U -> Bool) {
    not lp(x) implies list_pair_with_left(x, right).filter(
        list_pair_product_split_filter_pred(lp, rp)).length = Nat.0
}

theorem list_pair_product_filter_length_product[T, U](left: List[T], right: List[U],
    lp: T -> Bool, rp: U -> Bool) {
    list_pair_product(left, right).filter(list_pair_product_split_filter_pred(lp, rp)).length =
    right.filter(rp).length * left.filter(lp).length
}

define pair_product_map_value[T, U](f: T -> Nat, g: U -> Nat) -> (Pair[T, U] -> Nat) {
    function(p: Pair[T, U]) { f(p.first) * g(p.second) }
}

theorem list_pair_with_left_map_mul_sum[T, U](x: T, right: List[U], f: T -> Nat,
    g: U -> Nat) {
    sum(map(list_pair_with_left(x, right), pair_product_map_value(f, g))) =
        f(x) * sum(map(right, g))
}

theorem list_pair_product_map_mul_sum[T, U](left: List[T], right: List[U], f: T -> Nat,
    g: U -> Nat) {
    sum(map(list_pair_product(left, right), pair_product_map_value(f, g))) =
        sum(map(left, f)) * sum(map(right, g))
}

define filter_indicator_value[T](c: Nat, pred: T -> Bool) -> (T -> Nat) {
    function(x: T) { if pred(x) { c } else { Nat.0 } }
}

theorem sum_filter_indicator_value[T](items: List[T], c: Nat, pred: T -> Bool) {
    sum(map(items, filter_indicator_value(c, pred))) = c * items.filter(pred).length
}

define row_encode(m: Nat) -> (Pair[Nat, Nat] -> Nat) {
    function(p: Pair[Nat, Nat]) { p.second * m + p.first }
}

define rectangle_values(m: Nat, n: Nat) -> List[Nat] {
    map[Pair[Nat, Nat], Nat](list_pair_product[Nat, Nat](m.range, n.range), row_encode(m))
}

theorem row_decomposition_unique(m: Nat, a: Nat, b: Nat, c: Nat, d: Nat) {
    m != Nat.0 and a < m and c < m and b * m + a = d * m + c implies a = c and b = d
}

theorem row_encode_locally_injective(m: Nat, n: Nat) {
    m != Nat.0 implies forall(p: Pair[Nat, Nat], q: Pair[Nat, Nat]) {
        list_pair_product[Nat, Nat](m.range, n.range).contains(p) and
        list_pair_product[Nat, Nat](m.range, n.range).contains(q) and
        row_encode(m)(p) = row_encode(m)(q) implies p = q
    }
}

theorem rectangle_values_contains_imp_lt(m: Nat, n: Nat, x: Nat) {
    rectangle_values(m, n).contains(x) implies x < m * n
}

theorem rectangle_values_contains_of_lt(m: Nat, n: Nat, x: Nat) {
    m != Nat.0 and x < m * n implies rectangle_values(m, n).contains(x)
}

theorem rectangle_values_contains_iff(m: Nat, n: Nat, x: Nat) {
    m != Nat.0 implies rectangle_values(m, n).contains(x) = (x < m * n)
}

theorem rectangle_values_unique(m: Nat, n: Nat) {
    m != Nat.0 implies rectangle_values(m, n).is_unique
}

theorem rectangle_values_same_contains_range(m: Nat, n: Nat, x: Nat) {
    m != Nat.0 implies rectangle_values(m, n).contains(x) = (m * n).range.contains(x)
}

theorem rectangle_values_filter_permutation_range_filter(m: Nat, n: Nat, pred: Nat -> Bool) {
    m != Nat.0 implies is_permutation(
        rectangle_values(m, n).filter(pred),
        (m * n).range.filter(pred))
}

theorem rectangle_values_filter_length_range(m: Nat, n: Nat, pred: Nat -> Bool) {
    m != Nat.0 implies rectangle_values(m, n).filter(pred).length =
        (m * n).range.filter(pred).length
}

define row_encode_filter_pred(m: Nat, pred: Nat -> Bool) -> (Pair[Nat, Nat] -> Bool) {
    function(p: Pair[Nat, Nat]) { pred(row_encode(m)(p)) }
}

theorem rectangle_values_filter_length_pair_product(m: Nat, n: Nat, pred: Nat -> Bool) {
    rectangle_values(m, n).filter(pred).length =
        list_pair_product[Nat, Nat](m.range, n.range).filter(row_encode_filter_pred(m, pred)).length
}

theorem row_encode_filter_length_range(m: Nat, n: Nat, pred: Nat -> Bool) {
    m != Nat.0 implies
    list_pair_product[Nat, Nat](m.range, n.range).filter(row_encode_filter_pred(m, pred)).length =
        (m * n).range.filter(pred).length
}

let finite_set_product[T, U](a: FiniteSet[T], b: FiniteSet[U]) -> result: FiniteSet[Pair[T, U]] satisfy {
    FiniteSet.new(pair_set(a.underlying_set, b.underlying_set)) = Option.some(result)
}

theorem finite_set_product_underlying_set[T, U](a: FiniteSet[T], b: FiniteSet[U]) {
    finite_set_product(a, b).underlying_set = pair_set(a.underlying_set, b.underlying_set)
}

theorem finite_set_product_contains_eq[T, U](a: FiniteSet[T], b: FiniteSet[U], p: Pair[T, U]) {
    finite_set_product(a, b).contains(p) = (a.contains(p.first) and b.contains(p.second))
}

theorem finite_set_product_contains_pair[T, U](a: FiniteSet[T], b: FiniteSet[U], x: T, y: U) {
    a.contains(x) and b.contains(y) implies finite_set_product(a, b).contains(Pair.new(x, y))
}

theorem finite_set_product_contains_left[T, U](a: FiniteSet[T], b: FiniteSet[U], p: Pair[T, U]) {
    finite_set_product(a, b).contains(p) implies a.contains(p.first)
}

theorem finite_set_product_contains_right[T, U](a: FiniteSet[T], b: FiniteSet[U], p: Pair[T, U]) {
    finite_set_product(a, b).contains(p) implies b.contains(p.second)
}

theorem finite_set_product_empty_left[T, U](b: FiniteSet[U]) {
    finite_set_product(fs_empty[T](Set[T].empty_set), b) =
    fs_empty[Pair[T, U]](Set[Pair[T, U]].empty_set)
}

theorem finite_set_product_empty_right[T, U](a: FiniteSet[T]) {
    finite_set_product(a, fs_empty[U](Set[U].empty_set)) =
    fs_empty[Pair[T, U]](Set[Pair[T, U]].empty_set)
}

theorem finite_set_product_subset[T, U](a: FiniteSet[T], a_target: FiniteSet[T],
    b: FiniteSet[U], b_target: FiniteSet[U]) {
    a.subset_eq(a_target) and b.subset_eq(b_target) implies
    finite_set_product(a, b).subset_eq(finite_set_product(a_target, b_target))
}

theorem finite_set_product_fs_from_list_contains_eq[T](items: List[T], x: T) {
    fs_from_list(items).contains(x) = items.contains(x)
}

theorem list_pair_product_contains_imp_finite_set_product_from_list_contains[T, U](left: List[T],
    right: List[U], p: Pair[T, U]) {
    list_pair_product(left, right).contains(p) implies
    finite_set_product(fs_from_list(left), fs_from_list(right)).contains(p)
}

theorem finite_set_product_from_list_contains_imp_list_pair_product_contains[T, U](left: List[T],
    right: List[U], p: Pair[T, U]) {
    finite_set_product(fs_from_list(left), fs_from_list(right)).contains(p) implies
    list_pair_product(left, right).contains(p)
}

theorem finite_set_product_from_list_eq[T, U](left: List[T], right: List[U]) {
    finite_set_product(fs_from_list(left), fs_from_list(right)) =
    fs_from_list(list_pair_product(left, right))
}

theorem finite_set_product_cardinality_is[T, U](a: FiniteSet[T], b: FiniteSet[U],
    n_left: Nat, n_right: Nat) {
    a.cardinality_is(n_left) and b.cardinality_is(n_right) implies
    finite_set_product(a, b).cardinality_is(n_right * n_left)
}

theorem fs_card_product[T, U](a: FiniteSet[T], b: FiniteSet[U]) {
    fs_card(finite_set_product(a, b)) = fs_card(b) * fs_card(a)
}

define finite_set_product_row_fn[T, U, A](f: Pair[T, U] -> A, x: T) -> (U -> A) {
    function(y: U) { f(Pair.new(x, y)) }
}

define list_pair_product_row_sum_fn[T, U, A: AddCommMonoid](right: List[U],
    f: Pair[T, U] -> A) -> (T -> A) {
    function(x: T) { sum[A](map(right, finite_set_product_row_fn(f, x))) }
}

theorem list_pair_with_left_sum_eq_row_sum[T, U, A: AddCommMonoid](right: List[U],
    f: Pair[T, U] -> A, x: T) {
    sum[A](map(list_pair_with_left(x, right), f)) =
        sum[A](map(right, finite_set_product_row_fn(f, x)))
}

theorem list_pair_product_fubini_rows[T, U, A: AddCommMonoid](left: List[T], right: List[U],
    f: Pair[T, U] -> A) {
    sum[A](map(list_pair_product(left, right), f)) =
        sum[A](map(left, list_pair_product_row_sum_fn(right, f)))
}

theorem finite_set_sum_eq_of_finite_set_eq[T, A: AddCommMonoid](s: FiniteSet[T], t: FiniteSet[T],
    f: T -> A) {
    s = t implies finite_set_sum(s, f) = finite_set_sum(t, f)
}

theorem finite_set_sum_eq_of_function_eq[T, A: AddCommMonoid](s: FiniteSet[T],
    f: T -> A, g: T -> A) {
    f = g implies finite_set_sum(s, f) = finite_set_sum(s, g)
}

theorem finite_set_sum_product_from_lists_eq_list_pair_product_sum[T, U, A: AddCommMonoid](
    left: List[T], right: List[U], f: Pair[T, U] -> A
) {
    left.is_unique and right.is_unique implies
    finite_set_sum(finite_set_product(fs_from_list(left), fs_from_list(right)), f) =
    sum[A](map(list_pair_product(left, right), f))
}

theorem finite_set_sum_product_fubini_rows[T, U, A: AddCommMonoid](
    a: FiniteSet[T], b: FiniteSet[U], f: Pair[T, U] -> A
) {
    finite_set_sum(finite_set_product(a, b), f) =
        finite_set_sum(a, function(x: T) { finite_set_sum(b, function(y: U) { f(Pair.new(x, y)) }) })
}

theorem finite_set_sum_eq_of_pointwise_on_set[T, A: AddCommMonoid](
    s: FiniteSet[T], f: T -> A, g: T -> A
) {
    (forall(x: T) { s.contains(x) implies f(x) = g(x) }) implies
        finite_set_sum(s, f) = finite_set_sum(s, g)
}

theorem finite_set_sum_eq_of_function_eq_global[T, A: AddCommMonoid](
    s: FiniteSet[T], f: T -> A, g: T -> A
) {
    f = g implies finite_set_sum(s, f) = finite_set_sum(s, g)
}

theorem finite_set_sum_pointwise_add[T, A: AddCommMonoid](s: FiniteSet[T], f: T -> A, g: T -> A) {
    finite_set_sum(s, add_fn(f, g)) = finite_set_sum(s, f) + finite_set_sum(s, g)
}

theorem finite_set_sum_insert_right[T, A: AddCommMonoid](s: FiniteSet[T], item: T, f: T -> A) {
    not s.contains(item) implies finite_set_sum(fs_insert(s, item), f) = finite_set_sum(s, f) + f(item)
}

theorem finite_set_sum_disjoint_union_commuted[T, A: AddCommMonoid](
    a: FiniteSet[T], b: FiniteSet[T], f: T -> A
) {
    a.is_disjoint(b) implies
        finite_set_sum(fs_union(a, b), f) = finite_set_sum(b, f) + finite_set_sum(a, f)
}

theorem finite_set_sum_scalar_mul_right_form[T, S: Semiring](c: S, s: FiniteSet[T], f: T -> S) {
    finite_set_sum(s, mul_fn(c, f)) = c * finite_set_sum(s, f)
}

theorem finite_set_product_contains_iff_components[T, U](
    a: FiniteSet[T], b: FiniteSet[U], p: Pair[T, U]
) {
    finite_set_product(a, b).contains(p) iff (a.contains(p.first) and b.contains(p.second))
}

theorem finite_set_product_contains_of_components[T, U](
    a: FiniteSet[T], b: FiniteSet[U], p: Pair[T, U]
) {
    a.contains(p.first) and b.contains(p.second) implies finite_set_product(a, b).contains(p)
}

theorem finite_set_product_contains_first[T, U](a: FiniteSet[T], b: FiniteSet[U], p: Pair[T, U]) {
    finite_set_product(a, b).contains(p) implies a.contains(p.first)
}

theorem finite_set_product_contains_second[T, U](a: FiniteSet[T], b: FiniteSet[U], p: Pair[T, U]) {
    finite_set_product(a, b).contains(p) implies b.contains(p.second)
}

theorem finite_set_product_subset_left[T, U](a: FiniteSet[T], a_target: FiniteSet[T], b: FiniteSet[U]) {
    a.subset_eq(a_target) implies finite_set_product(a, b).subset_eq(finite_set_product(a_target, b))
}

theorem finite_set_product_subset_right[T, U](a: FiniteSet[T], b: FiniteSet[U], b_target: FiniteSet[U]) {
    b.subset_eq(b_target) implies finite_set_product(a, b).subset_eq(finite_set_product(a, b_target))
}

theorem finite_set_sum_product_fubini_rows_rev[T, U, A: AddCommMonoid](
    a: FiniteSet[T], b: FiniteSet[U], f: Pair[T, U] -> A
) {
    finite_set_sum(a, function(x: T) { finite_set_sum(b, function(y: U) { f(Pair.new(x, y)) }) }) =
        finite_set_sum(finite_set_product(a, b), f)
}

theorem finite_set_product_row_fn_apply[T, U, A](f: Pair[T, U] -> A, x: T, y: U) {
    finite_set_product_row_fn(f, x, y) = f(Pair.new(x, y))
}

theorem finite_set_sum_nonnegative_of_pointwise[T](s: FiniteSet[T], f: T -> Real) {
    (forall(item: T) { Real.0 <= f(item) }) implies Real.0 <= finite_set_sum(s, f)
}

theorem finite_set_sum_monotone_of_pointwise_le[T](s: FiniteSet[T], f: T -> Real, g: T -> Real) {
    pointwise_le(f, g) implies finite_set_sum(s, f) <= finite_set_sum(s, g)
}

theorem pointwise_le_intro[T](f: T -> Real, g: T -> Real) {
    (forall(t: T) { f(t) <= g(t) }) implies pointwise_le(f, g)
}

theorem pointwise_le_iff_forall[T](f: T -> Real, g: T -> Real) {
    pointwise_le(f, g) iff forall(t: T) { f(t) <= g(t) }
}

theorem pointwise_le_elim[T](f: T -> Real, g: T -> Real, t: T) {
    pointwise_le(f, g) implies f(t) <= g(t)
}
