    Nat.1 <= a and Nat.1 <= b and Nat.1 <= c and Nat.1 <= d and b <= a and c <= b and d <= c and
        a + b + c + d = Nat.4 implies a = Nat.1 and b = Nat.1 and c = Nat.1 and d = Nat.1
