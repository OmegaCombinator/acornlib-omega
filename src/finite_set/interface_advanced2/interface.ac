theorem three_parts_four(a: Nat, b: Nat, c: Nat) {
    Nat.1 <= a and Nat.1 <= b and Nat.1 <= c and b <= a and c <= b and
        a + b + c = Nat.4 implies a = Nat.2 and b = Nat.1 and c = Nat.1
}

