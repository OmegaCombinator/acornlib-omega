define hamming(xs: List[Bool], ys: List[Bool]) -> Nat {
    match xs {
        List.nil {
            match ys {
                List.nil {
                    Nat.0
                }
                List.cons(hy, ty) {
                    Nat.0
                }
            }
        }
        List.cons(hx, tx) {
            match ys {
                List.nil {
                    Nat.0
                }
                List.cons(hy, ty) {
                    if hx != hy {
                        Nat.1 + hamming(tx, ty)
                    } else {
                        hamming(tx, ty)
                    }
                }
            }
        }
    }
}

