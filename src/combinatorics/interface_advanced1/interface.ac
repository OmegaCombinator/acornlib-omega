define choose_exists(x: Nat, y: Nat) -> Bool {
    (x.factorial * y.factorial).divides((x + y).factorial)
}

define choose_hyp(n: Nat) -> Bool {
    forall(x: Nat, y: Nat) {
        if x + y = n {
            choose_exists(x, y)
        }
    }
}

theorem choose_exists_left_zero(x: Nat) {
    choose_exists(0, x)
}

theorem choose_exists_right_zero(x: Nat) {
    choose_exists(x, 0)
}

theorem choose_base {
    choose_hyp(0)
}

theorem choose_lemma(a: Nat, b: Nat) {
    a != 0 and b != 0 and choose_hyp(a + b - 1) implies
    (a.factorial * b.factorial).divides((a + b - 1).factorial * b)
}

theorem choose_exists_is_true(z1: Nat, z2: Nat) {
    choose_exists(z1, z2)
}

theorem choose_exists_sub_form(n: Nat, k: Nat) {
    k <= n implies exists(c: Nat) {
        c * k.factorial * (n - k).factorial = n.factorial
    }
}

let binom(n: Nat, k: Nat) -> c: Nat satisfy {
    if n < k {
        c = 0
    } else {
        c * k.factorial * (n - k).factorial = n.factorial
    }
}

attributes Nat {
    /// The binomial coefficient "n choose k".
    let binom = binom
}

theorem factorial_nonzero(n: Nat) {
    n.factorial != 0
}

theorem choose_zero(n: Nat) {
    n.binom(0) = 1
}

theorem choose_n(n: Nat) {
    n.binom(n) = 1
}

theorem choose_add(a: Nat, b: Nat) {
    (a + b).binom(a) * a.factorial * b.factorial = (a + b).factorial
}

theorem choose_symm_add_form(a: Nat, b: Nat) {
    (a + b).binom(a) = (a + b).binom(b)
}

theorem choose_symm_sub_form(n: Nat, k: Nat) {
    k <= n implies n.binom(k) = n.binom(n - k)
}

theorem choose_one(n: Nat) {
    n.binom(1) = n
}

theorem binom_n_minus_one(n: Nat) {
    1 <= n implies n.binom(n - 1) = n
}

theorem binom_two_double(n: Nat) {
    2 <= n implies 2 * n.binom(2) = n * (n - 1)
}

theorem binom_three_factor(n: Nat) {
    3 <= n implies 6 * n.binom(3) = n * (n - 1) * (n - 2)
}

theorem choose_out_of_bounds(n: Nat, k: Nat) {
    n < k implies n.binom(k) = 0
}

theorem binom_pos(n: Nat, k: Nat) {
    k <= n implies 0 < n.binom(k)
}

theorem pascal(n: Nat, k: Nat) {
    0 < k and k <= n implies n.suc.binom(k) = n.binom(k - 1) + n.binom(k)
}

theorem pascal_suc(n: Nat, k: Nat) {
    k <= n implies n.suc.binom(k.suc) = n.binom(k) + n.binom(k.suc)
}

define binomial_term(a: Nat, b: Nat, n: Nat, k: Nat) -> Nat {
    n.binom(k) * a.pow(k) * b.pow(n - k)
}

theorem binomial_term_zero(a: Nat, b: Nat, m: Nat) {
    binomial_term(a, b, m.suc, 0) = b * binomial_term(a, b, m, 0)
}

theorem binomial_term_top(a: Nat, b: Nat, m: Nat) {
    binomial_term(a, b, m.suc, m.suc) = a * binomial_term(a, b, m, m)
}

theorem binomial_term_recurrence(a: Nat, b: Nat, m: Nat, k: Nat) {
    0 < k and k <= m implies
    binomial_term(a, b, m.suc, k) =
    a * binomial_term(a, b, m, k - 1) + b * binomial_term(a, b, m, k)
}

theorem alt_binomial_term_recurrence(a: Nat, b: Nat, m: Nat, k: Nat) {
    k < m implies
    binomial_term(a, b, m.suc, k.suc) =
    a * binomial_term(a, b, m, k) + b * binomial_term(a, b, m, k.suc)
}

theorem binomial_middle_sum(a: Nat, b: Nat, m: Nat) {
    partial(compose(binomial_term(a, b, m.suc), Nat.suc), m) =
        a * partial(binomial_term(a, b, m), m) + b * partial(compose(binomial_term(a, b, m), Nat.suc), m)
}

theorem binomial_distribution(a: Nat, b: Nat, m: Nat) {
    (a + b) * partial(binomial_term(a, b, m), m.suc) = partial(binomial_term(a, b, m.suc), m.suc.suc)
}

theorem binomial(a: Nat, b: Nat, n: Nat) {
    (a + b).pow(n) = partial(binomial_term(a, b, n), n.suc)
}

theorem binom_absorption(n: Nat, k: Nat) {
    0 < k and k <= n implies k * n.binom(k) = n * (n - 1).binom(k - 1)
}

theorem binom_absorption_suc(n: Nat, k: Nat) {
    k <= n implies k.suc * n.suc.binom(k.suc) = n.suc * n.binom(k)
}

theorem binom_complement_absorption(n: Nat, k: Nat) {
    k < n implies (n - k) * n.binom(k) = k.suc * n.binom(k.suc)
}

theorem binom_le_binom_suc(n: Nat, k: Nat) {
    2 * k.suc <= n implies n.binom(k) <= n.binom(k.suc)
}

theorem binom_suc_le_binom(n: Nat, k: Nat) {
    n <= 2 * k implies n.binom(k.suc) <= n.binom(k)
}

theorem binom_subset_product(n: Nat, k: Nat, j: Nat) {
    j <= k and k <= n implies n.binom(k) * k.binom(j) = n.binom(j) * (n - j).binom(k - j)
}

theorem pascal_suc_unbounded(n: Nat, k: Nat) {
    n.suc.binom(k.suc) = n.binom(k) + n.binom(k.suc)
}

define vandermonde_term(m: Nat, n: Nat, k: Nat, j: Nat) -> Nat {
    m.binom(j) * n.binom(k - j)
}

theorem vandermonde_zero_aux(n: Nat, k: Nat, m: Nat) {
    partial(vandermonde_term(Nat.0, n, k), m.suc) = n.binom(k)
}

theorem vandermonde_step(big_m: Nat, n: Nat, k1: Nat) {
    (forall(kk: Nat) {
        partial(vandermonde_term(big_m, n, kk), kk.suc) = (big_m + n).binom(kk)
    }) implies partial(vandermonde_term(big_m.suc, n, k1), k1.suc) = (big_m.suc + n).binom(k1)
}

define vandermonde_pred(m: Nat, n: Nat) -> Bool {
    forall(k: Nat) {
        partial(vandermonde_term(m, n, k), k.suc) = (m + n).binom(k)
    }
}

theorem vandermonde(m: Nat, n: Nat, k: Nat) {
    partial(vandermonde_term(m, n, k), k.suc) = (m + n).binom(k)
}

define binom_square_term(n: Nat, j: Nat) -> Nat {
    n.binom(j) * n.binom(j)
}

theorem binom_square_sum(n: Nat) {
    partial(binom_square_term(n), n.suc) = (n + n).binom(n)
}

define hockey_stick_term(r: Nat, j: Nat) -> Nat {
    (r + j).binom(r)
}

theorem hockey_stick(r: Nat, n: Nat) {
    partial(hockey_stick_term(r), n.suc) = (r + n.suc).binom(r.suc)
}

theorem binom_row_sum(n: Nat) {
    partial(n.binom, n.suc) = 2.pow(n)
}

define binom_weighted_term(n: Nat, k: Nat) -> Nat {
    k * n.binom(k)
}

theorem binom_weighted_row_sum(n: Nat) {
    partial(binom_weighted_term(n), n.suc) = n * 2.pow(n - 1)
}

define binom_second_weighted_term(n: Nat, k: Nat) -> Nat {
    k * (k - Nat.1) * n.binom(k)
}

theorem binom_second_weighted_row_sum(n: Nat) {
    partial(binom_second_weighted_term(n), n.suc) =
        n * (n - Nat.1) * 2.pow((n - Nat.1) - Nat.1)
}

define triangular(n: Nat) -> Nat {
    match n {
        Nat.zero {
            Nat.0
        }
        Nat.suc(k) {
            n + triangular(k)
        }
    }
}

theorem triangular_zero {
    triangular(Nat.0) = Nat.0
}

theorem triangular_suc(k: Nat) {
    triangular(k.suc) = k.suc + triangular(k)
}

theorem triangular_doubled_suc(k: Nat) {
    Nat.2 * triangular(k) = k * (k + Nat.1)
        implies Nat.2 * triangular(k.suc) = k.suc * (k.suc + Nat.1)
}

theorem triangular_doubled(n: Nat) {
    Nat.2 * triangular(n) = n * (n + Nat.1)
}

theorem nat_suc_sub_suc(a: Nat, b: Nat) {
    a.suc - b.suc = a - b
}

theorem nat_add_sub_cancel(a: Nat, b: Nat, c: Nat) {
    (a + c) - (b + c) = a - b
}

theorem nat_mul_sub_distrib_right(a: Nat, b: Nat, c: Nat) {
    (a - b) * c = a * c - b * c
}

theorem nat_mul_sub_distrib_left(a: Nat, b: Nat, c: Nat) {
    a * (b - c) = a * b - a * c
}

define catalan(n: Nat) -> Nat {
    (n + n).binom(n) - (n + n).binom(n + Nat.1)
}

theorem catalan_zero {
    catalan(Nat.0) = Nat.1
}

theorem catalan_one {
    catalan(Nat.1) = Nat.1
}

theorem lt_n_n_plus_n(n: Nat) {
    Nat.0 < n implies n < n + n
}

theorem nat_suc_lte_double_suc(n: Nat) {
    n.suc <= n + n + Nat.1
}

theorem nat_pred_add_one(n: Nat) {
    Nat.0 < n implies n - Nat.1 + Nat.1 = n
}

theorem nat_pred_suc(n: Nat) {
    Nat.0 < n implies (n - Nat.1).suc = n
}

theorem nat_pred_lte_double(n: Nat) {
    Nat.0 < n implies n - Nat.1 <= n + n
}

theorem nat_double_sub_pred(n: Nat) {
    Nat.0 < n implies n + n - (n - Nat.1) = n.suc
}

theorem central_binom_adjacent(n: Nat) {
    Nat.0 < n implies
        n.suc * (n + n).binom(n.suc) = n * (n + n).binom(n)
}

theorem central_binom_adjacent_lte(n: Nat) {
    (n + n).binom(n.suc) <= (n + n).binom(n)
}

theorem central_binom_suc(n: Nat) {
    (n.suc + n.suc).binom(n.suc) =
        Nat.2 * ((n + n).binom(n) + (n + n).binom(n.suc))
}

theorem central_binom_shift(n: Nat) {
    (n.suc + n.suc).binom(n.suc.suc) =
        (n + n).binom(n) + Nat.2 * (n + n).binom(n.suc) + (n + n).binom(n.suc.suc)
}

theorem central_binom_step(m: Nat, j: Nat) {
    Nat.0 < j implies
        (m.suc + m.suc).binom(m.suc + j) =
            (m + m).binom(m + j - Nat.1) + Nat.2 * (m + m).binom(m + j) +
            (m + m).binom(m + j.suc)
}

theorem catalan_mul_suc(n: Nat) {
    catalan(n) * n.suc = (n + n).binom(n)
}

theorem catalan_shift(n: Nat) {
    catalan(n.suc) = (n + n).binom(n) - (n + n).binom(n.suc.suc)
}

define cb_term(n: Nat, j: Nat, k: Nat) -> Nat {
    catalan(k) * ((n - k) + (n - k)).binom(n - k + j)
}

define catalan_family_hyp(n: Nat) -> Bool {
    forall(j: Nat) {
        partial(cb_term(n, j), n.suc) = (n + n).binom(n + j) + (n + n).binom(n + j.suc)
    }
}

theorem nat_suc_sub_shift(n: Nat, k: Nat) {
    k <= n implies n.suc - k = (n - k) + Nat.1
}

theorem nat_add_sub_one(a: Nat, b: Nat) {
    Nat.0 < b implies a + (b - Nat.1) = a + b - Nat.1
}

theorem catalan_middle_suc(n: Nat, j: Nat) {
    Nat.0 < j implies
        partial(cb_term(n.suc, j), n) =
            partial(cb_term(n, j - Nat.1), n) +
            Nat.2 * partial(cb_term(n, j), n) +
            partial(cb_term(n, j.suc), n)
}

theorem catalan_middle_zero(n: Nat) {
    partial(cb_term(n.suc, Nat.0), n) =
        Nat.2 * partial(cb_term(n, Nat.0), n) +
        Nat.2 * partial(cb_term(n, Nat.1), n)
}

theorem central_binom_second_lte(n: Nat) {
    (n + n).binom(n.suc.suc) <= (n + n).binom(n)
}

theorem catalan_shift_merge(n: Nat) {
    catalan(n.suc) + Nat.2 * (n + n).binom(n.suc.suc) =
        (n + n).binom(n) + (n + n).binom(n.suc.suc)
}

theorem catalan_j0_cancel(n: Nat) {
    Nat.2 * (n + n).binom(n) + Nat.4 * (n + n).binom(n.suc) +
        Nat.2 * (n + n).binom(n.suc.suc) + catalan(n.suc) =
        Nat.3 * (n + n).binom(n) + Nat.4 * (n + n).binom(n.suc) +
        (n + n).binom(n.suc.suc)
}

theorem catalan_j0_merge(n: Nat) {
    Nat.2 * partial(cb_term(n, Nat.0), n) +
        Nat.2 * partial(cb_term(n, Nat.1), n) + Nat.2 * catalan(n) =
        Nat.2 * partial(cb_term(n, Nat.0), n.suc) +
        Nat.2 * partial(cb_term(n, Nat.1), n.suc)
}

theorem catalan_conv_family(n: Nat) {
    catalan_family_hyp(n)
}

define catalan_conv_term(n: Nat, k: Nat) -> Nat {
    catalan(k) * catalan(n - k)
}

define catalan_first_sum_term(n: Nat, k: Nat) -> Nat {
    k.suc * catalan_conv_term(n, k)
}

define catalan_weighted_term(n: Nat, k: Nat) -> Nat {
    (n - k).suc * catalan_conv_term(n, k)
}

theorem catalan_cb_weighted(n: Nat, k: Nat) {
    cb_term(n, Nat.0, k) = catalan_weighted_term(n, k)
}

theorem catalan_weighted_sum(n: Nat) {
    partial(catalan_weighted_term(n), n.suc) =
        (n + n).binom(n) + (n + n).binom(n.suc)
}

theorem catalan_split_term(n: Nat, k: Nat) {
    k <= n implies
        (n + Nat.2) * catalan_conv_term(n, k) =
            catalan_first_sum_term(n, k) + catalan_weighted_term(n, k)
}

theorem catalan_first_reversed(n: Nat, k: Nat) {
    k <= n implies
        reverse_index(catalan_first_sum_term(n), n, k) =
            catalan(k) * ((n - k) + (n - k)).binom(n - k)
}

theorem catalan_first_sum(n: Nat) {
    partial(catalan_first_sum_term(n), n.suc) =
        (n + n).binom(n) + (n + n).binom(n.suc)
}

theorem catalan_recurrence(n: Nat) {
    catalan(n.suc) = partial(catalan_conv_term(n), n.suc)
}

define hamming(xs: List[Bool], ys: List[Bool]) -> Nat {
    match xs {
        List.nil {
            match ys {
                List.nil {
                    Nat.0
                }
                List.cons(hy, ty) {
                    Nat.0
                }
            }
        }
        List.cons(hx, tx) {
            match ys {
                List.nil {
                    Nat.0
                }
                List.cons(hy, ty) {
                    if hx != hy {
                        Nat.1 + hamming(tx, ty)
                    } else {
                        hamming(tx, ty)
                    }
                }
            }
        }
    }
}

define bit_diff(a: Bool, b: Bool) -> Nat {
    if a != b {
        Nat.1
    } else {
        Nat.0
    }
}

theorem length_zero_imp_nil[T](list: List[T]) {
    list.length = Nat.0 implies list = List.nil[T]
}

theorem hamming_cons_eq(xs: List[Bool], ys: List[Bool], hx: Bool, hy: Bool) {
    hamming(List.cons(hx, xs), List.cons(hy, ys)) = bit_diff(hx, hy) + hamming(xs, ys)
}

theorem bit_diff_sym(hx: Bool, hy: Bool) {
    bit_diff(hx, hy) = bit_diff(hy, hx)
}

theorem lte_add_both(a: Nat, b: Nat, c: Nat, d: Nat) {
    a <= b and c <= d implies a + c <= b + d
}

theorem n_lte_one_plus_n(n: Nat) {
    n <= Nat.1 + n
}

theorem zero_lte(n: Nat) {
    Nat.0 <= n
}

theorem bool_diff_or(hx: Bool, hy: Bool, hz: Bool) {
    hx != hz implies hx != hy or hy != hz
}

theorem bit_diff_le_sum(hx: Bool, hy: Bool, hz: Bool) {
    bit_diff(hx, hz) <= bit_diff(hx, hy) + bit_diff(hy, hz)
}

theorem hamming_nonneg(xs: List[Bool], ys: List[Bool]) {
    Nat.0 <= hamming(xs, ys)
}

theorem hamming_self(xs: List[Bool]) {
    hamming(xs, xs) = Nat.0
}

theorem hamming_sym(xs: List[Bool], ys: List[Bool]) {
    xs.length = ys.length implies hamming(xs, ys) = hamming(ys, xs)
}

theorem bit_diff_zero_imp_eq(hx: Bool, hy: Bool) {
    bit_diff(hx, hy) = Nat.0 implies hx = hy
}

theorem hamming_triangle(xs: List[Bool], ys: List[Bool], zs: List[Bool]) {
    xs.length = ys.length and ys.length = zs.length implies
        hamming(xs, zs) <= hamming(xs, ys) + hamming(ys, zs)
}

theorem hamming_zero_imp_eq(xs: List[Bool], ys: List[Bool]) {
    xs.length = ys.length and hamming(xs, ys) = Nat.0 implies xs = ys
}

theorem hamming_zero_iff_eq(xs: List[Bool], ys: List[Bool]) {
    xs.length = ys.length implies ((hamming(xs, ys) = Nat.0) = (xs = ys))
}

define is_word_length(xs: List[Bool], n: Nat) -> Bool {
    xs.length = n
}

define is_code(words: List[List[Bool]], n: Nat) -> Bool {
    words.is_unique and forall(w: List[Bool]) {
        words.contains(w) implies w.length = n
    }
}

define min_distance_at_least(words: List[List[Bool]], d: Nat) -> Bool {
    forall(x: List[Bool], y: List[Bool]) {
        words.contains(x) and words.contains(y) and x != y implies d <= hamming(x, y)
    }
}

define zero_word(n: Nat) -> List[Bool] {
    match n {
        Nat.zero {
            List.nil[Bool]
        }
        Nat.suc(k) {
            List.cons(false, zero_word(k))
        }
    }
}

define one_word(n: Nat) -> List[Bool] {
    match n {
        Nat.zero {
            List.nil[Bool]
        }
        Nat.suc(k) {
            List.cons(true, one_word(k))
        }
    }
}

let repetition_code_three: List[List[Bool]] =
    List.cons(zero_word(3), List.cons(one_word(3), List.nil[List[Bool]]))

/// The word obtained from `000` by flipping the first bit.

let flip_first_three: List[Bool] =
    List.cons(true, zero_word(2))

/// The word obtained from `000` by flipping the second bit.

let flip_second_three: List[Bool] =
    List.cons(false, List.cons(true, zero_word(1)))

/// The word obtained from `000` by flipping the third bit.

let flip_third_three: List[Bool] =
    List.cons(false, List.cons(false, List.cons(true, zero_word(0))))


/// The zero word of length `n` has length `n`.
theorem zero_word_length(n: Nat) {
    zero_word(n).length = n
}

theorem one_word_length(n: Nat) {
    one_word(n).length = n
}

theorem zero_one_distinct(n: Nat) {
    0 < n implies zero_word(n) != one_word(n)
}

theorem hamming_zero_one(n: Nat) {
    hamming(zero_word(n), one_word(n)) = n
}

theorem contains_two_imp_eq[T](a: T, b: T, w: T) {
    List.cons(a, List.cons(b, List.nil[T])).contains(w) implies w = a or w = b
}

theorem two_unique_distinct[T](a: T, b: T) {
    a != b implies List.cons(a, List.cons(b, List.nil[T])).is_unique
}

theorem repetition_three_members_length(w: List[Bool]) {
    repetition_code_three.contains(w) implies w.length = 3
}

theorem repetition_three_is_code {
    is_code(repetition_code_three, 3)
}

theorem repetition_three_pair_distance(x: List[Bool], y: List[Bool]) {
    repetition_code_three.contains(x) and repetition_code_three.contains(y) and x != y implies 3 <= hamming(x, y)
}

theorem repetition_three_min_distance {
    min_distance_at_least(repetition_code_three, 3)
}

theorem hamming_ball_radius_one_size_three {
    3.binom(0) + 3.binom(1) = 4
}

theorem two_pow_three {
    2.pow(3) = 8
}

theorem m_times_four_le_eight_imp_le_two(m: Nat) {
    m * 4 <= 8 implies m <= 2
}

theorem sphere_packing_bound_three(m: Nat) {
    m * (3.binom(0) + 3.binom(1)) <= 2.pow(3) implies m <= 2
}

theorem repetition_three_satisfies_bound {
    2 * (3.binom(0) + 3.binom(1)) <= 2.pow(3)
}

theorem flip_first_distance_one {
    hamming(flip_first_three, zero_word(3)) = Nat.1
}

theorem flip_second_distance_one {
    hamming(flip_second_three, zero_word(3)) = Nat.1
}

theorem flip_third_distance_one {
    hamming(flip_third_three, zero_word(3)) = Nat.1
}

theorem flip_first_length {
    flip_first_three.length = 3
}

theorem flip_second_length {
    flip_second_three.length = 3
}

theorem flip_third_length {
    flip_third_three.length = 3
}

theorem single_flip_closer(w: List[Bool]) {
    w.length = 3 and hamming(w, zero_word(3)) = Nat.1 implies
        hamming(w, zero_word(3)) < hamming(w, one_word(3))
}

theorem flip_first_closer {
    hamming(flip_first_three, zero_word(3)) < hamming(flip_first_three, one_word(3))
}

theorem flip_second_closer {
    hamming(flip_second_three, zero_word(3)) < hamming(flip_second_three, one_word(3))
}

theorem flip_third_closer {
    hamming(flip_third_three, zero_word(3)) < hamming(flip_third_three, one_word(3))
}

theorem lte_one_cases(n: Nat) {
    n <= Nat.1 implies n = Nat.0 or n = Nat.1
}

theorem repetition_three_corrects_one_error(w: List[Bool]) {
    w.length = 3 and hamming(w, zero_word(3)) <= Nat.1 implies
        hamming(w, zero_word(3)) < hamming(w, one_word(3))
}

theorem two_pow_nonneg(n: Nat) {
    Nat.1 <= 2.pow(n)
}

theorem two_pow_ge_four_of_ge_two(k: Nat) {
    2 <= k implies 4 <= 2.pow(k)
}

theorem two_pow_le_two_imp_le_one(k: Nat) {
    2.pow(k) <= 2 implies k <= 1
}

theorem sphere_packing_bound_k_three(k: Nat) {
    2.pow(k) * (3.binom(0) + 3.binom(1)) <= 2.pow(3) implies k <= 1
}

theorem binomial_term_zero_power[R: CommRing](a: R, b: R, n: Nat) {
    binomial_term[R](a, b, n, 0) = b.pow(n)
}

theorem binomial_term_top_power[R: CommRing](a: R, b: R, n: Nat) {
    binomial_term[R](a, b, n, n) = a.pow(n)
}

theorem binomial_term_zero_zero[R: CommRing](a: R, b: R) {
    binomial_term[R](a, b, 0, 0) = R.1
}

theorem binomial_term_zero_succ_power[R: CommRing](a: R, b: R, m: Nat) {
    binomial_term[R](a, b, m.suc, 0) = b * b.pow(m)
}

theorem binomial_term_top_succ_power[R: CommRing](a: R, b: R, m: Nat) {
    binomial_term[R](a, b, m.suc, m.suc) = a * a.pow(m)
}

theorem binomial_term_recurrence_succ_index[R: CommRing](a: R, b: R, m: Nat, k: Nat) {
    k < m implies
    binomial_term[R](a, b, m.suc, k.suc) =
    a * binomial_term[R](a, b, m, k) + b * binomial_term[R](a, b, m, k.suc)
}

theorem alternating_binomial_row_sum[R: CommRing](n: Nat) {
    n > Nat.0 implies
        partial(binomial_term[R](-R.1, R.1, n), n.suc) = R.0
}

define even_binomial_row_term[R: CommRing](n: Nat, k: Nat) -> R {
    if Nat.2.divides(k) {
        from_nat[R](n.binom(k))
    } else {
        R.0
    }
}

define odd_binomial_row_term[R: CommRing](n: Nat, k: Nat) -> R {
    if Nat.2.divides(k) {
        R.0
    } else {
        from_nat[R](n.binom(k))
    }
}

theorem alternating_binomial_term_parity[R: CommRing](n: Nat, k: Nat) {
    binomial_term[R](-R.1, R.1, n, k) =
        even_binomial_row_term[R](n, k) - odd_binomial_row_term[R](n, k)
}

theorem alternating_binomial_partial_decomposition[R: CommRing](n: Nat, m: Nat) {
    partial(binomial_term[R](-R.1, R.1, n), m) =
        partial(even_binomial_row_term[R](n), m) -
        partial(odd_binomial_row_term[R](n), m)
}

theorem even_odd_binomial_row_sums_equal[R: CommRing](n: Nat) {
    n > Nat.0 implies
        partial(even_binomial_row_term[R](n), n.suc) =
        partial(odd_binomial_row_term[R](n), n.suc)
}

theorem alternating_binomial_term_eq_sign_mul[R: CommRing](n: Nat, k: Nat) {
    binomial_term[R](-R.1, R.1, n, k) =
        alternating_sign[R](k) * from_nat[R](n.binom(k))
}

theorem alternating_binomial_partial_row[R: CommRing](n: Nat, m: Nat) {
    partial(binomial_term[R](-R.1, R.1, n.suc), m.suc) =
        alternating_sign[R](m) * from_nat[R](n.binom(m))
}

define binomial_derivative_term[R: CommRing](a: R, b: R, n: Nat, k: Nat) -> R {
    from_nat[R](k) * from_nat[R](n.binom(k)) *
        a.pow(k - Nat.1) * b.pow(n - k)
}

theorem binomial_derivative_term_zero[R: CommRing](a: R, b: R, n: Nat) {
    binomial_derivative_term[R](a, b, n, Nat.0) = R.0
}

theorem binomial_derivative_term_suc[R: CommRing](
    a: R, b: R, n: Nat, k: Nat
) {
    k <= n implies
        binomial_derivative_term[R](a, b, n.suc, k.suc) =
        from_nat[R](n.suc) * binomial_term[R](a, b, n, k)
}

theorem binomial_derivative_sum[R: CommRing](a: R, b: R, n: Nat) {
    partial(binomial_derivative_term[R](a, b, n), n.suc) =
        from_nat[R](n) * (a + b).pow(n - Nat.1)
}

define geom_sum_term[R: CommRing](a: R, b: R, n: Nat, k: Nat) -> R {
    a.pow(k) * b.pow(n - k)
}

theorem geom_sum_term_step[R: CommRing](a: R, b: R, n: Nat) {
    partial(geom_sum_term[R](a, b, n.suc), n.suc.suc) =
        a.pow(n.suc) + b * partial(geom_sum_term[R](a, b, n), n.suc)
}

theorem geom_sum[R: CommRing](a: R, b: R, n: Nat) {
    (a - b) * partial(geom_sum_term[R](a, b, n), n.suc) = a.pow(n.suc) - b.pow(n.suc)
}

theorem geom_sum_classical[R: CommRing](a: R, b: R, n: Nat) {
    (a - b) * partial(geom_sum_term[R](a, b, n - Nat.1), n) = a.pow(n) - b.pow(n)
}

define residue_list(n: Nat, f: Nat -> Nat, m: Nat) -> List[Nat] {
    map(m.range, function(i: Nat) { f(i).mod(n) })
}

theorem residue_list_length(n: Nat, f: Nat -> Nat, m: Nat) {
    residue_list(n, f, m).length = m
}

theorem residue_list_lt(n: Nat, f: Nat -> Nat, m: Nat, x: Nat) {
    n != Nat.0 and residue_list(n, f, m).contains(x) implies x < n
}

theorem lt_three_cases(x: Nat) {
    x < Nat.3 implies x = Nat.0 or x = Nat.1 or x = Nat.2
}

theorem one_lte_two_add(x: Nat) {
    Nat.1 + x <= Nat.2 + x
}

define pick_one(i: Nat) -> Nat -> Nat {
    function(a: Nat) {
        i
    }
}

theorem pick_one_apply(i: Nat, a: Nat) {
    pick_one(i)(a) = i
}

define pick_two(i: Nat, j: Nat) -> Nat -> Nat {
    function(a: Nat) {
        if a = 0 {
            i
        } else {
            j
        }
    }
}

theorem pick_two_zero(i: Nat, j: Nat) {
    pick_two(i, j)(0) = i
}

theorem pick_two_one(i: Nat, j: Nat) {
    pick_two(i, j)(1) = j
}

define pick_three(i: Nat, j: Nat, k: Nat) -> Nat -> Nat {
    function(a: Nat) {
        if a = 0 {
            i
        } else {
            if a = 1 {
                j
            } else {
                k
            }
        }
    }
}

theorem pick_three_zero(i: Nat, j: Nat, k: Nat) {
    pick_three(i, j, k)(0) = i
}

theorem pick_three_one(i: Nat, j: Nat, k: Nat) {
    pick_three(i, j, k)(1) = j
}

theorem pick_three_two(i: Nat, j: Nat, k: Nat) {
    pick_three(i, j, k)(2) = k
}

theorem egz_bounds_one {
    forall(j: Nat) { j < Nat.1 implies pick_one(Nat.0)(j) < Nat.1 }
}

theorem egz_inj_one {
    forall(a: Nat, b: Nat) { a < b and b < Nat.1 implies pick_one(Nat.0)(a) != pick_one(Nat.0)(b) }
}

theorem egz_bounds_two(i: Nat, j: Nat) {
    i < j and j < Nat.3 implies forall(j2: Nat) {
        j2 < Nat.2 implies pick_two(i, j)(j2) < Nat.3
    }
}

theorem lt_imp_ne_nat(a: Nat, b: Nat) {
    a < b implies a != b
}

theorem egz_inj_two(i: Nat, j: Nat) {
    i < j and j < Nat.3 implies forall(a: Nat, b: Nat) {
        a < b and b < Nat.2 implies pick_two(i, j)(a) != pick_two(i, j)(b)
    }
}

theorem lt_two_cases(x: Nat) {
    x < Nat.2 implies x = Nat.0 or x = Nat.1
}

theorem lt_two_ne_zero_imp_one(x: Nat) {
    x < Nat.2 and x != Nat.0 implies x = Nat.1
}

theorem lt_two_ne_one_imp_zero(x: Nat) {
    x < Nat.2 and x != Nat.1 implies x = Nat.0
}

theorem range_sum_term_lte(f: Nat -> Nat, n: Nat, k: Nat) {
    k < n implies f(k) <= range_sum(f, n)
}

theorem partial_term_lte(f: Nat -> Nat, n: Nat, k: Nat) {
    k < n implies f(k) <= partial(f, n)
}

define binom_row(m: Nat, k: Nat) -> Nat {
    m.binom(k)
}

theorem binomial_term_one_one(m: Nat, k: Nat) {
    binomial_term(Nat.1, Nat.1, m, k) = binom_row(m, k)
}

theorem binom_lte_two_pow(m: Nat, k: Nat) {
    k <= m implies m.binom(k) <= Nat.2.pow(m)
}

theorem range_sum_two_terms_lte(f: Nat -> Nat, n: Nat, j: Nat, k: Nat) {
    j < k and k < n implies f(j) + f(k) <= range_sum(f, n)
}

theorem partial_two_terms_lte(f: Nat -> Nat, n: Nat, j: Nat, k: Nat) {
    j < k and k < n implies f(j) + f(k) <= partial(f, n)
}

theorem odd_row_middle_symm(m: Nat) {
    (m + m.suc).binom(m) = (m + m.suc).binom(m.suc)
}

theorem odd_row_middle_doubled(m: Nat) {
    (m + m.suc).binom(m) + (m + m.suc).binom(m) <= Nat.2.pow(m + m.suc)
}

theorem two_pow_odd(m: Nat) {
    Nat.2.pow(m + m.suc) = Nat.2 * Nat.4.pow(m)
}

theorem odd_binom_lte_four_pow(m: Nat) {
    (m + m.suc).binom(m) <= Nat.4.pow(m)
}
