define is_odd(n: Nat) -> Bool {
    match n {
        Nat.zero {
            false
        }
        Nat.suc(pred) {
            not is_odd(pred)
        }
    }
}

theorem is_odd_suc(k: Nat) {
    is_odd(k.suc) = not is_odd(k)
}

