theorem ring_hom_sub[R: Ring, S: Ring](f: RingHom[R, S], a: R, b: R) {
    f.hom(a - b) = f.hom(a) - f.hom(b)
}

theorem ring_hom_unit_val[R: Ring, S: Ring](f: RingHom[R, S], u: Unit[R]) {
    monoid_hom_unit(ring_hom_to_monoid_hom(f), u).val = f.hom(u.val)
}

theorem ring_hom_unit_inv[R: Ring, S: Ring](f: RingHom[R, S], u: Unit[R]) {
    monoid_hom_unit(ring_hom_to_monoid_hom(f), u).inv = f.hom(u.inv)
}

theorem ring_hom_maps_unit[R: CommRing, S: CommRing](f: RingHom[R, S], a: R) {
    a.is_unit implies f.hom(a).is_unit
}

theorem ring_hom_kernel_contains_zero[R: CommRing, S: CommRing](f: RingHom[R, S]) {
    ring_hom_kernel(f).contains(R.0)
}

theorem ring_hom_kernel_contains_add[R: CommRing, S: CommRing](f: RingHom[R, S], a: R, b: R) {
    ring_hom_kernel(f).contains(a) and ring_hom_kernel(f).contains(b) implies
        ring_hom_kernel(f).contains(a + b)
}

theorem ring_hom_kernel_contains_mul[R: CommRing, S: CommRing](f: RingHom[R, S], r: R, a: R) {
    ring_hom_kernel(f).contains(a) implies ring_hom_kernel(f).contains(r * a)
}

theorem ring_hom_kernel_is_ideal[R: CommRing, S: CommRing](f: RingHom[R, S]) {
    is_ideal(ring_hom_kernel(f).contains)
}

theorem ring_hom_kernel_contains_sub_iff[R: CommRing, S: CommRing](f: RingHom[R, S], a: R, b: R) {
    ring_hom_kernel(f).contains(a - b) = (f.hom(a) = f.hom(b))
}

theorem ring_hom_kernel_of_compose[R: CommRing, S: CommRing, T: CommRing](
    f: RingHom[S, T],
    g: RingHom[R, S]
) {
    ring_hom_kernel(compose_ring_hom(f, g)) = ideal_preimage(g, ring_hom_kernel(f))
}

theorem ideal_contains_mul_of_contains[R: CommRing](i: Ideal[R], a: R, b: R) {
    i.contains(a) and i.contains(b) implies i.contains(a * b)
}

theorem ideal_inter_contains_of_contains[R: CommRing](i: Ideal[R], j: Ideal[R], a: R) {
    i.contains(a) and j.contains(a) implies i.intersection(j).contains(a)
}

theorem ideal_sum_contains_add[R: CommRing](i: Ideal[R], j: Ideal[R], a: R, b: R) {
    i.contains(a) and j.contains(b) implies i.sum(j).contains(a + b)
}

theorem ideal_quotient_mk_type_eq_iff_contains_sub[R: CommRing](i: Ideal[R], a: R, b: R) {
    (ideal_quotient_mk_type(i, a) = ideal_quotient_mk_type(i, b)) = i.contains(a - b)
}

theorem ideal_quotient_mk_type_eq_zero_iff_contains[R: CommRing](i: Ideal[R], a: R) {
    (ideal_quotient_mk_type(i, a) = Zero.0[IdealQuotient[R, i]]) = i.contains(a)
}

theorem ideal_quotient_mk_type_eq_zero_of_contains[R: CommRing](i: Ideal[R], a: R) {
    i.contains(a) implies ideal_quotient_mk_type(i, a) = Zero.0[IdealQuotient[R, i]]
}

theorem ideal_quotient_contains_of_mk_type_eq_zero[R: CommRing](i: Ideal[R], a: R) {
    ideal_quotient_mk_type(i, a) = Zero.0[IdealQuotient[R, i]] implies i.contains(a)
}

theorem ideal_quotient_mk_type_neg[R: CommRing](i: Ideal[R], a: R) {
    ideal_quotient_mk_type(i, -a) = -ideal_quotient_mk_type(i, a)
}

theorem ideal_quotient_first_iso_factorization[R: CommRing, S: CommRing](f: RingHom[R, S]) {
    forall(a: R) {
        ring_hom_kernel_quotient_induced(f, ideal_quotient_project(ring_hom_kernel(f), a)) = f.hom(a)
    }
}

theorem ideal_quotient_first_iso_induced_injective[R: CommRing, S: CommRing](f: RingHom[R, S]) {
    forall(a: R, b: R) {
        ring_hom_kernel_quotient_induced(f, ideal_quotient_project(ring_hom_kernel(f), a)) =
            ring_hom_kernel_quotient_induced(f, ideal_quotient_project(ring_hom_kernel(f), b))
        implies ideal_quotient_project(ring_hom_kernel(f), a) = ideal_quotient_project(ring_hom_kernel(f), b)
    }
}

theorem ring_two_mul[R: CommRing](x: R) {
    (R.1 + R.1) * x = x + x
}

theorem ring_square_add_raw[R: CommRing](a: R, b: R) {
    (a + b) * (a + b) = a * a + (a * b + a * b) + b * b
}

theorem ring_square_add_pow[R: CommRing](a: R, b: R) {
    (a + b).pow(Nat.2) = a.pow(Nat.2) + (R.1 + R.1) * a * b + b.pow(Nat.2)
}

theorem ring_square_sub_pow[R: CommRing](a: R, b: R) {
    (a - b).pow(Nat.2) = a.pow(Nat.2) - (R.1 + R.1) * a * b + b.pow(Nat.2)
}

theorem ring_square_add_reordered[R: CommRing](a: R, b: R) {
    (a + b).pow(Nat.2) = a.pow(Nat.2) + b.pow(Nat.2) + (R.1 + R.1) * a * b
}

theorem ring_difference_of_squares[R: CommRing](a: R, b: R) {
    (a + b) * (a - b) = a.pow(Nat.2) - b.pow(Nat.2)
}

theorem ring_add_rotate_three[R: Ring](a: R, b: R, c: R) {
    (a + b) + c = (b + c) + a
}

theorem ring_add_swap_outer[R: Ring](a: R, b: R, c: R) {
    a + (b + c) = b + (a + c)
}

theorem ideal_contains_sub[R: CommRing](i: Ideal[R], a: R, b: R) {
    i.contains(a) and i.contains(b) implies i.contains(a - b)
}

theorem ideal_contains_neg_iff[R: CommRing](i: Ideal[R], a: R) {
    i.contains(-a) = i.contains(a)
}

theorem ideal_contains_of_contains_sub_add[R: CommRing](i: Ideal[R], a: R, b: R) {
    i.contains(a - b) and i.contains(b) implies i.contains(a)
}

theorem ideal_contains_iff_contains_zero_sub[R: CommRing](i: Ideal[R], a: R) {
    i.contains(R.0 - a) = i.contains(a)
}

theorem ideal_contains_sub_self[R: CommRing](i: Ideal[R], a: R) {
    i.contains(a - a)
}

theorem ideal_contains_pow[R: CommRing](i: Ideal[R], a: R, n: Nat) {
    n != Nat.0 and i.contains(a) implies i.contains(a.pow(n))
}

theorem ideal_contains_pow_two[R: CommRing](i: Ideal[R], a: R) {
    i.contains(a) implies i.contains(a.pow(2))
}

theorem ideal_contains_mul_left_of_contains[R: CommRing](i: Ideal[R], r: R, a: R) {
    i.contains(a) implies i.contains(r * a)
}

theorem ideal_contains_mul_right_of_contains[R: CommRing](i: Ideal[R], a: R, r: R) {
    i.contains(a) implies i.contains(a * r)
}

theorem ideal_contains_from_nat_mul[R: CommRing](i: Ideal[R], a: R, n: Nat) {
    i.contains(a) implies i.contains(from_nat[R](n) * a)
}

theorem ideal_inter_contains_mul[R: CommRing](i: Ideal[R], j: Ideal[R], a: R, b: R) {
    i.contains(a) and j.contains(b) implies i.intersection(j).contains(a * b)
}

theorem ideal_sum_contains_mul[R: CommRing](i: Ideal[R], j: Ideal[R], a: R, b: R) {
    i.contains(a) and j.contains(b) implies i.sum(j).contains(a * b)
}

theorem ideal_sum_contains_left_elem[R: CommRing](i: Ideal[R], j: Ideal[R], a: R) {
    i.contains(a) implies i.sum(j).contains(a)
}

theorem ideal_sum_contains_right_elem[R: CommRing](i: Ideal[R], j: Ideal[R], b: R) {
    j.contains(b) implies i.sum(j).contains(b)
}

theorem ideal_quotient_mk_type_sub[R: CommRing](i: Ideal[R], a: R, b: R) {
    ideal_quotient_mk_type(i, a - b) = ideal_quotient_mk_type(i, a) - ideal_quotient_mk_type(i, b)
}

theorem ideal_quotient_mk_type_pow[R: CommRing](i: Ideal[R], a: R, n: Nat) {
    ideal_quotient_mk_type(i, a.pow(n)) = ideal_quotient_mk_type(i, a).pow(n)
}

theorem ideal_quotient_mk_type_sub_eq_zero_iff_contains[R: CommRing](i: Ideal[R], a: R, b: R) {
    (ideal_quotient_mk_type(i, a) - ideal_quotient_mk_type(i, b) = Zero.0[IdealQuotient[R, i]]) =
        i.contains(a - b)
}

theorem unit_typeclass_mul_eq_unit_mul[M: Monoid](u: Unit[M], v: Unit[M]) {
    u * v = unit_mul(u, v)
}

theorem unit_typeclass_one_eq_unit_one[M: Monoid] {
    One.1[Unit[M]] = unit_one[M]
}

theorem unit_typeclass_mul_assoc[M: Monoid](u: Unit[M], v: Unit[M], w: Unit[M]) {
    Mul.mul(u, Mul.mul(v, w)) = Mul.mul(Mul.mul(u, v), w)
}

theorem unit_semigroup_mul_associative[M: Monoid] {
    forall(u: Unit[M], v: Unit[M], w: Unit[M]) {
        Mul.mul(u, Mul.mul(v, w)) = Mul.mul(Mul.mul(u, v), w)
    }
}

theorem unit_typeclass_mul_one_right[M: Monoid](u: Unit[M]) {
    u * One.1[Unit[M]] = u
}

theorem unit_typeclass_mul_one_left[M: Monoid](u: Unit[M]) {
    One.1[Unit[M]] * u = u
}

theorem unit_monoid_identity_right[M: Monoid] {
    forall(u: Unit[M]) {
        u * One.1[Unit[M]] = u
    }
}

theorem unit_monoid_identity_left[M: Monoid] {
    forall(u: Unit[M]) {
        One.1[Unit[M]] * u = u
    }
}

theorem unit_typeclass_unit_inverse_right[M: Monoid](u: Unit[M]) {
    u * unit_inverse(u) = One.1[Unit[M]]
}

theorem unit_typeclass_inverse_eq_unit_inverse[M: Monoid](u: Unit[M]) {
    u.inverse = unit_inverse(u)
}

theorem unit_typeclass_inverse_right[M: Monoid](u: Unit[M]) {
    u * u.inverse = One.1[Unit[M]]
}

theorem unit_val_mul_typeclass[M: Monoid](u: Unit[M], v: Unit[M]) {
    (u * v).val = u.val * v.val
}

theorem unit_inv_mul_typeclass[M: Monoid](u: Unit[M], v: Unit[M]) {
    (u * v).inv = v.inv * u.inv
}

theorem unit_one_val_typeclass[M: Monoid] {
    One.1[Unit[M]].val = M.1
}

theorem unit_one_inv_typeclass[M: Monoid] {
    One.1[Unit[M]].inv = M.1
}

theorem unit_inverse_val_typeclass[M: Monoid](u: Unit[M]) {
    u.inverse.val = u.inv
}

theorem unit_inverse_inv_typeclass[M: Monoid](u: Unit[M]) {
    u.inverse.inv = u.val
}

theorem unit_typeclass_eq_iff_val_eq[M: Monoid](u: Unit[M], v: Unit[M]) {
    (u = v) = (u.val = v.val)
}

theorem unit_typeclass_eq_one_iff_val_eq_one[M: Monoid](u: Unit[M]) {
    (u = One.1[Unit[M]]) = (u.val = M.1)
}

theorem unit_typeclass_mul_ext_val[M: Monoid](u: Unit[M], v: Unit[M], w: Unit[M]) {
    u.val * v.val = w.val implies u * v = w
}

define units_map_fn[M: Monoid, N: Monoid](f: MonoidHom[M, N], u: Unit[M]) -> Unit[N] {
    monoid_hom_unit(f, u)
}

theorem units_map_fn_is_monoid_hom[M: Monoid, N: Monoid](f: MonoidHom[M, N]) {
    is_monoid_hom(units_map_fn(f))
}

let units_map[M: Monoid, N: Monoid](f: MonoidHom[M, N]) -> result: MonoidHom[Unit[M], Unit[N]] satisfy {
    MonoidHom.new(units_map_fn(f)) = Option.some(result)
}

theorem units_map_hom[M: Monoid, N: Monoid](f: MonoidHom[M, N]) {
    units_map(f).hom = units_map_fn(f)
}

theorem coe_map[M: Monoid, N: Monoid](f: MonoidHom[M, N], u: Unit[M]) {
    units_map(f).hom(u).val = f.hom(u.val)
}

theorem coe_map_inv[M: Monoid, N: Monoid](f: MonoidHom[M, N], u: Unit[M]) {
    units_map(f).hom(u).inv = f.hom(u.inv)
}
