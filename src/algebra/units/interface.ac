    subfield_preimage(phi, subfield_image(phi, s))
}

theorem subfield_image_preimage_closure_extensive[F: Field, E: Field](
    phi: FieldHom[F, E], s: Subfield[F]
) {
    subfield_le(s, subfield_image_preimage_closure(phi, s))
}

theorem subfield_image_preimage_closure_monotone[F: Field, E: Field](
    phi: FieldHom[F, E], s: Subfield[F], t: Subfield[F]
) {
    subfield_le(s, t) implies
        subfield_le(subfield_image_preimage_closure(phi, s), subfield_image_preimage_closure(phi, t))
}

theorem subfield_le_image_preimage_closure_iff_image_le[F: Field, E: Field](
    phi: FieldHom[F, E], s: Subfield[F], t: Subfield[F]
) {
    subfield_le(s, subfield_image_preimage_closure(phi, t)) =
        subfield_le(subfield_image(phi, s), subfield_image(phi, t))
}

theorem subfield_image_preimage_closure_eq_self[F: Field, E: Field](
    phi: FieldHom[F, E], s: Subfield[F]
) {
    subfield_image_preimage_closure(phi, s) = s
}

theorem subfield_image_of_preimage_closure_eq[F: Field, E: Field](
    phi: FieldHom[F, E], s: Subfield[F]
) {
    subfield_image(phi, subfield_image_preimage_closure(phi, s)) = subfield_image(phi, s)
}

theorem subfield_image_preimage_closure_idempotent[F: Field, E: Field](
    phi: FieldHom[F, E], s: Subfield[F]
) {
    subfield_image_preimage_closure(phi, subfield_image_preimage_closure(phi, s)) =
        subfield_image_preimage_closure(phi, s)
}

define subfield_image_preimage_kernel[F: Field, E: Field](
    phi: FieldHom[F, E], t: Subfield[E]
) -> Subfield[E] {
    subfield_image(phi, subfield_preimage(phi, t))
}

theorem subfield_image_preimage_kernel_le[F: Field, E: Field](
    phi: FieldHom[F, E], t: Subfield[E]
) {
    subfield_le(subfield_image_preimage_kernel(phi, t), t)
}

theorem subfield_image_preimage_kernel_le_field_hom_image[F: Field, E: Field](
    phi: FieldHom[F, E], t: Subfield[E]
) {
    subfield_le(subfield_image_preimage_kernel(phi, t), field_hom_image(phi))
}

theorem subfield_image_preimage_kernel_eq_inter[F: Field, E: Field](
    phi: FieldHom[F, E], t: Subfield[E]
) {
    subfield_image_preimage_kernel(phi, t) = subfield_inter(t, field_hom_image(phi))
}

theorem subfield_image_preimage_kernel_le_iff_preimage_le[F: Field, E: Field](
    phi: FieldHom[F, E], s: Subfield[E], t: Subfield[E]
) {
    subfield_le(subfield_image_preimage_kernel(phi, s), t) =
        subfield_le(subfield_preimage(phi, s), subfield_preimage(phi, t))
}

theorem subfield_image_preimage_kernel_monotone[F: Field, E: Field](
    phi: FieldHom[F, E], s: Subfield[E], t: Subfield[E]
) {
    subfield_le(s, t) implies
        subfield_le(subfield_image_preimage_kernel(phi, s), subfield_image_preimage_kernel(phi, t))
}

theorem subfield_image_preimage_kernel_idempotent[F: Field, E: Field](
    phi: FieldHom[F, E], t: Subfield[E]
) {
    subfield_image_preimage_kernel(phi, subfield_image_preimage_kernel(phi, t)) =
        subfield_image_preimage_kernel(phi, t)
}

theorem subfield_image_preimage_kernel_fixed_iff_le_image[F: Field, E: Field](
    phi: FieldHom[F, E], t: Subfield[E]
) {
    (subfield_image_preimage_kernel(phi, t) = t) = subfield_le(t, field_hom_image(phi))
}

theorem subfield_image_preimage_kernel_eq_of_le_image[F: Field, E: Field](
    phi: FieldHom[F, E], t: Subfield[E]
) {
    subfield_le(t, field_hom_image(phi)) implies subfield_image_preimage_kernel(phi, t) = t
}

theorem subfield_le_image_of_subfield_image_preimage_kernel_eq[F: Field, E: Field](
    phi: FieldHom[F, E], t: Subfield[E]
) {
    subfield_image_preimage_kernel(phi, t) = t implies subfield_le(t, field_hom_image(phi))
}

define subfield_carrier[F: Field](s: Subfield[F]) -> Set[F] {
    Set[F].new(s.contains)
}

theorem subfield_carrier_contains_eq[F: Field](s: Subfield[F], x: F) {
    subfield_carrier(s).contains(x) = s.contains(x)
}

define set_subset_subfield[F: Field](a: Set[F], s: Subfield[F]) -> Bool {
    a.subset(subfield_carrier(s))
}

theorem set_subset_subfield_intro[F: Field](a: Set[F], s: Subfield[F]) {
    (forall(x: F) { a.contains(x) implies s.contains(x) }) implies set_subset_subfield(a, s)
}

theorem set_subset_subfield_contains[F: Field](a: Set[F], s: Subfield[F], x: F) {
    set_subset_subfield(a, s) and a.contains(x) implies s.contains(x)
}

theorem set_subset_subfield_carrier_self[F: Field](s: Subfield[F]) {
    set_subset_subfield(subfield_carrier(s), s)
}

define subfield_closure_contains[F: Field](a: Set[F], x: F) -> Bool {
    forall(s: Subfield[F]) {
        set_subset_subfield(a, s) implies s.contains(x)
    }
}

theorem subfield_closure_contains_intro[F: Field](a: Set[F], x: F) {
    (forall(s: Subfield[F]) { set_subset_subfield(a, s) implies s.contains(x) })
    implies subfield_closure_contains(a, x)
}

theorem subfield_closure_contains_in_subfield[F: Field](a: Set[F], s: Subfield[F], x: F) {
    subfield_closure_contains(a, x) and set_subset_subfield(a, s) implies s.contains(x)
}

theorem subfield_closure_contains_zero[F: Field](a: Set[F]) {
    subfield_closure_contains(a, F.0)
}

theorem subfield_closure_contains_one[F: Field](a: Set[F]) {
    subfield_closure_contains(a, F.1)
}

theorem subfield_closure_contains_add[F: Field](a: Set[F], x: F, y: F) {
    subfield_closure_contains(a, x) and subfield_closure_contains(a, y)
    implies subfield_closure_contains(a, x + y)
}

theorem subfield_closure_contains_neg[F: Field](a: Set[F], x: F) {
    subfield_closure_contains(a, x) implies subfield_closure_contains(a, -x)
}

theorem subfield_closure_contains_mul[F: Field](a: Set[F], x: F, y: F) {
    subfield_closure_contains(a, x) and subfield_closure_contains(a, y)
    implies subfield_closure_contains(a, x * y)
}

theorem subfield_closure_contains_inverse[F: Field](a: Set[F], x: F) {
    subfield_closure_contains(a, x) and x != F.0 implies subfield_closure_contains(a, x.inverse)
}

theorem subfield_closure_contains_is_subfield[F: Field](a: Set[F]) {
    subfield_constraint(subfield_closure_contains(a))
}

let subfield_closure[F: Field](a: Set[F]) -> result: Subfield[F] satisfy {
    Subfield.new(subfield_closure_contains(a)) = Option.some(result)
}

theorem subfield_closure_contains_eq[F: Field](a: Set[F], x: F) {
    subfield_closure(a).contains(x) = subfield_closure_contains(a, x)
}

theorem subfield_closure_contains_generator[F: Field](a: Set[F], x: F) {
    a.contains(x) implies subfield_closure(a).contains(x)
}

theorem subfield_closure_minimal[F: Field](a: Set[F], s: Subfield[F]) {
    set_subset_subfield(a, s) implies subfield_le(subfield_closure(a), s)
}

theorem subfield_closure_le_iff_set_subset_subfield[F: Field](a: Set[F], s: Subfield[F]) {
    subfield_le(subfield_closure(a), s) = set_subset_subfield(a, s)
}

theorem subfield_closure_mono[F: Field](a: Set[F], b: Set[F]) {
    a.subset(b) implies subfield_le(subfield_closure(a), subfield_closure(b))
}

theorem subfield_closure_eq_of_mutual_subset[F: Field](a: Set[F], b: Set[F]) {
    a.subset(b) and b.subset(a) implies subfield_closure(a) = subfield_closure(b)
}

theorem subfield_closure_of_carrier[F: Field](s: Subfield[F]) {
    subfield_closure(subfield_carrier(s)) = s
}

theorem subfield_closure_idempotent[F: Field](a: Set[F]) {
    subfield_closure(subfield_carrier(subfield_closure(a))) = subfield_closure(a)
}

theorem set_image_subset_subfield_image_closure[F: Field, E: Field](
    phi: FieldHom[F, E], a: Set[F]
) {
    set_subset_subfield(set_image(a, phi.hom), subfield_image(phi, subfield_closure(a)))
}

theorem subfield_image_closure_le_closure_image[F: Field, E: Field](
    phi: FieldHom[F, E], a: Set[F]
) {
    subfield_le(subfield_image(phi, subfield_closure(a)), subfield_closure(set_image(a, phi.hom)))
}

theorem subfield_image_closure_eq_closure_image[F: Field, E: Field](
    phi: FieldHom[F, E], a: Set[F]
) {
    subfield_image(phi, subfield_closure(a)) = subfield_closure(set_image(a, phi.hom))
}

theorem subfield_preimage_closure_image_eq_closure[F: Field, E: Field](
    phi: FieldHom[F, E], a: Set[F]
) {
    subfield_preimage(phi, subfield_closure(set_image(a, phi.hom))) = subfield_closure(a)
}

theorem subfield_closure_preimage_le_preimage_closure[F: Field, E: Field](
    phi: FieldHom[F, E], a: Set[E]
) {
    subfield_le(subfield_closure(set_preimage(phi.hom, a)), subfield_preimage(phi, subfield_closure(a)))
}

theorem subfield_image_closure_preimage_le_closure[F: Field, E: Field](
    phi: FieldHom[F, E], a: Set[E]
) {
    subfield_le(subfield_image(phi, subfield_closure(set_preimage(phi.hom, a))), subfield_closure(a))
}

theorem subfield_image_closure_preimage_eq_closure_of_set_subset_image[F: Field, E: Field](
    phi: FieldHom[F, E], a: Set[E]
) {
    set_subset_subfield(a, field_hom_image(phi)) implies
    subfield_image(phi, subfield_closure(set_preimage(phi.hom, a))) = subfield_closure(a)
}

theorem field_unit_val_nonzero[F: Field](u: Unit[F]) {
    u.val != F.0
}

theorem field_unit_inv_nonzero[F: Field](u: Unit[F]) {
    u.inv != F.0
}

theorem field_unit_inv_eq_inverse[F: Field](u: Unit[F]) {
    u.inv = u.val.inverse
}

theorem field_unit_val_eq_inverse_inv[F: Field](u: Unit[F]) {
    u.val = u.inv.inverse
}

theorem field_unit_val_inverse_nonzero[F: Field](u: Unit[F]) {
    u.val.inverse != F.0
}

theorem field_unit_val_mul_nonzero_left[F: Field](u: Unit[F], a: F) {
    a != F.0 implies u.val * a != F.0
}

theorem field_unit_val_mul_nonzero_right[F: Field](u: Unit[F], a: F) {
    a != F.0 implies a * u.val != F.0
}

theorem field_nonzero_is_monoid_unit[F: Field](a: F) {
    a != F.0 implies is_monoid_unit(a)
}

theorem field_inverse_is_monoid_unit[F: Field](a: F) {
    a != F.0 implies is_monoid_unit(a.inverse)
}

theorem field_is_monoid_unit_iff_nonzero[F: Field](a: F) {
    is_monoid_unit(a) = (a != F.0)
}

theorem field_zero_not_monoid_unit[F: Field] {
    not(is_monoid_unit(F.0))
}

theorem field_one_is_monoid_unit[F: Field] {
    is_monoid_unit(F.1)
}

theorem field_mul_eq_one_left_nonzero[F: Field](a: F, b: F) {
    a * b = F.1 implies a != F.0
}

theorem field_mul_eq_one_right_nonzero[F: Field](a: F, b: F) {
    a * b = F.1 implies b != F.0
}

theorem field_unit_exists_of_nonzero[F: Field](a: F) {
    a != F.0 implies exists(u: Unit[F]) {
        u.val = a and u.inv = a.inverse
    }
}

theorem field_nonzero_is_unit[F: Field](a: F) {
    a != F.0 implies a.is_unit
}

theorem field_nonzero_pow_is_unit[F: Field](a: F, n: Nat) {
    a != F.0 implies a.pow(n).is_unit
}

theorem field_unit_is_nonzero[F: Field](a: F) {
    a.is_unit implies a != F.0
}

theorem field_is_unit_iff_nonzero[F: Field](a: F) {
    a.is_unit = (a != F.0)
}

theorem field_zero_is_non_unit[F: Field] {
    F.0.is_non_unit
}

theorem field_non_unit_iff_zero[F: Field](a: F) {
    a.is_non_unit = (a = F.0)
}

theorem field_maximal_ideal_eq_zero_ideal[F: Field](other: F -> Bool) {
    is_maximal_ideal(other) implies other = zero_ideal[F]
}

theorem field_is_local_ring[F: Field] {
    is_local_ring(zero_ideal[F])
}

theorem unit_typeclass_one_eq_unit_one[M: Monoid] {
    One.1[Unit[M]] = unit_one[M]
}

theorem unit_typeclass_mul_one_right[M: Monoid](u: Unit[M]) {
    u * One.1[Unit[M]] = u
}

theorem unit_typeclass_mul_one_left[M: Monoid](u: Unit[M]) {
    One.1[Unit[M]] * u = u
}

theorem unit_monoid_identity_right[M: Monoid] {
    forall(u: Unit[M]) {
        u * One.1[Unit[M]] = u
    }
}

theorem unit_monoid_identity_left[M: Monoid] {
    forall(u: Unit[M]) {
        One.1[Unit[M]] * u = u
    }
}

theorem unit_typeclass_unit_inverse_right[M: Monoid](u: Unit[M]) {
    u * unit_inverse(u) = One.1[Unit[M]]
}

theorem unit_typeclass_inverse_right[M: Monoid](u: Unit[M]) {
    u * u.inverse = One.1[Unit[M]]
}

theorem unit_one_val_typeclass[M: Monoid] {
    One.1[Unit[M]].val = M.1
}

theorem unit_one_inv_typeclass[M: Monoid] {
    One.1[Unit[M]].inv = M.1
}

theorem unit_typeclass_eq_one_iff_val_eq_one[M: Monoid](u: Unit[M]) {
    (u = One.1[Unit[M]]) = (u.val = M.1)
}
