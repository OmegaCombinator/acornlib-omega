define is_function_pair_unit[T, A: Monoid, B: Monoid](p: Pair[T -> A, T -> B]) -> Bool {
    exists(q: Pair[T -> A, T -> B]) {
        function_pair_mul(p, q) = function_pair_one[T, A, B] and
        function_pair_mul(q, p) = function_pair_one[T, A, B]
    }
}

theorem function_pair_mul_is_function_pair_unit[T, A: Monoid, B: Monoid](
    p: Pair[T -> A, T -> B],
    q: Pair[T -> A, T -> B]
) {
    is_function_pair_unit(p) and is_function_pair_unit(q) implies
    is_function_pair_unit(function_pair_mul(p, q))
}

theorem function_pair_one_is_function_pair_unit[T, A: Monoid, B: Monoid] {
    is_function_pair_unit(function_pair_one[T, A, B])
}

theorem function_pair_unit_of_inverse[T, A: Monoid, B: Monoid](
    p: Pair[T -> A, T -> B],
    q: Pair[T -> A, T -> B]
) {
    function_pair_mul(p, q) = function_pair_one[T, A, B] and
    function_pair_mul(q, p) = function_pair_one[T, A, B]
    implies is_function_pair_unit(p)
}

theorem function_pair_inverse_witness_is_function_pair_unit[T, A: Monoid, B: Monoid](
    p: Pair[T -> A, T -> B],
    q: Pair[T -> A, T -> B]
) {
    function_pair_mul(p, q) = function_pair_one[T, A, B] and
    function_pair_mul(q, p) = function_pair_one[T, A, B]
    implies is_function_pair_unit(q)
}

theorem function_pair_unit_of_group[T, A: Group, B: Group](p: Pair[T -> A, T -> B]) {
    is_function_pair_unit(p)
}

theorem function_pair_inverse_is_function_pair_unit[T, A: Group, B: Group](
    p: Pair[T -> A, T -> B]
) {
    is_function_pair_unit(function_pair_inverse(p))
}

define is_function_triple_unit[T, A: Monoid, B: Monoid, C: Monoid](
    p: Pair[T -> A, Pair[T -> B, T -> C]]
) -> Bool {
    exists(q: Pair[T -> A, Pair[T -> B, T -> C]]) {
        function_triple_mul(p, q) = function_triple_one[T, A, B, C] and
        function_triple_mul(q, p) = function_triple_one[T, A, B, C]
    }
}

theorem function_triple_one_is_function_triple_unit[T, A: Monoid, B: Monoid, C: Monoid] {
    is_function_triple_unit(function_triple_one[T, A, B, C])
}

theorem function_triple_unit_of_inverse[T, A: Monoid, B: Monoid, C: Monoid](
    p: Pair[T -> A, Pair[T -> B, T -> C]],
    q: Pair[T -> A, Pair[T -> B, T -> C]]
) {
    function_triple_mul(p, q) = function_triple_one[T, A, B, C] and
    function_triple_mul(q, p) = function_triple_one[T, A, B, C]
    implies is_function_triple_unit(p)
}

theorem function_triple_inverse_witness_is_function_triple_unit[T, A: Monoid, B: Monoid, C: Monoid](
    p: Pair[T -> A, Pair[T -> B, T -> C]],
    q: Pair[T -> A, Pair[T -> B, T -> C]]
) {
    function_triple_mul(p, q) = function_triple_one[T, A, B, C] and
    function_triple_mul(q, p) = function_triple_one[T, A, B, C]
    implies is_function_triple_unit(q)
}

theorem function_triple_unit_of_group[T, A: Group, B: Group, C: Group](
    p: Pair[T -> A, Pair[T -> B, T -> C]]
) {
    is_function_triple_unit(p)
}

theorem function_triple_inverse_is_function_triple_unit[T, A: Group, B: Group, C: Group](
    p: Pair[T -> A, Pair[T -> B, T -> C]]
) {
    is_function_triple_unit(function_triple_inverse(p))
}

define is_function_quadruple_unit[T, A: Monoid, B: Monoid, C: Monoid, D: Monoid](
    p: Pair[T -> A, Pair[T -> B, Pair[T -> C, T -> D]]]
) -> Bool {
    exists(q: Pair[T -> A, Pair[T -> B, Pair[T -> C, T -> D]]]) {
        function_quadruple_mul(p, q) = function_quadruple_one[T, A, B, C, D] and
        function_quadruple_mul(q, p) = function_quadruple_one[T, A, B, C, D]
    }
}

theorem function_quadruple_unit_of_inverse[T, A: Monoid, B: Monoid, C: Monoid, D: Monoid](
    p: Pair[T -> A, Pair[T -> B, Pair[T -> C, T -> D]]],
    q: Pair[T -> A, Pair[T -> B, Pair[T -> C, T -> D]]]
) {
    function_quadruple_mul(p, q) = function_quadruple_one[T, A, B, C, D] and
    function_quadruple_mul(q, p) = function_quadruple_one[T, A, B, C, D]
    implies is_function_quadruple_unit(p)
}

theorem function_quadruple_inverse_witness_is_function_quadruple_unit[T, A: Monoid, B: Monoid, C: Monoid, D: Monoid](
    p: Pair[T -> A, Pair[T -> B, Pair[T -> C, T -> D]]],
    q: Pair[T -> A, Pair[T -> B, Pair[T -> C, T -> D]]]
) {
    function_quadruple_mul(p, q) = function_quadruple_one[T, A, B, C, D] and
    function_quadruple_mul(q, p) = function_quadruple_one[T, A, B, C, D]
    implies is_function_quadruple_unit(q)
}

theorem function_quadruple_unit_of_group[T, A: Group, B: Group, C: Group, D: Group](
    p: Pair[T -> A, Pair[T -> B, Pair[T -> C, T -> D]]]
) {
    is_function_quadruple_unit(p)
}

theorem function_quadruple_inverse_is_function_quadruple_unit[T, A: Group, B: Group, C: Group, D: Group](
    p: Pair[T -> A, Pair[T -> B, Pair[T -> C, T -> D]]]
) {
    is_function_quadruple_unit(function_quadruple_inverse(p))
}

define is_pointwise_unit[T, M: Monoid](f: T -> M) -> Bool {
    exists(g: T -> M) {
        pointwise_mul(f, g) = pointwise_one[T, M] and
        pointwise_mul(g, f) = pointwise_one[T, M]
    }
}

theorem function_pair_unit_first_is_pointwise_unit[T, A: Monoid, B: Monoid](
    p: Pair[T -> A, T -> B]
) {
    is_function_pair_unit(p) implies is_pointwise_unit(p.first)
}

theorem function_pair_unit_second_is_pointwise_unit[T, A: Monoid, B: Monoid](
    p: Pair[T -> A, T -> B]
) {
    is_function_pair_unit(p) implies is_pointwise_unit(p.second)
}

theorem function_pair_unit_of_components[T, A: Monoid, B: Monoid](
    p: Pair[T -> A, T -> B]
) {
    is_pointwise_unit(p.first) and is_pointwise_unit(p.second) implies
    is_function_pair_unit(p)
}

theorem function_pair_unit_iff_components[T, A: Monoid, B: Monoid](
    p: Pair[T -> A, T -> B]
) {
    is_function_pair_unit(p) = (is_pointwise_unit(p.first) and is_pointwise_unit(p.second))
}

theorem function_pair_mul_first_is_pointwise_unit[T, A: Monoid, B: Monoid](
    p: Pair[T -> A, T -> B],
    q: Pair[T -> A, T -> B]
) {
    is_pointwise_unit(p.first) and is_pointwise_unit(q.first) implies
    is_pointwise_unit(function_pair_mul(p, q).first)
}

theorem function_pair_mul_second_is_pointwise_unit[T, A: Monoid, B: Monoid](
    p: Pair[T -> A, T -> B],
    q: Pair[T -> A, T -> B]
) {
    is_pointwise_unit(p.second) and is_pointwise_unit(q.second) implies
    is_pointwise_unit(function_pair_mul(p, q).second)
}

theorem function_triple_unit_first_is_pointwise_unit[T, A: Monoid, B: Monoid, C: Monoid](
    p: Pair[T -> A, Pair[T -> B, T -> C]]
) {
    is_function_triple_unit(p) implies is_pointwise_unit(p.first)
}

theorem function_triple_unit_second_first_is_pointwise_unit[T, A: Monoid, B: Monoid, C: Monoid](
    p: Pair[T -> A, Pair[T -> B, T -> C]]
) {
    is_function_triple_unit(p) implies is_pointwise_unit(p.second.first)
}

theorem function_triple_unit_second_second_is_pointwise_unit[T, A: Monoid, B: Monoid, C: Monoid](
    p: Pair[T -> A, Pair[T -> B, T -> C]]
) {
    is_function_triple_unit(p) implies is_pointwise_unit(p.second.second)
}

theorem function_triple_unit_of_components[T, A: Monoid, B: Monoid, C: Monoid](
    p: Pair[T -> A, Pair[T -> B, T -> C]]
) {
    is_pointwise_unit(p.first) and is_pointwise_unit(p.second.first) and
    is_pointwise_unit(p.second.second) implies is_function_triple_unit(p)
}

theorem function_triple_unit_iff_components[T, A: Monoid, B: Monoid, C: Monoid](
    p: Pair[T -> A, Pair[T -> B, T -> C]]
) {
    is_function_triple_unit(p) = (
        is_pointwise_unit(p.first) and
        is_pointwise_unit(p.second.first) and
        is_pointwise_unit(p.second.second)
    )
}

theorem function_quadruple_unit_first_is_pointwise_unit[T, A: Monoid, B: Monoid, C: Monoid, D: Monoid](
    p: Pair[T -> A, Pair[T -> B, Pair[T -> C, T -> D]]]
) {
    is_function_quadruple_unit(p) implies is_pointwise_unit(p.first)
}

theorem function_quadruple_unit_second_first_is_pointwise_unit[T, A: Monoid, B: Monoid, C: Monoid, D: Monoid](
    p: Pair[T -> A, Pair[T -> B, Pair[T -> C, T -> D]]]
) {
    is_function_quadruple_unit(p) implies is_pointwise_unit(p.second.first)
}

theorem function_quadruple_unit_second_second_first_is_pointwise_unit[T, A: Monoid, B: Monoid, C: Monoid, D: Monoid](
    p: Pair[T -> A, Pair[T -> B, Pair[T -> C, T -> D]]]
) {
    is_function_quadruple_unit(p) implies is_pointwise_unit(p.second.second.first)
}

theorem function_quadruple_unit_second_second_second_is_pointwise_unit[T, A: Monoid, B: Monoid, C: Monoid, D: Monoid](
    p: Pair[T -> A, Pair[T -> B, Pair[T -> C, T -> D]]]
) {
    is_function_quadruple_unit(p) implies is_pointwise_unit(p.second.second.second)
}

theorem unit_function_val_mul_inv[T, M: Monoid](f: T -> Unit[M]) {
    pointwise_mul(unit_function_val(f), unit_function_inv(f)) = pointwise_one[T, M]
}

theorem unit_function_inv_mul_val[T, M: Monoid](f: T -> Unit[M]) {
    pointwise_mul(unit_function_inv(f), unit_function_val(f)) = pointwise_one[T, M]
}

theorem unit_function_val_is_pointwise_unit[T, M: Monoid](f: T -> Unit[M]) {
    is_pointwise_unit(unit_function_val(f))
}

theorem unit_function_inv_is_pointwise_unit[T, M: Monoid](f: T -> Unit[M]) {
    is_pointwise_unit(unit_function_inv(f))
}

theorem pointwise_unit_apply_is_monoid_unit[T, M: Monoid](f: T -> M, t: T) {
    is_pointwise_unit(f) implies is_monoid_unit(f(t))
}

theorem pointwise_unit_of_inverse[T, M: Monoid](f: T -> M, g: T -> M) {
    pointwise_mul(f, g) = pointwise_one[T, M] and
    pointwise_mul(g, f) = pointwise_one[T, M]
    implies is_pointwise_unit(f)
}

theorem pointwise_inverse_witness_is_pointwise_unit[T, M: Monoid](f: T -> M, g: T -> M) {
    pointwise_mul(f, g) = pointwise_one[T, M] and
    pointwise_mul(g, f) = pointwise_one[T, M]
    implies is_pointwise_unit(g)
}

theorem pointwise_unit_of_eq[T, M: Monoid](f: T -> M, h: T -> M) {
    is_pointwise_unit(f) and f = h implies is_pointwise_unit(h)
}

theorem pointwise_unit_of_eq_reverse[T, M: Monoid](f: T -> M, h: T -> M) {
    is_pointwise_unit(h) and f = h implies is_pointwise_unit(f)
}

theorem pointwise_one_is_pointwise_unit[T, M: Monoid] {
    is_pointwise_unit(pointwise_one[T, M])
}

theorem pointwise_unit_of_group[T, G: Group](f: T -> G) {
    is_pointwise_unit(f)
}

theorem pointwise_mul_is_pointwise_unit[T, M: Monoid](f: T -> M, h: T -> M) {
    is_pointwise_unit(f) and is_pointwise_unit(h) implies
        is_pointwise_unit(pointwise_mul(f, h))
}

theorem pointwise_unit_mul_eq_zero_left_apply[T, R: Ring](u: T -> R, f: T -> R, t: T) {
    is_pointwise_unit(u) and pointwise_mul(u, f) = pointwise_zero[T, R] implies
    f(t) = R.0
}

theorem pointwise_unit_mul_eq_zero_left[T, R: Ring](u: T -> R, f: T -> R) {
    is_pointwise_unit(u) and pointwise_mul(u, f) = pointwise_zero[T, R] implies
    f = pointwise_zero[T, R]
}

theorem pointwise_unit_mul_eq_zero_right_apply[T, R: Ring](u: T -> R, f: T -> R, t: T) {
    is_pointwise_unit(u) and pointwise_mul(f, u) = pointwise_zero[T, R] implies
    f(t) = R.0
}

theorem pointwise_unit_mul_eq_zero_right[T, R: Ring](u: T -> R, f: T -> R) {
    is_pointwise_unit(u) and pointwise_mul(f, u) = pointwise_zero[T, R] implies
    f = pointwise_zero[T, R]
}

theorem pointwise_unit_mul_cancel_left_apply[T, R: Ring](u: T -> R, f: T -> R, g: T -> R, t: T) {
    is_pointwise_unit(u) and pointwise_mul(u, f) = pointwise_mul(u, g) implies
    f(t) = g(t)
}

theorem pointwise_unit_mul_cancel_left[T, R: Ring](u: T -> R, f: T -> R, g: T -> R) {
    is_pointwise_unit(u) and pointwise_mul(u, f) = pointwise_mul(u, g) implies
    f = g
}

theorem pointwise_unit_mul_cancel_right_apply[T, R: Ring](u: T -> R, f: T -> R, g: T -> R, t: T) {
    is_pointwise_unit(u) and pointwise_mul(f, u) = pointwise_mul(g, u) implies
    f(t) = g(t)
}

theorem pointwise_unit_mul_cancel_right[T, R: Ring](u: T -> R, f: T -> R, g: T -> R) {
    is_pointwise_unit(u) and pointwise_mul(f, u) = pointwise_mul(g, u) implies
    f = g
}

theorem pointwise_one_apply[T, A: One](t: T) {
    pointwise_one[T, A](t) = A.1
}

theorem pointwise_mul_one_right[T, A: Monoid](f: T -> A) {
    pointwise_mul(f, pointwise_one[T, A]) = f
}

theorem pointwise_mul_one_left[T, A: Monoid](f: T -> A) {
    pointwise_mul(pointwise_one[T, A], f) = f
}

theorem pointwise_mul_inverse_right[T, A: Group](f: T -> A) {
    pointwise_mul(f, pointwise_inverse(f)) = pointwise_one[T, A]
}

theorem pointwise_mul_inverse_left[T, A: Group](f: T -> A) {
    pointwise_mul(pointwise_inverse(f), f) = pointwise_one[T, A]
}

theorem vector_space_smul_eq_zero[F: Field, V: AddCommGroup](
    m: Module[F, V], r: F, v: V) {
    m.smul(r, v) = V.0 implies r = F.0 or v = V.0
}

theorem vector_space_smul_ne_zero[F: Field, V: AddCommGroup](
    m: Module[F, V], r: F, v: V) {
    r != F.0 and v != V.0 implies m.smul(r, v) != V.0
}

theorem vector_space_smul_inverse_left[F: Field, V: AddCommGroup](
    m: Module[F, V], r: F, v: V) {
    r != F.0 implies m.smul(r.inverse, m.smul(r, v)) = v
}

theorem vector_space_smul_inverse_right[F: Field, V: AddCommGroup](
    m: Module[F, V], r: F, v: V) {
    r != F.0 implies m.smul(r, m.smul(r.inverse, v)) = v
}

theorem vector_space_smul_left_cancel[F: Field, V: AddCommGroup](
    m: Module[F, V], r: F, u: V, v: V) {
    r != F.0 and m.smul(r, u) = m.smul(r, v) implies u = v
}

theorem vector_space_smul_right_cancel[F: Field, V: AddCommGroup](
    m: Module[F, V], r: F, s: F, v: V) {
    v != V.0 and m.smul(r, v) = m.smul(s, v) implies r = s
}

theorem vector_space_smul_eq_implies_eq_inverse_smul[F: Field, V: AddCommGroup](
    m: Module[F, V], r: F, u: V, v: V) {
    r != F.0 and m.smul(r, v) = u implies v = m.smul(r.inverse, u)
}

theorem vector_space_inverse_smul_implies_smul_eq[F: Field, V: AddCommGroup](
    m: Module[F, V], r: F, u: V, v: V) {
    r != F.0 and v = m.smul(r.inverse, u) implies m.smul(r, v) = u
}

theorem vector_space_smul_eq_iff_left_cancel[F: Field, V: AddCommGroup](
    m: Module[F, V], r: F, u: V, v: V) {
    r != F.0 implies (m.smul(r, u) = m.smul(r, v) iff u = v)
}

theorem vector_space_smul_eq_zero_iff[F: Field, V: AddCommGroup](
    m: Module[F, V], r: F, v: V) {
    m.smul(r, v) = V.0 iff (r = F.0 or v = V.0)
}

theorem vector_space_neg_smul_eq_smul_neg[F: Field, V: AddCommGroup](
    m: Module[F, V], r: F, v: V) {
    -m.smul(r, v) = m.smul(r, -v)
}

theorem vector_space_smul_eq_iff_right_cancel[F: Field, V: AddCommGroup](
    m: Module[F, V], r: F, s: F, v: V) {
    v != V.0 implies (m.smul(r, v) = m.smul(s, v) iff r = s)
}

theorem vector_space_smul_ne_zero_iff[F: Field, V: AddCommGroup](
    m: Module[F, V], r: F, v: V) {
    m.smul(r, v) != V.0 iff (r != F.0 and v != V.0)
}

theorem vector_space_smul_eq_iff_eq_inverse_smul[F: Field, V: AddCommGroup](
    m: Module[F, V], r: F, u: V, v: V) {
    r != F.0 implies (m.smul(r, v) = u iff v = m.smul(r.inverse, u))
}

theorem vector_space_smul_zero[F: Field, V: AddCommGroup](m: Module[F, V], v: V) {
    m.smul(F.0, v) = V.0
}

theorem vector_space_smul_one[F: Field, V: AddCommGroup](m: Module[F, V], v: V) {
    m.smul(F.1, v) = v
}

theorem vector_space_smul_neg_one[F: Field, V: AddCommGroup](m: Module[F, V], v: V) {
    m.smul(-F.1, v) = -v
}

theorem vector_space_subspace_criterion[F: Field, V: AddCommGroup](
    m: Module[F, V], contains: V -> Bool
) {
    (exists(x: V) { contains(x) })
    and (forall(a: V, b: V) { contains(a) and contains(b) implies contains(a + b) })
    and (forall(r: F, a: V) { contains(a) implies contains(m.smul(r, a)) })
    implies is_submodule(m, contains)
}

theorem vector_space_span_is_subspace[F: Field, V: AddCommGroup](m: Module[F, V], a: Set[V]) {
    is_submodule(m, submodule_closure(m, a).contains)
}

define vector_space_singleton_independent[F: Field, V: AddCommGroup](
    m: Module[F, V], v: V
) -> Bool {
    forall(r: F) {
        m.smul(r, v) = V.0 implies r = F.0
    }
}

theorem vector_space_singleton_independent_of_ne_zero[F: Field, V: AddCommGroup](
    m: Module[F, V], v: V
) {
    v != V.0 implies vector_space_singleton_independent(m, v)
}

theorem vector_space_ne_zero_of_singleton_independent[F: Field, V: AddCommGroup](
    m: Module[F, V], v: V
) {
    vector_space_singleton_independent(m, v) implies v != V.0
}

theorem vector_space_singleton_independent_iff_ne_zero[F: Field, V: AddCommGroup](
    m: Module[F, V], v: V
) {
    vector_space_singleton_independent(m, v) iff v != V.0
}

theorem mul_opposite_val_one[M: One] {
    MulOpposite[M].one.val = M.1
}

theorem mul_opposite_one_right[M: Monoid](x: MulOpposite[M]) {
    x * MulOpposite[M].one = x
}

theorem mul_opposite_one_right_raw[M: Monoid] {
    forall(x: MulOpposite[M]) {
        Mul.mul(x, One.1[MulOpposite[M]]) = x
    }
}

theorem mul_opposite_one_left[M: Monoid](x: MulOpposite[M]) {
    MulOpposite[M].one * x = x
}

theorem mul_opposite_one_left_raw[M: Monoid] {
    forall(x: MulOpposite[M]) {
        Mul.mul(One.1[MulOpposite[M]], x) = x
    }
}

theorem mul_opposite_inverse_right[G: Group](x: MulOpposite[G]) {
    x * x.inverse = MulOpposite[G].one
}

theorem mul_opposite_inverse_right_raw[G: Group] {
    forall(x: MulOpposite[G]) {
        Mul.mul(x, x.inverse) = One.1[MulOpposite[G]]
    }
}

theorem pair_typeclass_one_eq_pair_one[A: One, B: One] {
    One.1[Pair[A, B]] = pair_one[A, B]
}

theorem pair_monoid_right_law[A: Monoid, B: Monoid](p: Pair[A, B]) {
    p * One.1[Pair[A, B]] = p
}

theorem pair_monoid_left_law[A: Monoid, B: Monoid](p: Pair[A, B]) {
    One.1[Pair[A, B]] * p = p
}

theorem pointwise_function_one_apply[T, A: One](t: T) {
    One.1[PointwiseFunction[T, A]].val(t) = A.1
}

theorem pointwise_function_mul_one_right[T, A: Monoid](f: PointwiseFunction[T, A]) {
    f * One.1[PointwiseFunction[T, A]] = f
}

theorem pointwise_function_mul_one_left[T, A: Monoid](f: PointwiseFunction[T, A]) {
    One.1[PointwiseFunction[T, A]] * f = f
}

theorem pointwise_function_monoid_right_law[T, A: Monoid](f: PointwiseFunction[T, A]) {
    Mul.mul(f, One.1[PointwiseFunction[T, A]]) = f
}

theorem pointwise_function_monoid_left_law[T, A: Monoid](f: PointwiseFunction[T, A]) {
    Mul.mul(One.1[PointwiseFunction[T, A]], f) = f
}

theorem pair_one_first[A: One, B: One] {
    pair_one[A, B].first = A.1
}

theorem pair_one_second[A: One, B: One] {
    pair_one[A, B].second = B.1
}

theorem pair_map_pair_one[A: One, B: One, C: One, D: One](f: A -> C, g: B -> D) {
    f(A.1) = C.1 and g(B.1) = D.1 implies
    pair_map(f, g, pair_one[A, B]) = pair_one[C, D]
}

theorem pair_swap_one[A: One, B: One] {
    pair_one[A, B].swap = pair_one[B, A]
}

define is_field_hom[F: Field, E: Field](f: F -> E) -> Bool {
    is_ring_hom(f)
}

structure FieldHom[F: Field, E: Field] {
    /// The mapping for the homomorphism.
    hom: F -> E
} constraint {
    is_field_hom(hom)
}

theorem field_hom_ext[F: Field, E: Field](f: FieldHom[F, E], g: FieldHom[F, E]) {
    (forall(a: F) { f.hom(a) = g.hom(a) }) implies f = g
}

attributes FieldHom[F: Field, E: Field] {
    /// Field homomorphism extensionality from pointwise equality of the homomorphism.
    let ext = field_hom_ext[F, E]
}

let field_hom_to_ring_hom[F: Field, E: Field](f: FieldHom[F, E]) -> result: RingHom[F, E] satisfy {
    RingHom.new(f.hom) = Option.some(result)
}

theorem field_hom_to_ring_hom_hom[F: Field, E: Field](f: FieldHom[F, E]) {
    field_hom_to_ring_hom(f).hom = f.hom
}

theorem field_hom_one[F: Field, E: Field](f: FieldHom[F, E]) {
    f.hom(F.1) = E.1
}

theorem field_hom_zero[F: Field, E: Field](f: FieldHom[F, E]) {
    f.hom(F.0) = E.0
}

theorem field_hom_add[F: Field, E: Field](f: FieldHom[F, E], a: F, b: F) {
    f.hom(a + b) = f.hom(a) + f.hom(b)
}

theorem field_hom_mul[F: Field, E: Field](f: FieldHom[F, E], a: F, b: F) {
    f.hom(a * b) = f.hom(a) * f.hom(b)
}

theorem field_hom_neg[F: Field, E: Field](f: FieldHom[F, E], a: F) {
    f.hom(-a) = -f.hom(a)
}

theorem field_hom_nonzero[F: Field, E: Field](f: FieldHom[F, E], a: F) {
    a != F.0 implies f.hom(a) != E.0
}

theorem field_hom_injective[F: Field, E: Field](f: FieldHom[F, E], a: F, b: F) {
    f.hom(a) = f.hom(b) implies a = b
}

theorem identity_fn_is_field_hom[F: Field] {
    is_field_hom(identity_fn[F])
}

theorem compose_is_field_hom[F: Field, E: Field, K: Field](f: E -> K, g: F -> E) {
    is_field_hom(f) and is_field_hom(g) implies is_field_hom(compose(f, g))
}

let identity_field_hom[F: Field]: FieldHom[F, F] satisfy {
    FieldHom.new(identity_fn[F]) = Option.some(identity_field_hom)
}

theorem identity_field_hom_hom[F: Field] {
    identity_field_hom[F].hom = identity_fn[F]
}

let compose_field_hom[F: Field, E: Field, K: Field](f: FieldHom[E, K], g: FieldHom[F, E]) -> result: FieldHom[F, K] satisfy {
    FieldHom.new(compose(f.hom, g.hom)) = Option.some(result)
}

theorem compose_field_hom_hom[F: Field, E: Field, K: Field](f: FieldHom[E, K], g: FieldHom[F, E]) {
    compose_field_hom(f, g).hom = compose(f.hom, g.hom)
}

theorem compose_field_hom_assoc[F: Field, E: Field, K: Field, L: Field](f: FieldHom[K, L], g: FieldHom[E, K], h: FieldHom[F, E]) {
    compose_field_hom(compose_field_hom(f, g), h) = compose_field_hom(f, compose_field_hom(g, h))
}

theorem compose_field_hom_identity_left[F: Field, E: Field](f: FieldHom[F, E]) {
    compose_field_hom(identity_field_hom[E], f) = f
}

theorem compose_field_hom_identity_right[F: Field, E: Field](f: FieldHom[F, E]) {
    compose_field_hom(f, identity_field_hom[F]) = f
}

theorem field_hom_inverse[F: Field, E: Field](f: FieldHom[F, E], a: F) {
    a != F.0 implies f.hom(a.inverse) = f.hom(a).inverse
}

theorem field_hom_eq_iff_sub_zero[F: Field, E: Field](f: FieldHom[F, E], a: F, b: F) {
    (f.hom(a) = f.hom(b)) = (f.hom(b - a) = E.0)
}

define is_trivial_field_hom_kernel[F: Field, E: Field](f: FieldHom[F, E]) -> Bool {
    forall(a: F) {
        f.hom(a) = E.0 implies a = F.0
    }
}

theorem field_hom_is_injective[F: Field, E: Field](f: FieldHom[F, E]) {
    is_injective_fn(f.hom)
}

theorem field_hom_has_trivial_kernel[F: Field, E: Field](f: FieldHom[F, E]) {
    is_trivial_field_hom_kernel(f)
}

theorem field_hom_injective_iff_trivial_kernel[F: Field, E: Field](f: FieldHom[F, E]) {
    is_injective_fn(f.hom) = is_trivial_field_hom_kernel(f)
}

