theorem pair_unit_mul_eq_zero_right_second[A: Ring, B: Ring](u: Pair[A, B], p: Pair[A, B]) {
    is_pair_unit(u) and pair_mul(p, u) = pair_zero[A, B] implies p.second = B.0
