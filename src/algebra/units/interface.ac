    e: Bijection[A, B],
    r: (B, B) -> Bool,
    s: (B, B) -> Bool
) {
    relation_subset(relation_pullback(e.map, r), relation_pullback(e.map, s)) = relation_subset(r, s)
}

theorem relation_pushforward_subset_iff_of_bijection_map[A, B](
