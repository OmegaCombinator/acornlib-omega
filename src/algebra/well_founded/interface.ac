theorem add_submonoid_is_finitely_generated_witness[M: AddMonoid](s: AddSubmonoid[M]) {
    add_submonoid_is_finitely_generated(s) implies exists(a: Set[M]) {
        a.is_finite and add_submonoid_closure(a) = s
