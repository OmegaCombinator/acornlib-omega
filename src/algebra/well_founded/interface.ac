}

theorem add_submonoid_closure_contains_eq[M: AddMonoid](a: Set[M], x: M) {
    add_submonoid_closure(a).contains(x) = add_submonoid_closure_contains(a, x)
}

theorem add_submonoid_subset_closure[M: AddMonoid](a: Set[M]) {
