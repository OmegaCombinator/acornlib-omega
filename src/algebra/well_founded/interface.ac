theorem full_add_submonoid_contains_eq[M: AddMonoid](m: M) {
    full_add_submonoid[M].contains(m) = true
}

theorem add_submonoid_subset_full[M: AddMonoid](s: AddSubmonoid[M]) {
    add_submonoid_subset(s, full_add_submonoid[M])
