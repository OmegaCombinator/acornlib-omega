theorem add_subgroup_eq_transport_predicate_rev[G: AddGroup](
    p: AddSubgroup[G] -> Bool,
    a: AddSubgroup[G],
    b: AddSubgroup[G]
) {
    a = b and p(b) implies p(a)
}

theorem zero_add_subgroup_constraint[G: AddGroup] {
