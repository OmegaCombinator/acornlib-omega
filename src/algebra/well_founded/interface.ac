theorem ideal_quotient_zero_projection_local[R: CommRing](i: Ideal[R]) {
    ideal_quotient_zero(i) = ideal_quotient_project(i, R.0)
}

theorem ideal_quotient_mk_type_pow[R: CommRing](i: Ideal[R], a: R, n: Nat) {
