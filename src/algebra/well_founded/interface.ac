        ideal_quotient_type_add(i, x, ideal_quotient_type_add(i, y, z))
}

theorem ideal_quotient_type_add_comm[R: CommRing](i: Ideal[R], x: IdealQuotient[R, i], y: IdealQuotient[R, i]) {
