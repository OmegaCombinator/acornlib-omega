define add_submonoid_zero_constraint[M: AddMonoid](contains: M -> Bool) -> Bool {
    contains(M.0)
}

define add_submonoid_closure_constraint[M: AddMonoid](contains: M -> Bool) -> Bool {
    forall(a: M, b: M) {
        contains(a) and contains(b) implies contains(a + b)
    }
}

define add_submonoid_constraint[M: AddMonoid](contains: M -> Bool) -> Bool {
    add_submonoid_zero_constraint(contains) and add_submonoid_closure_constraint(contains)
}

structure AddSubmonoid[M: AddMonoid] {
    /// True if the given element is a member of this additive submonoid.
    contains: M -> Bool
} constraint {
    add_submonoid_constraint(contains)
}

theorem add_submonoid_eq_transport_predicate[M: AddMonoid](
    p: AddSubmonoid[M] -> Bool,
    a: AddSubmonoid[M],
    b: AddSubmonoid[M]
) {
    a = b and p(a) implies p(b)
}

theorem add_submonoid_eq_transport_predicate_rev[M: AddMonoid](
    p: AddSubmonoid[M] -> Bool,
    a: AddSubmonoid[M],
    b: AddSubmonoid[M]
) {
    a = b and p(b) implies p(a)
}

define is_add_monoid_identity[M: AddMonoid](m: M) -> Bool {
    m = M.0
}

theorem zero_add_submonoid_constraint[M: AddMonoid] {
    add_submonoid_constraint(is_add_monoid_identity[M])
}

let zero_add_submonoid[M: AddMonoid]: AddSubmonoid[M] satisfy {
    AddSubmonoid.new(is_add_monoid_identity[M]) = Option.some(zero_add_submonoid)
}

define full_add_monoid_contains[M: AddMonoid](a: M) -> Bool {
    true
}

theorem full_add_submonoid_constraint[M: AddMonoid] {
    add_submonoid_constraint(full_add_monoid_contains[M])
}

let full_add_submonoid[M: AddMonoid]: AddSubmonoid[M] satisfy {
    AddSubmonoid.new(full_add_monoid_contains[M]) = Option.some(full_add_submonoid)
}

define add_zero_constraint[G: AddGroup](contains: G -> Bool) -> Bool {
    contains(G.0)
}

define add_closure_constraint[G: AddGroup](contains: G -> Bool) -> Bool {
    forall(a: G, b: G) {
        contains(a) and contains(b) implies contains(a + b)
    }
}

define is_add_identity[G: AddGroup](g: G) -> Bool {
    g = G.0
}

define full_add_group_contains[G: AddGroup](a: G) -> Bool {
    true
}

theorem gf4_add_zero_left(z: GF4) {
    Add.add(Zero.0[GF4], z) = z
}

theorem gf4_add_zero_right(z: GF4) {
    Add.add(z, Zero.0[GF4]) = z
}

theorem gf4_mul_zero_left(z: GF4) {
    Mul.mul(Zero.0[GF4], z) = Zero.0[GF4]
}

theorem gf4_mul_zero_right(z: GF4) {
    Mul.mul(z, Zero.0[GF4]) = Zero.0[GF4]
}

theorem gf4_add_comm_e0(z: GF4) {
    gf4_add(GF4.zero, z) = gf4_add(z, GF4.zero)
}

theorem gf4_mul_comm_e0(z: GF4) {
    gf4_mul(GF4.zero, z) = gf4_mul(z, GF4.zero)
}

theorem gf4_add_assoc_e0e0(z: GF4) {
    gf4_add(GF4.zero, gf4_add(GF4.zero, z)) = gf4_add(gf4_add(GF4.zero, GF4.zero), z)
}

theorem gf4_add_assoc_e0e2(z: GF4) {
    gf4_add(GF4.zero, gf4_add(GF4.x, z)) = gf4_add(gf4_add(GF4.zero, GF4.x), z)
}

theorem gf4_add_assoc_e0e3(z: GF4) {
    gf4_add(GF4.zero, gf4_add(GF4.x_plus_one, z)) = gf4_add(gf4_add(GF4.zero, GF4.x_plus_one), z)
}

theorem gf4_add_assoc_e2e0(z: GF4) {
    gf4_add(GF4.x, gf4_add(GF4.zero, z)) = gf4_add(gf4_add(GF4.x, GF4.zero), z)
}

theorem gf4_add_assoc_e3e0(z: GF4) {
    gf4_add(GF4.x_plus_one, gf4_add(GF4.zero, z)) = gf4_add(gf4_add(GF4.x_plus_one, GF4.zero), z)
}

theorem gf4_add_assoc_e0(y: GF4, z: GF4) {
    gf4_add(GF4.zero, gf4_add(y, z)) = gf4_add(gf4_add(GF4.zero, y), z)
}

theorem gf4_mul_assoc_e0e0(z: GF4) {
