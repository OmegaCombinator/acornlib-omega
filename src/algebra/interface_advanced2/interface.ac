) {
    add_subgroup_subset(a.intersection(b), b)
}

theorem add_subgroup_subset_intersection_of_subset_left_right[G: AddGroup](
    c: AddSubgroup[G],
    a: AddSubgroup[G],
    b: AddSubgroup[G]
