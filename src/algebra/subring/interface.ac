}

theorem add_monoid_algebra_single_zero[R: Semiring, M](m: M) {
    AddMonoidAlgebra[R, M].single(m, R.0) = AddMonoidAlgebra[R, M].zero
}

theorem add_monoid_algebra_single_eq_zero_iff[R: Semiring, M](m: M, r: R) {
    AddMonoidAlgebra[R, M].single(m, r) = AddMonoidAlgebra[R, M].zero = (r = R.0)
}

theorem add_monoid_algebra_single_eq_single_same_iff[R: Semiring, M](m: M, r: R, s: R) {
    AddMonoidAlgebra[R, M].single(m, r) = AddMonoidAlgebra[R, M].single(m, s) = (r = s)
}

theorem add_monoid_algebra_single_add_same_coeff_self[R: Semiring, M](m: M, r: R, s: R) {
    (AddMonoidAlgebra[R, M].single(m, r) + AddMonoidAlgebra[R, M].single(m, s)).coeff(m) = r + s
}

theorem add_monoid_algebra_single_add_same_coeff_of_ne[R: Semiring, M](m: M, r: R, s: R, n: M) {
    n != m implies
    (AddMonoidAlgebra[R, M].single(m, r) + AddMonoidAlgebra[R, M].single(m, s)).coeff(n) = R.0
}

theorem add_monoid_algebra_single_add_same[R: Semiring, M](m: M, r: R, s: R) {
    AddMonoidAlgebra[R, M].single(m, r) + AddMonoidAlgebra[R, M].single(m, s) =
        AddMonoidAlgebra[R, M].single(m, r + s)
}

theorem add_monoid_algebra_single_smul_coeff_self[R: Semiring, M](m: M, r: R, s: R) {
    AddMonoidAlgebra[R, M].single(m, r).smul(s).coeff(m) = s * r
}

theorem add_monoid_algebra_single_smul_coeff_of_ne[R: Semiring, M](m: M, r: R, s: R, n: M) {
    n != m implies AddMonoidAlgebra[R, M].single(m, r).smul(s).coeff(n) = R.0
}

theorem add_monoid_algebra_single_smul[R: Semiring, M](m: M, r: R, s: R) {
    AddMonoidAlgebra[R, M].single(m, r).smul(s) = AddMonoidAlgebra[R, M].single(m, s * r)
}

theorem add_monoid_algebra_single_neg_coeff_self[R: Ring, M](m: M, r: R) {
    AddMonoidAlgebra[R, M].single(m, r).neg.coeff(m) = -r
}

theorem add_monoid_algebra_single_neg_coeff_of_ne[R: Ring, M](m: M, r: R, n: M) {
    n != m implies AddMonoidAlgebra[R, M].single(m, r).neg.coeff(n) = R.0
}

theorem add_monoid_algebra_single_neg[R: Ring, M](m: M, r: R) {
    AddMonoidAlgebra[R, M].single(m, r).neg = AddMonoidAlgebra[R, M].single(m, -r)
}

theorem add_monoid_algebra_single_sub_same_coeff_self[R: Ring, M](m: M, r: R, s: R) {
    AddMonoidAlgebra[R, M].single(m, r).sub(AddMonoidAlgebra[R, M].single(m, s)).coeff(m) = r + -s
}

theorem add_monoid_algebra_single_sub_same_coeff_of_ne[R: Ring, M](m: M, r: R, s: R, n: M) {
    n != m implies AddMonoidAlgebra[R, M].single(m, r).sub(AddMonoidAlgebra[R, M].single(m, s)).coeff(n) = R.0
}

theorem add_monoid_algebra_single_sub_same[R: Ring, M](m: M, r: R, s: R) {
    AddMonoidAlgebra[R, M].single(m, r).sub(AddMonoidAlgebra[R, M].single(m, s)) =
        AddMonoidAlgebra[R, M].single(m, r + -s)
}

theorem finitely_supported_function_apply_zero_outside_support[T, A: AddCommGroup](
    f: FinitelySupportedFunction[T, A],
    t: T
) {
    not finitely_supported_function_support(f).contains(t) implies f.to_fun(t) = A.0
}

theorem finitely_supported_function_apply_zero_of_not_contains[T, A: AddCommGroup](
    f: FinitelySupportedFunction[T, A],
    s: FiniteSet[T],
    t: T
) {
    has_support_in(f.to_fun, s) and not s.contains(t) implies f.to_fun(t) = A.0
}

theorem finitely_supported_function_neg_apply[T, A: AddCommGroup](
    f: FinitelySupportedFunction[T, A],
    t: T
) {
    (-f).to_fun(t) = -f.to_fun(t)
}

theorem finitely_supported_function_neg_to_fun[T, A: AddCommGroup](
    f: FinitelySupportedFunction[T, A]
) {
    (-f).to_fun = pointwise_neg(f.to_fun)
}

theorem finitely_supported_function_sub_apply[T, A: AddCommGroup](
    f: FinitelySupportedFunction[T, A],
    g: FinitelySupportedFunction[T, A],
    t: T
) {
    f.sub(g).to_fun(t) = f.to_fun(t) + -g.to_fun(t)
}

theorem finitely_supported_function_sub_to_fun[T, A: AddCommGroup](
    f: FinitelySupportedFunction[T, A],
    g: FinitelySupportedFunction[T, A]
) {
    f.sub(g).to_fun = pointwise_add(f.to_fun, pointwise_neg(g.to_fun))
}

theorem finitely_supported_function_add_group_inverse_law[T, A: AddCommGroup](
    f: FinitelySupportedFunction[T, A]
) {
    Add.add(f, Neg.neg(f)) = Zero.0[FinitelySupportedFunction[T, A]]
}

theorem pair_typeclass_one_eq_pair_one[A: One, B: One] {
    One.1[Pair[A, B]] = pair_one[A, B]
}

theorem pair_typeclass_neg_eq_pair_neg[A: Neg, B: Neg](p: Pair[A, B]) {
    -p = pair_neg(p)
}

theorem pair_add_group_inverse_law[A: AddGroup, B: AddGroup](p: Pair[A, B]) {
    p + -p = Zero.0[Pair[A, B]]
}

theorem pair_add_group_instance_law[A: AddGroup, B: AddGroup](p: Pair[A, B]) {
    Add.add(p, Neg.neg(p)) = Zero.0[Pair[A, B]]
}

theorem pair_monoid_right_law[A: Monoid, B: Monoid](p: Pair[A, B]) {
    p * One.1[Pair[A, B]] = p
}

theorem pair_monoid_left_law[A: Monoid, B: Monoid](p: Pair[A, B]) {
    One.1[Pair[A, B]] * p = p
}

theorem pair_semiring_distrib_left_law[A: Semiring, B: Semiring](
    p: Pair[A, B],
    q: Pair[A, B],
    r: Pair[A, B]
) {
    p * (q + r) = (p * q) + (p * r)
}

theorem pair_semiring_distrib_right_law[A: Semiring, B: Semiring](
    p: Pair[A, B],
    q: Pair[A, B],
    r: Pair[A, B]
) {
    (p + q) * r = (p * r) + (q * r)
}

theorem pair_semiring_mul_zero_left_law[A: Semiring, B: Semiring](p: Pair[A, B]) {
    p * Zero.0[Pair[A, B]] = Zero.0[Pair[A, B]]
}

theorem pair_semiring_mul_zero_right_law[A: Semiring, B: Semiring](p: Pair[A, B]) {
    Zero.0[Pair[A, B]] * p = Zero.0[Pair[A, B]]
}

theorem pair_semiring_distrib_left_instance_law[A: Semiring, B: Semiring](
    p: Pair[A, B],
    q: Pair[A, B],
    r: Pair[A, B]
) {
    Mul.mul(p, Add.add(q, r)) = Add.add(Mul.mul(p, q), Mul.mul(p, r))
}

theorem pair_semiring_distrib_right_instance_law[A: Semiring, B: Semiring](
    p: Pair[A, B],
    q: Pair[A, B],
    r: Pair[A, B]
) {
    Mul.mul(Add.add(p, q), r) = Add.add(Mul.mul(p, r), Mul.mul(q, r))
}

define alternating_sign[R: Ring](n: Nat) -> R {
    match n {
        Nat.zero {
            R.1
        }
        Nat.suc(k) {
            -alternating_sign[R](k)
        }
    }
}

theorem alternating_sign_zero[R: Ring] {
    alternating_sign[R](Nat.0) = R.1
}

theorem alternating_sign_suc[R: Ring](n: Nat) {
    alternating_sign[R](n.suc) = -alternating_sign[R](n)
}

theorem alternating_sign_suc_mul[R: Ring](n: Nat) {
    alternating_sign[R](n.suc) = -R.1 * alternating_sign[R](n)
}

theorem alternating_sign_eq_neg_one_pow[R: Ring](n: Nat) {
    alternating_sign[R](n) = (-R.1).pow(n)
}

theorem alternating_sign_parity[R: Ring](n: Nat) {
    (Nat.2.divides(n) implies alternating_sign[R](n) = R.1) and
    (not Nat.2.divides(n) implies alternating_sign[R](n) = -R.1)
}

theorem geometric_sum[R: Ring](a: R, n: Nat) {
    (a + -R.1) * sum(map(n.range, a.pow)) = a.pow(n) + -R.1
}

theorem geometric_sum_sub_one[R: Ring](a: R, n: Nat) {
    (a - R.1) * sum(map(n.range, a.pow)) = a.pow(n) - R.1
}

theorem ring_neg_zero[R: Ring] {
    -R.0 = R.0
}

theorem ring_sub_self[R: Ring](a: R) {
    a - a = R.0
}

theorem ring_sub_zero[R: Ring](a: R) {
    a - R.0 = a
}

theorem ring_zero_sub[R: Ring](a: R) {
    R.0 - a = -a
}

theorem ring_sub_eq_zero_iff_eq[R: Ring](a: R, b: R) {
    (a - b = R.0) = (a = b)
}

theorem ring_neg_sub[R: Ring](a: R, b: R) {
    -(a - b) = b - a
}

theorem ring_sub_neg[R: Ring](a: R, b: R) {
    a - -b = a + b
}

theorem ring_sub_eq_neg_sub[R: Ring](a: R, b: R) {
    a - b = -(b - a)
}

theorem ring_neg_eq_zero_iff[R: Ring](a: R) {
    (-a = R.0) = (a = R.0)
}

theorem ring_neg_eq_neg_iff[R: Ring](a: R, b: R) {
    (-a = -b) = (a = b)
}

theorem ring_add_sub_assoc[R: Ring](a: R, b: R, c: R) {
    (a + b) - c = a + (b - c)
}

theorem ring_sub_add_cancel[R: Ring](a: R, b: R) {
    (a - b) + b = a
}

theorem ring_add_sub_cancel[R: Ring](a: R, b: R) {
    a + b - b = a
}

theorem ring_sub_sub[R: Ring](a: R, b: R, c: R) {
    a - (b - c) = a - b + c
}

theorem ring_add_eq_zero_iff_eq_neg[R: Ring](a: R, b: R) {
    (a + b = R.0) = (b = -a)
}

theorem ring_add_eq_zero_iff_eq_neg_left[R: Ring](a: R, b: R) {
    (a + b = R.0) = (a = -b)
}

theorem ring_neg_add_neg_neg[R: Ring](a: R, b: R) {
    -(-a + -b) = a + b
}

theorem ring_mul_sub_cancel_right[R: Ring](a: R, b: R, c: R) {
    a * (b - c) + a * c = a * b
}

theorem ring_sub_mul_cancel_right[R: Ring](a: R, b: R, c: R) {
    (a - b) * c + b * c = a * c
}

theorem ring_sub_eq_of_sub_eq[R: Ring](a: R, b: R, c: R) {
    a - b = c - b implies a = c
}

theorem ring_sub_eq_iff_sub[R: Ring](a: R, b: R, c: R) {
    (a - b = a - c) = (b = c)
}

theorem ring_pow_two[R: Ring](a: R) {
    a.pow(2) = a * a
}

theorem ring_pow_three[R: Ring](a: R) {
    a.pow(3) = a * a * a
}

theorem ring_neg_pow_two[R: Ring](a: R) {
    (-a).pow(2) = a.pow(2)
}

theorem ring_neg_one_pow_two[R: Ring] {
    (-R.1).pow(2) = R.1
}

theorem ring_foil[R: Ring](a: R, b: R, c: R, d: R) {
    (a + b) * (c + d) = a * c + a * d + b * c + b * d
}

theorem ring_pow_mul_comm[R: Ring](a: R, m: Nat, n: Nat) {
    a.pow(m) * a.pow(n) = a.pow(n) * a.pow(m)
}

theorem ring_sub_self_mul_left[R: Ring](a: R, b: R) {
    (a - a) * b = R.0
}

theorem ring_mul_sub_self_right[R: Ring](a: R, b: R) {
    a * (b - b) = R.0
}

theorem ring_double_square[R: Ring](a: R) {
    (a + a).pow(2) = a.pow(2) + a.pow(2) + a.pow(2) + a.pow(2)
}

theorem ring_two_mul_add[R: Ring](a: R, b: R) {
    (R.1 + R.1) * (a + b) = (R.1 + R.1) * a + (R.1 + R.1) * b
}

theorem ring_from_nat_two[R: Ring] {
    from_nat[R](2) = R.1 + R.1
}

theorem ring_two_mul_from_nat[R: Ring](a: R) {
    from_nat[R](2) * a = a + a
}

define is_nilpotent[R: Ring](a: R) -> Bool {
    exists(n: Nat) {
        n != Nat.0 and a.pow(n) = R.0
    }
}

theorem nilpotent_zero[R: Ring] {
    is_nilpotent[R](R.0)
}

theorem nilpotent_intro[R: Ring](a: R, n: Nat) {
    n != Nat.0 and a.pow(n) = R.0 implies is_nilpotent[R](a)
}

theorem nilpotent_apply[R: Ring](a: R) {
    is_nilpotent[R](a) implies exists(n: Nat) {
        n != Nat.0 and a.pow(n) = R.0
    }
}

theorem nilpotent_neg[R: CommRing](a: R) {
    is_nilpotent[R](a) implies is_nilpotent[R](-a)
}

theorem nilpotent_mul_left[R: CommRing](a: R, b: R) {
    is_nilpotent[R](a) implies is_nilpotent[R](a * b)
}

theorem nilpotent_mul_right[R: CommRing](a: R, b: R) {
    is_nilpotent[R](b) implies is_nilpotent[R](a * b)
}

theorem nilpotent_pow[R: Ring](a: R, k: Nat) {
    k != Nat.0 and is_nilpotent[R](a) implies is_nilpotent[R](a.pow(k))
}

let is_char_two[R: Ring] = forall(a: R) {
    a + a = R.0
}

theorem char_two_iff_one_plus_one_zero[R: Ring] {
    is_char_two[R] = (R.1 + R.1 = R.0)
}

theorem char_two_neg_eq_self[R: Ring](a: R) {
    is_char_two[R] implies -a = a
}

theorem char_two_sub_eq_add[R: Ring](a: R, b: R) {
    is_char_two[R] implies a - b = a + b
}

theorem ring_add_self_zero_iff_neg_eq_self[R: Ring](a: R) {
    (a + a = R.0) = (-a = a)
}

theorem ring_add_self_zero_iff_two_mul_zero[R: Ring](a: R) {
    (a + a = R.0) = ((R.1 + R.1) * a = R.0)
}

define is_semiring_hom[S: Semiring, T: Semiring](f: S -> T) -> Bool {
    is_add_monoid_hom(f) and is_monoid_hom(f)
}

structure SemiringHom[S: Semiring, T: Semiring] {
    /// The mapping for the homomorphism.
    hom: S -> T
} constraint {
    is_semiring_hom(hom)
}

theorem semiring_hom_ext[S: Semiring, T: Semiring](f: SemiringHom[S, T], g: SemiringHom[S, T]) {
    (forall(a: S) { f.hom(a) = g.hom(a) }) implies f = g
}

attributes SemiringHom[S: Semiring, T: Semiring] {
    /// Semiring homomorphism extensionality from pointwise equality of the homomorphism.
    let ext = semiring_hom_ext[S, T]
}

theorem semiring_hom_eq_hom[S: Semiring, T: Semiring](f: SemiringHom[S, T], g: SemiringHom[S, T]) {
    f = g implies f.hom = g.hom
}

theorem semiring_hom_eq_apply[S: Semiring, T: Semiring](f: SemiringHom[S, T], g: SemiringHom[S, T], a: S) {
    f = g implies f.hom(a) = g.hom(a)
}

theorem semiring_hom_eq_transport_predicate[S: Semiring, T: Semiring](
    p: SemiringHom[S, T] -> Bool,
    f: SemiringHom[S, T],
    g: SemiringHom[S, T]
) {
    f = g and p(f) implies p(g)
}

theorem semiring_hom_eq_transport_predicate_rev[S: Semiring, T: Semiring](
    p: SemiringHom[S, T] -> Bool,
    f: SemiringHom[S, T],
    g: SemiringHom[S, T]
) {
    f = g and p(g) implies p(f)
}

theorem semiring_hom_eq_of_hom_eq[S: Semiring, T: Semiring](f: SemiringHom[S, T], g: SemiringHom[S, T]) {
    f.hom = g.hom implies f = g
}

theorem semiring_hom_eq_of_apply_eq[S: Semiring, T: Semiring](f: SemiringHom[S, T], g: SemiringHom[S, T]) {
    (forall(a: S) { f.hom(a) = g.hom(a) }) implies f = g
}

theorem semiring_hom_zero[S: Semiring, T: Semiring](f: SemiringHom[S, T]) {
    f.hom(S.0) = T.0
}

theorem semiring_hom_one[S: Semiring, T: Semiring](f: SemiringHom[S, T]) {
    f.hom(S.1) = T.1
}

theorem semiring_hom_add[S: Semiring, T: Semiring](f: SemiringHom[S, T], a: S, b: S) {
    f.hom(a + b) = f.hom(a) + f.hom(b)
}

theorem semiring_hom_mul[S: Semiring, T: Semiring](f: SemiringHom[S, T], a: S, b: S) {
    f.hom(a * b) = f.hom(a) * f.hom(b)
}

theorem semiring_hom_pow[S: Semiring, T: Semiring](f: SemiringHom[S, T], a: S, n: Nat) {
    f.hom(a.pow(n)) = f.hom(a).pow(n)
}

theorem function_eq_transport_semiring_hom[S: Semiring, T: Semiring](f: S -> T, g: S -> T) {
    f = g and is_semiring_hom(f) implies is_semiring_hom(g)
}

theorem function_eq_transport_semiring_hom_rev[S: Semiring, T: Semiring](f: S -> T, g: S -> T) {
    f = g and is_semiring_hom(g) implies is_semiring_hom(f)
}

theorem identity_fn_is_semiring_hom[S: Semiring] {
    is_semiring_hom(identity_fn[S])
}

theorem compose_is_semiring_hom[S: Semiring, T: Semiring, U: Semiring](f: T -> U, g: S -> T) {
    is_semiring_hom(f) and is_semiring_hom(g) implies is_semiring_hom(compose(f, g))
}

let identity_semiring_hom[S: Semiring]: SemiringHom[S, S] satisfy {
    SemiringHom.new(identity_fn[S]) = Option.some(identity_semiring_hom)
}

theorem identity_semiring_hom_hom[S: Semiring] {
    identity_semiring_hom[S].hom = identity_fn[S]
}

let compose_semiring_hom[S: Semiring, T: Semiring, U: Semiring](f: SemiringHom[T, U], g: SemiringHom[S, T]) -> result: SemiringHom[S, U] satisfy {
    SemiringHom.new(compose(f.hom, g.hom)) = Option.some(result)
}

theorem compose_semiring_hom_hom[S: Semiring, T: Semiring, U: Semiring](f: SemiringHom[T, U], g: SemiringHom[S, T]) {
    compose_semiring_hom(f, g).hom = compose(f.hom, g.hom)
}

theorem compose_semiring_hom_assoc[S: Semiring, T: Semiring, U: Semiring, V: Semiring](
    f: SemiringHom[U, V], g: SemiringHom[T, U], h: SemiringHom[S, T]) {
    compose_semiring_hom(compose_semiring_hom(f, g), h) = compose_semiring_hom(f, compose_semiring_hom(g, h))
}

theorem compose_semiring_hom_identity_left[S: Semiring, T: Semiring](f: SemiringHom[S, T]) {
    compose_semiring_hom(identity_semiring_hom[T], f) = f
}

theorem compose_semiring_hom_identity_right[S: Semiring, T: Semiring](f: SemiringHom[S, T]) {
    compose_semiring_hom(f, identity_semiring_hom[S]) = f
}

define is_ring_hom[R: Ring, S: Ring](f: R -> S) -> Bool {
    f(R.1) = S.1 and forall(a: R, b: R) {
        f(a + b) = f(a) + f(b) and f(a * b) = f(a) * f(b)
    }
}

structure RingHom[R: Ring, S: Ring] {
    /// The mapping for the homomorphism.
    hom: R -> S
} constraint {
    is_ring_hom(hom)
}

theorem ring_hom_ext[R: Ring, S: Ring](f: RingHom[R, S], g: RingHom[R, S]) {
    (forall(a: R) { f.hom(a) = g.hom(a) }) implies f = g
}

attributes RingHom[R: Ring, S: Ring] {
    /// Ring homomorphism extensionality from pointwise equality of the homomorphism.
    let ext = ring_hom_ext[R, S]
}

theorem ring_hom_eq_hom[R: Ring, S: Ring](f: RingHom[R, S], g: RingHom[R, S]) {
    f = g implies f.hom = g.hom
}

theorem ring_hom_eq_apply[R: Ring, S: Ring](f: RingHom[R, S], g: RingHom[R, S], a: R) {
    f = g implies f.hom(a) = g.hom(a)
}

theorem ring_hom_eq_transport_predicate[R: Ring, S: Ring](
    p: RingHom[R, S] -> Bool,
    f: RingHom[R, S],
    g: RingHom[R, S]
) {
    f = g and p(f) implies p(g)
}

theorem ring_hom_eq_transport_predicate_rev[R: Ring, S: Ring](
    p: RingHom[R, S] -> Bool,
    f: RingHom[R, S],
    g: RingHom[R, S]
) {
    f = g and p(g) implies p(f)
}

theorem ring_hom_eq_of_hom_eq[R: Ring, S: Ring](f: RingHom[R, S], g: RingHom[R, S]) {
    f.hom = g.hom implies f = g
}

theorem ring_hom_eq_of_apply_eq[R: Ring, S: Ring](f: RingHom[R, S], g: RingHom[R, S]) {
    (forall(a: R) { f.hom(a) = g.hom(a) }) implies f = g
}

theorem ring_hom_one[R: Ring, S: Ring](f: RingHom[R, S]) {
    f.hom(R.1) = S.1
}

theorem ring_hom_add[R: Ring, S: Ring](f: RingHom[R, S], a: R, b: R) {
    f.hom(a + b) = f.hom(a) + f.hom(b)
}

theorem ring_hom_mul[R: Ring, S: Ring](f: RingHom[R, S], a: R, b: R) {
    f.hom(a * b) = f.hom(a) * f.hom(b)
}

theorem ring_hom_zero[R: Ring, S: Ring](f: RingHom[R, S]) {
    f.hom(R.0) = S.0
}

theorem ring_hom_neg[R: Ring, S: Ring](f: RingHom[R, S], a: R) {
    f.hom(-a) = -f.hom(a)
}

theorem ring_hom_is_add_group_hom[R: Ring, S: Ring](f: RingHom[R, S]) {
    is_add_group_hom(f.hom)
}

theorem ring_hom_is_monoid_hom[R: Ring, S: Ring](f: RingHom[R, S]) {
    is_monoid_hom(f.hom)
}

theorem ring_hom_is_semiring_hom[R: Ring, S: Ring](f: RingHom[R, S]) {
    is_semiring_hom(f.hom)
}

let ring_hom_to_add_group_hom[R: Ring, S: Ring](f: RingHom[R, S]) -> result: AddGroupHom[R, S] satisfy {
    AddGroupHom.new(f.hom) = Option.some(result)
}

theorem ring_hom_to_add_group_hom_hom[R: Ring, S: Ring](f: RingHom[R, S]) {
    ring_hom_to_add_group_hom(f).hom = f.hom
}

let ring_hom_to_monoid_hom[R: Ring, S: Ring](f: RingHom[R, S]) -> result: MonoidHom[R, S] satisfy {
    MonoidHom.new(f.hom) = Option.some(result)
}

theorem ring_hom_to_monoid_hom_hom[R: Ring, S: Ring](f: RingHom[R, S]) {
    ring_hom_to_monoid_hom(f).hom = f.hom
}

let ring_hom_to_semiring_hom[R: Ring, S: Ring](f: RingHom[R, S]) -> result: SemiringHom[R, S] satisfy {
    SemiringHom.new(f.hom) = Option.some(result)
}

theorem ring_hom_to_semiring_hom_hom[R: Ring, S: Ring](f: RingHom[R, S]) {
    ring_hom_to_semiring_hom(f).hom = f.hom
}

theorem add_group_hom_monoid_hom_is_ring_hom[R: Ring, S: Ring](f: AddGroupHom[R, S], g: MonoidHom[R, S]) {
    f.hom = g.hom implies is_ring_hom(f.hom)
}

theorem ring_hom_pow[R: Ring, S: Ring](f: RingHom[R, S], a: R, n: Nat) {
    f.hom(a.pow(n)) = f.hom(a).pow(n)
}

theorem function_eq_transport_ring_hom[R: Ring, S: Ring](f: R -> S, g: R -> S) {
    f = g and is_ring_hom(f) implies is_ring_hom(g)
}

theorem function_eq_transport_ring_hom_rev[R: Ring, S: Ring](f: R -> S, g: R -> S) {
    f = g and is_ring_hom(g) implies is_ring_hom(f)
}

theorem identity_fn_is_ring_hom[R: Ring] {
    is_ring_hom(identity_fn[R])
}

theorem compose_is_ring_hom[R: Ring, S: Ring, T: Ring](f: S -> T, g: R -> S) {
    is_ring_hom(f) and is_ring_hom(g) implies is_ring_hom(compose(f, g))
}

let identity_ring_hom[R: Ring]: RingHom[R, R] satisfy {
    RingHom.new(identity_fn[R]) = Option.some(identity_ring_hom)
}

theorem identity_ring_hom_hom[R: Ring] {
    identity_ring_hom[R].hom = identity_fn[R]
}

let compose_ring_hom[R: Ring, S: Ring, T: Ring](f: RingHom[S, T], g: RingHom[R, S]) -> result: RingHom[R, T] satisfy {
    RingHom.new(compose(f.hom, g.hom)) = Option.some(result)
}

theorem compose_ring_hom_hom[R: Ring, S: Ring, T: Ring](f: RingHom[S, T], g: RingHom[R, S]) {
    compose_ring_hom(f, g).hom = compose(f.hom, g.hom)
}

theorem compose_ring_hom_assoc[R: Ring, S: Ring, T: Ring, U: Ring](
    f: RingHom[T, U], g: RingHom[S, T], h: RingHom[R, S]) {
    compose_ring_hom(compose_ring_hom(f, g), h) = compose_ring_hom(f, compose_ring_hom(g, h))
}

theorem compose_ring_hom_identity_left[R: Ring, S: Ring](f: RingHom[R, S]) {
    compose_ring_hom(identity_ring_hom[S], f) = f
}

theorem compose_ring_hom_identity_right[R: Ring, S: Ring](f: RingHom[R, S]) {
    compose_ring_hom(f, identity_ring_hom[R]) = f
}

define is_field_hom[F: Field, E: Field](f: F -> E) -> Bool {
    is_ring_hom(f)
}

structure FieldHom[F: Field, E: Field] {
    /// The mapping for the homomorphism.
    hom: F -> E
} constraint {
    is_field_hom(hom)
}

theorem field_hom_ext[F: Field, E: Field](f: FieldHom[F, E], g: FieldHom[F, E]) {
    (forall(a: F) { f.hom(a) = g.hom(a) }) implies f = g
}

attributes FieldHom[F: Field, E: Field] {
    /// Field homomorphism extensionality from pointwise equality of the homomorphism.
    let ext = field_hom_ext[F, E]
}

let field_hom_to_ring_hom[F: Field, E: Field](f: FieldHom[F, E]) -> result: RingHom[F, E] satisfy {
    RingHom.new(f.hom) = Option.some(result)
}

theorem field_hom_to_ring_hom_hom[F: Field, E: Field](f: FieldHom[F, E]) {
    field_hom_to_ring_hom(f).hom = f.hom
}

theorem field_hom_one[F: Field, E: Field](f: FieldHom[F, E]) {
    f.hom(F.1) = E.1
}

theorem field_hom_zero[F: Field, E: Field](f: FieldHom[F, E]) {
    f.hom(F.0) = E.0
}

theorem field_hom_add[F: Field, E: Field](f: FieldHom[F, E], a: F, b: F) {
    f.hom(a + b) = f.hom(a) + f.hom(b)
}

theorem field_hom_mul[F: Field, E: Field](f: FieldHom[F, E], a: F, b: F) {
    f.hom(a * b) = f.hom(a) * f.hom(b)
}

theorem field_hom_neg[F: Field, E: Field](f: FieldHom[F, E], a: F) {
    f.hom(-a) = -f.hom(a)
}

theorem field_hom_nonzero[F: Field, E: Field](f: FieldHom[F, E], a: F) {
    a != F.0 implies f.hom(a) != E.0
}

theorem field_hom_injective[F: Field, E: Field](f: FieldHom[F, E], a: F, b: F) {
    f.hom(a) = f.hom(b) implies a = b
}

theorem identity_fn_is_field_hom[F: Field] {
    is_field_hom(identity_fn[F])
}

theorem compose_is_field_hom[F: Field, E: Field, K: Field](f: E -> K, g: F -> E) {
    is_field_hom(f) and is_field_hom(g) implies is_field_hom(compose(f, g))
}

let identity_field_hom[F: Field]: FieldHom[F, F] satisfy {
    FieldHom.new(identity_fn[F]) = Option.some(identity_field_hom)
}

theorem identity_field_hom_hom[F: Field] {
    identity_field_hom[F].hom = identity_fn[F]
}

let compose_field_hom[F: Field, E: Field, K: Field](f: FieldHom[E, K], g: FieldHom[F, E]) -> result: FieldHom[F, K] satisfy {
    FieldHom.new(compose(f.hom, g.hom)) = Option.some(result)
}

theorem compose_field_hom_hom[F: Field, E: Field, K: Field](f: FieldHom[E, K], g: FieldHom[F, E]) {
    compose_field_hom(f, g).hom = compose(f.hom, g.hom)
}

theorem compose_field_hom_assoc[F: Field, E: Field, K: Field, L: Field](f: FieldHom[K, L], g: FieldHom[E, K], h: FieldHom[F, E]) {
    compose_field_hom(compose_field_hom(f, g), h) = compose_field_hom(f, compose_field_hom(g, h))
}

theorem compose_field_hom_identity_left[F: Field, E: Field](f: FieldHom[F, E]) {
    compose_field_hom(identity_field_hom[E], f) = f
}

theorem compose_field_hom_identity_right[F: Field, E: Field](f: FieldHom[F, E]) {
    compose_field_hom(f, identity_field_hom[F]) = f
}

theorem field_hom_inverse[F: Field, E: Field](f: FieldHom[F, E], a: F) {
    a != F.0 implies f.hom(a.inverse) = f.hom(a).inverse
}

define is_trivial_group_hom_kernel[G: Group, H: Group](f: GroupHom[G, H]) -> Bool {
    forall(a: G) {
        f.hom(a) = H.1 implies a = G.1
    }
}

theorem group_hom_eq_iff_inv_mul_one[G: Group, H: Group](f: GroupHom[G, H], a: G, b: G) {
    (f.hom(a) = f.hom(b)) = (f.hom(a.inverse * b) = H.1)
}

theorem group_hom_injective_iff_trivial_kernel[G: Group, H: Group](f: GroupHom[G, H]) {
    is_injective_fn(f.hom) = is_trivial_group_hom_kernel(f)
}

theorem add_group_hom_eq_iff_sub_zero[A: AddGroup, B: AddGroup](f: AddGroupHom[A, B], a: A, b: A) {
    (f.hom(a) = f.hom(b)) = (f.hom(b - a) = B.0)
}

define is_trivial_ring_hom_kernel[R: Ring, S: Ring](f: RingHom[R, S]) -> Bool {
    forall(a: R) {
        f.hom(a) = S.0 implies a = R.0
    }
}

theorem ring_hom_eq_iff_sub_zero[R: Ring, S: Ring](f: RingHom[R, S], a: R, b: R) {
    (f.hom(a) = f.hom(b)) = (f.hom(b - a) = S.0)
}

theorem ring_hom_injective_iff_trivial_kernel[R: Ring, S: Ring](f: RingHom[R, S]) {
    is_injective_fn(f.hom) = is_trivial_ring_hom_kernel(f)
}

theorem field_hom_eq_iff_sub_zero[F: Field, E: Field](f: FieldHom[F, E], a: F, b: F) {
    (f.hom(a) = f.hom(b)) = (f.hom(b - a) = E.0)
}

define is_trivial_field_hom_kernel[F: Field, E: Field](f: FieldHom[F, E]) -> Bool {
    forall(a: F) {
        f.hom(a) = E.0 implies a = F.0
    }
}

theorem field_hom_is_injective[F: Field, E: Field](f: FieldHom[F, E]) {
    is_injective_fn(f.hom)
}

theorem field_hom_has_trivial_kernel[F: Field, E: Field](f: FieldHom[F, E]) {
    is_trivial_field_hom_kernel(f)
}

theorem field_hom_injective_iff_trivial_kernel[F: Field, E: Field](f: FieldHom[F, E]) {
    is_injective_fn(f.hom) = is_trivial_field_hom_kernel(f)
}

theorem is_ideal_unfold[R: CommRing](contains: R -> Bool) {
    is_ideal(contains) = (ideal_zero_constraint(contains) and ideal_add_constraint(contains) and ideal_absorb_constraint(contains))
}

theorem is_ideal_from_constraints[R: CommRing](contains: R -> Bool) {
    ideal_zero_constraint(contains) and ideal_add_constraint(contains) and ideal_absorb_constraint(contains)
        implies is_ideal(contains)
}

theorem is_ideal_zero[R: CommRing](contains: R -> Bool) {
    is_ideal(contains) implies contains(R.0)
}

theorem is_ideal_add[R: CommRing](contains: R -> Bool, a: R, b: R) {
    is_ideal(contains) and contains(a) and contains(b) implies contains(a + b)
}

theorem is_ideal_absorb[R: CommRing](contains: R -> Bool, r: R, a: R) {
    is_ideal(contains) and contains(a) implies contains(r * a)
}

theorem is_ideal_neg[R: CommRing](contains: R -> Bool, a: R) {
    is_ideal(contains) and contains(a) implies contains(-a)
}

define zero_ideal[R: CommRing](a: R) -> Bool {
    a = R.0
}

theorem zero_ideal_is_ideal[R: CommRing] {
    is_ideal(zero_ideal[R])
}

define unit_ideal[R: CommRing](a: R) -> Bool {
    true
}

theorem unit_ideal_is_ideal[R: CommRing] {
    is_ideal(unit_ideal[R])
}

theorem ideal_eq_unit_of_contains_one[R: CommRing](contains: R -> Bool) {
    is_ideal(contains) and contains(R.1) implies contains = unit_ideal[R]
}

theorem ideal_contains_one_iff_eq_unit[R: CommRing](contains: R -> Bool) {
    is_ideal(contains) implies (contains(R.1) = (contains = unit_ideal[R]))
}

define principal_ideal[R: CommRing](a: R, x: R) -> Bool {
    exists(r: R) {
        x = r * a
    }
}

theorem principal_ideal_is_ideal[R: CommRing](a: R) {
    is_ideal(principal_ideal[R](a))
}

theorem principal_ideal_contains_generator[R: CommRing](a: R) {
    principal_ideal(a, a)
}

theorem principal_ideal_contains_multiple[R: CommRing](a: R, r: R) {
    principal_ideal(a, r * a)
}

theorem principal_ideal_witness[R: CommRing](a: R, x: R) {
    principal_ideal(a, x) implies exists(r: R) { x = r * a }
}

theorem principal_ideal_zero_eq_zero_ideal[R: CommRing] {
    principal_ideal[R](R.0) = zero_ideal[R]
}

theorem principal_ideal_one_eq_unit_ideal[R: CommRing] {
    principal_ideal[R](R.1) = unit_ideal[R]
}

define ideal_subset[R: CommRing](contains_i: R -> Bool, contains_j: R -> Bool) -> Bool {
    forall(x: R) {
        contains_i(x) implies contains_j(x)
    }
}

theorem ideal_subset_refl[R: CommRing](contains: R -> Bool) {
    ideal_subset(contains, contains)
}

theorem ideal_subset_trans[R: CommRing](contains_i: R -> Bool,
                                        contains_j: R -> Bool,
                                        contains_k: R -> Bool) {
    ideal_subset(contains_i, contains_j) and ideal_subset(contains_j, contains_k)
        implies ideal_subset(contains_i, contains_k)
}

theorem ideal_subset_antisymm[R: CommRing](contains_i: R -> Bool,
                                           contains_j: R -> Bool) {
    ideal_subset(contains_i, contains_j) and ideal_subset(contains_j, contains_i)
        implies contains_i = contains_j
}

theorem ideal_eq_iff_subset_both[R: CommRing](contains_i: R -> Bool,
                                              contains_j: R -> Bool) {
    contains_i = contains_j = (ideal_subset(contains_i, contains_j) and ideal_subset(contains_j, contains_i))
}
