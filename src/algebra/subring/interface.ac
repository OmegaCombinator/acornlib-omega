theorem pointwise_pair_neg_is_finitely_supported[T, A: AddGroup, B: AddGroup](f: T -> Pair[A, B]) {
    is_pair_finitely_supported(f) implies is_pair_finitely_supported(pointwise_pair_neg(f))
