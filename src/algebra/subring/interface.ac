}

theorem add_monoid_algebra_zero_smul[R: Semiring, M](p: AddMonoidAlgebra[R, M]) {
    p.smul(R.0) = AddMonoidAlgebra[R, M].zero
}

theorem add_monoid_algebra_one_smul[R: Semiring, M](p: AddMonoidAlgebra[R, M]) {
