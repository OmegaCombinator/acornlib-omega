theorem pointwise_pair_add_is_finitely_supported_of_supports[T, A: AddMonoid, B: AddMonoid](
    f: T -> Pair[A, B],
    g: T -> Pair[A, B],
    s: FiniteSet[T],
    u: FiniteSet[T]
