        Set[R].new(self.contains)
    }

    /// The zero ideal.
    let zero = bundled_zero_ideal[R]

    /// The unit ideal.
    let unit = bundled_unit_ideal[R]

    /// The principal ideal generated by an element.
    let principal: R -> Ideal[R] = bundled_principal_ideal
}

