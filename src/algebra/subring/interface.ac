theorem monoid_hom_image_subset_iff_subset_preimage[M: Monoid, N: Monoid](
    f: MonoidHom[M, N],
    s: Set[M],
    t: Set[N]
) {
    monoid_hom_image(f, s).subset(t) = s.subset(monoid_hom_preimage(f, t))
}

theorem monoid_hom_image_compose[M: Monoid, N: Monoid, P: Monoid](
    f: MonoidHom[N, P],
    g: MonoidHom[M, N],
    s: Set[M]
) {
    monoid_hom_image(compose_monoid_hom(f, g), s) =
        monoid_hom_image(f, monoid_hom_image(g, s))
}

theorem monoid_hom_preimage_compose[M: Monoid, N: Monoid, P: Monoid](
    f: MonoidHom[N, P],
    g: MonoidHom[M, N],
    s: Set[P]
) {
    monoid_hom_preimage(compose_monoid_hom(f, g), s) =
        monoid_hom_preimage(g, monoid_hom_preimage(f, s))
}

theorem monoid_hom_image_preimage_closure_extensive[M: Monoid, N: Monoid](
    f: MonoidHom[M, N],
    s: Set[M]
) {
    s.subset(monoid_hom_image_preimage_closure(f, s))
}

theorem monoid_hom_image_preimage_closure_monotone[M: Monoid, N: Monoid](
    f: MonoidHom[M, N]
) {
    is_subset_monotone_map(monoid_hom_image_preimage_closure(f))
}

theorem monoid_hom_image_preimage_closure_idempotent[M: Monoid, N: Monoid](
    f: MonoidHom[M, N],
    s: Set[M]
) {
    monoid_hom_image_preimage_closure(f, monoid_hom_image_preimage_closure(f, s)) =
        monoid_hom_image_preimage_closure(f, s)
}

theorem monoid_hom_image_preimage_closure_operator[M: Monoid, N: Monoid](
    f: MonoidHom[M, N]
) {
    is_set_closure_operator(monoid_hom_image_preimage_closure(f))
}

theorem monoid_hom_preimage_image_kernel_reductive[M: Monoid, N: Monoid](
    f: MonoidHom[M, N],
    s: Set[N]
) {
    monoid_hom_preimage_image_kernel(f, s).subset(s)
}

theorem monoid_hom_preimage_image_kernel_monotone[M: Monoid, N: Monoid](
    f: MonoidHom[M, N]
) {
    is_subset_monotone_map(monoid_hom_preimage_image_kernel(f))
}

theorem monoid_hom_preimage_image_kernel_idempotent[M: Monoid, N: Monoid](
    f: MonoidHom[M, N],
    s: Set[N]
) {
    monoid_hom_preimage_image_kernel(f, monoid_hom_preimage_image_kernel(f, s)) =
        monoid_hom_preimage_image_kernel(f, s)
}

theorem monoid_hom_preimage_image_kernel_operator[M: Monoid, N: Monoid](
    f: MonoidHom[M, N]
) {
    is_set_kernel_operator(monoid_hom_preimage_image_kernel(f))
}

theorem monoid_pow_suc_left[M: Monoid](a: M, n: Nat) {
    a.pow(n.suc) = a * a.pow(n)
}

theorem monoid_pow_suc_right[M: Monoid](a: M, n: Nat) {
    a.pow(n.suc) = a.pow(n) * a
}

theorem monoid_pow_comm[M: Monoid](a: M, m: Nat, n: Nat) {
    a.pow(m) * a.pow(n) = a.pow(n) * a.pow(m)
}

theorem monoid_pow_comm_self[M: Monoid](a: M, n: Nat) {
    a * a.pow(n) = a.pow(n) * a
}

theorem monoid_pow_pow_comm[M: Monoid](a: M, m: Nat, n: Nat) {
    a.pow(m).pow(n) = a.pow(n).pow(m)
}

theorem group_idempotent_is_identity[G: Group](a: G) {
    is_idempotent_elem(a) implies a = G.1
}

theorem comm_monoid_pow_mul[M: CommMonoid](a: M, b: M, n: Nat) {
    (a * b).pow(n) = a.pow(n) * b.pow(n)
}

theorem monoid_comm_pow_right[M: Monoid](a: M, b: M, n: Nat) {
    a * b = b * a implies a * b.pow(n) = b.pow(n) * a
}

theorem monoid_comm_pow_add_step[M: Monoid](a: M, b: M, k: Nat) {
    a * b = b * a and (a * b).pow(k) = a.pow(k) * b.pow(k)
        implies (a * b).pow(k.suc) = a.pow(k.suc) * b.pow(k.suc)
}

theorem monoid_comm_pow_add[M: Monoid](a: M, b: M, n: Nat) {
    a * b = b * a implies (a * b).pow(n) = a.pow(n) * b.pow(n)
}

theorem opposite_mul_one_right[M: Monoid](a: M) {
    opposite_mul(a, M.1) = a
}

theorem opposite_mul_one_left[M: Monoid](a: M) {
    opposite_mul(M.1, a) = a
}

theorem opposite_mul_inverse_right[G: Group](a: G) {
    opposite_mul(a, a.inverse) = G.1
}

theorem opposite_mul_inverse_left[G: Group](a: G) {
    opposite_mul(a.inverse, a) = G.1
}

theorem inverse_opposite_mul[G: Group](a: G, b: G) {
    opposite_mul(a, b).inverse = opposite_mul(b.inverse, a.inverse)
}

theorem inverse_mul_eq_opposite_inverse_mul[G: Group](a: G, b: G) {
    (a * b).inverse = opposite_mul(a.inverse, b.inverse)
}

theorem opposite_mul_zero_right[R: Semiring](a: R) {
    opposite_mul(a, R.0) = R.0
}

theorem opposite_mul_zero_left[R: Semiring](a: R) {
    opposite_mul(R.0, a) = R.0
}

theorem opposite_mul_add_distrib_left[R: Semiring](a: R, b: R, c: R) {
    opposite_mul(a, b + c) = opposite_mul(a, b) + opposite_mul(a, c)
}

theorem opposite_mul_add_distrib_right[R: Semiring](a: R, b: R, c: R) {
    opposite_mul(a + b, c) = opposite_mul(a, c) + opposite_mul(b, c)
}

theorem opposite_mul_add_left_via_map[A: Semiring, B: Semiring](f: A -> B, a: A, b: A, c: A) {
    (forall(x: A, y: A) { f(x + y) = f(x) + f(y) }) and
    (forall(x: A, y: A) { f(x * y) = f(x) * f(y) }) implies
    f(opposite_mul(a, b + c)) = opposite_mul(f(a), f(b)) + opposite_mul(f(a), f(c))
}

theorem mul_opposite_val_one[M: One] {
    MulOpposite[M].one.val = M.1
}

theorem mul_opposite_one_right[M: Monoid](x: MulOpposite[M]) {
    x * MulOpposite[M].one = x
}

theorem mul_opposite_one_right_raw[M: Monoid] {
    forall(x: MulOpposite[M]) {
        Mul.mul(x, One.1[MulOpposite[M]]) = x
    }
}

theorem mul_opposite_one_left[M: Monoid](x: MulOpposite[M]) {
    MulOpposite[M].one * x = x
}

theorem mul_opposite_one_left_raw[M: Monoid] {
    forall(x: MulOpposite[M]) {
        Mul.mul(One.1[MulOpposite[M]], x) = x
    }
}

theorem mul_opposite_val_inverse[G: Group](x: MulOpposite[G]) {
    x.inverse.val = x.val.inverse
}

theorem mul_opposite_inverse_right[G: Group](x: MulOpposite[G]) {
    x * x.inverse = MulOpposite[G].one
}

theorem mul_opposite_inverse_right_raw[G: Group] {
    forall(x: MulOpposite[G]) {
        Mul.mul(x, x.inverse) = One.1[MulOpposite[G]]
    }
}

define pointwise_function_neg[T, A: Neg](f: PointwiseFunction[T, A]) -> PointwiseFunction[T, A] {
    PointwiseFunction.new(pointwise_neg(f.val))
}

attributes PointwiseFunction[T, A: Neg] {
    /// Pointwise additive inverse of a wrapped function.
    define neg(self) -> PointwiseFunction[T, A] {
        pointwise_function_neg(self)
    }
}

theorem pointwise_function_neg_apply[T, A: Neg](f: PointwiseFunction[T, A], t: T) {
    (-f).val(t) = -f.val(t)
}

theorem pointwise_function_one_apply[T, A: One](t: T) {
    One.1[PointwiseFunction[T, A]].val(t) = A.1
}

theorem pointwise_function_add_neg_right[T, A: AddGroup](f: PointwiseFunction[T, A]) {
    f + -f = Zero.0[PointwiseFunction[T, A]]
}

theorem pointwise_function_add_neg_left[T, A: AddGroup](f: PointwiseFunction[T, A]) {
    -f + f = Zero.0[PointwiseFunction[T, A]]
}

theorem pointwise_function_mul_one_right[T, A: Monoid](f: PointwiseFunction[T, A]) {
    f * One.1[PointwiseFunction[T, A]] = f
}

theorem pointwise_function_mul_one_left[T, A: Monoid](f: PointwiseFunction[T, A]) {
    One.1[PointwiseFunction[T, A]] * f = f
}

theorem pointwise_function_mul_add_left[T, A: Semiring](
    f: PointwiseFunction[T, A],
    g: PointwiseFunction[T, A],
    h: PointwiseFunction[T, A]
) {
    f * (g + h) = (f * g) + (f * h)
}

theorem pointwise_function_mul_add_right[T, A: Semiring](
    f: PointwiseFunction[T, A],
    g: PointwiseFunction[T, A],
    h: PointwiseFunction[T, A]
) {
    (f + g) * h = (f * h) + (g * h)
}

theorem pointwise_function_mul_zero_right[T, A: Semiring](f: PointwiseFunction[T, A]) {
    f * Zero.0[PointwiseFunction[T, A]] = Zero.0[PointwiseFunction[T, A]]
}

theorem pointwise_function_mul_zero_left[T, A: Semiring](f: PointwiseFunction[T, A]) {
    Zero.0[PointwiseFunction[T, A]] * f = Zero.0[PointwiseFunction[T, A]]
}

theorem pointwise_function_monoid_right_law[T, A: Monoid](f: PointwiseFunction[T, A]) {
    Mul.mul(f, One.1[PointwiseFunction[T, A]]) = f
}

theorem pointwise_function_monoid_left_law[T, A: Monoid](f: PointwiseFunction[T, A]) {
    Mul.mul(One.1[PointwiseFunction[T, A]], f) = f
}

theorem pointwise_function_semiring_distrib_left_law[T, A: Semiring](
    f: PointwiseFunction[T, A],
    g: PointwiseFunction[T, A],
    h: PointwiseFunction[T, A]
) {
    Mul.mul(f, Add.add(g, h)) = Add.add(Mul.mul(f, g), Mul.mul(f, h))
}

theorem pointwise_function_semiring_distrib_right_law[T, A: Semiring](
    f: PointwiseFunction[T, A],
    g: PointwiseFunction[T, A],
    h: PointwiseFunction[T, A]
) {
    Mul.mul(Add.add(f, g), h) = Add.add(Mul.mul(f, h), Mul.mul(g, h))
}

theorem pointwise_function_semiring_mul_zero_right_law[T, A: Semiring](f: PointwiseFunction[T, A]) {
    Mul.mul(f, Zero.0[PointwiseFunction[T, A]]) = Zero.0[PointwiseFunction[T, A]]
}

theorem pointwise_function_semiring_mul_zero_left_law[T, A: Semiring](f: PointwiseFunction[T, A]) {
    Mul.mul(Zero.0[PointwiseFunction[T, A]], f) = Zero.0[PointwiseFunction[T, A]]
}

define pair_neg[A: Neg, B: Neg](p: Pair[A, B]) -> Pair[A, B] {
    Pair.new(-p.first, -p.second)
}

attributes Pair[A: Neg, B: Neg] {
    define neg(self) -> Pair[A, B] {
        pair_neg(self)
    }
}

instance PointwiseFunction[T, A: Neg]: Neg {
    let neg = PointwiseFunction[T, A].neg
}

instance FinitelySupportedFunction[T, A: AddCommGroup]: Neg {
    let neg = FinitelySupportedFunction[T, A].neg
}

instance Pair[A: Neg, B: Neg]: Neg {
    let neg = Pair[A, B].neg
}

instance IdealQuotient[R: CommRing, i: Ideal[R]]: Neg {
    let neg = IdealQuotient[R, i].neg
}

theorem add_subgroup_rel_respects_neg[G: AddCommGroup](h: AddSubgroup[G]) {
    respects_unary_op(add_subgroup_rel(h), G.neg)
}

theorem add_subgroup_quotient_relation_respects_neg[G: AddCommGroup](h: AddSubgroup[G]) {
    quotient_unary_respects(add_subgroup_quotient_relation(h), G.neg)
}

define add_subgroup_quotient_neg[G: AddCommGroup](h: AddSubgroup[G]) ->
    QuotientOver[G] -> QuotientOver[G] {
    quotient_over_unary_op(add_subgroup_quotient_relation(h), G.neg)
}

theorem add_subgroup_quotient_neg_projection[G: AddCommGroup](h: AddSubgroup[G], a: G) {
    add_subgroup_quotient_neg(h, quotient_over_mk(add_subgroup_quotient_relation(h), a)) =
        quotient_over_mk(add_subgroup_quotient_relation(h), -a)
}

theorem add_subgroup_quotient_neg_projection_compatible[G: AddCommGroup](h: AddSubgroup[G], a: G, b: G) {
    add_subgroup_rel(h, a, b) implies
    add_subgroup_quotient_neg(h, quotient_over_mk(add_subgroup_quotient_relation(h), a)) =
        add_subgroup_quotient_neg(h, quotient_over_mk(add_subgroup_quotient_relation(h), b))
}

theorem add_subgroup_quotient_neg_add[G: AddCommGroup](h: AddSubgroup[G], a: G) {
    add_subgroup_quotient_add(h,
        add_subgroup_quotient_neg(h, quotient_over_mk(add_subgroup_quotient_relation(h), a)),
        quotient_over_mk(add_subgroup_quotient_relation(h), a)) =
        quotient_over_mk(add_subgroup_quotient_relation(h), G.0)
}

theorem add_subgroup_quotient_add_neg[G: AddCommGroup](h: AddSubgroup[G], a: G) {
    add_subgroup_quotient_add(h,
        quotient_over_mk(add_subgroup_quotient_relation(h), a),
        add_subgroup_quotient_neg(h, quotient_over_mk(add_subgroup_quotient_relation(h), a))) =
        quotient_over_mk(add_subgroup_quotient_relation(h), G.0)
}

theorem gf4_add_neg_right(z: GF4) {
    Add.add(z, Neg.neg(z)) = Zero.0[GF4]
}

define submodule_quotient_neg[R: Ring, M: AddCommGroup](s: Submodule[R, M]) ->
    QuotientOver[M] -> QuotientOver[M] {
    add_subgroup_quotient_neg(submodule_to_add_subgroup(s))
}

theorem submodule_quotient_neg_projection[R: Ring, M: AddCommGroup](s: Submodule[R, M], a: M) {
    submodule_quotient_neg(s,
        quotient_over_mk(submodule_quotient_relation(s), a)
    ) = quotient_over_mk(submodule_quotient_relation(s), -a)
}

theorem submodule_quotient_mk_neg[R: Ring, M: AddCommGroup](
    s: Submodule[R, M], a: M
) {
    submodule_quotient_mk(s)(-a) = submodule_quotient_neg(s, submodule_quotient_mk(s)(a))
}

theorem pointwise_function_add_group_inverse_law[T, A: AddGroup](f: PointwiseFunction[T, A]) {
    Add.add(f, Neg.neg(f)) = Zero.0[PointwiseFunction[T, A]]
}

define pair_inverse[A: Group, B: Group](p: Pair[A, B]) -> Pair[A, B] {
    Pair.new(p.first.inverse, p.second.inverse)
}

theorem pair_one_first[A: One, B: One] {
    pair_one[A, B].first = A.1
}

theorem pair_one_second[A: One, B: One] {
    pair_one[A, B].second = B.1
}

theorem pair_neg_first[A: Neg, B: Neg](p: Pair[A, B]) {
    pair_neg(p).first = -p.first
}

theorem pair_neg_second[A: Neg, B: Neg](p: Pair[A, B]) {
    pair_neg(p).second = -p.second
}

theorem pair_inverse_first[A: Group, B: Group](p: Pair[A, B]) {
    pair_inverse(p).first = p.first.inverse
}

theorem pair_inverse_second[A: Group, B: Group](p: Pair[A, B]) {
    pair_inverse(p).second = p.second.inverse
}

theorem pair_add_neg_right[A: AddGroup, B: AddGroup](p: Pair[A, B]) {
    pair_add(p, pair_neg(p)) = pair_zero[A, B]
}

theorem pair_add_neg_left[A: AddGroup, B: AddGroup](p: Pair[A, B]) {
    pair_add(pair_neg(p), p) = pair_zero[A, B]
}

theorem pair_mul_one_right[A: Monoid, B: Monoid](p: Pair[A, B]) {
    pair_mul(p, pair_one[A, B]) = p
}

theorem pair_mul_one_left[A: Monoid, B: Monoid](p: Pair[A, B]) {
    pair_mul(pair_one[A, B], p) = p
}

theorem pair_mul_inverse_right[A: Group, B: Group](p: Pair[A, B]) {
    pair_mul(p, pair_inverse[A, B](p)) = pair_one[A, B]
}

theorem pair_mul_inverse_left[A: Group, B: Group](p: Pair[A, B]) {
    pair_mul(pair_inverse[A, B](p), p) = pair_one[A, B]
}

theorem pair_map_pair_one[A: One, B: One, C: One, D: One](f: A -> C, g: B -> D) {
    f(A.1) = C.1 and g(B.1) = D.1 implies
    pair_map(f, g, pair_one[A, B]) = pair_one[C, D]
}

theorem pair_mul_add_distrib_left[A: Semiring, B: Semiring](
    p: Pair[A, B],
    q: Pair[A, B],
    r: Pair[A, B]
) {
    pair_mul(p, pair_add(q, r)) = pair_add(pair_mul(p, q), pair_mul(p, r))
}

theorem pair_mul_add_distrib_right[A: Semiring, B: Semiring](
    p: Pair[A, B],
    q: Pair[A, B],
    r: Pair[A, B]
) {
    pair_mul(pair_add(p, q), r) = pair_add(pair_mul(p, r), pair_mul(q, r))
}

theorem pair_mul_zero_right[A: Semiring, B: Semiring](p: Pair[A, B]) {
    pair_mul(p, pair_zero[A, B]) = pair_zero[A, B]
}

theorem pair_mul_zero_left[A: Semiring, B: Semiring](p: Pair[A, B]) {
    pair_mul(pair_zero[A, B], p) = pair_zero[A, B]
}

theorem pair_inverse_inverse[A: Group, B: Group](p: Pair[A, B]) {
    pair_inverse[A, B](pair_inverse[A, B](p)) = p
}

theorem pair_inverse_mul[A: Group, B: Group](p: Pair[A, B], q: Pair[A, B]) {
    pair_inverse[A, B](pair_mul(p, q)) = pair_mul(pair_inverse[A, B](q), pair_inverse[A, B](p))
}

theorem pair_swap_one[A: One, B: One] {
    pair_one[A, B].swap = pair_one[B, A]
}

theorem pair_swap_neg[A: Neg, B: Neg](p: Pair[A, B]) {
    pair_neg(p).swap = pair_neg(p.swap)
}

theorem pair_swap_inverse[A: Group, B: Group](p: Pair[A, B]) {
    pair_inverse[A, B](p).swap = pair_inverse[B, A](p.swap)
}

let function_pair_one[T, A: One, B: One]: Pair[T -> A, T -> B] =
    Pair.new(pointwise_one[T, A], pointwise_one[T, B])

define function_pair_neg[T, A: Neg, B: Neg](
    p: Pair[T -> A, T -> B]
) -> Pair[T -> A, T -> B] {
    Pair.new(pointwise_neg(p.first), pointwise_neg(p.second))
}

define function_pair_inverse[T, A: Group, B: Group](
    p: Pair[T -> A, T -> B]
) -> Pair[T -> A, T -> B] {
    Pair.new(pointwise_inverse(p.first), pointwise_inverse(p.second))
}

theorem function_pair_one_first[T, A: One, B: One] {
    function_pair_one[T, A, B].first = pointwise_one[T, A]
}

theorem function_pair_one_second[T, A: One, B: One] {
    function_pair_one[T, A, B].second = pointwise_one[T, B]
}

theorem function_pair_neg_first[T, A: Neg, B: Neg](p: Pair[T -> A, T -> B]) {
    function_pair_neg(p).first = pointwise_neg(p.first)
}

theorem function_pair_neg_second[T, A: Neg, B: Neg](p: Pair[T -> A, T -> B]) {
    function_pair_neg(p).second = pointwise_neg(p.second)
}

theorem function_pair_inverse_first[T, A: Group, B: Group](p: Pair[T -> A, T -> B]) {
    function_pair_inverse(p).first = pointwise_inverse(p.first)
}

theorem function_pair_inverse_second[T, A: Group, B: Group](p: Pair[T -> A, T -> B]) {
    function_pair_inverse(p).second = pointwise_inverse(p.second)
}

theorem function_pair_one_apply[T, A: One, B: One](t: T) {
    function_pair_apply(function_pair_one[T, A, B], t) = pair_one[A, B]
}

theorem function_pair_neg_apply[T, A: Neg, B: Neg](p: Pair[T -> A, T -> B], t: T) {
    function_pair_apply(function_pair_neg(p), t) = pair_neg(function_pair_apply(p, t))
}

theorem function_pair_inverse_apply[T, A: Group, B: Group](p: Pair[T -> A, T -> B], t: T) {
    function_pair_apply(function_pair_inverse(p), t) = pair_inverse(function_pair_apply(p, t))
}

theorem function_pair_add_neg_right[T, A: AddGroup, B: AddGroup](
    p: Pair[T -> A, T -> B]
) {
    function_pair_add(p, function_pair_neg(p)) = function_pair_zero[T, A, B]
}

theorem function_pair_add_neg_left[T, A: AddGroup, B: AddGroup](
    p: Pair[T -> A, T -> B]
) {
    function_pair_add(function_pair_neg(p), p) = function_pair_zero[T, A, B]
}

theorem function_pair_mul_one_right[T, A: Monoid, B: Monoid](
    p: Pair[T -> A, T -> B]
) {
    function_pair_mul(p, function_pair_one[T, A, B]) = p
}

theorem function_pair_mul_one_left[T, A: Monoid, B: Monoid](
    p: Pair[T -> A, T -> B]
) {
    function_pair_mul(function_pair_one[T, A, B], p) = p
}

theorem function_pair_mul_inverse_right[T, A: Group, B: Group](
    p: Pair[T -> A, T -> B]
) {
    function_pair_mul(p, function_pair_inverse(p)) = function_pair_one[T, A, B]
}

theorem function_pair_mul_inverse_left[T, A: Group, B: Group](
    p: Pair[T -> A, T -> B]
) {
    function_pair_mul(function_pair_inverse(p), p) = function_pair_one[T, A, B]
}

theorem function_pair_mul_distrib_left[T, A: Semiring, B: Semiring](
    p: Pair[T -> A, T -> B],
    q: Pair[T -> A, T -> B],
    r: Pair[T -> A, T -> B]
) {
    function_pair_mul(p, function_pair_add(q, r)) =
    function_pair_add(function_pair_mul(p, q), function_pair_mul(p, r))
}

theorem function_pair_mul_distrib_right[T, A: Semiring, B: Semiring](
    p: Pair[T -> A, T -> B],
    q: Pair[T -> A, T -> B],
    r: Pair[T -> A, T -> B]
) {
    function_pair_mul(function_pair_add(p, q), r) =
    function_pair_add(function_pair_mul(p, r), function_pair_mul(q, r))
}

theorem function_pair_mul_zero_right[T, A: Semiring, B: Semiring](
    p: Pair[T -> A, T -> B]
) {
    function_pair_mul(p, function_pair_zero[T, A, B]) = function_pair_zero[T, A, B]
}

theorem function_pair_mul_zero_left[T, A: Semiring, B: Semiring](
