theorem pointwise_function_mul_associative[T, A: Semigroup](
    f: PointwiseFunction[T, A],
    g: PointwiseFunction[T, A],
    h: PointwiseFunction[T, A]
) {
    f * (g * h) = (f * g) * h
}

theorem pointwise_function_mul_commutative[T, A: CommSemigroup](
    f: PointwiseFunction[T, A],
    g: PointwiseFunction[T, A]
) {
    f * g = g * f
}

theorem pointwise_function_mul_add_left[T, A: Semiring](
    f: PointwiseFunction[T, A],
    g: PointwiseFunction[T, A],
    h: PointwiseFunction[T, A]
) {
    f * (g + h) = (f * g) + (f * h)
}

theorem pointwise_function_mul_add_right[T, A: Semiring](
    f: PointwiseFunction[T, A],
    g: PointwiseFunction[T, A],
    h: PointwiseFunction[T, A]
) {
    (f + g) * h = (f * h) + (g * h)
}

theorem pointwise_function_add_semigroup_law[T, A: AddSemigroup](
    f: PointwiseFunction[T, A],
    g: PointwiseFunction[T, A],
    h: PointwiseFunction[T, A]
) {
    Add.add(f, Add.add(g, h)) = Add.add(Add.add(f, g), h)
}

theorem pointwise_function_add_comm_semigroup_law[T, A: AddCommSemigroup](
    f: PointwiseFunction[T, A],
    g: PointwiseFunction[T, A]
) {
    Add.add(f, g) = Add.add(g, f)
}

theorem pointwise_function_semigroup_law[T, A: Semigroup](
    f: PointwiseFunction[T, A],
    g: PointwiseFunction[T, A],
    h: PointwiseFunction[T, A]
) {
    Mul.mul(f, Mul.mul(g, h)) = Mul.mul(Mul.mul(f, g), h)
}

theorem pointwise_function_comm_semigroup_law[T, A: CommSemigroup](
    f: PointwiseFunction[T, A],
    g: PointwiseFunction[T, A]
) {
    Mul.mul(f, g) = Mul.mul(g, f)
}

theorem pointwise_function_semiring_distrib_left_law[T, A: Semiring](
    f: PointwiseFunction[T, A],
    g: PointwiseFunction[T, A],
    h: PointwiseFunction[T, A]
) {
    Mul.mul(f, Add.add(g, h)) = Add.add(Mul.mul(f, g), Mul.mul(f, h))
}

theorem pointwise_function_semiring_distrib_right_law[T, A: Semiring](
    f: PointwiseFunction[T, A],
    g: PointwiseFunction[T, A],
    h: PointwiseFunction[T, A]
) {
    Mul.mul(Add.add(f, g), h) = Add.add(Mul.mul(f, h), Mul.mul(g, h))
}

define pair_neg[A: Neg, B: Neg](p: Pair[A, B]) -> Pair[A, B] {
    Pair.new(-p.first, -p.second)
}

attributes Pair[A: Neg, B: Neg] {
    define neg(self) -> Pair[A, B] {
        pair_neg(self)
    }
}

instance Pair[A: Neg, B: Neg]: Neg {
    let neg = Pair[A, B].neg
}

instance PointwiseFunction[T, A: Neg]: Neg {
    let neg = PointwiseFunction[T, A].neg
}

instance FinitelySupportedFunction[T, A: AddCommGroup]: Neg {
    let neg = FinitelySupportedFunction[T, A].neg
}

instance IdealQuotient[R: CommRing, i: Ideal[R]]: Neg {
    let neg = IdealQuotient[R, i].neg
}

theorem add_subgroup_rel_respects_neg[G: AddCommGroup](h: AddSubgroup[G]) {
    respects_unary_op(add_subgroup_rel(h), G.neg)
}

theorem add_subgroup_quotient_relation_respects_neg[G: AddCommGroup](h: AddSubgroup[G]) {
    quotient_unary_respects(add_subgroup_quotient_relation(h), G.neg)
}

define add_subgroup_quotient_neg[G: AddCommGroup](h: AddSubgroup[G]) ->
    QuotientOver[G] -> QuotientOver[G] {
    quotient_over_unary_op(add_subgroup_quotient_relation(h), G.neg)
}

theorem add_subgroup_quotient_neg_projection[G: AddCommGroup](h: AddSubgroup[G], a: G) {
    add_subgroup_quotient_neg(h, quotient_over_mk(add_subgroup_quotient_relation(h), a)) =
        quotient_over_mk(add_subgroup_quotient_relation(h), -a)
}

theorem add_subgroup_quotient_neg_projection_compatible[G: AddCommGroup](h: AddSubgroup[G], a: G, b: G) {
    add_subgroup_rel(h, a, b) implies
    add_subgroup_quotient_neg(h, quotient_over_mk(add_subgroup_quotient_relation(h), a)) =
        add_subgroup_quotient_neg(h, quotient_over_mk(add_subgroup_quotient_relation(h), b))
}

theorem add_subgroup_quotient_neg_add[G: AddCommGroup](h: AddSubgroup[G], a: G) {
    add_subgroup_quotient_add(h,
        add_subgroup_quotient_neg(h, quotient_over_mk(add_subgroup_quotient_relation(h), a)),
        quotient_over_mk(add_subgroup_quotient_relation(h), a)) =
        quotient_over_mk(add_subgroup_quotient_relation(h), G.0)
}

theorem add_subgroup_quotient_add_neg[G: AddCommGroup](h: AddSubgroup[G], a: G) {
    add_subgroup_quotient_add(h,
        quotient_over_mk(add_subgroup_quotient_relation(h), a),
        add_subgroup_quotient_neg(h, quotient_over_mk(add_subgroup_quotient_relation(h), a))) =
        quotient_over_mk(add_subgroup_quotient_relation(h), G.0)
}

theorem function_pair_neg_apply[T, A: Neg, B: Neg](p: Pair[T -> A, T -> B], t: T) {
    function_pair_apply(function_pair_neg(p), t) = pair_neg(function_pair_apply(p, t))
}

define submodule_quotient_neg[R: Ring, M: AddCommGroup](s: Submodule[R, M]) ->
    QuotientOver[M] -> QuotientOver[M] {
    add_subgroup_quotient_neg(submodule_to_add_subgroup(s))
}

theorem submodule_quotient_neg_projection[R: Ring, M: AddCommGroup](s: Submodule[R, M], a: M) {
    submodule_quotient_neg(s,
        quotient_over_mk(submodule_quotient_relation(s), a)
    ) = quotient_over_mk(submodule_quotient_relation(s), -a)
}

theorem submodule_quotient_mk_neg[R: Ring, M: AddCommGroup](
    s: Submodule[R, M], a: M
) {
    submodule_quotient_mk(s)(-a) = submodule_quotient_neg(s, submodule_quotient_mk(s)(a))
}

theorem pair_typeclass_neg_eq_pair_neg[A: Neg, B: Neg](p: Pair[A, B]) {
    -p = pair_neg(p)
}

define pair_inverse[A: Group, B: Group](p: Pair[A, B]) -> Pair[A, B] {
    Pair.new(p.first.inverse, p.second.inverse)
}

theorem function_pair_inverse_apply[T, A: Group, B: Group](p: Pair[T -> A, T -> B], t: T) {
    function_pair_apply(function_pair_inverse(p), t) = pair_inverse(function_pair_apply(p, t))
}

theorem pair_add_first[A: Add, B: Add](p: Pair[A, B], q: Pair[A, B]) {
    pair_add(p, q).first = p.first + q.first
}

theorem pair_add_second[A: Add, B: Add](p: Pair[A, B], q: Pair[A, B]) {
    pair_add(p, q).second = p.second + q.second
}

theorem pair_mul_first[A: Mul, B: Mul](p: Pair[A, B], q: Pair[A, B]) {
    pair_mul(p, q).first = p.first * q.first
}

theorem pair_mul_second[A: Mul, B: Mul](p: Pair[A, B], q: Pair[A, B]) {
    pair_mul(p, q).second = p.second * q.second
}

theorem pair_neg_first[A: Neg, B: Neg](p: Pair[A, B]) {
    pair_neg(p).first = -p.first
}

theorem pair_neg_second[A: Neg, B: Neg](p: Pair[A, B]) {
    pair_neg(p).second = -p.second
}

theorem pair_inverse_first[A: Group, B: Group](p: Pair[A, B]) {
    pair_inverse(p).first = p.first.inverse
}

theorem pair_inverse_second[A: Group, B: Group](p: Pair[A, B]) {
    pair_inverse(p).second = p.second.inverse
}

theorem pair_add_assoc[A: AddSemigroup, B: AddSemigroup](
    p: Pair[A, B], q: Pair[A, B], r: Pair[A, B]
) {
    pair_add(p, pair_add(q, r)) = pair_add(pair_add(p, q), r)
}

theorem pair_add_comm[A: AddCommSemigroup, B: AddCommSemigroup](p: Pair[A, B], q: Pair[A, B]) {
    pair_add(p, q) = pair_add(q, p)
}

theorem pair_add_zero_right[A: AddMonoid, B: AddMonoid](p: Pair[A, B]) {
    pair_add(p, pair_zero[A, B]) = p
}

theorem pair_add_zero_left[A: AddMonoid, B: AddMonoid](p: Pair[A, B]) {
    pair_add(pair_zero[A, B], p) = p
}

theorem pair_add_neg_right[A: AddGroup, B: AddGroup](p: Pair[A, B]) {
    pair_add(p, pair_neg(p)) = pair_zero[A, B]
}

theorem pair_add_neg_left[A: AddGroup, B: AddGroup](p: Pair[A, B]) {
    pair_add(pair_neg(p), p) = pair_zero[A, B]
}

theorem pair_mul_assoc[A: Semigroup, B: Semigroup](
    p: Pair[A, B], q: Pair[A, B], r: Pair[A, B]
) {
    pair_mul(p, pair_mul(q, r)) = pair_mul(pair_mul(p, q), r)
}

theorem pair_mul_comm[A: CommSemigroup, B: CommSemigroup](p: Pair[A, B], q: Pair[A, B]) {
    pair_mul(p, q) = pair_mul(q, p)
}

theorem pair_mul_one_right[A: Monoid, B: Monoid](p: Pair[A, B]) {
    pair_mul(p, pair_one[A, B]) = p
}

theorem pair_mul_one_left[A: Monoid, B: Monoid](p: Pair[A, B]) {
    pair_mul(pair_one[A, B], p) = p
}

theorem pair_mul_inverse_right[A: Group, B: Group](p: Pair[A, B]) {
    pair_mul(p, pair_inverse[A, B](p)) = pair_one[A, B]
}

theorem pair_mul_inverse_left[A: Group, B: Group](p: Pair[A, B]) {
    pair_mul(pair_inverse[A, B](p), p) = pair_one[A, B]
}

theorem pair_mul_add_distrib_left[A: Semiring, B: Semiring](
    p: Pair[A, B],
    q: Pair[A, B],
    r: Pair[A, B]
) {
    pair_mul(p, pair_add(q, r)) = pair_add(pair_mul(p, q), pair_mul(p, r))
}

theorem pair_mul_add_distrib_right[A: Semiring, B: Semiring](
    p: Pair[A, B],
    q: Pair[A, B],
    r: Pair[A, B]
) {
    pair_mul(pair_add(p, q), r) = pair_add(pair_mul(p, r), pair_mul(q, r))
}

theorem pair_mul_zero_right[A: Semiring, B: Semiring](p: Pair[A, B]) {
    pair_mul(p, pair_zero[A, B]) = pair_zero[A, B]
}

theorem pair_mul_zero_left[A: Semiring, B: Semiring](p: Pair[A, B]) {
    pair_mul(pair_zero[A, B], p) = pair_zero[A, B]
}

theorem pair_inverse_inverse[A: Group, B: Group](p: Pair[A, B]) {
    pair_inverse[A, B](pair_inverse[A, B](p)) = p
}

theorem pair_inverse_mul[A: Group, B: Group](p: Pair[A, B], q: Pair[A, B]) {
    pair_inverse[A, B](pair_mul(p, q)) = pair_mul(pair_inverse[A, B](q), pair_inverse[A, B](p))
}

theorem pair_swap_add[A: Add, B: Add](p: Pair[A, B], q: Pair[A, B]) {
    pair_add(p, q).swap = pair_add(p.swap, q.swap)
}

theorem pair_swap_mul[A: Mul, B: Mul](p: Pair[A, B], q: Pair[A, B]) {
    pair_mul(p, q).swap = pair_mul(p.swap, q.swap)
}

theorem pair_swap_neg[A: Neg, B: Neg](p: Pair[A, B]) {
    pair_neg(p).swap = pair_neg(p.swap)
}

theorem pair_swap_inverse[A: Group, B: Group](p: Pair[A, B]) {
    pair_inverse[A, B](p).swap = pair_inverse[B, A](p.swap)
}

theorem pointwise_neg_has_support_in[T, A: AddGroup](f: T -> A, s: FiniteSet[T]) {
    has_support_in(f, s) implies has_support_in(pointwise_neg(f), s)
}

theorem pointwise_neg_is_finitely_supported[T, A: AddGroup](f: T -> A) {
    is_finitely_supported(f) implies is_finitely_supported(pointwise_neg(f))
}

theorem pointwise_mul_has_support_in_left[T, A: Semiring](f: T -> A, g: T -> A, s: FiniteSet[T]) {
    has_support_in(f, s) implies has_support_in(pointwise_mul(f, g), s)
}

theorem pointwise_mul_has_support_in_right[T, A: Semiring](f: T -> A, g: T -> A, s: FiniteSet[T]) {
    has_support_in(g, s) implies has_support_in(pointwise_mul(f, g), s)
}

theorem pointwise_mul_is_finitely_supported_left[T, A: Semiring](f: T -> A, g: T -> A) {
    is_finitely_supported(f) implies is_finitely_supported(pointwise_mul(f, g))
}

theorem pointwise_mul_is_finitely_supported_right[T, A: Semiring](f: T -> A, g: T -> A) {
    is_finitely_supported(g) implies is_finitely_supported(pointwise_mul(f, g))
}

theorem pointwise_mul_is_finitely_supported[T, A: Semiring](f: T -> A, g: T -> A) {
    is_finitely_supported(f) and is_finitely_supported(g) implies
    is_finitely_supported(pointwise_mul(f, g))
}

define pair_function_first[T, A, B](f: T -> Pair[A, B], t: T) -> A {
    f(t).first
}

define pair_function_second[T, A, B](f: T -> Pair[A, B], t: T) -> B {
    f(t).second
}

define pointwise_pair_add[T, A: AddMonoid, B: AddMonoid](
    f: T -> Pair[A, B],
    g: T -> Pair[A, B],
    t: T
) -> Pair[A, B] {
    pair_add(f(t), g(t))
}

define pointwise_pair_neg[T, A: AddGroup, B: AddGroup](f: T -> Pair[A, B], t: T) -> Pair[A, B] {
    pair_neg(f(t))
}

define pointwise_pair_mul[T, A: Semiring, B: Semiring](
    f: T -> Pair[A, B],
    g: T -> Pair[A, B],
    t: T
) -> Pair[A, B] {
    pair_mul(f(t), g(t))
}

theorem add_monoid_algebra_single_coeff_zero_of_not_contains[R: Semiring, M](m: M, r: R, n: M) {
    not add_monoid_algebra_singleton_support(m).contains(n) implies
    add_monoid_algebra_single_coeff[R, M](m, r, n) = R.0
}

theorem add_monoid_algebra_add_coeff[R: Semiring, M](p: AddMonoidAlgebra[R, M], q: AddMonoidAlgebra[R, M], m: M) {
    (p + q).coeff(m) = p.coeff(m) + q.coeff(m)
}

theorem add_monoid_algebra_add_assoc[R: Semiring, M](
    p: AddMonoidAlgebra[R, M], q: AddMonoidAlgebra[R, M], r: AddMonoidAlgebra[R, M]
) {
    p + (q + r) = (p + q) + r
}

theorem add_monoid_algebra_add_comm[R: Semiring, M](p: AddMonoidAlgebra[R, M], q: AddMonoidAlgebra[R, M]) {
    p + q = q + p
}

theorem add_monoid_algebra_add_has_support_in_union[R: Semiring, M](
    p: AddMonoidAlgebra[R, M],
    q: AddMonoidAlgebra[R, M],
    s: FiniteSet[M],
    u: FiniteSet[M]
) {
    has_support_in(p.coeff, s) and has_support_in(q.coeff, u) implies
    has_support_in((p + q).coeff, s.union(u))
}

define add_monoid_algebra_smul_coeff_fn[R: Semiring, M](r: R, p: AddMonoidAlgebra[R, M], m: M) -> R {
    r * p.coeff(m)
}

theorem add_monoid_algebra_smul_coeff_zero_of_not_contains[R: Semiring, M](
    r: R,
    p: AddMonoidAlgebra[R, M],
    s: FiniteSet[M],
    m: M
) {
    has_support_in(p.coeff, s) and not s.contains(m) implies
    add_monoid_algebra_smul_coeff_fn(r, p, m) = R.0
}

theorem add_monoid_algebra_smul_coeff_has_support[R: Semiring, M](
    r: R,
    p: AddMonoidAlgebra[R, M],
    s: FiniteSet[M]
) {
    has_support_in(p.coeff, s) implies has_support_in(add_monoid_algebra_smul_coeff_fn(r, p), s)
}

theorem add_monoid_algebra_smul_coeff_is_finitely_supported[R: Semiring, M](r: R, p: AddMonoidAlgebra[R, M]) {
    is_finitely_supported(add_monoid_algebra_smul_coeff_fn(r, p))
}

theorem add_monoid_algebra_smul_coeff[R: Semiring, M](r: R, p: AddMonoidAlgebra[R, M], m: M) {
    p.smul(r).coeff(m) = r * p.coeff(m)
}

theorem add_monoid_algebra_smul_add[R: Semiring, M](r: R, p: AddMonoidAlgebra[R, M], q: AddMonoidAlgebra[R, M]) {
    (p + q).smul(r) = p.smul(r) + q.smul(r)
}

theorem add_monoid_algebra_add_smul[R: Semiring, M](r: R, s: R, p: AddMonoidAlgebra[R, M]) {
    p.smul(r + s) = p.smul(r) + p.smul(s)
}

theorem add_monoid_algebra_smul_assoc[R: Semiring, M](r: R, s: R, p: AddMonoidAlgebra[R, M]) {
    p.smul(r * s) = p.smul(s).smul(r)
}

theorem add_monoid_algebra_neg_coeff[R: Ring, M](p: AddMonoidAlgebra[R, M], m: M) {
    p.neg.coeff(m) = -p.coeff(m)
}

theorem add_monoid_algebra_sub_coeff[R: Ring, M](p: AddMonoidAlgebra[R, M], q: AddMonoidAlgebra[R, M], m: M) {
    p.sub(q).coeff(m) = p.coeff(m) + -q.coeff(m)
}

theorem add_monoid_algebra_neg_has_support_in[R: Ring, M](p: AddMonoidAlgebra[R, M], s: FiniteSet[M]) {
    has_support_in(p.coeff, s) implies has_support_in(p.neg.coeff, s)
}

theorem add_monoid_algebra_sub_has_support_in_union[R: Ring, M](
    p: AddMonoidAlgebra[R, M],
    q: AddMonoidAlgebra[R, M],
    s: FiniteSet[M],
    u: FiniteSet[M]
) {
    has_support_in(p.coeff, s) and has_support_in(q.coeff, u) implies
    has_support_in(p.sub(q).coeff, s.union(u))
}

theorem add_monoid_algebra_neg_add[R: Ring, M](p: AddMonoidAlgebra[R, M], q: AddMonoidAlgebra[R, M]) {
    (p + q).neg = p.neg + q.neg
}

theorem add_monoid_algebra_add_left_cancel[R: Ring, M](p: AddMonoidAlgebra[R, M], q: AddMonoidAlgebra[R, M], r: AddMonoidAlgebra[R, M]) {
    p + q = p + r implies q = r
}

theorem add_monoid_algebra_add_right_cancel[R: Ring, M](p: AddMonoidAlgebra[R, M], q: AddMonoidAlgebra[R, M], r: AddMonoidAlgebra[R, M]) {
    q + p = r + p implies q = r
}

theorem add_monoid_algebra_sub_add_cancel[R: Ring, M](p: AddMonoidAlgebra[R, M], q: AddMonoidAlgebra[R, M]) {
    p.sub(q) + q = p
}

theorem add_monoid_algebra_add_sub_cancel[R: Ring, M](p: AddMonoidAlgebra[R, M], q: AddMonoidAlgebra[R, M]) {
    (p + q).sub(q) = p
}

theorem add_monoid_algebra_smul_neg[R: Ring, M](r: R, p: AddMonoidAlgebra[R, M]) {
    p.neg.smul(r) = p.smul(r).neg
}

theorem add_monoid_algebra_smul_sub[R: Ring, M](r: R, p: AddMonoidAlgebra[R, M], q: AddMonoidAlgebra[R, M]) {
    p.sub(q).smul(r) = p.smul(r).sub(q.smul(r))
}

theorem add_monoid_algebra_neg_smul[R: Ring, M](r: R, p: AddMonoidAlgebra[R, M]) {
    p.smul(-r) = p.smul(r).neg
}

theorem add_monoid_algebra_smul_neg_eq_neg_smul[R: Ring, M](r: R, p: AddMonoidAlgebra[R, M]) {
    p.neg.smul(r) = p.smul(-r)
}

theorem add_monoid_algebra_sub_smul[R: Ring, M](r: R, s: R, p: AddMonoidAlgebra[R, M]) {
    p.smul(r + -s) = p.smul(r).sub(p.smul(s))
}

theorem add_monoid_algebra_neg_smul_eq_smul_neg[R: Ring, M](r: R, p: AddMonoidAlgebra[R, M]) {
    p.smul(r).neg = p.smul(-r)
}

theorem add_monoid_algebra_single_add_same_coeff_self[R: Semiring, M](m: M, r: R, s: R) {
    (AddMonoidAlgebra[R, M].single(m, r) + AddMonoidAlgebra[R, M].single(m, s)).coeff(m) = r + s
}

theorem add_monoid_algebra_single_add_same_coeff_of_ne[R: Semiring, M](m: M, r: R, s: R, n: M) {
    n != m implies
    (AddMonoidAlgebra[R, M].single(m, r) + AddMonoidAlgebra[R, M].single(m, s)).coeff(n) = R.0
}

theorem add_monoid_algebra_single_add_same[R: Semiring, M](m: M, r: R, s: R) {
    AddMonoidAlgebra[R, M].single(m, r) + AddMonoidAlgebra[R, M].single(m, s) =
        AddMonoidAlgebra[R, M].single(m, r + s)
}

theorem add_monoid_algebra_single_smul_coeff_self[R: Semiring, M](m: M, r: R, s: R) {
    AddMonoidAlgebra[R, M].single(m, r).smul(s).coeff(m) = s * r
}

theorem add_monoid_algebra_single_smul[R: Semiring, M](m: M, r: R, s: R) {
    AddMonoidAlgebra[R, M].single(m, r).smul(s) = AddMonoidAlgebra[R, M].single(m, s * r)
}

theorem add_monoid_algebra_single_neg_coeff_self[R: Ring, M](m: M, r: R) {
    AddMonoidAlgebra[R, M].single(m, r).neg.coeff(m) = -r
}

theorem add_monoid_algebra_single_neg_coeff_of_ne[R: Ring, M](m: M, r: R, n: M) {
    n != m implies AddMonoidAlgebra[R, M].single(m, r).neg.coeff(n) = R.0
}

theorem add_monoid_algebra_single_neg[R: Ring, M](m: M, r: R) {
    AddMonoidAlgebra[R, M].single(m, r).neg = AddMonoidAlgebra[R, M].single(m, -r)
}

theorem add_monoid_algebra_single_sub_same_coeff_self[R: Ring, M](m: M, r: R, s: R) {
    AddMonoidAlgebra[R, M].single(m, r).sub(AddMonoidAlgebra[R, M].single(m, s)).coeff(m) = r + -s
}

theorem add_monoid_algebra_single_sub_same_coeff_of_ne[R: Ring, M](m: M, r: R, s: R, n: M) {
    n != m implies AddMonoidAlgebra[R, M].single(m, r).sub(AddMonoidAlgebra[R, M].single(m, s)).coeff(n) = R.0
}

theorem add_monoid_algebra_single_sub_same[R: Ring, M](m: M, r: R, s: R) {
    AddMonoidAlgebra[R, M].single(m, r).sub(AddMonoidAlgebra[R, M].single(m, s)) =
        AddMonoidAlgebra[R, M].single(m, r + -s)
}

theorem finitely_supported_function_apply_zero_outside_support[T, A: AddCommGroup](
    f: FinitelySupportedFunction[T, A],
    t: T
) {
    not finitely_supported_function_support(f).contains(t) implies f.to_fun(t) = A.0
}

theorem finitely_supported_function_apply_zero_of_not_contains[T, A: AddCommGroup](
    f: FinitelySupportedFunction[T, A],
    s: FiniteSet[T],
    t: T
) {
    has_support_in(f.to_fun, s) and not s.contains(t) implies f.to_fun(t) = A.0
}

theorem finitely_supported_function_add_apply[T, A: AddCommGroup](
    f: FinitelySupportedFunction[T, A],
    g: FinitelySupportedFunction[T, A],
    t: T
) {
    (f + g).to_fun(t) = f.to_fun(t) + g.to_fun(t)
}

theorem finitely_supported_function_add_to_fun[T, A: AddCommGroup](
    f: FinitelySupportedFunction[T, A],
    g: FinitelySupportedFunction[T, A]
) {
    (f + g).to_fun = pointwise_add(f.to_fun, g.to_fun)
}

theorem finitely_supported_function_neg_apply[T, A: AddCommGroup](
    f: FinitelySupportedFunction[T, A],
    t: T
) {
    (-f).to_fun(t) = -f.to_fun(t)
}

theorem finitely_supported_function_neg_to_fun[T, A: AddCommGroup](
    f: FinitelySupportedFunction[T, A]
) {
    (-f).to_fun = pointwise_neg(f.to_fun)
}

theorem finitely_supported_function_sub_apply[T, A: AddCommGroup](
    f: FinitelySupportedFunction[T, A],
    g: FinitelySupportedFunction[T, A],
    t: T
) {
    f.sub(g).to_fun(t) = f.to_fun(t) + -g.to_fun(t)
}

theorem finitely_supported_function_sub_to_fun[T, A: AddCommGroup](
    f: FinitelySupportedFunction[T, A],
    g: FinitelySupportedFunction[T, A]
) {
    f.sub(g).to_fun = pointwise_add(f.to_fun, pointwise_neg(g.to_fun))
}

theorem finitely_supported_function_add_semigroup_law[T, A: AddCommGroup](
    f: FinitelySupportedFunction[T, A],
    g: FinitelySupportedFunction[T, A],
    h: FinitelySupportedFunction[T, A]
) {
    Add.add(f, Add.add(g, h)) = Add.add(Add.add(f, g), h)
}

theorem finitely_supported_function_add_comm_semigroup_law[T, A: AddCommGroup](
    f: FinitelySupportedFunction[T, A],
    g: FinitelySupportedFunction[T, A]
) {
    Add.add(f, g) = Add.add(g, f)
}

theorem geometric_sum[R: Ring](a: R, n: Nat) {
    (a + -R.1) * sum(map(n.range, a.pow)) = a.pow(n) + -R.1
}

theorem geometric_sum_sub_one[R: Ring](a: R, n: Nat) {
    (a - R.1) * sum(map(n.range, a.pow)) = a.pow(n) - R.1
}

theorem ring_neg_zero[R: Ring] {
    -R.0 = R.0
}

theorem ring_sub_self[R: Ring](a: R) {
    a - a = R.0
}

theorem ring_sub_zero[R: Ring](a: R) {
    a - R.0 = a
}

theorem ring_zero_sub[R: Ring](a: R) {
    R.0 - a = -a
}

theorem ring_sub_eq_zero_iff_eq[R: Ring](a: R, b: R) {
    (a - b = R.0) = (a = b)
}

theorem ring_neg_sub[R: Ring](a: R, b: R) {
    -(a - b) = b - a
}

theorem ring_sub_neg[R: Ring](a: R, b: R) {
    a - -b = a + b
}

theorem ring_sub_eq_neg_sub[R: Ring](a: R, b: R) {
    a - b = -(b - a)
}

theorem ring_neg_eq_zero_iff[R: Ring](a: R) {
    (-a = R.0) = (a = R.0)
}

theorem ring_neg_eq_neg_iff[R: Ring](a: R, b: R) {
    (-a = -b) = (a = b)
}

theorem ring_add_sub_assoc[R: Ring](a: R, b: R, c: R) {
    (a + b) - c = a + (b - c)
}

theorem ring_sub_add_cancel[R: Ring](a: R, b: R) {
    (a - b) + b = a
}

theorem ring_add_sub_cancel[R: Ring](a: R, b: R) {
    a + b - b = a
}

theorem ring_sub_sub[R: Ring](a: R, b: R, c: R) {
    a - (b - c) = a - b + c
}

theorem ring_add_eq_zero_iff_eq_neg[R: Ring](a: R, b: R) {
    (a + b = R.0) = (b = -a)
}

theorem ring_add_eq_zero_iff_eq_neg_left[R: Ring](a: R, b: R) {
    (a + b = R.0) = (a = -b)
}

theorem ring_neg_add_neg_neg[R: Ring](a: R, b: R) {
    -(-a + -b) = a + b
}

theorem ring_mul_sub_cancel_right[R: Ring](a: R, b: R, c: R) {
    a * (b - c) + a * c = a * b
}

theorem ring_sub_mul_cancel_right[R: Ring](a: R, b: R, c: R) {
    (a - b) * c + b * c = a * c
}

theorem ring_sub_eq_of_sub_eq[R: Ring](a: R, b: R, c: R) {
    a - b = c - b implies a = c
}

theorem ring_sub_eq_iff_sub[R: Ring](a: R, b: R, c: R) {
    (a - b = a - c) = (b = c)
}

theorem ring_pow_two[R: Ring](a: R) {
    a.pow(2) = a * a
}

theorem ring_pow_three[R: Ring](a: R) {
    a.pow(3) = a * a * a
}

theorem ring_neg_pow_two[R: Ring](a: R) {
    (-a).pow(2) = a.pow(2)
}

theorem ring_neg_one_pow_two[R: Ring] {
    (-R.1).pow(2) = R.1
}

theorem ring_foil[R: Ring](a: R, b: R, c: R, d: R) {
    (a + b) * (c + d) = a * c + a * d + b * c + b * d
}

theorem ring_pow_mul_comm[R: Ring](a: R, m: Nat, n: Nat) {
    a.pow(m) * a.pow(n) = a.pow(n) * a.pow(m)
}

theorem ring_sub_self_mul_left[R: Ring](a: R, b: R) {
    (a - a) * b = R.0
}

theorem ring_mul_sub_self_right[R: Ring](a: R, b: R) {
    a * (b - b) = R.0
}

theorem ring_double_square[R: Ring](a: R) {
    (a + a).pow(2) = a.pow(2) + a.pow(2) + a.pow(2) + a.pow(2)
}

theorem ring_two_mul_add[R: Ring](a: R, b: R) {
    (R.1 + R.1) * (a + b) = (R.1 + R.1) * a + (R.1 + R.1) * b
}

theorem ring_from_nat_two[R: Ring] {
    from_nat[R](2) = R.1 + R.1
}

theorem ring_two_mul_from_nat[R: Ring](a: R) {
    from_nat[R](2) * a = a + a
}

theorem nilpotent_neg[R: CommRing](a: R) {
    is_nilpotent[R](a) implies is_nilpotent[R](-a)
}

theorem nilpotent_mul_left[R: CommRing](a: R, b: R) {
    is_nilpotent[R](a) implies is_nilpotent[R](a * b)
}

theorem nilpotent_mul_right[R: CommRing](a: R, b: R) {
    is_nilpotent[R](b) implies is_nilpotent[R](a * b)
}

let is_char_two[R: Ring] = forall(a: R) {
    a + a = R.0
}

theorem char_two_iff_one_plus_one_zero[R: Ring] {
    is_char_two[R] = (R.1 + R.1 = R.0)
}

theorem char_two_neg_eq_self[R: Ring](a: R) {
    is_char_two[R] implies -a = a
}

theorem char_two_sub_eq_add[R: Ring](a: R, b: R) {
    is_char_two[R] implies a - b = a + b
}

theorem ring_add_self_zero_iff_neg_eq_self[R: Ring](a: R) {
    (a + a = R.0) = (-a = a)
}

theorem ring_add_self_zero_iff_two_mul_zero[R: Ring](a: R) {
    (a + a = R.0) = ((R.1 + R.1) * a = R.0)
}

theorem semiring_hom_add[S: Semiring, T: Semiring](f: SemiringHom[S, T], a: S, b: S) {
    f.hom(a + b) = f.hom(a) + f.hom(b)
}

theorem semiring_hom_mul[S: Semiring, T: Semiring](f: SemiringHom[S, T], a: S, b: S) {
    f.hom(a * b) = f.hom(a) * f.hom(b)
}

define is_ring_hom[R: Ring, S: Ring](f: R -> S) -> Bool {
    f(R.1) = S.1 and forall(a: R, b: R) {
        f(a + b) = f(a) + f(b) and f(a * b) = f(a) * f(b)
    }
}

structure RingHom[R: Ring, S: Ring] {
    /// The mapping for the homomorphism.
    hom: R -> S
} constraint {
    is_ring_hom(hom)
}

theorem ring_hom_ext[R: Ring, S: Ring](f: RingHom[R, S], g: RingHom[R, S]) {
    (forall(a: R) { f.hom(a) = g.hom(a) }) implies f = g
}

attributes RingHom[R: Ring, S: Ring] {
    /// Ring homomorphism extensionality from pointwise equality of the homomorphism.
    let ext = ring_hom_ext[R, S]
}

theorem ring_hom_eq_hom[R: Ring, S: Ring](f: RingHom[R, S], g: RingHom[R, S]) {
    f = g implies f.hom = g.hom
}

theorem ring_hom_eq_apply[R: Ring, S: Ring](f: RingHom[R, S], g: RingHom[R, S], a: R) {
    f = g implies f.hom(a) = g.hom(a)
}

theorem ring_hom_eq_transport_predicate[R: Ring, S: Ring](
    p: RingHom[R, S] -> Bool,
    f: RingHom[R, S],
    g: RingHom[R, S]
) {
    f = g and p(f) implies p(g)
}

theorem ring_hom_eq_transport_predicate_rev[R: Ring, S: Ring](
    p: RingHom[R, S] -> Bool,
    f: RingHom[R, S],
    g: RingHom[R, S]
) {
    f = g and p(g) implies p(f)
}

theorem ring_hom_eq_of_hom_eq[R: Ring, S: Ring](f: RingHom[R, S], g: RingHom[R, S]) {
    f.hom = g.hom implies f = g
}

theorem ring_hom_eq_of_apply_eq[R: Ring, S: Ring](f: RingHom[R, S], g: RingHom[R, S]) {
    (forall(a: R) { f.hom(a) = g.hom(a) }) implies f = g
}

theorem ring_hom_one[R: Ring, S: Ring](f: RingHom[R, S]) {
    f.hom(R.1) = S.1
}

theorem ring_hom_add[R: Ring, S: Ring](f: RingHom[R, S], a: R, b: R) {
    f.hom(a + b) = f.hom(a) + f.hom(b)
}

theorem ring_hom_mul[R: Ring, S: Ring](f: RingHom[R, S], a: R, b: R) {
    f.hom(a * b) = f.hom(a) * f.hom(b)
}

theorem ring_hom_zero[R: Ring, S: Ring](f: RingHom[R, S]) {
    f.hom(R.0) = S.0
}

theorem ring_hom_neg[R: Ring, S: Ring](f: RingHom[R, S], a: R) {
    f.hom(-a) = -f.hom(a)
}

theorem ring_hom_is_add_group_hom[R: Ring, S: Ring](f: RingHom[R, S]) {
    is_add_group_hom(f.hom)
}

theorem ring_hom_is_monoid_hom[R: Ring, S: Ring](f: RingHom[R, S]) {
    is_monoid_hom(f.hom)
}

theorem ring_hom_is_semiring_hom[R: Ring, S: Ring](f: RingHom[R, S]) {
    is_semiring_hom(f.hom)
}

let ring_hom_to_add_group_hom[R: Ring, S: Ring](f: RingHom[R, S]) -> result: AddGroupHom[R, S] satisfy {
    AddGroupHom.new(f.hom) = Option.some(result)
}

theorem ring_hom_to_add_group_hom_hom[R: Ring, S: Ring](f: RingHom[R, S]) {
    ring_hom_to_add_group_hom(f).hom = f.hom
}

let ring_hom_to_monoid_hom[R: Ring, S: Ring](f: RingHom[R, S]) -> result: MonoidHom[R, S] satisfy {
    MonoidHom.new(f.hom) = Option.some(result)
}

theorem ring_hom_to_monoid_hom_hom[R: Ring, S: Ring](f: RingHom[R, S]) {
    ring_hom_to_monoid_hom(f).hom = f.hom
}

let ring_hom_to_semiring_hom[R: Ring, S: Ring](f: RingHom[R, S]) -> result: SemiringHom[R, S] satisfy {
    SemiringHom.new(f.hom) = Option.some(result)
}

theorem ring_hom_to_semiring_hom_hom[R: Ring, S: Ring](f: RingHom[R, S]) {
    ring_hom_to_semiring_hom(f).hom = f.hom
}

theorem add_group_hom_monoid_hom_is_ring_hom[R: Ring, S: Ring](f: AddGroupHom[R, S], g: MonoidHom[R, S]) {
    f.hom = g.hom implies is_ring_hom(f.hom)
}

theorem ring_hom_pow[R: Ring, S: Ring](f: RingHom[R, S], a: R, n: Nat) {
    f.hom(a.pow(n)) = f.hom(a).pow(n)
}

theorem function_eq_transport_ring_hom[R: Ring, S: Ring](f: R -> S, g: R -> S) {
    f = g and is_ring_hom(f) implies is_ring_hom(g)
}

theorem function_eq_transport_ring_hom_rev[R: Ring, S: Ring](f: R -> S, g: R -> S) {
    f = g and is_ring_hom(g) implies is_ring_hom(f)
}

theorem identity_fn_is_ring_hom[R: Ring] {
    is_ring_hom(identity_fn[R])
}

theorem compose_is_ring_hom[R: Ring, S: Ring, T: Ring](f: S -> T, g: R -> S) {
    is_ring_hom(f) and is_ring_hom(g) implies is_ring_hom(compose(f, g))
}

let identity_ring_hom[R: Ring]: RingHom[R, R] satisfy {
    RingHom.new(identity_fn[R]) = Option.some(identity_ring_hom)
}

theorem identity_ring_hom_hom[R: Ring] {
    identity_ring_hom[R].hom = identity_fn[R]
}

let compose_ring_hom[R: Ring, S: Ring, T: Ring](f: RingHom[S, T], g: RingHom[R, S]) -> result: RingHom[R, T] satisfy {
    RingHom.new(compose(f.hom, g.hom)) = Option.some(result)
}

theorem compose_ring_hom_hom[R: Ring, S: Ring, T: Ring](f: RingHom[S, T], g: RingHom[R, S]) {
    compose_ring_hom(f, g).hom = compose(f.hom, g.hom)
}

theorem compose_ring_hom_assoc[R: Ring, S: Ring, T: Ring, U: Ring](
    f: RingHom[T, U], g: RingHom[S, T], h: RingHom[R, S]) {
    compose_ring_hom(compose_ring_hom(f, g), h) = compose_ring_hom(f, compose_ring_hom(g, h))
}

theorem compose_ring_hom_identity_left[R: Ring, S: Ring](f: RingHom[R, S]) {
    compose_ring_hom(identity_ring_hom[S], f) = f
}

theorem compose_ring_hom_identity_right[R: Ring, S: Ring](f: RingHom[R, S]) {
    compose_ring_hom(f, identity_ring_hom[R]) = f
}

define is_trivial_group_hom_kernel[G: Group, H: Group](f: GroupHom[G, H]) -> Bool {
    forall(a: G) {
        f.hom(a) = H.1 implies a = G.1
    }
}

theorem group_hom_eq_iff_inv_mul_one[G: Group, H: Group](f: GroupHom[G, H], a: G, b: G) {
    (f.hom(a) = f.hom(b)) = (f.hom(a.inverse * b) = H.1)
}

theorem group_hom_injective_iff_trivial_kernel[G: Group, H: Group](f: GroupHom[G, H]) {
    is_injective_fn(f.hom) = is_trivial_group_hom_kernel(f)
}

theorem add_group_hom_eq_iff_sub_zero[A: AddGroup, B: AddGroup](f: AddGroupHom[A, B], a: A, b: A) {
    (f.hom(a) = f.hom(b)) = (f.hom(b - a) = B.0)
}

define is_trivial_ring_hom_kernel[R: Ring, S: Ring](f: RingHom[R, S]) -> Bool {
    forall(a: R) {
        f.hom(a) = S.0 implies a = R.0
    }
}

theorem ring_hom_eq_iff_sub_zero[R: Ring, S: Ring](f: RingHom[R, S], a: R, b: R) {
    (f.hom(a) = f.hom(b)) = (f.hom(b - a) = S.0)
}

theorem ring_hom_injective_iff_trivial_kernel[R: Ring, S: Ring](f: RingHom[R, S]) {
    is_injective_fn(f.hom) = is_trivial_ring_hom_kernel(f)
}

theorem is_ideal_add[R: CommRing](contains: R -> Bool, a: R, b: R) {
    is_ideal(contains) and contains(a) and contains(b) implies contains(a + b)
}

theorem is_ideal_absorb[R: CommRing](contains: R -> Bool, r: R, a: R) {
    is_ideal(contains) and contains(a) implies contains(r * a)
}

theorem is_ideal_neg[R: CommRing](contains: R -> Bool, a: R) {
    is_ideal(contains) and contains(a) implies contains(-a)
}

define principal_ideal[R: CommRing](a: R, x: R) -> Bool {
    exists(r: R) {
        x = r * a
    }
}

theorem principal_ideal_is_ideal[R: CommRing](a: R) {
    is_ideal(principal_ideal[R](a))
}

theorem principal_ideal_contains_generator[R: CommRing](a: R) {
    principal_ideal(a, a)
}

theorem principal_ideal_contains_multiple[R: CommRing](a: R, r: R) {
    principal_ideal(a, r * a)
}

theorem principal_ideal_witness[R: CommRing](a: R, x: R) {
    principal_ideal(a, x) implies exists(r: R) { x = r * a }
}

theorem principal_ideal_zero_eq_zero_ideal[R: CommRing] {
    principal_ideal[R](R.0) = zero_ideal[R]
}

theorem principal_ideal_one_eq_unit_ideal[R: CommRing] {
    principal_ideal[R](R.1) = unit_ideal[R]
}

theorem principal_ideal_subset_of_contains_generator[R: CommRing](a: R, contains: R -> Bool) {
    is_ideal(contains) and contains(a) implies
        ideal_subset(principal_ideal[R](a), contains)
}

define ideal_sum[R: CommRing](contains_i: R -> Bool,
                              contains_j: R -> Bool,
                              x: R) -> Bool {
    exists(a: R, b: R) {
        contains_i(a) and contains_j(b) and x = a + b
    }
}

theorem ideal_sum_zero_constraint[R: CommRing](contains_i: R -> Bool,
                                               contains_j: R -> Bool) {
    is_ideal(contains_i) and is_ideal(contains_j)
        implies ideal_zero_constraint(ideal_sum[R](contains_i, contains_j))
}

theorem ideal_sum_add_constraint[R: CommRing](contains_i: R -> Bool,
                                              contains_j: R -> Bool) {
    is_ideal(contains_i) and is_ideal(contains_j)
        implies ideal_add_constraint(ideal_sum[R](contains_i, contains_j))
}

theorem ideal_sum_absorb_constraint[R: CommRing](contains_i: R -> Bool,
                                                 contains_j: R -> Bool) {
    is_ideal(contains_i) and is_ideal(contains_j)
        implies ideal_absorb_constraint(ideal_sum[R](contains_i, contains_j))
}

theorem ideal_sum_is_ideal[R: CommRing](contains_i: R -> Bool,
                                        contains_j: R -> Bool) {
    is_ideal(contains_i) and is_ideal(contains_j)
        implies is_ideal(ideal_sum[R](contains_i, contains_j))
}

theorem ideal_sum_subset_left[R: CommRing](contains_i: R -> Bool,
                                           contains_j: R -> Bool) {
    is_ideal(contains_j) implies ideal_subset(contains_i, ideal_sum[R](contains_i, contains_j))
}

theorem ideal_sum_subset_right[R: CommRing](contains_i: R -> Bool,
                                            contains_j: R -> Bool) {
    is_ideal(contains_i) implies ideal_subset(contains_j, ideal_sum[R](contains_i, contains_j))
}

theorem ideal_sum_lub[R: CommRing](contains_i: R -> Bool,
                                   contains_j: R -> Bool,
                                   contains_k: R -> Bool) {
    is_ideal(contains_k) and ideal_subset(contains_i, contains_k) and ideal_subset(contains_j, contains_k)
        implies ideal_subset(ideal_sum[R](contains_i, contains_j), contains_k)
}

theorem ideal_sum_subset_iff[R: CommRing](contains_i: R -> Bool,
                                          contains_j: R -> Bool,
                                          contains_k: R -> Bool) {
    is_ideal(contains_i) and is_ideal(contains_j) and is_ideal(contains_k)
        implies
    (ideal_subset(ideal_sum[R](contains_i, contains_j), contains_k) =
        (ideal_subset(contains_i, contains_k) and ideal_subset(contains_j, contains_k)))
}

theorem ideal_sum_comm[R: CommRing](contains_i: R -> Bool,
                                    contains_j: R -> Bool) {
    ideal_sum[R](contains_i, contains_j) = ideal_sum[R](contains_j, contains_i)
}

theorem ideal_sum_assoc[R: CommRing](contains_i: R -> Bool,
                                     contains_j: R -> Bool,
                                     contains_k: R -> Bool) {
    ideal_sum[R](contains_i, ideal_sum[R](contains_j, contains_k)) =
        ideal_sum[R](ideal_sum[R](contains_i, contains_j), contains_k)
}

theorem ideal_sum_idempotent[R: CommRing](contains: R -> Bool) {
    is_ideal(contains) implies ideal_sum[R](contains, contains) = contains
}

theorem ideal_sum_eq_left_of_subset[R: CommRing](contains_i: R -> Bool,
                                                 contains_j: R -> Bool) {
    is_ideal(contains_i) and is_ideal(contains_j) and ideal_subset(contains_j, contains_i)
        implies ideal_sum[R](contains_i, contains_j) = contains_i
}

theorem ideal_sum_eq_right_of_subset[R: CommRing](contains_i: R -> Bool,
                                                  contains_j: R -> Bool) {
    is_ideal(contains_i) and is_ideal(contains_j) and ideal_subset(contains_i, contains_j)
        implies ideal_sum[R](contains_i, contains_j) = contains_j
}

theorem zero_ideal_sum_left[R: CommRing](contains: R -> Bool) {
    is_ideal(contains) implies ideal_sum[R](zero_ideal[R], contains) = contains
}

theorem zero_ideal_sum_right[R: CommRing](contains: R -> Bool) {
    is_ideal(contains) implies ideal_sum[R](contains, zero_ideal[R]) = contains
}

theorem unit_ideal_sum_left[R: CommRing](contains: R -> Bool) {
    is_ideal(contains) implies ideal_sum[R](unit_ideal[R], contains) = unit_ideal[R]
}

theorem unit_ideal_sum_right[R: CommRing](contains: R -> Bool) {
    is_ideal(contains) implies ideal_sum[R](contains, unit_ideal[R]) = unit_ideal[R]
}

theorem ideal_eq_contains[R: CommRing](a: Ideal[R], b: Ideal[R]) {
    a = b implies a.contains = b.contains
}

theorem ideal_eq_contains_at[R: CommRing](a: Ideal[R], b: Ideal[R], x: R) {
    a = b implies a.contains(x) = b.contains(x)
}

theorem ideal_eq_of_contains_eq[R: CommRing](a: Ideal[R], b: Ideal[R]) {
    a.contains = b.contains implies a = b
}

theorem ideal_eq_of_contains_at_eq[R: CommRing](a: Ideal[R], b: Ideal[R]) {
    (forall(x: R) { a.contains(x) = b.contains(x) }) implies a = b
}

theorem ideal_contains_zero[R: CommRing](i: Ideal[R]) {
    i.contains(R.0)
}

theorem ideal_contains_add[R: CommRing](i: Ideal[R], a: R, b: R) {
    i.contains(a) and i.contains(b) implies i.contains(a + b)
}

theorem ideal_contains_mul_left[R: CommRing](i: Ideal[R], r: R, a: R) {
    i.contains(a) implies i.contains(r * a)
}

theorem ideal_contains_mul_right[R: CommRing](i: Ideal[R], a: R, r: R) {
    i.contains(a) implies i.contains(a * r)
}

theorem ideal_contains_neg[R: CommRing](i: Ideal[R], a: R) {
    i.contains(a) implies i.contains(-a)
}

theorem bundled_unit_ideal_contains_everything[R: CommRing](x: R) {
    Ideal[R].unit.contains(x)
}

theorem bundled_unit_ideal_contains_eq[R: CommRing](x: R) {
    Ideal[R].unit.contains(x) = true
}

theorem bundled_ideal_eq_unit_of_contains_one[R: CommRing](i: Ideal[R]) {
    i.contains(R.1) implies i = Ideal[R].unit
}

theorem bundled_ideal_contains_one_iff_eq_unit[R: CommRing](i: Ideal[R]) {
    i.contains(R.1) = (i = Ideal[R].unit)
}

theorem bundled_principal_ideal_contains_eq[R: CommRing](a: R, x: R) {
    Ideal[R].principal(a).contains(x) = principal_ideal(a, x)
}

theorem bundled_principal_ideal_contains_generator[R: CommRing](a: R) {
    Ideal[R].principal(a).contains(a)
}

theorem bundled_principal_ideal_one_eq_unit[R: CommRing] {
    Ideal[R].principal(R.1) = Ideal[R].unit
}

theorem bundled_principal_ideal_contains_multiple[R: CommRing](a: R, r: R) {
    Ideal[R].principal(a).contains(r * a)
}

theorem bundled_principal_ideal_witness[R: CommRing](a: R, x: R) {
    Ideal[R].principal(a).contains(x) implies exists(r: R) { x = r * a }
}

define bundled_ideal_subset[R: CommRing](a: Ideal[R], b: Ideal[R]) -> Bool {
    forall(x: R) {
        a.contains(x) implies b.contains(x)
    }
}

theorem bundled_ideal_subset_eq[R: CommRing](a: Ideal[R], b: Ideal[R]) {
    bundled_ideal_subset(a, b) = ideal_subset(a.contains, b.contains)
}

theorem bundled_ideal_subset_refl[R: CommRing](a: Ideal[R]) {
    bundled_ideal_subset(a, a)
}

theorem bundled_ideal_subset_trans[R: CommRing](a: Ideal[R], b: Ideal[R], c: Ideal[R]) {
    bundled_ideal_subset(a, b) and bundled_ideal_subset(b, c) implies bundled_ideal_subset(a, c)
}

theorem bundled_ideal_subset_antisymm[R: CommRing](a: Ideal[R], b: Ideal[R]) {
    bundled_ideal_subset(a, b) and bundled_ideal_subset(b, a) implies a = b
}

theorem bundled_ideal_eq_iff_subset_both[R: CommRing](a: Ideal[R], b: Ideal[R]) {
    a = b = (bundled_ideal_subset(a, b) and bundled_ideal_subset(b, a))
}

theorem bundled_ideal_subset_unit[R: CommRing](i: Ideal[R]) {
    bundled_ideal_subset(i, Ideal[R].unit)
}

theorem bundled_principal_ideal_subset_of_contains_generator[R: CommRing](a: R, b: Ideal[R]) {
    b.contains(a) implies bundled_ideal_subset(Ideal[R].principal(a), b)
}

theorem bundled_principal_ideal_subset_iff_contains_generator[R: CommRing](a: R, b: Ideal[R]) {
    bundled_ideal_subset(Ideal[R].principal(a), b) = b.contains(a)
}

define bundled_ideal_inter_contains[R: CommRing](a: Ideal[R], b: Ideal[R], x: R) -> Bool {
    a.contains(x) and b.contains(x)
}

theorem bundled_ideal_inter_is_ideal[R: CommRing](a: Ideal[R], b: Ideal[R]) {
    is_ideal(bundled_ideal_inter_contains(a, b))
}

let bundled_ideal_inter[R: CommRing](a: Ideal[R], b: Ideal[R]) -> result: Ideal[R] satisfy {
    Ideal.new(bundled_ideal_inter_contains(a, b)) = Option.some(result)
}

define bundled_ideal_sum_contains[R: CommRing](a: Ideal[R], b: Ideal[R], x: R) -> Bool {
    exists(y: R, z: R) {
        a.contains(y) and b.contains(z) and x = y + z
    }
}

theorem bundled_ideal_sum_is_ideal[R: CommRing](a: Ideal[R], b: Ideal[R]) {
    is_ideal(bundled_ideal_sum_contains(a, b))
}

let bundled_ideal_sum[R: CommRing](a: Ideal[R], b: Ideal[R]) -> result: Ideal[R] satisfy {
    Ideal.new(bundled_ideal_sum_contains(a, b)) = Option.some(result)
}

attributes Ideal[R: CommRing] {
    /// The common part of two ideals.
    let intersection: (Ideal[R], Ideal[R]) -> Ideal[R] = bundled_ideal_inter

    /// The least ideal containing two ideals.
    let sum: (Ideal[R], Ideal[R]) -> Ideal[R] = bundled_ideal_sum
}

theorem bundled_ideal_sum_contains_eq[R: CommRing](a: Ideal[R], b: Ideal[R], x: R) {
    a.sum(b).contains(x) = bundled_ideal_sum_contains(a, b, x)
}

theorem bundled_ideal_sum_subset_left[R: CommRing](a: Ideal[R], b: Ideal[R]) {
    bundled_ideal_subset(a, a.sum(b))
}

theorem bundled_ideal_sum_subset_right[R: CommRing](a: Ideal[R], b: Ideal[R]) {
    bundled_ideal_subset(b, a.sum(b))
}

theorem bundled_ideal_sum_subset_of_left_right[R: CommRing](
    a: Ideal[R],
    b: Ideal[R],
    c: Ideal[R]
) {
    bundled_ideal_subset(a, c) and bundled_ideal_subset(b, c) implies bundled_ideal_subset(a.sum(b), c)
}

theorem bundled_ideal_sum_subset_iff[R: CommRing](a: Ideal[R], b: Ideal[R], c: Ideal[R]) {
    bundled_ideal_subset(a.sum(b), c) =
        (bundled_ideal_subset(a, c) and bundled_ideal_subset(b, c))
}

theorem bundled_ideal_sum_comm[R: CommRing](a: Ideal[R], b: Ideal[R]) {
    a.sum(b) = b.sum(a)
}

theorem bundled_ideal_sum_idempotent[R: CommRing](a: Ideal[R]) {
    a.sum(a) = a
}

theorem bundled_ideal_sum_eq_left_of_subset[R: CommRing](a: Ideal[R], b: Ideal[R]) {
    bundled_ideal_subset(b, a) implies a.sum(b) = a
}

theorem bundled_ideal_sum_eq_right_of_subset[R: CommRing](a: Ideal[R], b: Ideal[R]) {
    bundled_ideal_subset(a, b) implies a.sum(b) = b
}

theorem bundled_unit_ideal_sum_left[R: CommRing](i: Ideal[R]) {
    Ideal[R].unit.sum(i) = Ideal[R].unit
}

theorem bundled_unit_ideal_sum_right[R: CommRing](i: Ideal[R]) {
    i.sum(Ideal[R].unit) = Ideal[R].unit
}

define set_subset_ideal[R: CommRing](a: Set[R], i: Ideal[R]) -> Bool {
    forall(x: R) {
        a.contains(x) implies i.contains(x)
    }
}

theorem set_subset_ideal_trans[R: CommRing](a: Set[R], i: Ideal[R], j: Ideal[R]) {
    set_subset_ideal(a, i) and bundled_ideal_subset(i, j) implies set_subset_ideal(a, j)
}

theorem set_subset_ideal_of_set_subset[R: CommRing](a: Set[R], b: Set[R], i: Ideal[R]) {
    a.subset(b) and set_subset_ideal(b, i) implies set_subset_ideal(a, i)
}

define ideal_closure_contains[R: CommRing](a: Set[R], x: R) -> Bool {
    forall(i: Ideal[R]) {
        set_subset_ideal(a, i) implies i.contains(x)
    }
}

theorem ideal_closure_contains_of_set_subset_raw[R: CommRing](a: Set[R], i: Ideal[R], x: R) {
    ideal_closure_contains(a, x) and set_subset_ideal(a, i) implies i.contains(x)
}

theorem ideal_closure_zero_constraint[R: CommRing](a: Set[R]) {
    ideal_zero_constraint(ideal_closure_contains(a))
}

theorem ideal_closure_add_constraint[R: CommRing](a: Set[R]) {
    ideal_add_constraint(ideal_closure_contains(a))
}

theorem ideal_closure_absorb_constraint[R: CommRing](a: Set[R]) {
    ideal_absorb_constraint(ideal_closure_contains(a))
}

theorem ideal_closure_is_ideal[R: CommRing](a: Set[R]) {
    is_ideal(ideal_closure_contains(a))
}

let ideal_closure[R: CommRing](a: Set[R]) -> result: Ideal[R] satisfy {
    Ideal.new(ideal_closure_contains(a)) = Option.some(result)
}

attributes Ideal[R: CommRing] {
    /// The smallest ideal containing a set.
    let closure: Set[R] -> Ideal[R] = ideal_closure
}

define ideal_indexed_inter_contains[R: CommRing, I](family: I -> Ideal[R], x: R) -> Bool {
    forall(i: I) { family(i).contains(x) }
}

theorem ideal_indexed_inter_zero_constraint[R: CommRing, I](family: I -> Ideal[R]) {
    ideal_zero_constraint(ideal_indexed_inter_contains(family))
}

theorem ideal_indexed_inter_add_constraint[R: CommRing, I](family: I -> Ideal[R]) {
    ideal_add_constraint(ideal_indexed_inter_contains(family))
}

theorem ideal_indexed_inter_absorb_constraint[R: CommRing, I](family: I -> Ideal[R]) {
    ideal_absorb_constraint(ideal_indexed_inter_contains(family))
}

theorem ideal_indexed_inter_is_ideal[R: CommRing, I](family: I -> Ideal[R]) {
    is_ideal(ideal_indexed_inter_contains(family))
}

let ideal_indexed_inter[R: CommRing, I](family: I -> Ideal[R]) -> result: Ideal[R] satisfy {
    Ideal.new(ideal_indexed_inter_contains(family)) = Option.some(result)
}

theorem ideal_indexed_inter_contains_eq[R: CommRing, I](family: I -> Ideal[R], x: R) {
    ideal_indexed_inter(family).contains(x) = forall(i: I) { family(i).contains(x) }
}

theorem ideal_indexed_inter_contains_of_forall[R: CommRing, I](family: I -> Ideal[R], x: R) {
    (forall(i: I) { family(i).contains(x) }) implies ideal_indexed_inter(family).contains(x)
}

theorem ideal_indexed_inter_contains_at[R: CommRing, I](family: I -> Ideal[R], i: I, x: R) {
    ideal_indexed_inter(family).contains(x) implies family(i).contains(x)
}

theorem ideal_indexed_inter_subset[R: CommRing, I](family: I -> Ideal[R], i: I) {
    bundled_ideal_subset(ideal_indexed_inter(family), family(i))
}

theorem ideal_subset_indexed_inter_of_forall[R: CommRing, I](
    c: Ideal[R], family: I -> Ideal[R]
) {
    (forall(i: I) { bundled_ideal_subset(c, family(i)) })
        implies bundled_ideal_subset(c, ideal_indexed_inter(family))
}

theorem ideal_subset_indexed_inter_iff[R: CommRing, I](
    c: Ideal[R], family: I -> Ideal[R]
) {
    bundled_ideal_subset(c, ideal_indexed_inter(family)) =
        forall(i: I) { bundled_ideal_subset(c, family(i)) }
}

theorem ideal_indexed_inter_monotone[R: CommRing, I](
    family_a: I -> Ideal[R], family_b: I -> Ideal[R]
) {
    (forall(i: I) { bundled_ideal_subset(family_a(i), family_b(i)) })
        implies bundled_ideal_subset(ideal_indexed_inter(family_a), ideal_indexed_inter(family_b))
}

theorem ideal_indexed_inter_eq_of_family_eq[R: CommRing, I](
    family_a: I -> Ideal[R], family_b: I -> Ideal[R]
) {
    family_a = family_b implies ideal_indexed_inter(family_a) = ideal_indexed_inter(family_b)
}

define ideal_prime_constraint[R: CommRing](contains: R -> Bool) -> Bool {
    forall(a: R, b: R) {
        contains(a * b) implies contains(a) or contains(b)
    }
}

define is_prime_ideal[R: CommRing](contains: R -> Bool) -> Bool {
    is_ideal(contains)
    and ideal_proper_constraint(contains)
    and ideal_prime_constraint(contains)
}

structure PrimeIdeal[R: CommRing] {
    /// True if the given element is a member of this prime ideal.
    contains: R -> Bool
} constraint {
    is_prime_ideal(contains)
}

structure Spec[R: CommRing] {
    /// The prime ideal of `R` that this point of the spectrum represents.
    point: PrimeIdeal[R]
}

theorem is_prime_ideal_unfold[R: CommRing](contains: R -> Bool) {
    is_prime_ideal(contains) = (is_ideal(contains) and ideal_proper_constraint(contains) and ideal_prime_constraint(contains))
}

theorem is_prime_ideal_from_constraints[R: CommRing](contains: R -> Bool) {
    is_ideal(contains) and ideal_proper_constraint(contains) and ideal_prime_constraint(contains)
        implies is_prime_ideal(contains)
}

theorem is_prime_ideal_is_ideal[R: CommRing](contains: R -> Bool) {
    is_prime_ideal(contains) implies is_ideal(contains)
}

theorem is_prime_ideal_proper[R: CommRing](contains: R -> Bool) {
    is_prime_ideal(contains) implies not contains(R.1)
}

theorem is_prime_ideal_mem[R: CommRing](contains: R -> Bool, a: R, b: R) {
    is_prime_ideal(contains) and contains(a * b) implies contains(a) or contains(b)
}

theorem unit_ideal_not_prime[R: CommRing] {
    not is_prime_ideal(unit_ideal[R])
}

theorem ideal_sum_principal_contains_generator[R: CommRing](contains: R -> Bool, a: R) {
    is_ideal(contains) implies ideal_sum[R](contains, principal_ideal[R](a), a)
}

theorem maximal_ideal_sum_principal_contains_one[R: CommRing](contains: R -> Bool, a: R) {
    is_maximal_ideal(contains) and not contains(a)
        implies ideal_sum[R](contains, principal_ideal[R](a), R.1)
}

theorem maximal_ideal_prime_step[R: CommRing](contains: R -> Bool, a: R, b: R) {
    is_maximal_ideal(contains) and contains(a * b) and not contains(a) implies contains(b)
}

theorem maximal_ideal_prime_constraint[R: CommRing](contains: R -> Bool) {
    is_maximal_ideal(contains) implies ideal_prime_constraint(contains)
}

theorem is_maximal_ideal_implies_prime[R: CommRing](contains: R -> Bool) {
    is_maximal_ideal(contains) implies is_prime_ideal(contains)
}

theorem is_maximal_ideal_mem[R: CommRing](contains: R -> Bool, a: R, b: R) {
    is_maximal_ideal(contains) and contains(a * b) implies contains(a) or contains(b)
}

theorem prime_ideal_is_ideal[R: CommRing](p: PrimeIdeal[R]) {
    is_ideal(p.contains)
}

theorem prime_ideal_ext[R: CommRing](a: PrimeIdeal[R], b: PrimeIdeal[R]) {
    (forall(x: R) { a.contains(x) = b.contains(x) }) implies a = b
}

theorem prime_ideal_not_contains_one[R: CommRing](p: PrimeIdeal[R]) {
    not p.contains(R.1)
}

theorem prime_ideal_contains_mul[R: CommRing](p: PrimeIdeal[R], a: R, b: R) {
    p.contains(a * b) implies p.contains(a) or p.contains(b)
}

let prime_ideal_as_ideal[R: CommRing](p: PrimeIdeal[R]) -> result: Ideal[R] satisfy {
    Ideal.new(p.contains) = Option.some(result)
}

attributes PrimeIdeal[R: CommRing] {
    /// Prime ideal extensionality from pointwise equality of membership.
    let ext = prime_ideal_ext[R]

    /// The bundled ideal obtained by forgetting the prime structure.
    let as_ideal: PrimeIdeal[R] -> Ideal[R] = prime_ideal_as_ideal[R]
}

theorem maximal_ideal_is_ideal[R: CommRing](m: MaximalIdeal[R]) {
    is_ideal(m.contains)
}

theorem maximal_ideal_is_prime[R: CommRing](m: MaximalIdeal[R]) {
    is_prime_ideal(m.contains)
}

theorem maximal_ideal_ext[R: CommRing](a: MaximalIdeal[R], b: MaximalIdeal[R]) {
    (forall(x: R) { a.contains(x) = b.contains(x) }) implies a = b
}

theorem maximal_ideal_not_contains_one[R: CommRing](m: MaximalIdeal[R]) {
    not m.contains(R.1)
}

theorem maximal_ideal_contains_mul[R: CommRing](m: MaximalIdeal[R], a: R, b: R) {
    m.contains(a * b) implies m.contains(a) or m.contains(b)
}

theorem maximal_ideal_witness[R: CommRing](m: MaximalIdeal[R], other: R -> Bool) {
    is_ideal(other) and ideal_subset(m.contains, other) and ideal_proper_constraint(other)
        implies ideal_subset(other, m.contains)
}

let maximal_ideal_as_ideal[R: CommRing](m: MaximalIdeal[R]) -> result: Ideal[R] satisfy {
    Ideal.new(m.contains) = Option.some(result)
}

let maximal_ideal_as_prime_ideal[R: CommRing](m: MaximalIdeal[R]) -> result: PrimeIdeal[R] satisfy {
    PrimeIdeal.new(m.contains) = Option.some(result)
}

attributes MaximalIdeal[R: CommRing] {
    /// Maximal ideal extensionality from pointwise equality of membership.
    let ext = maximal_ideal_ext[R]

    /// The bundled ideal obtained by forgetting the maximal structure.
    let as_ideal: MaximalIdeal[R] -> Ideal[R] = maximal_ideal_as_ideal[R]

    /// The bundled prime ideal obtained from a maximal ideal.
    let as_prime_ideal: MaximalIdeal[R] -> PrimeIdeal[R] = maximal_ideal_as_prime_ideal[R]
}

theorem prime_ideal_as_ideal_contains_eq[R: CommRing](p: PrimeIdeal[R], x: R) {
    p.as_ideal.contains(x) = p.contains(x)
}

theorem maximal_ideal_as_ideal_contains_eq[R: CommRing](m: MaximalIdeal[R], x: R) {
    m.as_ideal.contains(x) = m.contains(x)
}

theorem maximal_ideal_as_prime_ideal_contains_eq[R: CommRing](m: MaximalIdeal[R], x: R) {
    m.as_prime_ideal.contains(x) = m.contains(x)
}

define ideal_preimage_contains[R: CommRing, S: CommRing](
    f: RingHom[R, S], i: Ideal[S], x: R
) -> Bool {
    i.contains(f.hom(x))
}

theorem ideal_preimage_zero_constraint[R: CommRing, S: CommRing](
    f: RingHom[R, S], i: Ideal[S]
) {
    ideal_zero_constraint(ideal_preimage_contains(f, i))
}

theorem ideal_preimage_add_constraint[R: CommRing, S: CommRing](
    f: RingHom[R, S], i: Ideal[S]
) {
    ideal_add_constraint(ideal_preimage_contains(f, i))
}

theorem ideal_preimage_absorb_constraint[R: CommRing, S: CommRing](
    f: RingHom[R, S], i: Ideal[S]
) {
    ideal_absorb_constraint(ideal_preimage_contains(f, i))
}

theorem ideal_preimage_is_ideal[R: CommRing, S: CommRing](
    f: RingHom[R, S], i: Ideal[S]
) {
    is_ideal(ideal_preimage_contains(f, i))
}

let ideal_preimage[R: CommRing, S: CommRing](f: RingHom[R, S], i: Ideal[S]) -> result: Ideal[R] satisfy {
    Ideal.new(ideal_preimage_contains(f, i)) = Option.some(result)
}

theorem ideal_preimage_contains_eq[R: CommRing, S: CommRing](
    f: RingHom[R, S], i: Ideal[S], x: R
) {
    ideal_preimage(f, i).contains(x) = i.contains(f.hom(x))
}

theorem ideal_preimage_contains_of_contains_map[R: CommRing, S: CommRing](
    f: RingHom[R, S], i: Ideal[S], x: R
) {
    i.contains(f.hom(x)) implies ideal_preimage(f, i).contains(x)
}

theorem ideal_contains_map_of_preimage_contains[R: CommRing, S: CommRing](
    f: RingHom[R, S], i: Ideal[S], x: R
) {
    ideal_preimage(f, i).contains(x) implies i.contains(f.hom(x))
}

theorem ideal_preimage_subset_of_subset[R: CommRing, S: CommRing](
    f: RingHom[R, S], i: Ideal[S], j: Ideal[S]
) {
    bundled_ideal_subset(i, j) implies
        bundled_ideal_subset(ideal_preimage(f, i), ideal_preimage(f, j))
}

theorem ideal_preimage_unit_eq_unit[R: CommRing, S: CommRing](f: RingHom[R, S]) {
    ideal_preimage(f, Ideal[S].unit) = Ideal[R].unit
}

theorem ideal_preimage_prime_is_prime[R: CommRing, S: CommRing](
    f: RingHom[R, S], p: PrimeIdeal[S]
) {
    is_prime_ideal(ideal_preimage_contains(f, p.as_ideal))
}

let prime_ideal_preimage[R: CommRing, S: CommRing](f: RingHom[R, S], p: PrimeIdeal[S]) -> result: PrimeIdeal[R] satisfy {
    PrimeIdeal.new(ideal_preimage_contains(f, p.as_ideal)) = Option.some(result)
}

theorem prime_ideal_preimage_contains_eq[R: CommRing, S: CommRing](
    f: RingHom[R, S], p: PrimeIdeal[S], x: R
) {
    prime_ideal_preimage(f, p).contains(x) = p.contains(f.hom(x))
}

theorem integral_domain_mul_left_cancel[D: IntegralDomain](a: D, b: D, c: D) {
    a != D.0 and a * b = a * c implies b = c
}

theorem integral_domain_mul_right_cancel[D: IntegralDomain](a: D, b: D, c: D) {
    c != D.0 and a * c = b * c implies a = b
}

theorem integral_domain_mul_eq_zero[D: IntegralDomain](a: D, b: D) {
    a * b = D.0 implies a = D.0 or b = D.0
}

theorem integral_domain_mul_eq_zero_of_factor[D: IntegralDomain](a: D, b: D) {
    a = D.0 or b = D.0 implies a * b = D.0
}

theorem integral_domain_mul_nonzero[D: IntegralDomain](a: D, b: D) {
    a != D.0 and b != D.0 implies a * b != D.0
}

theorem integral_domain_left_nonzero_of_mul_nonzero[D: IntegralDomain](a: D, b: D) {
    a * b != D.0 implies a != D.0
}

theorem integral_domain_right_nonzero_of_mul_nonzero[D: IntegralDomain](a: D, b: D) {
    a * b != D.0 implies b != D.0
}

theorem integral_domain_square_nonzero[D: IntegralDomain](a: D) {
    a != D.0 implies a * a != D.0
}

theorem integral_domain_pow_suc_nonzero[D: IntegralDomain](a: D, k: Nat) {
    a != D.0 and a.pow(k) != D.0 implies a.pow(k.suc) != D.0
}

theorem integral_domain_pow_nonzero[D: IntegralDomain](a: D, n: Nat) {
    a != D.0 implies a.pow(n) != D.0
}

theorem zero_ideal_is_prime_of_integral_domain[D: IntegralDomain] {
    is_prime_ideal(zero_ideal[D])
}

theorem no_zero_divisors_of_zero_ideal_prime[R: CommRing](a: R, b: R) {
    is_prime_ideal(zero_ideal[R]) and a * b = R.0 implies a = R.0 or b = R.0
}

theorem integral_domain_mul_left_cancel_iff[D: IntegralDomain](a: D, b: D, c: D) {
    a != D.0 implies ((a * b = a * c) = (b = c))
}

theorem integral_domain_mul_right_cancel_iff[D: IntegralDomain](a: D, b: D, c: D) {
    a != D.0 implies ((b * a = c * a) = (b = c))
}

theorem integral_domain_mul_eq_zero_iff[D: IntegralDomain](a: D, b: D) {
    (a * b = D.0) = (a = D.0 or b = D.0)
}

theorem integral_domain_sq_eq_zero_iff[D: IntegralDomain](a: D) {
    (a * a = D.0) = (a = D.0)
}

theorem integral_domain_pow_eq_zero_iff[D: IntegralDomain](a: D, n: Nat) {
    n != Nat.0 implies ((a.pow(n) = D.0) = (a = D.0))
}

theorem integral_domain_nilpotent_zero[D: IntegralDomain](a: D) {
    is_nilpotent[D](a) implies a = D.0
}

theorem add_monoid_hom_kernel_step[A: AddMonoid, B: AddMonoid](f: A -> B, x1: A, y1: A, x2: A, y2: A) {
    is_add_monoid_hom(f) and kernel_relation(f, x1, y1) and kernel_relation(f, x2, y2)
    implies kernel_relation(f, x1 + x2, y1 + y2)
}

theorem add_group_hom_kernel_step[A: AddGroup, B: AddGroup](f: AddGroupHom[A, B], x1: A, y1: A, x2: A, y2: A) {
    kernel_relation(f.hom, x1, y1) and kernel_relation(f.hom, x2, y2)
    implies kernel_relation(f.hom, x1 + x2, y1 + y2)
}

theorem add_group_hom_kernel_respects_neg[A: AddGroup, B: AddGroup](f: AddGroupHom[A, B]) {
    respects_unary_op(kernel_relation(f.hom), A.neg)
}

theorem add_group_hom_kernel_respects_sub[A: AddGroup, B: AddGroup](f: AddGroupHom[A, B]) {
