theorem group_hom_kernel_quotient_induced_surjective_onto_image[G: Group, H: Group](
    f: GroupHom[G, H], a: G
) {
    exists(q: QuotientOver[G]) {
        group_hom_kernel_quotient_induced(f, q) = f.hom(a)
