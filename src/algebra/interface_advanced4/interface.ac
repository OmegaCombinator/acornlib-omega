    kernel_relation(f.hom, b1, b2) implies
    semiring_hom_kernel_quotient_mul(f,
        quotient_over_mk(kernel_quotient_relation(f.hom), a),
        quotient_over_mk(kernel_quotient_relation(f.hom), b1)
