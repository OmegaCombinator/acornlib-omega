}

theorem lie_subalgebra_carrier[R: CommRing, L: AddCommGroup](s: LieSubalgebra[R, L]) {
    s.submodule.carrier = s.ambient.module
}

theorem lie_subalgebra_has_bracket_constraint[R: CommRing, L: AddCommGroup](
    s: LieSubalgebra[R, L]
