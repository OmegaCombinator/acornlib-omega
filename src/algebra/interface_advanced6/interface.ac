theorem lie_bracket_jacobi_cyclic_right[R: CommRing, L: AddCommGroup](
    a: LieAlgebra[R, L], x: L, y: L, z: L
) {
    (a.bracket(z, a.bracket(x, y)) + a.bracket(x, a.bracket(y, z))) + a.bracket(y, a.bracket(z, x)) = L.0
}

