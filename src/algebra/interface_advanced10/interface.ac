theorem ideal_image_contains_hom[R: CommRing, S: CommRing](f: RingHom[R, S], i: Ideal[R], x: R) {
    i.contains(x) implies ideal_image(f, i).contains(f.hom(x))
}

theorem ideal_subset_preimage_of_image_subset[R: CommRing, S: CommRing](
    f: RingHom[R, S], i: Ideal[R], j: Ideal[S]
) {
    bundled_ideal_subset(ideal_image(f, i), j) implies bundled_ideal_subset(i, ideal_preimage(f, j))
}

theorem ideal_image_subset_of_subset_preimage[R: CommRing, S: CommRing](
    f: RingHom[R, S], i: Ideal[R], j: Ideal[S]
) {
    bundled_ideal_subset(i, ideal_preimage(f, j)) implies bundled_ideal_subset(ideal_image(f, i), j)
}

theorem ideal_image_subset_iff_subset_preimage[R: CommRing, S: CommRing](
    f: RingHom[R, S], i: Ideal[R], j: Ideal[S]
) {
    bundled_ideal_subset(ideal_image(f, i), j) = bundled_ideal_subset(i, ideal_preimage(f, j))
}

theorem ideal_preimage_identity[R: CommRing](i: Ideal[R]) {
    ideal_preimage(identity_ring_hom[R], i) = i
}

theorem ideal_preimage_compose[R: CommRing, S: CommRing, T: CommRing](
    f: RingHom[S, T], g: RingHom[R, S], i: Ideal[T]
) {
    ideal_preimage(compose_ring_hom(f, g), i) = ideal_preimage(g, ideal_preimage(f, i))
}

theorem ring_hom_kernel_compose_eq_preimage[R: CommRing, S: CommRing, T: CommRing](
    f: RingHom[S, T], g: RingHom[R, S]
) {
    ring_hom_kernel(compose_ring_hom(f, g)) = ideal_preimage(g, ring_hom_kernel(f))
}

theorem bundled_ideal_subset_kernel_compose_iff_preimage_kernel[R: CommRing, S: CommRing, T: CommRing](
    i: Ideal[R], f: RingHom[S, T], g: RingHom[R, S]
) {
    bundled_ideal_subset(i, ring_hom_kernel(compose_ring_hom(f, g))) =
        bundled_ideal_subset(i, ideal_preimage(g, ring_hom_kernel(f)))
}

theorem ideal_preimage_subset_kernel_compose_of_subset_kernel[R: CommRing, S: CommRing, T: CommRing](
    f: RingHom[S, T], g: RingHom[R, S], j: Ideal[S]
) {
    bundled_ideal_subset(j, ring_hom_kernel(f)) implies
        bundled_ideal_subset(ideal_preimage(g, j), ring_hom_kernel(compose_ring_hom(f, g)))
}

theorem ideal_subset_preimage_image[R: CommRing, S: CommRing](
    f: RingHom[R, S], i: Ideal[R]
) {
    bundled_ideal_subset(i, ideal_preimage(f, ideal_image(f, i)))
}

theorem ideal_image_preimage_subset[R: CommRing, S: CommRing](
    f: RingHom[R, S], j: Ideal[S]
) {
    bundled_ideal_subset(ideal_image(f, ideal_preimage(f, j)), j)
}

theorem ideal_image_mono[R: CommRing, S: CommRing](
    f: RingHom[R, S], i: Ideal[R], j: Ideal[R]
) {
    bundled_ideal_subset(i, j) implies bundled_ideal_subset(ideal_image(f, i), ideal_image(f, j))
}

theorem ideal_image_subset_zero_iff_subset_kernel[R: CommRing, S: CommRing](
    f: RingHom[R, S], i: Ideal[R]
) {
    bundled_ideal_subset(ideal_image(f, i), Ideal[S].zero) =
        bundled_ideal_subset(i, ring_hom_kernel(f))
}

theorem ideal_image_subset_kernel_iff_subset_kernel_compose[R: CommRing, S: CommRing, T: CommRing](
    f: RingHom[S, T], g: RingHom[R, S], i: Ideal[R]
) {
    bundled_ideal_subset(ideal_image(g, i), ring_hom_kernel(f)) =
        bundled_ideal_subset(i, ring_hom_kernel(compose_ring_hom(f, g)))
}

theorem semiring_hom_is_ring_hom[R: Ring, S: Ring](f: SemiringHom[R, S]) {
    is_ring_hom(f.hom)
}

let semiring_hom_to_ring_hom[R: Ring, S: Ring](f: SemiringHom[R, S]) -> result: RingHom[R, S] satisfy {
    RingHom.new(f.hom) = Option.some(result)
}

theorem semiring_hom_to_ring_hom_hom[R: Ring, S: Ring](f: SemiringHom[R, S]) {
    semiring_hom_to_ring_hom(f).hom = f.hom
}

theorem ring_to_semiring_to_ring_hom[R: Ring, S: Ring](f: RingHom[R, S]) {
    semiring_hom_to_ring_hom(ring_hom_to_semiring_hom(f)) = f
}

theorem semiring_to_ring_to_semiring_hom[R: Ring, S: Ring](f: SemiringHom[R, S]) {
    ring_hom_to_semiring_hom(semiring_hom_to_ring_hom(f)) = f
}

theorem semiring_hom_ring_neg[R: Ring, S: Ring](f: SemiringHom[R, S], a: R) {
    f.hom(-a) = -f.hom(a)
}

structure Spec[R: CommRing] {
    /// The prime ideal of `R` that this point of the spectrum represents.
    point: PrimeIdeal[R]
}

theorem spec_ext[R: CommRing](a: Spec[R], b: Spec[R]) {
    a.point = b.point implies a = b
}

theorem spec_ext_contains[R: CommRing](a: Spec[R], b: Spec[R]) {
    (forall(x: R) { a.point.contains(x) = b.point.contains(x) }) implies a = b
}

define spec_of_prime[R: CommRing](p: PrimeIdeal[R]) -> Spec[R] {
    Spec[R].new(p)
}

theorem spec_of_prime_point[R: CommRing](p: PrimeIdeal[R]) {
    spec_of_prime(p).point = p
}

attributes Spec[R: CommRing] {
    /// Extensionality: equality of points reduces to equality of prime ideals.
    let ext = spec_ext[R]

    /// Extensionality via membership predicates.
    let ext_contains = spec_ext_contains[R]

    /// The point of `Spec(R)` corresponding to a prime ideal of `R`.
    let of_prime: PrimeIdeal[R] -> Spec[R] = spec_of_prime[R]
}

theorem spec_of_prime_eq[R: CommRing](p: PrimeIdeal[R], q: PrimeIdeal[R]) {
    Spec[R].of_prime(p) = Spec[R].of_prime(q) implies p = q
}

define spec_of_maximal[R: CommRing](m: MaximalIdeal[R]) -> Spec[R] {
    Spec[R].of_prime(m.as_prime_ideal)
}

define spec_in_vanishing[R: CommRing](i: Ideal[R], p: Spec[R]) -> Bool {
    bundled_ideal_subset(i, p.point.as_ideal)
}

define spec_vanishing[R: CommRing](i: Ideal[R]) -> Set[Spec[R]] {
    Set[Spec[R]].new(function(p: Spec[R]) {
        spec_in_vanishing(i, p)
    })
}

attributes Spec[R: CommRing] {
    /// The point of `Spec(R)` corresponding to a maximal ideal of `R`.
    let of_maximal: MaximalIdeal[R] -> Spec[R] = spec_of_maximal[R]

    /// The vanishing set `V(I)` of an ideal of `R`.
    let vanishing: Ideal[R] -> Set[Spec[R]] = spec_vanishing[R]
}

theorem spec_vanishing_contains_eq[R: CommRing](i: Ideal[R], p: Spec[R]) {
    Spec[R].vanishing(i).contains(p) = bundled_ideal_subset(i, p.point.as_ideal)
}

theorem spec_vanishing_antitone[R: CommRing](i: Ideal[R], j: Ideal[R]) {
    bundled_ideal_subset(i, j) implies Spec[R].vanishing(j).subset(Spec[R].vanishing(i))
}

theorem spec_vanishing_zero[R: CommRing] {
    Spec[R].vanishing(Ideal[R].zero) = Set[Spec[R]].universal_set
}

theorem spec_vanishing_unit[R: CommRing] {
    Spec[R].vanishing(Ideal[R].unit) = Set[Spec[R]].empty_set
}

theorem spec_vanishing_sum_subset_inter[R: CommRing](i: Ideal[R], j: Ideal[R]) {
    Spec[R].vanishing(i.sum(j)).subset(Spec[R].vanishing(i).intersection(Spec[R].vanishing(j)))
}

theorem spec_vanishing_inter_subset_sum[R: CommRing](i: Ideal[R], j: Ideal[R]) {
    Spec[R].vanishing(i).intersection(Spec[R].vanishing(j)).subset(Spec[R].vanishing(i.sum(j)))
}

theorem spec_vanishing_sum[R: CommRing](i: Ideal[R], j: Ideal[R]) {
    Spec[R].vanishing(i.sum(j)) = Spec[R].vanishing(i).intersection(Spec[R].vanishing(j))
}

theorem spec_of_maximal_point[R: CommRing](m: MaximalIdeal[R]) {
    Spec[R].of_maximal(m).point = m.as_prime_ideal
}

theorem spec_vanishing_principal_contains_eq[R: CommRing](f: R, p: Spec[R]) {
    Spec[R].vanishing(Ideal[R].principal(f)).contains(p) = p.point.contains(f)
}

theorem spec_vanishing_principal_zero[R: CommRing] {
    Spec[R].vanishing(Ideal[R].principal(R.0)) = Set[Spec[R]].universal_set
}

theorem spec_vanishing_principal_one[R: CommRing] {
    Spec[R].vanishing(Ideal[R].principal(R.1)) = Set[Spec[R]].empty_set
}

define spec_basic_open[R: CommRing](f: R) -> Set[Spec[R]] {
    Spec[R].vanishing(Ideal[R].principal(f)).c
}

attributes Spec[R: CommRing] {
    /// The distinguished open set `D(f)` complementary to `V(principal(f))`.
    let basic_open: R -> Set[Spec[R]] = spec_basic_open[R]
}

theorem spec_basic_open_contains_eq[R: CommRing](f: R, p: Spec[R]) {
    Spec[R].basic_open(f).contains(p) = not p.point.contains(f)
}

theorem spec_basic_open_zero[R: CommRing] {
    Spec[R].basic_open(R.0) = Set[Spec[R]].empty_set
}

theorem spec_basic_open_one[R: CommRing] {
    Spec[R].basic_open(R.1) = Set[Spec[R]].universal_set
}

theorem spec_vanishing_union_subset_inter[R: CommRing](i: Ideal[R], j: Ideal[R]) {
    Spec[R].vanishing(i).union(Spec[R].vanishing(j)).subset(Spec[R].vanishing(i.intersection(j)))
}

theorem spec_vanishing_inter_subset_union[R: CommRing](i: Ideal[R], j: Ideal[R]) {
    Spec[R].vanishing(i.intersection(j)).subset(
        Spec[R].vanishing(i).union(Spec[R].vanishing(j)))
}

theorem spec_vanishing_union_eq_inter[R: CommRing](i: Ideal[R], j: Ideal[R]) {
    Spec[R].vanishing(i).union(Spec[R].vanishing(j)) =
        Spec[R].vanishing(i.intersection(j))
}

theorem spec_basic_open_compl[R: CommRing](f: R) {
    Spec[R].basic_open(f).c = Spec[R].vanishing(Ideal[R].principal(f))
}

theorem spec_vanishing_principal_compl[R: CommRing](f: R) {
    Spec[R].vanishing(Ideal[R].principal(f)).c = Spec[R].basic_open(f)
}

theorem spec_vanishing_compl_inter[R: CommRing](i: Ideal[R], j: Ideal[R]) {
    Spec[R].vanishing(i).c.intersection(Spec[R].vanishing(j).c) =
        Spec[R].vanishing(i.intersection(j)).c
}

theorem spec_of_prime_inj[R: CommRing](p: PrimeIdeal[R], q: PrimeIdeal[R]) {
    Spec[R].of_prime(p) = Spec[R].of_prime(q) implies p = q
}

define spec_vanishing_family[R: CommRing, I](family: I -> Ideal[R], i: I) -> Set[Spec[R]] {
    Spec[R].vanishing(family(i))
}

theorem spec_vanishing_indexed_union_subset_inter[R: CommRing, I](family: I -> Ideal[R]) {
    indexed_union(spec_vanishing_family(family)).subset(
        Spec[R].vanishing(ideal_indexed_inter(family)))
}

theorem spec_basic_open_mul[R: CommRing](f: R, g: R) {
    Spec[R].basic_open(f * g) = Spec[R].basic_open(f).intersection(Spec[R].basic_open(g))
}

theorem spec_of_prime_in_vanishing[R: CommRing](i: Ideal[R], p: PrimeIdeal[R]) {
    Spec[R].vanishing(i).contains(Spec[R].of_prime(p)) = bundled_ideal_subset(i, p.as_ideal)
}

theorem spec_of_maximal_in_vanishing[R: CommRing](i: Ideal[R], m: MaximalIdeal[R]) {
    Spec[R].vanishing(i).contains(Spec[R].of_maximal(m)) =
        bundled_ideal_subset(i, m.as_prime_ideal.as_ideal)
}

theorem spec_vanishing_zero_compl[R: CommRing] {
    Spec[R].vanishing(Ideal[R].zero).c = Set[Spec[R]].empty_set
}

theorem spec_vanishing_unit_compl[R: CommRing] {
    Spec[R].vanishing(Ideal[R].unit).c = Set[Spec[R]].universal_set
}

theorem spec_vanishing_sum_compl[R: CommRing](i: Ideal[R], j: Ideal[R]) {
    Spec[R].vanishing(i.sum(j)).c =
        Spec[R].vanishing(i).c.union(Spec[R].vanishing(j).c)
}

theorem spec_basic_open_subset_one[R: CommRing](f: R) {
    Spec[R].basic_open(f).subset(Spec[R].basic_open(R.1))
}

theorem spec_basic_open_mul_subset_left[R: CommRing](f: R, g: R) {
    Spec[R].basic_open(f * g).subset(Spec[R].basic_open(f))
}

theorem spec_basic_open_mul_subset_right[R: CommRing](f: R, g: R) {
    Spec[R].basic_open(f * g).subset(Spec[R].basic_open(g))
}

define spec_zariski_closed[R: CommRing](s: Set[Spec[R]]) -> Bool {
    exists(i: Ideal[R]) {
        s = Spec[R].vanishing(i)
    }
}

theorem spec_zariski_closed_empty[R: CommRing] {
    spec_zariski_closed(Set[Spec[R]].empty_set)
}

theorem spec_zariski_closed_universal[R: CommRing] {
    spec_zariski_closed(Set[Spec[R]].universal_set)
}

theorem spec_zariski_closed_vanishing[R: CommRing](i: Ideal[R]) {
    spec_zariski_closed(Spec[R].vanishing(i))
}

theorem spec_zariski_closed_inter[R: CommRing](s: Set[Spec[R]], t: Set[Spec[R]]) {
    spec_zariski_closed(s) and spec_zariski_closed(t)
        implies spec_zariski_closed(s.intersection(t))
}

theorem spec_zariski_closed_union[R: CommRing](s: Set[Spec[R]], t: Set[Spec[R]]) {
    spec_zariski_closed(s) and spec_zariski_closed(t)
        implies spec_zariski_closed(s.union(t))
}

define spec_basic_open_family[R: CommRing](s: Set[Spec[R]]) -> Bool {
    exists(f: R) {
        s = Spec[R].basic_open(f)
    }
}

theorem spec_basic_open_family_member[R: CommRing](f: R) {
    spec_basic_open_family(Spec[R].basic_open(f))
}

theorem spec_basic_open_family_inter_member[R: CommRing](f: R, g: R) {
    spec_basic_open_family(Spec[R].basic_open(f).intersection(Spec[R].basic_open(g)))
}

theorem spec_basic_open_family_inter[R: CommRing](s: Set[Spec[R]], t: Set[Spec[R]]) {
    spec_basic_open_family(s) and spec_basic_open_family(t)
        implies spec_basic_open_family(s.intersection(t))
}

define spec_zariski_open[R: CommRing](s: Set[Spec[R]]) -> Bool {
    exists(i: Ideal[R]) {
        s = Spec[R].vanishing(i).c
    }
}

theorem spec_zariski_open_vanishing_compl[R: CommRing](i: Ideal[R]) {
    spec_zariski_open(Spec[R].vanishing(i).c)
}

theorem spec_zariski_open_empty[R: CommRing] {
    spec_zariski_open(Set[Spec[R]].empty_set)
}

theorem spec_zariski_open_universal[R: CommRing] {
    spec_zariski_open(Set[Spec[R]].universal_set)
}

theorem spec_zariski_open_basic[R: CommRing](f: R) {
    spec_zariski_open(Spec[R].basic_open(f))
}

theorem spec_zariski_open_inter[R: CommRing](s: Set[Spec[R]], t: Set[Spec[R]]) {
    spec_zariski_open(s) and spec_zariski_open(t)
        implies spec_zariski_open(s.intersection(t))
}

theorem spec_zariski_open_union[R: CommRing](s: Set[Spec[R]], t: Set[Spec[R]]) {
    spec_zariski_open(s) and spec_zariski_open(t)
        implies spec_zariski_open(s.union(t))
}

theorem spec_of_maximal_inj[R: CommRing](m: MaximalIdeal[R], n: MaximalIdeal[R]) {
    Spec[R].of_maximal(m) = Spec[R].of_maximal(n) implies m.as_prime_ideal = n.as_prime_ideal
}

define subring_zero_constraint[R: Ring](contains: R -> Bool) -> Bool {
    contains(R.0)
}

define subring_one_constraint[R: Ring](contains: R -> Bool) -> Bool {
    contains(R.1)
}

define subring_add_constraint[R: Ring](contains: R -> Bool) -> Bool {
    forall(a: R, b: R) {
        contains(a) and contains(b) implies contains(a + b)
    }
}

define subring_neg_constraint[R: Ring](contains: R -> Bool) -> Bool {
    forall(a: R) {
        contains(a) implies contains(-a)
    }
}

define subring_mul_constraint[R: Ring](contains: R -> Bool) -> Bool {
    forall(a: R, b: R) {
        contains(a) and contains(b) implies contains(a * b)
    }
}

define subring_constraint[R: Ring](contains: R -> Bool) -> Bool {
    subring_zero_constraint(contains) and subring_one_constraint(contains) and
        subring_add_constraint(contains) and subring_neg_constraint(contains) and
        subring_mul_constraint(contains)
}

structure Subring[R: Ring] {
    /// True if the given element is a member of this subring.
    contains: R -> Bool
} constraint {
    subring_constraint(contains)
}

theorem subring_ext[R: Ring](a: Subring[R], b: Subring[R]) {
    (forall(x: R) { a.contains(x) = b.contains(x) }) implies a = b
}

theorem subring_eq_contains[R: Ring](a: Subring[R], b: Subring[R]) {
    a = b implies a.contains = b.contains
}

theorem subring_eq_contains_at[R: Ring](a: Subring[R], b: Subring[R], x: R) {
    a = b implies a.contains(x) = b.contains(x)
}

theorem subring_eq_transport_predicate[R: Ring](
    p: Subring[R] -> Bool,
    a: Subring[R],
    b: Subring[R]
) {
    a = b and p(a) implies p(b)
}

theorem subring_eq_transport_predicate_rev[R: Ring](
    p: Subring[R] -> Bool,
    a: Subring[R],
    b: Subring[R]
) {
    a = b and p(b) implies p(a)
}

theorem subring_eq_of_contains_eq[R: Ring](a: Subring[R], b: Subring[R]) {
    a.contains = b.contains implies a = b
}

theorem subring_eq_of_contains_at_eq[R: Ring](a: Subring[R], b: Subring[R]) {
    (forall(x: R) { a.contains(x) = b.contains(x) }) implies a = b
}

theorem subring_contains_zero[R: Ring](s: Subring[R]) {
    s.contains(R.0)
}

theorem subring_contains_one[R: Ring](s: Subring[R]) {
    s.contains(R.1)
}

theorem subring_contains_add[R: Ring](s: Subring[R], a: R, b: R) {
    s.contains(a) and s.contains(b) implies s.contains(a + b)
}

theorem subring_contains_neg[R: Ring](s: Subring[R], a: R) {
    s.contains(a) implies s.contains(-a)
}

theorem subring_contains_sub[R: Ring](s: Subring[R], a: R, b: R) {
    s.contains(a) and s.contains(b) implies s.contains(a - b)
}

theorem subring_contains_mul[R: Ring](s: Subring[R], a: R, b: R) {
    s.contains(a) and s.contains(b) implies s.contains(a * b)
}

define subring_intersection_contains[R: Ring](a: Subring[R], b: Subring[R], x: R) -> Bool {
    a.contains(x) and b.contains(x)
}

theorem subring_intersection_zero_constraint[R: Ring](a: Subring[R], b: Subring[R]) {
    subring_zero_constraint(subring_intersection_contains(a, b))
}

theorem subring_intersection_one_constraint[R: Ring](a: Subring[R], b: Subring[R]) {
    subring_one_constraint(subring_intersection_contains(a, b))
}

theorem subring_intersection_add_constraint[R: Ring](a: Subring[R], b: Subring[R]) {
    subring_add_constraint(subring_intersection_contains(a, b))
}

theorem subring_intersection_neg_constraint[R: Ring](a: Subring[R], b: Subring[R]) {
    subring_neg_constraint(subring_intersection_contains(a, b))
}

theorem subring_intersection_mul_constraint[R: Ring](a: Subring[R], b: Subring[R]) {
    subring_mul_constraint(subring_intersection_contains(a, b))
}

theorem subring_intersection_constraint[R: Ring](a: Subring[R], b: Subring[R]) {
    subring_constraint(subring_intersection_contains(a, b))
}

let subring_intersection[R: Ring](a: Subring[R], b: Subring[R]) -> result: Subring[R] satisfy {
    Subring.new(subring_intersection_contains(a, b)) = Option.some(result)
}

attributes Subring[R: Ring] {
    /// Subring extensionality from pointwise equality of membership.
    let ext = subring_ext[R]

    /// The subset of ring elements belonging to this subring.
    define as_set(self) -> Set[R] {
        Set[R].new(self.contains)
    }

    /// The common part of two subrings.
    let intersection: (Subring[R], Subring[R]) -> Subring[R] = subring_intersection
}

theorem subring_as_set_contains_eq[R: Ring](s: Subring[R], x: R) {
    s.as_set.contains(x) = s.contains(x)
}

theorem subring_contains_as_set_eq[R: Ring](s: Subring[R], x: R) {
    s.contains(x) = s.as_set.contains(x)
}

theorem subring_eq_as_set[R: Ring](a: Subring[R], b: Subring[R]) {
    a = b implies a.as_set = b.as_set
}

theorem subring_intersection_contains_eq[R: Ring](a: Subring[R], b: Subring[R], x: R) {
    a.intersection(b).contains(x) = (a.contains(x) and b.contains(x))
}

theorem subring_intersection_subset_left[R: Ring](a: Subring[R], b: Subring[R], x: R) {
    a.intersection(b).contains(x) implies a.contains(x)
}

theorem subring_intersection_subset_right[R: Ring](a: Subring[R], b: Subring[R], x: R) {
    a.intersection(b).contains(x) implies b.contains(x)
}

theorem subring_intersection_comm[R: Ring](a: Subring[R], b: Subring[R]) {
    a.intersection(b) = b.intersection(a)
}

theorem subring_intersection_assoc[R: Ring](a: Subring[R], b: Subring[R], c: Subring[R]) {
    a.intersection(b).intersection(c) = a.intersection(b.intersection(c))
}

theorem subring_intersection_idempotent[R: Ring](a: Subring[R]) {
    a.intersection(a) = a
}

define subring_subset[R: Ring](a: Subring[R], b: Subring[R]) -> Bool {
    forall(x: R) {
        a.contains(x) implies b.contains(x)
    }
}

theorem subring_subset_as_set_eq[R: Ring](a: Subring[R], b: Subring[R]) {
    subring_subset(a, b) = a.as_set.subset(b.as_set)
}

theorem subring_as_set_subset_of_subset[R: Ring](a: Subring[R], b: Subring[R]) {
    subring_subset(a, b) implies a.as_set.subset(b.as_set)
}

theorem subring_subset_of_as_set_subset[R: Ring](a: Subring[R], b: Subring[R]) {
    a.as_set.subset(b.as_set) implies subring_subset(a, b)
}

theorem subring_subset_refl[R: Ring](a: Subring[R]) {
