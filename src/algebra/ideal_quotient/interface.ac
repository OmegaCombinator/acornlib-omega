            normal_subgroup_quotient_project(s, a),
            normal_subgroup_quotient_project(s, b)),
        normal_subgroup_quotient_project(s, c)) =
    normal_subgroup_quotient_mul(s,
        normal_subgroup_quotient_project(s, a),
        normal_subgroup_quotient_mul(s,
            normal_subgroup_quotient_project(s, b),
            normal_subgroup_quotient_project(s, c)))
