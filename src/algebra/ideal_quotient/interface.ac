let subring_preimage[R: Ring, S: Ring](f: RingHom[R, S], t: Subring[S]) -> result: Subring[R] satisfy {
    Subring.new(subring_preimage_contains(f, t)) = Option.some(result)
}

theorem subring_preimage_contains_eq[R: Ring, S: Ring](
    f: RingHom[R, S],
    t: Subring[S],
    a: R
) {
    subring_preimage(f, t).contains(a) = t.contains(f.hom(a))
}

theorem subring_preimage_contains_of_contains_map[R: Ring, S: Ring](
    f: RingHom[R, S],
    t: Subring[S],
    a: R
) {
    t.contains(f.hom(a)) implies subring_preimage(f, t).contains(a)
}

theorem subring_contains_map_of_preimage_contains[R: Ring, S: Ring](
    f: RingHom[R, S],
    t: Subring[S],
    a: R
) {
    subring_preimage(f, t).contains(a) implies t.contains(f.hom(a))
}

theorem subring_preimage_subset_of_subset[R: Ring, S: Ring](
    f: RingHom[R, S],
    t: Subring[S],
    u: Subring[S]
) {
    subring_subset(t, u) implies subring_subset(subring_preimage(f, t), subring_preimage(f, u))
}

theorem subring_preimage_full[R: Ring, S: Ring](f: RingHom[R, S]) {
    subring_preimage(f, full_subring[S]) = full_subring[R]
}

theorem subring_preimage_compose[R: Ring, S: Ring, T: Ring](
    f: RingHom[S, T],
    g: RingHom[R, S],
    u: Subring[T]
) {
    subring_preimage(compose_ring_hom(f, g), u) =
        subring_preimage(g, subring_preimage(f, u))
}

theorem subring_image_subset_iff_subset_preimage[R: Ring, S: Ring](
    f: RingHom[R, S],
    s: Subring[R],
    t: Subring[S]
) {
    subring_subset(subring_image(f, s), t) = subring_subset(s, subring_preimage(f, t))
}

theorem subring_image_identity[R: Ring](s: Subring[R]) {
    subring_image(identity_ring_hom[R], s) = s
}

theorem subring_preimage_identity[R: Ring](s: Subring[R]) {
    subring_preimage(identity_ring_hom[R], s) = s
}

theorem subring_subset_preimage_image[R: Ring, S: Ring](f: RingHom[R, S], s: Subring[R]) {
    subring_subset(s, subring_preimage(f, subring_image(f, s)))
}

theorem subring_image_preimage_subset[R: Ring, S: Ring](f: RingHom[R, S], t: Subring[S]) {
    subring_subset(subring_image(f, subring_preimage(f, t)), t)
}

theorem subring_image_preimage_image_eq[R: Ring, S: Ring](f: RingHom[R, S], s: Subring[R]) {
    subring_image(f, subring_preimage(f, subring_image(f, s))) = subring_image(f, s)
}

theorem subring_preimage_image_preimage_eq[R: Ring, S: Ring](f: RingHom[R, S], t: Subring[S]) {
    subring_preimage(f, subring_image(f, subring_preimage(f, t))) = subring_preimage(f, t)
}

theorem subring_subset_contains_eq[R: Ring](a: Subring[R], b: Subring[R]) {
    subring_subset(a, b) = forall(x: R) {
        a.contains(x) implies b.contains(x)
    }
}

theorem subring_subset_contains[R: Ring](a: Subring[R], b: Subring[R], x: R) {
    subring_subset(a, b) and a.contains(x) implies b.contains(x)
}

theorem subring_subset_of_contains[R: Ring](a: Subring[R], b: Subring[R]) {
    (forall(x: R) { a.contains(x) implies b.contains(x) }) implies subring_subset(a, b)
}

theorem subring_order_subset_refl[R: Ring](a: Subring[R]) {
    subring_subset(a, a)
}

theorem subring_order_subset_trans[R: Ring](a: Subring[R], b: Subring[R], c: Subring[R]) {
    subring_subset(a, b) and subring_subset(b, c) implies subring_subset(a, c)
}

theorem subring_order_subset_antisymm[R: Ring](a: Subring[R], b: Subring[R]) {
    subring_subset(a, b) and subring_subset(b, a) implies a = b
}

theorem subring_closure_monotone[R: Ring](a: Set[R], b: Set[R]) {
    a.subset(b) implies subring_subset(subring_closure(a), subring_closure(b))
}

theorem subring_subset_antisymm_iff_eq[R: Ring](a: Subring[R], b: Subring[R]) {
    (subring_subset(a, b) and subring_subset(b, a)) = (a = b)
}

theorem subsemigroup_subset_contains_eq[S: Semigroup](a: Subsemigroup[S], b: Subsemigroup[S]) {
    subsemigroup_subset(a, b) = forall(x: S) {
        a.contains(x) implies b.contains(x)
    }
}

theorem subsemigroup_subset_contains[S: Semigroup](a: Subsemigroup[S], b: Subsemigroup[S], x: S) {
    subsemigroup_subset(a, b) and a.contains(x) implies b.contains(x)
}

theorem subsemigroup_subset_of_contains[S: Semigroup](a: Subsemigroup[S], b: Subsemigroup[S]) {
    (forall(x: S) { a.contains(x) implies b.contains(x) }) implies subsemigroup_subset(a, b)
}

theorem subsemigroup_order_subset_refl[S: Semigroup](a: Subsemigroup[S]) {
    subsemigroup_subset(a, a)
}

theorem subsemigroup_order_subset_trans[S: Semigroup](
    a: Subsemigroup[S],
    b: Subsemigroup[S],
    c: Subsemigroup[S]
) {
    subsemigroup_subset(a, b) and subsemigroup_subset(b, c) implies subsemigroup_subset(a, c)
}

theorem subsemigroup_order_subset_antisymm[S: Semigroup](a: Subsemigroup[S], b: Subsemigroup[S]) {
    subsemigroup_subset(a, b) and subsemigroup_subset(b, a) implies a = b
}

theorem subsemigroup_closure_monotone[S: Semigroup](a: Set[S], b: Set[S]) {
    a.subset(b) implies subsemigroup_subset(subsemigroup_closure(a), subsemigroup_closure(b))
}

theorem subsemigroup_subset_antisymm_iff_eq[S: Semigroup](a: Subsemigroup[S], b: Subsemigroup[S]) {
    (subsemigroup_subset(a, b) and subsemigroup_subset(b, a)) = (a = b)
}

define subsemiring_zero_constraint[S: Semiring](contains: S -> Bool) -> Bool {
    contains(S.0)
}

define subsemiring_one_constraint[S: Semiring](contains: S -> Bool) -> Bool {
    contains(S.1)
}

define subsemiring_add_constraint[S: Semiring](contains: S -> Bool) -> Bool {
    forall(a: S, b: S) {
        contains(a) and contains(b) implies contains(a + b)
    }
}

define subsemiring_mul_constraint[S: Semiring](contains: S -> Bool) -> Bool {
    forall(a: S, b: S) {
        contains(a) and contains(b) implies contains(a * b)
    }
}

define subsemiring_constraint[S: Semiring](contains: S -> Bool) -> Bool {
    subsemiring_zero_constraint(contains) and subsemiring_one_constraint(contains) and
        subsemiring_add_constraint(contains) and subsemiring_mul_constraint(contains)
}

structure Subsemiring[S: Semiring] {
    /// True if the given element is a member of this subsemiring.
    contains: S -> Bool
} constraint {
    subsemiring_constraint(contains)
}

theorem subsemiring_satisfies_constraint[S: Semiring](s: Subsemiring[S]) {
    subsemiring_constraint(s.contains)
}

theorem subsemiring_satisfies_zero[S: Semiring](s: Subsemiring[S]) {
    subsemiring_zero_constraint(s.contains)
}

theorem subsemiring_satisfies_one[S: Semiring](s: Subsemiring[S]) {
    subsemiring_one_constraint(s.contains)
}

theorem subsemiring_satisfies_add[S: Semiring](s: Subsemiring[S]) {
    forall(a: S, b: S) {
        s.contains(a) and s.contains(b) implies s.contains(a + b)
    }
}

theorem subsemiring_satisfies_mul[S: Semiring](s: Subsemiring[S]) {
    forall(a: S, b: S) {
        s.contains(a) and s.contains(b) implies s.contains(a * b)
    }
}

theorem subsemiring_ext[S: Semiring](a: Subsemiring[S], b: Subsemiring[S]) {
    (forall(x: S) { a.contains(x) = b.contains(x) }) implies a = b
}

theorem subsemiring_eq_contains[S: Semiring](a: Subsemiring[S], b: Subsemiring[S]) {
    a = b implies a.contains = b.contains
}

theorem subsemiring_eq_contains_at[S: Semiring](a: Subsemiring[S], b: Subsemiring[S], x: S) {
    a = b implies a.contains(x) = b.contains(x)
}

theorem subsemiring_eq_of_contains_eq[S: Semiring](a: Subsemiring[S], b: Subsemiring[S]) {
    a.contains = b.contains implies a = b
}
