    (normal_subgroup_quotient_project(s, b) = normal_subgroup_quotient_project(s, c))
}

theorem normal_subgroup_quotient_project_mul_left_eq_iff_rel[G: Group](
    s: Subgroup[G], a: G, b: G, c: G
) {
    is_normal_subgroup(s) implies
    (normal_subgroup_quotient_mul(s,
        normal_subgroup_quotient_project(s, a),
        normal_subgroup_quotient_project(s, b)) =
    normal_subgroup_quotient_mul(s,
        normal_subgroup_quotient_project(s, a),
        normal_subgroup_quotient_project(s, c))) =
    normal_subgroup_rel(s, b, c)
}

theorem normal_subgroup_quotient_project_mul_right_eq_iff_rel[G: Group](
    s: Subgroup[G], a: G, b: G, c: G
) {
    is_normal_subgroup(s) implies
    (normal_subgroup_quotient_mul(s,
        normal_subgroup_quotient_project(s, b),
        normal_subgroup_quotient_project(s, a)) =
    normal_subgroup_quotient_mul(s,
        normal_subgroup_quotient_project(s, c),
        normal_subgroup_quotient_project(s, a))) =
    normal_subgroup_rel(s, b, c)
}

theorem normal_subgroup_quotient_project_mul_comm[G: CommGroup](s: Subgroup[G], a: G, b: G) {
    is_normal_subgroup(s) implies
    normal_subgroup_quotient_mul(s,
        normal_subgroup_quotient_project(s, a),
        normal_subgroup_quotient_project(s, b)) =
    normal_subgroup_quotient_mul(s,
        normal_subgroup_quotient_project(s, b),
        normal_subgroup_quotient_project(s, a))
}

define subgroup_image_contains[G: Group, H: Group](
    f: GroupHom[G, H],
    s: Subgroup[G],
    y: H
) -> Bool {
    exists(x: G) {
        s.contains(x) and f.hom(x) = y
    }
}

theorem subgroup_image_identity_constraint[G: Group, H: Group](
    f: GroupHom[G, H],
    s: Subgroup[G]
) {
    identity_constraint(subgroup_image_contains(f, s))
}

theorem subgroup_image_closure_constraint[G: Group, H: Group](
    f: GroupHom[G, H],
    s: Subgroup[G]
) {
    closure_constraint(subgroup_image_contains(f, s))
}

theorem subgroup_image_inverse_constraint[G: Group, H: Group](
    f: GroupHom[G, H],
    s: Subgroup[G]
) {
    inverse_constraint(subgroup_image_contains(f, s))
}

theorem subgroup_image_constraint[G: Group, H: Group](
    f: GroupHom[G, H],
    s: Subgroup[G]
) {
    subgroup_constraint(subgroup_image_contains(f, s))
}

let subgroup_image[G: Group, H: Group](f: GroupHom[G, H], s: Subgroup[G]) -> result: Subgroup[H] satisfy {
    Subgroup.new(subgroup_image_contains(f, s)) = Option.some(result)
}

theorem subgroup_image_contains_eq[G: Group, H: Group](
    f: GroupHom[G, H],
    s: Subgroup[G],
    y: H
) {
    subgroup_image(f, s).contains(y) = exists(x: G) {
        s.contains(x) and f.hom(x) = y
    }
}

theorem subgroup_image_contains_map[G: Group, H: Group](
    f: GroupHom[G, H],
    s: Subgroup[G],
    x: G
) {
    s.contains(x) implies subgroup_image(f, s).contains(f.hom(x))
}

theorem subgroup_image_contains_witness[G: Group, H: Group](
    f: GroupHom[G, H],
    s: Subgroup[G],
    y: H
) {
    subgroup_image(f, s).contains(y) implies exists(x: G) {
        s.contains(x) and f.hom(x) = y
    }
}

theorem subgroup_image_subset_iff_subset_preimage[G: Group, H: Group](
    f: GroupHom[G, H],
    s: Subgroup[G],
    t: Subgroup[H]
) {
    subgroup_subset(subgroup_image(f, s), t) = subgroup_subset(s, subgroup_preimage(f, t))
}

theorem subgroup_image_subset_of_subset[G: Group, H: Group](
    f: GroupHom[G, H],
    s: Subgroup[G],
    t: Subgroup[G]
) {
    subgroup_subset(s, t) implies subgroup_subset(subgroup_image(f, s), subgroup_image(f, t))
}

theorem subgroup_preimage_normal[G: Group, H: Group](
    f: GroupHom[G, H],
    n: Subgroup[H]
) {
    is_normal_subgroup(n) implies is_normal_subgroup(subgroup_preimage(f, n))
}

define subgroup_maps_to_one_raw[G: Group, H: Group](phi: G -> H, n: Subgroup[G]) -> Bool {
    forall(a: G) {
        n.contains(a) implies phi(a) = H.1
    }
}

theorem subgroup_maps_to_one_raw_at[G: Group, H: Group](phi: G -> H, n: Subgroup[G], a: G) {
    subgroup_maps_to_one_raw(phi, n) and n.contains(a) implies phi(a) = H.1
}

define normal_subgroup_maps_to_one[G: Group, H: Group](
    f: GroupHom[G, H], n: Subgroup[G]
) -> Bool {
    subgroup_maps_to_one_raw(f.hom, n)
}

theorem normal_subgroup_maps_to_one_at[G: Group, H: Group](
    f: GroupHom[G, H], n: Subgroup[G], a: G
) {
    normal_subgroup_maps_to_one(f, n) and n.contains(a) implies f.hom(a) = H.1
}

theorem normal_subgroup_maps_to_one_rel_invariant[G: Group, H: Group](
    f: GroupHom[G, H], n: Subgroup[G], a: G, b: G
) {
    normal_subgroup_maps_to_one(f, n) and normal_subgroup_rel(n, a, b) implies
    f.hom(a) = f.hom(b)
}

define normal_subgroup_quotient_lift[G: Group, H: Group](
    n: Subgroup[G], f: GroupHom[G, H]
) -> QuotientOver[G] -> H {
    quotient_over_lift_to(f.hom)
}

theorem normal_subgroup_quotient_lift_project[G: Group, H: Group](
    f: GroupHom[G, H], n: Subgroup[G], a: G
) {
    normal_subgroup_maps_to_one(f, n) implies
    normal_subgroup_quotient_lift(n, f, normal_subgroup_quotient_project(n, a)) = f.hom(a)
}

theorem normal_subgroup_quotient_lift_mul_project[G: Group, H: Group](
    f: GroupHom[G, H], n: Subgroup[G], a: G, b: G
) {
    is_normal_subgroup(n) and normal_subgroup_maps_to_one(f, n) implies
    normal_subgroup_quotient_lift(n, f,
        normal_subgroup_quotient_mul(n,
            normal_subgroup_quotient_project(n, a),
            normal_subgroup_quotient_project(n, b))) = f.hom(a) * f.hom(b)
}

theorem normal_subgroup_quotient_lift_mul_project_hom[G: Group, H: Group](
    f: GroupHom[G, H], n: Subgroup[G], a: G, b: G
) {
    is_normal_subgroup(n) and normal_subgroup_maps_to_one(f, n) implies
    normal_subgroup_quotient_lift(n, f,
        normal_subgroup_quotient_mul(n,
            normal_subgroup_quotient_project(n, a),
            normal_subgroup_quotient_project(n, b))) =
        normal_subgroup_quotient_lift(n, f, normal_subgroup_quotient_project(n, a)) *
        normal_subgroup_quotient_lift(n, f, normal_subgroup_quotient_project(n, b))
}

theorem normal_subgroup_quotient_lift_one[G: Group, H: Group](
    f: GroupHom[G, H], n: Subgroup[G]
) {
    normal_subgroup_maps_to_one(f, n) implies
    normal_subgroup_quotient_lift(n, f, normal_subgroup_quotient_one(n)) = H.1
}

theorem normal_subgroup_quotient_lift_inverse_project[G: Group, H: Group](
    f: GroupHom[G, H], n: Subgroup[G], a: G
) {
    is_normal_subgroup(n) and normal_subgroup_maps_to_one(f, n) implies
    normal_subgroup_quotient_lift(n, f,
        normal_subgroup_quotient_inverse(n, normal_subgroup_quotient_project(n, a))) =
        f.hom(a).inverse
}

theorem normal_subgroup_quotient_lift_inverse_project_hom[G: Group, H: Group](
    f: GroupHom[G, H], n: Subgroup[G], a: G
) {
    is_normal_subgroup(n) and normal_subgroup_maps_to_one(f, n) implies
    normal_subgroup_quotient_lift(n, f,
        normal_subgroup_quotient_inverse(n, normal_subgroup_quotient_project(n, a))) =
        normal_subgroup_quotient_lift(n, f, normal_subgroup_quotient_project(n, a)).inverse
}

theorem group_hom_kernel_is_normal_subgroup[G: Group, H: Group](f: GroupHom[G, H]) {
    is_normal_subgroup(group_hom_kernel(f))
}

theorem normal_subgroup_maps_to_one_iff_subgroup_subset_group_hom_kernel[G: Group, H: Group](
    f: GroupHom[G, H], n: Subgroup[G]
) {
    normal_subgroup_maps_to_one(f, n) = subgroup_subset(n, group_hom_kernel(f))
}

theorem group_hom_kernel_eq_identity_subgroup_iff_trivial_kernel[G: Group, H: Group](
    f: GroupHom[G, H]
) {
    (group_hom_kernel(f) = identity_subgroup[G]) = is_trivial_group_hom_kernel(f)
}

theorem group_hom_injective_iff_group_hom_kernel_eq_identity_subgroup[G: Group, H: Group](
    f: GroupHom[G, H]
) {
    is_injective_fn(f.hom) = (group_hom_kernel(f) = identity_subgroup[G])
}

define subgroup_product_contains[G: Group](h: Subgroup[G], k: Subgroup[G], x: G) -> Bool {
    exists(a: G, b: G) {
        h.contains(a) and k.contains(b) and x = a * b
    }
}

theorem subgroup_product_identity_constraint[G: Group](h: Subgroup[G], k: Subgroup[G]) {
    identity_constraint(subgroup_product_contains(h, k))
}

theorem subgroup_product_commute_left[G: Group](h: Subgroup[G], k: Subgroup[G], a: G, b: G) {
    is_normal_subgroup(k) and h.contains(a) and k.contains(b) implies
    exists(kp: G) {
        k.contains(kp) and b * a = a * kp
    }
}

theorem subgroup_product_closure_constraint[G: Group](h: Subgroup[G], k: Subgroup[G]) {
    is_normal_subgroup(k) implies closure_constraint(subgroup_product_contains(h, k))
}

theorem subgroup_product_inverse_constraint[G: Group](h: Subgroup[G], k: Subgroup[G]) {
    is_normal_subgroup(k) implies inverse_constraint(subgroup_product_contains(h, k))
}

theorem subgroup_product_constraint[G: Group](h: Subgroup[G], k: Subgroup[G]) {
    is_normal_subgroup(k) implies subgroup_constraint(subgroup_product_contains(h, k))
}

theorem subgroup_product_contains_of_left[G: Group](h: Subgroup[G], k: Subgroup[G], a: G) {
    h.contains(a) implies subgroup_product_contains(h, k, a)
}

theorem subgroup_product_contains_of_right[G: Group](h: Subgroup[G], k: Subgroup[G], b: G) {
    k.contains(b) implies subgroup_product_contains(h, k, b)
}

theorem subgroup_product_commute_right[G: Group](h: Subgroup[G], k: Subgroup[G], a: G, b: G) {
    is_normal_subgroup(h) and h.contains(a) and k.contains(b) implies
    exists(hp: G) {
        h.contains(hp) and b * a = hp * b
    }
}

theorem subgroup_product_closure_constraint_right[G: Group](h: Subgroup[G], k: Subgroup[G]) {
    is_normal_subgroup(h) implies closure_constraint(subgroup_product_contains(h, k))
}

theorem subgroup_product_inverse_constraint_right[G: Group](h: Subgroup[G], k: Subgroup[G]) {
    is_normal_subgroup(h) implies inverse_constraint(subgroup_product_contains(h, k))
}

theorem subgroup_product_constraint_right[G: Group](h: Subgroup[G], k: Subgroup[G]) {
    is_normal_subgroup(h) implies subgroup_constraint(subgroup_product_contains(h, k))
}

theorem second_iso_project_mul[G: Group](h: Subgroup[G], k: Subgroup[G], a: G, b: G) {
    is_normal_subgroup(k) and h.contains(a) and h.contains(b) implies
    normal_subgroup_quotient_project(k, a * b) =
        normal_subgroup_quotient_mul(k,
            normal_subgroup_quotient_project(k, a),
            normal_subgroup_quotient_project(k, b))
}

theorem second_iso_project_inverse[G: Group](h: Subgroup[G], k: Subgroup[G], a: G) {
    is_normal_subgroup(k) and h.contains(a) implies
    normal_subgroup_quotient_project(k, a.inverse) =
        normal_subgroup_quotient_inverse(k, normal_subgroup_quotient_project(k, a))
}

theorem second_iso_image_iff_product[G: Group](h: Subgroup[G], k: Subgroup[G], q: QuotientOver[G]) {
    is_normal_subgroup(k) implies
    (exists(a: G) {
        h.contains(a) and normal_subgroup_quotient_project(k, a) = q
    }) =
    (exists(x: G) {
        subgroup_product_contains(h, k, x) and normal_subgroup_quotient_project(k, x) = q
    })
}

theorem second_iso_dual_image_iff_product[G: Group](h: Subgroup[G], k: Subgroup[G], q: QuotientOver[G]) {
    is_normal_subgroup(h) implies
    (exists(b: G) {
        k.contains(b) and normal_subgroup_quotient_project(h, b) = q
    }) =
    (exists(x: G) {
        subgroup_product_contains(h, k, x) and normal_subgroup_quotient_project(h, x) = q
    })
}

define third_iso_projection[G: Group](m: Subgroup[G], g: G) -> QuotientOver[G] {
    normal_subgroup_quotient_project(m, g)
}

theorem third_iso_well_defined[G: Group](n: Subgroup[G], m: Subgroup[G], a: G, b: G) {
    subgroup_subset(n, m) and normal_subgroup_rel(n, a, b) implies
    normal_subgroup_quotient_project(m, a) = normal_subgroup_quotient_project(m, b)
}

theorem third_iso_projection_respects[G: Group](n: Subgroup[G], m: Subgroup[G]) {
    subgroup_subset(n, m) implies
    quotient_respects(normal_subgroup_quotient_relation(n), third_iso_projection(m))
}

define third_iso_map[G: Group](n: Subgroup[G], m: Subgroup[G]) -> QuotientOver[G] -> QuotientOver[G] {
    quotient_over_lift_to(third_iso_projection(m))
}

theorem third_iso_map_project[G: Group](n: Subgroup[G], m: Subgroup[G], g: G) {
    subgroup_subset(n, m) implies
    third_iso_map(n, m, normal_subgroup_quotient_project(n, g)) =
        normal_subgroup_quotient_project(m, g)
}

theorem third_iso_map_mul[G: Group](n: Subgroup[G], m: Subgroup[G], a: G, b: G) {
    is_normal_subgroup(n) and is_normal_subgroup(m) and subgroup_subset(n, m) implies
    third_iso_map(n, m,
        normal_subgroup_quotient_mul(n,
            normal_subgroup_quotient_project(n, a),
            normal_subgroup_quotient_project(n, b))) =
        normal_subgroup_quotient_mul(m,
            third_iso_map(n, m, normal_subgroup_quotient_project(n, a)),
            third_iso_map(n, m, normal_subgroup_quotient_project(n, b)))
}

theorem third_iso_map_one[G: Group](n: Subgroup[G], m: Subgroup[G]) {
    subgroup_subset(n, m) implies
    third_iso_map(n, m, normal_subgroup_quotient_one(n)) = normal_subgroup_quotient_one(m)
}

theorem third_iso_map_inverse[G: Group](n: Subgroup[G], m: Subgroup[G], a: G) {
    is_normal_subgroup(n) and is_normal_subgroup(m) and subgroup_subset(n, m) implies
    third_iso_map(n, m,
        normal_subgroup_quotient_inverse(n, normal_subgroup_quotient_project(n, a))) =
        normal_subgroup_quotient_inverse(m,
            third_iso_map(n, m, normal_subgroup_quotient_project(n, a)))
}

theorem third_iso_kernel_iff[G: Group](n: Subgroup[G], m: Subgroup[G], a: G, b: G) {
    subgroup_subset(n, m) implies
    (third_iso_map(n, m, normal_subgroup_quotient_project(n, a)) =
        third_iso_map(n, m, normal_subgroup_quotient_project(n, b))) =
        m.contains(a * b.inverse)
}

theorem third_iso_kernel_quotient_rel[G: Group](n: Subgroup[G], m: Subgroup[G], a: G, b: G) {
    is_normal_subgroup(n) and subgroup_subset(n, m) implies
    (third_iso_map(n, m, normal_subgroup_quotient_project(n, a)) =
        third_iso_map(n, m, normal_subgroup_quotient_project(n, b))) =
        exists(t: G) {
            m.contains(t) and n.contains(a * b.inverse * t.inverse)
        }
}

theorem third_iso_surjective[G: Group](n: Subgroup[G], m: Subgroup[G], q: QuotientOver[G]) {
    subgroup_subset(n, m) and q.qrel = normal_subgroup_quotient_relation(m) implies
    exists(qp: QuotientOver[G]) {
        qp.qrel = normal_subgroup_quotient_relation(n) and third_iso_map(n, m, qp) = q
    }
}

define quotient_subgroup_mul_closed[G: Group](n: Subgroup[G], contains: QuotientOver[G] -> Bool) -> Bool {
    forall(a: QuotientOver[G], b: QuotientOver[G]) {
        contains(a) and contains(b) implies
        contains(normal_subgroup_quotient_mul(n, a, b))
    }
}

define quotient_subgroup_inv_closed[G: Group](n: Subgroup[G], contains: QuotientOver[G] -> Bool) -> Bool {
    forall(a: QuotientOver[G]) {
        contains(a) implies contains(normal_subgroup_quotient_inverse(n, a))
    }
}

define quotient_subgroup_constraint[G: Group](n: Subgroup[G], contains: QuotientOver[G] -> Bool) -> Bool {
    contains(normal_subgroup_quotient_one(n)) and
    quotient_subgroup_mul_closed(n, contains) and
    quotient_subgroup_inv_closed(n, contains)
}

define m_over_n_contains[G: Group](n: Subgroup[G], m: Subgroup[G], q: QuotientOver[G]) -> Bool {
    exists(a: G) {
        m.contains(a) and normal_subgroup_quotient_project(n, a) = q
    }
}

theorem m_over_n_identity[G: Group](n: Subgroup[G], m: Subgroup[G]) {
    m_over_n_contains(n, m, normal_subgroup_quotient_one(n))
}

theorem m_over_n_mul[G: Group](n: Subgroup[G], m: Subgroup[G], q1: QuotientOver[G], q2: QuotientOver[G]) {
    is_normal_subgroup(n) and m_over_n_contains(n, m, q1) and m_over_n_contains(n, m, q2) implies
    m_over_n_contains(n, m, normal_subgroup_quotient_mul(n, q1, q2))
}

theorem m_over_n_inverse[G: Group](n: Subgroup[G], m: Subgroup[G], q: QuotientOver[G]) {
    is_normal_subgroup(n) and m_over_n_contains(n, m, q) implies
    m_over_n_contains(n, m, normal_subgroup_quotient_inverse(n, q))
}

theorem m_over_n_constraint[G: Group](n: Subgroup[G], m: Subgroup[G]) {
    is_normal_subgroup(n) implies quotient_subgroup_constraint(n, m_over_n_contains(n, m))
}

theorem m_over_n_normal[G: Group](n: Subgroup[G], m: Subgroup[G], g: G, x: QuotientOver[G]) {
    is_normal_subgroup(n) and is_normal_subgroup(m) and
    m_over_n_contains(n, m, x) implies
    m_over_n_contains(n, m,
        normal_subgroup_quotient_mul(n,
            normal_subgroup_quotient_mul(n,
                normal_subgroup_quotient_project(n, g), x),
            normal_subgroup_quotient_inverse(n,
                normal_subgroup_quotient_project(n, g))))
}

define projection_image_contains[G: Group](n: Subgroup[G], s: Subgroup[G], q: QuotientOver[G]) -> Bool {
    exists(a: G) {
        s.contains(a) and normal_subgroup_quotient_project(n, a) = q
    }
}

theorem projection_image_identity[G: Group](n: Subgroup[G], s: Subgroup[G]) {
    projection_image_contains(n, s, normal_subgroup_quotient_one(n))
}

theorem projection_image_mul[G: Group](n: Subgroup[G], s: Subgroup[G], q1: QuotientOver[G], q2: QuotientOver[G]) {
    is_normal_subgroup(n) and projection_image_contains(n, s, q1) and projection_image_contains(n, s, q2) implies
    projection_image_contains(n, s, normal_subgroup_quotient_mul(n, q1, q2))
}

theorem projection_image_inverse[G: Group](n: Subgroup[G], s: Subgroup[G], q: QuotientOver[G]) {
    is_normal_subgroup(n) and projection_image_contains(n, s, q) implies
    projection_image_contains(n, s, normal_subgroup_quotient_inverse(n, q))
}

theorem projection_image_constraint[G: Group](n: Subgroup[G], s: Subgroup[G]) {
    is_normal_subgroup(n) implies quotient_subgroup_constraint(n, projection_image_contains(n, s))
}

define projection_preimage_contains[G: Group](n: Subgroup[G], t: QuotientOver[G] -> Bool, g: G) -> Bool {
    t(normal_subgroup_quotient_project(n, g))
}

theorem projection_preimage_identity_constraint[G: Group](n: Subgroup[G], t: QuotientOver[G] -> Bool) {
    t(normal_subgroup_quotient_one(n)) implies
    identity_constraint(projection_preimage_contains(n, t))
}

theorem projection_preimage_closure_constraint[G: Group](n: Subgroup[G], t: QuotientOver[G] -> Bool) {
    is_normal_subgroup(n) and
    (forall(a: QuotientOver[G], b: QuotientOver[G]) {
        t(a) and t(b) implies t(normal_subgroup_quotient_mul(n, a, b))
    }) implies
    closure_constraint(projection_preimage_contains(n, t))
}

theorem projection_preimage_inverse_constraint[G: Group](n: Subgroup[G], t: QuotientOver[G] -> Bool) {
    is_normal_subgroup(n) and
    (forall(a: QuotientOver[G]) {
        t(a) implies t(normal_subgroup_quotient_inverse(n, a))
    }) implies
    inverse_constraint(projection_preimage_contains(n, t))
}

theorem projection_preimage_constraint[G: Group](n: Subgroup[G], t: QuotientOver[G] -> Bool) {
    is_normal_subgroup(n) and t(normal_subgroup_quotient_one(n)) and
    (forall(a: QuotientOver[G], b: QuotientOver[G]) {
        t(a) and t(b) implies t(normal_subgroup_quotient_mul(n, a, b))
    }) and
    (forall(a: QuotientOver[G]) {
        t(a) implies t(normal_subgroup_quotient_inverse(n, a))
    }) implies
    subgroup_constraint(projection_preimage_contains(n, t))
}

theorem projection_preimage_contains_n[G: Group](n: Subgroup[G], t: QuotientOver[G] -> Bool) {
    t(normal_subgroup_quotient_one(n)) implies
    forall(g: G) {
        n.contains(g) implies projection_preimage_contains(n, t, g)
    }
}

theorem projection_image_subset_iff_preimage_subset[G: Group](n: Subgroup[G], s: Subgroup[G], t: QuotientOver[G] -> Bool) {
    (forall(q: QuotientOver[G]) {
        projection_image_contains(n, s, q) implies t(q)
    }) = (forall(g: G) {
        s.contains(g) implies projection_preimage_contains(n, t, g)
    })
}

theorem projection_left_inverse[G: Group](n: Subgroup[G], s: Subgroup[G], g: G) {
    subgroup_subset(n, s) implies
    projection_preimage_contains(n, projection_image_contains(n, s), g) = s.contains(g)
}

define projection_image_of_preimage_contains[G: Group](n: Subgroup[G], t: QuotientOver[G] -> Bool, q: QuotientOver[G]) -> Bool {
    exists(a: G) {
        projection_preimage_contains(n, t, a) and normal_subgroup_quotient_project(n, a) = q
    }
}

theorem projection_right_inverse[G: Group](n: Subgroup[G], t: QuotientOver[G] -> Bool, q: QuotientOver[G]) {
    q.qrel = normal_subgroup_quotient_relation(n) implies
    projection_image_of_preimage_contains(n, t, q) = t(q)
}

define action_identity_constraint[G: Group, X](act: (G, X) -> X) -> Bool {
    forall(x: X) {
        act(G.1, x) = x
    }
}

define action_mul_constraint[G: Group, X](act: (G, X) -> X) -> Bool {
    forall(g: G, h: G, x: X) {
        act(g * h, x) = act(g, act(h, x))
    }
}

define is_mul_action[G: Group, X](act: (G, X) -> X) -> Bool {
    action_mul_constraint(act) and action_identity_constraint(act)
}

structure MulAction[G: Group, X] {
    /// The action map.
    act: (G, X) -> X
} constraint {
    is_mul_action(act)
}

theorem mul_action_one[G: Group, X](a: MulAction[G, X], x: X) {
    a.act(G.1, x) = x
}

theorem mul_action_mul[G: Group, X](a: MulAction[G, X], g: G, h: G, x: X) {
    a.act(g * h, x) = a.act(g, a.act(h, x))
}

theorem mul_action_inv_apply_apply[G: Group, X](a: MulAction[G, X], g: G, x: X) {
    a.act(g.inverse, a.act(g, x)) = x
}

theorem mul_action_apply_inv_apply[G: Group, X](a: MulAction[G, X], g: G, x: X) {
    a.act(g, a.act(g.inverse, x)) = x
}

define action_map[G: Group, X](a: MulAction[G, X], g: G, x: X) -> X {
    a.act(g, x)
}

theorem action_map_apply[G: Group, X](a: MulAction[G, X], g: G, x: X) {
    action_map(a, g, x) = a.act(g, x)
}

theorem action_map_inverse_apply_apply[G: Group, X](a: MulAction[G, X], g: G, x: X) {
    action_map(a, g.inverse, action_map(a, g, x)) = x
}

theorem action_map_apply_inverse_apply[G: Group, X](a: MulAction[G, X], g: G, x: X) {
    action_map(a, g, action_map(a, g.inverse, x)) = x
}

theorem action_map_is_injective[G: Group, X](a: MulAction[G, X], g: G) {
    is_injective_fn(action_map(a, g))
}

theorem action_map_is_surjective[G: Group, X](a: MulAction[G, X], g: G) {
    is_surjective_fn(action_map(a, g))
}

theorem action_map_is_bijection[G: Group, X](a: MulAction[G, X], g: G) {
    is_bijection_fn(action_map(a, g))
}

let action_bijection[G: Group, X](a: MulAction[G, X], g: G) -> result: Bijection[X, X] satisfy {
    result.map = action_map(a, g)
}

theorem action_bijection_map[G: Group, X](a: MulAction[G, X], g: G) {
    action_bijection(a, g).map = action_map(a, g)
}

theorem action_bijection_apply[G: Group, X](a: MulAction[G, X], g: G, x: X) {
    action_bijection(a, g).map(x) = a.act(g, x)
}

theorem action_map_one[G: Group, X](a: MulAction[G, X]) {
    action_map(a, G.1) = identity_fn[X]
}

theorem action_bijection_one_map[G: Group, X](a: MulAction[G, X]) {
    action_bijection(a, G.1).map = identity_fn[X]
}

theorem action_map_mul[G: Group, X](a: MulAction[G, X], g: G, h: G) {
    action_map(a, g * h) = compose(action_map(a, g), action_map(a, h))
}

theorem action_bijection_mul_map[G: Group, X](a: MulAction[G, X], g: G, h: G) {
    action_bijection(a, g * h).map =
        compose(action_bijection(a, g).map, action_bijection(a, h).map)
}

theorem action_map_inverse_compose_left[G: Group, X](a: MulAction[G, X], g: G) {
    compose(action_map(a, g.inverse), action_map(a, g)) = identity_fn[X]
}

theorem action_map_inverse_compose_right[G: Group, X](a: MulAction[G, X], g: G) {
    compose(action_map(a, g), action_map(a, g.inverse)) = identity_fn[X]
}

define is_equivariant_map[G: Group, X, Y](
    a: MulAction[G, X],
    b: MulAction[G, Y],
    f: X -> Y
) -> Bool {
    forall(g: G, x: X) {
        f(a.act(g, x)) = b.act(g, f(x))
    }
}

structure ActionHom[G: Group, X, Y] {
    /// The source action.
    src: MulAction[G, X]

    /// The target action.
    dst: MulAction[G, Y]

    /// The underlying map.
    map: X -> Y
} constraint {
    is_equivariant_map(src, dst, map)
}

theorem equivariant_map_apply[G: Group, X, Y](
    a: MulAction[G, X],
    b: MulAction[G, Y],
    f: X -> Y,
    g: G,
    x: X
) {
    is_equivariant_map(a, b, f) implies f(a.act(g, x)) = b.act(g, f(x))
}

theorem action_hom_is_equivariant[G: Group, X, Y](f: ActionHom[G, X, Y]) {
    is_equivariant_map(f.src, f.dst, f.map)
}

theorem action_hom_apply[G: Group, X, Y](f: ActionHom[G, X, Y], g: G, x: X) {
    f.map(f.src.act(g, x)) = f.dst.act(g, f.map(x))
}

theorem action_hom_ext[G: Group, X, Y](f: ActionHom[G, X, Y], h: ActionHom[G, X, Y]) {
    f.src = h.src and f.dst = h.dst and f.map = h.map implies f = h
}

attributes ActionHom[G: Group, X, Y] {
    /// Action homomorphism extensionality from equality of fields.
    let ext = action_hom_ext[G, X, Y]
}

theorem action_hom_eq_map[G: Group, X, Y](f: ActionHom[G, X, Y], h: ActionHom[G, X, Y]) {
    f = h implies f.map = h.map
}

theorem action_hom_eq_apply[G: Group, X, Y](f: ActionHom[G, X, Y], h: ActionHom[G, X, Y], x: X) {
    f = h implies f.map(x) = h.map(x)
}

theorem identity_fn_is_equivariant[G: Group, X](a: MulAction[G, X]) {
    is_equivariant_map(a, a, identity_fn[X])
}

let identity_action_hom[G: Group, X](a: MulAction[G, X]) -> result: ActionHom[G, X, X] satisfy {
    ActionHom[G, X, X].new(a, a, identity_fn[X]) = Option.some(result)
}

theorem identity_action_hom_map[G: Group, X](a: MulAction[G, X]) {
    identity_action_hom(a).map = identity_fn[X]
}

theorem identity_action_hom_apply[G: Group, X](a: MulAction[G, X], x: X) {
    identity_action_hom(a).map(x) = x
}

theorem compose_is_equivariant_map[G: Group, X, Y, Z](
    a: MulAction[G, X],
    b: MulAction[G, Y],
    c: MulAction[G, Z],
    f: Y -> Z,
    h: X -> Y
) {
    is_equivariant_map(b, c, f) and is_equivariant_map(a, b, h) implies
        is_equivariant_map(a, c, compose(f, h))
}

theorem action_hom_compose_maps_is_equivariant[G: Group, X, Y, Z](
    f: ActionHom[G, Y, Z],
    h: ActionHom[G, X, Y]
) {
    h.dst = f.src implies is_equivariant_map(h.src, f.dst, compose(f.map, h.map))
}

theorem action_hom_compose_maps_apply[G: Group, X, Y, Z](
    f: ActionHom[G, Y, Z],
    h: ActionHom[G, X, Y],
    x: X
) {
    compose(f.map, h.map, x) = f.map(h.map(x))
}

define orbit_contains[G: Group, X](a: MulAction[G, X], x: X, y: X) -> Bool {
    exists(g: G) {
        y = a.act(g, x)
    }
}

define orbit_relation[G: Group, X](a: MulAction[G, X], x: X, y: X) -> Bool {
    orbit_contains(a, x, y)
}

define orbit[G: Group, X](a: MulAction[G, X], x: X) -> Set[X] {
    Set[X].new(orbit_contains(a, x))
}

theorem orbit_contains_self[G: Group, X](a: MulAction[G, X], x: X) {
    orbit(a, x).contains(x)
}

theorem orbit_contains_action[G: Group, X](a: MulAction[G, X], x: X, g: G) {
    orbit(a, x).contains(a.act(g, x))
}

theorem orbit_contains_witness[G: Group, X](a: MulAction[G, X], x: X, y: X) {
    orbit(a, x).contains(y) implies exists(g: G) {
        y = a.act(g, x)
    }
}

theorem equivariant_map_maps_orbit_contains[G: Group, X, Y](
    a: MulAction[G, X],
    b: MulAction[G, Y],
    f: X -> Y,
    x: X,
    y: X
) {
    is_equivariant_map(a, b, f) and orbit(a, x).contains(y) implies orbit(b, f(x)).contains(f(y))
}

theorem action_hom_maps_orbit_contains[G: Group, X, Y](
    f: ActionHom[G, X, Y],
    x: X,
    y: X
) {
    orbit(f.src, x).contains(y) implies orbit(f.dst, f.map(x)).contains(f.map(y))
}

theorem equivariant_map_reflects_orbit_contains_of_injective[G: Group, X, Y](
    a: MulAction[G, X],
    b: MulAction[G, Y],
    f: X -> Y,
    x: X,
    y: X
) {
    is_injective_fn(f) and is_equivariant_map(a, b, f) and
        orbit(b, f(x)).contains(f(y)) implies orbit(a, x).contains(y)
}

theorem action_hom_reflects_orbit_contains_of_injective[G: Group, X, Y](
    f: ActionHom[G, X, Y],
    x: X,
    y: X
) {
    is_injective_fn(f.map) and orbit(f.dst, f.map(x)).contains(f.map(y)) implies
        orbit(f.src, x).contains(y)
}

theorem orbit_contains_symmetric[G: Group, X](a: MulAction[G, X], x: X, y: X) {
    orbit(a, x).contains(y) implies orbit(a, y).contains(x)
}

theorem orbit_contains_action_of_contains[G: Group, X](a: MulAction[G, X], x: X, y: X, g: G) {
    orbit(a, x).contains(y) implies orbit(a, x).contains(a.act(g, y))
}

theorem orbit_contains_transitive[G: Group, X](a: MulAction[G, X], x: X, y: X, z: X) {
    orbit(a, x).contains(y) and orbit(a, y).contains(z) implies orbit(a, x).contains(z)
}

theorem orbit_relation_eq_contains[G: Group, X](a: MulAction[G, X], x: X, y: X) {
    orbit_relation(a, x, y) = orbit(a, x).contains(y)
}

theorem orbit_relation_is_reflexive[G: Group, X](a: MulAction[G, X]) {
    is_reflexive(orbit_relation(a))
}

theorem orbit_relation_is_symmetric[G: Group, X](a: MulAction[G, X]) {
    is_symmetric(orbit_relation(a))
}

theorem orbit_eq_of_contains[G: Group, X](a: MulAction[G, X], x: X, y: X) {
    orbit(a, x).contains(y) implies orbit(a, x) = orbit(a, y)
}

theorem orbit_eq_iff_contains[G: Group, X](a: MulAction[G, X], x: X, y: X) {
    orbit(a, x) = orbit(a, y) = orbit(a, x).contains(y)
}

define stabilizer_contains[G: Group, X](a: MulAction[G, X], x: X, g: G) -> Bool {
    a.act(g, x) = x
}

theorem stabilizer_identity_constraint[G: Group, X](a: MulAction[G, X], x: X) {
    identity_constraint(stabilizer_contains(a, x))
}

theorem stabilizer_closure_constraint[G: Group, X](a: MulAction[G, X], x: X) {
    closure_constraint(stabilizer_contains(a, x))
}

theorem stabilizer_inverse_constraint[G: Group, X](a: MulAction[G, X], x: X) {
    inverse_constraint(stabilizer_contains(a, x))
}

theorem stabilizer_subgroup_constraint[G: Group, X](a: MulAction[G, X], x: X) {
    subgroup_constraint(stabilizer_contains(a, x))
}

let stabilizer[G: Group, X](a: MulAction[G, X], x: X) -> result: Subgroup[G] satisfy {
    Subgroup.new(stabilizer_contains(a, x)) = Option.some(result)
}

theorem stabilizer_contains_eq[G: Group, X](a: MulAction[G, X], x: X, g: G) {
    stabilizer(a, x).contains(g) = (a.act(g, x) = x)
}

theorem stabilizer_fixes[G: Group, X](a: MulAction[G, X], x: X, g: G) {
    stabilizer(a, x).contains(g) implies a.act(g, x) = x
}

theorem stabilizer_contains_of_fixes[G: Group, X](a: MulAction[G, X], x: X, g: G) {
    a.act(g, x) = x implies stabilizer(a, x).contains(g)
}

theorem orbit_action_eq_iff_stabilizer_left_coset_raw[G: Group, X](
    a: MulAction[G, X],
    x: X,
    g: G,
    k: G
) {
    (a.act(g, x) = a.act(k, x)) = stabilizer(a, x).contains(g.inverse * k)
}

theorem equivariant_map_maps_fixed_point_value[G: Group, X, Y](
    a: MulAction[G, X],
    b: MulAction[G, Y],
    f: X -> Y,
    x: X,
    g: G
) {
    is_equivariant_map(a, b, f) and stabilizer(a, x).contains(g) implies
        b.act(g, f(x)) = f(x)
}

theorem equivariant_map_maps_stabilizer_contains[G: Group, X, Y](
    a: MulAction[G, X],
    b: MulAction[G, Y],
    f: X -> Y,
    x: X,
    g: G
) {
    is_equivariant_map(a, b, f) and stabilizer(a, x).contains(g) implies
        stabilizer(b, f(x)).contains(g)
}

theorem action_hom_maps_stabilizer_contains[G: Group, X, Y](
    f: ActionHom[G, X, Y],
    x: X,
    g: G
) {
    stabilizer(f.src, x).contains(g) implies stabilizer(f.dst, f.map(x)).contains(g)
}

theorem equivariant_map_reflects_fixed_point_value_of_injective[G: Group, X, Y](
    a: MulAction[G, X],
    b: MulAction[G, Y],
    f: X -> Y,
    x: X,
    g: G
) {
    is_injective_fn(f) and is_equivariant_map(a, b, f) and stabilizer(b, f(x)).contains(g) implies
        a.act(g, x) = x
}

theorem equivariant_map_reflects_stabilizer_contains_of_injective[G: Group, X, Y](
    a: MulAction[G, X],
    b: MulAction[G, Y],
    f: X -> Y,
    x: X,
    g: G
) {
    is_injective_fn(f) and is_equivariant_map(a, b, f) and stabilizer(b, f(x)).contains(g) implies
        stabilizer(a, x).contains(g)
}

theorem action_hom_reflects_stabilizer_contains_of_injective[G: Group, X, Y](
    f: ActionHom[G, X, Y],
    x: X,
    g: G
) {
    is_injective_fn(f.map) and stabilizer(f.dst, f.map(x)).contains(g) implies
        stabilizer(f.src, x).contains(g)
}

define fixed_points_contains[G: Group, X](a: MulAction[G, X], g: G, x: X) -> Bool {
    a.act(g, x) = x
}

define fixed_points[G: Group, X](a: MulAction[G, X], g: G) -> Set[X] {
    Set[X].new(fixed_points_contains(a, g))
}

theorem fixed_points_contains_eq[G: Group, X](a: MulAction[G, X], g: G, x: X) {
    fixed_points(a, g).contains(x) = (a.act(g, x) = x)
}

theorem fixed_points_one_contains[G: Group, X](a: MulAction[G, X], x: X) {
    fixed_points(a, G.1).contains(x)
}

define is_transitive_action[G: Group, X](a: MulAction[G, X]) -> Bool {
    forall(x: X, y: X) {
        orbit(a, x).contains(y)
    }
}

theorem transitive_action_orbit_contains[G: Group, X](a: MulAction[G, X], x: X, y: X) {
    is_transitive_action(a) implies orbit(a, x).contains(y)
}

theorem transitive_action_of_universal_orbits[G: Group, X](a: MulAction[G, X]) {
    (forall(x: X, y: X) { orbit(a, x).contains(y) }) implies is_transitive_action(a)
}

define is_faithful_action[G: Group, X](a: MulAction[G, X]) -> Bool {
    forall(g: G, h: G) {
        (forall(x: X) { a.act(g, x) = a.act(h, x) }) implies g = h
    }
}

theorem faithful_action_eq_of_pointwise_eq[G: Group, X](a: MulAction[G, X], g: G, h: G) {
    is_faithful_action(a) and (forall(x: X) { a.act(g, x) = a.act(h, x) }) implies g = h
}

theorem faithful_action_eq_one_of_pointwise_fixed[G: Group, X](a: MulAction[G, X], g: G) {
    is_faithful_action(a) and (forall(x: X) { a.act(g, x) = x }) implies g = G.1
}

define is_invariant_set[G: Group, X](a: MulAction[G, X], s: Set[X]) -> Bool {
    forall(g: G, x: X) {
        s.contains(x) implies s.contains(a.act(g, x))
    }
}

theorem universal_set_is_invariant[G: Group, X](a: MulAction[G, X]) {
    is_invariant_set(a, Set[X].universal_set)
}

theorem orbit_is_invariant[G: Group, X](a: MulAction[G, X], x: X) {
    is_invariant_set(a, orbit(a, x))
}

theorem group_inverse_one[G: Group] {
    G.1.inverse = G.1
}

theorem group_inverse_unique[G: Group](a: G, b: G) {
    a * b = G.1 and b * a = G.1 implies b = a.inverse
}

theorem group_right_inverse_eq_inverse[G: Group](a: G, b: G) {
    a * b = G.1 implies b = a.inverse
}

theorem group_left_inverse_eq_inverse[G: Group](a: G, b: G) {
    b * a = G.1 implies b = a.inverse
}

theorem group_inverse_mul_inv_left[G: Group](a: G, b: G) {
    (a.inverse * b).inverse = b.inverse * a
}

theorem group_inverse_mul_inv_right[G: Group](a: G, b: G) {
    (a * b.inverse).inverse = b * a.inverse
}

theorem group_mul_inv_cancel_left[G: Group](a: G, b: G) {
    a * (a.inverse * b) = b
}

theorem group_mul_inv_cancel_right[G: Group](a: G, b: G) {
    (b * a) * a.inverse = b
}

theorem group_inv_mul_cancel_left[G: Group](a: G, b: G) {
    a.inverse * (a * b) = b
}

theorem group_inv_mul_cancel_right[G: Group](a: G, b: G) {
    (b * a.inverse) * a = b
}

theorem group_mul_eq_one_iff_eq_inverse[G: Group](a: G, b: G) {
    (a * b = G.1) = (b = a.inverse)
}

theorem group_mul_eq_one_iff_eq_inverse_left[G: Group](a: G, b: G) {
    (a * b = G.1) = (a = b.inverse)
}

theorem group_inverse_injective[G: Group](a: G, b: G) {
    a.inverse = b.inverse implies a = b
}

theorem group_eq_iff_inv_eq[G: Group](a: G, b: G) {
    (a = b) = (a.inverse = b.inverse)
}

theorem group_sq_eq_one_iff_inv_eq_self[G: Group](a: G) {
    (a * a = G.1) = (a.inverse = a)
}

theorem group_pow_two[G: Group](a: G) {
    a.pow(2) = a * a
}

theorem group_pow_three[G: Group](a: G) {
    a.pow(3) = a * a * a
}

theorem group_pow_comm[G: Group](a: G, m: Nat, n: Nat) {
    a.pow(m) * a.pow(n) = a.pow(n) * a.pow(m)
}

theorem comm_group_commute[G: CommGroup](a: G, b: G) {
    commute[G](a, b)
}

theorem comm_group_inverse_mul[G: CommGroup](a: G, b: G) {
    (a * b).inverse = a.inverse * b.inverse
}

theorem comm_group_inv_eq_self_iff_sq_one[G: CommGroup](a: G) {
    (a.inverse = a) = (a * a = G.1)
}

theorem group_hom_kernel_contains_identity[G: Group, H: Group](f: GroupHom[G, H]) {
    group_hom_kernel(f).contains(G.1)
}

theorem group_hom_image_contains_identity[G: Group, H: Group](f: GroupHom[G, H], s: Subgroup[G]) {
    subgroup_image(f, s).contains(H.1)
}

theorem group_commute_pow_right[G: Group](a: G, b: G, n: Nat) {
    a * b = b * a implies a * b.pow(n) = b.pow(n) * a
}

define subring_zero_constraint[R: Ring](contains: R -> Bool) -> Bool {
    contains(R.0)
}

define subring_one_constraint[R: Ring](contains: R -> Bool) -> Bool {
    contains(R.1)
}

define subring_add_constraint[R: Ring](contains: R -> Bool) -> Bool {
    forall(a: R, b: R) {
        contains(a) and contains(b) implies contains(a + b)
    }
}

define subring_neg_constraint[R: Ring](contains: R -> Bool) -> Bool {
    forall(a: R) {
        contains(a) implies contains(-a)
    }
}

define subring_mul_constraint[R: Ring](contains: R -> Bool) -> Bool {
    forall(a: R, b: R) {
        contains(a) and contains(b) implies contains(a * b)
    }
}

define subring_constraint[R: Ring](contains: R -> Bool) -> Bool {
    subring_zero_constraint(contains) and subring_one_constraint(contains) and
        subring_add_constraint(contains) and subring_neg_constraint(contains) and
        subring_mul_constraint(contains)
}

structure Subring[R: Ring] {
    /// True if the given element is a member of this subring.
    contains: R -> Bool
} constraint {
    subring_constraint(contains)
}

theorem subring_ext[R: Ring](a: Subring[R], b: Subring[R]) {
    (forall(x: R) { a.contains(x) = b.contains(x) }) implies a = b
}

theorem subring_eq_contains[R: Ring](a: Subring[R], b: Subring[R]) {
    a = b implies a.contains = b.contains
}

theorem subring_eq_contains_at[R: Ring](a: Subring[R], b: Subring[R], x: R) {
    a = b implies a.contains(x) = b.contains(x)
}

theorem subring_eq_transport_predicate[R: Ring](
    p: Subring[R] -> Bool,
    a: Subring[R],
    b: Subring[R]
) {
    a = b and p(a) implies p(b)
}

theorem subring_eq_transport_predicate_rev[R: Ring](
    p: Subring[R] -> Bool,
    a: Subring[R],
    b: Subring[R]
) {
    a = b and p(b) implies p(a)
}

theorem subring_eq_of_contains_eq[R: Ring](a: Subring[R], b: Subring[R]) {
    a.contains = b.contains implies a = b
}

theorem subring_eq_of_contains_at_eq[R: Ring](a: Subring[R], b: Subring[R]) {
    (forall(x: R) { a.contains(x) = b.contains(x) }) implies a = b
}

theorem subring_contains_zero[R: Ring](s: Subring[R]) {
    s.contains(R.0)
}

theorem subring_contains_one[R: Ring](s: Subring[R]) {
    s.contains(R.1)
}

theorem subring_contains_add[R: Ring](s: Subring[R], a: R, b: R) {
    s.contains(a) and s.contains(b) implies s.contains(a + b)
}

theorem subring_contains_neg[R: Ring](s: Subring[R], a: R) {
    s.contains(a) implies s.contains(-a)
}

theorem subring_contains_sub[R: Ring](s: Subring[R], a: R, b: R) {
    s.contains(a) and s.contains(b) implies s.contains(a - b)
}

theorem subring_contains_mul[R: Ring](s: Subring[R], a: R, b: R) {
    s.contains(a) and s.contains(b) implies s.contains(a * b)
}

define subring_intersection_contains[R: Ring](a: Subring[R], b: Subring[R], x: R) -> Bool {
    a.contains(x) and b.contains(x)
}

theorem subring_intersection_zero_constraint[R: Ring](a: Subring[R], b: Subring[R]) {
    subring_zero_constraint(subring_intersection_contains(a, b))
}

theorem subring_intersection_one_constraint[R: Ring](a: Subring[R], b: Subring[R]) {
    subring_one_constraint(subring_intersection_contains(a, b))
}

theorem subring_intersection_add_constraint[R: Ring](a: Subring[R], b: Subring[R]) {
    subring_add_constraint(subring_intersection_contains(a, b))
}

theorem subring_intersection_neg_constraint[R: Ring](a: Subring[R], b: Subring[R]) {
    subring_neg_constraint(subring_intersection_contains(a, b))
}

theorem subring_intersection_mul_constraint[R: Ring](a: Subring[R], b: Subring[R]) {
    subring_mul_constraint(subring_intersection_contains(a, b))
}

theorem subring_intersection_constraint[R: Ring](a: Subring[R], b: Subring[R]) {
    subring_constraint(subring_intersection_contains(a, b))
}

let subring_intersection[R: Ring](a: Subring[R], b: Subring[R]) -> result: Subring[R] satisfy {
    Subring.new(subring_intersection_contains(a, b)) = Option.some(result)
}

attributes Subring[R: Ring] {
    /// Subring extensionality from pointwise equality of membership.
    let ext = subring_ext[R]

    /// The subset of ring elements belonging to this subring.
    define as_set(self) -> Set[R] {
        Set[R].new(self.contains)
    }

    /// The common part of two subrings.
    let intersection: (Subring[R], Subring[R]) -> Subring[R] = subring_intersection
}

define subring_subset[R: Ring](a: Subring[R], b: Subring[R]) -> Bool {
    forall(x: R) {
        a.contains(x) implies b.contains(x)
    }
}

theorem subring_subset_refl[R: Ring](a: Subring[R]) {
    subring_subset(a, a)
}

theorem subring_subset_trans[R: Ring](a: Subring[R], b: Subring[R], c: Subring[R]) {
    subring_subset(a, b) and subring_subset(b, c) implies subring_subset(a, c)
}

theorem subring_subset_antisymm[R: Ring](a: Subring[R], b: Subring[R]) {
    subring_subset(a, b) and subring_subset(b, a) implies a = b
}

theorem subring_eq_iff_subset_both[R: Ring](a: Subring[R], b: Subring[R]) {
    a = b = (subring_subset(a, b) and subring_subset(b, a))
}

define full_subring_contains[R: Ring](a: R) -> Bool {
    true
}

theorem full_subring_constraint[R: Ring] {
    subring_constraint(full_subring_contains[R])
}

let full_subring[R: Ring]: Subring[R] satisfy {
    Subring.new(full_subring_contains[R]) = Option.some(full_subring)
}

theorem full_subring_contains_everything[R: Ring](a: R) {
    full_subring[R].contains(a)
}

theorem full_subring_contains_eq[R: Ring](a: R) {
    full_subring[R].contains(a) = true
}

theorem subring_subset_full[R: Ring](s: Subring[R]) {
    subring_subset(s, full_subring[R])
}

define set_subset_subring[R: Ring](a: Set[R], s: Subring[R]) -> Bool {
    forall(x: R) {
        a.contains(x) implies s.contains(x)
    }
}

theorem set_subset_subring_trans[R: Ring](
    a: Set[R],
    s: Subring[R],
    t: Subring[R]
) {
    set_subset_subring(a, s) and subring_subset(s, t) implies set_subset_subring(a, t)
}

theorem set_subset_subring_of_set_subset[R: Ring](
    a: Set[R],
    b: Set[R],
    s: Subring[R]
) {
    a.subset(b) and set_subset_subring(b, s) implies set_subset_subring(a, s)
}

define subring_closure_contains[R: Ring](a: Set[R], x: R) -> Bool {
    forall(s: Subring[R]) {
        set_subset_subring(a, s) implies s.contains(x)
    }
}

theorem subring_closure_contains_of_set_subset_raw[R: Ring](
    a: Set[R],
    s: Subring[R],
    x: R
) {
    subring_closure_contains(a, x) and set_subset_subring(a, s) implies s.contains(x)
}

theorem subring_closure_zero_constraint[R: Ring](a: Set[R]) {
    subring_zero_constraint(subring_closure_contains(a))
}

theorem subring_closure_one_constraint[R: Ring](a: Set[R]) {
    subring_one_constraint(subring_closure_contains(a))
}

theorem subring_closure_add_constraint[R: Ring](a: Set[R]) {
    subring_add_constraint(subring_closure_contains(a))
}

theorem subring_closure_neg_constraint[R: Ring](a: Set[R]) {
    subring_neg_constraint(subring_closure_contains(a))
}

theorem subring_closure_mul_constraint[R: Ring](a: Set[R]) {
    subring_mul_constraint(subring_closure_contains(a))
}

theorem subring_generated_constraint[R: Ring](a: Set[R]) {
    subring_constraint(subring_closure_contains(a))
}

let subring_closure[R: Ring](a: Set[R]) -> result: Subring[R] satisfy {
    Subring.new(subring_closure_contains(a)) = Option.some(result)
}

theorem subring_closure_contains_eq[R: Ring](a: Set[R], x: R) {
    subring_closure(a).contains(x) = subring_closure_contains(a, x)
}

theorem subring_subset_closure[R: Ring](a: Set[R]) {
    set_subset_subring(a, subring_closure(a))
}

theorem subring_closure_contains_of_set_contains[R: Ring](a: Set[R], x: R) {
    a.contains(x) implies subring_closure(a).contains(x)
}

theorem subring_closure_subset_of_set_subset[R: Ring](a: Set[R], s: Subring[R]) {
    set_subset_subring(a, s) implies subring_subset(subring_closure(a), s)
}

theorem subring_closure_le_iff_set_subset[R: Ring](a: Set[R], s: Subring[R]) {
    subring_subset(subring_closure(a), s) = set_subset_subring(a, s)
}

theorem subring_closure_mono[R: Ring](a: Set[R], b: Set[R]) {
    a.subset(b) implies subring_subset(subring_closure(a), subring_closure(b))
}

theorem subring_closure_eq_of_set_eq[R: Ring](a: Set[R], b: Set[R]) {
    a = b implies subring_closure(a) = subring_closure(b)
}

theorem subring_closure_universal[R: Ring] {
    subring_closure(Set[R].universal_set) = full_subring[R]
}

define subring_is_finitely_generated[R: Ring](s: Subring[R]) -> Bool {
    exists(a: Set[R]) {
        a.is_finite and subring_closure(a) = s
    }
}

theorem subring_is_finitely_generated_witness[R: Ring](s: Subring[R]) {
    subring_is_finitely_generated(s) implies exists(a: Set[R]) {
        a.is_finite and subring_closure(a) = s
    }
}

theorem subring_is_finitely_generated_of_closure_eq[R: Ring](a: Set[R], s: Subring[R]) {
    a.is_finite and subring_closure(a) = s implies subring_is_finitely_generated(s)
}

theorem subring_is_finitely_generated_of_eq[R: Ring](s: Subring[R], t: Subring[R]) {
    subring_is_finitely_generated(s) and s = t implies subring_is_finitely_generated(t)
}

theorem subring_closure_is_finitely_generated[R: Ring](a: Set[R]) {
    a.is_finite implies subring_is_finitely_generated(subring_closure(a))
}

theorem subring_closure_singleton_is_finitely_generated[R: Ring](a: R) {
    subring_is_finitely_generated(subring_closure(Set[R].singleton(a)))
}

theorem subring_closure_singleton_contains[R: Ring](a: R) {
    subring_closure(Set[R].singleton(a)).contains(a)
}

theorem subring_add_subgroup_constraint[R: Ring](s: Subring[R]) {
    add_subgroup_constraint(s.contains)
}

let subring_to_add_subgroup[R: Ring](s: Subring[R]) -> result: AddSubgroup[R] satisfy {
    AddSubgroup.new(s.contains) = Option.some(result)
}

theorem subring_to_add_subgroup_contains[R: Ring](s: Subring[R]) {
    subring_to_add_subgroup(s).contains = s.contains
}

theorem subring_to_add_subgroup_contains_eq[R: Ring](s: Subring[R], x: R) {
    subring_to_add_subgroup(s).contains(x) = s.contains(x)
}

theorem subring_contains_to_add_subgroup_eq[R: Ring](s: Subring[R], x: R) {
    s.contains(x) = subring_to_add_subgroup(s).contains(x)
}

theorem subring_submonoid_constraint[R: Ring](s: Subring[R]) {
    submonoid_constraint(s.contains)
}

let subring_to_submonoid[R: Ring](s: Subring[R]) -> result: Submonoid[R] satisfy {
    Submonoid.new(s.contains) = Option.some(result)
}

theorem subring_to_submonoid_contains[R: Ring](s: Subring[R]) {
    subring_to_submonoid(s).contains = s.contains
}

theorem subring_to_submonoid_contains_eq[R: Ring](s: Subring[R], x: R) {
    subring_to_submonoid(s).contains(x) = s.contains(x)
}

theorem subring_contains_to_submonoid_eq[R: Ring](s: Subring[R], x: R) {
    s.contains(x) = subring_to_submonoid(s).contains(x)
}

define subring_image_contains[R: Ring, S: Ring](
    f: RingHom[R, S],
    s: Subring[R],
    y: S
) -> Bool {
    exists(x: R) {
        s.contains(x) and f.hom(x) = y
    }
}

theorem subring_image_zero_constraint[R: Ring, S: Ring](
    f: RingHom[R, S],
    s: Subring[R]
) {
    subring_zero_constraint(subring_image_contains(f, s))
}

theorem subring_image_one_constraint[R: Ring, S: Ring](
    f: RingHom[R, S],
    s: Subring[R]
) {
    subring_one_constraint(subring_image_contains(f, s))
}

theorem subring_image_add_constraint[R: Ring, S: Ring](
    f: RingHom[R, S],
    s: Subring[R]
) {
    subring_add_constraint(subring_image_contains(f, s))
}

theorem subring_image_neg_constraint[R: Ring, S: Ring](
    f: RingHom[R, S],
    s: Subring[R]
) {
    subring_neg_constraint(subring_image_contains(f, s))
}

theorem subring_image_mul_constraint[R: Ring, S: Ring](
    f: RingHom[R, S],
    s: Subring[R]
) {
    subring_mul_constraint(subring_image_contains(f, s))
}

theorem subring_image_constraint[R: Ring, S: Ring](
    f: RingHom[R, S],
    s: Subring[R]
) {
    subring_constraint(subring_image_contains(f, s))
}

let subring_image[R: Ring, S: Ring](f: RingHom[R, S], s: Subring[R]) -> result: Subring[S] satisfy {
    Subring.new(subring_image_contains(f, s)) = Option.some(result)
}

theorem subring_image_contains_eq[R: Ring, S: Ring](
    f: RingHom[R, S],
    s: Subring[R],
    y: S
) {
    subring_image(f, s).contains(y) = exists(x: R) {
        s.contains(x) and f.hom(x) = y
    }
}

theorem subring_image_contains_hom[R: Ring, S: Ring](
    f: RingHom[R, S],
    s: Subring[R],
    x: R
) {
    s.contains(x) implies subring_image(f, s).contains(f.hom(x))
}

theorem subring_image_contains_witness[R: Ring, S: Ring](
    f: RingHom[R, S],
    s: Subring[R],
    y: S
) {
    subring_image(f, s).contains(y) implies exists(x: R) {
        s.contains(x) and f.hom(x) = y
    }
}

theorem subring_image_subset_of_subset[R: Ring, S: Ring](
    f: RingHom[R, S],
    s: Subring[R],
    t: Subring[R]
) {
    subring_subset(s, t) implies subring_subset(subring_image(f, s), subring_image(f, t))
}

theorem subring_image_compose[R: Ring, S: Ring, T: Ring](
    f: RingHom[S, T],
    g: RingHom[R, S],
    s: Subring[R]
) {
    subring_image(compose_ring_hom(f, g), s) = subring_image(f, subring_image(g, s))
}

define subring_preimage_contains[R: Ring, S: Ring](
    f: RingHom[R, S],
    t: Subring[S],
    a: R
) -> Bool {
    t.contains(f.hom(a))
}

theorem subring_preimage_zero_constraint[R: Ring, S: Ring](
    f: RingHom[R, S],
    t: Subring[S]
) {
    subring_zero_constraint(subring_preimage_contains(f, t))
}

theorem subring_preimage_one_constraint[R: Ring, S: Ring](
