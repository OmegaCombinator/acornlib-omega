    f: RingHom[S, T],
    s: Set[S],
    u: Set[T]
) {
    ring_hom_image(f, s).subset(u) = s.subset(ring_hom_preimage(f, u))
}

theorem ring_hom_image_compose[S: Ring, T: Ring, U: Ring](
    f: RingHom[T, U],
    g: RingHom[S, T],
    s: Set[S]
) {
    ring_hom_image(compose_ring_hom(f, g), s) =
        ring_hom_image(f, ring_hom_image(g, s))
