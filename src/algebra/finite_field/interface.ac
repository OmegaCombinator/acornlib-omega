theorem ideal_quotient_project_sub_eq_zero_of_project_eq[R: CommRing](i: Ideal[R], a: R, b: R) {
    ideal_quotient_project(i, a) = ideal_quotient_project(i, b) implies
    ideal_quotient_project(i, a - b) = ideal_quotient_zero(i)
