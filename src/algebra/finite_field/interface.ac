theorem ideal_quotient_project_eq_of_project_sub_eq_zero[R: CommRing](i: Ideal[R], a: R, b: R) {
    ideal_quotient_project(i, a - b) = ideal_quotient_zero(i) implies
    ideal_quotient_project(i, a) = ideal_quotient_project(i, b)
