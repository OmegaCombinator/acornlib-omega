theorem set_subset_submonoid_of_set_subset[M: Monoid](
    a: Set[M],
    b: Set[M],
    s: Submonoid[M]
) {
    a.subset(b) and set_subset_submonoid(b, s) implies set_subset_submonoid(a, s)
