theorem ring_hom_image_contains_witness[S: Ring, T: Ring](
    f: RingHom[S, T],
    s: Set[S],
    y: T
) {
    ring_hom_image(f, s).contains(y) implies exists(x: S) {
        s.contains(x) and y = f.hom(x)
    }
}

theorem ring_hom_maps_into_image[S: Ring, T: Ring](
    f: RingHom[S, T],
    s: Set[S],
