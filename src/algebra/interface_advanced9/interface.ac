theorem vector_space_ne_zero_of_singleton_independent[F: Field, V: AddCommGroup](
    m: Module[F, V], v: V
) {
    vector_space_singleton_independent(m, v) implies v != V.0
}

theorem vector_space_singleton_independent_iff_ne_zero[F: Field, V: AddCommGroup](
    m: Module[F, V], v: V
) {
    vector_space_singleton_independent(m, v) iff v != V.0
}

theorem set_subset_submonoid_union[M: Monoid](a: Set[M], b: Set[M], s: Submonoid[M]) {
    set_subset_submonoid(a, s) and set_subset_submonoid(b, s) implies
        set_subset_submonoid(a.union(b), s)
}

theorem set_subset_submonoid_left_closure_sup[M: Monoid](a: Set[M], b: Set[M]) {
    set_subset_submonoid(a, submonoid_sup(submonoid_closure(a), submonoid_closure(b)))
}

theorem set_subset_submonoid_right_closure_sup[M: Monoid](a: Set[M], b: Set[M]) {
    set_subset_submonoid(b, submonoid_sup(submonoid_closure(a), submonoid_closure(b)))
}

theorem submonoid_closure_union_is_finitely_generated[M: Monoid](a: Set[M], b: Set[M]) {
    a.is_finite and b.is_finite implies
        submonoid_is_finitely_generated(submonoid_closure(a.union(b)))
}

theorem submonoid_sup_of_closure_finite_sets_eq_closure_union[M: Monoid](a: Set[M], b: Set[M]) {
    submonoid_sup(submonoid_closure(a), submonoid_closure(b)) = submonoid_closure(a.union(b))
}

theorem submonoid_sup_of_closure_finite_sets_is_finitely_generated[M: Monoid](a: Set[M], b: Set[M]) {
    a.is_finite and b.is_finite implies
        submonoid_is_finitely_generated(submonoid_sup(submonoid_closure(a), submonoid_closure(b)))
}

theorem submonoid_sup_is_finitely_generated[M: Monoid](s: Submonoid[M], t: Submonoid[M]) {
    submonoid_is_finitely_generated(s) and submonoid_is_finitely_generated(t) implies
        submonoid_is_finitely_generated(submonoid_sup(s, t))
}

theorem submonoid_sup_eq_closure_union_of_closure_eq[M: Monoid](
    a: Set[M],
    b: Set[M],
    s: Submonoid[M],
    t: Submonoid[M]
) {
    submonoid_closure(a) = s and submonoid_closure(b) = t implies
        submonoid_sup(s, t) = submonoid_closure(a.union(b))
}

theorem submonoid_sup_of_finite_generating_sets_is_finitely_generated[M: Monoid](
    a: Set[M],
    b: Set[M],
    s: Submonoid[M],
    t: Submonoid[M]
) {
    a.is_finite and b.is_finite and submonoid_closure(a) = s and submonoid_closure(b) = t implies
        submonoid_is_finitely_generated(submonoid_sup(s, t))
}

theorem submonoid_subset_contains_eq[M: Monoid](a: Submonoid[M], b: Submonoid[M]) {
    submonoid_subset(a, b) = forall(x: M) {
        a.contains(x) implies b.contains(x)
    }
}

theorem submonoid_subset_contains[M: Monoid](a: Submonoid[M], b: Submonoid[M], x: M) {
    submonoid_subset(a, b) and a.contains(x) implies b.contains(x)
}

theorem submonoid_subset_of_contains[M: Monoid](a: Submonoid[M], b: Submonoid[M]) {
    (forall(x: M) { a.contains(x) implies b.contains(x) }) implies submonoid_subset(a, b)
}

theorem submonoid_order_subset_refl[M: Monoid](a: Submonoid[M]) {
    submonoid_subset(a, a)
}

theorem submonoid_order_subset_trans[M: Monoid](
    a: Submonoid[M],
    b: Submonoid[M],
    c: Submonoid[M]
) {
    submonoid_subset(a, b) and submonoid_subset(b, c) implies submonoid_subset(a, c)
}

theorem submonoid_order_subset_antisymm[M: Monoid](a: Submonoid[M], b: Submonoid[M]) {
    submonoid_subset(a, b) and submonoid_subset(b, a) implies a = b
}

theorem submonoid_subset_as_set_iff[M: Monoid](a: Submonoid[M], b: Submonoid[M]) {
    submonoid_subset(a, b) = a.as_set.subset(b.as_set)
}

theorem submonoid_as_set_subset_contains[M: Monoid](a: Submonoid[M], b: Submonoid[M], x: M) {
    a.as_set.subset(b.as_set) and a.contains(x) implies b.contains(x)
}

theorem submonoid_intersection_greatest_lower_bound[M: Monoid](
    c: Submonoid[M],
    a: Submonoid[M],
    b: Submonoid[M]
) {
    submonoid_subset(c, a.intersection(b)) = (submonoid_subset(c, a) and submonoid_subset(c, b))
}

theorem submonoid_subset_left_of_subset_intersection[M: Monoid](
    c: Submonoid[M],
    a: Submonoid[M],
    b: Submonoid[M]
) {
    submonoid_subset(c, a.intersection(b)) implies submonoid_subset(c, a)
}

theorem submonoid_subset_right_of_subset_intersection[M: Monoid](
    c: Submonoid[M],
    a: Submonoid[M],
    b: Submonoid[M]
) {
    submonoid_subset(c, a.intersection(b)) implies submonoid_subset(c, b)
}

theorem submonoid_subset_intersection_of_subset_both[M: Monoid](
    c: Submonoid[M],
    a: Submonoid[M],
    b: Submonoid[M]
) {
    submonoid_subset(c, a) and submonoid_subset(c, b) implies submonoid_subset(c, a.intersection(b))
}

theorem submonoid_closure_monotone[M: Monoid](a: Set[M], b: Set[M]) {
    a.subset(b) implies submonoid_subset(submonoid_closure(a), submonoid_closure(b))
}

theorem submonoid_closure_as_set_monotone[M: Monoid](a: Set[M], b: Set[M]) {
    a.subset(b) implies submonoid_closure(a).as_set.subset(submonoid_closure(b).as_set)
}

theorem submonoid_closure_subset_iff_as_set_subset[M: Monoid](a: Set[M], s: Submonoid[M]) {
    submonoid_subset(submonoid_closure(a), s) = a.subset(s.as_set)
}

theorem submonoid_subset_antisymm_iff_eq[M: Monoid](a: Submonoid[M], b: Submonoid[M]) {
    (submonoid_subset(a, b) and submonoid_subset(b, a)) = (a = b)
}

theorem submonoid_intersection_mono_left[M: Monoid](
    a: Submonoid[M],
    b: Submonoid[M],
    c: Submonoid[M]
) {
    submonoid_subset(a, b) implies submonoid_subset(a.intersection(c), b.intersection(c))
}

theorem submonoid_intersection_mono_right[M: Monoid](
    a: Submonoid[M],
    b: Submonoid[M],
    c: Submonoid[M]
) {
    submonoid_subset(a, b) implies submonoid_subset(c.intersection(a), c.intersection(b))
}

theorem submonoid_intersection_mono[M: Monoid](
    a: Submonoid[M],
    b: Submonoid[M],
    c: Submonoid[M],
    d: Submonoid[M]
) {
    submonoid_subset(a, b) and submonoid_subset(c, d) implies
        submonoid_subset(a.intersection(c), b.intersection(d))
}

theorem submonoid_sup_mono_left[M: Monoid](
    a: Submonoid[M],
    b: Submonoid[M],
    c: Submonoid[M]
) {
    submonoid_subset(a, b) implies submonoid_subset(submonoid_sup(a, c), submonoid_sup(b, c))
}

theorem submonoid_sup_mono_right[M: Monoid](
    a: Submonoid[M],
    b: Submonoid[M],
    c: Submonoid[M]
) {
    submonoid_subset(a, b) implies submonoid_subset(submonoid_sup(c, a), submonoid_sup(c, b))
}

theorem submonoid_sup_mono[M: Monoid](
    a: Submonoid[M],
    b: Submonoid[M],
    c: Submonoid[M],
    d: Submonoid[M]
) {
    submonoid_subset(a, b) and submonoid_subset(c, d) implies
        submonoid_subset(submonoid_sup(a, c), submonoid_sup(b, d))
}

theorem submonoid_closure_eq_of_mutual_as_set_subset[M: Monoid](a: Set[M], b: Set[M]) {
    a.subset(submonoid_closure(b).as_set) and b.subset(submonoid_closure(a).as_set) implies
        submonoid_closure(a) = submonoid_closure(b)
}

theorem monoid_pow_suc_left[M: Monoid](a: M, n: Nat) {
    a.pow(n.suc) = a * a.pow(n)
}

theorem monoid_pow_suc_right[M: Monoid](a: M, n: Nat) {
    a.pow(n.suc) = a.pow(n) * a
}

theorem monoid_pow_comm[M: Monoid](a: M, m: Nat, n: Nat) {
    a.pow(m) * a.pow(n) = a.pow(n) * a.pow(m)
}

theorem monoid_pow_comm_self[M: Monoid](a: M, n: Nat) {
    a * a.pow(n) = a.pow(n) * a
}

theorem monoid_pow_pow_comm[M: Monoid](a: M, m: Nat, n: Nat) {
    a.pow(m).pow(n) = a.pow(n).pow(m)
}

theorem group_idempotent_is_identity[G: Group](a: G) {
    is_idempotent_elem(a) implies a = G.1
}

theorem comm_monoid_pow_mul[M: CommMonoid](a: M, b: M, n: Nat) {
    (a * b).pow(n) = a.pow(n) * b.pow(n)
}

theorem monoid_comm_pow_right[M: Monoid](a: M, b: M, n: Nat) {
    a * b = b * a implies a * b.pow(n) = b.pow(n) * a
}

theorem monoid_comm_pow_add_step[M: Monoid](a: M, b: M, k: Nat) {
    a * b = b * a and (a * b).pow(k) = a.pow(k) * b.pow(k)
        implies (a * b).pow(k.suc) = a.pow(k.suc) * b.pow(k.suc)
}

theorem monoid_comm_pow_add[M: Monoid](a: M, b: M, n: Nat) {
    a * b = b * a implies (a * b).pow(n) = a.pow(n) * b.pow(n)
}

define opposite_mul[M: Mul](a: M, b: M) -> M {
    b * a
}

theorem opposite_mul_eq[M: Mul](a: M, b: M) {
    opposite_mul(a, b) = b * a
}

theorem opposite_mul_rev_eq[M: Mul](a: M, b: M) {
    opposite_mul(b, a) = a * b
}

theorem opposite_mul_assoc[M: Semigroup](a: M, b: M, c: M) {
    opposite_mul(a, opposite_mul(b, c)) = opposite_mul(opposite_mul(a, b), c)
}

theorem opposite_mul_comm[M: CommSemigroup](a: M, b: M) {
    opposite_mul(a, b) = opposite_mul(b, a)
}

theorem opposite_mul_eq_mul[M: CommSemigroup](a: M, b: M) {
    opposite_mul(a, b) = a * b
}

theorem opposite_mul_one_right[M: Monoid](a: M) {
    opposite_mul(a, M.1) = a
}

theorem opposite_mul_one_left[M: Monoid](a: M) {
    opposite_mul(M.1, a) = a
}

theorem opposite_mul_inverse_right[G: Group](a: G) {
    opposite_mul(a, a.inverse) = G.1
}

theorem opposite_mul_inverse_left[G: Group](a: G) {
    opposite_mul(a.inverse, a) = G.1
}

theorem inverse_opposite_mul[G: Group](a: G, b: G) {
    opposite_mul(a, b).inverse = opposite_mul(b.inverse, a.inverse)
}

theorem inverse_mul_eq_opposite_inverse_mul[G: Group](a: G, b: G) {
    (a * b).inverse = opposite_mul(a.inverse, b.inverse)
}

theorem opposite_mul_zero_right[R: Semiring](a: R) {
    opposite_mul(a, R.0) = R.0
}

theorem opposite_mul_zero_left[R: Semiring](a: R) {
    opposite_mul(R.0, a) = R.0
}

theorem opposite_mul_add_distrib_left[R: Semiring](a: R, b: R, c: R) {
    opposite_mul(a, b + c) = opposite_mul(a, b) + opposite_mul(a, c)
}

theorem opposite_mul_add_distrib_right[R: Semiring](a: R, b: R, c: R) {
    opposite_mul(a + b, c) = opposite_mul(a, c) + opposite_mul(b, c)
}

theorem preserves_opposite_mul[A: Mul, B: Mul](f: A -> B) {
    (forall(a: A, b: A) { f(a * b) = f(a) * f(b) }) implies
    forall(a: A, b: A) {
        f(opposite_mul(a, b)) = opposite_mul(f(a), f(b))
    }
}

theorem opposite_mul_add_left_via_map[A: Semiring, B: Semiring](f: A -> B, a: A, b: A, c: A) {
    (forall(x: A, y: A) { f(x + y) = f(x) + f(y) }) and
    (forall(x: A, y: A) { f(x * y) = f(x) * f(y) }) implies
    f(opposite_mul(a, b + c)) = opposite_mul(f(a), f(b)) + opposite_mul(f(a), f(c))
}

structure MulOpposite[M] {
    /// The underlying value in the original carrier.
    val: M
}

define to_mul_opposite[M](x: M) -> MulOpposite[M] {
    MulOpposite.new(x)
}

define of_mul_opposite[M](x: MulOpposite[M]) -> M {
    x.val
}

theorem mul_opposite_ext[M](x: MulOpposite[M], y: MulOpposite[M]) {
    x.val = y.val implies x = y
}

theorem of_to_mul_opposite[M](x: M) {
    of_mul_opposite(to_mul_opposite(x)) = x
}

theorem to_of_mul_opposite[M](x: MulOpposite[M]) {
    to_mul_opposite(of_mul_opposite(x)) = x
}

theorem to_mul_opposite_val[M](x: M) {
    to_mul_opposite(x).val = x
}

attributes MulOpposite[M: Mul] {
    /// Multiplication in the opposite carrier is original multiplication with reversed factors.
    define mul(self, other: MulOpposite[M]) -> MulOpposite[M] {
        MulOpposite.new(opposite_mul(self.val, other.val))
    }
}

instance MulOpposite[M: Mul]: Mul {
    let mul = MulOpposite[M].mul
}

theorem mul_opposite_val_mul[M: Mul](x: MulOpposite[M], y: MulOpposite[M]) {
    (x * y).val = y.val * x.val
}

theorem mul_opposite_to_mul[M: Mul](x: M, y: M) {
    (to_mul_opposite(x) * to_mul_opposite(y)).val = y * x
}

theorem to_mul_opposite_opposite_mul[M: Mul](x: M, y: M) {
    to_mul_opposite(opposite_mul(x, y)) = to_mul_opposite(x) * to_mul_opposite(y)
}

let mul_opposite_one[M: One]: MulOpposite[M] = MulOpposite.new(M.1)

attributes MulOpposite[M: One] {
    /// The identity element of the opposite carrier is the original identity.
    let one: MulOpposite[M] = mul_opposite_one[M]
}

theorem mul_opposite_val_one[M: One] {
    MulOpposite[M].one.val = M.1
}

theorem mul_opposite_mul_assoc[M: Semigroup](x: MulOpposite[M], y: MulOpposite[M], z: MulOpposite[M]) {
    x * (y * z) = (x * y) * z
}

theorem mul_opposite_mul_is_associative[M: Semigroup] {
    forall(x: MulOpposite[M], y: MulOpposite[M], z: MulOpposite[M]) {
        x * (y * z) = (x * y) * z
    }
}

theorem mul_opposite_mul_is_associative_raw[M: Semigroup] {
    forall(x: MulOpposite[M], y: MulOpposite[M], z: MulOpposite[M]) {
        Mul.mul(x, Mul.mul(y, z)) = Mul.mul(Mul.mul(x, y), z)
    }
}

theorem mul_opposite_one_right_raw[M: Monoid] {
    forall(x: MulOpposite[M]) {
        Mul.mul(x, One.1[MulOpposite[M]]) = x
    }
}

theorem mul_opposite_one_left[M: Monoid](x: MulOpposite[M]) {
    MulOpposite[M].one * x = x
}

theorem mul_opposite_one_left_raw[M: Monoid] {
    forall(x: MulOpposite[M]) {
        Mul.mul(One.1[MulOpposite[M]], x) = x
    }
}

theorem mul_opposite_val_inverse[G: Group](x: MulOpposite[G]) {
    x.inverse.val = x.val.inverse
}

theorem mul_opposite_inverse_right[G: Group](x: MulOpposite[G]) {
    x * x.inverse = MulOpposite[G].one
}

theorem mul_opposite_inverse_right_raw[G: Group] {
    forall(x: MulOpposite[G]) {
        Mul.mul(x, x.inverse) = One.1[MulOpposite[G]]
    }
}

structure PointwiseFunction[T, A] {
    /// The underlying function.
    val: T -> A
}

theorem pointwise_function_ext[T, A](f: PointwiseFunction[T, A], g: PointwiseFunction[T, A]) {
    (forall(t: T) { f.val(t) = g.val(t) }) implies f = g
}

theorem pointwise_function_eq_val[T, A](f: PointwiseFunction[T, A], g: PointwiseFunction[T, A]) {
    f = g implies f.val = g.val
}

theorem pointwise_function_eq_apply[T, A](f: PointwiseFunction[T, A], g: PointwiseFunction[T, A], t: T) {
    f = g implies f.val(t) = g.val(t)
}

define pointwise_function_add[T, A: Add](f: PointwiseFunction[T, A], g: PointwiseFunction[T, A]) -> PointwiseFunction[T, A] {
    PointwiseFunction.new(pointwise_add(f.val, g.val))
}

define pointwise_function_mul[T, A: Mul](f: PointwiseFunction[T, A], g: PointwiseFunction[T, A]) -> PointwiseFunction[T, A] {
    PointwiseFunction.new(pointwise_mul(f.val, g.val))
}

let pointwise_function_zero[T, A: Zero]: PointwiseFunction[T, A] =
    PointwiseFunction.new(pointwise_zero[T, A])

/// The constant one wrapped function.
let pointwise_function_one[T, A: One]: PointwiseFunction[T, A] =
    PointwiseFunction.new(pointwise_one[T, A])

/// The pointwise negation of a wrapped function.
define pointwise_function_neg[T, A: Neg](f: PointwiseFunction[T, A]) -> PointwiseFunction[T, A] {
    PointwiseFunction.new(pointwise_neg(f.val))
}

attributes PointwiseFunction[T, A: Add] {
    /// Pointwise addition of wrapped functions.
    define add(self, other: PointwiseFunction[T, A]) -> PointwiseFunction[T, A] {
        pointwise_function_add(self, other)
    }
}

attributes PointwiseFunction[T, A: Zero] {
    /// The constant zero wrapped function.
    let zero: PointwiseFunction[T, A] = pointwise_function_zero[T, A]
}

attributes PointwiseFunction[T, A: Neg] {
    /// Pointwise additive inverse of a wrapped function.
    define neg(self) -> PointwiseFunction[T, A] {
        pointwise_function_neg(self)
    }
}

attributes PointwiseFunction[T, A: Mul] {
    /// Pointwise multiplication of wrapped functions.
    define mul(self, other: PointwiseFunction[T, A]) -> PointwiseFunction[T, A] {
        pointwise_function_mul(self, other)
    }
}

attributes PointwiseFunction[T, A: One] {
    /// The constant one wrapped function.
    let one: PointwiseFunction[T, A] = pointwise_function_one[T, A]
}

instance PointwiseFunction[T, A: Add]: Add {
    let add = PointwiseFunction[T, A].add
}

theorem pointwise_function_add_apply[T, A: Add](f: PointwiseFunction[T, A], g: PointwiseFunction[T, A], t: T) {
    (f + g).val(t) = f.val(t) + g.val(t)
}

theorem pointwise_function_zero_apply[T, A: Zero](t: T) {
    Zero.0[PointwiseFunction[T, A]].val(t) = A.0
}

theorem pointwise_function_neg_apply[T, A: Neg](f: PointwiseFunction[T, A], t: T) {
    (-f).val(t) = -f.val(t)
}

theorem pointwise_function_mul_apply[T, A: Mul](f: PointwiseFunction[T, A], g: PointwiseFunction[T, A], t: T) {
    (f * g).val(t) = f.val(t) * g.val(t)
}

theorem pointwise_function_one_apply[T, A: One](t: T) {
    One.1[PointwiseFunction[T, A]].val(t) = A.1
}

theorem pointwise_function_add_associative[T, A: AddSemigroup](
    f: PointwiseFunction[T, A],
    g: PointwiseFunction[T, A],
    h: PointwiseFunction[T, A]
) {
    f + (g + h) = (f + g) + h
}

theorem pointwise_function_add_commutative[T, A: AddCommSemigroup](
    f: PointwiseFunction[T, A],
    g: PointwiseFunction[T, A]
) {
    f + g = g + f
}

theorem pointwise_function_add_zero_right[T, A: AddMonoid](f: PointwiseFunction[T, A]) {
    f + Zero.0[PointwiseFunction[T, A]] = f
}

theorem pointwise_function_add_zero_left[T, A: AddMonoid](f: PointwiseFunction[T, A]) {
    Zero.0[PointwiseFunction[T, A]] + f = f
}

theorem pointwise_function_add_neg_right[T, A: AddGroup](f: PointwiseFunction[T, A]) {
    f + -f = Zero.0[PointwiseFunction[T, A]]
}

theorem pointwise_function_add_neg_left[T, A: AddGroup](f: PointwiseFunction[T, A]) {
    -f + f = Zero.0[PointwiseFunction[T, A]]
}

theorem pointwise_function_mul_associative[T, A: Semigroup](
    f: PointwiseFunction[T, A],
    g: PointwiseFunction[T, A],
    h: PointwiseFunction[T, A]
) {
    f * (g * h) = (f * g) * h
}

theorem pointwise_function_mul_commutative[T, A: CommSemigroup](
    f: PointwiseFunction[T, A],
    g: PointwiseFunction[T, A]
) {
    f * g = g * f
}

theorem pointwise_function_mul_one_right[T, A: Monoid](f: PointwiseFunction[T, A]) {
    f * One.1[PointwiseFunction[T, A]] = f
}

theorem pointwise_function_mul_one_left[T, A: Monoid](f: PointwiseFunction[T, A]) {
    One.1[PointwiseFunction[T, A]] * f = f
}

theorem pointwise_function_mul_add_left[T, A: Semiring](
    f: PointwiseFunction[T, A],
    g: PointwiseFunction[T, A],
    h: PointwiseFunction[T, A]
) {
    f * (g + h) = (f * g) + (f * h)
}

theorem pointwise_function_mul_add_right[T, A: Semiring](
    f: PointwiseFunction[T, A],
    g: PointwiseFunction[T, A],
    h: PointwiseFunction[T, A]
) {
    (f + g) * h = (f * h) + (g * h)
}

theorem pointwise_function_mul_zero_right[T, A: Semiring](f: PointwiseFunction[T, A]) {
    f * Zero.0[PointwiseFunction[T, A]] = Zero.0[PointwiseFunction[T, A]]
}

theorem pointwise_function_mul_zero_left[T, A: Semiring](f: PointwiseFunction[T, A]) {
    Zero.0[PointwiseFunction[T, A]] * f = Zero.0[PointwiseFunction[T, A]]
}

theorem pointwise_function_add_semigroup_law[T, A: AddSemigroup](
    f: PointwiseFunction[T, A],
    g: PointwiseFunction[T, A],
    h: PointwiseFunction[T, A]
) {
    Add.add(f, Add.add(g, h)) = Add.add(Add.add(f, g), h)
}

theorem pointwise_function_add_monoid_left_law[T, A: AddMonoid](f: PointwiseFunction[T, A]) {
    Add.add(Zero.0[PointwiseFunction[T, A]], f) = f
}

theorem pointwise_function_monoid_left_law[T, A: Monoid](f: PointwiseFunction[T, A]) {
    Mul.mul(One.1[PointwiseFunction[T, A]], f) = f
}

theorem pointwise_function_semiring_distrib_right_law[T, A: Semiring](
    f: PointwiseFunction[T, A],
    g: PointwiseFunction[T, A],
    h: PointwiseFunction[T, A]
) {
    Mul.mul(Add.add(f, g), h) = Add.add(Mul.mul(f, h), Mul.mul(g, h))
}

theorem pointwise_function_semiring_mul_zero_right_law[T, A: Semiring](f: PointwiseFunction[T, A]) {
    Mul.mul(f, Zero.0[PointwiseFunction[T, A]]) = Zero.0[PointwiseFunction[T, A]]
}

theorem pointwise_function_semiring_mul_zero_left_law[T, A: Semiring](f: PointwiseFunction[T, A]) {
    Mul.mul(Zero.0[PointwiseFunction[T, A]], f) = Zero.0[PointwiseFunction[T, A]]
}

define is_pair_unit[A: Monoid, B: Monoid](p: Pair[A, B]) -> Bool {
    exists(q: Pair[A, B]) {
        pair_mul(p, q) = pair_one[A, B] and pair_mul(q, p) = pair_one[A, B]
    }
}

define unit_pair_val[A: Monoid, B: Monoid](u: Pair[Unit[A], Unit[B]]) -> Pair[A, B] {
    Pair.new(u.first.val, u.second.val)
}

define unit_pair_inv[A: Monoid, B: Monoid](u: Pair[Unit[A], Unit[B]]) -> Pair[A, B] {
    Pair.new(u.first.inv, u.second.inv)
}

theorem unit_pair_val_first[A: Monoid, B: Monoid](u: Pair[Unit[A], Unit[B]]) {
    unit_pair_val(u).first = u.first.val
}

theorem unit_pair_val_second[A: Monoid, B: Monoid](u: Pair[Unit[A], Unit[B]]) {
    unit_pair_val(u).second = u.second.val
}

theorem unit_pair_inv_first[A: Monoid, B: Monoid](u: Pair[Unit[A], Unit[B]]) {
    unit_pair_inv(u).first = u.first.inv
}

theorem unit_pair_inv_second[A: Monoid, B: Monoid](u: Pair[Unit[A], Unit[B]]) {
    unit_pair_inv(u).second = u.second.inv
}

theorem unit_pair_val_mul_inv[A: Monoid, B: Monoid](u: Pair[Unit[A], Unit[B]]) {
    pair_mul(unit_pair_val(u), unit_pair_inv(u)) = pair_one[A, B]
}

theorem unit_pair_inv_mul_val[A: Monoid, B: Monoid](u: Pair[Unit[A], Unit[B]]) {
    pair_mul(unit_pair_inv(u), unit_pair_val(u)) = pair_one[A, B]
}

theorem unit_pair_val_is_pair_unit[A: Monoid, B: Monoid](u: Pair[Unit[A], Unit[B]]) {
    is_pair_unit(unit_pair_val(u))
}

theorem pair_of_unit_values_is_pair_unit[A: Monoid, B: Monoid](u: Unit[A], v: Unit[B]) {
    is_pair_unit(Pair.new(u.val, v.val))
}

theorem pair_unit_first_is_monoid_unit[A: Monoid, B: Monoid](p: Pair[A, B]) {
    is_pair_unit(p) implies is_monoid_unit(p.first)
}

theorem pair_unit_second_is_monoid_unit[A: Monoid, B: Monoid](p: Pair[A, B]) {
    is_pair_unit(p) implies is_monoid_unit(p.second)
}

theorem pair_unit_of_components[A: Monoid, B: Monoid](p: Pair[A, B]) {
    is_monoid_unit(p.first) and is_monoid_unit(p.second) implies is_pair_unit(p)
}

theorem pair_unit_iff_components[A: Monoid, B: Monoid](p: Pair[A, B]) {
    is_pair_unit(p) = (is_monoid_unit(p.first) and is_monoid_unit(p.second))
}

theorem pair_one_is_pair_unit[A: Monoid, B: Monoid] {
    is_pair_unit(pair_one[A, B])
}

theorem pair_unit_mul[A: Monoid, B: Monoid](p: Pair[A, B], q: Pair[A, B]) {
    is_pair_unit(p) and is_pair_unit(q) implies is_pair_unit(pair_mul(p, q))
}

theorem pair_unit_of_inverse[A: Monoid, B: Monoid](p: Pair[A, B], q: Pair[A, B]) {
    pair_mul(p, q) = pair_one[A, B] and pair_mul(q, p) = pair_one[A, B]
    implies is_pair_unit(p)
}

theorem pair_inverse_witness_is_pair_unit[A: Monoid, B: Monoid](p: Pair[A, B], q: Pair[A, B]) {
    pair_mul(p, q) = pair_one[A, B] and pair_mul(q, p) = pair_one[A, B]
    implies is_pair_unit(q)
}

theorem pair_unit_witness_components[A: Monoid, B: Monoid](p: Pair[A, B], q: Pair[A, B]) {
    pair_mul(p, q) = pair_one[A, B] and pair_mul(q, p) = pair_one[A, B]
    implies is_monoid_unit(p.first) and is_monoid_unit(p.second)
}

theorem unit_pair_inv_is_pair_unit[A: Monoid, B: Monoid](u: Pair[Unit[A], Unit[B]]) {
    is_pair_unit(unit_pair_inv(u))
}

theorem unit_pair_val_components_are_units[A: Monoid, B: Monoid](u: Pair[Unit[A], Unit[B]]) {
    is_monoid_unit(unit_pair_val(u).first) and is_monoid_unit(unit_pair_val(u).second)
}

theorem unit_pair_inv_components_are_units[A: Monoid, B: Monoid](u: Pair[Unit[A], Unit[B]]) {
    is_monoid_unit(unit_pair_inv(u).first) and is_monoid_unit(unit_pair_inv(u).second)
}

theorem pair_unit_of_group[A: Group, B: Group](p: Pair[A, B]) {
    is_pair_unit(p)
}

theorem pair_inverse_is_pair_unit[A: Group, B: Group](p: Pair[A, B]) {
    is_pair_unit(pair_inverse(p))
}

theorem pair_unit_mul_eq_zero_left_first[A: Ring, B: Ring](u: Pair[A, B], p: Pair[A, B]) {
    is_pair_unit(u) and pair_mul(u, p) = pair_zero[A, B] implies p.first = A.0
}

theorem pair_unit_mul_eq_zero_left_second[A: Ring, B: Ring](u: Pair[A, B], p: Pair[A, B]) {
    is_pair_unit(u) and pair_mul(u, p) = pair_zero[A, B] implies p.second = B.0
}

theorem pair_unit_mul_eq_zero_right_first[A: Ring, B: Ring](u: Pair[A, B], p: Pair[A, B]) {
    is_pair_unit(u) and pair_mul(p, u) = pair_zero[A, B] implies p.first = A.0
}

theorem pair_unit_mul_eq_zero_right_second[A: Ring, B: Ring](u: Pair[A, B], p: Pair[A, B]) {
    is_pair_unit(u) and pair_mul(p, u) = pair_zero[A, B] implies p.second = B.0
}

theorem pair_unit_mul_cancel_left_first[A: Ring, B: Ring](
    u: Pair[A, B],
    p: Pair[A, B],
    q: Pair[A, B]
) {
    is_pair_unit(u) and pair_mul(u, p) = pair_mul(u, q) implies p.first = q.first
}

theorem pair_unit_mul_cancel_left_second[A: Ring, B: Ring](
    u: Pair[A, B],
    p: Pair[A, B],
    q: Pair[A, B]
) {
    is_pair_unit(u) and pair_mul(u, p) = pair_mul(u, q) implies p.second = q.second
}

theorem pair_unit_mul_cancel_right_first[A: Ring, B: Ring](
    u: Pair[A, B],
    p: Pair[A, B],
    q: Pair[A, B]
) {
    is_pair_unit(u) and pair_mul(p, u) = pair_mul(q, u) implies p.first = q.first
}

theorem pair_unit_mul_cancel_right_second[A: Ring, B: Ring](
    u: Pair[A, B],
    p: Pair[A, B],
    q: Pair[A, B]
) {
    is_pair_unit(u) and pair_mul(p, u) = pair_mul(q, u) implies p.second = q.second
}

theorem pair_eq_zero_of_components_zero[A: Zero, B: Zero](p: Pair[A, B]) {
    p.first = A.0 and p.second = B.0 implies p = pair_zero[A, B]
}

theorem pair_eq_of_components_eq[A, B](p: Pair[A, B], q: Pair[A, B]) {
    p.first = q.first and p.second = q.second implies p = q
}

theorem pair_unit_mul_eq_zero_left_components[A: Ring, B: Ring](u: Pair[A, B], p: Pair[A, B]) {
    is_pair_unit(u) and pair_mul(u, p) = pair_zero[A, B] implies
    p.first = A.0 and p.second = B.0
}

theorem pair_unit_mul_eq_zero_left[A: Ring, B: Ring](u: Pair[A, B], p: Pair[A, B]) {
    is_pair_unit(u) and pair_mul(u, p) = pair_zero[A, B] implies p = pair_zero[A, B]
}

theorem pair_unit_mul_eq_zero_right_components[A: Ring, B: Ring](u: Pair[A, B], p: Pair[A, B]) {
    is_pair_unit(u) and pair_mul(p, u) = pair_zero[A, B] implies
    p.first = A.0 and p.second = B.0
}

theorem pair_unit_mul_eq_zero_right[A: Ring, B: Ring](u: Pair[A, B], p: Pair[A, B]) {
    is_pair_unit(u) and pair_mul(p, u) = pair_zero[A, B] implies p = pair_zero[A, B]
}

theorem pair_unit_mul_cancel_left_components[A: Ring, B: Ring](
    u: Pair[A, B],
    p: Pair[A, B],
    q: Pair[A, B]
) {
    is_pair_unit(u) and pair_mul(u, p) = pair_mul(u, q) implies
    p.first = q.first and p.second = q.second
}

theorem pair_unit_mul_cancel_left[A: Ring, B: Ring](
    u: Pair[A, B],
    p: Pair[A, B],
    q: Pair[A, B]
) {
    is_pair_unit(u) and pair_mul(u, p) = pair_mul(u, q) implies p = q
}

theorem pair_unit_mul_cancel_right_components[A: Ring, B: Ring](
    u: Pair[A, B],
    p: Pair[A, B],
    q: Pair[A, B]
) {
    is_pair_unit(u) and pair_mul(p, u) = pair_mul(q, u) implies
    p.first = q.first and p.second = q.second
}

theorem pair_unit_mul_cancel_right[A: Ring, B: Ring](
    u: Pair[A, B],
    p: Pair[A, B],
    q: Pair[A, B]
) {
    is_pair_unit(u) and pair_mul(p, u) = pair_mul(q, u) implies p = q
}

let ideal_quotient_relation[R: CommRing](i: Ideal[R]) -> result: QuotientRelation[R] satisfy {
    QuotientRelation[R].new(ideal_quotient_rel(i)) = Option.some(result)
}

theorem ideal_quotient_relation_rel[R: CommRing](i: Ideal[R]) {
    ideal_quotient_relation(i).rel = ideal_quotient_rel(i)
}

theorem ideal_quotient_rel_respects_neg[R: CommRing](i: Ideal[R]) {
    respects_unary_op(ideal_quotient_rel(i), R.neg)
}

theorem ideal_quotient_relation_respects_add[R: CommRing](i: Ideal[R]) {
    quotient_binary_respects(ideal_quotient_relation(i), R.add)
}

theorem ideal_quotient_relation_respects_mul[R: CommRing](i: Ideal[R]) {
    quotient_binary_respects(ideal_quotient_relation(i), R.mul)
}

theorem ideal_quotient_relation_respects_neg[R: CommRing](i: Ideal[R]) {
    quotient_unary_respects(ideal_quotient_relation(i), R.neg)
}

theorem ideal_quotient_rel_respects_sub[R: CommRing](i: Ideal[R]) {
    respects_binary_op(ideal_quotient_rel(i), R.sub)
}

theorem ideal_quotient_relation_respects_sub[R: CommRing](i: Ideal[R]) {
    quotient_binary_respects(ideal_quotient_relation(i), R.sub)
}

define ideal_quotient_add[R: CommRing](i: Ideal[R]) ->
    (QuotientOver[R], QuotientOver[R]) -> QuotientOver[R] {
    quotient_over_binary_op(R.add)
}

theorem ideal_quotient_add_projection[R: CommRing](i: Ideal[R], a: R, b: R) {
    ideal_quotient_add(i,
        quotient_over_mk(ideal_quotient_relation(i), a),
        quotient_over_mk(ideal_quotient_relation(i), b)
    ) = quotient_over_mk(ideal_quotient_relation(i), a + b)
}

theorem ideal_quotient_add_projection_left[R: CommRing](i: Ideal[R], a1: R, a2: R, b: R) {
    ideal_quotient_rel(i, a1, a2) implies
    ideal_quotient_add(i,
        quotient_over_mk(ideal_quotient_relation(i), a1),
        quotient_over_mk(ideal_quotient_relation(i), b)
    ) = ideal_quotient_add(i,
        quotient_over_mk(ideal_quotient_relation(i), a2),
        quotient_over_mk(ideal_quotient_relation(i), b)
    )
}

theorem ideal_quotient_add_projection_right[R: CommRing](i: Ideal[R], a: R, b1: R, b2: R) {
    ideal_quotient_rel(i, b1, b2) implies
    ideal_quotient_add(i,
        quotient_over_mk(ideal_quotient_relation(i), a),
        quotient_over_mk(ideal_quotient_relation(i), b1)
    ) = ideal_quotient_add(i,
        quotient_over_mk(ideal_quotient_relation(i), a),
        quotient_over_mk(ideal_quotient_relation(i), b2)
    )
}

define ideal_quotient_mul[R: CommRing](i: Ideal[R]) ->
    (QuotientOver[R], QuotientOver[R]) -> QuotientOver[R] {
    quotient_over_binary_op(R.mul)
}

theorem ideal_quotient_mul_projection[R: CommRing](i: Ideal[R], a: R, b: R) {
    ideal_quotient_mul(i,
        quotient_over_mk(ideal_quotient_relation(i), a),
        quotient_over_mk(ideal_quotient_relation(i), b)
    ) = quotient_over_mk(ideal_quotient_relation(i), a * b)
}

theorem ideal_quotient_mul_projection_left[R: CommRing](i: Ideal[R], a1: R, a2: R, b: R) {
    ideal_quotient_rel(i, a1, a2) implies
    ideal_quotient_mul(i,
        quotient_over_mk(ideal_quotient_relation(i), a1),
        quotient_over_mk(ideal_quotient_relation(i), b)
    ) = ideal_quotient_mul(i,
        quotient_over_mk(ideal_quotient_relation(i), a2),
        quotient_over_mk(ideal_quotient_relation(i), b)
    )
}

theorem ideal_quotient_mul_projection_right[R: CommRing](i: Ideal[R], a: R, b1: R, b2: R) {
    ideal_quotient_rel(i, b1, b2) implies
    ideal_quotient_mul(i,
        quotient_over_mk(ideal_quotient_relation(i), a),
        quotient_over_mk(ideal_quotient_relation(i), b1)
    ) = ideal_quotient_mul(i,
        quotient_over_mk(ideal_quotient_relation(i), a),
        quotient_over_mk(ideal_quotient_relation(i), b2)
    )
}

define ideal_quotient_neg[R: CommRing](i: Ideal[R]) ->
    QuotientOver[R] -> QuotientOver[R] {
    quotient_over_unary_op(ideal_quotient_relation(i), R.neg)
}

theorem ideal_quotient_neg_projection[R: CommRing](i: Ideal[R], a: R) {
    ideal_quotient_neg(i, quotient_over_mk(ideal_quotient_relation(i), a)) =
        quotient_over_mk(ideal_quotient_relation(i), -a)
}

theorem ideal_quotient_neg_projection_compatible[R: CommRing](i: Ideal[R], a: R, b: R) {
    ideal_quotient_rel(i, a, b) implies
    ideal_quotient_neg(i, quotient_over_mk(ideal_quotient_relation(i), a)) =
        ideal_quotient_neg(i, quotient_over_mk(ideal_quotient_relation(i), b))
}

define ideal_quotient_sub[R: CommRing](i: Ideal[R]) ->
    (QuotientOver[R], QuotientOver[R]) -> QuotientOver[R] {
    quotient_over_binary_op(R.sub)
}

theorem ideal_quotient_sub_projection[R: CommRing](i: Ideal[R], a: R, b: R) {
    ideal_quotient_sub(i,
        quotient_over_mk(ideal_quotient_relation(i), a),
        quotient_over_mk(ideal_quotient_relation(i), b)
    ) = quotient_over_mk(ideal_quotient_relation(i), a - b)
}

theorem ideal_quotient_sub_projection_left[R: CommRing](i: Ideal[R], a1: R, a2: R, b: R) {
    ideal_quotient_rel(i, a1, a2) implies
    ideal_quotient_sub(i,
        quotient_over_mk(ideal_quotient_relation(i), a1),
        quotient_over_mk(ideal_quotient_relation(i), b)
    ) = ideal_quotient_sub(i,
        quotient_over_mk(ideal_quotient_relation(i), a2),
        quotient_over_mk(ideal_quotient_relation(i), b)
    )
}

theorem ideal_quotient_sub_projection_right[R: CommRing](i: Ideal[R], a: R, b1: R, b2: R) {
    ideal_quotient_rel(i, b1, b2) implies
    ideal_quotient_sub(i,
        quotient_over_mk(ideal_quotient_relation(i), a),
        quotient_over_mk(ideal_quotient_relation(i), b1)
    ) = ideal_quotient_sub(i,
        quotient_over_mk(ideal_quotient_relation(i), a),
        quotient_over_mk(ideal_quotient_relation(i), b2)
    )
}

define ideal_quotient_zero[R: CommRing](i: Ideal[R]) -> QuotientOver[R] {
    quotient_over_mk(ideal_quotient_relation(i), R.0)
}

define ideal_quotient_one[R: CommRing](i: Ideal[R]) -> QuotientOver[R] {
    quotient_over_mk(ideal_quotient_relation(i), R.1)
}

theorem ideal_quotient_zero_projection[R: CommRing](i: Ideal[R]) {
    ideal_quotient_zero(i) = quotient_over_mk(ideal_quotient_relation(i), R.0)
}

theorem ideal_quotient_one_projection[R: CommRing](i: Ideal[R]) {
    ideal_quotient_one(i) = quotient_over_mk(ideal_quotient_relation(i), R.1)
}

define ideal_quotient_project[R: CommRing](i: Ideal[R], a: R) -> QuotientOver[R] {
    quotient_over_mk(ideal_quotient_relation(i), a)
}

theorem ideal_quotient_project_eq_mk[R: CommRing](i: Ideal[R], a: R) {
    ideal_quotient_project(i, a) = quotient_over_mk(ideal_quotient_relation(i), a)
}

theorem ideal_quotient_project_eq_of_rel[R: CommRing](i: Ideal[R], a: R, b: R) {
    ideal_quotient_rel(i, a, b) implies ideal_quotient_project(i, a) = ideal_quotient_project(i, b)
}

theorem ideal_quotient_rel_of_project_eq[R: CommRing](i: Ideal[R], a: R, b: R) {
    ideal_quotient_project(i, a) = ideal_quotient_project(i, b) implies ideal_quotient_rel(i, a, b)
}

theorem ideal_quotient_project_eq_iff_rel[R: CommRing](i: Ideal[R], a: R, b: R) {
    (ideal_quotient_project(i, a) = ideal_quotient_project(i, b)) = ideal_quotient_rel(i, a, b)
}

theorem ideal_quotient_project_eq_iff_contains_sub[R: CommRing](i: Ideal[R], a: R, b: R) {
    (ideal_quotient_project(i, a) = ideal_quotient_project(i, b)) = i.contains(a - b)
}

theorem ideal_quotient_project_eq_of_contains_sub[R: CommRing](i: Ideal[R], a: R, b: R) {
    i.contains(a - b) implies ideal_quotient_project(i, a) = ideal_quotient_project(i, b)
}

theorem ideal_quotient_contains_sub_of_project_eq[R: CommRing](i: Ideal[R], a: R, b: R) {
    ideal_quotient_project(i, a) = ideal_quotient_project(i, b) implies i.contains(a - b)
}

theorem ideal_quotient_project_eq_iff_principal_multiple[R: CommRing](m: R, a: R, b: R) {
    (ideal_quotient_project(Ideal[R].principal(m), a) =
        ideal_quotient_project(Ideal[R].principal(m), b)) =
        exists(q: R) { a - b = q * m }
}

theorem ideal_quotient_project_eq_of_principal_multiple[R: CommRing](m: R, a: R, b: R) {
    exists(q: R) { a - b = q * m } implies
        ideal_quotient_project(Ideal[R].principal(m), a) =
        ideal_quotient_project(Ideal[R].principal(m), b)
}

theorem principal_multiple_of_ideal_quotient_project_eq[R: CommRing](m: R, a: R, b: R) {
    ideal_quotient_project(Ideal[R].principal(m), a) =
        ideal_quotient_project(Ideal[R].principal(m), b)
        implies exists(q: R) { a - b = q * m }
}

theorem ideal_quotient_rel_zero_right[R: CommRing](i: Ideal[R], a: R) {
    ideal_quotient_rel(i, a, R.0) = i.contains(a)
}

theorem ideal_quotient_rel_zero_left[R: CommRing](i: Ideal[R], a: R) {
    ideal_quotient_rel(i, R.0, a) = i.contains(a)
}

theorem ideal_quotient_project_eq_zero_iff_contains[R: CommRing](i: Ideal[R], a: R) {
    (ideal_quotient_project(i, a) = ideal_quotient_zero(i)) = i.contains(a)
}

theorem ideal_quotient_zero_eq_project_iff_contains[R: CommRing](i: Ideal[R], a: R) {
    (ideal_quotient_zero(i) = ideal_quotient_project(i, a)) = i.contains(a)
}

theorem ideal_quotient_project_eq_zero_of_contains[R: CommRing](i: Ideal[R], a: R) {
    i.contains(a) implies ideal_quotient_project(i, a) = ideal_quotient_zero(i)
}

theorem ideal_quotient_contains_of_project_eq_zero[R: CommRing](i: Ideal[R], a: R) {
    ideal_quotient_project(i, a) = ideal_quotient_zero(i) implies i.contains(a)
}

theorem ideal_quotient_zero_eq_project_of_contains[R: CommRing](i: Ideal[R], a: R) {
    i.contains(a) implies ideal_quotient_zero(i) = ideal_quotient_project(i, a)
}

theorem ideal_quotient_contains_of_zero_eq_project[R: CommRing](i: Ideal[R], a: R) {
    ideal_quotient_zero(i) = ideal_quotient_project(i, a) implies i.contains(a)
}

theorem ideal_quotient_project_eq_zero_iff_principal_multiple[R: CommRing](m: R, a: R) {
    (ideal_quotient_project(Ideal[R].principal(m), a) =
        ideal_quotient_zero(Ideal[R].principal(m))) =
        exists(q: R) { a = q * m }
}

theorem ideal_quotient_project_eq_zero_of_principal_multiple[R: CommRing](m: R, a: R) {
    exists(q: R) { a = q * m } implies
        ideal_quotient_project(Ideal[R].principal(m), a) =
        ideal_quotient_zero(Ideal[R].principal(m))
}

theorem principal_multiple_of_ideal_quotient_project_eq_zero[R: CommRing](m: R, a: R) {
    ideal_quotient_project(Ideal[R].principal(m), a) =
        ideal_quotient_zero(Ideal[R].principal(m))
        implies exists(q: R) { a = q * m }
}

theorem ideal_quotient_project_sub_eq_zero_iff_rel[R: CommRing](i: Ideal[R], a: R, b: R) {
    (ideal_quotient_project(i, a - b) = ideal_quotient_zero(i)) = ideal_quotient_rel(i, a, b)
}

theorem ideal_quotient_project_sub_eq_zero_iff_contains_sub[R: CommRing](i: Ideal[R], a: R, b: R) {
    (ideal_quotient_project(i, a - b) = ideal_quotient_zero(i)) = i.contains(a - b)
}

theorem ideal_quotient_project_sub_eq_zero_of_rel[R: CommRing](i: Ideal[R], a: R, b: R) {
    ideal_quotient_rel(i, a, b) implies
    ideal_quotient_project(i, a - b) = ideal_quotient_zero(i)
