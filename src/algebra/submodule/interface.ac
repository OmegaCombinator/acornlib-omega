theorem linear_equiv_submodule_map_identity_contains_eq[R: Ring, M: AddCommGroup](
    m: Module[R, M], s: Submodule[R, M], x: M
) {
    s.carrier = m implies linear_equiv_submodule_map(linear_equiv_identity(m), s).contains(x) = s.contains(x)
}

theorem linear_equiv_submodule_map_identity_eq[R: Ring, M: AddCommGroup](
    m: Module[R, M], s: Submodule[R, M]
) {
    s.carrier = m implies linear_equiv_submodule_map(linear_equiv_identity(m), s) = s
}

theorem linear_equiv_submodule_map_symm_contains_eq[R: Ring, M: AddCommGroup, N: AddCommGroup](
    e: LinearEquiv[R, M, N], t: Submodule[R, N], x: M
) {
    t.carrier = e.dst implies
        linear_equiv_submodule_map(linear_equiv_symm(e), t).contains(x) = t.contains(e.to_fn(x))
}

theorem linear_equiv_submodule_map_symm_left_roundtrip_contains_eq[R: Ring, M: AddCommGroup, N: AddCommGroup](
    e: LinearEquiv[R, M, N], s: Submodule[R, M], x: M
) {
    s.carrier = e.src implies
        linear_equiv_submodule_map(linear_equiv_symm(e), linear_equiv_submodule_map(e, s)).contains(x) =
            s.contains(x)
}

theorem linear_equiv_submodule_map_symm_left_roundtrip_eq[R: Ring, M: AddCommGroup, N: AddCommGroup](
    e: LinearEquiv[R, M, N], s: Submodule[R, M]
) {
    s.carrier = e.src implies
        linear_equiv_submodule_map(linear_equiv_symm(e), linear_equiv_submodule_map(e, s)) = s
}

theorem linear_equiv_submodule_map_symm_right_roundtrip_contains_eq[R: Ring, M: AddCommGroup, N: AddCommGroup](
    e: LinearEquiv[R, M, N], t: Submodule[R, N], y: N
) {
    t.carrier = e.dst implies
        linear_equiv_submodule_map(e, linear_equiv_submodule_map(linear_equiv_symm(e), t)).contains(y) =
            t.contains(y)
}

theorem linear_equiv_submodule_map_symm_right_roundtrip_eq[R: Ring, M: AddCommGroup, N: AddCommGroup](
    e: LinearEquiv[R, M, N], t: Submodule[R, N]
) {
    t.carrier = e.dst implies
        linear_equiv_submodule_map(e, linear_equiv_submodule_map(linear_equiv_symm(e), t)) = t
}

theorem linear_equiv_submodule_map_compose_contains_eq[R: Ring, M: AddCommGroup, N: AddCommGroup, K: AddCommGroup](
    e: LinearEquiv[R, N, K], d: LinearEquiv[R, M, N], h: LinearEquiv[R, M, K],
    s: Submodule[R, M], z: K
) {
    e.src = d.dst and s.carrier = d.src and linear_equiv_compose(e, d) = Option.some(h) implies
        linear_equiv_submodule_map(h, s).contains(z) =
            linear_equiv_submodule_map(e, linear_equiv_submodule_map(d, s)).contains(z)
}

theorem linear_equiv_submodule_map_compose_eq[R: Ring, M: AddCommGroup, N: AddCommGroup, K: AddCommGroup](
    e: LinearEquiv[R, N, K], d: LinearEquiv[R, M, N], h: LinearEquiv[R, M, K],
    s: Submodule[R, M]
) {
    e.src = d.dst and s.carrier = d.src and linear_equiv_compose(e, d) = Option.some(h) implies
        linear_equiv_submodule_map(h, s) =
            linear_equiv_submodule_map(e, linear_equiv_submodule_map(d, s))
}

theorem linear_equiv_submodule_map_subset_iff[R: Ring, M: AddCommGroup, N: AddCommGroup](
    e: LinearEquiv[R, M, N], s1: Submodule[R, M], s2: Submodule[R, M]
) {
    s1.carrier = e.src and s2.carrier = e.src implies
        submodule_subset(linear_equiv_submodule_map(e, s1), linear_equiv_submodule_map(e, s2)) =
            submodule_subset(s1, s2)
}

theorem linear_equiv_submodule_map_eq_iff[R: Ring, M: AddCommGroup, N: AddCommGroup](
    e: LinearEquiv[R, M, N], s1: Submodule[R, M], s2: Submodule[R, M]
) {
    s1.carrier = e.src and s2.carrier = e.src implies
        (linear_equiv_submodule_map(e, s1) = linear_equiv_submodule_map(e, s2)) = (s1 = s2)
}

theorem linear_equiv_submodule_map_zero_eq_zero[R: Ring, M: AddCommGroup, N: AddCommGroup](
    e: LinearEquiv[R, M, N]
) {
    linear_equiv_submodule_map(e, zero_submodule(e.src)) = zero_submodule(e.dst)
}

theorem linear_equiv_submodule_map_full_eq_full[R: Ring, M: AddCommGroup, N: AddCommGroup](
    e: LinearEquiv[R, M, N]
) {
    linear_equiv_submodule_map(e, full_submodule(e.src)) = full_submodule(e.dst)
}

theorem linear_equiv_submodule_map_intersection_eq[R: Ring, M: AddCommGroup, N: AddCommGroup](
    e: LinearEquiv[R, M, N], s1: Submodule[R, M], s2: Submodule[R, M]
) {
    s1.carrier = e.src and s2.carrier = e.src implies
        linear_equiv_submodule_map(e, s1.intersection(s2)) =
            linear_equiv_submodule_map(e, s1).intersection(linear_equiv_submodule_map(e, s2))
}

theorem linear_equiv_submodule_map_sup_eq[R: Ring, M: AddCommGroup, N: AddCommGroup](
    e: LinearEquiv[R, M, N], s1: Submodule[R, M], s2: Submodule[R, M]
) {
    s1.carrier = e.src and s2.carrier = e.src implies
        linear_equiv_submodule_map(e, submodule_sup(s1, s2)) =
            submodule_sup(linear_equiv_submodule_map(e, s1), linear_equiv_submodule_map(e, s2))
}

theorem module_hom_compose_image_contains_implies_image_outer[R: Ring, M: AddCommGroup, N: AddCommGroup, K: AddCommGroup](
    f: ModuleHom[R, N, K], g: ModuleHom[R, M, N], h: ModuleHom[R, M, K], y: K
) {
    module_hom_compose(f, g) = Option.some(h) and module_hom_image(h).contains(y)
        implies module_hom_image(f).contains(y)
}

theorem module_hom_compose_image_subset_image_outer[R: Ring, M: AddCommGroup, N: AddCommGroup, K: AddCommGroup](
    f: ModuleHom[R, N, K], g: ModuleHom[R, M, N], h: ModuleHom[R, M, K]
) {
    module_hom_compose(f, g) = Option.some(h)
        implies submodule_subset(module_hom_image(h), module_hom_image(f))
}

theorem module_hom_image_outer_contains_implies_compose_image_of_surjective_inner[R: Ring, M: AddCommGroup, N: AddCommGroup, K: AddCommGroup](
    f: ModuleHom[R, N, K], g: ModuleHom[R, M, N], h: ModuleHom[R, M, K], y: K
) {
    module_hom_compose(f, g) = Option.some(h) and is_surjective_fn(g.hom)
        and module_hom_image(f).contains(y)
        implies module_hom_image(h).contains(y)
}

theorem module_hom_image_outer_subset_compose_image_of_surjective_inner[R: Ring, M: AddCommGroup, N: AddCommGroup, K: AddCommGroup](
    f: ModuleHom[R, N, K], g: ModuleHom[R, M, N], h: ModuleHom[R, M, K]
) {
    module_hom_compose(f, g) = Option.some(h) and is_surjective_fn(g.hom)
        implies submodule_subset(module_hom_image(f), module_hom_image(h))
}

theorem module_hom_compose_image_eq_image_outer_of_surjective_inner[R: Ring, M: AddCommGroup, N: AddCommGroup, K: AddCommGroup](
    f: ModuleHom[R, N, K], g: ModuleHom[R, M, N], h: ModuleHom[R, M, K]
) {
    module_hom_compose(f, g) = Option.some(h) and is_surjective_fn(g.hom)
        implies module_hom_image(h) = module_hom_image(f)
}

theorem module_hom_identity_kernel_eq_zero_submodule[R: Ring, M: AddCommGroup](
    m: Module[R, M]
) {
    module_hom_kernel(module_hom_identity(m)) = zero_submodule(m)
}

theorem module_hom_identity_image_eq_full_submodule[R: Ring, M: AddCommGroup](
    m: Module[R, M]
) {
    module_hom_image(module_hom_identity(m)) = full_submodule(m)
}

theorem zero_submodule_subset_module_hom_kernel[R: Ring, M: AddCommGroup, N: AddCommGroup](
    f: ModuleHom[R, M, N]
) {
    submodule_subset(zero_submodule(f.src), module_hom_kernel(f))
}

theorem module_hom_image_subset_full[R: Ring, M: AddCommGroup, N: AddCommGroup](
    f: ModuleHom[R, M, N]
) {
    submodule_subset(module_hom_image(f), full_submodule(f.dst))
}

theorem module_hom_kernel_eq_zero_of_injective[R: Ring, M: AddCommGroup, N: AddCommGroup](
    f: ModuleHom[R, M, N]
) {
    is_injective_fn(f.hom) implies module_hom_kernel(f) = zero_submodule(f.src)
}

theorem module_hom_image_eq_full_of_surjective[R: Ring, M: AddCommGroup, N: AddCommGroup](
    f: ModuleHom[R, M, N]
) {
    is_surjective_fn(f.hom) implies module_hom_image(f) = full_submodule(f.dst)
}

theorem module_hom_forall_preimage_of_image_eq_full[R: Ring, M: AddCommGroup, N: AddCommGroup](
    f: ModuleHom[R, M, N]
) {
    module_hom_image(f) = full_submodule(f.dst) implies forall(y: N) {
        exists(x: M) {
            f.hom(x) = y
        }
    }
}

theorem module_hom_surjective_of_image_eq_full[R: Ring, M: AddCommGroup, N: AddCommGroup](
    f: ModuleHom[R, M, N]
) {
    module_hom_image(f) = full_submodule(f.dst) implies is_surjective_fn(f.hom)
}

theorem module_hom_injective_iff_kernel_eq_zero[R: Ring, M: AddCommGroup, N: AddCommGroup](
    f: ModuleHom[R, M, N]
) {
    is_injective_fn(f.hom) = (module_hom_kernel(f) = zero_submodule(f.src))
}

theorem module_hom_surjective_iff_image_eq_full[R: Ring, M: AddCommGroup, N: AddCommGroup](
    f: ModuleHom[R, M, N]
) {
    is_surjective_fn(f.hom) = (module_hom_image(f) = full_submodule(f.dst))
}

theorem module_hom_trivial_image_contains_implies_zero[R: Ring, M: AddCommGroup, N: AddCommGroup](
    src: Module[R, M], dst: Module[R, N], y: N
) {
    module_hom_image(module_hom_trivial(src, dst)).contains(y) implies y = N.0
}

theorem module_hom_trivial_image_contains_zero[R: Ring, M: AddCommGroup, N: AddCommGroup](
    src: Module[R, M], dst: Module[R, N]
) {
    module_hom_image(module_hom_trivial(src, dst)).contains(N.0)
}

theorem module_hom_trivial_image_contains_eq[R: Ring, M: AddCommGroup, N: AddCommGroup](
    src: Module[R, M], dst: Module[R, N], y: N
) {
    module_hom_image(module_hom_trivial(src, dst)).contains(y) = (y = N.0)
}

theorem module_hom_trivial_image_contains_eq_zero_submodule[R: Ring, M: AddCommGroup, N: AddCommGroup](
    src: Module[R, M], dst: Module[R, N], y: N
) {
    module_hom_image(module_hom_trivial(src, dst)).contains(y) = zero_submodule(dst).contains(y)
}

theorem module_hom_trivial_kernel_eq_full_submodule[R: Ring, M: AddCommGroup, N: AddCommGroup](
    src: Module[R, M], dst: Module[R, N]
) {
    module_hom_kernel(module_hom_trivial(src, dst)) = full_submodule(src)
}

theorem module_hom_trivial_image_eq_zero_submodule[R: Ring, M: AddCommGroup, N: AddCommGroup](
    src: Module[R, M], dst: Module[R, N]
) {
    module_hom_image(module_hom_trivial(src, dst)) = zero_submodule(dst)
}

theorem submodule_subset_contains_at[R: Ring, M: AddCommGroup](
    a: Submodule[R, M], b: Submodule[R, M], x: M
) {
    submodule_subset(a, b) and a.contains(x) implies b.contains(x)
}

theorem predicate_subset_intro[T](p: T -> Bool, q: T -> Bool) {
    (forall(x: T) { p(x) implies q(x) }) implies predicate_subset(p, q)
}

theorem submodule_subset_intro[R: Ring, M: AddCommGroup](
    a: Submodule[R, M], b: Submodule[R, M]
) {
    (forall(x: M) { a.contains(x) implies b.contains(x) }) implies submodule_subset(a, b)
}

theorem set_subset_submodule_intro[R: Ring, M: AddCommGroup](a: Set[M], s: Submodule[R, M]) {
    (forall(x: M) { a.contains(x) implies s.contains(x) }) implies set_subset_submodule(a, s)
}

define linear_map_submodule_image_witness[R: Ring, M: AddCommGroup, N: AddCommGroup](
    s: Submodule[R, M], f: M -> N, y: N
) -> Bool {
    exists(x: M) {
        s.contains(x) and f(x) = y
    }
}

define linear_map_submodule_image[R: Ring, M: AddCommGroup, N: AddCommGroup](
    src: Module[R, M], dst: Module[R, N], f: M -> N, s: Submodule[R, M]
) -> Submodule[R, N] {
    submodule_closure(dst, set_image(s.as_set, f))
}

theorem linear_map_submodule_image_eq_closure[R: Ring, M: AddCommGroup, N: AddCommGroup](
    src: Module[R, M], dst: Module[R, N], f: M -> N, s: Submodule[R, M]
) {
    linear_map_submodule_image(src, dst, f, s) = submodule_closure(dst, set_image(s.as_set, f))
}

theorem linear_map_submodule_image_carrier_eq[R: Ring, M: AddCommGroup, N: AddCommGroup](
    src: Module[R, M], dst: Module[R, N], f: M -> N, s: Submodule[R, M]
) {
    linear_map_submodule_image(src, dst, f, s).carrier = dst
}

theorem linear_map_submodule_image_contains_of_witness[R: Ring, M: AddCommGroup, N: AddCommGroup](
    src: Module[R, M], dst: Module[R, N], f: M -> N, s: Submodule[R, M], y: N
) {
    linear_map_submodule_image_witness(s, f, y) implies
        linear_map_submodule_image(src, dst, f, s).contains(y)
}

theorem linear_map_submodule_image_contains_apply[R: Ring, M: AddCommGroup, N: AddCommGroup](
    src: Module[R, M], dst: Module[R, N], f: M -> N, s: Submodule[R, M], x: M
) {
    s.contains(x) implies linear_map_submodule_image(src, dst, f, s).contains(f(x))
}

theorem linear_map_submodule_image_subset_of_preimage_subset[R: Ring, M: AddCommGroup, N: AddCommGroup](
    src: Module[R, M], dst: Module[R, N], f: M -> N, s: Submodule[R, M], t: Submodule[R, N]
) {
    is_linear_map(src, dst, f) and s.carrier = src and t.carrier = dst
        and submodule_subset(s, linear_map_preimage_submodule(src, t, f))
    implies submodule_subset(linear_map_submodule_image(src, dst, f, s), t)
}

theorem linear_map_submodule_image_subset_preimage_of_image_subset[R: Ring, M: AddCommGroup, N: AddCommGroup](
    src: Module[R, M], dst: Module[R, N], f: M -> N, s: Submodule[R, M], t: Submodule[R, N]
) {
    is_linear_map(src, dst, f) and s.carrier = src and t.carrier = dst
        and submodule_subset(linear_map_submodule_image(src, dst, f, s), t)
    implies submodule_subset(s, linear_map_preimage_submodule(src, t, f))
}

theorem linear_map_submodule_image_subset_iff_preimage[R: Ring, M: AddCommGroup, N: AddCommGroup](
    src: Module[R, M], dst: Module[R, N], f: M -> N, s: Submodule[R, M], t: Submodule[R, N]
) {
    is_linear_map(src, dst, f) and s.carrier = src and t.carrier = dst implies
        submodule_subset(linear_map_submodule_image(src, dst, f, s), t) =
            submodule_subset(s, linear_map_preimage_submodule(src, t, f))
}

theorem linear_map_submodule_image_identity_contains_of_contains[R: Ring, M: AddCommGroup](
    src: Module[R, M], s: Submodule[R, M], x: M
) {
    s.contains(x) implies linear_map_submodule_image(src, src, identity_fn[M], s).contains(x)
}

theorem linear_map_submodule_image_identity[R: Ring, M: AddCommGroup](
    src: Module[R, M], s: Submodule[R, M]
) {
    s.carrier = src implies linear_map_submodule_image(src, src, identity_fn[M], s) = s
}

define module_hom_submodule_map[R: Ring, M: AddCommGroup, N: AddCommGroup](
    f: ModuleHom[R, M, N], s: Submodule[R, M]
) -> Submodule[R, N] {
    linear_map_submodule_image(f.src, f.dst, f.hom, s)
}

define module_hom_submodule_comap[R: Ring, M: AddCommGroup, N: AddCommGroup](
    f: ModuleHom[R, M, N], t: Submodule[R, N]
) -> Submodule[R, M] {
    linear_map_preimage_submodule(f.src, t, f.hom)
}

theorem module_hom_submodule_map_carrier_eq[R: Ring, M: AddCommGroup, N: AddCommGroup](
    f: ModuleHom[R, M, N], s: Submodule[R, M]
) {
    module_hom_submodule_map(f, s).carrier = f.dst
}

theorem module_hom_submodule_comap_carrier_eq[R: Ring, M: AddCommGroup, N: AddCommGroup](
    f: ModuleHom[R, M, N], t: Submodule[R, N]
) {
    module_hom_submodule_comap(f, t).carrier = f.src
}

theorem module_hom_submodule_map_contains_apply[R: Ring, M: AddCommGroup, N: AddCommGroup](
    f: ModuleHom[R, M, N], s: Submodule[R, M], x: M
) {
    s.contains(x) implies module_hom_submodule_map(f, s).contains(f.hom(x))
}

theorem module_hom_submodule_comap_contains_eq[R: Ring, M: AddCommGroup, N: AddCommGroup](
    f: ModuleHom[R, M, N], t: Submodule[R, N], x: M
) {
    t.carrier = f.dst implies module_hom_submodule_comap(f, t).contains(x) = t.contains(f.hom(x))
}

theorem module_hom_submodule_comap_contains_of_image_in[R: Ring, M: AddCommGroup, N: AddCommGroup](
    f: ModuleHom[R, M, N], t: Submodule[R, N], x: M
) {
    t.carrier = f.dst and t.contains(f.hom(x)) implies module_hom_submodule_comap(f, t).contains(x)
}

theorem module_hom_submodule_comap_image_in_of_contains[R: Ring, M: AddCommGroup, N: AddCommGroup](
    f: ModuleHom[R, M, N], t: Submodule[R, N], x: M
) {
    t.carrier = f.dst and module_hom_submodule_comap(f, t).contains(x) implies t.contains(f.hom(x))
}

theorem module_hom_submodule_map_subset_iff_comap[R: Ring, M: AddCommGroup, N: AddCommGroup](
    f: ModuleHom[R, M, N], s: Submodule[R, M], t: Submodule[R, N]
) {
    s.carrier = f.src and t.carrier = f.dst implies
        submodule_subset(module_hom_submodule_map(f, s), t) =
            submodule_subset(s, module_hom_submodule_comap(f, t))
}

theorem module_hom_submodule_map_mono[R: Ring, M: AddCommGroup, N: AddCommGroup](
    f: ModuleHom[R, M, N], s1: Submodule[R, M], s2: Submodule[R, M]
) {
    s1.carrier = f.src and s2.carrier = f.src and submodule_subset(s1, s2)
        implies submodule_subset(module_hom_submodule_map(f, s1), module_hom_submodule_map(f, s2))
}

theorem module_hom_submodule_comap_mono[R: Ring, M: AddCommGroup, N: AddCommGroup](
    f: ModuleHom[R, M, N], t1: Submodule[R, N], t2: Submodule[R, N]
) {
    t1.carrier = f.dst and t2.carrier = f.dst and submodule_subset(t1, t2)
        implies submodule_subset(module_hom_submodule_comap(f, t1), module_hom_submodule_comap(f, t2))
}

theorem module_hom_submodule_comap_full_eq_full[R: Ring, M: AddCommGroup, N: AddCommGroup](
    f: ModuleHom[R, M, N]
) {
    module_hom_submodule_comap(f, full_submodule(f.dst)) = full_submodule(f.src)
}

theorem module_hom_submodule_comap_zero_eq_kernel[R: Ring, M: AddCommGroup, N: AddCommGroup](
    f: ModuleHom[R, M, N]
) {
    module_hom_submodule_comap(f, zero_submodule(f.dst)) = module_hom_kernel(f)
}

theorem module_hom_submodule_map_subset_image[R: Ring, M: AddCommGroup, N: AddCommGroup](
    f: ModuleHom[R, M, N], s: Submodule[R, M]
) {
    s.carrier = f.src implies submodule_subset(module_hom_submodule_map(f, s), module_hom_image(f))
}

theorem module_hom_image_subset_submodule_map_full[R: Ring, M: AddCommGroup, N: AddCommGroup](
    f: ModuleHom[R, M, N]
) {
    submodule_subset(module_hom_image(f), module_hom_submodule_map(f, full_submodule(f.src)))
}

theorem module_hom_submodule_map_full_eq_image[R: Ring, M: AddCommGroup, N: AddCommGroup](
    f: ModuleHom[R, M, N]
) {
    module_hom_submodule_map(f, full_submodule(f.src)) = module_hom_image(f)
}

theorem module_hom_compose_kernel_contains_of_kernel[R: Ring, M: AddCommGroup, N: AddCommGroup, K: AddCommGroup](
    f: ModuleHom[R, N, K], g: ModuleHom[R, M, N], h: ModuleHom[R, M, K], x: M
) {
    module_hom_compose(f, g) = Option.some(h) and module_hom_kernel(g).contains(x)
        implies module_hom_kernel(h).contains(x)
}

theorem module_hom_kernel_inner_subset_module_hom_compose_kernel[R: Ring, M: AddCommGroup, N: AddCommGroup, K: AddCommGroup](
    f: ModuleHom[R, N, K], g: ModuleHom[R, M, N], h: ModuleHom[R, M, K]
) {
    module_hom_compose(f, g) = Option.some(h)
        implies submodule_subset(module_hom_kernel(g), module_hom_kernel(h))
}

theorem module_hom_compose_kernel_contains_implies_kernel_inner_of_injective_outer[R: Ring, M: AddCommGroup, N: AddCommGroup, K: AddCommGroup](
    f: ModuleHom[R, N, K], g: ModuleHom[R, M, N], h: ModuleHom[R, M, K], x: M
) {
    module_hom_compose(f, g) = Option.some(h) and is_injective_fn(f.hom)
        and module_hom_kernel(h).contains(x)
        implies module_hom_kernel(g).contains(x)
}

theorem module_hom_compose_kernel_subset_kernel_inner_of_injective_outer[R: Ring, M: AddCommGroup, N: AddCommGroup, K: AddCommGroup](
    f: ModuleHom[R, N, K], g: ModuleHom[R, M, N], h: ModuleHom[R, M, K]
) {
    module_hom_compose(f, g) = Option.some(h) and is_injective_fn(f.hom)
        implies submodule_subset(module_hom_kernel(h), module_hom_kernel(g))
}

theorem module_hom_compose_kernel_eq_kernel_inner_of_injective_outer[R: Ring, M: AddCommGroup, N: AddCommGroup, K: AddCommGroup](
    f: ModuleHom[R, N, K], g: ModuleHom[R, M, N], h: ModuleHom[R, M, K]
) {
    module_hom_compose(f, g) = Option.some(h) and is_injective_fn(f.hom)
        implies module_hom_kernel(h) = module_hom_kernel(g)
}

theorem module_hom_compose_kernel_eq_comap_kernel[R: Ring, M: AddCommGroup, N: AddCommGroup, K: AddCommGroup](
    f: ModuleHom[R, N, K], g: ModuleHom[R, M, N], h: ModuleHom[R, M, K]
) {
    f.src = g.dst and module_hom_compose(f, g) = Option.some(h) implies
        module_hom_kernel(h) = module_hom_submodule_comap(g, module_hom_kernel(f))
}

theorem linear_map_submodule_image_mono[R: Ring, M: AddCommGroup, N: AddCommGroup](
    src: Module[R, M], dst: Module[R, N], f: M -> N,
    s1: Submodule[R, M], s2: Submodule[R, M]
) {
    submodule_subset(s1, s2) implies submodule_subset(
        linear_map_submodule_image(src, dst, f, s1),
        linear_map_submodule_image(src, dst, f, s2))
}

theorem linear_map_submodule_image_subset_of_maps_into[R: Ring, M: AddCommGroup, N: AddCommGroup](
    src: Module[R, M], dst: Module[R, N], f: M -> N,
    s: Submodule[R, M], t: Submodule[R, N]
) {
    t.carrier = dst and (forall(x: M) { s.contains(x) implies t.contains(f(x)) })
    implies submodule_subset(linear_map_submodule_image(src, dst, f, s), t)
}

theorem linear_map_submodule_image_subset_iff_maps_into[R: Ring, M: AddCommGroup, N: AddCommGroup](
    src: Module[R, M], dst: Module[R, N], f: M -> N,
    s: Submodule[R, M], t: Submodule[R, N]
) {
    t.carrier = dst implies
        (submodule_subset(linear_map_submodule_image(src, dst, f, s), t) =
            forall(x: M) { s.contains(x) implies t.contains(f(x)) })
}

theorem linear_map_preimage_submodule_mono_of_subset[R: Ring, M: AddCommGroup, N: AddCommGroup](
    src: Module[R, M], dst: Module[R, N], f: M -> N,
    t1: Submodule[R, N], t2: Submodule[R, N]
) {
    t1.carrier = dst and t2.carrier = dst and is_linear_map(src, dst, f) and submodule_subset(t1, t2)
    implies submodule_subset(
        linear_map_preimage_submodule(src, t1, f),
        linear_map_preimage_submodule(src, t2, f))
}

theorem linear_map_submodule_subset_preimage_image[R: Ring, M: AddCommGroup, N: AddCommGroup](
    src: Module[R, M], dst: Module[R, N], f: M -> N, s: Submodule[R, M]
) {
    is_linear_map(src, dst, f) and s.carrier = src implies submodule_subset(
        s,
        linear_map_preimage_submodule(src, linear_map_submodule_image(src, dst, f, s), f))
}

theorem linear_map_submodule_image_preimage_subset[R: Ring, M: AddCommGroup, N: AddCommGroup](
    src: Module[R, M], dst: Module[R, N], f: M -> N, t: Submodule[R, N]
) {
    is_linear_map(src, dst, f) and t.carrier = dst implies submodule_subset(
        linear_map_submodule_image(src, dst, f, linear_map_preimage_submodule(src, t, f)),
        t)
}

theorem linear_map_preimage_submodule_full_eq_full[R: Ring, M: AddCommGroup, N: AddCommGroup](
    src: Module[R, M], dst: Module[R, N], f: M -> N
) {
    is_linear_map(src, dst, f) implies
        linear_map_preimage_submodule(src, full_submodule(dst), f) = full_submodule(src)
}

theorem linear_map_preimage_submodule_zero_eq_kernel[R: Ring, M: AddCommGroup, N: AddCommGroup](
    src: Module[R, M], dst: Module[R, N], f: M -> N
) {
    is_linear_map(src, dst, f) implies
        linear_map_preimage_submodule(src, zero_submodule(dst), f) = linear_map_kernel_submodule(src, dst, f)
}

theorem linear_map_preimage_submodule_identity[R: Ring, M: AddCommGroup](
    src: Module[R, M], t: Submodule[R, M]
) {
    t.carrier = src implies linear_map_preimage_submodule(src, t, identity_fn[M]) = t
}

theorem linear_map_submodule_image_subset_image_submodule[R: Ring, M: AddCommGroup, N: AddCommGroup](
    src: Module[R, M], dst: Module[R, N], f: M -> N, s: Submodule[R, M]
) {
    is_linear_map(src, dst, f) implies submodule_subset(
        linear_map_submodule_image(src, dst, f, s),
        linear_map_image_submodule(src, dst, f))
}

theorem linear_map_image_submodule_subset_submodule_image_full[R: Ring, M: AddCommGroup, N: AddCommGroup](
    src: Module[R, M], dst: Module[R, N], f: M -> N
) {
    is_linear_map(src, dst, f) implies submodule_subset(
        linear_map_image_submodule(src, dst, f),
        linear_map_submodule_image(src, dst, f, full_submodule(src)))
}

theorem linear_map_submodule_image_full_eq_image_submodule[R: Ring, M: AddCommGroup, N: AddCommGroup](
    src: Module[R, M], dst: Module[R, N], f: M -> N
) {
    is_linear_map(src, dst, f) implies
        linear_map_submodule_image(src, dst, f, full_submodule(src)) = linear_map_image_submodule(src, dst, f)
}

theorem linear_map_submodule_image_zero_eq_zero[R: Ring, M: AddCommGroup, N: AddCommGroup](
    src: Module[R, M], dst: Module[R, N], f: M -> N
) {
    is_linear_map(src, dst, f) implies
        linear_map_submodule_image(src, dst, f, zero_submodule(src)) = zero_submodule(dst)
}

theorem module_hom_submodule_map_subset_of_maps_into[R: Ring, M: AddCommGroup, N: AddCommGroup](
    f: ModuleHom[R, M, N], s: Submodule[R, M], t: Submodule[R, N]
) {
    t.carrier = f.dst and (forall(x: M) { s.contains(x) implies t.contains(f.hom(x)) })
        implies submodule_subset(module_hom_submodule_map(f, s), t)
}

theorem module_hom_submodule_map_subset_iff_maps_into[R: Ring, M: AddCommGroup, N: AddCommGroup](
    f: ModuleHom[R, M, N], s: Submodule[R, M], t: Submodule[R, N]
) {
    t.carrier = f.dst implies
        (submodule_subset(module_hom_submodule_map(f, s), t) =
            forall(x: M) { s.contains(x) implies t.contains(f.hom(x)) })
}

theorem module_hom_submodule_subset_comap_map[R: Ring, M: AddCommGroup, N: AddCommGroup](
    f: ModuleHom[R, M, N], s: Submodule[R, M]
) {
    s.carrier = f.src implies submodule_subset(s, module_hom_submodule_comap(f, module_hom_submodule_map(f, s)))
}

theorem module_hom_submodule_map_comap_subset[R: Ring, M: AddCommGroup, N: AddCommGroup](
    f: ModuleHom[R, M, N], t: Submodule[R, N]
) {
    t.carrier = f.dst implies submodule_subset(module_hom_submodule_map(f, module_hom_submodule_comap(f, t)), t)
}

theorem module_hom_submodule_comap_identity[R: Ring, M: AddCommGroup](
    src: Module[R, M], t: Submodule[R, M]
) {
    t.carrier = src implies module_hom_submodule_comap(module_hom_identity(src), t) = t
}

theorem module_hom_submodule_map_zero_eq_zero[R: Ring, M: AddCommGroup, N: AddCommGroup](
    f: ModuleHom[R, M, N]
) {
    module_hom_submodule_map(f, zero_submodule(f.src)) = zero_submodule(f.dst)
}

theorem linear_map_preimage_submodule_zero_eq_kernel_alt[R: Ring, M: AddCommGroup, N: AddCommGroup](
    src: Module[R, M], dst: Module[R, N], f: M -> N
) {
    is_linear_map(src, dst, f) implies
        linear_map_preimage_submodule(src, zero_submodule(dst), f) =
            linear_map_kernel_submodule(src, dst, f)
}

theorem linear_map_preimage_submodule_full_eq[R: Ring, M: AddCommGroup, N: AddCommGroup](
    src: Module[R, M], dst: Module[R, N], f: M -> N
) {
    is_linear_map(src, dst, f) implies
        linear_map_preimage_submodule(src, full_submodule(dst), f) = full_submodule(src)
}

theorem linear_map_kernel_compose_eq_preimage_kernel[R: Ring, M: AddCommGroup, N: AddCommGroup, K: AddCommGroup](
    src: Module[R, M], mid: Module[R, N], dst: Module[R, K], f: N -> K, g: M -> N
) {
    is_linear_map(mid, dst, f) and is_linear_map(src, mid, g) implies
        linear_map_kernel_submodule(src, dst, compose(f, g)) =
            linear_map_preimage_submodule(src, linear_map_kernel_submodule(mid, dst, f), g)
}

theorem vector_space_smul_eq_zero[F: Field, V: AddCommGroup](
    m: Module[F, V], r: F, v: V) {
    m.smul(r, v) = V.0 implies r = F.0 or v = V.0
}

theorem vector_space_smul_ne_zero[F: Field, V: AddCommGroup](
    m: Module[F, V], r: F, v: V) {
    r != F.0 and v != V.0 implies m.smul(r, v) != V.0
}

theorem vector_space_smul_inverse_left[F: Field, V: AddCommGroup](
    m: Module[F, V], r: F, v: V) {
    r != F.0 implies m.smul(r.inverse, m.smul(r, v)) = v
}

theorem vector_space_smul_inverse_right[F: Field, V: AddCommGroup](
    m: Module[F, V], r: F, v: V) {
    r != F.0 implies m.smul(r, m.smul(r.inverse, v)) = v
}

theorem vector_space_smul_left_cancel[F: Field, V: AddCommGroup](
    m: Module[F, V], r: F, u: V, v: V) {
    r != F.0 and m.smul(r, u) = m.smul(r, v) implies u = v
}

theorem vector_space_smul_right_cancel[F: Field, V: AddCommGroup](
    m: Module[F, V], r: F, s: F, v: V) {
    v != V.0 and m.smul(r, v) = m.smul(s, v) implies r = s
}

theorem vector_space_smul_eq_implies_eq_inverse_smul[F: Field, V: AddCommGroup](
    m: Module[F, V], r: F, u: V, v: V) {
    r != F.0 and m.smul(r, v) = u implies v = m.smul(r.inverse, u)
}

theorem vector_space_inverse_smul_implies_smul_eq[F: Field, V: AddCommGroup](
    m: Module[F, V], r: F, u: V, v: V) {
    r != F.0 and v = m.smul(r.inverse, u) implies m.smul(r, v) = u
}

theorem vector_space_smul_eq_iff_left_cancel[F: Field, V: AddCommGroup](
    m: Module[F, V], r: F, u: V, v: V) {
    r != F.0 implies (m.smul(r, u) = m.smul(r, v) iff u = v)
}

theorem vector_space_smul_eq_zero_iff[F: Field, V: AddCommGroup](
    m: Module[F, V], r: F, v: V) {
    m.smul(r, v) = V.0 iff (r = F.0 or v = V.0)
}

theorem vector_space_neg_smul_eq_smul_neg[F: Field, V: AddCommGroup](
    m: Module[F, V], r: F, v: V) {
    -m.smul(r, v) = m.smul(r, -v)
}

theorem vector_space_smul_eq_iff_right_cancel[F: Field, V: AddCommGroup](
    m: Module[F, V], r: F, s: F, v: V) {
    v != V.0 implies (m.smul(r, v) = m.smul(s, v) iff r = s)
}

theorem vector_space_smul_ne_zero_iff[F: Field, V: AddCommGroup](
    m: Module[F, V], r: F, v: V) {
    m.smul(r, v) != V.0 iff (r != F.0 and v != V.0)
}

theorem vector_space_smul_eq_iff_eq_inverse_smul[F: Field, V: AddCommGroup](
    m: Module[F, V], r: F, u: V, v: V) {
    r != F.0 implies (m.smul(r, v) = u iff v = m.smul(r.inverse, u))
}

theorem vector_space_smul_zero[F: Field, V: AddCommGroup](m: Module[F, V], v: V) {
    m.smul(F.0, v) = V.0
}

theorem vector_space_smul_one[F: Field, V: AddCommGroup](m: Module[F, V], v: V) {
    m.smul(F.1, v) = v
}

theorem vector_space_smul_neg_one[F: Field, V: AddCommGroup](m: Module[F, V], v: V) {
    m.smul(-F.1, v) = -v
}

theorem vector_space_subspace_criterion[F: Field, V: AddCommGroup](
    m: Module[F, V], contains: V -> Bool
) {
    (exists(x: V) { contains(x) })
    and (forall(a: V, b: V) { contains(a) and contains(b) implies contains(a + b) })
    and (forall(r: F, a: V) { contains(a) implies contains(m.smul(r, a)) })
    implies is_submodule(m, contains)
}

theorem vector_space_span_is_subspace[F: Field, V: AddCommGroup](m: Module[F, V], a: Set[V]) {
    is_submodule(m, submodule_closure(m, a).contains)
}

define vector_space_singleton_independent[F: Field, V: AddCommGroup](
    m: Module[F, V], v: V
) -> Bool {
    forall(r: F) {
        m.smul(r, v) = V.0 implies r = F.0
    }
}

theorem vector_space_singleton_independent_of_ne_zero[F: Field, V: AddCommGroup](
    m: Module[F, V], v: V
) {
    v != V.0 implies vector_space_singleton_independent(m, v)
}

theorem vector_space_ne_zero_of_singleton_independent[F: Field, V: AddCommGroup](
    m: Module[F, V], v: V
) {
    vector_space_singleton_independent(m, v) implies v != V.0
}

theorem vector_space_singleton_independent_iff_ne_zero[F: Field, V: AddCommGroup](
    m: Module[F, V], v: V
) {
    vector_space_singleton_independent(m, v) iff v != V.0
}

define monoid_hom_image[M: Monoid, N: Monoid](f: MonoidHom[M, N], s: Set[M]) -> Set[N] {
    set_image(s, f.hom)
}

define monoid_hom_preimage[M: Monoid, N: Monoid](f: MonoidHom[M, N], s: Set[N]) -> Set[M] {
    set_preimage(f.hom, s)
}

define monoid_hom_image_preimage_closure[M: Monoid, N: Monoid](
    f: MonoidHom[M, N],
    s: Set[M]
) -> Set[M] {
    set_image_preimage_closure(f.hom, s)
}

define monoid_hom_preimage_image_kernel[M: Monoid, N: Monoid](
    f: MonoidHom[M, N],
    s: Set[N]
) -> Set[N] {
    set_preimage_image_kernel(f.hom, s)
}

theorem monoid_hom_image_contains_witness[M: Monoid, N: Monoid](
    f: MonoidHom[M, N],
    s: Set[M],
    y: N
) {
    monoid_hom_image(f, s).contains(y) implies exists(x: M) {
        s.contains(x) and y = f.hom(x)
    }
}

theorem monoid_hom_maps_into_image[M: Monoid, N: Monoid](
    f: MonoidHom[M, N],
    s: Set[M],
    x: M
) {
    s.contains(x) implies monoid_hom_image(f, s).contains(f.hom(x))
}

theorem monoid_hom_image_subset_iff_subset_preimage[M: Monoid, N: Monoid](
    f: MonoidHom[M, N],
    s: Set[M],
    t: Set[N]
) {
    monoid_hom_image(f, s).subset(t) = s.subset(monoid_hom_preimage(f, t))
}

theorem monoid_hom_image_compose[M: Monoid, N: Monoid, P: Monoid](
    f: MonoidHom[N, P],
    g: MonoidHom[M, N],
    s: Set[M]
) {
    monoid_hom_image(compose_monoid_hom(f, g), s) =
        monoid_hom_image(f, monoid_hom_image(g, s))
}

theorem monoid_hom_preimage_compose[M: Monoid, N: Monoid, P: Monoid](
    f: MonoidHom[N, P],
    g: MonoidHom[M, N],
    s: Set[P]
) {
    monoid_hom_preimage(compose_monoid_hom(f, g), s) =
        monoid_hom_preimage(g, monoid_hom_preimage(f, s))
}

theorem monoid_hom_image_preimage_closure_extensive[M: Monoid, N: Monoid](
    f: MonoidHom[M, N],
    s: Set[M]
) {
    s.subset(monoid_hom_image_preimage_closure(f, s))
}

theorem monoid_hom_image_preimage_closure_monotone[M: Monoid, N: Monoid](
    f: MonoidHom[M, N]
) {
    is_subset_monotone_map(monoid_hom_image_preimage_closure(f))
}

theorem monoid_hom_image_preimage_closure_idempotent[M: Monoid, N: Monoid](
    f: MonoidHom[M, N],
    s: Set[M]
) {
    monoid_hom_image_preimage_closure(f, monoid_hom_image_preimage_closure(f, s)) =
        monoid_hom_image_preimage_closure(f, s)
}

theorem monoid_hom_image_preimage_closure_operator[M: Monoid, N: Monoid](
    f: MonoidHom[M, N]
) {
    is_set_closure_operator(monoid_hom_image_preimage_closure(f))
}

theorem monoid_hom_preimage_image_kernel_reductive[M: Monoid, N: Monoid](
    f: MonoidHom[M, N],
    s: Set[N]
) {
    monoid_hom_preimage_image_kernel(f, s).subset(s)
}

theorem monoid_hom_preimage_image_kernel_monotone[M: Monoid, N: Monoid](
    f: MonoidHom[M, N]
) {
    is_subset_monotone_map(monoid_hom_preimage_image_kernel(f))
}

theorem monoid_hom_preimage_image_kernel_idempotent[M: Monoid, N: Monoid](
    f: MonoidHom[M, N],
    s: Set[N]
) {
    monoid_hom_preimage_image_kernel(f, monoid_hom_preimage_image_kernel(f, s)) =
        monoid_hom_preimage_image_kernel(f, s)
}

theorem monoid_hom_preimage_image_kernel_operator[M: Monoid, N: Monoid](
    f: MonoidHom[M, N]
) {
    is_set_kernel_operator(monoid_hom_preimage_image_kernel(f))
}

theorem monoid_pow_suc_left[M: Monoid](a: M, n: Nat) {
    a.pow(n.suc) = a * a.pow(n)
}

theorem monoid_pow_suc_right[M: Monoid](a: M, n: Nat) {
    a.pow(n.suc) = a.pow(n) * a
}

theorem monoid_pow_comm[M: Monoid](a: M, m: Nat, n: Nat) {
    a.pow(m) * a.pow(n) = a.pow(n) * a.pow(m)
}

theorem monoid_pow_comm_self[M: Monoid](a: M, n: Nat) {
    a * a.pow(n) = a.pow(n) * a
}

theorem monoid_pow_pow_comm[M: Monoid](a: M, m: Nat, n: Nat) {
    a.pow(m).pow(n) = a.pow(n).pow(m)
}

theorem group_idempotent_is_identity[G: Group](a: G) {
    is_idempotent_elem(a) implies a = G.1
}

theorem comm_monoid_pow_mul[M: CommMonoid](a: M, b: M, n: Nat) {
    (a * b).pow(n) = a.pow(n) * b.pow(n)
}

theorem monoid_comm_pow_right[M: Monoid](a: M, b: M, n: Nat) {
    a * b = b * a implies a * b.pow(n) = b.pow(n) * a
}

theorem monoid_comm_pow_add_step[M: Monoid](a: M, b: M, k: Nat) {
    a * b = b * a and (a * b).pow(k) = a.pow(k) * b.pow(k)
        implies (a * b).pow(k.suc) = a.pow(k.suc) * b.pow(k.suc)
}

theorem monoid_comm_pow_add[M: Monoid](a: M, b: M, n: Nat) {
    a * b = b * a implies (a * b).pow(n) = a.pow(n) * b.pow(n)
}

define opposite_mul[M: Mul](a: M, b: M) -> M {
    b * a
}

attributes MulOpposite[M: Mul] {
    /// Multiplication in the opposite carrier is original multiplication with reversed factors.
    define mul(self, other: MulOpposite[M]) -> MulOpposite[M] {
        MulOpposite.new(opposite_mul(self.val, other.val))
    }
}

instance MulOpposite[M: Mul]: Mul {
    let mul = MulOpposite[M].mul
}

instance MulOpposite[M: Semigroup]: Semigroup

theorem opposite_mul_eq[M: Mul](a: M, b: M) {
    opposite_mul(a, b) = b * a
}

theorem opposite_mul_rev_eq[M: Mul](a: M, b: M) {
    opposite_mul(b, a) = a * b
}

theorem opposite_mul_assoc[M: Semigroup](a: M, b: M, c: M) {
    opposite_mul(a, opposite_mul(b, c)) = opposite_mul(opposite_mul(a, b), c)
}

theorem opposite_mul_comm[M: CommSemigroup](a: M, b: M) {
    opposite_mul(a, b) = opposite_mul(b, a)
}

theorem opposite_mul_eq_mul[M: CommSemigroup](a: M, b: M) {
    opposite_mul(a, b) = a * b
}

theorem opposite_mul_one_right[M: Monoid](a: M) {
    opposite_mul(a, M.1) = a
}

theorem opposite_mul_one_left[M: Monoid](a: M) {
    opposite_mul(M.1, a) = a
}

theorem opposite_mul_inverse_right[G: Group](a: G) {
    opposite_mul(a, a.inverse) = G.1
}

theorem opposite_mul_inverse_left[G: Group](a: G) {
    opposite_mul(a.inverse, a) = G.1
}

theorem inverse_opposite_mul[G: Group](a: G, b: G) {
    opposite_mul(a, b).inverse = opposite_mul(b.inverse, a.inverse)
}

theorem inverse_mul_eq_opposite_inverse_mul[G: Group](a: G, b: G) {
    (a * b).inverse = opposite_mul(a.inverse, b.inverse)
}

theorem opposite_mul_zero_right[R: Semiring](a: R) {
    opposite_mul(a, R.0) = R.0
}

theorem opposite_mul_zero_left[R: Semiring](a: R) {
    opposite_mul(R.0, a) = R.0
}

theorem opposite_mul_add_distrib_left[R: Semiring](a: R, b: R, c: R) {
    opposite_mul(a, b + c) = opposite_mul(a, b) + opposite_mul(a, c)
}

theorem opposite_mul_add_distrib_right[R: Semiring](a: R, b: R, c: R) {
    opposite_mul(a + b, c) = opposite_mul(a, c) + opposite_mul(b, c)
}

theorem preserves_opposite_mul[A: Mul, B: Mul](f: A -> B) {
    (forall(a: A, b: A) { f(a * b) = f(a) * f(b) }) implies
    forall(a: A, b: A) {
        f(opposite_mul(a, b)) = opposite_mul(f(a), f(b))
    }
}

theorem opposite_mul_add_left_via_map[A: Semiring, B: Semiring](f: A -> B, a: A, b: A, c: A) {
    (forall(x: A, y: A) { f(x + y) = f(x) + f(y) }) and
    (forall(x: A, y: A) { f(x * y) = f(x) * f(y) }) implies
    f(opposite_mul(a, b + c)) = opposite_mul(f(a), f(b)) + opposite_mul(f(a), f(c))
}

define to_mul_opposite[M](x: M) -> MulOpposite[M] {
    MulOpposite.new(x)
}

define of_mul_opposite[M](x: MulOpposite[M]) -> M {
    x.val
}

theorem mul_opposite_ext[M](x: MulOpposite[M], y: MulOpposite[M]) {
    x.val = y.val implies x = y
}

theorem of_to_mul_opposite[M](x: M) {
    of_mul_opposite(to_mul_opposite(x)) = x
}

theorem to_of_mul_opposite[M](x: MulOpposite[M]) {
    to_mul_opposite(of_mul_opposite(x)) = x
}

theorem to_mul_opposite_val[M](x: M) {
    to_mul_opposite(x).val = x
}

theorem mul_opposite_val_mul[M: Mul](x: MulOpposite[M], y: MulOpposite[M]) {
    (x * y).val = y.val * x.val
}

theorem mul_opposite_to_mul[M: Mul](x: M, y: M) {
    (to_mul_opposite(x) * to_mul_opposite(y)).val = y * x
}

theorem to_mul_opposite_opposite_mul[M: Mul](x: M, y: M) {
    to_mul_opposite(opposite_mul(x, y)) = to_mul_opposite(x) * to_mul_opposite(y)
}

let mul_opposite_one[M: One]: MulOpposite[M] = MulOpposite.new(M.1)

instance MulOpposite[M: One]: One {
    let 1: MulOpposite[M] = mul_opposite_one[M]
}

instance MulOpposite[M: Monoid]: Monoid

instance MulOpposite[G: Group]: Group {
    let inverse = MulOpposite[G].inverse
}

attributes MulOpposite[M: One] {
    /// The identity element of the opposite carrier is the original identity.
    let one: MulOpposite[M] = mul_opposite_one[M]
}

theorem mul_opposite_val_one[M: One] {
    MulOpposite[M].one.val = M.1
}

theorem mul_opposite_mul_assoc[M: Semigroup](x: MulOpposite[M], y: MulOpposite[M], z: MulOpposite[M]) {
    x * (y * z) = (x * y) * z
}

theorem mul_opposite_mul_is_associative[M: Semigroup] {
    forall(x: MulOpposite[M], y: MulOpposite[M], z: MulOpposite[M]) {
        x * (y * z) = (x * y) * z
    }
}

theorem mul_opposite_one_right[M: Monoid](x: MulOpposite[M]) {
    x * MulOpposite[M].one = x
}

theorem mul_opposite_one_left[M: Monoid](x: MulOpposite[M]) {
    MulOpposite[M].one * x = x
}

theorem mul_opposite_val_inverse[G: Group](x: MulOpposite[G]) {
    x.inverse.val = x.val.inverse
}
