theorem function_triple_neg_apply[T, A: Neg, B: Neg, C: Neg](
    p: Pair[T -> A, Pair[T -> B, T -> C]],
    t: T
) {
    function_triple_apply(function_triple_neg(p), t) =
    Pair.new(-p.first(t), Pair.new(-p.second.first(t), -p.second.second(t)))
