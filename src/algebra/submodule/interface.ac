theorem gf4_x_squared_plus_x_plus_one_eq_zero {
    gf4_add(gf4_add(gf4_mul(GF4.x, GF4.x), GF4.x), GF4.one) = GF4.zero
}

theorem gf4_x_inverse {
    gf4_mul(GF4.x, GF4.x_plus_one) = GF4.one
}

theorem gf4_x_plus_one_inverse {
    gf4_mul(GF4.x_plus_one, GF4.x) = GF4.one
}

theorem gf4_zero_ne_one_elt {
    GF4.zero != GF4.one
}

theorem gf4_one_ne_x {
    GF4.one != GF4.x
}

theorem gf4_one_ne_x_plus_one {
    GF4.one != GF4.x_plus_one
}

theorem inverse_left_group[G: Group](a: G) {
    a.inverse * a = G.1
}

theorem inverse_inverse_group[G: Group](a: G) {
    a.inverse.inverse = a
}

theorem left_cancel_group[G: Group](a: G, b: G, c: G) {
    a * b = a * c implies b = c
}

theorem right_cancel_group[G: Group](a: G, b: G, c: G) {
    b * a = c * a implies b = c
}

theorem inverse_mul[G: Group](a: G, b: G) {
    (a * b).inverse = b.inverse * a.inverse
}

theorem pow_inverse_group[G: Group](a: G, n: Nat) {
    a.pow(n).inverse = a.inverse.pow(n)
}

theorem pow_cancel[G: Group](a: G, m: Nat, n: Nat) {
    n > m and a.pow(n) = a.pow(m) implies a.pow(n - m) = G.1
}

define has_finite_order[G: Group](g: G) -> Bool {
    exists(n: Nat) {
        n != Nat.0 and g.pow(n) = G.1
    }
}

let is_torsion_free[G: Group] = forall(g: G) {
    has_finite_order(g) implies g = G.1
}

define is_group_hom[G: Group, H: Group](f: G -> H) -> Bool {
    forall(a: G, b: G) {
        f(a * b) = f(a) * f(b)
    }
}

structure GroupHom[G: Group, H: Group] {
    /// The mapping for the homomorphism.
    hom: G -> H
} constraint {
    is_group_hom(hom)
}

let trivial_group_hom[G: Group, H: Group]: G -> H = function(a: G) {
    H.1
}

theorem trivial_group_hom_is_hom[G: Group, H: Group] {
    is_group_hom(trivial_group_hom[G, H])
}

theorem group_hom_ext[G: Group, H: Group](f: GroupHom[G, H], g: GroupHom[G, H]) {
    (forall(a: G) { f.hom(a) = g.hom(a) }) implies f = g
}

attributes GroupHom[G: Group, H: Group] {
    /// Group homomorphism extensionality from pointwise equality of the homomorphism.
    let ext = group_hom_ext[G, H]
}

theorem group_hom_eq_hom[G: Group, H: Group](f: GroupHom[G, H], g: GroupHom[G, H]) {
    f = g implies f.hom = g.hom
}

theorem group_hom_eq_apply[G: Group, H: Group](f: GroupHom[G, H], g: GroupHom[G, H], a: G) {
    f = g implies f.hom(a) = g.hom(a)
}

theorem group_hom_eq_transport_predicate[G: Group, H: Group](
    p: GroupHom[G, H] -> Bool,
    f: GroupHom[G, H],
    g: GroupHom[G, H]
) {
    f = g and p(f) implies p(g)
}

theorem group_hom_eq_transport_predicate_rev[G: Group, H: Group](
    p: GroupHom[G, H] -> Bool,
    f: GroupHom[G, H],
    g: GroupHom[G, H]
) {
    f = g and p(g) implies p(f)
}

theorem group_hom_eq_of_hom_eq[G: Group, H: Group](f: GroupHom[G, H], g: GroupHom[G, H]) {
    f.hom = g.hom implies f = g
}

theorem group_hom_eq_of_apply_eq[G: Group, H: Group](f: GroupHom[G, H], g: GroupHom[G, H]) {
    (forall(a: G) { f.hom(a) = g.hom(a) }) implies f = g
}

theorem group_hom_mul[G: Group, H: Group](f: GroupHom[G, H], a: G, b: G) {
    f.hom(a * b) = f.hom(a) * f.hom(b)
}

theorem group_hom_one[G: Group, H: Group](f: GroupHom[G, H]) {
    f.hom(G.1) = H.1
}

theorem group_hom_inv[G: Group, H: Group](f: GroupHom[G, H], a: G) {
    f.hom(a.inverse) = f.hom(a).inverse
}

theorem group_hom_pow[G: Group, H: Group](f: GroupHom[G, H], a: G, n: Nat) {
    f.hom(a.pow(n)) = f.hom(a).pow(n)
}

theorem monoid_hom_imp_group_hom[G: Group, H: Group](f: G -> H) {
    is_monoid_hom(f) implies is_group_hom(f)
}

theorem group_hom_imp_monoid_hom[G: Group, H: Group](f: G -> H) {
    is_group_hom(f) implies is_monoid_hom(f)
}

theorem group_hom_is_monoid_hom[G: Group, H: Group](f: GroupHom[G, H]) {
    is_monoid_hom(f.hom)
}

theorem monoid_hom_is_group_hom[G: Group, H: Group](f: MonoidHom[G, H]) {
    is_group_hom(f.hom)
}

let group_hom_to_monoid_hom[G: Group, H: Group](f: GroupHom[G, H]) -> result: MonoidHom[G, H] satisfy {
    MonoidHom.new(f.hom) = Option.some(result)
}

theorem group_hom_to_monoid_hom_hom[G: Group, H: Group](f: GroupHom[G, H]) {
    group_hom_to_monoid_hom(f).hom = f.hom
}

let group_hom_of_monoid_hom[G: Group, H: Group](f: MonoidHom[G, H]) -> result: GroupHom[G, H] satisfy {
    GroupHom.new(f.hom) = Option.some(result)
}

theorem group_hom_of_monoid_hom_hom[G: Group, H: Group](f: MonoidHom[G, H]) {
    group_hom_of_monoid_hom(f).hom = f.hom
}

theorem function_eq_transport_group_hom[G: Group, H: Group](f: G -> H, g: G -> H) {
    f = g and is_group_hom(f) implies is_group_hom(g)
}

theorem function_eq_transport_group_hom_rev[G: Group, H: Group](f: G -> H, g: G -> H) {
    f = g and is_group_hom(g) implies is_group_hom(f)
}

theorem identity_fn_is_group_hom[G: Group] {
    is_group_hom(identity_fn[G])
}

theorem compose_is_group_hom[G: Group, H: Group, K: Group](f: H -> K, g: G -> H) {
    is_group_hom(f) and is_group_hom(g) implies is_group_hom(compose(f, g))
}

let identity_group_hom[G: Group]: GroupHom[G, G] satisfy {
    GroupHom.new(identity_fn[G]) = Option.some(identity_group_hom)
}

theorem identity_group_hom_hom[G: Group] {
    identity_group_hom[G].hom = identity_fn[G]
}

let compose_group_hom[G: Group, H: Group, K: Group](f: GroupHom[H, K], g: GroupHom[G, H]) -> result: GroupHom[G, K] satisfy {
    GroupHom.new(compose(f.hom, g.hom)) = Option.some(result)
}

theorem compose_group_hom_hom[G: Group, H: Group, K: Group](f: GroupHom[H, K], g: GroupHom[G, H]) {
    compose_group_hom(f, g).hom = compose(f.hom, g.hom)
}

theorem compose_group_hom_assoc[A: Group, B: Group, C: Group, D: Group](
    f: GroupHom[C, D], g: GroupHom[B, C], h: GroupHom[A, B]) {
    compose_group_hom(compose_group_hom(f, g), h) = compose_group_hom(f, compose_group_hom(g, h))
}

theorem compose_group_hom_identity_left[G: Group, H: Group](f: GroupHom[G, H]) {
    compose_group_hom(identity_group_hom[H], f) = f
}

theorem compose_group_hom_identity_right[G: Group, H: Group](f: GroupHom[G, H]) {
    compose_group_hom(f, identity_group_hom[G]) = f
}

define pointwise_one[T, A: One](t: T) -> A {
    A.1
}

define pointwise_neg[T, A: Neg](f: T -> A, t: T) -> A {
    -f(t)
}

define pointwise_inverse[T, A: Group](f: T -> A, t: T) -> A {
    f(t).inverse
}

theorem pointwise_one_apply[T, A: One](t: T) {
    pointwise_one[T, A](t) = A.1
}

theorem pointwise_neg_apply[T, A: Neg](f: T -> A, t: T) {
    pointwise_neg(f, t) = -f(t)
}

theorem pointwise_inverse_apply[T, A: Group](f: T -> A, t: T) {
    pointwise_inverse(f, t) = f(t).inverse
}

theorem pointwise_add_neg_right[T, A: AddGroup](f: T -> A) {
    pointwise_add(f, pointwise_neg(f)) = pointwise_zero[T, A]
}

theorem pointwise_add_neg_left[T, A: AddGroup](f: T -> A) {
    pointwise_add(pointwise_neg(f), f) = pointwise_zero[T, A]
}

theorem pointwise_mul_one_right[T, A: Monoid](f: T -> A) {
    pointwise_mul(f, pointwise_one[T, A]) = f
}

theorem pointwise_mul_one_left[T, A: Monoid](f: T -> A) {
    pointwise_mul(pointwise_one[T, A], f) = f
}

theorem pointwise_mul_inverse_right[T, A: Group](f: T -> A) {
    pointwise_mul(f, pointwise_inverse(f)) = pointwise_one[T, A]
}

theorem pointwise_mul_inverse_left[T, A: Group](f: T -> A) {
    pointwise_mul(pointwise_inverse(f), f) = pointwise_one[T, A]
}

theorem pointwise_mul_distrib_left[T, A: Semiring](f: T -> A, g: T -> A, h: T -> A) {
    pointwise_mul(f, pointwise_add(g, h)) =
    pointwise_add(pointwise_mul(f, g), pointwise_mul(f, h))
}

theorem pointwise_mul_distrib_right[T, A: Semiring](f: T -> A, g: T -> A, h: T -> A) {
    pointwise_mul(pointwise_add(f, g), h) =
    pointwise_add(pointwise_mul(f, h), pointwise_mul(g, h))
}

theorem pointwise_mul_zero_right[T, A: Semiring](f: T -> A) {
    pointwise_mul(f, pointwise_zero[T, A]) = pointwise_zero[T, A]
}

theorem pointwise_mul_zero_left[T, A: Semiring](f: T -> A) {
    pointwise_mul(pointwise_zero[T, A], f) = pointwise_zero[T, A]
}

define function_even[A: Neg, B](f: A -> B) -> Bool {
    forall(x: A) {
        f(-x) = f(x)
    }
}

define function_odd[A: Neg, B: Neg](f: A -> B) -> Bool {
    forall(x: A) {
        f(-x) = -f(x)
    }
}

theorem function_even_def[A: Neg, B](f: A -> B) {
    function_even(f) = forall(x: A) {
        f(-x) = f(x)
    }
}

theorem function_even_eq[A: Neg, B](f: A -> B, x: A) {
    function_even(f) implies f(-x) = f(x)
}

theorem function_odd_def[A: Neg, B: Neg](f: A -> B) {
    function_odd(f) = forall(x: A) {
        f(-x) = -f(x)
    }
}

theorem function_odd_eq[A: Neg, B: Neg](f: A -> B, x: A) {
    function_odd(f) implies f(-x) = -f(x)
}

theorem function_even_const[A: Neg, B](b: B) {
    function_even(constant[A, B](b))
}

theorem function_even_zero[A: Neg, B: Zero] {
    function_even(pointwise_zero[A, B])
}

theorem function_odd_zero[A: Neg, B: AddGroup] {
    function_odd(pointwise_zero[A, B])
}

theorem function_even_left_comp[A: Neg, B, C](g: A -> B, f: B -> C) {
    function_even(g) implies function_even(compose(f, g))
}

theorem function_even_comp_odd[A: Neg, B: Neg, C](f: B -> C, g: A -> B) {
    function_even(f) and function_odd(g) implies function_even(compose(f, g))
}

theorem function_odd_comp_odd[A: Neg, B: Neg, C: Neg](f: B -> C, g: A -> B) {
    function_odd(f) and function_odd(g) implies function_odd(compose(f, g))
}

theorem function_even_add[A: Neg, B: Add](f: A -> B, g: A -> B) {
    function_even(f) and function_even(g) implies function_even(pointwise_add(f, g))
}

theorem function_odd_add[A: Neg, B: AddCommGroup](f: A -> B, g: A -> B) {
    function_odd(f) and function_odd(g) implies function_odd(pointwise_add(f, g))
}

theorem function_even_mul_even[A: Neg, B: Mul](f: A -> B, g: A -> B) {
    function_even(f) and function_even(g) implies function_even(pointwise_mul(f, g))
}

define indicator[T, A: Zero](s: Set[T], f: T -> A, x: T) -> A {
    if s.contains(x) { f(x) } else { A.0 }
}

define indicator_fn[T, A: Zero](s: Set[T], f: T -> A) -> T -> A {
    function(x: T) {
        indicator(s, f, x)
    }
}

theorem indicator_fn_apply[T, A: Zero](s: Set[T], f: T -> A, x: T) {
    indicator_fn(s, f)(x) = indicator(s, f, x)
}

theorem indicator_apply[T, A: Zero](s: Set[T], f: T -> A, x: T) {
    indicator(s, f, x) = if s.contains(x) { f(x) } else { A.0 }
}

theorem indicator_of_mem[T, A: Zero](s: Set[T], f: T -> A, x: T) {
    s.contains(x) implies indicator(s, f, x) = f(x)
}

theorem indicator_of_not_mem[T, A: Zero](s: Set[T], f: T -> A, x: T) {
    not s.contains(x) implies indicator(s, f, x) = A.0
}

theorem indicator_univ[T, A: Zero](f: T -> A) {
    indicator_fn(Set[T].universal_set, f) = f
}

theorem indicator_empty[T, A: Zero](f: T -> A) {
    indicator_fn(Set[T].empty_set, f) = constant[T, A](A.0)
}

theorem indicator_pointwise_zero_apply[T, A: Zero](s: Set[T], x: T) {
    indicator(s, pointwise_zero[T, A], x) = A.0
}

theorem indicator_pointwise_zero[T, A: Zero](s: Set[T]) {
    indicator_fn(s, pointwise_zero[T, A]) = pointwise_zero[T, A]
}

theorem indicator_empty_pointwise_zero[T, A: Zero](f: T -> A) {
    indicator_fn(Set[T].empty_set, f) = pointwise_zero[T, A]
}

define function_mul_support_contains[T, A: One](f: T -> A, t: T) -> Bool {
    f(t) != A.1
}

define function_mul_support[T, A: One](f: T -> A) -> Set[T] {
    Set[T].new(function_mul_support_contains(f))
}

theorem function_support_contains_eq[T, A: Zero](f: T -> A, t: T) {
    function_support(f).contains(t) = (f(t) != A.0)
}

theorem function_support_not_contains_eq[T, A: Zero](f: T -> A, t: T) {
    not function_support(f).contains(t) = (f(t) = A.0)
}

theorem function_mul_support_contains_eq[T, A: One](f: T -> A, t: T) {
    function_mul_support(f).contains(t) = (f(t) != A.1)
}

theorem function_mul_support_not_contains_eq[T, A: One](f: T -> A, t: T) {
    not function_mul_support(f).contains(t) = (f(t) = A.1)
}

theorem function_support_subset_of_eq_zero_outside[T, A: Zero](f: T -> A, s: Set[T]) {
    (forall(t: T) { not s.contains(t) implies f(t) = A.0 }) implies
    function_support(f).subset(s)
}

theorem function_mul_support_subset_of_eq_one_outside[T, A: One](f: T -> A, s: Set[T]) {
    (forall(t: T) { not s.contains(t) implies f(t) = A.1 }) implies
    function_mul_support(f).subset(s)
}

theorem function_mul_support_mul_subset[T, A: Monoid](f: T -> A, g: T -> A) {
    function_mul_support(pointwise_mul(f, g)).subset(function_mul_support(f).union(function_mul_support(g)))
}

theorem prepend_all_contains_witness[T](x: T, u: List[T], ll: List[List[T]]) {
    prepend_all(x, ll).contains(u) implies exists(t1: List[T]) { ll.contains(t1) and List.cons(x, t1) = u }
}

theorem prepend_all_pairwise_disjoint[T](items: List[T], k: Nat) {
    forall(x: T, y: T, u: List[T]) {
        x != y implies
            not (prepend_all(x, all_lists(items, k)).contains(u) and
                prepend_all(y, all_lists(items, k)).contains(u))
    }
}

theorem flatten_list_contains_witness[T](xss: List[List[T]], u: T) {
    flatten_list(xss).contains(u) implies exists(xs: List[T]) {
        xss.contains(xs) and xs.contains(u)
    }
}

theorem unique_cons_not_contains_local[T](head: T, tail: List[T]) {
    List.cons(head, tail).is_unique implies not tail.contains(head)
}

theorem add_unique_of_disjoint_unique[T](a: List[T], b: List[T]) {
    a.is_unique and b.is_unique and (forall(u: T) { a.contains(u) implies not b.contains(u) })
    implies (a + b).is_unique
}

define commutator_element[G: Group](g: G, h: G) -> G {
    g * h * g.inverse * h.inverse
}

theorem commutator_element_def[G: Group](g: G, h: G) {
    commutator_element(g, h) = g * h * g.inverse * h.inverse
}

theorem mul_left_injective[G: Group](g: G) {
    is_injective_fn(function(h: G) { g * h })
}

theorem mul_right_injective[G: Group](g: G) {
    is_injective_fn(function(h: G) { h * g })
}

let mulLeftEmbedding[G: Group](g: G) -> result: Embedding[G, G] satisfy {
    Embedding[G, G].new(function(h: G) { g * h }) = Option.some(result)
}

let mulRightEmbedding[G: Group](g: G) -> result: Embedding[G, G] satisfy {
    Embedding[G, G].new(function(h: G) { h * g }) = Option.some(result)
}

theorem group_hom_eq_of_mul_inverse_maps_one[G: Group, H: Group](
    f: GroupHom[G, H], a: G, b: G
) {
    f.hom(a * b.inverse) = H.1 implies f.hom(a) = f.hom(b)
}

theorem group_hom_pow_eq_one_of_pow_eq_one[G: Group, H: Group](f: GroupHom[G, H], a: G, n: Nat) {
    a.pow(n) = G.1 implies f.hom(a).pow(n) = H.1
}

theorem injective_group_hom_pow_eq_one_iff[G: Group, H: Group](f: GroupHom[G, H], a: G, n: Nat) {
    is_injective_fn(f.hom) implies
    (f.hom(a).pow(n) = H.1) = (a.pow(n) = G.1)
}

theorem injective_group_hom_preserves_finite_order[G: Group, H: Group](f: GroupHom[G, H], a: G) {
    is_injective_fn(f.hom) implies (has_finite_order(a) = has_finite_order(f.hom(a)))
}

theorem group_iso_preserves_finite_order[G: Group, H: Group](f: GroupHom[G, H], a: G) {
    is_bijection_fn(f.hom) implies (has_finite_order(a) = has_finite_order(f.hom(a)))
}

define group_hom_image[G: Group, H: Group](f: GroupHom[G, H], s: Set[G]) -> Set[H] {
    set_image(s, f.hom)
}

define group_hom_preimage[G: Group, H: Group](f: GroupHom[G, H], s: Set[H]) -> Set[G] {
    set_preimage(f.hom, s)
}

define group_hom_image_preimage_closure[G: Group, H: Group](
    f: GroupHom[G, H],
    s: Set[G]
) -> Set[G] {
    set_image_preimage_closure(f.hom, s)
}

define group_hom_preimage_image_kernel[G: Group, H: Group](
    f: GroupHom[G, H],
    s: Set[H]
) -> Set[H] {
    set_preimage_image_kernel(f.hom, s)
}

theorem group_hom_image_contains_witness[G: Group, H: Group](
    f: GroupHom[G, H],
    s: Set[G],
    y: H
) {
    group_hom_image(f, s).contains(y) implies exists(x: G) {
        s.contains(x) and y = f.hom(x)
    }
}

theorem group_hom_maps_into_image[G: Group, H: Group](
    f: GroupHom[G, H],
    s: Set[G],
    x: G
) {
    s.contains(x) implies group_hom_image(f, s).contains(f.hom(x))
}

theorem group_hom_image_subset_iff_subset_preimage[G: Group, H: Group](
    f: GroupHom[G, H],
    s: Set[G],
    t: Set[H]
) {
    group_hom_image(f, s).subset(t) = s.subset(group_hom_preimage(f, t))
}

theorem group_hom_image_compose[G: Group, H: Group, K: Group](
    f: GroupHom[H, K],
    g: GroupHom[G, H],
    s: Set[G]
) {
    group_hom_image(compose_group_hom(f, g), s) =
        group_hom_image(f, group_hom_image(g, s))
}

theorem group_hom_preimage_compose[G: Group, H: Group, K: Group](
    f: GroupHom[H, K],
    g: GroupHom[G, H],
    s: Set[K]
) {
    group_hom_preimage(compose_group_hom(f, g), s) =
        group_hom_preimage(g, group_hom_preimage(f, s))
}

theorem group_hom_image_preimage_closure_extensive[G: Group, H: Group](
    f: GroupHom[G, H],
    s: Set[G]
) {
    s.subset(group_hom_image_preimage_closure(f, s))
}

theorem group_hom_image_preimage_closure_monotone[G: Group, H: Group](
    f: GroupHom[G, H]
) {
    is_subset_monotone_map(group_hom_image_preimage_closure(f))
}

theorem group_hom_image_preimage_closure_idempotent[G: Group, H: Group](
    f: GroupHom[G, H],
    s: Set[G]
) {
    group_hom_image_preimage_closure(f, group_hom_image_preimage_closure(f, s)) =
        group_hom_image_preimage_closure(f, s)
}

theorem group_hom_image_preimage_closure_operator[G: Group, H: Group](
    f: GroupHom[G, H]
) {
    is_set_closure_operator(group_hom_image_preimage_closure(f))
}

theorem group_hom_preimage_image_kernel_reductive[G: Group, H: Group](
    f: GroupHom[G, H],
    s: Set[H]
) {
    group_hom_preimage_image_kernel(f, s).subset(s)
}

theorem group_hom_preimage_image_kernel_monotone[G: Group, H: Group](
    f: GroupHom[G, H]
) {
    is_subset_monotone_map(group_hom_preimage_image_kernel(f))
}

theorem group_hom_preimage_image_kernel_idempotent[G: Group, H: Group](
    f: GroupHom[G, H],
    s: Set[H]
) {
    group_hom_preimage_image_kernel(f, group_hom_preimage_image_kernel(f, s)) =
        group_hom_preimage_image_kernel(f, s)
}

theorem group_hom_preimage_image_kernel_operator[G: Group, H: Group](
    f: GroupHom[G, H]
) {
    is_set_kernel_operator(group_hom_preimage_image_kernel(f))
}

theorem semiconj_by_one_right[M: Monoid](a: M) {
    semiconj_by(a, M.1, M.1)
}

theorem semiconj_by_one_left[M: Monoid](x: M) {
    semiconj_by(M.1, x, x)
}

theorem semiconj_by_conj_mk[G: Group](a: G, x: G) {
    semiconj_by(a, x, a * x * a.inverse)
}

theorem semiconj_by_map[M: Monoid, N: Monoid](f: MonoidHom[M, N], a: M, x: M, y: M) {
    semiconj_by(a, x, y) implies semiconj_by(f.hom(a), f.hom(x), f.hom(y))
}

theorem commute_map[M: Monoid, N: Monoid](f: MonoidHom[M, N], x: M, y: M) {
    commute(x, y) implies commute(f.hom(x), f.hom(y))
}

theorem semiconj_by_of_map[M: Monoid, N: Monoid](f: MonoidHom[M, N], a: M, x: M, y: M) {
    is_injective_fn(f.hom) and semiconj_by(f.hom(a), f.hom(x), f.hom(y))
    implies semiconj_by(a, x, y)
}

theorem commute_of_map[M: Monoid, N: Monoid](f: MonoidHom[M, N], x: M, y: M) {
    is_injective_fn(f.hom) and commute(f.hom(x), f.hom(y)) implies commute(x, y)
}

theorem semiconj_by_map_iff[M: Monoid, N: Monoid](f: MonoidHom[M, N], a: M, x: M, y: M) {
    is_injective_fn(f.hom) implies
    semiconj_by(f.hom(a), f.hom(x), f.hom(y)) = semiconj_by(a, x, y)
}

theorem commute_map_iff[M: Monoid, N: Monoid](f: MonoidHom[M, N], x: M, y: M) {
    is_injective_fn(f.hom) implies commute(f.hom(x), f.hom(y)) = commute(x, y)
}

theorem is_square_one[M: Monoid] {
    is_square[M](M.1)
}

theorem is_square_pow_two[M: Monoid](a: M) {
    is_square[M](a.pow(Nat.2))
}

theorem is_square_pow[M: CommMonoid](a: M, n: Nat) {
    is_square[M](a) implies is_square[M](a.pow(n))
}

theorem is_square_map[M: Monoid, N: Monoid](f: MonoidHom[M, N], a: M) {
    is_square[M](a) implies is_square[N](f.hom(a))
}

define module_smul_add_left_constraint[R: Ring, M: AddCommGroup](smul: R -> M -> M) -> Bool {
    forall(r: R, s: R, x: M) {
        smul(r + s, x) = smul(r, x) + smul(s, x)
    }
}

define module_smul_add_right_constraint[R: Ring, M: AddCommGroup](smul: R -> M -> M) -> Bool {
    forall(r: R, x: M, y: M) {
        smul(r, x + y) = smul(r, x) + smul(r, y)
    }
}

define module_smul_assoc_constraint[R: Ring, M: AddCommGroup](smul: R -> M -> M) -> Bool {
    forall(r: R, s: R, x: M) {
        smul(r * s, x) = smul(r, smul(s, x))
    }
}

define module_smul_one_constraint[R: Ring, M: AddCommGroup](smul: R -> M -> M) -> Bool {
    forall(x: M) {
        smul(R.1, x) = x
    }
}

theorem module_ext[R: Ring, M: AddCommGroup](a: Module[R, M], b: Module[R, M]) {
    (forall(r: R, x: M) { a.smul(r, x) = b.smul(r, x) }) implies a = b
}

theorem module_smul_add_left[R: Ring, M: AddCommGroup](m: Module[R, M], r: R, s: R, x: M) {
    m.smul(r + s, x) = m.smul(r, x) + m.smul(s, x)
}

theorem module_smul_add_right[R: Ring, M: AddCommGroup](m: Module[R, M], r: R, x: M, y: M) {
    m.smul(r, x + y) = m.smul(r, x) + m.smul(r, y)
}

theorem module_smul_assoc[R: Ring, M: AddCommGroup](m: Module[R, M], r: R, s: R, x: M) {
    m.smul(r * s, x) = m.smul(r, m.smul(s, x))
}

theorem module_smul_one[R: Ring, M: AddCommGroup](m: Module[R, M], x: M) {
    m.smul(R.1, x) = x
}

theorem module_smul_zero_left[R: Ring, M: AddCommGroup](m: Module[R, M], x: M) {
    m.smul(R.0, x) = M.0
}

theorem module_smul_zero_right[R: Ring, M: AddCommGroup](m: Module[R, M], r: R) {
    m.smul(r, M.0) = M.0
}

theorem module_smul_neg_left[R: Ring, M: AddCommGroup](m: Module[R, M], r: R, x: M) {
    m.smul(-r, x) = -m.smul(r, x)
}

theorem module_smul_neg_right[R: Ring, M: AddCommGroup](m: Module[R, M], r: R, x: M) {
    m.smul(r, -x) = -m.smul(r, x)
}

let ring_mul_smul[R: Ring]: R -> R -> R = function(r: R, s: R) {
    r * s
}

theorem ring_mul_is_module_action[R: Ring] {
    is_module_action(ring_mul_smul[R])
}

let ring_as_module[R: Ring]: Module[R, R] satisfy {
    Module.new(ring_mul_smul[R]) = Option.some(ring_as_module)
}

theorem ring_as_module_smul[R: Ring](r: R, s: R) {
    ring_as_module[R].smul(r, s) = r * s
}

define preserves_smul[R: Ring, M: AddCommGroup, N: AddCommGroup](
    src: Module[R, M], dst: Module[R, N], f: M -> N) -> Bool {
    forall(r: R, x: M) {
        f(src.smul(r, x)) = dst.smul(r, f(x))
    }
}

define is_linear_map[R: Ring, M: AddCommGroup, N: AddCommGroup](
    src: Module[R, M], dst: Module[R, N], f: M -> N) -> Bool {
    preserves_add(f) and preserves_smul(src, dst, f)
}

structure ModuleHom[R: Ring, M: AddCommGroup, N: AddCommGroup] {
    /// The source R-module.
    src: Module[R, M]
    /// The destination R-module.
    dst: Module[R, N]
    /// The underlying function.
    hom: M -> N
} constraint {
    is_linear_map(src, dst, hom)
}

structure LinearEquiv[R: Ring, M: AddCommGroup, N: AddCommGroup] {
    /// The source R-module.
    src: Module[R, M]
    /// The destination R-module.
    dst: Module[R, N]
    /// The underlying forward function.
    to_fn: M -> N
    /// The underlying inverse function.
    inv_fn: N -> M
} constraint {
    is_linear_map(src, dst, to_fn) and is_two_sided_inverse_fn(to_fn, inv_fn)
}

theorem trivial_linear_map_preserves_smul[R: Ring, M: AddCommGroup, N: AddCommGroup](
    src: Module[R, M], dst: Module[R, N]) {
    preserves_smul(src, dst, trivial_linear_map[M, N])
}

theorem trivial_linear_map_is_linear_map[R: Ring, M: AddCommGroup, N: AddCommGroup](
    src: Module[R, M], dst: Module[R, N]) {
    is_linear_map(src, dst, trivial_linear_map[M, N])
}

theorem identity_fn_is_linear_map[R: Ring, M: AddCommGroup](src: Module[R, M]) {
    is_linear_map(src, src, identity_fn[M])
}

theorem compose_preserves_smul[R: Ring, M: AddCommGroup, N: AddCommGroup, K: AddCommGroup](
    a: Module[R, M], b: Module[R, N], c: Module[R, K], f: N -> K, g: M -> N) {
    preserves_smul(a, b, g) and preserves_smul(b, c, f)
        implies preserves_smul(a, c, compose(f, g))
}

theorem linear_map_zero[R: Ring, M: AddCommGroup, N: AddCommGroup](
    src: Module[R, M], dst: Module[R, N], f: M -> N) {
    is_linear_map(src, dst, f) implies f(M.0) = N.0
}

theorem linear_map_smul[R: Ring, M: AddCommGroup, N: AddCommGroup](
    src: Module[R, M], dst: Module[R, N], f: M -> N, r: R, x: M) {
    is_linear_map(src, dst, f) implies f(src.smul(r, x)) = dst.smul(r, f(x))
}

theorem linear_map_add[R: Ring, M: AddCommGroup, N: AddCommGroup](
    src: Module[R, M], dst: Module[R, N], f: M -> N, x: M, y: M) {
    is_linear_map(src, dst, f) implies f(x + y) = f(x) + f(y)
}

theorem linear_map_neg[R: Ring, M: AddCommGroup, N: AddCommGroup](
    src: Module[R, M], dst: Module[R, N], f: M -> N, x: M) {
    is_linear_map(src, dst, f) implies f(-x) = -f(x)
}

theorem linear_map_sub[R: Ring, M: AddCommGroup, N: AddCommGroup](
    src: Module[R, M], dst: Module[R, N], f: M -> N, x: M, y: M) {
    is_linear_map(src, dst, f) implies f(x - y) = f(x) - f(y)
}

theorem compose_is_linear_map[R: Ring, M: AddCommGroup, N: AddCommGroup, K: AddCommGroup](
    a: Module[R, M], b: Module[R, N], c: Module[R, K], f: N -> K, g: M -> N
) {
    is_linear_map(b, c, f) and is_linear_map(a, b, g)
    implies is_linear_map(a, c, compose(f, g))
}

define neg_fn[M: AddCommGroup, N: AddCommGroup](f: M -> N, x: M) -> N {
    -f(x)
}

theorem add_fn_preserves_smul[R: Ring, M: AddCommGroup, N: AddCommGroup](
    src: Module[R, M], dst: Module[R, N], f: M -> N, g: M -> N) {
    preserves_smul(src, dst, f) and preserves_smul(src, dst, g)
        implies preserves_smul(src, dst, add_fn(f, g))
}

theorem add_fn_is_linear_map[R: Ring, M: AddCommGroup, N: AddCommGroup](
    src: Module[R, M], dst: Module[R, N], f: M -> N, g: M -> N) {
    is_linear_map(src, dst, f) and is_linear_map(src, dst, g)
        implies is_linear_map(src, dst, add_fn(f, g))
}

theorem neg_fn_preserves_add[M: AddCommGroup, N: AddCommGroup](f: M -> N) {
    preserves_add(f) implies preserves_add(neg_fn(f))
}

theorem neg_fn_preserves_smul[R: Ring, M: AddCommGroup, N: AddCommGroup](
    src: Module[R, M], dst: Module[R, N], f: M -> N) {
    preserves_smul(src, dst, f) implies preserves_smul(src, dst, neg_fn(f))
}

theorem neg_fn_is_linear_map[R: Ring, M: AddCommGroup, N: AddCommGroup](
    src: Module[R, M], dst: Module[R, N], f: M -> N) {
    is_linear_map(src, dst, f) implies is_linear_map(src, dst, neg_fn(f))
}

define sub_fn[M: AddCommGroup, N: AddCommGroup](f: M -> N, g: M -> N, x: M) -> N {
    f(x) - g(x)
}

theorem sub_fn_eq_add_neg[M: AddCommGroup, N: AddCommGroup](f: M -> N, g: M -> N, x: M) {
    sub_fn(f, g, x) = add_fn(f, neg_fn(g), x)
}

theorem sub_fn_preserves_add[M: AddCommGroup, N: AddCommGroup](f: M -> N, g: M -> N) {
    preserves_add(f) and preserves_add(g) implies preserves_add(sub_fn(f, g))
}

theorem sub_fn_preserves_smul[R: Ring, M: AddCommGroup, N: AddCommGroup](
    src: Module[R, M], dst: Module[R, N], f: M -> N, g: M -> N) {
    preserves_smul(src, dst, f) and preserves_smul(src, dst, g)
        implies preserves_smul(src, dst, sub_fn(f, g))
}

theorem sub_fn_is_linear_map[R: Ring, M: AddCommGroup, N: AddCommGroup](
    src: Module[R, M], dst: Module[R, N], f: M -> N, g: M -> N) {
    is_linear_map(src, dst, f) and is_linear_map(src, dst, g)
        implies is_linear_map(src, dst, sub_fn(f, g))
}

theorem add_fn_neg_fn[M: AddCommGroup, N: AddCommGroup](f: M -> N) {
    add_fn(f, neg_fn(f)) = trivial_linear_map[M, N]
}

define is_linear_equiv[R: Ring, M: AddCommGroup, N: AddCommGroup](
    src: Module[R, M], dst: Module[R, N], f: M -> N) -> Bool {
    is_linear_map(src, dst, f) and is_bijection_fn(f)
}

theorem linear_equiv_is_linear_map[R: Ring, M: AddCommGroup, N: AddCommGroup](
    src: Module[R, M], dst: Module[R, N], f: M -> N) {
    is_linear_equiv(src, dst, f) implies is_linear_map(src, dst, f)
}

theorem linear_equiv_is_bijection[R: Ring, M: AddCommGroup, N: AddCommGroup](
    src: Module[R, M], dst: Module[R, N], f: M -> N) {
    is_linear_equiv(src, dst, f) implies is_bijection_fn(f)
}

theorem identity_fn_is_linear_equiv[R: Ring, M: AddCommGroup](src: Module[R, M]) {
    is_linear_equiv(src, src, identity_fn[M])
}

theorem compose_is_linear_equiv[R: Ring, M: AddCommGroup, N: AddCommGroup, K: AddCommGroup](
    a: Module[R, M], b: Module[R, N], c: Module[R, K], f: N -> K, g: M -> N
) {
    is_linear_equiv(b, c, f) and is_linear_equiv(a, b, g)
    implies is_linear_equiv(a, c, compose(f, g))
}

theorem linear_map_two_sided_inverse_preserves_add[R: Ring, M: AddCommGroup, N: AddCommGroup](
    src: Module[R, M], dst: Module[R, N], f: M -> N, g: N -> M) {
    is_linear_map(src, dst, f) and is_two_sided_inverse_fn(f, g) implies preserves_add(g)
}

theorem linear_map_two_sided_inverse_preserves_smul[R: Ring, M: AddCommGroup, N: AddCommGroup](
    src: Module[R, M], dst: Module[R, N], f: M -> N, g: N -> M) {
    is_linear_map(src, dst, f) and is_two_sided_inverse_fn(f, g)
        implies preserves_smul(dst, src, g)
}

theorem linear_map_two_sided_inverse_is_linear_map[R: Ring, M: AddCommGroup, N: AddCommGroup](
    src: Module[R, M], dst: Module[R, N], f: M -> N, g: N -> M) {
    is_linear_map(src, dst, f) and is_two_sided_inverse_fn(f, g)
        implies is_linear_map(dst, src, g)
}

theorem linear_equiv_two_sided_inverse_is_linear_equiv[R: Ring, M: AddCommGroup, N: AddCommGroup](
    src: Module[R, M], dst: Module[R, N], f: M -> N, g: N -> M) {
    is_linear_equiv(src, dst, f) and is_two_sided_inverse_fn(f, g)
        implies is_linear_equiv(dst, src, g)
}

theorem linear_equiv_is_injective[R: Ring, M: AddCommGroup, N: AddCommGroup](
    src: Module[R, M], dst: Module[R, N], f: M -> N) {
    is_linear_equiv(src, dst, f) implies is_injective_fn(f)
}

theorem linear_equiv_is_surjective[R: Ring, M: AddCommGroup, N: AddCommGroup](
    src: Module[R, M], dst: Module[R, N], f: M -> N) {
    is_linear_equiv(src, dst, f) implies is_surjective_fn(f)
}

theorem linear_equiv_zero[R: Ring, M: AddCommGroup, N: AddCommGroup](
    src: Module[R, M], dst: Module[R, N], f: M -> N) {
    is_linear_equiv(src, dst, f) implies f(M.0) = N.0
}

theorem linear_equiv_add[R: Ring, M: AddCommGroup, N: AddCommGroup](
    src: Module[R, M], dst: Module[R, N], f: M -> N, x: M, y: M) {
    is_linear_equiv(src, dst, f) implies f(x + y) = f(x) + f(y)
}

theorem linear_equiv_smul[R: Ring, M: AddCommGroup, N: AddCommGroup](
    src: Module[R, M], dst: Module[R, N], f: M -> N, r: R, x: M) {
    is_linear_equiv(src, dst, f) implies f(src.smul(r, x)) = dst.smul(r, f(x))
}

theorem linear_equiv_neg[R: Ring, M: AddCommGroup, N: AddCommGroup](
    src: Module[R, M], dst: Module[R, N], f: M -> N, x: M) {
    is_linear_equiv(src, dst, f) implies f(-x) = -f(x)
}

theorem linear_equiv_sub[R: Ring, M: AddCommGroup, N: AddCommGroup](
    src: Module[R, M], dst: Module[R, N], f: M -> N, x: M, y: M) {
    is_linear_equiv(src, dst, f) implies f(x - y) = f(x) - f(y)
}

theorem linear_equiv_apply_eq_iff[R: Ring, M: AddCommGroup, N: AddCommGroup](
    src: Module[R, M], dst: Module[R, N], f: M -> N, g: N -> M, x: M, y: N) {
    is_linear_equiv(src, dst, f) and is_two_sided_inverse_fn(f, g)
        implies (f(x) = y iff x = g(y))
}

theorem linear_equiv_apply_eq_zero_iff_eq_zero[R: Ring, M: AddCommGroup, N: AddCommGroup](
    src: Module[R, M], dst: Module[R, N], f: M -> N, x: M) {
    is_linear_equiv(src, dst, f) implies (f(x) = N.0 iff x = M.0)
}

theorem linear_equiv_two_sided_inverse_zero[R: Ring, M: AddCommGroup, N: AddCommGroup](
    src: Module[R, M], dst: Module[R, N], f: M -> N, g: N -> M) {
    is_linear_equiv(src, dst, f) and is_two_sided_inverse_fn(f, g) implies g(N.0) = M.0
}

theorem linear_equiv_two_sided_inverse_add[R: Ring, M: AddCommGroup, N: AddCommGroup](
    src: Module[R, M], dst: Module[R, N], f: M -> N, g: N -> M, x: N, y: N) {
    is_linear_equiv(src, dst, f) and is_two_sided_inverse_fn(f, g)
        implies g(x + y) = g(x) + g(y)
}

theorem linear_equiv_two_sided_inverse_smul[R: Ring, M: AddCommGroup, N: AddCommGroup](
    src: Module[R, M], dst: Module[R, N], f: M -> N, g: N -> M, r: R, x: N) {
    is_linear_equiv(src, dst, f) and is_two_sided_inverse_fn(f, g)
        implies g(dst.smul(r, x)) = src.smul(r, g(x))
}

theorem linear_equiv_two_sided_inverse_neg[R: Ring, M: AddCommGroup, N: AddCommGroup](
    src: Module[R, M], dst: Module[R, N], f: M -> N, g: N -> M, x: N) {
    is_linear_equiv(src, dst, f) and is_two_sided_inverse_fn(f, g)
        implies g(-x) = -g(x)
}

theorem linear_equiv_two_sided_inverse_sub[R: Ring, M: AddCommGroup, N: AddCommGroup](
    src: Module[R, M], dst: Module[R, N], f: M -> N, g: N -> M, x: N, y: N) {
    is_linear_equiv(src, dst, f) and is_two_sided_inverse_fn(f, g)
        implies g(x - y) = g(x) - g(y)
}

theorem module_hom_ext[R: Ring, M: AddCommGroup, N: AddCommGroup](
    f: ModuleHom[R, M, N], g: ModuleHom[R, M, N]
) {
    f.src = g.src and f.dst = g.dst and (forall(x: M) { f.hom(x) = g.hom(x) }) implies f = g
}

attributes ModuleHom[R: Ring, M: AddCommGroup, N: AddCommGroup] {
    /// Module hom extensionality from pointwise equality of the underlying function.
    let ext = module_hom_ext[R, M, N]
}

theorem module_hom_eq_src[R: Ring, M: AddCommGroup, N: AddCommGroup](
    f: ModuleHom[R, M, N], g: ModuleHom[R, M, N]
) {
    f = g implies f.src = g.src
}

theorem module_hom_eq_dst[R: Ring, M: AddCommGroup, N: AddCommGroup](
    f: ModuleHom[R, M, N], g: ModuleHom[R, M, N]
) {
    f = g implies f.dst = g.dst
}

theorem module_hom_eq_hom[R: Ring, M: AddCommGroup, N: AddCommGroup](
    f: ModuleHom[R, M, N], g: ModuleHom[R, M, N]
) {
    f = g implies f.hom = g.hom
}

theorem module_hom_eq_hom_at[R: Ring, M: AddCommGroup, N: AddCommGroup](
    f: ModuleHom[R, M, N], g: ModuleHom[R, M, N], x: M
) {
    f = g implies f.hom(x) = g.hom(x)
}

theorem module_hom_is_linear_map[R: Ring, M: AddCommGroup, N: AddCommGroup](
    f: ModuleHom[R, M, N]
) {
    is_linear_map(f.src, f.dst, f.hom)
}

theorem module_hom_zero[R: Ring, M: AddCommGroup, N: AddCommGroup](
    f: ModuleHom[R, M, N]
) {
    f.hom(M.0) = N.0
}

theorem module_hom_add[R: Ring, M: AddCommGroup, N: AddCommGroup](
    f: ModuleHom[R, M, N], x: M, y: M
) {
    f.hom(x + y) = f.hom(x) + f.hom(y)
}

theorem module_hom_smul[R: Ring, M: AddCommGroup, N: AddCommGroup](
    f: ModuleHom[R, M, N], r: R, x: M
) {
    f.hom(f.src.smul(r, x)) = f.dst.smul(r, f.hom(x))
}

theorem module_hom_neg[R: Ring, M: AddCommGroup, N: AddCommGroup](
    f: ModuleHom[R, M, N], x: M
) {
    f.hom(-x) = -f.hom(x)
}

theorem module_hom_sub[R: Ring, M: AddCommGroup, N: AddCommGroup](
    f: ModuleHom[R, M, N], x: M, y: M
) {
    f.hom(x - y) = f.hom(x) - f.hom(y)
}

let module_hom_identity[R: Ring, M: AddCommGroup](m: Module[R, M]) -> result: ModuleHom[R, M, M] satisfy {
    ModuleHom.new(m, m, identity_fn[M]) = Option.some(result)
}

theorem module_hom_identity_hom[R: Ring, M: AddCommGroup](m: Module[R, M]) {
    module_hom_identity(m).hom = identity_fn[M]
}

theorem module_hom_identity_src[R: Ring, M: AddCommGroup](m: Module[R, M]) {
    module_hom_identity(m).src = m
}

theorem module_hom_identity_dst[R: Ring, M: AddCommGroup](m: Module[R, M]) {
    module_hom_identity(m).dst = m
}

theorem module_hom_identity_hom_at[R: Ring, M: AddCommGroup](m: Module[R, M], x: M) {
    module_hom_identity(m).hom(x) = x
}

let module_hom_trivial[R: Ring, M: AddCommGroup, N: AddCommGroup](src: Module[R, M], dst: Module[R, N]) -> result: ModuleHom[R, M, N] satisfy {
    ModuleHom.new(src, dst, trivial_linear_map[M, N]) = Option.some(result)
}

theorem module_hom_trivial_hom[R: Ring, M: AddCommGroup, N: AddCommGroup](
    src: Module[R, M], dst: Module[R, N]
) {
    module_hom_trivial(src, dst).hom = trivial_linear_map[M, N]
}

theorem module_hom_trivial_src[R: Ring, M: AddCommGroup, N: AddCommGroup](
    src: Module[R, M], dst: Module[R, N]
) {
    module_hom_trivial(src, dst).src = src
}

theorem module_hom_trivial_dst[R: Ring, M: AddCommGroup, N: AddCommGroup](
    src: Module[R, M], dst: Module[R, N]
) {
    module_hom_trivial(src, dst).dst = dst
}

theorem module_hom_trivial_hom_at[R: Ring, M: AddCommGroup, N: AddCommGroup](
    src: Module[R, M], dst: Module[R, N], x: M
) {
    module_hom_trivial(src, dst).hom(x) = N.0
}

define module_hom_compose[R: Ring, M: AddCommGroup, N: AddCommGroup, K: AddCommGroup](
    f: ModuleHom[R, N, K], g: ModuleHom[R, M, N]
) -> Option[ModuleHom[R, M, K]] {
    ModuleHom[R, M, K].new(g.src, f.dst, compose(f.hom, g.hom))
}

theorem module_hom_compose_some[R: Ring, M: AddCommGroup, N: AddCommGroup, K: AddCommGroup](
    f: ModuleHom[R, N, K], g: ModuleHom[R, M, N]
) {
    f.src = g.dst implies exists(h: ModuleHom[R, M, K]) {
        module_hom_compose(f, g) = Option.some(h)
    }
}

theorem module_hom_compose_src[R: Ring, M: AddCommGroup, N: AddCommGroup, K: AddCommGroup](
    f: ModuleHom[R, N, K], g: ModuleHom[R, M, N], h: ModuleHom[R, M, K]
) {
    module_hom_compose(f, g) = Option.some(h) implies h.src = g.src
}

theorem module_hom_compose_dst[R: Ring, M: AddCommGroup, N: AddCommGroup, K: AddCommGroup](
    f: ModuleHom[R, N, K], g: ModuleHom[R, M, N], h: ModuleHom[R, M, K]
) {
    module_hom_compose(f, g) = Option.some(h) implies h.dst = f.dst
}

theorem module_hom_compose_hom[R: Ring, M: AddCommGroup, N: AddCommGroup, K: AddCommGroup](
    f: ModuleHom[R, N, K], g: ModuleHom[R, M, N], h: ModuleHom[R, M, K]
) {
    module_hom_compose(f, g) = Option.some(h) implies h.hom = compose(f.hom, g.hom)
}

theorem module_hom_compose_hom_at[R: Ring, M: AddCommGroup, N: AddCommGroup, K: AddCommGroup](
    f: ModuleHom[R, N, K], g: ModuleHom[R, M, N], h: ModuleHom[R, M, K], x: M
) {
    module_hom_compose(f, g) = Option.some(h) implies h.hom(x) = f.hom(g.hom(x))
}

theorem module_hom_compose_identity_left_some[R: Ring, M: AddCommGroup, N: AddCommGroup](f: ModuleHom[R, M, N]) {
    exists(h: ModuleHom[R, M, N]) {
        module_hom_compose(module_hom_identity(f.dst), f) = Option.some(h)
    }
}

theorem module_hom_compose_identity_left_hom[R: Ring, M: AddCommGroup, N: AddCommGroup](f: ModuleHom[R, M, N], h: ModuleHom[R, M, N]) {
    module_hom_compose(module_hom_identity(f.dst), f) = Option.some(h) implies h.hom = f.hom
}

theorem module_hom_compose_identity_right_some[R: Ring, M: AddCommGroup, N: AddCommGroup](f: ModuleHom[R, M, N]) {
    exists(h: ModuleHom[R, M, N]) {
        module_hom_compose(f, module_hom_identity(f.src)) = Option.some(h)
    }
}

theorem module_hom_compose_identity_right_hom[R: Ring, M: AddCommGroup, N: AddCommGroup](f: ModuleHom[R, M, N], h: ModuleHom[R, M, N]) {
    module_hom_compose(f, module_hom_identity(f.src)) = Option.some(h) implies h.hom = f.hom
}

theorem module_hom_compose_trivial_left_some[R: Ring, M: AddCommGroup, N: AddCommGroup, K: AddCommGroup](
    f: ModuleHom[R, M, N], dst: Module[R, K]
) {
    exists(h: ModuleHom[R, M, K]) {
        module_hom_compose(module_hom_trivial(f.dst, dst), f) = Option.some(h)
    }
}

theorem module_hom_compose_trivial_left_hom[R: Ring, M: AddCommGroup, N: AddCommGroup, K: AddCommGroup](
    f: ModuleHom[R, M, N], dst: Module[R, K], h: ModuleHom[R, M, K]
) {
    module_hom_compose(module_hom_trivial(f.dst, dst), f) = Option.some(h)
        implies h.hom = trivial_linear_map[M, K]
}

theorem module_hom_compose_trivial_right_some[R: Ring, M: AddCommGroup, N: AddCommGroup, K: AddCommGroup](
    f: ModuleHom[R, N, K], src: Module[R, M]
) {
    exists(h: ModuleHom[R, M, K]) {
        module_hom_compose(f, module_hom_trivial(src, f.src)) = Option.some(h)
    }
}

theorem module_hom_compose_trivial_right_hom[R: Ring, M: AddCommGroup, N: AddCommGroup, K: AddCommGroup](
    f: ModuleHom[R, N, K], src: Module[R, M], h: ModuleHom[R, M, K]
) {
    module_hom_compose(f, module_hom_trivial(src, f.src)) = Option.some(h)
        implies h.hom = trivial_linear_map[M, K]
}

theorem module_hom_compose_identity_left_hom_at[R: Ring, M: AddCommGroup, N: AddCommGroup](
    f: ModuleHom[R, M, N], h: ModuleHom[R, M, N], x: M
) {
    module_hom_compose(module_hom_identity(f.dst), f) = Option.some(h)
        implies h.hom(x) = f.hom(x)
}

theorem module_hom_compose_identity_right_hom_at[R: Ring, M: AddCommGroup, N: AddCommGroup](
    f: ModuleHom[R, M, N], h: ModuleHom[R, M, N], x: M
) {
    module_hom_compose(f, module_hom_identity(f.src)) = Option.some(h)
        implies h.hom(x) = f.hom(x)
}

theorem module_hom_compose_trivial_left_hom_at[R: Ring, M: AddCommGroup, N: AddCommGroup, K: AddCommGroup](
    f: ModuleHom[R, M, N], dst: Module[R, K], h: ModuleHom[R, M, K], x: M
) {
    module_hom_compose(module_hom_trivial(f.dst, dst), f) = Option.some(h)
        implies h.hom(x) = K.0
}

theorem module_hom_compose_trivial_right_hom_at[R: Ring, M: AddCommGroup, N: AddCommGroup, K: AddCommGroup](
    f: ModuleHom[R, N, K], src: Module[R, M], h: ModuleHom[R, M, K], x: M
) {
    module_hom_compose(f, module_hom_trivial(src, f.src)) = Option.some(h)
        implies h.hom(x) = K.0
}

define is_linear_equiv_pair[R: Ring, M: AddCommGroup, N: AddCommGroup](
    src: Module[R, M], dst: Module[R, N], f: M -> N, g: N -> M) -> Bool {
    is_linear_map(src, dst, f) and is_two_sided_inverse_fn(f, g)
}

theorem linear_equiv_pair_forward[R: Ring, M: AddCommGroup, N: AddCommGroup](
    src: Module[R, M], dst: Module[R, N], f: M -> N, g: N -> M) {
    is_linear_equiv_pair(src, dst, f, g) implies is_linear_equiv(src, dst, f)
}

theorem linear_equiv_pair_inverse[R: Ring, M: AddCommGroup, N: AddCommGroup](
    src: Module[R, M], dst: Module[R, N], f: M -> N, g: N -> M) {
    is_linear_equiv_pair(src, dst, f, g) implies is_two_sided_inverse_fn(f, g)
}

theorem linear_equiv_pair_inverse_is_linear_equiv[R: Ring, M: AddCommGroup, N: AddCommGroup](
    src: Module[R, M], dst: Module[R, N], f: M -> N, g: N -> M) {
    is_linear_equiv_pair(src, dst, f, g) implies is_linear_equiv(dst, src, g)
}

theorem linear_equiv_pair_identity[R: Ring, M: AddCommGroup](src: Module[R, M]) {
    is_linear_equiv_pair(src, src, identity_fn[M], identity_fn[M])
}

theorem linear_equiv_pair_swap[R: Ring, M: AddCommGroup, N: AddCommGroup](
    src: Module[R, M], dst: Module[R, N], f: M -> N, g: N -> M) {
    is_linear_equiv_pair(src, dst, f, g) implies is_linear_equiv_pair(dst, src, g, f)
}

theorem linear_equiv_pair_compose[R: Ring, M: AddCommGroup, N: AddCommGroup, K: AddCommGroup](
    a: Module[R, M], b: Module[R, N], c: Module[R, K],
    f: N -> K, g: K -> N, h: M -> N, k: N -> M
) {
    is_linear_equiv_pair(b, c, f, g) and is_linear_equiv_pair(a, b, h, k)
    implies is_linear_equiv_pair(a, c, compose(f, h), compose(k, g))
}

define modules_linearly_equivalent[R: Ring, M: AddCommGroup, N: AddCommGroup](
    src: Module[R, M], dst: Module[R, N]) -> Bool {
    exists(f: M -> N) {
        exists(g: N -> M) {
            is_linear_equiv_pair(src, dst, f, g)
        }
    }
}

theorem modules_linearly_equivalent_of_pair[R: Ring, M: AddCommGroup, N: AddCommGroup](
    src: Module[R, M], dst: Module[R, N], f: M -> N, g: N -> M) {
    is_linear_equiv_pair(src, dst, f, g) implies modules_linearly_equivalent(src, dst)
}

theorem modules_linearly_equivalent_refl[R: Ring, M: AddCommGroup](src: Module[R, M]) {
    modules_linearly_equivalent(src, src)
}

theorem modules_linearly_equivalent_symm[R: Ring, M: AddCommGroup, N: AddCommGroup](
    src: Module[R, M], dst: Module[R, N]) {
    modules_linearly_equivalent(src, dst) implies modules_linearly_equivalent(dst, src)
}

theorem modules_linearly_equivalent_of_composed_pairs[R: Ring, M: AddCommGroup, N: AddCommGroup, K: AddCommGroup](
    a: Module[R, M], b: Module[R, N], c: Module[R, K],
    f: N -> K, g: K -> N, h: M -> N, k: N -> M
) {
    is_linear_equiv_pair(b, c, f, g) and is_linear_equiv_pair(a, b, h, k)
    implies modules_linearly_equivalent(a, c)
}

theorem modules_linearly_equivalent_of_pair_trans[R: Ring, M: AddCommGroup, N: AddCommGroup, K: AddCommGroup](
    a: Module[R, M], b: Module[R, N], c: Module[R, K], h: M -> N, k: N -> M
) {
    is_linear_equiv_pair(a, b, h, k) and modules_linearly_equivalent(b, c)
    implies modules_linearly_equivalent(a, c)
}

theorem modules_linearly_equivalent_trans[R: Ring, M: AddCommGroup, N: AddCommGroup, K: AddCommGroup](
    a: Module[R, M], b: Module[R, N], c: Module[R, K]) {
    modules_linearly_equivalent(a, b) and modules_linearly_equivalent(b, c)
    implies modules_linearly_equivalent(a, c)
}

theorem linear_equiv_to_fn_is_linear_map[R: Ring, M: AddCommGroup, N: AddCommGroup](
    e: LinearEquiv[R, M, N]
) {
    is_linear_map(e.src, e.dst, e.to_fn)
}

theorem linear_equiv_to_inv_two_sided[R: Ring, M: AddCommGroup, N: AddCommGroup](
    e: LinearEquiv[R, M, N]
) {
    is_two_sided_inverse_fn(e.to_fn, e.inv_fn)
}

theorem linear_equiv_left_inverse[R: Ring, M: AddCommGroup, N: AddCommGroup](
    e: LinearEquiv[R, M, N], x: M
) {
    e.inv_fn(e.to_fn(x)) = x
}

theorem linear_equiv_right_inverse[R: Ring, M: AddCommGroup, N: AddCommGroup](
    e: LinearEquiv[R, M, N], y: N
) {
    e.to_fn(e.inv_fn(y)) = y
}

theorem linear_equiv_to_fn_is_linear_equiv[R: Ring, M: AddCommGroup, N: AddCommGroup](
    e: LinearEquiv[R, M, N]
) {
    is_linear_equiv(e.src, e.dst, e.to_fn)
}

theorem linear_equiv_inv_fn_is_linear_map[R: Ring, M: AddCommGroup, N: AddCommGroup](
    e: LinearEquiv[R, M, N]
) {
    is_linear_map(e.dst, e.src, e.inv_fn)
}

theorem linear_equiv_is_pair[R: Ring, M: AddCommGroup, N: AddCommGroup](
    e: LinearEquiv[R, M, N]
) {
    is_linear_equiv_pair(e.src, e.dst, e.to_fn, e.inv_fn)
}

theorem linear_equiv_modules_linearly_equivalent[R: Ring, M: AddCommGroup, N: AddCommGroup](
    e: LinearEquiv[R, M, N]
) {
    modules_linearly_equivalent(e.src, e.dst)
}

theorem linear_equiv_ext[R: Ring, M: AddCommGroup, N: AddCommGroup](
    e: LinearEquiv[R, M, N], h: LinearEquiv[R, M, N]
) {
    e.src = h.src and e.dst = h.dst and e.to_fn = h.to_fn and e.inv_fn = h.inv_fn
        implies e = h
}

theorem linear_equiv_map_zero[R: Ring, M: AddCommGroup, N: AddCommGroup](
    e: LinearEquiv[R, M, N]
) {
    e.to_fn(M.0) = N.0
}

theorem linear_equiv_map_add[R: Ring, M: AddCommGroup, N: AddCommGroup](
    e: LinearEquiv[R, M, N], x: M, y: M
) {
    e.to_fn(x + y) = e.to_fn(x) + e.to_fn(y)
}

theorem linear_equiv_map_smul[R: Ring, M: AddCommGroup, N: AddCommGroup](
    e: LinearEquiv[R, M, N], r: R, x: M
) {
    e.to_fn(e.src.smul(r, x)) = e.dst.smul(r, e.to_fn(x))
}

theorem linear_equiv_map_neg[R: Ring, M: AddCommGroup, N: AddCommGroup](
    e: LinearEquiv[R, M, N], x: M
) {
    e.to_fn(-x) = -e.to_fn(x)
}

theorem linear_equiv_map_sub[R: Ring, M: AddCommGroup, N: AddCommGroup](
    e: LinearEquiv[R, M, N], x: M, y: M
) {
    e.to_fn(x - y) = e.to_fn(x) - e.to_fn(y)
}
