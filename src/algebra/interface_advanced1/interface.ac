typeclass G: Group extends Monoid {
    /// The inverse operation
    inverse: G -> G

    /// We only need right-inverse; we can prove left-inverse from it.
    inverse_right(a: G) {
        a * a.inverse = G.1
    }
}

theorem inverse_left_group[G: Group](a: G) {
    a.inverse * a = G.1
}

theorem inverse_inverse_group[G: Group](a: G) {
    a.inverse.inverse = a
}

theorem left_cancel_group[G: Group](a: G, b: G, c: G) {
    a * b = a * c implies b = c
}

theorem right_cancel_group[G: Group](a: G, b: G, c: G) {
    b * a = c * a implies b = c
}

theorem inverse_mul[G: Group](a: G, b: G) {
    (a * b).inverse = b.inverse * a.inverse
}

theorem pow_inverse_group[G: Group](a: G, n: Nat) {
    a.pow(n).inverse = a.inverse.pow(n)
}

theorem pow_cancel[G: Group](a: G, m: Nat, n: Nat) {
    n > m and a.pow(n) = a.pow(m) implies a.pow(n - m) = G.1
}

define has_finite_order[G: Group](g: G) -> Bool {
    exists(n: Nat) {
        n != Nat.0 and g.pow(n) = G.1
    }
}

let is_torsion_free[G: Group] = forall(g: G) {
    has_finite_order(g) implies g = G.1
}

define is_group_hom[G: Group, H: Group](f: G -> H) -> Bool {
    forall(a: G, b: G) {
        f(a * b) = f(a) * f(b)
    }
}

let trivial_group_hom[G: Group, H: Group]: G -> H = function(a: G) {
    H.1
}

theorem trivial_group_hom_is_hom[G: Group, H: Group] {
    is_group_hom(trivial_group_hom[G, H])
}

structure GroupHom[G: Group, H: Group] {
    /// The mapping for the homomorphism.
    hom: G -> H
} constraint {
    is_group_hom(hom)
}

theorem group_hom_ext[G: Group, H: Group](f: GroupHom[G, H], g: GroupHom[G, H]) {
    (forall(a: G) { f.hom(a) = g.hom(a) }) implies f = g
}

attributes GroupHom[G: Group, H: Group] {
    /// Group homomorphism extensionality from pointwise equality of the homomorphism.
    let ext = group_hom_ext[G, H]
}

theorem group_hom_eq_hom[G: Group, H: Group](f: GroupHom[G, H], g: GroupHom[G, H]) {
    f = g implies f.hom = g.hom
}

theorem group_hom_eq_apply[G: Group, H: Group](f: GroupHom[G, H], g: GroupHom[G, H], a: G) {
    f = g implies f.hom(a) = g.hom(a)
}

theorem group_hom_eq_transport_predicate[G: Group, H: Group](
    p: GroupHom[G, H] -> Bool,
    f: GroupHom[G, H],
    g: GroupHom[G, H]
) {
    f = g and p(f) implies p(g)
}

theorem group_hom_eq_transport_predicate_rev[G: Group, H: Group](
    p: GroupHom[G, H] -> Bool,
    f: GroupHom[G, H],
    g: GroupHom[G, H]
) {
    f = g and p(g) implies p(f)
}

theorem group_hom_eq_of_hom_eq[G: Group, H: Group](f: GroupHom[G, H], g: GroupHom[G, H]) {
    f.hom = g.hom implies f = g
}

theorem group_hom_eq_of_apply_eq[G: Group, H: Group](f: GroupHom[G, H], g: GroupHom[G, H]) {
    (forall(a: G) { f.hom(a) = g.hom(a) }) implies f = g
}

theorem group_hom_mul[G: Group, H: Group](f: GroupHom[G, H], a: G, b: G) {
    f.hom(a * b) = f.hom(a) * f.hom(b)
}

theorem group_hom_one[G: Group, H: Group](f: GroupHom[G, H]) {
    f.hom(G.1) = H.1
}

theorem group_hom_inv[G: Group, H: Group](f: GroupHom[G, H], a: G) {
    f.hom(a.inverse) = f.hom(a).inverse
}

theorem group_hom_pow[G: Group, H: Group](f: GroupHom[G, H], a: G, n: Nat) {
    f.hom(a.pow(n)) = f.hom(a).pow(n)
}

theorem monoid_hom_imp_group_hom[G: Group, H: Group](f: G -> H) {
    is_monoid_hom(f) implies is_group_hom(f)
}

theorem group_hom_imp_monoid_hom[G: Group, H: Group](f: G -> H) {
    is_group_hom(f) implies is_monoid_hom(f)
}

theorem group_hom_is_monoid_hom[G: Group, H: Group](f: GroupHom[G, H]) {
    is_monoid_hom(f.hom)
}

theorem monoid_hom_is_group_hom[G: Group, H: Group](f: MonoidHom[G, H]) {
    is_group_hom(f.hom)
}

let group_hom_to_monoid_hom[G: Group, H: Group](f: GroupHom[G, H]) -> result: MonoidHom[G, H] satisfy {
    MonoidHom.new(f.hom) = Option.some(result)
}

theorem group_hom_to_monoid_hom_hom[G: Group, H: Group](f: GroupHom[G, H]) {
    group_hom_to_monoid_hom(f).hom = f.hom
}

let group_hom_of_monoid_hom[G: Group, H: Group](f: MonoidHom[G, H]) -> result: GroupHom[G, H] satisfy {
    GroupHom.new(f.hom) = Option.some(result)
}

theorem group_hom_of_monoid_hom_hom[G: Group, H: Group](f: MonoidHom[G, H]) {
    group_hom_of_monoid_hom(f).hom = f.hom
}

theorem function_eq_transport_group_hom[G: Group, H: Group](f: G -> H, g: G -> H) {
    f = g and is_group_hom(f) implies is_group_hom(g)
}

theorem function_eq_transport_group_hom_rev[G: Group, H: Group](f: G -> H, g: G -> H) {
    f = g and is_group_hom(g) implies is_group_hom(f)
}

theorem identity_fn_is_group_hom[G: Group] {
    is_group_hom(identity_fn[G])
}

theorem compose_is_group_hom[G: Group, H: Group, K: Group](f: H -> K, g: G -> H) {
    is_group_hom(f) and is_group_hom(g) implies is_group_hom(compose(f, g))
}

let identity_group_hom[G: Group]: GroupHom[G, G] satisfy {
    GroupHom.new(identity_fn[G]) = Option.some(identity_group_hom)
}

theorem identity_group_hom_hom[G: Group] {
    identity_group_hom[G].hom = identity_fn[G]
}

let compose_group_hom[G: Group, H: Group, K: Group](f: GroupHom[H, K], g: GroupHom[G, H]) -> result: GroupHom[G, K] satisfy {
    GroupHom.new(compose(f.hom, g.hom)) = Option.some(result)
}

theorem compose_group_hom_hom[G: Group, H: Group, K: Group](f: GroupHom[H, K], g: GroupHom[G, H]) {
    compose_group_hom(f, g).hom = compose(f.hom, g.hom)
}

theorem compose_group_hom_assoc[A: Group, B: Group, C: Group, D: Group](
    f: GroupHom[C, D], g: GroupHom[B, C], h: GroupHom[A, B]) {
    compose_group_hom(compose_group_hom(f, g), h) = compose_group_hom(f, compose_group_hom(g, h))
}

theorem compose_group_hom_identity_left[G: Group, H: Group](f: GroupHom[G, H]) {
    compose_group_hom(identity_group_hom[H], f) = f
}

theorem compose_group_hom_identity_right[G: Group, H: Group](f: GroupHom[G, H]) {
    compose_group_hom(f, identity_group_hom[G]) = f
}

define pointwise_add[T, A: Add](f: T -> A, g: T -> A, t: T) -> A {
    f(t) + g(t)
}

define pointwise_mul[T, A: Mul](f: T -> A, g: T -> A, t: T) -> A {
    f(t) * g(t)
}

define pointwise_zero[T, A: Zero](t: T) -> A {
    A.0
}

define pointwise_one[T, A: One](t: T) -> A {
    A.1
}

define pointwise_neg[T, A: Neg](f: T -> A, t: T) -> A {
    -f(t)
}

define pointwise_inverse[T, A: Group](f: T -> A, t: T) -> A {
    f(t).inverse
}

theorem pointwise_add_apply[T, A: Add](f: T -> A, g: T -> A, t: T) {
    pointwise_add(f, g, t) = f(t) + g(t)
}

theorem pointwise_mul_apply[T, A: Mul](f: T -> A, g: T -> A, t: T) {
    pointwise_mul(f, g, t) = f(t) * g(t)
}

theorem pointwise_zero_apply[T, A: Zero](t: T) {
    pointwise_zero[T, A](t) = A.0
}

theorem pointwise_one_apply[T, A: One](t: T) {
    pointwise_one[T, A](t) = A.1
}

theorem pointwise_neg_apply[T, A: Neg](f: T -> A, t: T) {
    pointwise_neg(f, t) = -f(t)
}

theorem pointwise_inverse_apply[T, A: Group](f: T -> A, t: T) {
    pointwise_inverse(f, t) = f(t).inverse
}

theorem pointwise_add_assoc[T, A: AddSemigroup](f: T -> A, g: T -> A, h: T -> A) {
    pointwise_add(f, pointwise_add(g, h)) = pointwise_add(pointwise_add(f, g), h)
}

theorem pointwise_add_comm[T, A: AddCommSemigroup](f: T -> A, g: T -> A) {
    pointwise_add(f, g) = pointwise_add(g, f)
}

theorem pointwise_add_zero_right[T, A: AddMonoid](f: T -> A) {
    pointwise_add(f, pointwise_zero[T, A]) = f
}

theorem pointwise_add_zero_left[T, A: AddMonoid](f: T -> A) {
    pointwise_add(pointwise_zero[T, A], f) = f
}

theorem pointwise_add_neg_right[T, A: AddGroup](f: T -> A) {
    pointwise_add(f, pointwise_neg(f)) = pointwise_zero[T, A]
}

theorem pointwise_add_neg_left[T, A: AddGroup](f: T -> A) {
    pointwise_add(pointwise_neg(f), f) = pointwise_zero[T, A]
}

theorem pointwise_mul_assoc[T, A: Semigroup](f: T -> A, g: T -> A, h: T -> A) {
    pointwise_mul(f, pointwise_mul(g, h)) = pointwise_mul(pointwise_mul(f, g), h)
}

theorem pointwise_mul_comm[T, A: CommSemigroup](f: T -> A, g: T -> A) {
    pointwise_mul(f, g) = pointwise_mul(g, f)
}

theorem pointwise_mul_one_right[T, A: Monoid](f: T -> A) {
    pointwise_mul(f, pointwise_one[T, A]) = f
}

theorem pointwise_mul_one_left[T, A: Monoid](f: T -> A) {
    pointwise_mul(pointwise_one[T, A], f) = f
}

theorem pointwise_mul_inverse_right[T, A: Group](f: T -> A) {
    pointwise_mul(f, pointwise_inverse(f)) = pointwise_one[T, A]
}

theorem pointwise_mul_inverse_left[T, A: Group](f: T -> A) {
    pointwise_mul(pointwise_inverse(f), f) = pointwise_one[T, A]
}

theorem pointwise_mul_distrib_left[T, A: Semiring](f: T -> A, g: T -> A, h: T -> A) {
    pointwise_mul(f, pointwise_add(g, h)) =
    pointwise_add(pointwise_mul(f, g), pointwise_mul(f, h))
}

theorem pointwise_mul_distrib_right[T, A: Semiring](f: T -> A, g: T -> A, h: T -> A) {
    pointwise_mul(pointwise_add(f, g), h) =
    pointwise_add(pointwise_mul(f, h), pointwise_mul(g, h))
}

theorem pointwise_mul_zero_right[T, A: Semiring](f: T -> A) {
    pointwise_mul(f, pointwise_zero[T, A]) = pointwise_zero[T, A]
}

theorem pointwise_mul_zero_left[T, A: Semiring](f: T -> A) {
    pointwise_mul(pointwise_zero[T, A], f) = pointwise_zero[T, A]
}

define pair_add[A: Add, B: Add](p: Pair[A, B], q: Pair[A, B]) -> Pair[A, B] {
    Pair.new(p.first + q.first, p.second + q.second)
}

define pair_mul[A: Mul, B: Mul](p: Pair[A, B], q: Pair[A, B]) -> Pair[A, B] {
    Pair.new(p.first * q.first, p.second * q.second)
}

let pair_zero[A: Zero, B: Zero]: Pair[A, B] =
    Pair.new(A.0, B.0)

/// Componentwise one on a product.

let pair_one[A: One, B: One]: Pair[A, B] =
    Pair.new(A.1, B.1)

/// Componentwise negation on a product.
define pair_neg[A: Neg, B: Neg](p: Pair[A, B]) -> Pair[A, B] {
    Pair.new(-p.first, -p.second)
}

define pair_inverse[A: Group, B: Group](p: Pair[A, B]) -> Pair[A, B] {
    Pair.new(p.first.inverse, p.second.inverse)
}

theorem pair_add_first[A: Add, B: Add](p: Pair[A, B], q: Pair[A, B]) {
    pair_add(p, q).first = p.first + q.first
}

theorem pair_add_second[A: Add, B: Add](p: Pair[A, B], q: Pair[A, B]) {
    pair_add(p, q).second = p.second + q.second
}

theorem pair_mul_first[A: Mul, B: Mul](p: Pair[A, B], q: Pair[A, B]) {
    pair_mul(p, q).first = p.first * q.first
}

theorem pair_mul_second[A: Mul, B: Mul](p: Pair[A, B], q: Pair[A, B]) {
    pair_mul(p, q).second = p.second * q.second
}

theorem pair_zero_first[A: Zero, B: Zero] {
    pair_zero[A, B].first = A.0
}

theorem pair_zero_second[A: Zero, B: Zero] {
    pair_zero[A, B].second = B.0
}

theorem pair_one_first[A: One, B: One] {
    pair_one[A, B].first = A.1
}

theorem pair_one_second[A: One, B: One] {
    pair_one[A, B].second = B.1
}

theorem pair_neg_first[A: Neg, B: Neg](p: Pair[A, B]) {
    pair_neg(p).first = -p.first
}

theorem pair_neg_second[A: Neg, B: Neg](p: Pair[A, B]) {
    pair_neg(p).second = -p.second
}

theorem pair_inverse_first[A: Group, B: Group](p: Pair[A, B]) {
    pair_inverse(p).first = p.first.inverse
}

theorem pair_inverse_second[A: Group, B: Group](p: Pair[A, B]) {
    pair_inverse(p).second = p.second.inverse
}

theorem pair_add_assoc[A: AddSemigroup, B: AddSemigroup](
    p: Pair[A, B], q: Pair[A, B], r: Pair[A, B]
) {
    pair_add(p, pair_add(q, r)) = pair_add(pair_add(p, q), r)
}

theorem pair_add_comm[A: AddCommSemigroup, B: AddCommSemigroup](p: Pair[A, B], q: Pair[A, B]) {
    pair_add(p, q) = pair_add(q, p)
}

theorem pair_add_zero_right[A: AddMonoid, B: AddMonoid](p: Pair[A, B]) {
    pair_add(p, pair_zero[A, B]) = p
}

theorem pair_add_zero_left[A: AddMonoid, B: AddMonoid](p: Pair[A, B]) {
    pair_add(pair_zero[A, B], p) = p
}

theorem pair_add_neg_right[A: AddGroup, B: AddGroup](p: Pair[A, B]) {
    pair_add(p, pair_neg(p)) = pair_zero[A, B]
}

theorem pair_add_neg_left[A: AddGroup, B: AddGroup](p: Pair[A, B]) {
    pair_add(pair_neg(p), p) = pair_zero[A, B]
}

theorem pair_mul_assoc[A: Semigroup, B: Semigroup](
    p: Pair[A, B], q: Pair[A, B], r: Pair[A, B]
) {
    pair_mul(p, pair_mul(q, r)) = pair_mul(pair_mul(p, q), r)
}

theorem pair_mul_comm[A: CommSemigroup, B: CommSemigroup](p: Pair[A, B], q: Pair[A, B]) {
    pair_mul(p, q) = pair_mul(q, p)
}

theorem pair_mul_one_right[A: Monoid, B: Monoid](p: Pair[A, B]) {
    pair_mul(p, pair_one[A, B]) = p
}

theorem pair_mul_one_left[A: Monoid, B: Monoid](p: Pair[A, B]) {
    pair_mul(pair_one[A, B], p) = p
}

theorem pair_mul_inverse_right[A: Group, B: Group](p: Pair[A, B]) {
    pair_mul(p, pair_inverse[A, B](p)) = pair_one[A, B]
}

theorem pair_mul_inverse_left[A: Group, B: Group](p: Pair[A, B]) {
    pair_mul(pair_inverse[A, B](p), p) = pair_one[A, B]
}

theorem pair_map_pair_zero[A: Zero, B: Zero, C: Zero, D: Zero](f: A -> C, g: B -> D) {
    f(A.0) = C.0 and g(B.0) = D.0 implies
    pair_map(f, g, pair_zero[A, B]) = pair_zero[C, D]
}

theorem pair_map_pair_one[A: One, B: One, C: One, D: One](f: A -> C, g: B -> D) {
    f(A.1) = C.1 and g(B.1) = D.1 implies
    pair_map(f, g, pair_one[A, B]) = pair_one[C, D]
}

theorem pair_mul_add_distrib_left[A: Semiring, B: Semiring](
    p: Pair[A, B],
    q: Pair[A, B],
    r: Pair[A, B]
) {
    pair_mul(p, pair_add(q, r)) = pair_add(pair_mul(p, q), pair_mul(p, r))
}

theorem pair_mul_add_distrib_right[A: Semiring, B: Semiring](
    p: Pair[A, B],
    q: Pair[A, B],
    r: Pair[A, B]
) {
    pair_mul(pair_add(p, q), r) = pair_add(pair_mul(p, r), pair_mul(q, r))
}

theorem pair_mul_zero_right[A: Semiring, B: Semiring](p: Pair[A, B]) {
    pair_mul(p, pair_zero[A, B]) = pair_zero[A, B]
}

theorem pair_mul_zero_left[A: Semiring, B: Semiring](p: Pair[A, B]) {
    pair_mul(pair_zero[A, B], p) = pair_zero[A, B]
}

theorem pair_inverse_inverse[A: Group, B: Group](p: Pair[A, B]) {
    pair_inverse[A, B](pair_inverse[A, B](p)) = p
}

theorem pair_inverse_mul[A: Group, B: Group](p: Pair[A, B], q: Pair[A, B]) {
    pair_inverse[A, B](pair_mul(p, q)) = pair_mul(pair_inverse[A, B](q), pair_inverse[A, B](p))
}

theorem pair_swap_add[A: Add, B: Add](p: Pair[A, B], q: Pair[A, B]) {
    pair_add(p, q).swap = pair_add(p.swap, q.swap)
}

theorem pair_swap_mul[A: Mul, B: Mul](p: Pair[A, B], q: Pair[A, B]) {
    pair_mul(p, q).swap = pair_mul(p.swap, q.swap)
}

theorem pair_swap_zero[A: Zero, B: Zero] {
    pair_zero[A, B].swap = pair_zero[B, A]
}

theorem pair_swap_one[A: One, B: One] {
    pair_one[A, B].swap = pair_one[B, A]
}

theorem pair_swap_neg[A: Neg, B: Neg](p: Pair[A, B]) {
    pair_neg(p).swap = pair_neg(p.swap)
}

theorem pair_swap_inverse[A: Group, B: Group](p: Pair[A, B]) {
    pair_inverse[A, B](p).swap = pair_inverse[B, A](p.swap)
}

define has_support_in[T, A: Zero](f: T -> A, s: FiniteSet[T]) -> Bool {
    forall(t: T) {
        not s.contains(t) implies f(t) = A.0
    }
}

define is_finitely_supported[T, A: Zero](f: T -> A) -> Bool {
    exists(s: FiniteSet[T]) {
        has_support_in(f, s)
    }
}

theorem is_finitely_supported_of_has_support_in[T, A: Zero](f: T -> A, s: FiniteSet[T]) {
    has_support_in(f, s) implies is_finitely_supported(f)
}

theorem has_support_in_apply_zero[T, A: Zero](f: T -> A, s: FiniteSet[T], t: T) {
    has_support_in(f, s) and not s.contains(t) implies f(t) = A.0
}

theorem has_support_in_subset[T, A: Zero](f: T -> A, s: FiniteSet[T], t: FiniteSet[T]) {
    has_support_in(f, s) and s.underlying_set.subset(t.underlying_set) implies has_support_in(f, t)
}

theorem pointwise_zero_has_support_in[T, A: Zero](s: FiniteSet[T]) {
    has_support_in(pointwise_zero[T, A], s)
}

theorem pointwise_zero_is_finitely_supported[T, A: Zero] {
    is_finitely_supported(pointwise_zero[T, A])
}

theorem pointwise_add_has_support_in_union[T, A: AddMonoid](
    f: T -> A,
    g: T -> A,
    s: FiniteSet[T],
    u: FiniteSet[T]
) {
    has_support_in(f, s) and has_support_in(g, u) implies
    has_support_in(pointwise_add(f, g), fs_union(s, u))
}

theorem pointwise_add_is_finitely_supported[T, A: AddMonoid](f: T -> A, g: T -> A) {
    is_finitely_supported(f) and is_finitely_supported(g) implies
    is_finitely_supported(pointwise_add(f, g))
}

theorem pointwise_neg_has_support_in[T, A: AddGroup](f: T -> A, s: FiniteSet[T]) {
    has_support_in(f, s) implies has_support_in(pointwise_neg(f), s)
}

theorem pointwise_neg_is_finitely_supported[T, A: AddGroup](f: T -> A) {
    is_finitely_supported(f) implies is_finitely_supported(pointwise_neg(f))
}

theorem pointwise_mul_has_support_in_left[T, A: Semiring](f: T -> A, g: T -> A, s: FiniteSet[T]) {
    has_support_in(f, s) implies has_support_in(pointwise_mul(f, g), s)
}

theorem pointwise_mul_has_support_in_right[T, A: Semiring](f: T -> A, g: T -> A, s: FiniteSet[T]) {
    has_support_in(g, s) implies has_support_in(pointwise_mul(f, g), s)
}

theorem pointwise_mul_is_finitely_supported_left[T, A: Semiring](f: T -> A, g: T -> A) {
    is_finitely_supported(f) implies is_finitely_supported(pointwise_mul(f, g))
}

theorem pointwise_mul_is_finitely_supported_right[T, A: Semiring](f: T -> A, g: T -> A) {
    is_finitely_supported(g) implies is_finitely_supported(pointwise_mul(f, g))
}

theorem pointwise_mul_is_finitely_supported[T, A: Semiring](f: T -> A, g: T -> A) {
    is_finitely_supported(f) and is_finitely_supported(g) implies
    is_finitely_supported(pointwise_mul(f, g))
}

define pair_function_first[T, A, B](f: T -> Pair[A, B], t: T) -> A {
    f(t).first
}

define pair_function_second[T, A, B](f: T -> Pair[A, B], t: T) -> B {
    f(t).second
}

define pointwise_pair_zero[T, A: Zero, B: Zero](t: T) -> Pair[A, B] {
    pair_zero[A, B]
}

define pointwise_pair_add[T, A: AddMonoid, B: AddMonoid](
    f: T -> Pair[A, B],
    g: T -> Pair[A, B],
    t: T
) -> Pair[A, B] {
    pair_add(f(t), g(t))
}

define pointwise_pair_neg[T, A: AddGroup, B: AddGroup](f: T -> Pair[A, B], t: T) -> Pair[A, B] {
    pair_neg(f(t))
}

define pointwise_pair_mul[T, A: Semiring, B: Semiring](
    f: T -> Pair[A, B],
    g: T -> Pair[A, B],
    t: T
) -> Pair[A, B] {
    pair_mul(f(t), g(t))
}

define has_pair_support_in[T, A: Zero, B: Zero](f: T -> Pair[A, B], s: FiniteSet[T]) -> Bool {
    forall(t: T) {
        not s.contains(t) implies f(t) = pair_zero[A, B]
    }
}

define is_pair_finitely_supported[T, A: Zero, B: Zero](f: T -> Pair[A, B]) -> Bool {
    exists(s: FiniteSet[T]) {
        has_pair_support_in(f, s)
    }
}

theorem is_pair_finitely_supported_of_has_pair_support_in[T, A: Zero, B: Zero](
    f: T -> Pair[A, B],
    s: FiniteSet[T]
) {
    has_pair_support_in(f, s) implies is_pair_finitely_supported(f)
}

theorem has_pair_support_in_apply_zero[T, A: Zero, B: Zero](f: T -> Pair[A, B], s: FiniteSet[T], t: T) {
    has_pair_support_in(f, s) and not s.contains(t) implies f(t) = pair_zero[A, B]
}

theorem has_pair_support_in_first[T, A: Zero, B: Zero](f: T -> Pair[A, B], s: FiniteSet[T]) {
    has_pair_support_in(f, s) implies has_support_in(pair_function_first(f), s)
}

theorem has_pair_support_in_second[T, A: Zero, B: Zero](f: T -> Pair[A, B], s: FiniteSet[T]) {
    has_pair_support_in(f, s) implies has_support_in(pair_function_second(f), s)
}

theorem has_pair_support_in_of_coordinate_support[T, A: Zero, B: Zero](
    f: T -> Pair[A, B],
    s: FiniteSet[T]
) {
    has_support_in(pair_function_first(f), s) and has_support_in(pair_function_second(f), s)
    implies has_pair_support_in(f, s)
}

theorem has_pair_support_in_union_of_coordinate_support[T, A: Zero, B: Zero](
    f: T -> Pair[A, B],
    s: FiniteSet[T],
    u: FiniteSet[T]
) {
    has_support_in(pair_function_first(f), s) and has_support_in(pair_function_second(f), u)
    implies has_pair_support_in(f, fs_union(s, u))
}

theorem pair_finitely_supported_first[T, A: Zero, B: Zero](f: T -> Pair[A, B]) {
    is_pair_finitely_supported(f) implies is_finitely_supported(pair_function_first(f))
}

theorem pair_finitely_supported_second[T, A: Zero, B: Zero](f: T -> Pair[A, B]) {
    is_pair_finitely_supported(f) implies is_finitely_supported(pair_function_second(f))
}

theorem pair_finitely_supported_of_coordinate_supports[T, A: Zero, B: Zero](
    f: T -> Pair[A, B],
    s: FiniteSet[T],
    u: FiniteSet[T]
) {
    has_support_in(pair_function_first(f), s) and has_support_in(pair_function_second(f), u)
    implies is_pair_finitely_supported(f)
}

theorem pair_finitely_supported_of_coordinates[T, A: Zero, B: Zero](f: T -> Pair[A, B]) {
    is_finitely_supported(pair_function_first(f)) and is_finitely_supported(pair_function_second(f))
    implies is_pair_finitely_supported(f)
}

theorem pair_finitely_supported_iff_coordinates[T, A: Zero, B: Zero](f: T -> Pair[A, B]) {
    is_pair_finitely_supported(f) =
        (is_finitely_supported(pair_function_first(f)) and is_finitely_supported(pair_function_second(f)))
}

theorem pointwise_pair_zero_has_support_in[T, A: Zero, B: Zero](s: FiniteSet[T]) {
    has_pair_support_in(pointwise_pair_zero[T, A, B], s)
}

theorem pointwise_pair_zero_is_finitely_supported[T, A: Zero, B: Zero] {
    is_pair_finitely_supported(pointwise_pair_zero[T, A, B])
}

theorem pointwise_pair_add_has_support_in_union[T, A: AddMonoid, B: AddMonoid](
    f: T -> Pair[A, B],
    g: T -> Pair[A, B],
    s: FiniteSet[T],
    u: FiniteSet[T]
) {
    has_pair_support_in(f, s) and has_pair_support_in(g, u) implies
    has_pair_support_in(pointwise_pair_add(f, g), fs_union(s, u))
}

theorem pointwise_pair_add_is_finitely_supported_of_supports[T, A: AddMonoid, B: AddMonoid](
    f: T -> Pair[A, B],
    g: T -> Pair[A, B],
    s: FiniteSet[T],
    u: FiniteSet[T]
) {
    has_pair_support_in(f, s) and has_pair_support_in(g, u) implies
    is_pair_finitely_supported(pointwise_pair_add(f, g))
}

theorem pointwise_pair_add_is_finitely_supported[T, A: AddMonoid, B: AddMonoid](
    f: T -> Pair[A, B],
    g: T -> Pair[A, B]
) {
    is_pair_finitely_supported(f) and is_pair_finitely_supported(g) implies
    is_pair_finitely_supported(pointwise_pair_add(f, g))
}

theorem pointwise_pair_neg_has_support_in[T, A: AddGroup, B: AddGroup](
    f: T -> Pair[A, B],
    s: FiniteSet[T]
) {
    has_pair_support_in(f, s) implies has_pair_support_in(pointwise_pair_neg(f), s)
}

theorem pointwise_pair_mul_has_support_in_left[T, A: Semiring, B: Semiring](
    f: T -> Pair[A, B],
    g: T -> Pair[A, B],
    s: FiniteSet[T]
) {
    has_pair_support_in(f, s) implies has_pair_support_in(pointwise_pair_mul(f, g), s)
}

theorem pointwise_pair_mul_has_support_in_right[T, A: Semiring, B: Semiring](
    f: T -> Pair[A, B],
    g: T -> Pair[A, B],
    s: FiniteSet[T]
) {
    has_pair_support_in(g, s) implies has_pair_support_in(pointwise_pair_mul(f, g), s)
}

theorem pointwise_pair_neg_is_finitely_supported[T, A: AddGroup, B: AddGroup](f: T -> Pair[A, B]) {
    is_pair_finitely_supported(f) implies is_pair_finitely_supported(pointwise_pair_neg(f))
}

theorem pointwise_pair_mul_is_finitely_supported_left[T, A: Semiring, B: Semiring](
    f: T -> Pair[A, B],
    g: T -> Pair[A, B]
) {
    is_pair_finitely_supported(f) implies is_pair_finitely_supported(pointwise_pair_mul(f, g))
}

theorem pointwise_pair_mul_is_finitely_supported_right[T, A: Semiring, B: Semiring](
    f: T -> Pair[A, B],
    g: T -> Pair[A, B]
) {
    is_pair_finitely_supported(g) implies is_pair_finitely_supported(pointwise_pair_mul(f, g))
}

theorem pointwise_pair_mul_is_finitely_supported[T, A: Semiring, B: Semiring](
    f: T -> Pair[A, B],
    g: T -> Pair[A, B]
) {
    is_pair_finitely_supported(f) and is_pair_finitely_supported(g) implies
    is_pair_finitely_supported(pointwise_pair_mul(f, g))
}

structure AddMonoidAlgebra[R: Semiring, M] {
    /// The coefficient function.
    coeff: M -> R
} constraint {
    is_finitely_supported(coeff)
}

theorem add_monoid_algebra_ext[R: Semiring, M](p: AddMonoidAlgebra[R, M], q: AddMonoidAlgebra[R, M]) {
    p.coeff = q.coeff implies p = q
}

theorem add_monoid_algebra_ext_pointwise[R: Semiring, M](
    p: AddMonoidAlgebra[R, M], q: AddMonoidAlgebra[R, M]
) {
    (forall(m: M) { p.coeff(m) = q.coeff(m) }) implies p = q
}

theorem add_monoid_algebra_eq_coeff[R: Semiring, M](p: AddMonoidAlgebra[R, M], q: AddMonoidAlgebra[R, M]) {
    p = q implies p.coeff = q.coeff
}

theorem add_monoid_algebra_eq_coeff_at[R: Semiring, M](
    p: AddMonoidAlgebra[R, M], q: AddMonoidAlgebra[R, M], m: M
) {
    p = q implies p.coeff(m) = q.coeff(m)
}

theorem add_monoid_algebra_eq_iff_coeff_eq[R: Semiring, M](
    p: AddMonoidAlgebra[R, M], q: AddMonoidAlgebra[R, M]
) {
    p = q = forall(m: M) { p.coeff(m) = q.coeff(m) }
}

let add_monoid_algebra_singleton_support[M](m: M) -> result: FiniteSet[M] satisfy {
    FiniteSet[M].new(Set[M].singleton(m)) = Option.some(result)
}

define add_monoid_algebra_single_coeff[R: Semiring, M](m: M, r: R, n: M) -> R {
    if n = m {
        r
    } else {
        R.0
    }
}

theorem add_monoid_algebra_single_coeff_zero_of_not_contains[R: Semiring, M](m: M, r: R, n: M) {
    not add_monoid_algebra_singleton_support(m).contains(n) implies
    add_monoid_algebra_single_coeff[R, M](m, r, n) = R.0
}

theorem add_monoid_algebra_single_coeff_has_support[R: Semiring, M](m: M, r: R) {
    has_support_in(
        add_monoid_algebra_single_coeff[R, M](m, r),
        add_monoid_algebra_singleton_support(m)
    )
}

theorem add_monoid_algebra_single_coeff_is_finitely_supported[R: Semiring, M](m: M, r: R) {
    is_finitely_supported(add_monoid_algebra_single_coeff[R, M](m, r))
}

let add_monoid_algebra_single[R: Semiring, M](m: M, r: R) -> result: AddMonoidAlgebra[R, M] satisfy {
    AddMonoidAlgebra[R, M].new(add_monoid_algebra_single_coeff[R, M](m, r)) = Option.some(result)
}

theorem add_monoid_algebra_single_coeff_self[R: Semiring, M](m: M, r: R) {
    add_monoid_algebra_single[R, M](m, r).coeff(m) = r
}

theorem add_monoid_algebra_single_coeff_of_ne[R: Semiring, M](m: M, r: R, n: M) {
    n != m implies add_monoid_algebra_single[R, M](m, r).coeff(n) = R.0
}

let add_monoid_algebra_zero[R: Semiring, M]: AddMonoidAlgebra[R, M] satisfy {
    AddMonoidAlgebra[R, M].new(pointwise_zero[M, R]) = Option.some(add_monoid_algebra_zero)
}

let add_monoid_algebra_add[R: Semiring, M](p: AddMonoidAlgebra[R, M], q: AddMonoidAlgebra[R, M]) -> result: AddMonoidAlgebra[R, M] satisfy {
    AddMonoidAlgebra[R, M].new(pointwise_add(p.coeff, q.coeff)) = Option.some(result)
}

attributes AddMonoidAlgebra[R: Semiring, M] {
    /// Additive monoid algebra extensionality from equality of coefficients.
    let ext = add_monoid_algebra_ext[R, M]

    /// The single basis term with a chosen coefficient.
    let single: (M, R) -> AddMonoidAlgebra[R, M] = add_monoid_algebra_single

    /// The zero element of an additive monoid algebra.
    let zero: AddMonoidAlgebra[R, M] = add_monoid_algebra_zero[R, M]

    /// The coefficientwise sum of two additive monoid algebra elements.
    define add(self, other: AddMonoidAlgebra[R, M]) -> AddMonoidAlgebra[R, M] {
        add_monoid_algebra_add(self, other)
    }
}

instance AddMonoidAlgebra[R: Semiring, M]: Add {
    let add = AddMonoidAlgebra[R, M].add
}

instance AddMonoidAlgebra[R: Semiring, M]: Zero {
    let 0 = AddMonoidAlgebra[R, M].zero
}

theorem add_monoid_algebra_zero_coeff[R: Semiring, M](m: M) {
    AddMonoidAlgebra[R, M].zero.coeff(m) = R.0
}

theorem add_monoid_algebra_add_coeff[R: Semiring, M](p: AddMonoidAlgebra[R, M], q: AddMonoidAlgebra[R, M], m: M) {
    (p + q).coeff(m) = p.coeff(m) + q.coeff(m)
}

theorem add_monoid_algebra_add_assoc[R: Semiring, M](
    p: AddMonoidAlgebra[R, M], q: AddMonoidAlgebra[R, M], r: AddMonoidAlgebra[R, M]
) {
    p + (q + r) = (p + q) + r
}

theorem add_monoid_algebra_add_comm[R: Semiring, M](p: AddMonoidAlgebra[R, M], q: AddMonoidAlgebra[R, M]) {
    p + q = q + p
}

theorem add_monoid_algebra_add_zero_right[R: Semiring, M](p: AddMonoidAlgebra[R, M]) {
    p + AddMonoidAlgebra[R, M].zero = p
}

theorem add_monoid_algebra_add_zero_left[R: Semiring, M](p: AddMonoidAlgebra[R, M]) {
    AddMonoidAlgebra[R, M].zero + p = p
}

theorem add_monoid_algebra_zero_has_support_in[R: Semiring, M](s: FiniteSet[M]) {
    has_support_in(AddMonoidAlgebra[R, M].zero.coeff, s)
}

theorem add_monoid_algebra_zero_has_support_empty[R: Semiring, M] {
    has_support_in(AddMonoidAlgebra[R, M].zero.coeff, FiniteSet[M].empty)
}

theorem add_monoid_algebra_eq_zero_of_has_support_empty[R: Semiring, M](p: AddMonoidAlgebra[R, M]) {
    has_support_in(p.coeff, FiniteSet[M].empty) implies p = AddMonoidAlgebra[R, M].zero
}

theorem add_monoid_algebra_single_has_support_in_singleton[R: Semiring, M](m: M, r: R) {
    has_support_in(AddMonoidAlgebra[R, M].single(m, r).coeff, add_monoid_algebra_singleton_support(m))
}

theorem add_monoid_algebra_add_has_support_in_union[R: Semiring, M](
    p: AddMonoidAlgebra[R, M],
    q: AddMonoidAlgebra[R, M],
    s: FiniteSet[M],
    u: FiniteSet[M]
) {
    has_support_in(p.coeff, s) and has_support_in(q.coeff, u) implies
    has_support_in((p + q).coeff, s.union(u))
}

define add_monoid_algebra_smul_coeff_fn[R: Semiring, M](r: R, p: AddMonoidAlgebra[R, M], m: M) -> R {
    r * p.coeff(m)
}

theorem add_monoid_algebra_smul_coeff_zero_of_not_contains[R: Semiring, M](
    r: R,
    p: AddMonoidAlgebra[R, M],
    s: FiniteSet[M],
    m: M
) {
    has_support_in(p.coeff, s) and not s.contains(m) implies
    add_monoid_algebra_smul_coeff_fn(r, p, m) = R.0
}

theorem add_monoid_algebra_smul_coeff_has_support[R: Semiring, M](
    r: R,
    p: AddMonoidAlgebra[R, M],
    s: FiniteSet[M]
) {
    has_support_in(p.coeff, s) implies has_support_in(add_monoid_algebra_smul_coeff_fn(r, p), s)
}

theorem add_monoid_algebra_smul_coeff_is_finitely_supported[R: Semiring, M](r: R, p: AddMonoidAlgebra[R, M]) {
    is_finitely_supported(add_monoid_algebra_smul_coeff_fn(r, p))
}

let add_monoid_algebra_smul[R: Semiring, M](r: R, p: AddMonoidAlgebra[R, M]) -> result: AddMonoidAlgebra[R, M] satisfy {
    AddMonoidAlgebra[R, M].new(add_monoid_algebra_smul_coeff_fn(r, p)) = Option.some(result)
}

attributes AddMonoidAlgebra[R: Semiring, M] {
    /// Scalar multiplication by a coefficient.
    define smul(self, r: R) -> AddMonoidAlgebra[R, M] {
        add_monoid_algebra_smul(r, self)
    }
}

theorem add_monoid_algebra_smul_coeff[R: Semiring, M](r: R, p: AddMonoidAlgebra[R, M], m: M) {
    p.smul(r).coeff(m) = r * p.coeff(m)
}

theorem add_monoid_algebra_smul_has_support_in[R: Semiring, M](
    r: R,
    p: AddMonoidAlgebra[R, M],
    s: FiniteSet[M]
) {
    has_support_in(p.coeff, s) implies has_support_in(p.smul(r).coeff, s)
}

theorem add_monoid_algebra_smul_zero[R: Semiring, M](r: R) {
    AddMonoidAlgebra[R, M].zero.smul(r) = AddMonoidAlgebra[R, M].zero
}

theorem add_monoid_algebra_zero_smul[R: Semiring, M](p: AddMonoidAlgebra[R, M]) {
    p.smul(R.0) = AddMonoidAlgebra[R, M].zero
}

theorem add_monoid_algebra_one_smul[R: Semiring, M](p: AddMonoidAlgebra[R, M]) {
    p.smul(R.1) = p
}

theorem add_monoid_algebra_smul_add[R: Semiring, M](r: R, p: AddMonoidAlgebra[R, M], q: AddMonoidAlgebra[R, M]) {
    (p + q).smul(r) = p.smul(r) + q.smul(r)
}

theorem add_monoid_algebra_add_smul[R: Semiring, M](r: R, s: R, p: AddMonoidAlgebra[R, M]) {
    p.smul(r + s) = p.smul(r) + p.smul(s)
}

theorem add_monoid_algebra_smul_assoc[R: Semiring, M](r: R, s: R, p: AddMonoidAlgebra[R, M]) {
    p.smul(r * s) = p.smul(s).smul(r)
}

let add_monoid_algebra_neg[R: Ring, M](p: AddMonoidAlgebra[R, M]) -> result: AddMonoidAlgebra[R, M] satisfy {
    AddMonoidAlgebra[R, M].new(pointwise_neg(p.coeff)) = Option.some(result)
}

attributes AddMonoidAlgebra[R: Ring, M] {
    /// The coefficientwise additive inverse of an additive monoid algebra element.
    define neg(self) -> AddMonoidAlgebra[R, M] {
        add_monoid_algebra_neg(self)
    }

    /// The coefficientwise difference of two additive monoid algebra elements.
    define sub(self, other: AddMonoidAlgebra[R, M]) -> AddMonoidAlgebra[R, M] {
        self + other.neg
    }
}

theorem add_monoid_algebra_neg_coeff[R: Ring, M](p: AddMonoidAlgebra[R, M], m: M) {
    p.neg.coeff(m) = -p.coeff(m)
}

theorem add_monoid_algebra_sub_coeff[R: Ring, M](p: AddMonoidAlgebra[R, M], q: AddMonoidAlgebra[R, M], m: M) {
    p.sub(q).coeff(m) = p.coeff(m) + -q.coeff(m)
}

theorem add_monoid_algebra_neg_has_support_in[R: Ring, M](p: AddMonoidAlgebra[R, M], s: FiniteSet[M]) {
    has_support_in(p.coeff, s) implies has_support_in(p.neg.coeff, s)
}

theorem add_monoid_algebra_sub_has_support_in_union[R: Ring, M](
    p: AddMonoidAlgebra[R, M],
    q: AddMonoidAlgebra[R, M],
    s: FiniteSet[M],
    u: FiniteSet[M]
) {
    has_support_in(p.coeff, s) and has_support_in(q.coeff, u) implies
    has_support_in(p.sub(q).coeff, s.union(u))
}

theorem add_monoid_algebra_add_neg_right[R: Ring, M](p: AddMonoidAlgebra[R, M]) {
    p + p.neg = AddMonoidAlgebra[R, M].zero
}

theorem add_monoid_algebra_add_neg_left[R: Ring, M](p: AddMonoidAlgebra[R, M]) {
    p.neg + p = AddMonoidAlgebra[R, M].zero
}

theorem add_monoid_algebra_neg_zero[R: Ring, M] {
    AddMonoidAlgebra[R, M].zero.neg = AddMonoidAlgebra[R, M].zero
}

theorem add_monoid_algebra_neg_add[R: Ring, M](p: AddMonoidAlgebra[R, M], q: AddMonoidAlgebra[R, M]) {
    (p + q).neg = p.neg + q.neg
}

theorem add_monoid_algebra_sub_self[R: Ring, M](p: AddMonoidAlgebra[R, M]) {
    p.sub(p) = AddMonoidAlgebra[R, M].zero
}

theorem add_monoid_algebra_sub_zero[R: Ring, M](p: AddMonoidAlgebra[R, M]) {
    p.sub(AddMonoidAlgebra[R, M].zero) = p
}

theorem add_monoid_algebra_zero_sub[R: Ring, M](p: AddMonoidAlgebra[R, M]) {
    AddMonoidAlgebra[R, M].zero.sub(p) = p.neg
}

theorem add_monoid_algebra_add_left_cancel[R: Ring, M](p: AddMonoidAlgebra[R, M], q: AddMonoidAlgebra[R, M], r: AddMonoidAlgebra[R, M]) {
    p + q = p + r implies q = r
}

theorem add_monoid_algebra_add_right_cancel[R: Ring, M](p: AddMonoidAlgebra[R, M], q: AddMonoidAlgebra[R, M], r: AddMonoidAlgebra[R, M]) {
    q + p = r + p implies q = r
}

theorem add_monoid_algebra_eq_zero_of_coeff_zero[R: Semiring, M](p: AddMonoidAlgebra[R, M]) {
    (forall(m: M) { p.coeff(m) = R.0 }) implies p = AddMonoidAlgebra[R, M].zero
}

theorem add_monoid_algebra_coeff_zero_of_eq_zero[R: Semiring, M](p: AddMonoidAlgebra[R, M], m: M) {
    p = AddMonoidAlgebra[R, M].zero implies p.coeff(m) = R.0
}

theorem add_monoid_algebra_add_eq_zero_coeff[R: Semiring, M](p: AddMonoidAlgebra[R, M], q: AddMonoidAlgebra[R, M], m: M) {
    p + q = AddMonoidAlgebra[R, M].zero implies p.coeff(m) + q.coeff(m) = R.0
}

theorem add_monoid_algebra_sub_eq_zero_of_eq[R: Ring, M](p: AddMonoidAlgebra[R, M], q: AddMonoidAlgebra[R, M]) {
    p = q implies p.sub(q) = AddMonoidAlgebra[R, M].zero
}

theorem add_monoid_algebra_eq_of_sub_eq_zero[R: Ring, M](p: AddMonoidAlgebra[R, M], q: AddMonoidAlgebra[R, M]) {
    p.sub(q) = AddMonoidAlgebra[R, M].zero implies p = q
}

theorem add_monoid_algebra_sub_add_cancel[R: Ring, M](p: AddMonoidAlgebra[R, M], q: AddMonoidAlgebra[R, M]) {
    p.sub(q) + q = p
}

theorem add_monoid_algebra_add_sub_cancel[R: Ring, M](p: AddMonoidAlgebra[R, M], q: AddMonoidAlgebra[R, M]) {
    (p + q).sub(q) = p
}

theorem add_monoid_algebra_smul_neg[R: Ring, M](r: R, p: AddMonoidAlgebra[R, M]) {
    p.neg.smul(r) = p.smul(r).neg
}

theorem add_monoid_algebra_smul_sub[R: Ring, M](r: R, p: AddMonoidAlgebra[R, M], q: AddMonoidAlgebra[R, M]) {
    p.sub(q).smul(r) = p.smul(r).sub(q.smul(r))
}

theorem add_monoid_algebra_neg_smul[R: Ring, M](r: R, p: AddMonoidAlgebra[R, M]) {
    p.smul(-r) = p.smul(r).neg
}

theorem add_monoid_algebra_smul_neg_eq_neg_smul[R: Ring, M](r: R, p: AddMonoidAlgebra[R, M]) {
    p.neg.smul(r) = p.smul(-r)
}

theorem add_monoid_algebra_sub_smul[R: Ring, M](r: R, s: R, p: AddMonoidAlgebra[R, M]) {
    p.smul(r + -s) = p.smul(r).sub(p.smul(s))
}

theorem add_monoid_algebra_neg_smul_eq_smul_neg[R: Ring, M](r: R, p: AddMonoidAlgebra[R, M]) {
    p.smul(r).neg = p.smul(-r)
}

theorem add_monoid_algebra_single_zero_coeff[R: Semiring, M](m: M, n: M) {
    AddMonoidAlgebra[R, M].single(m, R.0).coeff(n) = R.0
}

theorem add_monoid_algebra_single_zero[R: Semiring, M](m: M) {
    AddMonoidAlgebra[R, M].single(m, R.0) = AddMonoidAlgebra[R, M].zero
}

theorem add_monoid_algebra_single_eq_zero_iff[R: Semiring, M](m: M, r: R) {
    AddMonoidAlgebra[R, M].single(m, r) = AddMonoidAlgebra[R, M].zero = (r = R.0)
}

theorem add_monoid_algebra_single_eq_single_same_iff[R: Semiring, M](m: M, r: R, s: R) {
    AddMonoidAlgebra[R, M].single(m, r) = AddMonoidAlgebra[R, M].single(m, s) = (r = s)
}

theorem add_monoid_algebra_single_add_same_coeff_self[R: Semiring, M](m: M, r: R, s: R) {
    (AddMonoidAlgebra[R, M].single(m, r) + AddMonoidAlgebra[R, M].single(m, s)).coeff(m) = r + s
}

theorem add_monoid_algebra_single_add_same_coeff_of_ne[R: Semiring, M](m: M, r: R, s: R, n: M) {
    n != m implies
    (AddMonoidAlgebra[R, M].single(m, r) + AddMonoidAlgebra[R, M].single(m, s)).coeff(n) = R.0
}

theorem add_monoid_algebra_single_add_same[R: Semiring, M](m: M, r: R, s: R) {
    AddMonoidAlgebra[R, M].single(m, r) + AddMonoidAlgebra[R, M].single(m, s) =
        AddMonoidAlgebra[R, M].single(m, r + s)
}

theorem add_monoid_algebra_single_smul_coeff_self[R: Semiring, M](m: M, r: R, s: R) {
    AddMonoidAlgebra[R, M].single(m, r).smul(s).coeff(m) = s * r
}

theorem add_monoid_algebra_single_smul_coeff_of_ne[R: Semiring, M](m: M, r: R, s: R, n: M) {
    n != m implies AddMonoidAlgebra[R, M].single(m, r).smul(s).coeff(n) = R.0
}

theorem add_monoid_algebra_single_smul[R: Semiring, M](m: M, r: R, s: R) {
    AddMonoidAlgebra[R, M].single(m, r).smul(s) = AddMonoidAlgebra[R, M].single(m, s * r)
}

theorem add_monoid_algebra_single_neg_coeff_self[R: Ring, M](m: M, r: R) {
    AddMonoidAlgebra[R, M].single(m, r).neg.coeff(m) = -r
}

theorem add_monoid_algebra_single_neg_coeff_of_ne[R: Ring, M](m: M, r: R, n: M) {
    n != m implies AddMonoidAlgebra[R, M].single(m, r).neg.coeff(n) = R.0
}

theorem add_monoid_algebra_single_neg[R: Ring, M](m: M, r: R) {
    AddMonoidAlgebra[R, M].single(m, r).neg = AddMonoidAlgebra[R, M].single(m, -r)
}

theorem add_monoid_algebra_single_sub_same_coeff_self[R: Ring, M](m: M, r: R, s: R) {
    AddMonoidAlgebra[R, M].single(m, r).sub(AddMonoidAlgebra[R, M].single(m, s)).coeff(m) = r + -s
}

theorem add_monoid_algebra_single_sub_same_coeff_of_ne[R: Ring, M](m: M, r: R, s: R, n: M) {
    n != m implies AddMonoidAlgebra[R, M].single(m, r).sub(AddMonoidAlgebra[R, M].single(m, s)).coeff(n) = R.0
}

theorem add_monoid_algebra_single_sub_same[R: Ring, M](m: M, r: R, s: R) {
    AddMonoidAlgebra[R, M].single(m, r).sub(AddMonoidAlgebra[R, M].single(m, s)) =
        AddMonoidAlgebra[R, M].single(m, r + -s)
}

define add_monoid_hom_image[A: AddMonoid, B: AddMonoid](f: AddMonoidHom[A, B], s: Set[A]) -> Set[B] {
    set_image(s, f.hom)
}

define add_monoid_hom_preimage[A: AddMonoid, B: AddMonoid](f: AddMonoidHom[A, B], s: Set[B]) -> Set[A] {
    set_preimage(f.hom, s)
}

define add_monoid_hom_image_preimage_closure[A: AddMonoid, B: AddMonoid](
    f: AddMonoidHom[A, B],
    s: Set[A]
) -> Set[A] {
    set_image_preimage_closure(f.hom, s)
}

define add_monoid_hom_preimage_image_kernel[A: AddMonoid, B: AddMonoid](
    f: AddMonoidHom[A, B],
    s: Set[B]
) -> Set[B] {
    set_preimage_image_kernel(f.hom, s)
}

theorem add_monoid_hom_image_contains_witness[A: AddMonoid, B: AddMonoid](
    f: AddMonoidHom[A, B],
    s: Set[A],
    y: B
) {
    add_monoid_hom_image(f, s).contains(y) implies exists(x: A) {
        s.contains(x) and y = f.hom(x)
    }
}

theorem add_monoid_hom_maps_into_image[A: AddMonoid, B: AddMonoid](
    f: AddMonoidHom[A, B],
    s: Set[A],
    x: A
) {
    s.contains(x) implies add_monoid_hom_image(f, s).contains(f.hom(x))
}

theorem add_monoid_hom_image_subset_iff_subset_preimage[A: AddMonoid, B: AddMonoid](
    f: AddMonoidHom[A, B],
    s: Set[A],
    t: Set[B]
) {
    add_monoid_hom_image(f, s).subset(t) = s.subset(add_monoid_hom_preimage(f, t))
}

theorem add_monoid_hom_image_compose[A: AddMonoid, B: AddMonoid, C: AddMonoid](
    f: AddMonoidHom[B, C],
    g: AddMonoidHom[A, B],
    s: Set[A]
) {
    add_monoid_hom_image(compose_add_monoid_hom(f, g), s) =
        add_monoid_hom_image(f, add_monoid_hom_image(g, s))
}

theorem add_monoid_hom_preimage_compose[A: AddMonoid, B: AddMonoid, C: AddMonoid](
    f: AddMonoidHom[B, C],
    g: AddMonoidHom[A, B],
    s: Set[C]
) {
    add_monoid_hom_preimage(compose_add_monoid_hom(f, g), s) =
        add_monoid_hom_preimage(g, add_monoid_hom_preimage(f, s))
}

theorem add_monoid_hom_image_preimage_closure_extensive[A: AddMonoid, B: AddMonoid](
    f: AddMonoidHom[A, B],
    s: Set[A]
) {
    s.subset(add_monoid_hom_image_preimage_closure(f, s))
}

theorem add_monoid_hom_image_preimage_closure_monotone[A: AddMonoid, B: AddMonoid](
    f: AddMonoidHom[A, B]
) {
    is_subset_monotone_map(add_monoid_hom_image_preimage_closure(f))
}

theorem add_monoid_hom_image_preimage_closure_idempotent[A: AddMonoid, B: AddMonoid](
    f: AddMonoidHom[A, B],
    s: Set[A]
) {
    add_monoid_hom_image_preimage_closure(f, add_monoid_hom_image_preimage_closure(f, s)) =
        add_monoid_hom_image_preimage_closure(f, s)
}

theorem add_monoid_hom_image_preimage_closure_operator[A: AddMonoid, B: AddMonoid](
    f: AddMonoidHom[A, B]
) {
    is_set_closure_operator(add_monoid_hom_image_preimage_closure(f))
}

theorem add_monoid_hom_preimage_image_kernel_reductive[A: AddMonoid, B: AddMonoid](
    f: AddMonoidHom[A, B],
    s: Set[B]
) {
    add_monoid_hom_preimage_image_kernel(f, s).subset(s)
}

theorem add_monoid_hom_preimage_image_kernel_monotone[A: AddMonoid, B: AddMonoid](
    f: AddMonoidHom[A, B]
) {
    is_subset_monotone_map(add_monoid_hom_preimage_image_kernel(f))
}

theorem add_monoid_hom_preimage_image_kernel_idempotent[A: AddMonoid, B: AddMonoid](
    f: AddMonoidHom[A, B],
    s: Set[B]
) {
    add_monoid_hom_preimage_image_kernel(f, add_monoid_hom_preimage_image_kernel(f, s)) =
        add_monoid_hom_preimage_image_kernel(f, s)
}

theorem add_monoid_hom_preimage_image_kernel_operator[A: AddMonoid, B: AddMonoid](
    f: AddMonoidHom[A, B]
) {
    is_set_kernel_operator(add_monoid_hom_preimage_image_kernel(f))
}

define add_submonoid_zero_constraint[M: AddMonoid](contains: M -> Bool) -> Bool {
    contains(M.0)
}

define add_submonoid_closure_constraint[M: AddMonoid](contains: M -> Bool) -> Bool {
    forall(a: M, b: M) {
        contains(a) and contains(b) implies contains(a + b)
    }
}

define add_submonoid_constraint[M: AddMonoid](contains: M -> Bool) -> Bool {
    add_submonoid_zero_constraint(contains) and add_submonoid_closure_constraint(contains)
}

structure AddSubmonoid[M: AddMonoid] {
    /// True if the given element is a member of this additive submonoid.
    contains: M -> Bool
} constraint {
    add_submonoid_constraint(contains)
}

theorem add_submonoid_ext[M: AddMonoid](a: AddSubmonoid[M], b: AddSubmonoid[M]) {
    (forall(x: M) { a.contains(x) = b.contains(x) }) implies a = b
}

theorem add_submonoid_eq_contains[M: AddMonoid](a: AddSubmonoid[M], b: AddSubmonoid[M]) {
    a = b implies a.contains = b.contains
}

theorem add_submonoid_eq_contains_at[M: AddMonoid](a: AddSubmonoid[M], b: AddSubmonoid[M], x: M) {
    a = b implies a.contains(x) = b.contains(x)
}

theorem add_submonoid_eq_transport_predicate[M: AddMonoid](
