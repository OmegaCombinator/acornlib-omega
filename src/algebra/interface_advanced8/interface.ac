theorem group_mul_inv_cancel_right[G: Group](a: G, b: G) {
    (b * a) * a.inverse = b
}

theorem group_inv_mul_cancel_left[G: Group](a: G, b: G) {
    a.inverse * (a * b) = b
}

theorem group_inv_mul_cancel_right[G: Group](a: G, b: G) {
    (b * a.inverse) * a = b
}

theorem group_mul_eq_one_iff_eq_inverse[G: Group](a: G, b: G) {
    (a * b = G.1) = (b = a.inverse)
}

theorem group_mul_eq_one_iff_eq_inverse_left[G: Group](a: G, b: G) {
    (a * b = G.1) = (a = b.inverse)
}

theorem group_inverse_injective[G: Group](a: G, b: G) {
    a.inverse = b.inverse implies a = b
}

theorem group_eq_iff_inv_eq[G: Group](a: G, b: G) {
    (a = b) = (a.inverse = b.inverse)
}

theorem group_sq_eq_one_iff_inv_eq_self[G: Group](a: G) {
    (a * a = G.1) = (a.inverse = a)
}

theorem group_pow_two[G: Group](a: G) {
    a.pow(2) = a * a
}

theorem group_pow_three[G: Group](a: G) {
    a.pow(3) = a * a * a
}

theorem group_pow_comm[G: Group](a: G, m: Nat, n: Nat) {
    a.pow(m) * a.pow(n) = a.pow(n) * a.pow(m)
}

theorem comm_group_commute[G: CommGroup](a: G, b: G) {
    commute[G](a, b)
}

theorem comm_group_inverse_mul[G: CommGroup](a: G, b: G) {
    (a * b).inverse = a.inverse * b.inverse
}

theorem comm_group_inv_eq_self_iff_sq_one[G: CommGroup](a: G) {
    (a.inverse = a) = (a * a = G.1)
}

theorem group_hom_kernel_contains_identity[G: Group, H: Group](f: GroupHom[G, H]) {
    group_hom_kernel(f).contains(G.1)
}

theorem group_hom_image_contains_identity[G: Group, H: Group](f: GroupHom[G, H], s: Subgroup[G]) {
    subgroup_image(f, s).contains(H.1)
}

theorem group_commute_pow_right[G: Group](a: G, b: G, n: Nat) {
    a * b = b * a implies a * b.pow(n) = b.pow(n) * a
}

typeclass D: IntegralDomain extends CommRing {
    /// Zero and one are distinct elements of the integral domain.
    zero_ne_one {
        D.0 != D.1
    }

    /// The product of two elements of an integral domain is zero only if at least one factor is zero.
    no_zero_divisors(a: D, b: D) {
        a * b = D.0 implies a = D.0 or b = D.0
    }
}

theorem integral_domain_mul_left_cancel[D: IntegralDomain](a: D, b: D, c: D) {
    a != D.0 and a * b = a * c implies b = c
}

theorem integral_domain_mul_right_cancel[D: IntegralDomain](a: D, b: D, c: D) {
    c != D.0 and a * c = b * c implies a = b
}

theorem integral_domain_mul_eq_zero[D: IntegralDomain](a: D, b: D) {
    a * b = D.0 implies a = D.0 or b = D.0
}

theorem integral_domain_mul_eq_zero_of_factor[D: IntegralDomain](a: D, b: D) {
    a = D.0 or b = D.0 implies a * b = D.0
}

theorem integral_domain_mul_nonzero[D: IntegralDomain](a: D, b: D) {
    a != D.0 and b != D.0 implies a * b != D.0
}

theorem integral_domain_left_nonzero_of_mul_nonzero[D: IntegralDomain](a: D, b: D) {
    a * b != D.0 implies a != D.0
}

theorem integral_domain_right_nonzero_of_mul_nonzero[D: IntegralDomain](a: D, b: D) {
    a * b != D.0 implies b != D.0
}

theorem integral_domain_square_nonzero[D: IntegralDomain](a: D) {
    a != D.0 implies a * a != D.0
}

theorem integral_domain_pow_suc_nonzero[D: IntegralDomain](a: D, k: Nat) {
    a != D.0 and a.pow(k) != D.0 implies a.pow(k.suc) != D.0
}

theorem integral_domain_pow_nonzero[D: IntegralDomain](a: D, n: Nat) {
    a != D.0 implies a.pow(n) != D.0
}

theorem zero_ideal_is_prime_of_integral_domain[D: IntegralDomain] {
    is_prime_ideal(zero_ideal[D])
}

theorem no_zero_divisors_of_zero_ideal_prime[R: CommRing](a: R, b: R) {
    is_prime_ideal(zero_ideal[R]) and a * b = R.0 implies a = R.0 or b = R.0
}

define alternating_sign[R: Ring](n: Nat) -> R {
    match n {
        Nat.zero {
            R.1
        }
        Nat.suc(k) {
            -alternating_sign[R](k)
        }
    }
}

theorem alternating_sign_zero[R: Ring] {
    alternating_sign[R](Nat.0) = R.1
}

theorem alternating_sign_suc[R: Ring](n: Nat) {
    alternating_sign[R](n.suc) = -alternating_sign[R](n)
}

theorem alternating_sign_suc_mul[R: Ring](n: Nat) {
    alternating_sign[R](n.suc) = -R.1 * alternating_sign[R](n)
}

theorem alternating_sign_eq_neg_one_pow[R: Ring](n: Nat) {
    alternating_sign[R](n) = (-R.1).pow(n)
}

theorem alternating_sign_parity[R: Ring](n: Nat) {
    (Nat.2.divides(n) implies alternating_sign[R](n) = R.1) and
    (not Nat.2.divides(n) implies alternating_sign[R](n) = -R.1)
}

theorem geometric_sum[R: Ring](a: R, n: Nat) {
    (a + -R.1) * sum(map(n.range, a.pow)) = a.pow(n) + -R.1
}

theorem geometric_sum_sub_one[R: Ring](a: R, n: Nat) {
    (a - R.1) * sum(map(n.range, a.pow)) = a.pow(n) - R.1
}

theorem ring_neg_zero[R: Ring] {
    -R.0 = R.0
}

theorem ring_sub_self[R: Ring](a: R) {
    a - a = R.0
}

theorem ring_sub_zero[R: Ring](a: R) {
    a - R.0 = a
}

theorem ring_zero_sub[R: Ring](a: R) {
    R.0 - a = -a
}

theorem ring_sub_eq_zero_iff_eq[R: Ring](a: R, b: R) {
    (a - b = R.0) = (a = b)
}

theorem ring_neg_sub[R: Ring](a: R, b: R) {
    -(a - b) = b - a
}

theorem ring_sub_neg[R: Ring](a: R, b: R) {
    a - -b = a + b
}

theorem ring_sub_eq_neg_sub[R: Ring](a: R, b: R) {
    a - b = -(b - a)
}

theorem ring_neg_eq_zero_iff[R: Ring](a: R) {
    (-a = R.0) = (a = R.0)
}

theorem ring_neg_eq_neg_iff[R: Ring](a: R, b: R) {
    (-a = -b) = (a = b)
}

theorem ring_add_sub_assoc[R: Ring](a: R, b: R, c: R) {
    (a + b) - c = a + (b - c)
}

theorem ring_sub_add_cancel[R: Ring](a: R, b: R) {
    (a - b) + b = a
}

theorem ring_add_sub_cancel[R: Ring](a: R, b: R) {
    a + b - b = a
}

theorem ring_sub_sub[R: Ring](a: R, b: R, c: R) {
    a - (b - c) = a - b + c
}

theorem ring_add_eq_zero_iff_eq_neg[R: Ring](a: R, b: R) {
    (a + b = R.0) = (b = -a)
}

theorem ring_add_eq_zero_iff_eq_neg_left[R: Ring](a: R, b: R) {
    (a + b = R.0) = (a = -b)
}

theorem ring_neg_add_neg_neg[R: Ring](a: R, b: R) {
    -(-a + -b) = a + b
}

theorem ring_mul_sub_cancel_right[R: Ring](a: R, b: R, c: R) {
    a * (b - c) + a * c = a * b
}

theorem ring_sub_mul_cancel_right[R: Ring](a: R, b: R, c: R) {
    (a - b) * c + b * c = a * c
}

theorem ring_sub_eq_of_sub_eq[R: Ring](a: R, b: R, c: R) {
    a - b = c - b implies a = c
}

theorem ring_sub_eq_iff_sub[R: Ring](a: R, b: R, c: R) {
    (a - b = a - c) = (b = c)
}

theorem ring_pow_two[R: Ring](a: R) {
    a.pow(2) = a * a
}

theorem ring_pow_three[R: Ring](a: R) {
    a.pow(3) = a * a * a
}

theorem ring_neg_pow_two[R: Ring](a: R) {
    (-a).pow(2) = a.pow(2)
}

theorem ring_neg_one_pow_two[R: Ring] {
    (-R.1).pow(2) = R.1
}

theorem ring_foil[R: Ring](a: R, b: R, c: R, d: R) {
    (a + b) * (c + d) = a * c + a * d + b * c + b * d
}

theorem ring_pow_mul_comm[R: Ring](a: R, m: Nat, n: Nat) {
    a.pow(m) * a.pow(n) = a.pow(n) * a.pow(m)
}

theorem ring_sub_self_mul_left[R: Ring](a: R, b: R) {
    (a - a) * b = R.0
}

theorem ring_mul_sub_self_right[R: Ring](a: R, b: R) {
    a * (b - b) = R.0
}

theorem ring_double_square[R: Ring](a: R) {
    (a + a).pow(2) = a.pow(2) + a.pow(2) + a.pow(2) + a.pow(2)
}

theorem ring_two_mul_add[R: Ring](a: R, b: R) {
    (R.1 + R.1) * (a + b) = (R.1 + R.1) * a + (R.1 + R.1) * b
}

theorem ring_from_nat_two[R: Ring] {
    from_nat[R](2) = R.1 + R.1
}

theorem ring_two_mul_from_nat[R: Ring](a: R) {
    from_nat[R](2) * a = a + a
}

define is_nilpotent[R: Ring](a: R) -> Bool {
    exists(n: Nat) {
        n != Nat.0 and a.pow(n) = R.0
    }
}

theorem nilpotent_zero[R: Ring] {
    is_nilpotent[R](R.0)
}

theorem nilpotent_intro[R: Ring](a: R, n: Nat) {
    n != Nat.0 and a.pow(n) = R.0 implies is_nilpotent[R](a)
}

theorem nilpotent_apply[R: Ring](a: R) {
    is_nilpotent[R](a) implies exists(n: Nat) {
        n != Nat.0 and a.pow(n) = R.0
    }
}

theorem nilpotent_neg[R: CommRing](a: R) {
    is_nilpotent[R](a) implies is_nilpotent[R](-a)
}

theorem nilpotent_mul_left[R: CommRing](a: R, b: R) {
    is_nilpotent[R](a) implies is_nilpotent[R](a * b)
}

theorem nilpotent_mul_right[R: CommRing](a: R, b: R) {
    is_nilpotent[R](b) implies is_nilpotent[R](a * b)
}

theorem nilpotent_pow[R: Ring](a: R, k: Nat) {
    k != Nat.0 and is_nilpotent[R](a) implies is_nilpotent[R](a.pow(k))
}

let is_char_two[R: Ring] = forall(a: R) {
    a + a = R.0
}

theorem char_two_iff_one_plus_one_zero[R: Ring] {
    is_char_two[R] = (R.1 + R.1 = R.0)
}

theorem char_two_neg_eq_self[R: Ring](a: R) {
    is_char_two[R] implies -a = a
}

theorem char_two_sub_eq_add[R: Ring](a: R, b: R) {
    is_char_two[R] implies a - b = a + b
}

theorem ring_add_self_zero_iff_neg_eq_self[R: Ring](a: R) {
    (a + a = R.0) = (-a = a)
}

theorem ring_add_self_zero_iff_two_mul_zero[R: Ring](a: R) {
    (a + a = R.0) = ((R.1 + R.1) * a = R.0)
}

theorem integral_domain_mul_left_cancel_iff[D: IntegralDomain](a: D, b: D, c: D) {
    a != D.0 implies ((a * b = a * c) = (b = c))
}

theorem integral_domain_mul_right_cancel_iff[D: IntegralDomain](a: D, b: D, c: D) {
    a != D.0 implies ((b * a = c * a) = (b = c))
}

theorem integral_domain_mul_eq_zero_iff[D: IntegralDomain](a: D, b: D) {
    (a * b = D.0) = (a = D.0 or b = D.0)
}

theorem integral_domain_sq_eq_zero_iff[D: IntegralDomain](a: D) {
    (a * a = D.0) = (a = D.0)
}

theorem integral_domain_pow_eq_zero_iff[D: IntegralDomain](a: D, n: Nat) {
    n != Nat.0 implies ((a.pow(n) = D.0) = (a = D.0))
}

theorem integral_domain_nilpotent_zero[D: IntegralDomain](a: D) {
    is_nilpotent[D](a) implies a = D.0
}

define is_square[M: Semigroup](a: M) -> Bool {
    exists(r: M) { a = r * r }
}

theorem is_square_iff_exists_mul_self[M: Semigroup](a: M) {
    is_square[M](a) = exists(r: M) { a = r * r }
}

theorem is_square_mul_self[M: Semigroup](r: M) {
    is_square[M](r * r)
}

theorem is_square_one[M: Monoid] {
    is_square[M](M.1)
}

theorem is_square_pow_two[M: Monoid](a: M) {
    is_square[M](a.pow(Nat.2))
}

theorem is_square_pow[M: CommMonoid](a: M, n: Nat) {
    is_square[M](a) implies is_square[M](a.pow(n))
}

theorem is_square_mul[M: CommSemigroup](a: M, b: M) {
    is_square[M](a) and is_square[M](b) implies is_square[M](a * b)
}

theorem is_square_map[M: Monoid, N: Monoid](f: MonoidHom[M, N], a: M) {
    is_square[M](a) implies is_square[N](f.hom(a))
}

define is_local_ring[R: CommRing](m: R -> Bool) -> Bool {
    is_maximal_ideal(m)
    and forall(other: R -> Bool) {
        is_maximal_ideal(other) implies other = m
    }
}

theorem is_local_ring_unfold[R: CommRing](m: R -> Bool) {
    is_local_ring(m) = (is_maximal_ideal(m) and forall(other: R -> Bool) {
        is_maximal_ideal(other) implies other = m
    })
}

theorem is_local_ring_from_unique_maximal[R: CommRing](m: R -> Bool) {
    is_maximal_ideal(m) and (forall(other: R -> Bool) {
        is_maximal_ideal(other) implies other = m
    }) implies is_local_ring(m)
}

theorem local_ring_witness_is_maximal[R: CommRing](m: R -> Bool) {
    is_local_ring(m) implies is_maximal_ideal(m)
}

theorem local_ring_maximal_unique[R: CommRing](m: R -> Bool, other: R -> Bool) {
    is_local_ring(m) and is_maximal_ideal(other) implies other = m
}

theorem local_ring_witness_eq_of_is_local_ring[R: CommRing](m: R -> Bool, n: R -> Bool) {
    is_local_ring(m) and is_local_ring(n) implies n = m
}

theorem field_maximal_ideal_eq_zero_ideal[F: Field](other: F -> Bool) {
    is_maximal_ideal(other) implies other = zero_ideal[F]
}

structure LocalRing[R: CommRing] {
    /// The unique maximal ideal of this local ring, as a membership predicate.
    maximal: R -> Bool
} constraint {
    is_local_ring(maximal)
}

theorem local_ring_maximal_is_maximal_ideal[R: CommRing](lr: LocalRing[R]) {
    is_maximal_ideal(lr.maximal)
}

theorem local_ring_unique_maximal[R: CommRing](lr: LocalRing[R], other: R -> Bool) {
    is_maximal_ideal(other) implies other = lr.maximal
}

let local_ring_as_maximal_ideal[R: CommRing](lr: LocalRing[R]) -> result: MaximalIdeal[R] satisfy {
    MaximalIdeal.new(lr.maximal) = Option.some(result)
}

theorem local_ring_ext[R: CommRing](a: LocalRing[R], b: LocalRing[R]) {
    a.maximal = b.maximal implies a = b
}

theorem local_ring_ext_at[R: CommRing](a: LocalRing[R], b: LocalRing[R]) {
    (forall(x: R) { a.maximal(x) = b.maximal(x) }) implies a = b
}

attributes LocalRing[R: CommRing] {
    /// Bundled local ring extensionality from equality of the maximal witness.
    let ext = local_ring_ext[R]

    /// The bundled maximal ideal obtained from the local ring structure.
    let as_maximal_ideal: LocalRing[R] -> MaximalIdeal[R] = local_ring_as_maximal_ideal[R]
}

theorem local_ring_as_maximal_ideal_contains_eq[R: CommRing](lr: LocalRing[R], x: R) {
    lr.as_maximal_ideal.contains(x) = lr.maximal(x)
}

theorem non_units_ideal_proper[R: CommRing] {
    ideal_proper_constraint(non_units[R])
}

theorem non_units_ideal_is_maximal[R: CommRing] {
    is_ideal(non_units[R]) implies is_maximal_ideal(non_units[R])
}

theorem non_units_ideal_maximal_unique[R: CommRing](other: R -> Bool) {
    is_ideal(non_units[R]) and is_maximal_ideal(other) implies other = non_units[R]
}

theorem non_units_ideal_implies_local_ring[R: CommRing] {
    is_ideal(non_units[R]) implies is_local_ring(non_units[R])
}

theorem field_is_local_ring[F: Field] {
    is_local_ring(zero_ideal[F])
}

define same_zero_support[T, A: Zero](f: T -> A, g: T -> A) -> Bool {
    forall(t: T) {
        (f(t) = A.0) = (g(t) = A.0)
    }
}

theorem has_support_in_of_same_zero_support[T, A: Zero](f: T -> A, g: T -> A, s: FiniteSet[T]) {
    same_zero_support(f, g) and has_support_in(f, s) implies has_support_in(g, s)
}

theorem has_support_in_iff_same_zero_support[T, A: Zero](f: T -> A, g: T -> A, s: FiniteSet[T]) {
    same_zero_support(f, g) implies (has_support_in(f, s) = has_support_in(g, s))
}

theorem is_finitely_supported_iff_same_zero_support[T, A: Zero](f: T -> A, g: T -> A) {
    same_zero_support(f, g) implies (is_finitely_supported(f) = is_finitely_supported(g))
}

structure FinitelySupportedFunction[T, A: AddCommGroup] {
    /// The underlying function.
    to_fun: T -> A
} constraint {
    is_finitely_supported(to_fun)
}

theorem finitely_supported_function_ext[T, A: AddCommGroup](
    f: FinitelySupportedFunction[T, A],
    g: FinitelySupportedFunction[T, A]
) {
    f.to_fun = g.to_fun implies f = g
}

theorem finitely_supported_function_ext_pointwise[T, A: AddCommGroup](
    f: FinitelySupportedFunction[T, A],
    g: FinitelySupportedFunction[T, A]
) {
    (forall(t: T) { f.to_fun(t) = g.to_fun(t) }) implies f = g
}

theorem finitely_supported_function_is_finitely_supported[T, A: AddCommGroup](
    f: FinitelySupportedFunction[T, A]
) {
    is_finitely_supported(f.to_fun)
}

let finitely_supported_function_support[T, A: AddCommGroup](f: FinitelySupportedFunction[T, A]) -> result: FiniteSet[T] satisfy {
    has_support_in(f.to_fun, result)
}

theorem finitely_supported_function_support_has_support_in[T, A: AddCommGroup](
    f: FinitelySupportedFunction[T, A]
) {
    has_support_in(f.to_fun, finitely_supported_function_support(f))
}

theorem finitely_supported_function_apply_zero_outside_support[T, A: AddCommGroup](
    f: FinitelySupportedFunction[T, A],
    t: T
) {
    not finitely_supported_function_support(f).contains(t) implies f.to_fun(t) = A.0
}

theorem finitely_supported_function_apply_zero_of_not_contains[T, A: AddCommGroup](
    f: FinitelySupportedFunction[T, A],
    s: FiniteSet[T],
    t: T
) {
    has_support_in(f.to_fun, s) and not s.contains(t) implies f.to_fun(t) = A.0
}

let finitely_supported_function_zero[T, A: AddCommGroup]: FinitelySupportedFunction[T, A] satisfy {
    FinitelySupportedFunction[T, A].new(pointwise_zero[T, A]) = Option.some(finitely_supported_function_zero)
}

let finitely_supported_function_add[T, A: AddCommGroup](f: FinitelySupportedFunction[T, A], g: FinitelySupportedFunction[T, A]) -> result: FinitelySupportedFunction[T, A] satisfy {
    FinitelySupportedFunction[T, A].new(pointwise_add(f.to_fun, g.to_fun)) = Option.some(result)
}

let finitely_supported_function_neg[T, A: AddCommGroup](f: FinitelySupportedFunction[T, A]) -> result: FinitelySupportedFunction[T, A] satisfy {
    FinitelySupportedFunction[T, A].new(pointwise_neg(f.to_fun)) = Option.some(result)
}

attributes FinitelySupportedFunction[T, A: AddCommGroup] {
    /// Extensionality for finitely supported functions.
    let ext = finitely_supported_function_ext[T, A]

    /// A chosen finite support for the underlying function.
    define support(self) -> FiniteSet[T] {
        finitely_supported_function_support(self)
    }

    /// The zero finitely supported function.
    let zero: FinitelySupportedFunction[T, A] = finitely_supported_function_zero[T, A]

    /// Pointwise addition of finitely supported functions.
    define add(self, other: FinitelySupportedFunction[T, A]) -> FinitelySupportedFunction[T, A] {
        finitely_supported_function_add(self, other)
    }

    /// Pointwise additive inverse of a finitely supported function.
    define neg(self) -> FinitelySupportedFunction[T, A] {
        finitely_supported_function_neg(self)
    }

    /// Pointwise difference of finitely supported functions.
    define sub(self, other: FinitelySupportedFunction[T, A]) -> FinitelySupportedFunction[T, A] {
        self + other.neg
    }
}

instance FinitelySupportedFunction[T, A: AddCommGroup]: Zero {
    let 0 = FinitelySupportedFunction[T, A].zero
}

theorem finitely_supported_function_zero_apply[T, A: AddCommGroup](t: T) {
    FinitelySupportedFunction[T, A].zero.to_fun(t) = A.0
}

theorem finitely_supported_function_zero_to_fun[T, A: AddCommGroup] {
    FinitelySupportedFunction[T, A].zero.to_fun = pointwise_zero[T, A]
}

theorem finitely_supported_function_add_apply[T, A: AddCommGroup](
    f: FinitelySupportedFunction[T, A],
    g: FinitelySupportedFunction[T, A],
    t: T
) {
    (f + g).to_fun(t) = f.to_fun(t) + g.to_fun(t)
}

theorem finitely_supported_function_add_to_fun[T, A: AddCommGroup](
    f: FinitelySupportedFunction[T, A],
    g: FinitelySupportedFunction[T, A]
) {
    (f + g).to_fun = pointwise_add(f.to_fun, g.to_fun)
}

theorem finitely_supported_function_neg_apply[T, A: AddCommGroup](
    f: FinitelySupportedFunction[T, A],
    t: T
) {
    (-f).to_fun(t) = -f.to_fun(t)
}

theorem finitely_supported_function_neg_to_fun[T, A: AddCommGroup](
    f: FinitelySupportedFunction[T, A]
) {
    (-f).to_fun = pointwise_neg(f.to_fun)
}

theorem finitely_supported_function_sub_apply[T, A: AddCommGroup](
    f: FinitelySupportedFunction[T, A],
    g: FinitelySupportedFunction[T, A],
    t: T
) {
    f.sub(g).to_fun(t) = f.to_fun(t) + -g.to_fun(t)
}

theorem finitely_supported_function_sub_to_fun[T, A: AddCommGroup](
    f: FinitelySupportedFunction[T, A],
    g: FinitelySupportedFunction[T, A]
) {
    f.sub(g).to_fun = pointwise_add(f.to_fun, pointwise_neg(g.to_fun))
}

