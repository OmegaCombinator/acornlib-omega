theorem modules_linearly_equivalent_symm_iff[R: Ring, M: AddCommGroup, N: AddCommGroup](
    src: Module[R, M], dst: Module[R, N]) {
    modules_linearly_equivalent(src, dst) iff modules_linearly_equivalent(dst, src)
}

