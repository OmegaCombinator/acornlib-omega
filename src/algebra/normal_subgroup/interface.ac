theorem ideal_quotient_pow_add[R: CommRing](i: Ideal[R], a: R, n: Nat, m: Nat) {
    ideal_quotient_mul(i,
        ideal_quotient_pow(i, quotient_over_mk(ideal_quotient_relation(i), a), n),
