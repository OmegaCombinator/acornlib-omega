}

theorem pair_add_semigroup_law[A: AddSemigroup, B: AddSemigroup](
    p: Pair[A, B],
    q: Pair[A, B],
    r: Pair[A, B]
) {
    p + (q + r) = (p + q) + r
}

theorem pair_add_semigroup_instance_law[A: AddSemigroup, B: AddSemigroup](
    p: Pair[A, B],
    q: Pair[A, B],
    r: Pair[A, B]
) {
    Add.add(p, Add.add(q, r)) = Add.add(Add.add(p, q), r)
}

theorem pair_add_comm_semigroup_law[A: AddCommSemigroup, B: AddCommSemigroup](
    p: Pair[A, B],
    q: Pair[A, B]
) {
    p + q = q + p
}

theorem pair_add_comm_semigroup_instance_law[A: AddCommSemigroup, B: AddCommSemigroup](
    p: Pair[A, B],
    q: Pair[A, B]
) {
    Add.add(p, q) = Add.add(q, p)
}

theorem pair_add_monoid_right_law[A: AddMonoid, B: AddMonoid](p: Pair[A, B]) {
    p + Zero.0[Pair[A, B]] = p
}

theorem pair_add_monoid_left_law[A: AddMonoid, B: AddMonoid](p: Pair[A, B]) {
    Zero.0[Pair[A, B]] + p = p
}

theorem pair_add_group_inverse_law[A: AddGroup, B: AddGroup](p: Pair[A, B]) {
    p + -p = Zero.0[Pair[A, B]]
}

theorem pair_add_group_instance_law[A: AddGroup, B: AddGroup](p: Pair[A, B]) {
    Add.add(p, Neg.neg(p)) = Zero.0[Pair[A, B]]
}

theorem pair_mul_semigroup_law[A: Semigroup, B: Semigroup](
    p: Pair[A, B],
    q: Pair[A, B],
    r: Pair[A, B]
) {
    p * (q * r) = (p * q) * r
}

theorem pair_mul_semigroup_instance_law[A: Semigroup, B: Semigroup](
    p: Pair[A, B],
    q: Pair[A, B],
    r: Pair[A, B]
) {
    Mul.mul(p, Mul.mul(q, r)) = Mul.mul(Mul.mul(p, q), r)
}

theorem pair_mul_comm_semigroup_law[A: CommSemigroup, B: CommSemigroup](
    p: Pair[A, B],
    q: Pair[A, B]
) {
    p * q = q * p
}

theorem pair_mul_comm_semigroup_instance_law[A: CommSemigroup, B: CommSemigroup](
    p: Pair[A, B],
    q: Pair[A, B]
) {
    Mul.mul(p, q) = Mul.mul(q, p)
}

theorem pair_monoid_right_law[A: Monoid, B: Monoid](p: Pair[A, B]) {
    p * One.1[Pair[A, B]] = p
}

theorem pair_monoid_left_law[A: Monoid, B: Monoid](p: Pair[A, B]) {
    One.1[Pair[A, B]] * p = p
}

theorem pair_semiring_distrib_left_law[A: Semiring, B: Semiring](
    p: Pair[A, B],
    q: Pair[A, B],
    r: Pair[A, B]
) {
    p * (q + r) = (p * q) + (p * r)
}

theorem pair_semiring_distrib_right_law[A: Semiring, B: Semiring](
    p: Pair[A, B],
    q: Pair[A, B],
    r: Pair[A, B]
) {
    (p + q) * r = (p * r) + (q * r)
}

theorem pair_semiring_mul_zero_left_law[A: Semiring, B: Semiring](p: Pair[A, B]) {
    p * Zero.0[Pair[A, B]] = Zero.0[Pair[A, B]]
}

theorem pair_semiring_mul_zero_right_law[A: Semiring, B: Semiring](p: Pair[A, B]) {
    Zero.0[Pair[A, B]] * p = Zero.0[Pair[A, B]]
}

theorem pair_semiring_distrib_left_instance_law[A: Semiring, B: Semiring](
    p: Pair[A, B],
    q: Pair[A, B],
    r: Pair[A, B]
) {
    Mul.mul(p, Add.add(q, r)) = Add.add(Mul.mul(p, q), Mul.mul(p, r))
}

theorem pair_semiring_distrib_right_instance_law[A: Semiring, B: Semiring](
    p: Pair[A, B],
    q: Pair[A, B],
    r: Pair[A, B]
) {
    Mul.mul(Add.add(p, q), r) = Add.add(Mul.mul(p, r), Mul.mul(q, r))
}

theorem alternating_sign_eq_neg_one_pow[R: Ring](n: Nat) {
    alternating_sign[R](n) = (-R.1).pow(n)
}

theorem geometric_sum[R: Ring](a: R, n: Nat) {
    (a + -R.1) * sum(map(n.range, a.pow)) = a.pow(n) + -R.1
}

theorem geometric_sum_sub_one[R: Ring](a: R, n: Nat) {
    (a - R.1) * sum(map(n.range, a.pow)) = a.pow(n) - R.1
}

theorem ring_neg_one_pow_two[R: Ring] {
    (-R.1).pow(2) = R.1
}

theorem ideal_quotient_canonical_projection_is_hom[R: CommRing](i: Ideal[R]) {
    ideal_quotient_mk_type(i, R.1) = One.1[IdealQuotient[R, i]] and
    forall(a: R, b: R) {
        ideal_quotient_mk_type(i, a + b) = ideal_quotient_mk_type(i, a) + ideal_quotient_mk_type(i, b) and
            ideal_quotient_mk_type(i, a * b) = ideal_quotient_mk_type(i, a) * ideal_quotient_mk_type(i, b)
    }
}

let unit_inverse[M: Monoid](u: Unit[M]) -> result: Unit[M] satisfy {
    Unit.new(u.inv, u.val) = Option.some(result)
}

instance Unit[M: Monoid]: Group {
    define inverse(self) -> Unit[M] {
        unit_inverse(self)
    }
}

attributes F: Field {
    /// Extends Monoid.pow to raise a field element to an integer.
    /// Similar to how we define Field.inverse this defines `F.0`.zpow(x) for negative x to be `0`.
    define zpow(self, exp: Int) -> F {
        match exp {
            Int.from_nat(n) {
                self.pow(n)
            }
            Int.neg_suc(k) {
                self.pow(k.suc).inverse
            }
        }
    }
}

theorem zero_pow_nonnegative[F: Field](n: Int) {
    n > Int.0 implies F.0.zpow(n) = F.0
}

theorem pow_inverse_nat[F: Field](a: F, k: Nat) {
    // n = k + 1
    a.zpow(Int.neg_suc(k)) = a.inverse.zpow(Int.from_nat(k.suc))
}

theorem pow_inverse[F: Field](a: F, n: Int) {
    a.zpow(-n) = a.inverse.zpow(n)
}

theorem pow_sub_inverse[F: Field](a: F, n: Int, m: Int) {
    a != F.0 and n >= Int.0 and m >= Int.0 implies a.zpow(n) * a.inverse.zpow(m) = a.zpow(n - m)
}

theorem pow_add_nonnegative[F: Field](a: F, n: Int, m: Int) {
    n >= Int.0 and m >= Int.0 implies a.zpow(n) * a.zpow(m) = a.zpow(n + m)
}

theorem pow_add[F: Field](a: F, n: Int, m: Int) {
    (n >= Int.0 and m >= Int.0) or a != F.0 implies a.zpow(n) * a.zpow(m) = a.zpow(n + m)
}

theorem zero_pow[F: Field](n: Int) {
    n != Int.0 implies F.0.zpow(n) = F.0
}

theorem pow_inverse2[F: Field](a: F, n: Int) {
    a.zpow(-n) = a.zpow(n).inverse
}

theorem one_pow[F: Field](n: Int) {
    F.1.zpow(n) = F.1
}

theorem pow_pow_nonnegative[F: Field](a: F, n: Int, m: Int) {
    n >= Int.0 and m >= Int.0 implies a.zpow(n).zpow(m) = a.zpow(n * m)
}

theorem pow_pow[F: Field](a: F, n: Int, m: Int) {
    a != F.0 or (n >= Int.0 and m >= Int.0) implies a.zpow(n).zpow(m) = a.zpow(n * m)
}

theorem gf4_inverse_zero {
    Zero.0[GF4].inverse = Zero.0[GF4]
}

theorem function_triple_inverse_apply[T, A: Group, B: Group, C: Group](
    p: Pair[T -> A, Pair[T -> B, T -> C]],
    t: T
) {
    function_triple_apply(function_triple_inverse(p), t) =
    Pair.new(p.first(t).inverse,
        Pair.new(p.second.first(t).inverse, p.second.second(t).inverse))
}

theorem unit_ext[M: Monoid](u: Unit[M], v: Unit[M]) {
    u.val = v.val and u.inv = v.inv implies u = v
}

attributes Unit[M: Monoid] {
    /// Unit extensionality from equality of the value and inverse.
    let ext = unit_ext[M]
}

theorem unit_val_mul_inv[M: Monoid](u: Unit[M]) {
    u.val * u.inv = M.1
}

theorem unit_inv_mul_val[M: Monoid](u: Unit[M]) {
    u.inv * u.val = M.1
}

theorem unit_val_is_monoid_unit[M: Monoid](u: Unit[M]) {
    is_monoid_unit(u.val)
}

theorem unit_right_inverse_unique[M: Monoid](u: Unit[M], b: M) {
    u.val * b = M.1 implies b = u.inv
}

theorem unit_left_inverse_unique[M: Monoid](u: Unit[M], b: M) {
    b * u.val = M.1 implies b = u.inv
}

theorem unit_inverse_unique[M: Monoid](u: Unit[M], b: M) {
    u.val * b = M.1 and b * u.val = M.1 implies b = u.inv
}

theorem unit_val_eq_inv_eq[M: Monoid](u: Unit[M], v: Unit[M]) {
    u.val = v.val implies u.inv = v.inv
}

theorem unit_inv_eq_val_eq[M: Monoid](u: Unit[M], v: Unit[M]) {
    u.inv = v.inv implies u.val = v.val
}

theorem unit_ext_val[M: Monoid](u: Unit[M], v: Unit[M]) {
    u.val = v.val implies u = v
}

theorem unit_ext_inv[M: Monoid](u: Unit[M], v: Unit[M]) {
    u.inv = v.inv implies u = v
}

theorem unit_eq_iff_val_eq[M: Monoid](u: Unit[M], v: Unit[M]) {
    (u = v) = (u.val = v.val)
}

theorem unit_eq_iff_inv_eq[M: Monoid](u: Unit[M], v: Unit[M]) {
    (u = v) = (u.inv = v.inv)
}

theorem unit_eq_val[M: Monoid](u: Unit[M], v: Unit[M]) {
    u = v implies u.val = v.val
}

theorem unit_eq_inv[M: Monoid](u: Unit[M], v: Unit[M]) {
    u = v implies u.inv = v.inv
}

theorem unit_one_val[M: Monoid] {
