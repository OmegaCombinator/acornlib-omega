theorem subfield_preimage_le[F: Field, E: Field](phi: FieldHom[F, E], s: Subfield[E], t: Subfield[E]) {
    subfield_le(s, t) implies subfield_le(subfield_preimage(phi, s), subfield_preimage(phi, t))
