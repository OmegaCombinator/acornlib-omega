define function_quintuple_add[T, A: Add, B: Add, C: Add, D: Add, E: Add](
    p: Pair[T -> A, Pair[T -> B, Pair[T -> C, Pair[T -> D, T -> E]]]],
    q: Pair[T -> A, Pair[T -> B, Pair[T -> C, Pair[T -> D, T -> E]]]]
) -> Pair[T -> A, Pair[T -> B, Pair[T -> C, Pair[T -> D, T -> E]]]] {
