let linear_map_preimage_submodule[R: Ring, M: AddCommGroup, N: AddCommGroup](src: Module[R, M], t: Submodule[R, N], f: M -> N) -> result: Submodule[R, M] satisfy {
    Submodule.new(src, linear_map_preimage_submodule_contains(src, t, f)) = Option.some(result)
}

theorem linear_map_preimage_submodule_carrier_eq[R: Ring, M: AddCommGroup, N: AddCommGroup](
    src: Module[R, M], t: Submodule[R, N], f: M -> N
) {
    linear_map_preimage_submodule(src, t, f).carrier = src
}

theorem linear_map_preimage_submodule_contains_eq[R: Ring, M: AddCommGroup, N: AddCommGroup](
    src: Module[R, M], t: Submodule[R, N], f: M -> N, x: M
) {
    is_linear_map(src, t.carrier, f) implies
        linear_map_preimage_submodule(src, t, f).contains(x) = t.contains(f(x))
}

theorem linear_map_preimage_submodule_contains_of_image_in[R: Ring, M: AddCommGroup, N: AddCommGroup](
    src: Module[R, M], t: Submodule[R, N], f: M -> N, x: M
) {
    is_linear_map(src, t.carrier, f) and t.contains(f(x))
    implies linear_map_preimage_submodule(src, t, f).contains(x)
}

theorem linear_map_preimage_submodule_image_in_of_contains[R: Ring, M: AddCommGroup, N: AddCommGroup](
    src: Module[R, M], t: Submodule[R, N], f: M -> N, x: M
) {
    is_linear_map(src, t.carrier, f) and linear_map_preimage_submodule(src, t, f).contains(x)
    implies t.contains(f(x))
}

theorem linear_map_preimage_submodule_full_contains_at[R: Ring, M: AddCommGroup, N: AddCommGroup](
    src: Module[R, M], dst: Module[R, N], f: M -> N, x: M
) {
    is_linear_map(src, dst, f) implies
        linear_map_preimage_submodule(src, full_submodule(dst), f).contains(x) = full_submodule(src).contains(x)
}

theorem linear_map_preimage_submodule_mono[R: Ring, M: AddCommGroup, N: AddCommGroup](
    src: Module[R, M], t1: Submodule[R, N], t2: Submodule[R, N], f: M -> N
) {
    t1.carrier = t2.carrier and is_linear_map(src, t1.carrier, f) and submodule_subset(t1, t2)
    implies submodule_subset(
        linear_map_preimage_submodule(src, t1, f),
        linear_map_preimage_submodule(src, t2, f))
}

theorem linear_map_preimage_submodule_zero_eq_kernel_at[R: Ring, M: AddCommGroup, N: AddCommGroup](
    src: Module[R, M], dst: Module[R, N], f: M -> N, x: M
) {
    is_linear_map(src, dst, f) implies linear_map_preimage_submodule(src, zero_submodule(dst), f).contains(x) = linear_map_kernel_submodule(src, dst, f).contains(x)
}

theorem linear_map_preimage_submodule_zero_subset_kernel[R: Ring, M: AddCommGroup, N: AddCommGroup](
    src: Module[R, M], dst: Module[R, N], f: M -> N
) {
    is_linear_map(src, dst, f) implies
        submodule_subset(
            linear_map_preimage_submodule(src, zero_submodule(dst), f),
            linear_map_kernel_submodule(src, dst, f))
}

theorem linear_map_kernel_subset_preimage_submodule_zero[R: Ring, M: AddCommGroup, N: AddCommGroup](
    src: Module[R, M], dst: Module[R, N], f: M -> N
) {
    is_linear_map(src, dst, f) implies
        submodule_subset(
            linear_map_kernel_submodule(src, dst, f),
            linear_map_preimage_submodule(src, zero_submodule(dst), f))
}

theorem linear_map_preimage_submodule_full_subset[R: Ring, M: AddCommGroup, N: AddCommGroup](
    src: Module[R, M], dst: Module[R, N], f: M -> N
) {
    is_linear_map(src, dst, f) implies
        submodule_subset(
            linear_map_preimage_submodule(src, full_submodule(dst), f),
            full_submodule(src))
}

theorem full_submodule_subset_linear_map_preimage_full[R: Ring, M: AddCommGroup, N: AddCommGroup](
    src: Module[R, M], dst: Module[R, N], f: M -> N
) {
    is_linear_map(src, dst, f) implies
        submodule_subset(
            full_submodule(src),
            linear_map_preimage_submodule(src, full_submodule(dst), f))
}

theorem linear_equiv_kernel_iff_zero[R: Ring, M: AddCommGroup, N: AddCommGroup](
    src: Module[R, M], dst: Module[R, N], f: M -> N, x: M
) {
    is_linear_equiv(src, dst, f) implies (linear_map_kernel[R, M, N](f, x) iff x = M.0)
}

theorem linear_equiv_image_full_at[R: Ring, M: AddCommGroup, N: AddCommGroup](
    src: Module[R, M], dst: Module[R, N], f: M -> N, y: N
) {
    is_linear_equiv(src, dst, f) implies linear_map_image[M, N](f, y)
}

theorem linear_equiv_kernel_submodule_contains_iff_zero[R: Ring, M: AddCommGroup, N: AddCommGroup](
    src: Module[R, M], dst: Module[R, N], f: M -> N, x: M
) {
    is_linear_equiv(src, dst, f) implies
        (linear_map_kernel_submodule(src, dst, f).contains(x) iff x = M.0)
}

theorem linear_equiv_image_submodule_contains[R: Ring, M: AddCommGroup, N: AddCommGroup](
    src: Module[R, M], dst: Module[R, N], f: M -> N, y: N
) {
    is_linear_equiv(src, dst, f) implies
        linear_map_image_submodule(src, dst, f).contains(y)
}

theorem linear_equiv_kernel_submodule_subset_zero_submodule[R: Ring, M: AddCommGroup, N: AddCommGroup](
    src: Module[R, M], dst: Module[R, N], f: M -> N
) {
    is_linear_equiv(src, dst, f) implies
        submodule_subset(linear_map_kernel_submodule(src, dst, f), zero_submodule(src))
}

theorem zero_submodule_subset_linear_equiv_kernel_submodule[R: Ring, M: AddCommGroup, N: AddCommGroup](
    src: Module[R, M], dst: Module[R, N], f: M -> N
) {
    is_linear_equiv(src, dst, f) implies
        submodule_subset(zero_submodule(src), linear_map_kernel_submodule(src, dst, f))
}

theorem full_submodule_subset_linear_equiv_image_submodule[R: Ring, M: AddCommGroup, N: AddCommGroup](
    src: Module[R, M], dst: Module[R, N], f: M -> N
) {
    is_linear_equiv(src, dst, f) implies
        submodule_subset(full_submodule(dst), linear_map_image_submodule(src, dst, f))
}

define module_hom_kernel[R: Ring, M: AddCommGroup, N: AddCommGroup](
    f: ModuleHom[R, M, N]
) -> Submodule[R, M] {
    linear_map_kernel_submodule(f.src, f.dst, f.hom)
}

theorem module_hom_kernel_carrier[R: Ring, M: AddCommGroup, N: AddCommGroup](
    f: ModuleHom[R, M, N]
) {
    module_hom_kernel(f).carrier = f.src
}

theorem module_hom_kernel_contains_eq[R: Ring, M: AddCommGroup, N: AddCommGroup](
    f: ModuleHom[R, M, N], x: M
) {
    module_hom_kernel(f).contains(x) = (f.hom(x) = N.0)
}

theorem module_hom_kernel_contains_of_map_eq_zero[R: Ring, M: AddCommGroup, N: AddCommGroup](
    f: ModuleHom[R, M, N], x: M
) {
    f.hom(x) = N.0 implies module_hom_kernel(f).contains(x)
}

theorem module_hom_kernel_map_eq_zero[R: Ring, M: AddCommGroup, N: AddCommGroup](
    f: ModuleHom[R, M, N], x: M
) {
    module_hom_kernel(f).contains(x) implies f.hom(x) = N.0
}

define module_hom_image[R: Ring, M: AddCommGroup, N: AddCommGroup](
    f: ModuleHom[R, M, N]
) -> Submodule[R, N] {
    linear_map_image_submodule(f.src, f.dst, f.hom)
}

theorem module_hom_image_carrier[R: Ring, M: AddCommGroup, N: AddCommGroup](
    f: ModuleHom[R, M, N]
) {
    module_hom_image(f).carrier = f.dst
}

theorem module_hom_image_contains_value[R: Ring, M: AddCommGroup, N: AddCommGroup](
    f: ModuleHom[R, M, N], x: M
) {
    module_hom_image(f).contains(f.hom(x))
}

theorem module_hom_image_contains_eq[R: Ring, M: AddCommGroup, N: AddCommGroup](
    f: ModuleHom[R, M, N], y: N
) {
    module_hom_image(f).contains(y) = linear_map_image[M, N](f.hom, y)
}

theorem module_hom_image_elim[R: Ring, M: AddCommGroup, N: AddCommGroup](
    f: ModuleHom[R, M, N], y: N
) {
    module_hom_image(f).contains(y) implies exists(x: M) { f.hom(x) = y }
}

theorem module_hom_image_subset_iff[R: Ring, M: AddCommGroup, N: AddCommGroup](
    f: ModuleHom[R, M, N], s: Submodule[R, N]
) {
    submodule_subset(module_hom_image(f), s) = forall(x: M) { s.contains(f.hom(x)) }
}

theorem module_hom_kernel_contains_iff_map_eq_zero[R: Ring, M: AddCommGroup, N: AddCommGroup](
    f: ModuleHom[R, M, N], x: M
) {
    module_hom_kernel(f).contains(x) iff f.hom(x) = N.0
}

theorem module_hom_kernel_implies_zero_of_injective[R: Ring, M: AddCommGroup, N: AddCommGroup](
    f: ModuleHom[R, M, N], x: M
) {
    is_injective_fn(f.hom) and module_hom_kernel(f).contains(x) implies x = M.0
}

theorem module_hom_kernel_subset_zero_of_injective[R: Ring, M: AddCommGroup, N: AddCommGroup](
    f: ModuleHom[R, M, N]
) {
    is_injective_fn(f.hom) implies
        submodule_subset(module_hom_kernel(f), zero_submodule(f.src))
}

theorem module_hom_injective_of_kernel_eq_zero[R: Ring, M: AddCommGroup, N: AddCommGroup](
    f: ModuleHom[R, M, N]
) {
    module_hom_kernel(f) = zero_submodule(f.src) implies is_injective_fn(f.hom)
}

theorem full_submodule_subset_module_hom_image_of_surjective[R: Ring, M: AddCommGroup, N: AddCommGroup](
    f: ModuleHom[R, M, N]
) {
    is_surjective_fn(f.hom) implies
        submodule_subset(full_submodule(f.dst), module_hom_image(f))
}

theorem module_hom_image_of_image_eq_full[R: Ring, M: AddCommGroup, N: AddCommGroup](
    f: ModuleHom[R, M, N], y: N
) {
    module_hom_image(f) = full_submodule(f.dst)
        implies exists(x: M) { f.hom(x) = y }
}

theorem module_hom_identity_kernel_contains_eq[R: Ring, M: AddCommGroup](
    m: Module[R, M], x: M
) {
    module_hom_kernel(module_hom_identity(m)).contains(x) = (x = M.0)
}

theorem module_hom_identity_kernel_contains_eq_zero_submodule[R: Ring, M: AddCommGroup](
    m: Module[R, M], x: M
) {
    module_hom_kernel(module_hom_identity(m)).contains(x) = zero_submodule(m).contains(x)
}

theorem module_hom_identity_image_contains[R: Ring, M: AddCommGroup](
    m: Module[R, M], x: M
) {
    module_hom_image(module_hom_identity(m)).contains(x)
}

theorem module_hom_identity_image_contains_eq_full_submodule[R: Ring, M: AddCommGroup](
    m: Module[R, M], x: M
) {
    module_hom_image(module_hom_identity(m)).contains(x) = full_submodule(m).contains(x)
}

theorem module_hom_trivial_kernel_contains[R: Ring, M: AddCommGroup, N: AddCommGroup](
    src: Module[R, M], dst: Module[R, N], x: M
) {
    module_hom_kernel(module_hom_trivial(src, dst)).contains(x)
}

theorem module_hom_trivial_kernel_contains_eq_full_submodule[R: Ring, M: AddCommGroup, N: AddCommGroup](
    src: Module[R, M], dst: Module[R, N], x: M
) {
    module_hom_kernel(module_hom_trivial(src, dst)).contains(x) = full_submodule(src).contains(x)
}

theorem module_hom_kernel_contains_zero[R: Ring, M: AddCommGroup, N: AddCommGroup](
    f: ModuleHom[R, M, N]
) {
    module_hom_kernel(f).contains(M.0)
}

theorem module_hom_kernel_contains_add[R: Ring, M: AddCommGroup, N: AddCommGroup](
    f: ModuleHom[R, M, N], a: M, b: M
) {
    module_hom_kernel(f).contains(a) and module_hom_kernel(f).contains(b)
        implies module_hom_kernel(f).contains(a + b)
}

theorem module_hom_kernel_contains_neg[R: Ring, M: AddCommGroup, N: AddCommGroup](
    f: ModuleHom[R, M, N], a: M
) {
    module_hom_kernel(f).contains(a) implies module_hom_kernel(f).contains(-a)
}

theorem module_hom_kernel_contains_smul[R: Ring, M: AddCommGroup, N: AddCommGroup](
    f: ModuleHom[R, M, N], r: R, a: M
) {
    module_hom_kernel(f).contains(a) implies module_hom_kernel(f).contains(f.src.smul(r, a))
}

theorem module_hom_kernel_subset_full[R: Ring, M: AddCommGroup, N: AddCommGroup](
    f: ModuleHom[R, M, N]
) {
    submodule_subset(module_hom_kernel(f), full_submodule(f.src))
}

theorem module_hom_image_contains_zero[R: Ring, M: AddCommGroup, N: AddCommGroup](
    f: ModuleHom[R, M, N]
) {
    module_hom_image(f).contains(N.0)
}

theorem module_hom_image_contains_add[R: Ring, M: AddCommGroup, N: AddCommGroup](
    f: ModuleHom[R, M, N], a: N, b: N
) {
    module_hom_image(f).contains(a) and module_hom_image(f).contains(b)
        implies module_hom_image(f).contains(a + b)
}

theorem module_hom_image_contains_neg[R: Ring, M: AddCommGroup, N: AddCommGroup](
    f: ModuleHom[R, M, N], a: N
) {
    module_hom_image(f).contains(a) implies module_hom_image(f).contains(-a)
}

theorem module_hom_image_contains_smul[R: Ring, M: AddCommGroup, N: AddCommGroup](
    f: ModuleHom[R, M, N], r: R, a: N
) {
    module_hom_image(f).contains(a) implies module_hom_image(f).contains(f.dst.smul(r, a))
}

define is_semiring_hom[S: Semiring, T: Semiring](f: S -> T) -> Bool {
    is_add_monoid_hom(f) and is_monoid_hom(f)
}

structure SemiringHom[S: Semiring, T: Semiring] {
    /// The mapping for the homomorphism.
    hom: S -> T
} constraint {
    is_semiring_hom(hom)
}

theorem semiring_hom_ext[S: Semiring, T: Semiring](f: SemiringHom[S, T], g: SemiringHom[S, T]) {
    (forall(a: S) { f.hom(a) = g.hom(a) }) implies f = g
}

attributes SemiringHom[S: Semiring, T: Semiring] {
    /// Semiring homomorphism extensionality from pointwise equality of the homomorphism.
    let ext = semiring_hom_ext[S, T]
}

theorem semiring_hom_eq_hom[S: Semiring, T: Semiring](f: SemiringHom[S, T], g: SemiringHom[S, T]) {
    f = g implies f.hom = g.hom
}

theorem semiring_hom_eq_apply[S: Semiring, T: Semiring](f: SemiringHom[S, T], g: SemiringHom[S, T], a: S) {
    f = g implies f.hom(a) = g.hom(a)
}

theorem semiring_hom_eq_transport_predicate[S: Semiring, T: Semiring](
    p: SemiringHom[S, T] -> Bool,
    f: SemiringHom[S, T],
    g: SemiringHom[S, T]
) {
    f = g and p(f) implies p(g)
}

theorem semiring_hom_eq_transport_predicate_rev[S: Semiring, T: Semiring](
    p: SemiringHom[S, T] -> Bool,
    f: SemiringHom[S, T],
    g: SemiringHom[S, T]
) {
    f = g and p(g) implies p(f)
}

theorem semiring_hom_eq_of_hom_eq[S: Semiring, T: Semiring](f: SemiringHom[S, T], g: SemiringHom[S, T]) {
    f.hom = g.hom implies f = g
}

theorem semiring_hom_eq_of_apply_eq[S: Semiring, T: Semiring](f: SemiringHom[S, T], g: SemiringHom[S, T]) {
    (forall(a: S) { f.hom(a) = g.hom(a) }) implies f = g
}

theorem semiring_hom_zero[S: Semiring, T: Semiring](f: SemiringHom[S, T]) {
    f.hom(S.0) = T.0
}

theorem semiring_hom_one[S: Semiring, T: Semiring](f: SemiringHom[S, T]) {
    f.hom(S.1) = T.1
}

theorem semiring_hom_add[S: Semiring, T: Semiring](f: SemiringHom[S, T], a: S, b: S) {
    f.hom(a + b) = f.hom(a) + f.hom(b)
}

theorem semiring_hom_mul[S: Semiring, T: Semiring](f: SemiringHom[S, T], a: S, b: S) {
    f.hom(a * b) = f.hom(a) * f.hom(b)
}

theorem semiring_hom_pow[S: Semiring, T: Semiring](f: SemiringHom[S, T], a: S, n: Nat) {
    f.hom(a.pow(n)) = f.hom(a).pow(n)
}

theorem function_eq_transport_semiring_hom[S: Semiring, T: Semiring](f: S -> T, g: S -> T) {
    f = g and is_semiring_hom(f) implies is_semiring_hom(g)
}

theorem function_eq_transport_semiring_hom_rev[S: Semiring, T: Semiring](f: S -> T, g: S -> T) {
    f = g and is_semiring_hom(g) implies is_semiring_hom(f)
}

theorem identity_fn_is_semiring_hom[S: Semiring] {
    is_semiring_hom(identity_fn[S])
}

theorem compose_is_semiring_hom[S: Semiring, T: Semiring, U: Semiring](f: T -> U, g: S -> T) {
    is_semiring_hom(f) and is_semiring_hom(g) implies is_semiring_hom(compose(f, g))
}

let identity_semiring_hom[S: Semiring]: SemiringHom[S, S] satisfy {
    SemiringHom.new(identity_fn[S]) = Option.some(identity_semiring_hom)
}

theorem identity_semiring_hom_hom[S: Semiring] {
    identity_semiring_hom[S].hom = identity_fn[S]
}

let compose_semiring_hom[S: Semiring, T: Semiring, U: Semiring](f: SemiringHom[T, U], g: SemiringHom[S, T]) -> result: SemiringHom[S, U] satisfy {
    SemiringHom.new(compose(f.hom, g.hom)) = Option.some(result)
}

theorem compose_semiring_hom_hom[S: Semiring, T: Semiring, U: Semiring](f: SemiringHom[T, U], g: SemiringHom[S, T]) {
    compose_semiring_hom(f, g).hom = compose(f.hom, g.hom)
}

theorem compose_semiring_hom_assoc[S: Semiring, T: Semiring, U: Semiring, V: Semiring](
    f: SemiringHom[U, V], g: SemiringHom[T, U], h: SemiringHom[S, T]) {
    compose_semiring_hom(compose_semiring_hom(f, g), h) = compose_semiring_hom(f, compose_semiring_hom(g, h))
}

theorem compose_semiring_hom_identity_left[S: Semiring, T: Semiring](f: SemiringHom[S, T]) {
    compose_semiring_hom(identity_semiring_hom[T], f) = f
}

theorem compose_semiring_hom_identity_right[S: Semiring, T: Semiring](f: SemiringHom[S, T]) {
    compose_semiring_hom(f, identity_semiring_hom[S]) = f
}

define is_ring_hom[R: Ring, S: Ring](f: R -> S) -> Bool {
    f(R.1) = S.1 and forall(a: R, b: R) {
        f(a + b) = f(a) + f(b) and f(a * b) = f(a) * f(b)
    }
}

structure RingHom[R: Ring, S: Ring] {
    /// The mapping for the homomorphism.
    hom: R -> S
} constraint {
    is_ring_hom(hom)
}

theorem ring_hom_ext[R: Ring, S: Ring](f: RingHom[R, S], g: RingHom[R, S]) {
    (forall(a: R) { f.hom(a) = g.hom(a) }) implies f = g
}

attributes RingHom[R: Ring, S: Ring] {
    /// Ring homomorphism extensionality from pointwise equality of the homomorphism.
    let ext = ring_hom_ext[R, S]
}

theorem ring_hom_eq_hom[R: Ring, S: Ring](f: RingHom[R, S], g: RingHom[R, S]) {
    f = g implies f.hom = g.hom
}

theorem ring_hom_eq_apply[R: Ring, S: Ring](f: RingHom[R, S], g: RingHom[R, S], a: R) {
    f = g implies f.hom(a) = g.hom(a)
}

theorem ring_hom_eq_transport_predicate[R: Ring, S: Ring](
    p: RingHom[R, S] -> Bool,
    f: RingHom[R, S],
    g: RingHom[R, S]
) {
    f = g and p(f) implies p(g)
}

theorem ring_hom_eq_transport_predicate_rev[R: Ring, S: Ring](
    p: RingHom[R, S] -> Bool,
    f: RingHom[R, S],
    g: RingHom[R, S]
) {
    f = g and p(g) implies p(f)
}

theorem ring_hom_eq_of_hom_eq[R: Ring, S: Ring](f: RingHom[R, S], g: RingHom[R, S]) {
    f.hom = g.hom implies f = g
}

theorem ring_hom_eq_of_apply_eq[R: Ring, S: Ring](f: RingHom[R, S], g: RingHom[R, S]) {
    (forall(a: R) { f.hom(a) = g.hom(a) }) implies f = g
}

theorem ring_hom_one[R: Ring, S: Ring](f: RingHom[R, S]) {
    f.hom(R.1) = S.1
}

theorem ring_hom_add[R: Ring, S: Ring](f: RingHom[R, S], a: R, b: R) {
    f.hom(a + b) = f.hom(a) + f.hom(b)
}

theorem ring_hom_mul[R: Ring, S: Ring](f: RingHom[R, S], a: R, b: R) {
    f.hom(a * b) = f.hom(a) * f.hom(b)
}

theorem ring_hom_zero[R: Ring, S: Ring](f: RingHom[R, S]) {
    f.hom(R.0) = S.0
}

theorem ring_hom_neg[R: Ring, S: Ring](f: RingHom[R, S], a: R) {
    f.hom(-a) = -f.hom(a)
}

theorem ring_hom_is_add_group_hom[R: Ring, S: Ring](f: RingHom[R, S]) {
    is_add_group_hom(f.hom)
}

theorem ring_hom_is_monoid_hom[R: Ring, S: Ring](f: RingHom[R, S]) {
    is_monoid_hom(f.hom)
}

theorem ring_hom_is_semiring_hom[R: Ring, S: Ring](f: RingHom[R, S]) {
    is_semiring_hom(f.hom)
}

let ring_hom_to_add_group_hom[R: Ring, S: Ring](f: RingHom[R, S]) -> result: AddGroupHom[R, S] satisfy {
    AddGroupHom.new(f.hom) = Option.some(result)
}

theorem ring_hom_to_add_group_hom_hom[R: Ring, S: Ring](f: RingHom[R, S]) {
    ring_hom_to_add_group_hom(f).hom = f.hom
}

let ring_hom_to_monoid_hom[R: Ring, S: Ring](f: RingHom[R, S]) -> result: MonoidHom[R, S] satisfy {
    MonoidHom.new(f.hom) = Option.some(result)
}

theorem ring_hom_to_monoid_hom_hom[R: Ring, S: Ring](f: RingHom[R, S]) {
    ring_hom_to_monoid_hom(f).hom = f.hom
}

let ring_hom_to_semiring_hom[R: Ring, S: Ring](f: RingHom[R, S]) -> result: SemiringHom[R, S] satisfy {
    SemiringHom.new(f.hom) = Option.some(result)
}

theorem ring_hom_to_semiring_hom_hom[R: Ring, S: Ring](f: RingHom[R, S]) {
    ring_hom_to_semiring_hom(f).hom = f.hom
}

theorem add_group_hom_monoid_hom_is_ring_hom[R: Ring, S: Ring](f: AddGroupHom[R, S], g: MonoidHom[R, S]) {
    f.hom = g.hom implies is_ring_hom(f.hom)
}

theorem ring_hom_pow[R: Ring, S: Ring](f: RingHom[R, S], a: R, n: Nat) {
    f.hom(a.pow(n)) = f.hom(a).pow(n)
}

theorem function_eq_transport_ring_hom[R: Ring, S: Ring](f: R -> S, g: R -> S) {
    f = g and is_ring_hom(f) implies is_ring_hom(g)
}

theorem function_eq_transport_ring_hom_rev[R: Ring, S: Ring](f: R -> S, g: R -> S) {
    f = g and is_ring_hom(g) implies is_ring_hom(f)
}

theorem identity_fn_is_ring_hom[R: Ring] {
    is_ring_hom(identity_fn[R])
}

theorem compose_is_ring_hom[R: Ring, S: Ring, T: Ring](f: S -> T, g: R -> S) {
    is_ring_hom(f) and is_ring_hom(g) implies is_ring_hom(compose(f, g))
}

let identity_ring_hom[R: Ring]: RingHom[R, R] satisfy {
    RingHom.new(identity_fn[R]) = Option.some(identity_ring_hom)
}

theorem identity_ring_hom_hom[R: Ring] {
    identity_ring_hom[R].hom = identity_fn[R]
}

let compose_ring_hom[R: Ring, S: Ring, T: Ring](f: RingHom[S, T], g: RingHom[R, S]) -> result: RingHom[R, T] satisfy {
    RingHom.new(compose(f.hom, g.hom)) = Option.some(result)
}

theorem compose_ring_hom_hom[R: Ring, S: Ring, T: Ring](f: RingHom[S, T], g: RingHom[R, S]) {
    compose_ring_hom(f, g).hom = compose(f.hom, g.hom)
}

theorem compose_ring_hom_assoc[R: Ring, S: Ring, T: Ring, U: Ring](
    f: RingHom[T, U], g: RingHom[S, T], h: RingHom[R, S]) {
    compose_ring_hom(compose_ring_hom(f, g), h) = compose_ring_hom(f, compose_ring_hom(g, h))
}

theorem compose_ring_hom_identity_left[R: Ring, S: Ring](f: RingHom[R, S]) {
    compose_ring_hom(identity_ring_hom[S], f) = f
}

theorem compose_ring_hom_identity_right[R: Ring, S: Ring](f: RingHom[R, S]) {
    compose_ring_hom(f, identity_ring_hom[R]) = f
}

define ideal_zero_constraint[R: CommRing](contains: R -> Bool) -> Bool {
    contains(R.0)
}

define ideal_add_constraint[R: CommRing](contains: R -> Bool) -> Bool {
    forall(a: R, b: R) {
        contains(a) and contains(b) implies contains(a + b)
    }
}

define ideal_absorb_constraint[R: CommRing](contains: R -> Bool) -> Bool {
    forall(r: R, a: R) {
        contains(a) implies contains(r * a)
    }
}

define is_ideal[R: CommRing](contains: R -> Bool) -> Bool {
    ideal_zero_constraint(contains)
    and ideal_add_constraint(contains)
    and ideal_absorb_constraint(contains)
}

theorem is_ideal_unfold[R: CommRing](contains: R -> Bool) {
    is_ideal(contains) = (ideal_zero_constraint(contains) and ideal_add_constraint(contains) and ideal_absorb_constraint(contains))
}

theorem is_ideal_from_constraints[R: CommRing](contains: R -> Bool) {
    ideal_zero_constraint(contains) and ideal_add_constraint(contains) and ideal_absorb_constraint(contains)
        implies is_ideal(contains)
}

theorem is_ideal_zero[R: CommRing](contains: R -> Bool) {
    is_ideal(contains) implies contains(R.0)
}

theorem is_ideal_add[R: CommRing](contains: R -> Bool, a: R, b: R) {
    is_ideal(contains) and contains(a) and contains(b) implies contains(a + b)
}

theorem is_ideal_absorb[R: CommRing](contains: R -> Bool, r: R, a: R) {
    is_ideal(contains) and contains(a) implies contains(r * a)
}

theorem is_ideal_neg[R: CommRing](contains: R -> Bool, a: R) {
    is_ideal(contains) and contains(a) implies contains(-a)
}

define zero_ideal[R: CommRing](a: R) -> Bool {
    a = R.0
}

theorem zero_ideal_is_ideal[R: CommRing] {
    is_ideal(zero_ideal[R])
}

define unit_ideal[R: CommRing](a: R) -> Bool {
    true
}

theorem unit_ideal_is_ideal[R: CommRing] {
    is_ideal(unit_ideal[R])
}

theorem ideal_eq_unit_of_contains_one[R: CommRing](contains: R -> Bool) {
    is_ideal(contains) and contains(R.1) implies contains = unit_ideal[R]
}

theorem ideal_contains_one_iff_eq_unit[R: CommRing](contains: R -> Bool) {
    is_ideal(contains) implies (contains(R.1) = (contains = unit_ideal[R]))
}

define principal_ideal[R: CommRing](a: R, x: R) -> Bool {
    exists(r: R) {
        x = r * a
    }
}

theorem principal_ideal_is_ideal[R: CommRing](a: R) {
    is_ideal(principal_ideal[R](a))
}

theorem principal_ideal_contains_generator[R: CommRing](a: R) {
    principal_ideal(a, a)
}

theorem principal_ideal_contains_multiple[R: CommRing](a: R, r: R) {
    principal_ideal(a, r * a)
}

theorem principal_ideal_witness[R: CommRing](a: R, x: R) {
    principal_ideal(a, x) implies exists(r: R) { x = r * a }
}

theorem principal_ideal_zero_eq_zero_ideal[R: CommRing] {
    principal_ideal[R](R.0) = zero_ideal[R]
}

theorem principal_ideal_one_eq_unit_ideal[R: CommRing] {
    principal_ideal[R](R.1) = unit_ideal[R]
}

define ideal_subset[R: CommRing](contains_i: R -> Bool, contains_j: R -> Bool) -> Bool {
    forall(x: R) {
        contains_i(x) implies contains_j(x)
    }
}

theorem ideal_subset_refl[R: CommRing](contains: R -> Bool) {
    ideal_subset(contains, contains)
}

theorem ideal_subset_trans[R: CommRing](contains_i: R -> Bool,
                                        contains_j: R -> Bool,
                                        contains_k: R -> Bool) {
    ideal_subset(contains_i, contains_j) and ideal_subset(contains_j, contains_k)
        implies ideal_subset(contains_i, contains_k)
}

theorem ideal_subset_antisymm[R: CommRing](contains_i: R -> Bool,
                                           contains_j: R -> Bool) {
    ideal_subset(contains_i, contains_j) and ideal_subset(contains_j, contains_i)
        implies contains_i = contains_j
}

theorem ideal_eq_iff_subset_both[R: CommRing](contains_i: R -> Bool,
                                              contains_j: R -> Bool) {
    contains_i = contains_j = (ideal_subset(contains_i, contains_j) and ideal_subset(contains_j, contains_i))
}

theorem principal_ideal_subset_of_contains_generator[R: CommRing](a: R, contains: R -> Bool) {
    is_ideal(contains) and contains(a) implies
        ideal_subset(principal_ideal[R](a), contains)
}

theorem zero_ideal_subset[R: CommRing](contains: R -> Bool) {
    is_ideal(contains) implies ideal_subset(zero_ideal[R], contains)
}

theorem subset_unit_ideal[R: CommRing](contains: R -> Bool) {
    ideal_subset(contains, unit_ideal[R])
}

define ideal_inter[R: CommRing](contains_i: R -> Bool,
                                contains_j: R -> Bool,
                                x: R) -> Bool {
    contains_i(x) and contains_j(x)
}

theorem ideal_inter_zero_constraint[R: CommRing](contains_i: R -> Bool,
                                                 contains_j: R -> Bool) {
    is_ideal(contains_i) and is_ideal(contains_j)
        implies ideal_zero_constraint(ideal_inter[R](contains_i, contains_j))
}

theorem ideal_inter_add_constraint[R: CommRing](contains_i: R -> Bool,
                                                contains_j: R -> Bool) {
    is_ideal(contains_i) and is_ideal(contains_j)
        implies ideal_add_constraint(ideal_inter[R](contains_i, contains_j))
}

theorem ideal_inter_absorb_constraint[R: CommRing](contains_i: R -> Bool,
                                                   contains_j: R -> Bool) {
    is_ideal(contains_i) and is_ideal(contains_j)
        implies ideal_absorb_constraint(ideal_inter[R](contains_i, contains_j))
}

theorem ideal_inter_is_ideal[R: CommRing](contains_i: R -> Bool,
                                          contains_j: R -> Bool) {
    is_ideal(contains_i) and is_ideal(contains_j)
        implies is_ideal(ideal_inter[R](contains_i, contains_j))
}

theorem ideal_inter_subset_left[R: CommRing](contains_i: R -> Bool,
                                             contains_j: R -> Bool) {
    ideal_subset(ideal_inter[R](contains_i, contains_j), contains_i)
}

theorem ideal_inter_subset_right[R: CommRing](contains_i: R -> Bool,
                                              contains_j: R -> Bool) {
    ideal_subset(ideal_inter[R](contains_i, contains_j), contains_j)
}

theorem ideal_inter_glb[R: CommRing](contains_i: R -> Bool,
                                     contains_j: R -> Bool,
                                     contains_k: R -> Bool) {
    ideal_subset(contains_k, contains_i) and ideal_subset(contains_k, contains_j)
        implies ideal_subset(contains_k, ideal_inter[R](contains_i, contains_j))
}

theorem ideal_subset_inter_iff[R: CommRing](contains_k: R -> Bool,
                                           contains_i: R -> Bool,
                                           contains_j: R -> Bool) {
    ideal_subset(contains_k, ideal_inter[R](contains_i, contains_j)) =
        (ideal_subset(contains_k, contains_i) and ideal_subset(contains_k, contains_j))
}

theorem ideal_inter_comm[R: CommRing](contains_i: R -> Bool,
                                      contains_j: R -> Bool) {
    ideal_inter[R](contains_i, contains_j) = ideal_inter[R](contains_j, contains_i)
}

theorem ideal_inter_assoc[R: CommRing](contains_i: R -> Bool,
                                       contains_j: R -> Bool,
                                       contains_k: R -> Bool) {
    ideal_inter[R](contains_i, ideal_inter[R](contains_j, contains_k)) =
        ideal_inter[R](ideal_inter[R](contains_i, contains_j), contains_k)
}

theorem ideal_inter_idempotent[R: CommRing](contains: R -> Bool) {
    ideal_inter[R](contains, contains) = contains
}

theorem ideal_inter_eq_left_of_subset[R: CommRing](contains_i: R -> Bool,
                                                   contains_j: R -> Bool) {
    ideal_subset(contains_i, contains_j) implies ideal_inter[R](contains_i, contains_j) = contains_i
}

theorem ideal_inter_eq_right_of_subset[R: CommRing](contains_i: R -> Bool,
                                                    contains_j: R -> Bool) {
    ideal_subset(contains_j, contains_i) implies ideal_inter[R](contains_i, contains_j) = contains_j
}

theorem zero_ideal_inter_left[R: CommRing](contains: R -> Bool) {
    is_ideal(contains) implies ideal_inter[R](zero_ideal[R], contains) = zero_ideal[R]
}

theorem zero_ideal_inter_right[R: CommRing](contains: R -> Bool) {
    is_ideal(contains) implies ideal_inter[R](contains, zero_ideal[R]) = zero_ideal[R]
}

theorem unit_ideal_inter_left[R: CommRing](contains: R -> Bool) {
    ideal_inter[R](unit_ideal[R], contains) = contains
}

theorem unit_ideal_inter_right[R: CommRing](contains: R -> Bool) {
    ideal_inter[R](contains, unit_ideal[R]) = contains
}

define ideal_sum[R: CommRing](contains_i: R -> Bool,
                              contains_j: R -> Bool,
                              x: R) -> Bool {
    exists(a: R, b: R) {
        contains_i(a) and contains_j(b) and x = a + b
    }
}

theorem ideal_sum_zero_constraint[R: CommRing](contains_i: R -> Bool,
                                               contains_j: R -> Bool) {
    is_ideal(contains_i) and is_ideal(contains_j)
        implies ideal_zero_constraint(ideal_sum[R](contains_i, contains_j))
}

theorem ideal_sum_add_constraint[R: CommRing](contains_i: R -> Bool,
                                              contains_j: R -> Bool) {
    is_ideal(contains_i) and is_ideal(contains_j)
        implies ideal_add_constraint(ideal_sum[R](contains_i, contains_j))
}

theorem ideal_sum_absorb_constraint[R: CommRing](contains_i: R -> Bool,
                                                 contains_j: R -> Bool) {
    is_ideal(contains_i) and is_ideal(contains_j)
        implies ideal_absorb_constraint(ideal_sum[R](contains_i, contains_j))
}

theorem ideal_sum_is_ideal[R: CommRing](contains_i: R -> Bool,
                                        contains_j: R -> Bool) {
    is_ideal(contains_i) and is_ideal(contains_j)
        implies is_ideal(ideal_sum[R](contains_i, contains_j))
}

theorem ideal_sum_subset_left[R: CommRing](contains_i: R -> Bool,
                                           contains_j: R -> Bool) {
    is_ideal(contains_j) implies ideal_subset(contains_i, ideal_sum[R](contains_i, contains_j))
}

theorem ideal_sum_subset_right[R: CommRing](contains_i: R -> Bool,
                                            contains_j: R -> Bool) {
    is_ideal(contains_i) implies ideal_subset(contains_j, ideal_sum[R](contains_i, contains_j))
}

theorem ideal_sum_lub[R: CommRing](contains_i: R -> Bool,
                                   contains_j: R -> Bool,
                                   contains_k: R -> Bool) {
    is_ideal(contains_k) and ideal_subset(contains_i, contains_k) and ideal_subset(contains_j, contains_k)
        implies ideal_subset(ideal_sum[R](contains_i, contains_j), contains_k)
}

theorem ideal_sum_subset_iff[R: CommRing](contains_i: R -> Bool,
                                          contains_j: R -> Bool,
                                          contains_k: R -> Bool) {
    is_ideal(contains_i) and is_ideal(contains_j) and is_ideal(contains_k)
        implies
    (ideal_subset(ideal_sum[R](contains_i, contains_j), contains_k) =
        (ideal_subset(contains_i, contains_k) and ideal_subset(contains_j, contains_k)))
}

theorem ideal_sum_comm[R: CommRing](contains_i: R -> Bool,
                                    contains_j: R -> Bool) {
    ideal_sum[R](contains_i, contains_j) = ideal_sum[R](contains_j, contains_i)
}

theorem ideal_sum_assoc[R: CommRing](contains_i: R -> Bool,
                                     contains_j: R -> Bool,
                                     contains_k: R -> Bool) {
    ideal_sum[R](contains_i, ideal_sum[R](contains_j, contains_k)) =
        ideal_sum[R](ideal_sum[R](contains_i, contains_j), contains_k)
}

theorem ideal_sum_idempotent[R: CommRing](contains: R -> Bool) {
    is_ideal(contains) implies ideal_sum[R](contains, contains) = contains
}

theorem ideal_sum_eq_left_of_subset[R: CommRing](contains_i: R -> Bool,
                                                 contains_j: R -> Bool) {
    is_ideal(contains_i) and is_ideal(contains_j) and ideal_subset(contains_j, contains_i)
        implies ideal_sum[R](contains_i, contains_j) = contains_i
}

theorem ideal_sum_eq_right_of_subset[R: CommRing](contains_i: R -> Bool,
                                                  contains_j: R -> Bool) {
    is_ideal(contains_i) and is_ideal(contains_j) and ideal_subset(contains_i, contains_j)
        implies ideal_sum[R](contains_i, contains_j) = contains_j
}

theorem zero_ideal_sum_left[R: CommRing](contains: R -> Bool) {
    is_ideal(contains) implies ideal_sum[R](zero_ideal[R], contains) = contains
}

theorem zero_ideal_sum_right[R: CommRing](contains: R -> Bool) {
    is_ideal(contains) implies ideal_sum[R](contains, zero_ideal[R]) = contains
}

theorem unit_ideal_sum_left[R: CommRing](contains: R -> Bool) {
    is_ideal(contains) implies ideal_sum[R](unit_ideal[R], contains) = unit_ideal[R]
}

theorem unit_ideal_sum_right[R: CommRing](contains: R -> Bool) {
    is_ideal(contains) implies ideal_sum[R](contains, unit_ideal[R]) = unit_ideal[R]
}

structure Ideal[R: CommRing] {
    /// True if the given element is a member of this ideal.
    contains: R -> Bool
} constraint {
    is_ideal(contains)
}

theorem ideal_ext[R: CommRing](a: Ideal[R], b: Ideal[R]) {
    (forall(x: R) { a.contains(x) = b.contains(x) }) implies a = b
}

theorem ideal_eq_contains[R: CommRing](a: Ideal[R], b: Ideal[R]) {
    a = b implies a.contains = b.contains
}

theorem ideal_eq_contains_at[R: CommRing](a: Ideal[R], b: Ideal[R], x: R) {
    a = b implies a.contains(x) = b.contains(x)
}

theorem ideal_eq_of_contains_eq[R: CommRing](a: Ideal[R], b: Ideal[R]) {
    a.contains = b.contains implies a = b
}

theorem ideal_eq_of_contains_at_eq[R: CommRing](a: Ideal[R], b: Ideal[R]) {
    (forall(x: R) { a.contains(x) = b.contains(x) }) implies a = b
}

theorem ideal_contains_zero[R: CommRing](i: Ideal[R]) {
    i.contains(R.0)
}

theorem ideal_contains_add[R: CommRing](i: Ideal[R], a: R, b: R) {
    i.contains(a) and i.contains(b) implies i.contains(a + b)
}

theorem ideal_contains_mul_left[R: CommRing](i: Ideal[R], r: R, a: R) {
    i.contains(a) implies i.contains(r * a)
}

theorem ideal_contains_mul_right[R: CommRing](i: Ideal[R], a: R, r: R) {
    i.contains(a) implies i.contains(a * r)
}

theorem ideal_contains_neg[R: CommRing](i: Ideal[R], a: R) {
    i.contains(a) implies i.contains(-a)
}

let bundled_zero_ideal[R: CommRing]: Ideal[R] satisfy {
    Ideal.new(zero_ideal[R]) = Option.some(bundled_zero_ideal)
}

let bundled_unit_ideal[R: CommRing]: Ideal[R] satisfy {
    Ideal.new(unit_ideal[R]) = Option.some(bundled_unit_ideal)
}

let bundled_principal_ideal[R: CommRing](a: R) -> result: Ideal[R] satisfy {
    Ideal.new(principal_ideal[R](a)) = Option.some(result)
}

attributes Ideal[R: CommRing] {
    /// Ideal extensionality from pointwise equality of membership.
    let ext = ideal_ext[R]

    /// The subset of ring elements belonging to this ideal.
    define as_set(self) -> Set[R] {
        Set[R].new(self.contains)
    }

    /// The zero ideal.
    let zero = bundled_zero_ideal[R]

    /// The unit ideal.
    let unit = bundled_unit_ideal[R]

    /// The principal ideal generated by an element.
    let principal: R -> Ideal[R] = bundled_principal_ideal
}

theorem ideal_as_set_contains_eq[R: CommRing](i: Ideal[R], x: R) {
    i.as_set.contains(x) = i.contains(x)
}

theorem ideal_contains_as_set_eq[R: CommRing](i: Ideal[R], x: R) {
    i.contains(x) = i.as_set.contains(x)
}

theorem ideal_eq_as_set[R: CommRing](a: Ideal[R], b: Ideal[R]) {
    a = b implies a.as_set = b.as_set
}

theorem bundled_zero_ideal_contains_eq[R: CommRing](x: R) {
    Ideal[R].zero.contains(x) = (x = R.0)
}

theorem bundled_zero_ideal_only_has_zero[R: CommRing](x: R) {
    Ideal[R].zero.contains(x) implies x = R.0
}

theorem bundled_unit_ideal_contains_everything[R: CommRing](x: R) {
    Ideal[R].unit.contains(x)
}

theorem bundled_unit_ideal_contains_eq[R: CommRing](x: R) {
    Ideal[R].unit.contains(x) = true
}

theorem bundled_ideal_eq_unit_of_contains_one[R: CommRing](i: Ideal[R]) {
    i.contains(R.1) implies i = Ideal[R].unit
}

theorem bundled_ideal_contains_one_iff_eq_unit[R: CommRing](i: Ideal[R]) {
    i.contains(R.1) = (i = Ideal[R].unit)
}

theorem bundled_principal_ideal_contains_eq[R: CommRing](a: R, x: R) {
    Ideal[R].principal(a).contains(x) = principal_ideal(a, x)
}

theorem bundled_principal_ideal_contains_generator[R: CommRing](a: R) {
    Ideal[R].principal(a).contains(a)
}

theorem bundled_principal_ideal_zero_eq_zero[R: CommRing] {
    Ideal[R].principal(R.0) = Ideal[R].zero
}

theorem bundled_principal_ideal_one_eq_unit[R: CommRing] {
    Ideal[R].principal(R.1) = Ideal[R].unit
}

theorem bundled_principal_ideal_contains_multiple[R: CommRing](a: R, r: R) {
    Ideal[R].principal(a).contains(r * a)
}

theorem bundled_principal_ideal_witness[R: CommRing](a: R, x: R) {
    Ideal[R].principal(a).contains(x) implies exists(r: R) { x = r * a }
}

define bundled_ideal_subset[R: CommRing](a: Ideal[R], b: Ideal[R]) -> Bool {
    forall(x: R) {
        a.contains(x) implies b.contains(x)
    }
}

theorem bundled_ideal_subset_eq[R: CommRing](a: Ideal[R], b: Ideal[R]) {
    bundled_ideal_subset(a, b) = ideal_subset(a.contains, b.contains)
}

theorem bundled_ideal_subset_as_set_eq[R: CommRing](a: Ideal[R], b: Ideal[R]) {
    bundled_ideal_subset(a, b) = a.as_set.subset(b.as_set)
}

theorem bundled_ideal_subset_refl[R: CommRing](a: Ideal[R]) {
    bundled_ideal_subset(a, a)
}

theorem bundled_ideal_subset_trans[R: CommRing](a: Ideal[R], b: Ideal[R], c: Ideal[R]) {
    bundled_ideal_subset(a, b) and bundled_ideal_subset(b, c) implies bundled_ideal_subset(a, c)
}

theorem bundled_ideal_subset_antisymm[R: CommRing](a: Ideal[R], b: Ideal[R]) {
    bundled_ideal_subset(a, b) and bundled_ideal_subset(b, a) implies a = b
}

theorem bundled_ideal_eq_iff_subset_both[R: CommRing](a: Ideal[R], b: Ideal[R]) {
    a = b = (bundled_ideal_subset(a, b) and bundled_ideal_subset(b, a))
}

theorem bundled_zero_ideal_subset[R: CommRing](i: Ideal[R]) {
    bundled_ideal_subset(Ideal[R].zero, i)
}

theorem bundled_ideal_subset_unit[R: CommRing](i: Ideal[R]) {
    bundled_ideal_subset(i, Ideal[R].unit)
}

theorem bundled_principal_ideal_subset_of_contains_generator[R: CommRing](a: R, b: Ideal[R]) {
    b.contains(a) implies bundled_ideal_subset(Ideal[R].principal(a), b)
}

theorem bundled_principal_ideal_subset_iff_contains_generator[R: CommRing](a: R, b: Ideal[R]) {
    bundled_ideal_subset(Ideal[R].principal(a), b) = b.contains(a)
}

define bundled_ideal_inter_contains[R: CommRing](a: Ideal[R], b: Ideal[R], x: R) -> Bool {
    a.contains(x) and b.contains(x)
}

theorem bundled_ideal_inter_is_ideal[R: CommRing](a: Ideal[R], b: Ideal[R]) {
    is_ideal(bundled_ideal_inter_contains(a, b))
}

let bundled_ideal_inter[R: CommRing](a: Ideal[R], b: Ideal[R]) -> result: Ideal[R] satisfy {
    Ideal.new(bundled_ideal_inter_contains(a, b)) = Option.some(result)
}

define bundled_ideal_sum_contains[R: CommRing](a: Ideal[R], b: Ideal[R], x: R) -> Bool {
    exists(y: R, z: R) {
        a.contains(y) and b.contains(z) and x = y + z
    }
}

theorem bundled_ideal_sum_is_ideal[R: CommRing](a: Ideal[R], b: Ideal[R]) {
    is_ideal(bundled_ideal_sum_contains(a, b))
}

let bundled_ideal_sum[R: CommRing](a: Ideal[R], b: Ideal[R]) -> result: Ideal[R] satisfy {
    Ideal.new(bundled_ideal_sum_contains(a, b)) = Option.some(result)
}

attributes Ideal[R: CommRing] {
    /// The common part of two ideals.
    let intersection: (Ideal[R], Ideal[R]) -> Ideal[R] = bundled_ideal_inter

    /// The least ideal containing two ideals.
    let sum: (Ideal[R], Ideal[R]) -> Ideal[R] = bundled_ideal_sum
}

theorem bundled_ideal_inter_contains_eq[R: CommRing](a: Ideal[R], b: Ideal[R], x: R) {
    a.intersection(b).contains(x) = (a.contains(x) and b.contains(x))
}

theorem bundled_ideal_inter_subset_left[R: CommRing](a: Ideal[R], b: Ideal[R]) {
    bundled_ideal_subset(a.intersection(b), a)
}

