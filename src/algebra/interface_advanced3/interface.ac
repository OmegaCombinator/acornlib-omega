theorem maximal_ideal_witness[R: CommRing](m: MaximalIdeal[R], other: R -> Bool) {
    is_ideal(other) and ideal_subset(m.contains, other) and ideal_proper_constraint(other)
        implies ideal_subset(other, m.contains)
