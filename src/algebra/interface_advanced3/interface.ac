    add_group_hom_kernel_quotient_add(f,
        add_group_hom_kernel_quotient_add(f,
            quotient_over_mk(kernel_quotient_relation(f.hom), a),
            quotient_over_mk(kernel_quotient_relation(f.hom), b)),
