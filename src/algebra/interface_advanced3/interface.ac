theorem add_group_hom_kernel_quotient_add_sub_cancel_left[A: AddGroup, B: AddGroup](
    f: AddGroupHom[A, B], a: A, b: A
) {
    add_group_hom_kernel_quotient_sub(f,
        add_group_hom_kernel_quotient_add(f,
