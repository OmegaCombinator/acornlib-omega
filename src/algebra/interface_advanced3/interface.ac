    add_group_hom_kernel_quotient_sub(f,
        quotient_over_mk(kernel_quotient_relation(f.hom), A.0),
        quotient_over_mk(kernel_quotient_relation(f.hom), a)) =
        add_group_hom_kernel_quotient_neg(f,
            quotient_over_mk(kernel_quotient_relation(f.hom), a))
