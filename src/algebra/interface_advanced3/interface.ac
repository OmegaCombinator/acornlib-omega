theorem ideal_closure_absorb_constraint[R: CommRing](a: Set[R]) {
    ideal_absorb_constraint(ideal_closure_contains(a))
}

theorem ideal_closure_is_ideal[R: CommRing](a: Set[R]) {
    is_ideal(ideal_closure_contains(a))
