theorem linear_map_kernel_quotient_image_eq_iff_project_eq[R: Ring, M: AddCommGroup, N: AddCommGroup](
    src: Module[R, M], dst: Module[R, N], f: M -> N, a: M, b: M
) {
    (f(a) = f(b)) =
        (linear_map_kernel_quotient_project(src, dst, f, a) =
            linear_map_kernel_quotient_project(src, dst, f, b))
}

theorem group_hom_kernel_quotient_project_eq_one_iff_image_eq_one[G: Group, H: Group](
    f: GroupHom[G, H], a: G
) {
    (group_hom_kernel_quotient_project(f, a) = group_hom_kernel_quotient_one(f)) =
        (f.hom(a) = H.1)
}

theorem monoid_hom_kernel_quotient_project_eq_one_iff_image_eq_one[M: Monoid, N: Monoid](
    f: MonoidHom[M, N], a: M
) {
    (monoid_hom_kernel_quotient_project(f, a) = monoid_hom_kernel_quotient_one(f)) =
        (f.hom(a) = N.1)
}

theorem add_group_hom_kernel_quotient_project_eq_zero_iff_image_eq_zero[A: AddGroup, B: AddGroup](
    f: AddGroupHom[A, B], a: A
) {
    (add_group_hom_kernel_quotient_project(f, a) = add_group_hom_kernel_quotient_zero(f)) =
        (f.hom(a) = B.0)
}

theorem add_monoid_hom_kernel_quotient_project_eq_zero_iff_image_eq_zero[A: AddMonoid, B: AddMonoid](
    f: AddMonoidHom[A, B], a: A
) {
    (add_monoid_hom_kernel_quotient_project(f, a) = add_monoid_hom_kernel_quotient_zero(f)) =
        (f.hom(a) = B.0)
}

theorem semiring_hom_kernel_quotient_project_eq_zero_iff_image_eq_zero[S: Semiring, T: Semiring](
    f: SemiringHom[S, T], a: S
) {
    (semiring_hom_kernel_quotient_project(f, a) = semiring_hom_kernel_quotient_zero(f)) =
        (f.hom(a) = T.0)
}

theorem ring_hom_kernel_quotient_project_eq_zero_iff_image_eq_zero[R: Ring, S: Ring](
    f: RingHom[R, S], a: R
) {
    (ring_hom_kernel_quotient_project(f, a) = ring_hom_kernel_quotient_zero(f)) =
        (f.hom(a) = S.0)
}

theorem group_hom_kernel_quotient_project_eq_iff_inv_mul_one[G: Group, H: Group](
    f: GroupHom[G, H], a: G, b: G
) {
    (group_hom_kernel_quotient_project(f, a) = group_hom_kernel_quotient_project(f, b)) =
        (f.hom(a.inverse * b) = H.1)
}

theorem add_group_hom_kernel_quotient_project_eq_iff_sub_zero[A: AddGroup, B: AddGroup](
    f: AddGroupHom[A, B], a: A, b: A
) {
    (add_group_hom_kernel_quotient_project(f, a) = add_group_hom_kernel_quotient_project(f, b)) =
        (f.hom(b - a) = B.0)
}

theorem ring_hom_kernel_quotient_project_eq_iff_sub_zero[R: Ring, S: Ring](
    f: RingHom[R, S], a: R, b: R
) {
    (ring_hom_kernel_quotient_project(f, a) = ring_hom_kernel_quotient_project(f, b)) =
        (f.hom(b - a) = S.0)
}

theorem linear_map_kernel_quotient_project_eq_iff_kernel_relation_fiso[R: Ring, M: AddCommGroup, N: AddCommGroup](
    src: Module[R, M], dst: Module[R, N], f: M -> N, a: M, b: M
) {
    (linear_map_kernel_quotient_project(src, dst, f, a) =
        linear_map_kernel_quotient_project(src, dst, f, b)) =
        kernel_relation(f, a, b)
}

theorem semiring_hom_kernel_quotient_induced_eq_iff_kernel_relation[S: Semiring, T: Semiring](
    f: SemiringHom[S, T], a: S, b: S
) {
    (semiring_hom_kernel_quotient_induced(f, semiring_hom_kernel_quotient_project(f, a)) =
        semiring_hom_kernel_quotient_induced(f, semiring_hom_kernel_quotient_project(f, b))) =
        kernel_relation(f.hom, a, b)
}

theorem ring_hom_kernel_quotient_induced_eq_iff_kernel_relation[R: Ring, S: Ring](
    f: RingHom[R, S], a: R, b: R
) {
    (ring_hom_kernel_quotient_induced(f, ring_hom_kernel_quotient_project(f, a)) =
        ring_hom_kernel_quotient_induced(f, ring_hom_kernel_quotient_project(f, b))) =
        kernel_relation(f.hom, a, b)
}

theorem group_hom_kernel_quotient_induced_eq_iff_kernel_relation[G: Group, H: Group](
    f: GroupHom[G, H], a: G, b: G
) {
    (group_hom_kernel_quotient_induced(f, group_hom_kernel_quotient_project(f, a)) =
        group_hom_kernel_quotient_induced(f, group_hom_kernel_quotient_project(f, b))) =
        kernel_relation(f.hom, a, b)
}

theorem monoid_hom_kernel_quotient_induced_eq_iff_kernel_relation[M: Monoid, N: Monoid](
    f: MonoidHom[M, N], a: M, b: M
) {
    (monoid_hom_kernel_quotient_induced(f, monoid_hom_kernel_quotient_project(f, a)) =
        monoid_hom_kernel_quotient_induced(f, monoid_hom_kernel_quotient_project(f, b))) =
        kernel_relation(f.hom, a, b)
}

theorem add_monoid_hom_kernel_quotient_induced_eq_iff_kernel_relation[A: AddMonoid, B: AddMonoid](
    f: AddMonoidHom[A, B], a: A, b: A
) {
    (add_monoid_hom_kernel_quotient_induced(f, add_monoid_hom_kernel_quotient_project(f, a)) =
        add_monoid_hom_kernel_quotient_induced(f, add_monoid_hom_kernel_quotient_project(f, b))) =
        kernel_relation(f.hom, a, b)
}

theorem add_group_hom_kernel_quotient_induced_eq_iff_kernel_relation[A: AddGroup, B: AddGroup](
    f: AddGroupHom[A, B], a: A, b: A
) {
    (add_group_hom_kernel_quotient_induced(f, add_group_hom_kernel_quotient_project(f, a)) =
        add_group_hom_kernel_quotient_induced(f, add_group_hom_kernel_quotient_project(f, b))) =
        kernel_relation(f.hom, a, b)
}

theorem linear_map_kernel_quotient_induced_eq_iff_kernel_relation[R: Ring, M: AddCommGroup, N: AddCommGroup](
    src: Module[R, M], dst: Module[R, N], f: M -> N, a: M, b: M
) {
    (linear_map_kernel_quotient_induced(src, dst, f, linear_map_kernel_quotient_project(src, dst, f, a)) =
        linear_map_kernel_quotient_induced(src, dst, f, linear_map_kernel_quotient_project(src, dst, f, b))) =
        kernel_relation(f, a, b)
}

theorem first_iso_group_induced_injective[G: Group, H: Group](
    f: GroupHom[G, H], a: G, b: G
) {
    group_hom_kernel_quotient_induced(f, group_hom_kernel_quotient_project(f, a)) =
        group_hom_kernel_quotient_induced(f, group_hom_kernel_quotient_project(f, b))
    implies group_hom_kernel_quotient_project(f, a) = group_hom_kernel_quotient_project(f, b)
}

theorem first_iso_group_induced_onto_image[G: Group, H: Group](f: GroupHom[G, H], a: G) {
    exists(q: QuotientOver[G]) {
        group_hom_kernel_quotient_induced(f, q) = f.hom(a)
    }
}

theorem first_iso_group_project_eq_iff_image_eq[G: Group, H: Group](f: GroupHom[G, H], a: G, b: G) {
    (group_hom_kernel_quotient_project(f, a) = group_hom_kernel_quotient_project(f, b)) =
        (f.hom(a) = f.hom(b))
}

define commutator_element[G: Group](g: G, h: G) -> G {
    g * h * g.inverse * h.inverse
}

theorem commutator_element_def[G: Group](g: G, h: G) {
    commutator_element(g, h) = g * h * g.inverse * h.inverse
}

define left_coset_contains[G: Group](s: Subgroup[G], a: G, x: G) -> Bool {
    s.contains(a.inverse * x)
}

theorem left_coset_contains_self[G: Group](s: Subgroup[G], a: G) {
    left_coset_contains(s, a, a)
}

theorem left_coset_contains_of_mem[G: Group](s: Subgroup[G], a: G, t: G) {
    s.contains(t) implies left_coset_contains(s, a, a * t)
}

theorem left_coset_contains_iff[G: Group](s: Subgroup[G], a: G, x: G) {
    left_coset_contains(s, a, x) = exists(t: G) {
        s.contains(t) and x = a * t
    }
}

theorem left_coset_contains_right_mul[G: Group](s: Subgroup[G], a: G, x: G, t: G) {
    left_coset_contains(s, a, x) and s.contains(t) implies left_coset_contains(s, a, x * t)
}

theorem left_coset_eq_of_rep[G: Group](s: Subgroup[G], a: G, b: G, x: G) {
    s.contains(a.inverse * b) implies (left_coset_contains(s, a, x) = left_coset_contains(s, b, x))
}

theorem left_coset_intersection_eq[G: Group](s: Subgroup[G], a: G, b: G) {
    exists(x: G) {
        left_coset_contains(s, a, x) and left_coset_contains(s, b, x)
    } implies forall(y: G) {
        left_coset_contains(s, a, y) = left_coset_contains(s, b, y)
    }
}

define right_coset_contains[G: Group](s: Subgroup[G], a: G, x: G) -> Bool {
    s.contains(x * a.inverse)
}

theorem right_coset_contains_self[G: Group](s: Subgroup[G], a: G) {
    right_coset_contains(s, a, a)
}

theorem right_coset_contains_of_mem[G: Group](s: Subgroup[G], a: G, t: G) {
    s.contains(t) implies right_coset_contains(s, a, t * a)
}

theorem right_coset_contains_left_mul[G: Group](s: Subgroup[G], a: G, x: G, t: G) {
    right_coset_contains(s, a, x) and s.contains(t) implies right_coset_contains(s, a, t * x)
}

theorem group_hom_eq_iff_same_kernel_coset[G: Group, H: Group](f: GroupHom[G, H], a: G, b: G) {
    (f.hom(a) = f.hom(b)) = left_coset_contains(group_hom_kernel(f), a, b)
}

theorem subgroup_inv_mul_mem_iff[G: Group](s: Subgroup[G], a: G, b: G) {
    s.contains(a) implies (s.contains(a.inverse * b) = s.contains(b))
}

theorem left_coset_contains_mem[G: Group](s: Subgroup[G], a: G, x: G) {
    s.contains(x) implies left_coset_contains(s, x, a) = s.contains(a)
}

structure Embedding[A, B] {
    /// The underlying function.
    to_fun: A -> B
} constraint {
    is_injective_fn(to_fun)
}

theorem mul_left_injective[G: Group](g: G) {
    is_injective_fn(function(h: G) { g * h })
}

theorem mul_right_injective[G: Group](g: G) {
    is_injective_fn(function(h: G) { h * g })
}

let mulLeftEmbedding[G: Group](g: G) -> result: Embedding[G, G] satisfy {
    Embedding[G, G].new(function(h: G) { g * h }) = Option.some(result)
}

let mulRightEmbedding[G: Group](g: G) -> result: Embedding[G, G] satisfy {
    Embedding[G, G].new(function(h: G) { h * g }) = Option.some(result)
}

theorem group_hom_eq_of_mul_inverse_maps_one[G: Group, H: Group](
    f: GroupHom[G, H], a: G, b: G
) {
    f.hom(a * b.inverse) = H.1 implies f.hom(a) = f.hom(b)
}

define subgroup_maps_to_one_raw[G: Group, H: Group](phi: G -> H, n: Subgroup[G]) -> Bool {
    forall(a: G) {
        n.contains(a) implies phi(a) = H.1
    }
}

theorem subgroup_maps_to_one_raw_at[G: Group, H: Group](phi: G -> H, n: Subgroup[G], a: G) {
    subgroup_maps_to_one_raw(phi, n) and n.contains(a) implies phi(a) = H.1
}

define normal_subgroup_maps_to_one[G: Group, H: Group](
    f: GroupHom[G, H], n: Subgroup[G]
) -> Bool {
    subgroup_maps_to_one_raw(f.hom, n)
}

theorem normal_subgroup_maps_to_one_at[G: Group, H: Group](
    f: GroupHom[G, H], n: Subgroup[G], a: G
) {
    normal_subgroup_maps_to_one(f, n) and n.contains(a) implies f.hom(a) = H.1
}

theorem normal_subgroup_maps_to_one_rel_invariant[G: Group, H: Group](
    f: GroupHom[G, H], n: Subgroup[G], a: G, b: G
) {
    normal_subgroup_maps_to_one(f, n) and normal_subgroup_rel(n, a, b) implies
    f.hom(a) = f.hom(b)
}

define normal_subgroup_quotient_lift[G: Group, H: Group](
    n: Subgroup[G], f: GroupHom[G, H]
) -> QuotientOver[G] -> H {
    quotient_over_lift_to(f.hom)
}

theorem normal_subgroup_quotient_lift_project[G: Group, H: Group](
    f: GroupHom[G, H], n: Subgroup[G], a: G
) {
    normal_subgroup_maps_to_one(f, n) implies
    normal_subgroup_quotient_lift(n, f, normal_subgroup_quotient_project(n, a)) = f.hom(a)
}

theorem normal_subgroup_quotient_lift_mul_project[G: Group, H: Group](
    f: GroupHom[G, H], n: Subgroup[G], a: G, b: G
) {
    is_normal_subgroup(n) and normal_subgroup_maps_to_one(f, n) implies
    normal_subgroup_quotient_lift(n, f,
        normal_subgroup_quotient_mul(n,
            normal_subgroup_quotient_project(n, a),
            normal_subgroup_quotient_project(n, b))) = f.hom(a) * f.hom(b)
}

theorem normal_subgroup_quotient_lift_mul_project_hom[G: Group, H: Group](
    f: GroupHom[G, H], n: Subgroup[G], a: G, b: G
) {
    is_normal_subgroup(n) and normal_subgroup_maps_to_one(f, n) implies
    normal_subgroup_quotient_lift(n, f,
        normal_subgroup_quotient_mul(n,
            normal_subgroup_quotient_project(n, a),
            normal_subgroup_quotient_project(n, b))) =
        normal_subgroup_quotient_lift(n, f, normal_subgroup_quotient_project(n, a)) *
        normal_subgroup_quotient_lift(n, f, normal_subgroup_quotient_project(n, b))
}

theorem normal_subgroup_quotient_lift_one[G: Group, H: Group](
    f: GroupHom[G, H], n: Subgroup[G]
) {
    normal_subgroup_maps_to_one(f, n) implies
    normal_subgroup_quotient_lift(n, f, normal_subgroup_quotient_one(n)) = H.1
}

theorem normal_subgroup_quotient_lift_inverse_project[G: Group, H: Group](
    f: GroupHom[G, H], n: Subgroup[G], a: G
) {
    is_normal_subgroup(n) and normal_subgroup_maps_to_one(f, n) implies
    normal_subgroup_quotient_lift(n, f,
        normal_subgroup_quotient_inverse(n, normal_subgroup_quotient_project(n, a))) =
        f.hom(a).inverse
}

theorem normal_subgroup_quotient_lift_inverse_project_hom[G: Group, H: Group](
    f: GroupHom[G, H], n: Subgroup[G], a: G
) {
    is_normal_subgroup(n) and normal_subgroup_maps_to_one(f, n) implies
    normal_subgroup_quotient_lift(n, f,
        normal_subgroup_quotient_inverse(n, normal_subgroup_quotient_project(n, a))) =
        normal_subgroup_quotient_lift(n, f, normal_subgroup_quotient_project(n, a)).inverse
}

theorem group_hom_kernel_is_normal_subgroup[G: Group, H: Group](f: GroupHom[G, H]) {
    is_normal_subgroup(group_hom_kernel(f))
}

theorem normal_subgroup_maps_to_one_iff_subgroup_subset_group_hom_kernel[G: Group, H: Group](
    f: GroupHom[G, H], n: Subgroup[G]
) {
    normal_subgroup_maps_to_one(f, n) = subgroup_subset(n, group_hom_kernel(f))
}

theorem group_hom_kernel_eq_identity_subgroup_iff_trivial_kernel[G: Group, H: Group](
    f: GroupHom[G, H]
) {
    (group_hom_kernel(f) = identity_subgroup[G]) = is_trivial_group_hom_kernel(f)
}

theorem group_hom_injective_iff_group_hom_kernel_eq_identity_subgroup[G: Group, H: Group](
    f: GroupHom[G, H]
) {
    is_injective_fn(f.hom) = (group_hom_kernel(f) = identity_subgroup[G])
}

theorem group_hom_pow_eq_one_of_pow_eq_one[G: Group, H: Group](f: GroupHom[G, H], a: G, n: Nat) {
    a.pow(n) = G.1 implies f.hom(a).pow(n) = H.1
}

theorem injective_group_hom_pow_eq_one_iff[G: Group, H: Group](f: GroupHom[G, H], a: G, n: Nat) {
    is_injective_fn(f.hom) implies
    (f.hom(a).pow(n) = H.1) = (a.pow(n) = G.1)
}

theorem injective_group_hom_preserves_finite_order[G: Group, H: Group](f: GroupHom[G, H], a: G) {
    is_injective_fn(f.hom) implies (has_finite_order(a) = has_finite_order(f.hom(a)))
}

theorem group_iso_preserves_finite_order[G: Group, H: Group](f: GroupHom[G, H], a: G) {
    is_bijection_fn(f.hom) implies (has_finite_order(a) = has_finite_order(f.hom(a)))
}

define group_hom_image[G: Group, H: Group](f: GroupHom[G, H], s: Set[G]) -> Set[H] {
    set_image(s, f.hom)
}

define group_hom_preimage[G: Group, H: Group](f: GroupHom[G, H], s: Set[H]) -> Set[G] {
    set_preimage(f.hom, s)
}

define group_hom_image_preimage_closure[G: Group, H: Group](
    f: GroupHom[G, H],
    s: Set[G]
) -> Set[G] {
    set_image_preimage_closure(f.hom, s)
}

define group_hom_preimage_image_kernel[G: Group, H: Group](
    f: GroupHom[G, H],
    s: Set[H]
) -> Set[H] {
    set_preimage_image_kernel(f.hom, s)
}

theorem group_hom_image_contains_witness[G: Group, H: Group](
    f: GroupHom[G, H],
    s: Set[G],
    y: H
) {
    group_hom_image(f, s).contains(y) implies exists(x: G) {
        s.contains(x) and y = f.hom(x)
    }
}

theorem group_hom_maps_into_image[G: Group, H: Group](
    f: GroupHom[G, H],
    s: Set[G],
    x: G
) {
    s.contains(x) implies group_hom_image(f, s).contains(f.hom(x))
}

theorem group_hom_image_subset_iff_subset_preimage[G: Group, H: Group](
    f: GroupHom[G, H],
    s: Set[G],
    t: Set[H]
) {
    group_hom_image(f, s).subset(t) = s.subset(group_hom_preimage(f, t))
}

theorem group_hom_image_compose[G: Group, H: Group, K: Group](
    f: GroupHom[H, K],
    g: GroupHom[G, H],
    s: Set[G]
) {
    group_hom_image(compose_group_hom(f, g), s) =
        group_hom_image(f, group_hom_image(g, s))
}

theorem group_hom_preimage_compose[G: Group, H: Group, K: Group](
    f: GroupHom[H, K],
    g: GroupHom[G, H],
    s: Set[K]
) {
    group_hom_preimage(compose_group_hom(f, g), s) =
        group_hom_preimage(g, group_hom_preimage(f, s))
}

theorem group_hom_image_preimage_closure_extensive[G: Group, H: Group](
    f: GroupHom[G, H],
    s: Set[G]
) {
    s.subset(group_hom_image_preimage_closure(f, s))
}

theorem group_hom_image_preimage_closure_monotone[G: Group, H: Group](
    f: GroupHom[G, H]
) {
    is_subset_monotone_map(group_hom_image_preimage_closure(f))
}

theorem group_hom_image_preimage_closure_idempotent[G: Group, H: Group](
    f: GroupHom[G, H],
    s: Set[G]
) {
    group_hom_image_preimage_closure(f, group_hom_image_preimage_closure(f, s)) =
        group_hom_image_preimage_closure(f, s)
}

theorem group_hom_image_preimage_closure_operator[G: Group, H: Group](
    f: GroupHom[G, H]
) {
    is_set_closure_operator(group_hom_image_preimage_closure(f))
}

theorem group_hom_preimage_image_kernel_reductive[G: Group, H: Group](
    f: GroupHom[G, H],
    s: Set[H]
) {
    group_hom_preimage_image_kernel(f, s).subset(s)
}

theorem group_hom_preimage_image_kernel_monotone[G: Group, H: Group](
    f: GroupHom[G, H]
) {
    is_subset_monotone_map(group_hom_preimage_image_kernel(f))
}

theorem group_hom_preimage_image_kernel_idempotent[G: Group, H: Group](
    f: GroupHom[G, H],
    s: Set[H]
) {
    group_hom_preimage_image_kernel(f, group_hom_preimage_image_kernel(f, s)) =
        group_hom_preimage_image_kernel(f, s)
}

theorem group_hom_preimage_image_kernel_operator[G: Group, H: Group](
    f: GroupHom[G, H]
) {
    is_set_kernel_operator(group_hom_preimage_image_kernel(f))
}

define subgroup_image_contains[G: Group, H: Group](
    f: GroupHom[G, H],
    s: Subgroup[G],
    y: H
) -> Bool {
    exists(x: G) {
        s.contains(x) and f.hom(x) = y
    }
}

theorem subgroup_image_identity_constraint[G: Group, H: Group](
    f: GroupHom[G, H],
    s: Subgroup[G]
) {
    identity_constraint(subgroup_image_contains(f, s))
}

theorem subgroup_image_closure_constraint[G: Group, H: Group](
    f: GroupHom[G, H],
    s: Subgroup[G]
) {
    closure_constraint(subgroup_image_contains(f, s))
}

theorem subgroup_image_inverse_constraint[G: Group, H: Group](
    f: GroupHom[G, H],
    s: Subgroup[G]
) {
    inverse_constraint(subgroup_image_contains(f, s))
}

theorem subgroup_image_constraint[G: Group, H: Group](
    f: GroupHom[G, H],
    s: Subgroup[G]
) {
    subgroup_constraint(subgroup_image_contains(f, s))
}

let subgroup_image[G: Group, H: Group](f: GroupHom[G, H], s: Subgroup[G]) -> result: Subgroup[H] satisfy {
    Subgroup.new(subgroup_image_contains(f, s)) = Option.some(result)
}

theorem subgroup_image_contains_eq[G: Group, H: Group](
    f: GroupHom[G, H],
    s: Subgroup[G],
    y: H
) {
    subgroup_image(f, s).contains(y) = exists(x: G) {
        s.contains(x) and f.hom(x) = y
    }
}

theorem subgroup_image_contains_map[G: Group, H: Group](
    f: GroupHom[G, H],
    s: Subgroup[G],
    x: G
) {
    s.contains(x) implies subgroup_image(f, s).contains(f.hom(x))
}

theorem subgroup_image_contains_witness[G: Group, H: Group](
    f: GroupHom[G, H],
    s: Subgroup[G],
    y: H
) {
    subgroup_image(f, s).contains(y) implies exists(x: G) {
        s.contains(x) and f.hom(x) = y
    }
}

theorem subgroup_image_subset_iff_subset_preimage[G: Group, H: Group](
    f: GroupHom[G, H],
    s: Subgroup[G],
    t: Subgroup[H]
) {
    subgroup_subset(subgroup_image(f, s), t) = subgroup_subset(s, subgroup_preimage(f, t))
}

theorem subgroup_image_subset_of_subset[G: Group, H: Group](
    f: GroupHom[G, H],
    s: Subgroup[G],
    t: Subgroup[G]
) {
    subgroup_subset(s, t) implies subgroup_subset(subgroup_image(f, s), subgroup_image(f, t))
}

theorem subgroup_preimage_normal[G: Group, H: Group](
    f: GroupHom[G, H],
    n: Subgroup[H]
) {
    is_normal_subgroup(n) implies is_normal_subgroup(subgroup_preimage(f, n))
}

instance Unit[M: Monoid]: Mul {
    define mul(self, other: Unit[M]) -> Unit[M] {
        unit_mul(self, other)
    }
}

theorem unit_typeclass_mul_eq_unit_mul[M: Monoid](u: Unit[M], v: Unit[M]) {
    u * v = unit_mul(u, v)
}

theorem unit_typeclass_one_eq_unit_one[M: Monoid] {
    One.1[Unit[M]] = unit_one[M]
}

theorem unit_typeclass_mul_assoc[M: Monoid](u: Unit[M], v: Unit[M], w: Unit[M]) {
    Mul.mul(u, Mul.mul(v, w)) = Mul.mul(Mul.mul(u, v), w)
}

theorem unit_semigroup_mul_associative[M: Monoid] {
    forall(u: Unit[M], v: Unit[M], w: Unit[M]) {
        Mul.mul(u, Mul.mul(v, w)) = Mul.mul(Mul.mul(u, v), w)
    }
}

theorem unit_typeclass_mul_one_left[M: Monoid](u: Unit[M]) {
    One.1[Unit[M]] * u = u
}

theorem unit_monoid_identity_right[M: Monoid] {
    forall(u: Unit[M]) {
        u * One.1[Unit[M]] = u
    }
}

theorem unit_monoid_identity_left[M: Monoid] {
    forall(u: Unit[M]) {
        One.1[Unit[M]] * u = u
    }
}

theorem unit_typeclass_inverse_eq_unit_inverse[M: Monoid](u: Unit[M]) {
    u.inverse = unit_inverse(u)
}

theorem unit_typeclass_inverse_right[M: Monoid](u: Unit[M]) {
    u * u.inverse = One.1[Unit[M]]
}

theorem unit_val_mul_typeclass[M: Monoid](u: Unit[M], v: Unit[M]) {
    (u * v).val = u.val * v.val
}

theorem unit_inv_mul_typeclass[M: Monoid](u: Unit[M], v: Unit[M]) {
    (u * v).inv = v.inv * u.inv
}

theorem unit_one_val_typeclass[M: Monoid] {
    One.1[Unit[M]].val = M.1
}

theorem unit_one_inv_typeclass[M: Monoid] {
    One.1[Unit[M]].inv = M.1
}

theorem unit_inverse_val_typeclass[M: Monoid](u: Unit[M]) {
    u.inverse.val = u.inv
}

theorem unit_inverse_inv_typeclass[M: Monoid](u: Unit[M]) {
    u.inverse.inv = u.val
}

theorem unit_typeclass_eq_iff_val_eq[M: Monoid](u: Unit[M], v: Unit[M]) {
    (u = v) = (u.val = v.val)
}

theorem unit_typeclass_eq_one_iff_val_eq_one[M: Monoid](u: Unit[M]) {
    (u = One.1[Unit[M]]) = (u.val = M.1)
}

theorem unit_typeclass_mul_ext_val[M: Monoid](u: Unit[M], v: Unit[M], w: Unit[M]) {
    u.val * v.val = w.val implies u * v = w
}

define units_map_fn[M: Monoid, N: Monoid](f: MonoidHom[M, N], u: Unit[M]) -> Unit[N] {
    monoid_hom_unit(f, u)
}

theorem units_map_fn_is_monoid_hom[M: Monoid, N: Monoid](f: MonoidHom[M, N]) {
    is_monoid_hom(units_map_fn(f))
}

let units_map[M: Monoid, N: Monoid](f: MonoidHom[M, N]) -> result: MonoidHom[Unit[M], Unit[N]] satisfy {
    MonoidHom.new(units_map_fn(f)) = Option.some(result)
}

theorem units_map_hom[M: Monoid, N: Monoid](f: MonoidHom[M, N]) {
    units_map(f).hom = units_map_fn(f)
}

theorem coe_map[M: Monoid, N: Monoid](f: MonoidHom[M, N], u: Unit[M]) {
    units_map(f).hom(u).val = f.hom(u.val)
}

theorem coe_map_inv[M: Monoid, N: Monoid](f: MonoidHom[M, N], u: Unit[M]) {
    units_map(f).hom(u).inv = f.hom(u.inv)
}

typeclass M: MulZeroClass extends Mul, Zero {
    /// Zero is a left absorbing element for multiplication.
    zero_mul(a: M) {
        M.0 * a = M.0
    }

    /// Zero is a right absorbing element for multiplication.
    mul_zero(a: M) {
        a * M.0 = M.0
    }
}

theorem semiconj_by_zero_right[M: MulZeroClass](a: M) {
    semiconj_by(a, M.0, M.0)
}

theorem semiconj_by_zero_left[M: MulZeroClass](x: M, y: M) {
    semiconj_by(M.0, x, y)
}

define subgroup_product_contains[G: Group](h: Subgroup[G], k: Subgroup[G], x: G) -> Bool {
    exists(a: G, b: G) {
        h.contains(a) and k.contains(b) and x = a * b
    }
}

theorem subgroup_product_identity_constraint[G: Group](h: Subgroup[G], k: Subgroup[G]) {
    identity_constraint(subgroup_product_contains(h, k))
}

theorem subgroup_product_commute_left[G: Group](h: Subgroup[G], k: Subgroup[G], a: G, b: G) {
    is_normal_subgroup(k) and h.contains(a) and k.contains(b) implies
    exists(kp: G) {
        k.contains(kp) and b * a = a * kp
    }
}

theorem subgroup_product_closure_constraint[G: Group](h: Subgroup[G], k: Subgroup[G]) {
    is_normal_subgroup(k) implies closure_constraint(subgroup_product_contains(h, k))
}

theorem subgroup_product_inverse_constraint[G: Group](h: Subgroup[G], k: Subgroup[G]) {
    is_normal_subgroup(k) implies inverse_constraint(subgroup_product_contains(h, k))
}

theorem subgroup_product_constraint[G: Group](h: Subgroup[G], k: Subgroup[G]) {
    is_normal_subgroup(k) implies subgroup_constraint(subgroup_product_contains(h, k))
}

theorem subgroup_product_contains_of_left[G: Group](h: Subgroup[G], k: Subgroup[G], a: G) {
    h.contains(a) implies subgroup_product_contains(h, k, a)
}

theorem subgroup_product_contains_of_right[G: Group](h: Subgroup[G], k: Subgroup[G], b: G) {
    k.contains(b) implies subgroup_product_contains(h, k, b)
}

theorem subgroup_product_commute_right[G: Group](h: Subgroup[G], k: Subgroup[G], a: G, b: G) {
    is_normal_subgroup(h) and h.contains(a) and k.contains(b) implies
    exists(hp: G) {
        h.contains(hp) and b * a = hp * b
    }
}

theorem subgroup_product_closure_constraint_right[G: Group](h: Subgroup[G], k: Subgroup[G]) {
    is_normal_subgroup(h) implies closure_constraint(subgroup_product_contains(h, k))
}

theorem subgroup_product_inverse_constraint_right[G: Group](h: Subgroup[G], k: Subgroup[G]) {
    is_normal_subgroup(h) implies inverse_constraint(subgroup_product_contains(h, k))
}

theorem subgroup_product_constraint_right[G: Group](h: Subgroup[G], k: Subgroup[G]) {
    is_normal_subgroup(h) implies subgroup_constraint(subgroup_product_contains(h, k))
}

theorem subgroup_intersection_normal_in_left[G: Group](h: Subgroup[G], k: Subgroup[G], g: G, x: G) {
    is_normal_subgroup(k) and h.contains(g) and h.intersection(k).contains(x) implies
    h.intersection(k).contains(g * x * g.inverse)
}

theorem subgroup_intersection_normal_in_right[G: Group](h: Subgroup[G], k: Subgroup[G], g: G, x: G) {
    is_normal_subgroup(h) and k.contains(g) and h.intersection(k).contains(x) implies
    h.intersection(k).contains(g * x * g.inverse)
}

theorem second_iso_project_mul[G: Group](h: Subgroup[G], k: Subgroup[G], a: G, b: G) {
    is_normal_subgroup(k) and h.contains(a) and h.contains(b) implies
    normal_subgroup_quotient_project(k, a * b) =
        normal_subgroup_quotient_mul(k,
            normal_subgroup_quotient_project(k, a),
            normal_subgroup_quotient_project(k, b))
}

theorem second_iso_project_inverse[G: Group](h: Subgroup[G], k: Subgroup[G], a: G) {
    is_normal_subgroup(k) and h.contains(a) implies
    normal_subgroup_quotient_project(k, a.inverse) =
        normal_subgroup_quotient_inverse(k, normal_subgroup_quotient_project(k, a))
}

theorem second_iso_kernel_iff[G: Group](h: Subgroup[G], k: Subgroup[G], a: G) {
    h.contains(a) implies
    (normal_subgroup_quotient_project(k, a) = normal_subgroup_quotient_one(k)) =
        h.intersection(k).contains(a)
}

theorem second_iso_kernel_rel[G: Group](h: Subgroup[G], k: Subgroup[G], a: G, b: G) {
    h.contains(a) and h.contains(b) implies
    (normal_subgroup_quotient_project(k, a) = normal_subgroup_quotient_project(k, b)) =
        normal_subgroup_rel(h.intersection(k), a, b)
}

theorem second_iso_induced_injective[G: Group](h: Subgroup[G], k: Subgroup[G], a: G, b: G) {
    h.contains(a) and h.contains(b) implies
    (normal_subgroup_quotient_project(k, a) = normal_subgroup_quotient_project(k, b)) =
        (normal_subgroup_quotient_project(h.intersection(k), a) =
            normal_subgroup_quotient_project(h.intersection(k), b))
}

theorem second_iso_image_iff_product[G: Group](h: Subgroup[G], k: Subgroup[G], q: QuotientOver[G]) {
    is_normal_subgroup(k) implies
    (exists(a: G) {
        h.contains(a) and normal_subgroup_quotient_project(k, a) = q
    }) =
    (exists(x: G) {
        subgroup_product_contains(h, k, x) and normal_subgroup_quotient_project(k, x) = q
    })
}

theorem second_iso_dual_kernel_iff[G: Group](h: Subgroup[G], k: Subgroup[G], b: G) {
    k.contains(b) implies
    (normal_subgroup_quotient_project(h, b) = normal_subgroup_quotient_one(h)) =
        h.intersection(k).contains(b)
}

theorem second_iso_dual_kernel_rel[G: Group](h: Subgroup[G], k: Subgroup[G], a: G, b: G) {
    k.contains(a) and k.contains(b) implies
    (normal_subgroup_quotient_project(h, a) = normal_subgroup_quotient_project(h, b)) =
        normal_subgroup_rel(h.intersection(k), a, b)
}

theorem second_iso_dual_induced_injective[G: Group](h: Subgroup[G], k: Subgroup[G], a: G, b: G) {
    k.contains(a) and k.contains(b) implies
    (normal_subgroup_quotient_project(h, a) = normal_subgroup_quotient_project(h, b)) =
        (normal_subgroup_quotient_project(h.intersection(k), a) =
            normal_subgroup_quotient_project(h.intersection(k), b))
}

theorem second_iso_dual_image_iff_product[G: Group](h: Subgroup[G], k: Subgroup[G], q: QuotientOver[G]) {
    is_normal_subgroup(h) implies
    (exists(b: G) {
        k.contains(b) and normal_subgroup_quotient_project(h, b) = q
    }) =
    (exists(x: G) {
        subgroup_product_contains(h, k, x) and normal_subgroup_quotient_project(h, x) = q
    })
}

define action_identity_constraint[G: Group, X](act: (G, X) -> X) -> Bool {
    forall(x: X) {
        act(G.1, x) = x
    }
}

define action_mul_constraint[G: Group, X](act: (G, X) -> X) -> Bool {
    forall(g: G, h: G, x: X) {
        act(g * h, x) = act(g, act(h, x))
    }
}

define is_mul_action[G: Group, X](act: (G, X) -> X) -> Bool {
    action_mul_constraint(act) and action_identity_constraint(act)
}

structure MulAction[G: Group, X] {
    /// The action map.
    act: (G, X) -> X
} constraint {
    is_mul_action(act)
}

theorem mul_action_one[G: Group, X](a: MulAction[G, X], x: X) {
    a.act(G.1, x) = x
}

theorem mul_action_mul[G: Group, X](a: MulAction[G, X], g: G, h: G, x: X) {
    a.act(g * h, x) = a.act(g, a.act(h, x))
}

theorem mul_action_inv_apply_apply[G: Group, X](a: MulAction[G, X], g: G, x: X) {
    a.act(g.inverse, a.act(g, x)) = x
}

theorem mul_action_apply_inv_apply[G: Group, X](a: MulAction[G, X], g: G, x: X) {
    a.act(g, a.act(g.inverse, x)) = x
}

define action_map[G: Group, X](a: MulAction[G, X], g: G, x: X) -> X {
    a.act(g, x)
}

theorem action_map_apply[G: Group, X](a: MulAction[G, X], g: G, x: X) {
    action_map(a, g, x) = a.act(g, x)
}

theorem action_map_inverse_apply_apply[G: Group, X](a: MulAction[G, X], g: G, x: X) {
    action_map(a, g.inverse, action_map(a, g, x)) = x
}

theorem action_map_apply_inverse_apply[G: Group, X](a: MulAction[G, X], g: G, x: X) {
    action_map(a, g, action_map(a, g.inverse, x)) = x
}

theorem action_map_is_injective[G: Group, X](a: MulAction[G, X], g: G) {
    is_injective_fn(action_map(a, g))
}

theorem action_map_is_surjective[G: Group, X](a: MulAction[G, X], g: G) {
    is_surjective_fn(action_map(a, g))
}

theorem action_map_is_bijection[G: Group, X](a: MulAction[G, X], g: G) {
    is_bijection_fn(action_map(a, g))
}

let action_bijection[G: Group, X](a: MulAction[G, X], g: G) -> result: Bijection[X, X] satisfy {
    result.map = action_map(a, g)
}

theorem action_bijection_map[G: Group, X](a: MulAction[G, X], g: G) {
    action_bijection(a, g).map = action_map(a, g)
}

theorem action_bijection_apply[G: Group, X](a: MulAction[G, X], g: G, x: X) {
    action_bijection(a, g).map(x) = a.act(g, x)
}

theorem action_map_one[G: Group, X](a: MulAction[G, X]) {
    action_map(a, G.1) = identity_fn[X]
}

theorem action_bijection_one_map[G: Group, X](a: MulAction[G, X]) {
    action_bijection(a, G.1).map = identity_fn[X]
}

theorem action_map_mul[G: Group, X](a: MulAction[G, X], g: G, h: G) {
    action_map(a, g * h) = compose(action_map(a, g), action_map(a, h))
}

theorem action_bijection_mul_map[G: Group, X](a: MulAction[G, X], g: G, h: G) {
    action_bijection(a, g * h).map =
        compose(action_bijection(a, g).map, action_bijection(a, h).map)
}

theorem action_map_inverse_compose_left[G: Group, X](a: MulAction[G, X], g: G) {
    compose(action_map(a, g.inverse), action_map(a, g)) = identity_fn[X]
}

theorem action_map_inverse_compose_right[G: Group, X](a: MulAction[G, X], g: G) {
    compose(action_map(a, g), action_map(a, g.inverse)) = identity_fn[X]
}

define is_equivariant_map[G: Group, X, Y](
    a: MulAction[G, X],
    b: MulAction[G, Y],
    f: X -> Y
) -> Bool {
    forall(g: G, x: X) {
        f(a.act(g, x)) = b.act(g, f(x))
    }
}

structure ActionHom[G: Group, X, Y] {
    /// The source action.
    src: MulAction[G, X]

    /// The target action.
    dst: MulAction[G, Y]

    /// The underlying map.
    map: X -> Y
} constraint {
    is_equivariant_map(src, dst, map)
}

theorem equivariant_map_apply[G: Group, X, Y](
    a: MulAction[G, X],
    b: MulAction[G, Y],
    f: X -> Y,
    g: G,
    x: X
) {
    is_equivariant_map(a, b, f) implies f(a.act(g, x)) = b.act(g, f(x))
}

theorem action_hom_is_equivariant[G: Group, X, Y](f: ActionHom[G, X, Y]) {
    is_equivariant_map(f.src, f.dst, f.map)
}

theorem action_hom_apply[G: Group, X, Y](f: ActionHom[G, X, Y], g: G, x: X) {
    f.map(f.src.act(g, x)) = f.dst.act(g, f.map(x))
}

theorem action_hom_ext[G: Group, X, Y](f: ActionHom[G, X, Y], h: ActionHom[G, X, Y]) {
    f.src = h.src and f.dst = h.dst and f.map = h.map implies f = h
}

attributes ActionHom[G: Group, X, Y] {
    /// Action homomorphism extensionality from equality of fields.
    let ext = action_hom_ext[G, X, Y]
}

theorem action_hom_eq_map[G: Group, X, Y](f: ActionHom[G, X, Y], h: ActionHom[G, X, Y]) {
    f = h implies f.map = h.map
}

theorem action_hom_eq_apply[G: Group, X, Y](f: ActionHom[G, X, Y], h: ActionHom[G, X, Y], x: X) {
    f = h implies f.map(x) = h.map(x)
}

theorem identity_fn_is_equivariant[G: Group, X](a: MulAction[G, X]) {
    is_equivariant_map(a, a, identity_fn[X])
}

let identity_action_hom[G: Group, X](a: MulAction[G, X]) -> result: ActionHom[G, X, X] satisfy {
    ActionHom[G, X, X].new(a, a, identity_fn[X]) = Option.some(result)
}

theorem identity_action_hom_map[G: Group, X](a: MulAction[G, X]) {
    identity_action_hom(a).map = identity_fn[X]
}

theorem identity_action_hom_apply[G: Group, X](a: MulAction[G, X], x: X) {
    identity_action_hom(a).map(x) = x
}

theorem compose_is_equivariant_map[G: Group, X, Y, Z](
    a: MulAction[G, X],
    b: MulAction[G, Y],
    c: MulAction[G, Z],
    f: Y -> Z,
    h: X -> Y
) {
    is_equivariant_map(b, c, f) and is_equivariant_map(a, b, h) implies
        is_equivariant_map(a, c, compose(f, h))
}

theorem action_hom_compose_maps_is_equivariant[G: Group, X, Y, Z](
    f: ActionHom[G, Y, Z],
    h: ActionHom[G, X, Y]
) {
    h.dst = f.src implies is_equivariant_map(h.src, f.dst, compose(f.map, h.map))
}

theorem action_hom_compose_maps_apply[G: Group, X, Y, Z](
    f: ActionHom[G, Y, Z],
    h: ActionHom[G, X, Y],
    x: X
) {
    compose(f.map, h.map, x) = f.map(h.map(x))
}

define orbit_contains[G: Group, X](a: MulAction[G, X], x: X, y: X) -> Bool {
    exists(g: G) {
        y = a.act(g, x)
    }
}

define orbit_relation[G: Group, X](a: MulAction[G, X], x: X, y: X) -> Bool {
    orbit_contains(a, x, y)
}

define orbit[G: Group, X](a: MulAction[G, X], x: X) -> Set[X] {
    Set[X].new(orbit_contains(a, x))
}

theorem orbit_contains_self[G: Group, X](a: MulAction[G, X], x: X) {
    orbit(a, x).contains(x)
}

theorem orbit_contains_action[G: Group, X](a: MulAction[G, X], x: X, g: G) {
    orbit(a, x).contains(a.act(g, x))
}

theorem orbit_contains_witness[G: Group, X](a: MulAction[G, X], x: X, y: X) {
    orbit(a, x).contains(y) implies exists(g: G) {
        y = a.act(g, x)
    }
}

theorem equivariant_map_maps_orbit_contains[G: Group, X, Y](
    a: MulAction[G, X],
    b: MulAction[G, Y],
    f: X -> Y,
    x: X,
    y: X
) {
    is_equivariant_map(a, b, f) and orbit(a, x).contains(y) implies orbit(b, f(x)).contains(f(y))
}

theorem action_hom_maps_orbit_contains[G: Group, X, Y](
    f: ActionHom[G, X, Y],
    x: X,
    y: X
) {
    orbit(f.src, x).contains(y) implies orbit(f.dst, f.map(x)).contains(f.map(y))
}

theorem equivariant_map_reflects_orbit_contains_of_injective[G: Group, X, Y](
    a: MulAction[G, X],
    b: MulAction[G, Y],
    f: X -> Y,
    x: X,
    y: X
) {
    is_injective_fn(f) and is_equivariant_map(a, b, f) and
        orbit(b, f(x)).contains(f(y)) implies orbit(a, x).contains(y)
}

theorem action_hom_reflects_orbit_contains_of_injective[G: Group, X, Y](
    f: ActionHom[G, X, Y],
    x: X,
    y: X
) {
    is_injective_fn(f.map) and orbit(f.dst, f.map(x)).contains(f.map(y)) implies
        orbit(f.src, x).contains(y)
}

theorem orbit_contains_symmetric[G: Group, X](a: MulAction[G, X], x: X, y: X) {
    orbit(a, x).contains(y) implies orbit(a, y).contains(x)
}

theorem orbit_contains_action_of_contains[G: Group, X](a: MulAction[G, X], x: X, y: X, g: G) {
    orbit(a, x).contains(y) implies orbit(a, x).contains(a.act(g, y))
}

theorem orbit_contains_transitive[G: Group, X](a: MulAction[G, X], x: X, y: X, z: X) {
    orbit(a, x).contains(y) and orbit(a, y).contains(z) implies orbit(a, x).contains(z)
}

theorem orbit_relation_eq_contains[G: Group, X](a: MulAction[G, X], x: X, y: X) {
    orbit_relation(a, x, y) = orbit(a, x).contains(y)
}

theorem orbit_relation_is_reflexive[G: Group, X](a: MulAction[G, X]) {
    is_reflexive(orbit_relation(a))
}

theorem orbit_relation_is_symmetric[G: Group, X](a: MulAction[G, X]) {
    is_symmetric(orbit_relation(a))
}

theorem orbit_eq_of_contains[G: Group, X](a: MulAction[G, X], x: X, y: X) {
    orbit(a, x).contains(y) implies orbit(a, x) = orbit(a, y)
}

theorem orbit_eq_iff_contains[G: Group, X](a: MulAction[G, X], x: X, y: X) {
    orbit(a, x) = orbit(a, y) = orbit(a, x).contains(y)
}

define stabilizer_contains[G: Group, X](a: MulAction[G, X], x: X, g: G) -> Bool {
    a.act(g, x) = x
}

theorem stabilizer_identity_constraint[G: Group, X](a: MulAction[G, X], x: X) {
    identity_constraint(stabilizer_contains(a, x))
}

theorem stabilizer_closure_constraint[G: Group, X](a: MulAction[G, X], x: X) {
    closure_constraint(stabilizer_contains(a, x))
}

theorem stabilizer_inverse_constraint[G: Group, X](a: MulAction[G, X], x: X) {
    inverse_constraint(stabilizer_contains(a, x))
}

theorem stabilizer_subgroup_constraint[G: Group, X](a: MulAction[G, X], x: X) {
    subgroup_constraint(stabilizer_contains(a, x))
}

let stabilizer[G: Group, X](a: MulAction[G, X], x: X) -> result: Subgroup[G] satisfy {
    Subgroup.new(stabilizer_contains(a, x)) = Option.some(result)
}

theorem stabilizer_contains_eq[G: Group, X](a: MulAction[G, X], x: X, g: G) {
    stabilizer(a, x).contains(g) = (a.act(g, x) = x)
}

theorem stabilizer_fixes[G: Group, X](a: MulAction[G, X], x: X, g: G) {
    stabilizer(a, x).contains(g) implies a.act(g, x) = x
}

theorem stabilizer_contains_of_fixes[G: Group, X](a: MulAction[G, X], x: X, g: G) {
    a.act(g, x) = x implies stabilizer(a, x).contains(g)
}

theorem orbit_action_eq_iff_stabilizer_left_coset_raw[G: Group, X](
    a: MulAction[G, X],
    x: X,
    g: G,
    k: G
) {
    (a.act(g, x) = a.act(k, x)) = stabilizer(a, x).contains(g.inverse * k)
}

theorem equivariant_map_maps_fixed_point_value[G: Group, X, Y](
    a: MulAction[G, X],
    b: MulAction[G, Y],
    f: X -> Y,
    x: X,
    g: G
) {
    is_equivariant_map(a, b, f) and stabilizer(a, x).contains(g) implies
        b.act(g, f(x)) = f(x)
}

theorem equivariant_map_maps_stabilizer_contains[G: Group, X, Y](
    a: MulAction[G, X],
    b: MulAction[G, Y],
    f: X -> Y,
    x: X,
    g: G
) {
    is_equivariant_map(a, b, f) and stabilizer(a, x).contains(g) implies
        stabilizer(b, f(x)).contains(g)
}

theorem action_hom_maps_stabilizer_contains[G: Group, X, Y](
    f: ActionHom[G, X, Y],
    x: X,
    g: G
) {
    stabilizer(f.src, x).contains(g) implies stabilizer(f.dst, f.map(x)).contains(g)
}

theorem equivariant_map_reflects_fixed_point_value_of_injective[G: Group, X, Y](
    a: MulAction[G, X],
    b: MulAction[G, Y],
    f: X -> Y,
    x: X,
    g: G
) {
    is_injective_fn(f) and is_equivariant_map(a, b, f) and stabilizer(b, f(x)).contains(g) implies
        a.act(g, x) = x
}

theorem equivariant_map_reflects_stabilizer_contains_of_injective[G: Group, X, Y](
    a: MulAction[G, X],
    b: MulAction[G, Y],
    f: X -> Y,
    x: X,
    g: G
) {
    is_injective_fn(f) and is_equivariant_map(a, b, f) and stabilizer(b, f(x)).contains(g) implies
        stabilizer(a, x).contains(g)
}

theorem action_hom_reflects_stabilizer_contains_of_injective[G: Group, X, Y](
    f: ActionHom[G, X, Y],
    x: X,
    g: G
) {
    is_injective_fn(f.map) and stabilizer(f.dst, f.map(x)).contains(g) implies
        stabilizer(f.src, x).contains(g)
}

define fixed_points_contains[G: Group, X](a: MulAction[G, X], g: G, x: X) -> Bool {
    a.act(g, x) = x
}

define fixed_points[G: Group, X](a: MulAction[G, X], g: G) -> Set[X] {
    Set[X].new(fixed_points_contains(a, g))
}

theorem fixed_points_contains_eq[G: Group, X](a: MulAction[G, X], g: G, x: X) {
    fixed_points(a, g).contains(x) = (a.act(g, x) = x)
}

theorem fixed_points_one_contains[G: Group, X](a: MulAction[G, X], x: X) {
    fixed_points(a, G.1).contains(x)
}

define is_transitive_action[G: Group, X](a: MulAction[G, X]) -> Bool {
    forall(x: X, y: X) {
        orbit(a, x).contains(y)
    }
}

theorem transitive_action_orbit_contains[G: Group, X](a: MulAction[G, X], x: X, y: X) {
    is_transitive_action(a) implies orbit(a, x).contains(y)
}

theorem transitive_action_of_universal_orbits[G: Group, X](a: MulAction[G, X]) {
    (forall(x: X, y: X) { orbit(a, x).contains(y) }) implies is_transitive_action(a)
}

define is_faithful_action[G: Group, X](a: MulAction[G, X]) -> Bool {
    forall(g: G, h: G) {
        (forall(x: X) { a.act(g, x) = a.act(h, x) }) implies g = h
    }
}

theorem faithful_action_eq_of_pointwise_eq[G: Group, X](a: MulAction[G, X], g: G, h: G) {
    is_faithful_action(a) and (forall(x: X) { a.act(g, x) = a.act(h, x) }) implies g = h
}

theorem faithful_action_eq_one_of_pointwise_fixed[G: Group, X](a: MulAction[G, X], g: G) {
    is_faithful_action(a) and (forall(x: X) { a.act(g, x) = x }) implies g = G.1
}

define is_invariant_set[G: Group, X](a: MulAction[G, X], s: Set[X]) -> Bool {
    forall(g: G, x: X) {
        s.contains(x) implies s.contains(a.act(g, x))
    }
}

theorem universal_set_is_invariant[G: Group, X](a: MulAction[G, X]) {
    is_invariant_set(a, Set[X].universal_set)
}

theorem orbit_is_invariant[G: Group, X](a: MulAction[G, X], x: X) {
    is_invariant_set(a, orbit(a, x))
}

define nat_multiples_map[M: AddMonoid](x: M, n: Nat) -> M {
    match n {
        Nat.zero {
            M.0
        }
        Nat.suc(k) {
            nat_multiples_map(x, k) + x
        }
    }
}

theorem nat_multiples_zero[M: AddMonoid](x: M) {
    nat_multiples_map(x, Nat.0) = M.0
}

theorem nat_multiples_one[M: AddMonoid](x: M) {
    nat_multiples_map(x, Nat.1) = x
}

theorem nat_multiples_add[M: AddMonoid](x: M, n: Nat, m: Nat) {
    nat_multiples_map(x, n + m) = nat_multiples_map(x, n) + nat_multiples_map(x, m)
}

theorem nat_multiples_map_is_add_monoid_hom[M: AddMonoid](x: M) {
    is_add_monoid_hom(nat_multiples_map[M](x))
}

theorem ext_nat_prime[M: AddMonoid](f: AddMonoidHom[Nat, M], g: AddMonoidHom[Nat, M]) {
    f.hom(Nat.1) = g.hom(Nat.1) implies f = g
}

theorem add_monoid_hom_ext_nat[M: AddMonoid](f: AddMonoidHom[Nat, M], g: AddMonoidHom[Nat, M]) {
    f.hom(Nat.1) = g.hom(Nat.1) implies f = g
}

let multiplesHom[M: AddMonoid](x: M) -> result: AddMonoidHom[Nat, M] satisfy {
    AddMonoidHom.new(nat_multiples_map[M](x)) = Option.some(result)
}

theorem multiplesHom_apply[M: AddMonoid](x: M, n: Nat) {
    multiplesHom(x).hom(n) = nat_multiples_map(x, n)
}

theorem add_monoid_hom_apply_nat[M: AddMonoid](f: AddMonoidHom[Nat, M], n: Nat) {
    f.hom(n) = nat_multiples_map(f.hom(Nat.1), n)
}

theorem group_inverse_one[G: Group] {
    G.1.inverse = G.1
}

theorem group_inverse_unique[G: Group](a: G, b: G) {
    a * b = G.1 and b * a = G.1 implies b = a.inverse
}

theorem group_right_inverse_eq_inverse[G: Group](a: G, b: G) {
    a * b = G.1 implies b = a.inverse
}

theorem group_left_inverse_eq_inverse[G: Group](a: G, b: G) {
    b * a = G.1 implies b = a.inverse
}

theorem group_inverse_mul_inv_left[G: Group](a: G, b: G) {
    (a.inverse * b).inverse = b.inverse * a
}

theorem group_inverse_mul_inv_right[G: Group](a: G, b: G) {
    (a * b.inverse).inverse = b * a.inverse
}

theorem group_mul_inv_cancel_left[G: Group](a: G, b: G) {
    a * (a.inverse * b) = b
}
