theorem submonoid_preimage_contains_eq[M: Monoid, N: Monoid](
    f: MonoidHom[M, N],
    s: Submonoid[N],
    a: M
) {
    submonoid_preimage(f, s).contains(a) = s.contains(f.hom(a))
