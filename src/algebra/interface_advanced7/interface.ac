theorem add_group_hom_kernel_quotient_image_eq_iff_project_eq[A: AddGroup, B: AddGroup](
    f: AddGroupHom[A, B], a: A, b: A
) {
    (f.hom(a) = f.hom(b)) =
        (add_group_hom_kernel_quotient_project(f, a) = add_group_hom_kernel_quotient_project(f, b))
