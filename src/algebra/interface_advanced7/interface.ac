) -> QuotientOver[G] {
    match n {
        Nat.zero {
            normal_subgroup_quotient_one(s)
        }
        Nat.suc(k) {
            normal_subgroup_quotient_mul(s, q, normal_subgroup_quotient_pow(s, q, k))
