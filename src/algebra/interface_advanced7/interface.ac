theorem submonoid_preimage_subset_of_subset[M: Monoid, N: Monoid](
    f: MonoidHom[M, N],
    s: Submonoid[N],
    t: Submonoid[N]
) {
    submonoid_subset(s, t) implies submonoid_subset(submonoid_preimage(f, s), submonoid_preimage(f, t))
