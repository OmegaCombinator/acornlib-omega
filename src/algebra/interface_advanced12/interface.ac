    s: (B, B) -> Bool
) {
    relation_subset(r, relation_pullback(f, s)) and has_ascending_chain(r) implies
    has_ascending_chain(s)
}

theorem nat_lt_relation_not_descending_chain(c: Nat -> Nat) {
