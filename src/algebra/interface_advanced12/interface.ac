theorem relation_pushforward_has_no_descending_chain_of_bijection[A, B](f: A -> B, r: (A, A) -> Bool) {
    is_bijection_fn(f) and is_well_founded(r) implies has_no_descending_chain(relation_pushforward(f, r))
