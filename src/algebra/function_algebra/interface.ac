theorem add_monoid_hom_kernel_quotient_project_add_comm[A: AddCommMonoid, B: AddCommMonoid](
    f: AddMonoidHom[A, B], a: A, b: A
) {
    add_monoid_hom_kernel_quotient_add(f,
