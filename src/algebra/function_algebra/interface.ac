    ideal_quotient_sub(i,
        ideal_quotient_mul(i, ideal_quotient_project(i, a), ideal_quotient_project(i, c)),
        ideal_quotient_mul(i, ideal_quotient_project(i, b), ideal_quotient_project(i, c)))
