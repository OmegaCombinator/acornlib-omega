            quotient_over_mk(ideal_quotient_relation(i), c)),
        ideal_quotient_mul(i,
            quotient_over_mk(ideal_quotient_relation(i), b),
            quotient_over_mk(ideal_quotient_relation(i), c)))
}

theorem ideal_quotient_add_sub_assoc[R: CommRing](i: Ideal[R], a: R, b: R, c: R) {
