theorem ideal_quotient_project_sub_self[R: CommRing](i: Ideal[R], a: R) {
    ideal_quotient_sub(i, ideal_quotient_project(i, a), ideal_quotient_project(i, a)) =
        ideal_quotient_zero(i)
