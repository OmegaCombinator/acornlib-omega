theorem well_founded_induction[T](r: (T, T) -> Bool, p: T -> Bool) {
    is_well_founded(r) and
    forall(x: T) {
        (forall(y: T) { r(y, x) implies p(y) }) implies p(x)
    }
    implies
    forall(x: T) {
        p(x)
    }
}

theorem relation_intersection_left_is_well_founded[T](r: (T, T) -> Bool, s: (T, T) -> Bool) {
