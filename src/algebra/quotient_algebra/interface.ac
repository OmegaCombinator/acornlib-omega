theorem gf4_mul_assoc(x: GF4, y: GF4, z: GF4) {
    Mul.mul(x, Mul.mul(y, z)) = Mul.mul(Mul.mul(x, y), z)
}

theorem gf4_mul_add_left(x: GF4, y: GF4, z: GF4) {
    Mul.mul(x, Add.add(y, z)) = Add.add(Mul.mul(x, y), Mul.mul(x, z))
}

theorem gf4_mul_add_right(x: GF4, y: GF4, z: GF4) {
    Mul.mul(Add.add(x, y), z) = Add.add(Mul.mul(x, z), Mul.mul(y, z))
}

define pointwise_mul[T, A: Mul](f: T -> A, g: T -> A, t: T) -> A {
    f(t) * g(t)
}

theorem pointwise_add_apply[T, A: Add](f: T -> A, g: T -> A, t: T) {
    pointwise_add(f, g, t) = f(t) + g(t)
}

theorem pointwise_mul_apply[T, A: Mul](f: T -> A, g: T -> A, t: T) {
    pointwise_mul(f, g, t) = f(t) * g(t)
}

theorem pointwise_mul_assoc[T, A: Semigroup](f: T -> A, g: T -> A, h: T -> A) {
    pointwise_mul(f, pointwise_mul(g, h)) = pointwise_mul(pointwise_mul(f, g), h)
}

theorem pointwise_mul_comm[T, A: CommSemigroup](f: T -> A, g: T -> A) {
    pointwise_mul(f, g) = pointwise_mul(g, f)
}

define flatten_list[T](xss: List[List[T]]) -> List[T] {
    match xss {
        List.nil {
            List.nil[T]
        }
        List.cons(xs, rest) {
            xs + flatten_list(rest)
        }
    }
}

theorem flatten_list_nil[T] {
    flatten_list(List.nil[List[T]]) = List.nil[T]
}

define semiconj_by[M: Mul](a: M, x: M, y: M) -> Bool {
    a * x = y * a
}

theorem semiconj_by_eq[M: Mul](a: M, x: M, y: M) {
    semiconj_by(a, x, y) = (a * x = y * a)
}

theorem semiconj_by_mul_eq[M: Mul](a: M, x: M, y: M) {
    semiconj_by(a, x, y) implies a * x = y * a
}

theorem semiconj_by_mul_right[S: Semigroup](a: S, x: S, y: S, xp: S, yp: S) {
    semiconj_by(a, x, y) and semiconj_by(a, xp, yp)
    implies semiconj_by(a, x * xp, y * yp)
}

theorem semiconj_by_mul_left[S: Semigroup](a: S, b: S, x: S, y: S, z: S) {
    semiconj_by(a, y, z) and semiconj_by(b, x, y)
    implies semiconj_by(a * b, x, z)
}

define is_square[M: Semigroup](a: M) -> Bool {
    exists(r: M) { a = r * r }
}

theorem is_square_iff_exists_mul_self[M: Semigroup](a: M) {
    is_square[M](a) = exists(r: M) { a = r * r }
}

theorem is_square_mul_self[M: Semigroup](r: M) {
    is_square[M](r * r)
}

theorem is_square_mul[M: CommSemigroup](a: M, b: M) {
    is_square[M](a) and is_square[M](b) implies is_square[M](a * b)
}

theorem opposite_mul_eq[M: Mul](a: M, b: M) {
    opposite_mul(a, b) = b * a
}

theorem opposite_mul_rev_eq[M: Mul](a: M, b: M) {
    opposite_mul(b, a) = a * b
}

theorem opposite_mul_eq_mul[M: CommSemigroup](a: M, b: M) {
    opposite_mul(a, b) = a * b
}

theorem preserves_opposite_mul[A: Mul, B: Mul](f: A -> B) {
    (forall(a: A, b: A) { f(a * b) = f(a) * f(b) }) implies
    forall(a: A, b: A) {
        f(opposite_mul(a, b)) = opposite_mul(f(a), f(b))
    }
}

theorem mul_opposite_val_mul[M: Mul](x: MulOpposite[M], y: MulOpposite[M]) {
    (x * y).val = y.val * x.val
}

theorem mul_opposite_to_mul[M: Mul](x: M, y: M) {
    (to_mul_opposite(x) * to_mul_opposite(y)).val = y * x
}

theorem to_mul_opposite_opposite_mul[M: Mul](x: M, y: M) {
    to_mul_opposite(opposite_mul(x, y)) = to_mul_opposite(x) * to_mul_opposite(y)
}

theorem mul_opposite_mul_assoc[M: Semigroup](x: MulOpposite[M], y: MulOpposite[M], z: MulOpposite[M]) {
    x * (y * z) = (x * y) * z
}

theorem mul_opposite_mul_is_associative[M: Semigroup] {
    forall(x: MulOpposite[M], y: MulOpposite[M], z: MulOpposite[M]) {
        x * (y * z) = (x * y) * z
    }
}

theorem mul_opposite_mul_is_associative_raw[M: Semigroup] {
    forall(x: MulOpposite[M], y: MulOpposite[M], z: MulOpposite[M]) {
        Mul.mul(x, Mul.mul(y, z)) = Mul.mul(Mul.mul(x, y), z)
    }
}

theorem pointwise_function_add_apply[T, A: Add](f: PointwiseFunction[T, A], g: PointwiseFunction[T, A], t: T) {
    (f + g).val(t) = f.val(t) + g.val(t)
}

theorem pointwise_function_mul_apply[T, A: Mul](f: PointwiseFunction[T, A], g: PointwiseFunction[T, A], t: T) {
    (f * g).val(t) = f.val(t) * g.val(t)
}

theorem pointwise_function_add_associative[T, A: AddSemigroup](
    f: PointwiseFunction[T, A],
    g: PointwiseFunction[T, A],
    h: PointwiseFunction[T, A]
) {
    f + (g + h) = (f + g) + h
}

theorem pointwise_function_add_commutative[T, A: AddCommSemigroup](
    f: PointwiseFunction[T, A],
    g: PointwiseFunction[T, A]
) {
    f + g = g + f
}

theorem pointwise_function_mul_associative[T, A: Semigroup](
    f: PointwiseFunction[T, A],
    g: PointwiseFunction[T, A],
    h: PointwiseFunction[T, A]
) {
    f * (g * h) = (f * g) * h
}

theorem pointwise_function_mul_commutative[T, A: CommSemigroup](
    f: PointwiseFunction[T, A],
    g: PointwiseFunction[T, A]
) {
    f * g = g * f
}

theorem pointwise_function_add_semigroup_law[T, A: AddSemigroup](
    f: PointwiseFunction[T, A],
    g: PointwiseFunction[T, A],
    h: PointwiseFunction[T, A]
) {
    Add.add(f, Add.add(g, h)) = Add.add(Add.add(f, g), h)
}

theorem pointwise_function_add_comm_semigroup_law[T, A: AddCommSemigroup](
    f: PointwiseFunction[T, A],
    g: PointwiseFunction[T, A]
) {
    Add.add(f, g) = Add.add(g, f)
}

theorem pointwise_function_semigroup_law[T, A: Semigroup](
    f: PointwiseFunction[T, A],
    g: PointwiseFunction[T, A],
    h: PointwiseFunction[T, A]
) {
    Mul.mul(f, Mul.mul(g, h)) = Mul.mul(Mul.mul(f, g), h)
}

theorem pointwise_function_comm_semigroup_law[T, A: CommSemigroup](
    f: PointwiseFunction[T, A],
    g: PointwiseFunction[T, A]
) {
    Mul.mul(f, g) = Mul.mul(g, f)
}

theorem pair_add_first[A: Add, B: Add](p: Pair[A, B], q: Pair[A, B]) {
    pair_add(p, q).first = p.first + q.first
}

theorem pair_add_second[A: Add, B: Add](p: Pair[A, B], q: Pair[A, B]) {
    pair_add(p, q).second = p.second + q.second
}

theorem pair_mul_first[A: Mul, B: Mul](p: Pair[A, B], q: Pair[A, B]) {
    pair_mul(p, q).first = p.first * q.first
}

theorem pair_mul_second[A: Mul, B: Mul](p: Pair[A, B], q: Pair[A, B]) {
    pair_mul(p, q).second = p.second * q.second
}

theorem pair_add_assoc[A: AddSemigroup, B: AddSemigroup](
    p: Pair[A, B], q: Pair[A, B], r: Pair[A, B]
) {
    pair_add(p, pair_add(q, r)) = pair_add(pair_add(p, q), r)
}

theorem pair_add_comm[A: AddCommSemigroup, B: AddCommSemigroup](p: Pair[A, B], q: Pair[A, B]) {
    pair_add(p, q) = pair_add(q, p)
