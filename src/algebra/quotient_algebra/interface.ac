theorem choose_well_founded_nonrecursive_solution_eq_function[T, U](
    r: (T, T) -> Bool,
    value: T -> U,
    default: U
) {
    is_well_founded(r) implies
    choose_well_founded_recursive_solution(r, well_founded_nonrecursive_step(value), default) =
