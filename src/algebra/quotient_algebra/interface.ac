theorem gf4_x_ne_x_plus_one {
    GF4.x != GF4.x_plus_one
}

define prepend_all[T](x: T, ts: List[List[T]]) -> List[List[T]] {
    map[List[T], List[T]](ts, function(t: List[T]) {
        List.cons(x, t)
    })
}

theorem prepend_all_unfold[T](x: T, ts: List[List[T]]) {
    prepend_all(x, ts) = map[List[T], List[T]](ts, function(t: List[T]) {
        List.cons(x, t)
    })
}

theorem cons_injective_fn[T](x: T) {
    is_injective_fn(function(t: List[T]) { List.cons(x, t) })
}

theorem map_unique_of_injective[T, U](items: List[T], f: T -> U) {
    items.is_unique and is_injective_fn(f) implies map(items, f).is_unique
}

theorem commute_map[M: Monoid, N: Monoid](f: MonoidHom[M, N], x: M, y: M) {
    commute(x, y) implies commute(f.hom(x), f.hom(y))
}

theorem commute_of_map[M: Monoid, N: Monoid](f: MonoidHom[M, N], x: M, y: M) {
    is_injective_fn(f.hom) and commute(f.hom(x), f.hom(y)) implies commute(x, y)
}

theorem commute_map_iff[M: Monoid, N: Monoid](f: MonoidHom[M, N], x: M, y: M) {
    is_injective_fn(f.hom) implies commute(f.hom(x), f.hom(y)) = commute(x, y)
}

theorem ext_nat_prime[M: AddMonoid](f: AddMonoidHom[Nat, M], g: AddMonoidHom[Nat, M]) {
    f.hom(Nat.1) = g.hom(Nat.1) implies f = g
}

theorem add_monoid_hom_ext_nat[M: AddMonoid](f: AddMonoidHom[Nat, M], g: AddMonoidHom[Nat, M]) {
    f.hom(Nat.1) = g.hom(Nat.1) implies f = g
}

define module_smul_one_constraint[R: Ring, M: AddCommGroup](smul: R -> M -> M) -> Bool {
    forall(x: M) {
        smul(R.1, x) = x
    }
}

let trivial_linear_map[M: AddCommGroup, N: AddCommGroup]: M -> N = function(a: M) {
    N.0
}

theorem compose_trivial_linear_map_left[M: AddCommGroup, N: AddCommGroup, K: AddCommGroup](f: M -> N) {
    compose(trivial_linear_map[N, K], f) = trivial_linear_map[M, K]
}

theorem add_fn_trivial_linear_map_right[M: AddCommGroup, N: AddCommGroup](f: M -> N) {
    add_fn(f, trivial_linear_map[M, N]) = f
}

theorem add_fn_trivial_linear_map_left[M: AddCommGroup, N: AddCommGroup](f: M -> N) {
    add_fn(trivial_linear_map[M, N], f) = f
}

theorem identity_fn_two_sided_inverse_self[M: AddCommGroup] {
    is_two_sided_inverse_fn(identity_fn[M], identity_fn[M])
}

define zero_submodule_contains[M: AddCommGroup](x: M) -> Bool {
    x = M.0
}

define full_submodule_contains[M: AddCommGroup](x: M) -> Bool {
    true
}

define linear_map_kernel[R: Ring, M: AddCommGroup, N: AddCommGroup](
    f: M -> N, x: M
) -> Bool {
    f(x) = N.0
}

define linear_map_image[M: AddCommGroup, N: AddCommGroup](f: M -> N, y: N) -> Bool {
    exists(x: M) {
        f(x) = y
    }
}

define is_kernel_trivial[R: Ring, M: AddCommGroup, N: AddCommGroup](f: M -> N) -> Bool {
    forall(x: M) {
        linear_map_kernel[R, M, N](f, x) implies x = M.0
    }
}

define lie_bracket_alternating_constraint[R: CommRing, L: AddCommGroup](
    bracket: (L, L) -> L
) -> Bool {
    forall(x: L) {
        bracket(x, x) = L.0
    }
}

let trivial_lie_bracket[R: CommRing, L: AddCommGroup]: (L, L) -> L =
    function(x: L, y: L) { L.0 }

theorem trivial_lie_bracket_zero[R: CommRing, L: AddCommGroup](x: L, y: L) {
    trivial_lie_bracket[R, L](x, y) = L.0
}

theorem predicate_subset_intro[T](p: T -> Bool, q: T -> Bool) {
    (forall(x: T) { p(x) implies q(x) }) implies predicate_subset(p, q)
}

define monoid_hom_image[M: Monoid, N: Monoid](f: MonoidHom[M, N], s: Set[M]) -> Set[N] {
    set_image(s, f.hom)
}

define monoid_hom_preimage[M: Monoid, N: Monoid](f: MonoidHom[M, N], s: Set[N]) -> Set[M] {
    set_preimage(f.hom, s)
}

define monoid_hom_image_preimage_closure[M: Monoid, N: Monoid](
    f: MonoidHom[M, N],
    s: Set[M]
) -> Set[M] {
    set_image_preimage_closure(f.hom, s)
}

define monoid_hom_preimage_image_kernel[M: Monoid, N: Monoid](
    f: MonoidHom[M, N],
    s: Set[N]
) -> Set[N] {
    set_preimage_image_kernel(f.hom, s)
}

theorem monoid_hom_image_subset_iff_subset_preimage[M: Monoid, N: Monoid](
    f: MonoidHom[M, N],
    s: Set[M],
    t: Set[N]
) {
    monoid_hom_image(f, s).subset(t) = s.subset(monoid_hom_preimage(f, t))
}

theorem monoid_hom_image_compose[M: Monoid, N: Monoid, P: Monoid](
    f: MonoidHom[N, P],
    g: MonoidHom[M, N],
    s: Set[M]
) {
    monoid_hom_image(compose_monoid_hom(f, g), s) =
        monoid_hom_image(f, monoid_hom_image(g, s))
}

theorem monoid_hom_preimage_compose[M: Monoid, N: Monoid, P: Monoid](
    f: MonoidHom[N, P],
    g: MonoidHom[M, N],
    s: Set[P]
) {
    monoid_hom_preimage(compose_monoid_hom(f, g), s) =
        monoid_hom_preimage(g, monoid_hom_preimage(f, s))
}

theorem monoid_hom_image_preimage_closure_extensive[M: Monoid, N: Monoid](
    f: MonoidHom[M, N],
    s: Set[M]
) {
    s.subset(monoid_hom_image_preimage_closure(f, s))
}

theorem monoid_hom_image_preimage_closure_monotone[M: Monoid, N: Monoid](
    f: MonoidHom[M, N]
) {
    is_subset_monotone_map(monoid_hom_image_preimage_closure(f))
}

theorem monoid_hom_image_preimage_closure_idempotent[M: Monoid, N: Monoid](
    f: MonoidHom[M, N],
    s: Set[M]
) {
    monoid_hom_image_preimage_closure(f, monoid_hom_image_preimage_closure(f, s)) =
        monoid_hom_image_preimage_closure(f, s)
}

theorem monoid_hom_image_preimage_closure_operator[M: Monoid, N: Monoid](
    f: MonoidHom[M, N]
) {
    is_set_closure_operator(monoid_hom_image_preimage_closure(f))
}

theorem monoid_hom_preimage_image_kernel_reductive[M: Monoid, N: Monoid](
    f: MonoidHom[M, N],
    s: Set[N]
) {
    monoid_hom_preimage_image_kernel(f, s).subset(s)
}

theorem monoid_hom_preimage_image_kernel_monotone[M: Monoid, N: Monoid](
    f: MonoidHom[M, N]
) {
    is_subset_monotone_map(monoid_hom_preimage_image_kernel(f))
}

theorem monoid_hom_preimage_image_kernel_idempotent[M: Monoid, N: Monoid](
    f: MonoidHom[M, N],
    s: Set[N]
) {
    monoid_hom_preimage_image_kernel(f, monoid_hom_preimage_image_kernel(f, s)) =
        monoid_hom_preimage_image_kernel(f, s)
}

theorem monoid_hom_preimage_image_kernel_operator[M: Monoid, N: Monoid](
    f: MonoidHom[M, N]
) {
    is_set_kernel_operator(monoid_hom_preimage_image_kernel(f))
}

theorem monoid_pow_pow_comm[M: Monoid](a: M, m: Nat, n: Nat) {
    a.pow(m).pow(n) = a.pow(n).pow(m)
}

define to_mul_opposite[M](x: M) -> MulOpposite[M] {
    MulOpposite.new(x)
}

define of_mul_opposite[M](x: MulOpposite[M]) -> M {
    x.val
}

theorem mul_opposite_ext[M](x: MulOpposite[M], y: MulOpposite[M]) {
    x.val = y.val implies x = y
}

theorem of_to_mul_opposite[M](x: M) {
    of_mul_opposite(to_mul_opposite(x)) = x
}

theorem to_of_mul_opposite[M](x: MulOpposite[M]) {
    to_mul_opposite(of_mul_opposite(x)) = x
}

theorem to_mul_opposite_val[M](x: M) {
    to_mul_opposite(x).val = x
}

theorem pointwise_function_ext[T, A](f: PointwiseFunction[T, A], g: PointwiseFunction[T, A]) {
    (forall(t: T) { f.val(t) = g.val(t) }) implies f = g
}

theorem pointwise_function_eq_val[T, A](f: PointwiseFunction[T, A], g: PointwiseFunction[T, A]) {
    f = g implies f.val = g.val
}

theorem pointwise_function_eq_apply[T, A](f: PointwiseFunction[T, A], g: PointwiseFunction[T, A], t: T) {
    f = g implies f.val(t) = g.val(t)
}

let add_monoid_algebra_singleton_support[M](m: M) -> result: FiniteSet[M] satisfy {
    FiniteSet[M].new(Set[M].singleton(m)) = Option.some(result)
}

define add_monoid_algebra_single_coeff[R: Semiring, M](m: M, r: R, n: M) -> R {
    if n = m {
        r
    } else {
        R.0
    }
}

theorem relation_compose_monotone_left[A, B, C](
    r1: (A, B) -> Bool,
    r2: (A, B) -> Bool,
    s: (B, C) -> Bool
) {
    relation_subset(r1, r2) implies
    relation_subset(relation_compose(r1, s), relation_compose(r2, s))
}

theorem relation_compose_monotone_right[A, B, C](
    r: (A, B) -> Bool,
    s1: (B, C) -> Bool,
    s2: (B, C) -> Bool
) {
    relation_subset(s1, s2) implies
    relation_subset(relation_compose(r, s1), relation_compose(r, s2))
}

theorem relation_intersection_monotone_left[A, B](
    r1: (A, B) -> Bool,
    r2: (A, B) -> Bool,
    s: (A, B) -> Bool
) {
    relation_subset(r1, r2) implies
    relation_subset(relation_intersection(r1, s), relation_intersection(r2, s))
}

theorem relation_intersection_monotone_right[A, B](
    r: (A, B) -> Bool,
    s1: (A, B) -> Bool,
    s2: (A, B) -> Bool
) {
    relation_subset(s1, s2) implies
    relation_subset(relation_intersection(r, s1), relation_intersection(r, s2))
}

theorem relation_union_monotone_left[A, B](
    r1: (A, B) -> Bool,
    r2: (A, B) -> Bool,
    s: (A, B) -> Bool
) {
    relation_subset(r1, r2) implies
    relation_subset(relation_union(r1, s), relation_union(r2, s))
}

theorem relation_union_monotone_right[A, B](
    r: (A, B) -> Bool,
    s1: (A, B) -> Bool,
    s2: (A, B) -> Bool
) {
    relation_subset(s1, s2) implies
    relation_subset(relation_union(r, s1), relation_union(r, s2))
}

theorem relation_converse_subset_iff[A, B](r: (A, B) -> Bool, s: (A, B) -> Bool) {
    relation_subset(relation_converse(r), relation_converse(s)) = relation_subset(r, s)
}

theorem relation_pullback_subset_imp_subset_of_surjective[A, B](
    f: A -> B,
    r: (B, B) -> Bool,
    s: (B, B) -> Bool
) {
    is_surjective_fn(f) and
    relation_subset(relation_pullback(f, r), relation_pullback(f, s)) implies
    relation_subset(r, s)
}

theorem relation_pullback_subset_iff_of_surjective[A, B](
    f: A -> B,
    r: (B, B) -> Bool,
    s: (B, B) -> Bool
) {
    is_surjective_fn(f) implies
    relation_subset(relation_pullback(f, r), relation_pullback(f, s)) = relation_subset(r, s)
}

theorem relation_pushforward_subset_imp_subset_of_injective[A, B](
    f: A -> B,
    r: (A, A) -> Bool,
    s: (A, A) -> Bool
) {
    is_injective_fn(f) and
    relation_subset(relation_pushforward(f, r), relation_pushforward(f, s)) implies
    relation_subset(r, s)
}

theorem relation_pushforward_subset_iff_of_injective[A, B](
    f: A -> B,
    r: (A, A) -> Bool,
    s: (A, A) -> Bool
) {
    is_injective_fn(f) implies
    relation_subset(relation_pushforward(f, r), relation_pushforward(f, s)) = relation_subset(r, s)
}

theorem relation_pullback_subset_iff_of_bijection[A, B](
    f: A -> B,
    r: (B, B) -> Bool,
    s: (B, B) -> Bool
) {
    is_bijection_fn(f) implies
    relation_subset(relation_pullback(f, r), relation_pullback(f, s)) = relation_subset(r, s)
}

theorem relation_pushforward_subset_iff_of_bijection[A, B](
    f: A -> B,
    r: (A, A) -> Bool,
    s: (A, A) -> Bool
) {
    is_bijection_fn(f) implies
    relation_subset(relation_pushforward(f, r), relation_pushforward(f, s)) = relation_subset(r, s)
}

theorem relation_pullback_subset_iff_of_bijection_map[A, B](
    e: Bijection[A, B],
    r: (B, B) -> Bool,
    s: (B, B) -> Bool
) {
    relation_subset(relation_pullback(e.map, r), relation_pullback(e.map, s)) = relation_subset(r, s)
}

theorem relation_pushforward_subset_iff_of_bijection_map[A, B](
    e: Bijection[A, B],
    r: (A, A) -> Bool,
    s: (A, A) -> Bool
) {
    relation_subset(relation_pushforward(e.map, r), relation_pushforward(e.map, s)) = relation_subset(r, s)
}

define is_predecessor_closed_predicate[T](r: (T, T) -> Bool, p: T -> Bool) -> Bool {
    forall(x: T) {
        (forall(y: T) { r(y, x) implies p(y) }) implies p(x)
    }
}

theorem predecessor_closed_predicate_at[T](r: (T, T) -> Bool, p: T -> Bool, x: T) {
    is_predecessor_closed_predicate(r, p) and
    forall(y: T) { r(y, x) implies p(y) } implies p(x)
}

define is_nilpotent[R: Ring](a: R) -> Bool {
    exists(n: Nat) {
        n != Nat.0 and a.pow(n) = R.0
    }
}

theorem nilpotent_zero[R: Ring] {
    is_nilpotent[R](R.0)
}

theorem nilpotent_intro[R: Ring](a: R, n: Nat) {
    n != Nat.0 and a.pow(n) = R.0 implies is_nilpotent[R](a)
}

theorem nilpotent_apply[R: Ring](a: R) {
    is_nilpotent[R](a) implies exists(n: Nat) {
        n != Nat.0 and a.pow(n) = R.0
    }
}

theorem nilpotent_pow[R: Ring](a: R, k: Nat) {
    k != Nat.0 and is_nilpotent[R](a) implies is_nilpotent[R](a.pow(k))
}

define is_semiring_hom[S: Semiring, T: Semiring](f: S -> T) -> Bool {
    is_add_monoid_hom(f) and is_monoid_hom(f)
}

structure SemiringHom[S: Semiring, T: Semiring] {
    /// The mapping for the homomorphism.
    hom: S -> T
} constraint {
    is_semiring_hom(hom)
}

theorem semiring_hom_ext[S: Semiring, T: Semiring](f: SemiringHom[S, T], g: SemiringHom[S, T]) {
    (forall(a: S) { f.hom(a) = g.hom(a) }) implies f = g
}

attributes SemiringHom[S: Semiring, T: Semiring] {
    /// Semiring homomorphism extensionality from pointwise equality of the homomorphism.
    let ext = semiring_hom_ext[S, T]
}

theorem semiring_hom_eq_hom[S: Semiring, T: Semiring](f: SemiringHom[S, T], g: SemiringHom[S, T]) {
    f = g implies f.hom = g.hom
}

theorem semiring_hom_eq_apply[S: Semiring, T: Semiring](f: SemiringHom[S, T], g: SemiringHom[S, T], a: S) {
    f = g implies f.hom(a) = g.hom(a)
}

theorem semiring_hom_eq_transport_predicate[S: Semiring, T: Semiring](
    p: SemiringHom[S, T] -> Bool,
    f: SemiringHom[S, T],
    g: SemiringHom[S, T]
) {
    f = g and p(f) implies p(g)
}

theorem semiring_hom_eq_transport_predicate_rev[S: Semiring, T: Semiring](
    p: SemiringHom[S, T] -> Bool,
    f: SemiringHom[S, T],
    g: SemiringHom[S, T]
) {
    f = g and p(g) implies p(f)
}

theorem semiring_hom_eq_of_hom_eq[S: Semiring, T: Semiring](f: SemiringHom[S, T], g: SemiringHom[S, T]) {
    f.hom = g.hom implies f = g
}

theorem semiring_hom_eq_of_apply_eq[S: Semiring, T: Semiring](f: SemiringHom[S, T], g: SemiringHom[S, T]) {
    (forall(a: S) { f.hom(a) = g.hom(a) }) implies f = g
}

theorem semiring_hom_zero[S: Semiring, T: Semiring](f: SemiringHom[S, T]) {
    f.hom(S.0) = T.0
}

theorem semiring_hom_one[S: Semiring, T: Semiring](f: SemiringHom[S, T]) {
    f.hom(S.1) = T.1
}

theorem semiring_hom_pow[S: Semiring, T: Semiring](f: SemiringHom[S, T], a: S, n: Nat) {
    f.hom(a.pow(n)) = f.hom(a).pow(n)
}

theorem function_eq_transport_semiring_hom[S: Semiring, T: Semiring](f: S -> T, g: S -> T) {
    f = g and is_semiring_hom(f) implies is_semiring_hom(g)
}

theorem function_eq_transport_semiring_hom_rev[S: Semiring, T: Semiring](f: S -> T, g: S -> T) {
    f = g and is_semiring_hom(g) implies is_semiring_hom(f)
}

theorem identity_fn_is_semiring_hom[S: Semiring] {
    is_semiring_hom(identity_fn[S])
}

theorem compose_is_semiring_hom[S: Semiring, T: Semiring, U: Semiring](f: T -> U, g: S -> T) {
    is_semiring_hom(f) and is_semiring_hom(g) implies is_semiring_hom(compose(f, g))
}

let identity_semiring_hom[S: Semiring]: SemiringHom[S, S] satisfy {
    SemiringHom.new(identity_fn[S]) = Option.some(identity_semiring_hom)
}

theorem identity_semiring_hom_hom[S: Semiring] {
    identity_semiring_hom[S].hom = identity_fn[S]
}

let compose_semiring_hom[S: Semiring, T: Semiring, U: Semiring](f: SemiringHom[T, U], g: SemiringHom[S, T]) -> result: SemiringHom[S, U] satisfy {
    SemiringHom.new(compose(f.hom, g.hom)) = Option.some(result)
}

theorem compose_semiring_hom_hom[S: Semiring, T: Semiring, U: Semiring](f: SemiringHom[T, U], g: SemiringHom[S, T]) {
    compose_semiring_hom(f, g).hom = compose(f.hom, g.hom)
}

theorem compose_semiring_hom_assoc[S: Semiring, T: Semiring, U: Semiring, V: Semiring](
    f: SemiringHom[U, V], g: SemiringHom[T, U], h: SemiringHom[S, T]) {
    compose_semiring_hom(compose_semiring_hom(f, g), h) = compose_semiring_hom(f, compose_semiring_hom(g, h))
}

theorem compose_semiring_hom_identity_left[S: Semiring, T: Semiring](f: SemiringHom[S, T]) {
    compose_semiring_hom(identity_semiring_hom[T], f) = f
}

theorem compose_semiring_hom_identity_right[S: Semiring, T: Semiring](f: SemiringHom[S, T]) {
    compose_semiring_hom(f, identity_semiring_hom[S]) = f
}

define is_trivial_add_group_hom_kernel[A: AddGroup, B: AddGroup](f: AddGroupHom[A, B]) -> Bool {
    forall(a: A) {
        f.hom(a) = B.0 implies a = A.0
    }
}

theorem add_group_hom_injective_iff_trivial_kernel[A: AddGroup, B: AddGroup](f: AddGroupHom[A, B]) {
    is_injective_fn(f.hom) = is_trivial_add_group_hom_kernel(f)
}

define ideal_zero_constraint[R: CommRing](contains: R -> Bool) -> Bool {
    contains(R.0)
}

define zero_ideal[R: CommRing](a: R) -> Bool {
    a = R.0
}

define unit_ideal[R: CommRing](a: R) -> Bool {
    true
}

define ideal_subset[R: CommRing](contains_i: R -> Bool, contains_j: R -> Bool) -> Bool {
    forall(x: R) {
        contains_i(x) implies contains_j(x)
    }
}

theorem ideal_subset_refl[R: CommRing](contains: R -> Bool) {
    ideal_subset(contains, contains)
}

theorem ideal_subset_trans[R: CommRing](contains_i: R -> Bool,
                                        contains_j: R -> Bool,
                                        contains_k: R -> Bool) {
    ideal_subset(contains_i, contains_j) and ideal_subset(contains_j, contains_k)
        implies ideal_subset(contains_i, contains_k)
}

theorem ideal_subset_antisymm[R: CommRing](contains_i: R -> Bool,
                                           contains_j: R -> Bool) {
    ideal_subset(contains_i, contains_j) and ideal_subset(contains_j, contains_i)
        implies contains_i = contains_j
}

theorem ideal_eq_iff_subset_both[R: CommRing](contains_i: R -> Bool,
                                              contains_j: R -> Bool) {
    contains_i = contains_j = (ideal_subset(contains_i, contains_j) and ideal_subset(contains_j, contains_i))
}

theorem subset_unit_ideal[R: CommRing](contains: R -> Bool) {
    ideal_subset(contains, unit_ideal[R])
}

define ideal_inter[R: CommRing](contains_i: R -> Bool,
                                contains_j: R -> Bool,
                                x: R) -> Bool {
    contains_i(x) and contains_j(x)
}

theorem ideal_inter_subset_left[R: CommRing](contains_i: R -> Bool,
                                             contains_j: R -> Bool) {
    ideal_subset(ideal_inter[R](contains_i, contains_j), contains_i)
}

theorem ideal_inter_subset_right[R: CommRing](contains_i: R -> Bool,
                                              contains_j: R -> Bool) {
    ideal_subset(ideal_inter[R](contains_i, contains_j), contains_j)
}

theorem ideal_inter_glb[R: CommRing](contains_i: R -> Bool,
                                     contains_j: R -> Bool,
                                     contains_k: R -> Bool) {
    ideal_subset(contains_k, contains_i) and ideal_subset(contains_k, contains_j)
        implies ideal_subset(contains_k, ideal_inter[R](contains_i, contains_j))
}

theorem ideal_subset_inter_iff[R: CommRing](contains_k: R -> Bool,
                                           contains_i: R -> Bool,
                                           contains_j: R -> Bool) {
    ideal_subset(contains_k, ideal_inter[R](contains_i, contains_j)) =
        (ideal_subset(contains_k, contains_i) and ideal_subset(contains_k, contains_j))
}

theorem ideal_inter_comm[R: CommRing](contains_i: R -> Bool,
                                      contains_j: R -> Bool) {
    ideal_inter[R](contains_i, contains_j) = ideal_inter[R](contains_j, contains_i)
}

theorem ideal_inter_assoc[R: CommRing](contains_i: R -> Bool,
                                       contains_j: R -> Bool,
                                       contains_k: R -> Bool) {
    ideal_inter[R](contains_i, ideal_inter[R](contains_j, contains_k)) =
        ideal_inter[R](ideal_inter[R](contains_i, contains_j), contains_k)
}

theorem ideal_inter_idempotent[R: CommRing](contains: R -> Bool) {
    ideal_inter[R](contains, contains) = contains
}

theorem ideal_inter_eq_left_of_subset[R: CommRing](contains_i: R -> Bool,
                                                   contains_j: R -> Bool) {
    ideal_subset(contains_i, contains_j) implies ideal_inter[R](contains_i, contains_j) = contains_i
}

theorem ideal_inter_eq_right_of_subset[R: CommRing](contains_i: R -> Bool,
                                                    contains_j: R -> Bool) {
    ideal_subset(contains_j, contains_i) implies ideal_inter[R](contains_i, contains_j) = contains_j
}

theorem unit_ideal_inter_left[R: CommRing](contains: R -> Bool) {
    ideal_inter[R](unit_ideal[R], contains) = contains
}

theorem unit_ideal_inter_right[R: CommRing](contains: R -> Bool) {
    ideal_inter[R](contains, unit_ideal[R]) = contains
}

define ideal_proper_constraint[R: CommRing](contains: R -> Bool) -> Bool {
    not contains(R.1)
}

theorem add_monoid_hom_kernel_respects_add[A: AddMonoid, B: AddMonoid](f: A -> B) {
    is_add_monoid_hom(f) implies respects_add(kernel_relation(f))
}

theorem add_monoid_hom_kernel_is_add_congruence[A: AddMonoid, B: AddMonoid](f: A -> B) {
    is_add_monoid_hom(f) implies is_add_congruence(kernel_relation(f))
}

theorem add_monoid_hom_kernel_zero[A: AddMonoid, B: AddMonoid](f: A -> B, a: A) {
    is_add_monoid_hom(f) and f(a) = B.0 implies kernel_relation(f, a, A.0)
}

theorem add_group_hom_kernel_respects_add[A: AddGroup, B: AddGroup](f: AddGroupHom[A, B]) {
    respects_add(kernel_relation(f.hom))
}

theorem add_group_hom_kernel_is_add_congruence[A: AddGroup, B: AddGroup](f: AddGroupHom[A, B]) {
    is_add_congruence(kernel_relation(f.hom))
}

theorem monoid_hom_kernel_respects_mul[M: Monoid, N: Monoid](f: MonoidHom[M, N]) {
    respects_mul(kernel_relation(f.hom))
}

theorem monoid_hom_kernel_is_mul_congruence[M: Monoid, N: Monoid](f: MonoidHom[M, N]) {
    is_mul_congruence(kernel_relation(f.hom))
}

define is_semiring_congruence[S: Semiring](r: (S, S) -> Bool) -> Bool {
    is_add_congruence(r) and is_mul_congruence(r)
}

theorem semiring_hom_kernel_respects_add[S: Semiring, T: Semiring](f: SemiringHom[S, T]) {
    respects_add(kernel_relation(f.hom))
}

theorem semiring_hom_kernel_respects_mul[S: Semiring, T: Semiring](f: SemiringHom[S, T]) {
    respects_mul(kernel_relation(f.hom))
}

theorem semiring_hom_kernel_is_add_congruence[S: Semiring, T: Semiring](f: SemiringHom[S, T]) {
    is_add_congruence(kernel_relation(f.hom))
}

theorem semiring_hom_kernel_is_mul_congruence[S: Semiring, T: Semiring](f: SemiringHom[S, T]) {
    is_mul_congruence(kernel_relation(f.hom))
}

theorem semiring_hom_kernel_is_semiring_congruence[S: Semiring, T: Semiring](f: SemiringHom[S, T]) {
    is_semiring_congruence(kernel_relation(f.hom))
}

define is_ring_congruence[R: Ring](r: (R, R) -> Bool) -> Bool {
    is_add_congruence(r) and is_mul_congruence(r)
}

define add_group_hom_kernel_quotient_zero[A: AddGroup, B: AddGroup](f: AddGroupHom[A, B]) -> QuotientOver[A] {
