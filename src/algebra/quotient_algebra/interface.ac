define function_pair_apply[T, A, B](p: Pair[T -> A, T -> B], t: T) -> Pair[A, B] {
    Pair.new(p.first(t), p.second(t))
}

define function_pair[T, A, B](f: T -> A, g: T -> B) -> Pair[T -> A, T -> B] {
    Pair.new(f, g)
}

define function_pair_add[T, A: Add, B: Add](
    p: Pair[T -> A, T -> B],
    q: Pair[T -> A, T -> B]
