) {
    is_well_founded_recursive_solution(
        r,
        well_founded_nonrecursive_step(value),
        well_founded_nonrecursive_function(value)
    )
}

theorem well_founded_nonrecursive_solution_exists[T, U](
    r: (T, T) -> Bool,
    value: T -> U
) {
