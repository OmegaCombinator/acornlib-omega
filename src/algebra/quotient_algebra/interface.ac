theorem add_subgroup_image_subset_of_subset[A: AddGroup, B: AddGroup](
    f: AddGroupHom[A, B],
    s: AddSubgroup[A],
    t: AddSubgroup[A]
) {
    add_subgroup_subset(s, t) implies
        add_subgroup_subset(add_subgroup_image(f, s), add_subgroup_image(f, t))
}

define add_group_hom_kernel[A: AddGroup, B: AddGroup](f: AddGroupHom[A, B]) -> AddSubgroup[A] {
    add_subgroup_preimage(f, zero_add_subgroup[B])
}

theorem pow_two_mul_comm_ring[R: CommRing](x: R) {
    x.pow(Nat.2) = x * x
}

theorem pow_three_mul_comm_ring[R: CommRing](x: R) {
    x.pow(Nat.3) = x * x * x
}

theorem two_mul_comm_ring[R: CommRing](x: R) {
    (R.1 + R.1) * x = x + x
}

theorem three_mul_comm_ring[R: CommRing](x: R) {
    (R.1 + R.1 + R.1) * x = x + (x + x)
}

theorem square_add_expand_comm_ring[R: CommRing](u: R, v: R) {
    (u + v) * (u + v) = u * u + (R.1 + R.1) * u * v + v * v
}

theorem square_add_expand_raw_comm_ring[R: CommRing](u: R, v: R) {
    (u + v) * (u + v) = u * u + (u * v + u * v) + v * v
}

theorem square_add_pow_comm_ring[R: CommRing](u: R, v: R) {
    (u + v).pow(Nat.2) = u.pow(Nat.2) + (R.1 + R.1) * u * v + v.pow(Nat.2)
}

theorem left_cube_raw_comm_ring[R: CommRing](u: R, v: R) {
    (u * u + (u * v + u * v) + v * v) * (u + v) =
    ((u * u) * u + (u * u) * v) +
    (((u * v) * u + (u * v) * u) +
     ((u * v) * v + (u * v) * v) +
     ((v * v) * u + (v * v) * v))
}

theorem regroup_three_pairs_comm_ring[R: CommRing](a: R, b: R) {
    (a + b) + ((a + b) + (a + b)) = (a + (a + a)) + (b + (b + b))
}

theorem regroup_three_pairs_left_assoc_comm_ring[R: CommRing](a: R, b: R) {
    (a + b) + (a + b) + (a + b) = (a + (a + a)) + (b + (b + b))
}

theorem three_uv_raw_comm_ring[R: CommRing](u: R, v: R) {
    (((R.1 + R.1 + R.1) * u * v) * (u + v)) =
    ((u * v) * u + ((u * v) * u + (u * v) * u)) +
    ((u * v) * v + ((u * v) * v + (u * v) * v))
}

theorem add_regroup_six_comm_ring[R: CommRing](x: R, y: R, a: R, b: R) {
    (x + a) + (((a + a) + (b + b)) + (b + y)) =
    x + y + ((a + (a + a)) + (b + (b + b)))
}

theorem raw_cube_regroup_comm_ring[R: CommRing](u: R, v: R) {
    ((u * u) * u + (u * u) * v) +
    (((u * v) * u + (u * v) * u) +
     ((u * v) * v + (u * v) * v) +
     ((v * v) * u + (v * v) * v)) =
    u * u * u + v * v * v + (((R.1 + R.1 + R.1) * u * v) * (u + v))
}

theorem cube_add_expanded_square_comm_ring[R: CommRing](u: R, v: R) {
    (u * u + (u * v + u * v) + v * v) * (u + v) =
    u * u * u + v * v * v + (((R.1 + R.1 + R.1) * u * v) * (u + v))
}

theorem cube_add_cardano_mul_comm_ring[R: CommRing](u: R, v: R) {
    (u + v) * (u + v) * (u + v) =
    u * u * u + v * v * v + (((R.1 + R.1 + R.1) * u * v) * (u + v))
}

theorem cube_add_cardano_comm_ring[R: CommRing](u: R, v: R) {
    (u + v).pow(Nat.3) =
    u.pow(Nat.3) + v.pow(Nat.3) + (((R.1 + R.1 + R.1) * u * v) * (u + v))
}

theorem cardano_depressed_cubic_substitution_comm_ring[R: CommRing](u: R, v: R, p: R, q: R) {
    ((R.1 + R.1 + R.1) * u * v + p = R.0 and
     u.pow(Nat.3) + v.pow(Nat.3) + q = R.0) implies
    (u + v).pow(Nat.3) + p * (u + v) + q = R.0
}

theorem square_four_terms_comm_ring[R: CommRing](u: R, v: R) {
    (u + v) * (u + v) = u * u + u * v + v * u + v * v
}

theorem four_terms_mul_comm_ring[R: CommRing](a: R, b: R, c: R, d: R, x: R) {
    (a + b + c + d) * x = a * x + b * x + c * x + d * x
}

theorem triple_uv_factor_comm_ring[R: CommRing](u: R, v: R) {
    ((R.1 + R.1 + R.1) * u * v) * (u + v) =
    u * u * v + u * v * u + v * u * u + u * v * v + v * u * v + v * v * u
}

theorem unique_inverse[F: Field](a: F, b: F) {
    a * b = F.1 implies b = a.inverse
}

theorem inverse_inverse_field[F: Field](a: F) {
    a.inverse.inverse = a
}

theorem mul_inverse_right[F: Field](a: F) {
    a != F.0 implies a * a.inverse = F.1
}

theorem mul_inverse_left[F: Field](a: F) {
    a != F.0 implies a.inverse * a = F.1
}

theorem inverse_one[F: Field] {
    F.1.inverse = F.1
}

theorem mul_inverse_cancel_right[F: Field](a: F, b: F) {
    a != F.0 implies b * a * a.inverse = b
}

theorem mul_inverse_cancel_left[F: Field](a: F, b: F) {
    a != F.0 implies a.inverse * (a * b) = b
}

theorem inverse_dist[F: Field](a: F, b: F) {
    (a * b).inverse = a.inverse * b.inverse
}

theorem pow_nat_times_inverse[F: Field](a: F, n: Nat) {
   a != F.0 implies a.pow(n.suc) * a.inverse = a.pow(n)
}

theorem pow_nat_sub_inverse[F: Field](a: F, n: Nat, m: Nat) {
    a != F.0 and m <= n implies a.pow(n) * a.inverse.pow(m) = a.pow(n - m)
}

theorem inverse_not_zero[F: Field](a: F) {
    a != F.0 implies a.inverse != F.0
}

theorem mul_not_zero[F: Field](a: F, b: F) {
    a != F.0 and b != F.0 implies a * b != F.0
}

theorem field_mul_nonzero[F: Field](a: F, b: F) {
    a != F.0 and b != F.0 implies a * b != F.0
}

theorem field_square_nonzero[F: Field](a: F) {
    a != F.0 implies a * a != F.0
}

theorem field_left_nonzero_of_mul_nonzero[F: Field](a: F, b: F) {
    a * b != F.0 implies a != F.0
}

theorem field_right_nonzero_of_mul_nonzero[F: Field](a: F, b: F) {
    a * b != F.0 implies b != F.0
}

theorem field_mul_eq_zero[F: Field](a: F, b: F) {
    a * b = F.0 implies a = F.0 or b = F.0
}

theorem field_mul_eq_zero_of_factor[F: Field](a: F, b: F) {
    a = F.0 or b = F.0 implies a * b = F.0
}

theorem pow_not_zero[F: Field](a: F, n: Nat) {
    a != F.0 implies a.pow(n) != F.0
}

define gf4_add(x: GF4, y: GF4) -> GF4 {
    match x {
        GF4.zero {
            match y {
                GF4.zero { GF4.zero }
                GF4.one { GF4.one }
                GF4.x { GF4.x }
                GF4.x_plus_one { GF4.x_plus_one }
            }
        }
        GF4.one {
            match y {
                GF4.zero { GF4.one }
                GF4.one { GF4.zero }
                GF4.x { GF4.x_plus_one }
                GF4.x_plus_one { GF4.x }
            }
        }
        GF4.x {
            match y {
                GF4.zero { GF4.x }
                GF4.one { GF4.x_plus_one }
                GF4.x { GF4.zero }
                GF4.x_plus_one { GF4.one }
            }
        }
        GF4.x_plus_one {
            match y {
                GF4.zero { GF4.x_plus_one }
                GF4.one { GF4.x }
                GF4.x { GF4.one }
                GF4.x_plus_one { GF4.zero }
            }
        }
    }
}

