define gf4_mul(x: GF4, y: GF4) -> GF4 {
    match x {
        GF4.zero {
            match y {
                GF4.zero { GF4.zero }
                GF4.one { GF4.zero }
                GF4.x { GF4.zero }
                GF4.x_plus_one { GF4.zero }
            }
        }
        GF4.one {
            match y {
                GF4.zero { GF4.zero }
                GF4.one { GF4.one }
