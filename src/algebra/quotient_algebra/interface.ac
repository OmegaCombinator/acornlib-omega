theorem noetherian_relation_has_maximal[T](r: (T, T) -> Bool, p: T -> Bool) {
    is_noetherian_relation(r) and exists(x: T) { p(x) } implies exists(m: T) {
        p(m) and forall(y: T) {
            r(m, y) implies not p(y)
        }
    }
}

