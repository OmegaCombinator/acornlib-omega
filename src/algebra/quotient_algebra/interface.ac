    IdealQuotient[R, i].new(ideal_quotient_add(i, x.val, y.val)) = Option.some(result)
}

let ideal_quotient_type_mul[R: CommRing](i: Ideal[R], x: IdealQuotient[R, i], y: IdealQuotient[R, i]) -> result: IdealQuotient[R, i] satisfy {
