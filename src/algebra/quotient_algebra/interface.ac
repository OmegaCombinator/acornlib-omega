                GF4.x { GF4.x_plus_one }
                GF4.x_plus_one { GF4.one }
            }
        }
        GF4.x_plus_one {
            match y {
                GF4.zero { GF4.zero }
                GF4.one { GF4.x_plus_one }
                GF4.x { GF4.one }
                GF4.x_plus_one { GF4.x }
