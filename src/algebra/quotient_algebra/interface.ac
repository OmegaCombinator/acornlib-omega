define add_subgroup_image_contains[A: AddGroup, B: AddGroup](
    f: AddGroupHom[A, B],
    s: AddSubgroup[A],
    y: B
) -> Bool {
    exists(x: A) {
        s.contains(x) and y = f.hom(x)
    }
}

theorem add_subgroup_image_contains_zero[A: AddGroup, B: AddGroup](
    f: AddGroupHom[A, B],
    s: AddSubgroup[A]
) {
    add_subgroup_image_contains(f, s, B.0)
