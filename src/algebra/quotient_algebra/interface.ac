theorem pair_typeclass_add_eq_pair_add[A: Add, B: Add](p: Pair[A, B], q: Pair[A, B]) {
    p + q = pair_add(p, q)
}

theorem pair_typeclass_mul_eq_pair_mul[A: Mul, B: Mul](p: Pair[A, B], q: Pair[A, B]) {
    p * q = pair_mul(p, q)
