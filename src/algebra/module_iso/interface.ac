theorem subfield_preimage_inter[F: Field, E: Field](phi: FieldHom[F, E], s: Subfield[E], t: Subfield[E]) {
    subfield_preimage(phi, subfield_inter(s, t)) = subfield_inter(subfield_preimage(phi, s), subfield_preimage(phi, t))
