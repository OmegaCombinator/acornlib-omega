theorem submonoid_sup_assoc[M: Monoid](
    a: Submonoid[M],
    b: Submonoid[M],
    c: Submonoid[M]
) {
    submonoid_sup(submonoid_sup(a, b), c) = submonoid_sup(a, submonoid_sup(b, c))
}

theorem set_subset_submonoid_union[M: Monoid](a: Set[M], b: Set[M], s: Submonoid[M]) {
    set_subset_submonoid(a, s) and set_subset_submonoid(b, s) implies
        set_subset_submonoid(a.union(b), s)
}

theorem set_subset_submonoid_left_closure_sup[M: Monoid](a: Set[M], b: Set[M]) {
    set_subset_submonoid(a, submonoid_sup(submonoid_closure(a), submonoid_closure(b)))
}

theorem set_subset_submonoid_right_closure_sup[M: Monoid](a: Set[M], b: Set[M]) {
    set_subset_submonoid(b, submonoid_sup(submonoid_closure(a), submonoid_closure(b)))
}

theorem submonoid_closure_union_is_finitely_generated[M: Monoid](a: Set[M], b: Set[M]) {
    a.is_finite and b.is_finite implies
        submonoid_is_finitely_generated(submonoid_closure(a.union(b)))
}

theorem submonoid_sup_of_closure_finite_sets_eq_closure_union[M: Monoid](a: Set[M], b: Set[M]) {
    submonoid_sup(submonoid_closure(a), submonoid_closure(b)) = submonoid_closure(a.union(b))
}

theorem submonoid_sup_of_closure_finite_sets_is_finitely_generated[M: Monoid](a: Set[M], b: Set[M]) {
    a.is_finite and b.is_finite implies
        submonoid_is_finitely_generated(submonoid_sup(submonoid_closure(a), submonoid_closure(b)))
}

theorem submonoid_sup_is_finitely_generated[M: Monoid](s: Submonoid[M], t: Submonoid[M]) {
    submonoid_is_finitely_generated(s) and submonoid_is_finitely_generated(t) implies
        submonoid_is_finitely_generated(submonoid_sup(s, t))
}

theorem submonoid_sup_eq_closure_union_of_closure_eq[M: Monoid](
    a: Set[M],
    b: Set[M],
    s: Submonoid[M],
    t: Submonoid[M]
) {
    submonoid_closure(a) = s and submonoid_closure(b) = t implies
        submonoid_sup(s, t) = submonoid_closure(a.union(b))
}

theorem submonoid_sup_of_finite_generating_sets_is_finitely_generated[M: Monoid](
    a: Set[M],
    b: Set[M],
    s: Submonoid[M],
    t: Submonoid[M]
) {
    a.is_finite and b.is_finite and submonoid_closure(a) = s and submonoid_closure(b) = t implies
        submonoid_is_finitely_generated(submonoid_sup(s, t))
}

theorem submonoid_subset_contains_eq[M: Monoid](a: Submonoid[M], b: Submonoid[M]) {
    submonoid_subset(a, b) = forall(x: M) {
        a.contains(x) implies b.contains(x)
    }
}

theorem submonoid_subset_contains[M: Monoid](a: Submonoid[M], b: Submonoid[M], x: M) {
    submonoid_subset(a, b) and a.contains(x) implies b.contains(x)
}

theorem submonoid_subset_of_contains[M: Monoid](a: Submonoid[M], b: Submonoid[M]) {
    (forall(x: M) { a.contains(x) implies b.contains(x) }) implies submonoid_subset(a, b)
}

theorem submonoid_order_subset_refl[M: Monoid](a: Submonoid[M]) {
    submonoid_subset(a, a)
}

theorem submonoid_order_subset_trans[M: Monoid](
    a: Submonoid[M],
    b: Submonoid[M],
    c: Submonoid[M]
) {
    submonoid_subset(a, b) and submonoid_subset(b, c) implies submonoid_subset(a, c)
}

theorem submonoid_order_subset_antisymm[M: Monoid](a: Submonoid[M], b: Submonoid[M]) {
    submonoid_subset(a, b) and submonoid_subset(b, a) implies a = b
}

theorem submonoid_subset_as_set_iff[M: Monoid](a: Submonoid[M], b: Submonoid[M]) {
    submonoid_subset(a, b) = a.as_set.subset(b.as_set)
}

theorem submonoid_as_set_subset_contains[M: Monoid](a: Submonoid[M], b: Submonoid[M], x: M) {
    a.as_set.subset(b.as_set) and a.contains(x) implies b.contains(x)
}

theorem submonoid_intersection_greatest_lower_bound[M: Monoid](
    c: Submonoid[M],
    a: Submonoid[M],
    b: Submonoid[M]
) {
    submonoid_subset(c, a.intersection(b)) = (submonoid_subset(c, a) and submonoid_subset(c, b))
}

theorem submonoid_subset_left_of_subset_intersection[M: Monoid](
    c: Submonoid[M],
    a: Submonoid[M],
    b: Submonoid[M]
) {
    submonoid_subset(c, a.intersection(b)) implies submonoid_subset(c, a)
}

theorem submonoid_subset_right_of_subset_intersection[M: Monoid](
    c: Submonoid[M],
    a: Submonoid[M],
    b: Submonoid[M]
) {
    submonoid_subset(c, a.intersection(b)) implies submonoid_subset(c, b)
}

theorem submonoid_subset_intersection_of_subset_both[M: Monoid](
    c: Submonoid[M],
    a: Submonoid[M],
    b: Submonoid[M]
) {
    submonoid_subset(c, a) and submonoid_subset(c, b) implies submonoid_subset(c, a.intersection(b))
}

theorem submonoid_closure_monotone[M: Monoid](a: Set[M], b: Set[M]) {
    a.subset(b) implies submonoid_subset(submonoid_closure(a), submonoid_closure(b))
}

theorem submonoid_closure_subset_iff_as_set_subset[M: Monoid](a: Set[M], s: Submonoid[M]) {
    submonoid_subset(submonoid_closure(a), s) = a.subset(s.as_set)
}

theorem submonoid_subset_antisymm_iff_eq[M: Monoid](a: Submonoid[M], b: Submonoid[M]) {
    (submonoid_subset(a, b) and submonoid_subset(b, a)) = (a = b)
}

theorem submonoid_intersection_mono_left[M: Monoid](
    a: Submonoid[M],
    b: Submonoid[M],
    c: Submonoid[M]
) {
    submonoid_subset(a, b) implies submonoid_subset(a.intersection(c), b.intersection(c))
}

theorem submonoid_intersection_mono_right[M: Monoid](
    a: Submonoid[M],
    b: Submonoid[M],
    c: Submonoid[M]
) {
    submonoid_subset(a, b) implies submonoid_subset(c.intersection(a), c.intersection(b))
}

theorem submonoid_intersection_mono[M: Monoid](
    a: Submonoid[M],
    b: Submonoid[M],
    c: Submonoid[M],
    d: Submonoid[M]
) {
    submonoid_subset(a, b) and submonoid_subset(c, d) implies
        submonoid_subset(a.intersection(c), b.intersection(d))
}

theorem submonoid_sup_mono_left[M: Monoid](
    a: Submonoid[M],
    b: Submonoid[M],
    c: Submonoid[M]
) {
    submonoid_subset(a, b) implies submonoid_subset(submonoid_sup(a, c), submonoid_sup(b, c))
}

theorem submonoid_sup_mono_right[M: Monoid](
    a: Submonoid[M],
    b: Submonoid[M],
    c: Submonoid[M]
) {
    submonoid_subset(a, b) implies submonoid_subset(submonoid_sup(c, a), submonoid_sup(c, b))
}

theorem submonoid_sup_mono[M: Monoid](
    a: Submonoid[M],
    b: Submonoid[M],
    c: Submonoid[M],
    d: Submonoid[M]
) {
    submonoid_subset(a, b) and submonoid_subset(c, d) implies
        submonoid_subset(submonoid_sup(a, c), submonoid_sup(b, d))
}

theorem submonoid_closure_eq_of_mutual_as_set_subset[M: Monoid](a: Set[M], b: Set[M]) {
    a.subset(submonoid_closure(b).as_set) and b.subset(submonoid_closure(a).as_set) implies
        submonoid_closure(a) = submonoid_closure(b)
}

define identity_constraint[G: Group](contains: G -> Bool) -> Bool {
    contains(G.1)
}

define closure_constraint[G: Group](contains: G -> Bool) -> Bool {
    forall(a: G, b: G) {
        contains(a) and contains(b) implies contains(a * b)
    }
}

define inverse_constraint[G: Group](contains: G -> Bool) -> Bool {
    forall(a: G) {
        contains(a) implies contains(a.inverse)
    }
}

define subgroup_constraint[G: Group](contains: G -> Bool) -> Bool {
    identity_constraint(contains) and closure_constraint(contains) and inverse_constraint(contains)
}

structure Subgroup[G: Group] {
    /// True if the given element is a member of this subgroup.
    contains: G -> Bool
} constraint {
    subgroup_constraint(contains)
}

define is_identity[G: Group](g: G) -> Bool {
    g = G.1
}

theorem identity_subgroup_constraint[G: Group] {
    subgroup_constraint(is_identity[G])
}

theorem subgroup_ext[G: Group](a: Subgroup[G], b: Subgroup[G]) {
    (forall(x: G) { a.contains(x) = b.contains(x) }) implies a = b
}

theorem subgroup_eq_contains[G: Group](a: Subgroup[G], b: Subgroup[G]) {
    a = b implies a.contains = b.contains
}

theorem subgroup_eq_contains_at[G: Group](a: Subgroup[G], b: Subgroup[G], x: G) {
    a = b implies a.contains(x) = b.contains(x)
}

theorem subgroup_eq_transport_predicate[G: Group](
    p: Subgroup[G] -> Bool,
    a: Subgroup[G],
    b: Subgroup[G]
) {
    a = b and p(a) implies p(b)
}

theorem subgroup_eq_transport_predicate_rev[G: Group](
    p: Subgroup[G] -> Bool,
    a: Subgroup[G],
    b: Subgroup[G]
) {
    a = b and p(b) implies p(a)
}

theorem subgroup_eq_of_contains_eq[G: Group](a: Subgroup[G], b: Subgroup[G]) {
    a.contains = b.contains implies a = b
}

theorem subgroup_eq_of_contains_at_eq[G: Group](a: Subgroup[G], b: Subgroup[G]) {
    (forall(x: G) { a.contains(x) = b.contains(x) }) implies a = b
}

theorem subgroup_contains_identity[G: Group](s: Subgroup[G]) {
    s.contains(G.1)
}

theorem subgroup_mul_mem[G: Group](s: Subgroup[G], a: G, b: G) {
    s.contains(a) and s.contains(b) implies s.contains(a * b)
}

theorem subgroup_inv_mem[G: Group](s: Subgroup[G], a: G) {
    s.contains(a) implies s.contains(a.inverse)
}

theorem subgroup_contains_inverse_iff[G: Group](s: Subgroup[G], a: G) {
    s.contains(a.inverse) = s.contains(a)
}

theorem subgroup_mul_inv_mem[G: Group](s: Subgroup[G], a: G, b: G) {
    s.contains(a) and s.contains(b) implies s.contains(a * b.inverse)
}

theorem subgroup_inv_mul_mem[G: Group](s: Subgroup[G], a: G, b: G) {
    s.contains(a) and s.contains(b) implies s.contains(a.inverse * b)
}

theorem same_left_coset_raw_reflexive[G: Group](s: Subgroup[G], a: G) {
    s.contains(a.inverse * a)
}

theorem same_left_coset_raw_symmetric[G: Group](s: Subgroup[G], a: G, b: G) {
    s.contains(a.inverse * b) implies s.contains(b.inverse * a)
}

theorem same_left_coset_raw_transitive[G: Group](s: Subgroup[G], a: G, b: G, c: G) {
    s.contains(a.inverse * b) and s.contains(b.inverse * c) implies s.contains(a.inverse * c)
}

theorem left_coset_intersection_witness_implies_same_representative_raw[G: Group](
    s: Subgroup[G],
    a: G,
    b: G,
    x: G
) {
    s.contains(a.inverse * x) and s.contains(b.inverse * x) implies s.contains(a.inverse * b)
}

theorem same_representative_implies_left_coset_membership_eq_raw[G: Group](
    s: Subgroup[G],
    a: G,
    b: G,
    y: G
) {
    s.contains(a.inverse * b) implies s.contains(a.inverse * y) = s.contains(b.inverse * y)
}

theorem intersecting_left_cosets_equal_raw[G: Group](s: Subgroup[G], a: G, b: G) {
    exists(x: G) {
        s.contains(a.inverse * x) and s.contains(b.inverse * x)
    } implies forall(y: G) {
        s.contains(a.inverse * y) = s.contains(b.inverse * y)
    }
}

theorem subgroup_mul_mul_mem[G: Group](s: Subgroup[G], a: G, b: G, c: G) {
    s.contains(a) and s.contains(b) and s.contains(c) implies s.contains(a * b * c)
}

theorem subgroup_conj_mem[G: Group](s: Subgroup[G], a: G, b: G) {
    s.contains(a) and s.contains(b) implies s.contains(a * b * a.inverse)
}

theorem subgroup_pow_mem[G: Group](s: Subgroup[G], a: G, n: Nat) {
    s.contains(a) implies s.contains(a.pow(n))
}

define subgroup_intersection_contains[G: Group](a: Subgroup[G], b: Subgroup[G], x: G) -> Bool {
    a.contains(x) and b.contains(x)
}

theorem subgroup_intersection_identity_constraint[G: Group](a: Subgroup[G], b: Subgroup[G]) {
    identity_constraint(subgroup_intersection_contains(a, b))
}

theorem subgroup_intersection_closure_constraint[G: Group](a: Subgroup[G], b: Subgroup[G]) {
    closure_constraint(subgroup_intersection_contains(a, b))
}

theorem subgroup_intersection_inverse_constraint[G: Group](a: Subgroup[G], b: Subgroup[G]) {
    inverse_constraint(subgroup_intersection_contains(a, b))
}

theorem subgroup_intersection_constraint[G: Group](a: Subgroup[G], b: Subgroup[G]) {
    subgroup_constraint(subgroup_intersection_contains(a, b))
}

let subgroup_intersection[G: Group](a: Subgroup[G], b: Subgroup[G]) -> result: Subgroup[G] satisfy {
    Subgroup.new(subgroup_intersection_contains(a, b)) = Option.some(result)
}

attributes Subgroup[G: Group] {
    /// Subgroup extensionality from pointwise equality of membership.
    let ext = subgroup_ext[G]

    /// The subset of group elements belonging to this subgroup.
    define as_set(self) -> Set[G] {
        Set[G].new(self.contains)
    }

    /// The common part of two subgroups.
    let intersection: (Subgroup[G], Subgroup[G]) -> Subgroup[G] = subgroup_intersection
}

theorem subgroup_as_set_contains_eq[G: Group](s: Subgroup[G], x: G) {
    s.as_set.contains(x) = s.contains(x)
}

theorem subgroup_contains_as_set_eq[G: Group](s: Subgroup[G], x: G) {
    s.contains(x) = s.as_set.contains(x)
}

theorem subgroup_eq_as_set[G: Group](a: Subgroup[G], b: Subgroup[G]) {
    a = b implies a.as_set = b.as_set
}

theorem subgroup_intersection_contains_eq[G: Group](a: Subgroup[G], b: Subgroup[G], x: G) {
    a.intersection(b).contains(x) = (a.contains(x) and b.contains(x))
}

theorem subgroup_intersection_subset_left[G: Group](a: Subgroup[G], b: Subgroup[G], x: G) {
    a.intersection(b).contains(x) implies a.contains(x)
}

theorem subgroup_intersection_subset_right[G: Group](a: Subgroup[G], b: Subgroup[G], x: G) {
    a.intersection(b).contains(x) implies b.contains(x)
}

theorem subgroup_intersection_comm[G: Group](a: Subgroup[G], b: Subgroup[G]) {
    a.intersection(b) = b.intersection(a)
}

theorem subgroup_intersection_assoc[G: Group](
    a: Subgroup[G],
    b: Subgroup[G],
    c: Subgroup[G]
) {
    a.intersection(b).intersection(c) = a.intersection(b.intersection(c))
}

theorem subgroup_intersection_idempotent[G: Group](a: Subgroup[G]) {
    a.intersection(a) = a
}

define subgroup_subset[G: Group](a: Subgroup[G], b: Subgroup[G]) -> Bool {
    forall(x: G) {
        a.contains(x) implies b.contains(x)
    }
}

theorem subgroup_subset_as_set_eq[G: Group](a: Subgroup[G], b: Subgroup[G]) {
    subgroup_subset(a, b) = a.as_set.subset(b.as_set)
}

theorem subgroup_as_set_subset_of_subset[G: Group](a: Subgroup[G], b: Subgroup[G]) {
    subgroup_subset(a, b) implies a.as_set.subset(b.as_set)
}

theorem subgroup_subset_of_as_set_subset[G: Group](a: Subgroup[G], b: Subgroup[G]) {
    a.as_set.subset(b.as_set) implies subgroup_subset(a, b)
}

theorem subgroup_subset_refl[G: Group](a: Subgroup[G]) {
    subgroup_subset(a, a)
}

theorem subgroup_subset_trans[G: Group](a: Subgroup[G], b: Subgroup[G], c: Subgroup[G]) {
    subgroup_subset(a, b) and subgroup_subset(b, c) implies subgroup_subset(a, c)
}

theorem subgroup_intersection_subset_left_relation[G: Group](a: Subgroup[G], b: Subgroup[G]) {
    subgroup_subset(a.intersection(b), a)
}

theorem subgroup_intersection_subset_right_relation[G: Group](a: Subgroup[G], b: Subgroup[G]) {
    subgroup_subset(a.intersection(b), b)
}

theorem subgroup_subset_intersection_of_subset_left_right[G: Group](
    c: Subgroup[G], a: Subgroup[G], b: Subgroup[G]
) {
    subgroup_subset(c, a) and subgroup_subset(c, b) implies subgroup_subset(c, a.intersection(b))
}

theorem subgroup_subset_intersection_iff[G: Group](c: Subgroup[G], a: Subgroup[G], b: Subgroup[G]) {
    subgroup_subset(c, a.intersection(b)) = (subgroup_subset(c, a) and subgroup_subset(c, b))
}

let identity_subgroup[G: Group]: Subgroup[G] satisfy {
    Subgroup.new(is_identity[G]) = Option.some(identity_subgroup)
}

theorem identity_subgroup_only_has_identity[G: Group](g: G) {
    identity_subgroup[G].contains(g) implies g = G.1
}

theorem identity_subgroup_contains_eq[G: Group](g: G) {
    identity_subgroup[G].contains(g) = (g = G.1)
}

theorem identity_subgroup_subset[G: Group](s: Subgroup[G]) {
    subgroup_subset(identity_subgroup[G], s)
}

define full_group_contains[G: Group](a: G) -> Bool {
    true
}

theorem full_subgroup_constraint[G: Group] {
    subgroup_constraint(full_group_contains[G])
}

let full_subgroup[G: Group]: Subgroup[G] satisfy {
    Subgroup.new(full_group_contains[G]) = Option.some(full_subgroup)
}

theorem full_subgroup_contains_everything[G: Group](g: G) {
    full_subgroup[G].contains(g)
}

theorem full_subgroup_contains_eq[G: Group](g: G) {
    full_subgroup[G].contains(g) = true
}

theorem subgroup_subset_full[G: Group](s: Subgroup[G]) {
    subgroup_subset(s, full_subgroup[G])
}

theorem subgroup_subset_antisymm[G: Group](a: Subgroup[G], b: Subgroup[G]) {
    subgroup_subset(a, b) and subgroup_subset(b, a) implies a = b
}

theorem subgroup_eq_iff_subset_both[G: Group](a: Subgroup[G], b: Subgroup[G]) {
    a = b = (subgroup_subset(a, b) and subgroup_subset(b, a))
}

theorem subgroup_intersection_eq_left_of_subset[G: Group](a: Subgroup[G], b: Subgroup[G]) {
    subgroup_subset(a, b) implies a.intersection(b) = a
}

theorem subgroup_intersection_eq_right_of_subset[G: Group](a: Subgroup[G], b: Subgroup[G]) {
    subgroup_subset(b, a) implies a.intersection(b) = b
}

theorem identity_subgroup_intersection_right[G: Group](s: Subgroup[G]) {
    s.intersection(identity_subgroup[G]) = identity_subgroup[G]
}

theorem full_subgroup_intersection_right[G: Group](s: Subgroup[G]) {
    s.intersection(full_subgroup[G]) = s
}

define set_subset_subgroup[G: Group](a: Set[G], s: Subgroup[G]) -> Bool {
    forall(x: G) {
        a.contains(x) implies s.contains(x)
    }
}

theorem set_subset_subgroup_as_set_eq[G: Group](a: Set[G], s: Subgroup[G]) {
    set_subset_subgroup(a, s) = a.subset(s.as_set)
}

theorem set_as_set_subset_of_subset_subgroup[G: Group](a: Set[G], s: Subgroup[G]) {
    set_subset_subgroup(a, s) implies a.subset(s.as_set)
}

theorem set_subset_subgroup_of_as_set_subset[G: Group](a: Set[G], s: Subgroup[G]) {
    a.subset(s.as_set) implies set_subset_subgroup(a, s)
}

theorem subgroup_as_set_subset_self[G: Group](s: Subgroup[G]) {
    set_subset_subgroup(s.as_set, s)
}

theorem set_subset_subgroup_trans[G: Group](
    a: Set[G],
    s: Subgroup[G],
    t: Subgroup[G]
) {
    set_subset_subgroup(a, s) and subgroup_subset(s, t) implies set_subset_subgroup(a, t)
}

theorem set_subset_subgroup_of_set_subset[G: Group](
    a: Set[G],
    b: Set[G],
    s: Subgroup[G]
) {
    a.subset(b) and set_subset_subgroup(b, s) implies set_subset_subgroup(a, s)
}

define subgroup_closure_contains[G: Group](a: Set[G], x: G) -> Bool {
    forall(s: Subgroup[G]) {
        set_subset_subgroup(a, s) implies s.contains(x)
    }
}

theorem subgroup_closure_contains_of_set_subset_raw[G: Group](
    a: Set[G],
    s: Subgroup[G],
    x: G
) {
    subgroup_closure_contains(a, x) and set_subset_subgroup(a, s) implies s.contains(x)
}

theorem subgroup_closure_identity_constraint[G: Group](a: Set[G]) {
    identity_constraint(subgroup_closure_contains(a))
}

theorem subgroup_closure_closure_constraint[G: Group](a: Set[G]) {
    closure_constraint(subgroup_closure_contains(a))
}

theorem subgroup_closure_inverse_constraint[G: Group](a: Set[G]) {
    inverse_constraint(subgroup_closure_contains(a))
}

theorem subgroup_generated_constraint[G: Group](a: Set[G]) {
    subgroup_constraint(subgroup_closure_contains(a))
}

let subgroup_closure[G: Group](a: Set[G]) -> result: Subgroup[G] satisfy {
    Subgroup.new(subgroup_closure_contains(a)) = Option.some(result)
}

theorem subgroup_closure_contains_eq[G: Group](a: Set[G], x: G) {
    subgroup_closure(a).contains(x) = subgroup_closure_contains(a, x)
}

theorem subgroup_subset_closure[G: Group](a: Set[G]) {
    set_subset_subgroup(a, subgroup_closure(a))
}

theorem subgroup_closure_contains_of_set_contains[G: Group](a: Set[G], x: G) {
    a.contains(x) implies subgroup_closure(a).contains(x)
}

theorem subgroup_closure_subset_of_set_subset[G: Group](a: Set[G], s: Subgroup[G]) {
    set_subset_subgroup(a, s) implies subgroup_subset(subgroup_closure(a), s)
}

theorem subgroup_closure_le_iff_set_subset[G: Group](a: Set[G], s: Subgroup[G]) {
    subgroup_subset(subgroup_closure(a), s) = set_subset_subgroup(a, s)
}

theorem subgroup_closure_as_set_galois_connection[G: Group](a: Set[G], s: Subgroup[G]) {
    subgroup_closure(a).as_set.subset(s.as_set) = a.subset(s.as_set)
}

theorem subgroup_closure_as_set[G: Group](s: Subgroup[G]) {
    subgroup_closure(s.as_set) = s
}

theorem subgroup_closure_mono[G: Group](a: Set[G], b: Set[G]) {
    a.subset(b) implies subgroup_subset(subgroup_closure(a), subgroup_closure(b))
}

theorem subgroup_closure_eq_of_set_eq[G: Group](a: Set[G], b: Set[G]) {
    a = b implies subgroup_closure(a) = subgroup_closure(b)
}

theorem subgroup_closure_empty[G: Group] {
    subgroup_closure(Set[G].empty_set) = identity_subgroup[G]
}

theorem subgroup_closure_universal[G: Group] {
    subgroup_closure(Set[G].universal_set) = full_subgroup[G]
}

define subgroup_sup[G: Group](a: Subgroup[G], b: Subgroup[G]) -> Subgroup[G] {
    subgroup_closure(a.as_set.union(b.as_set))
}

attributes Subgroup[G: Group] {
    /// The smallest subgroup containing a set.
    let closure: Set[G] -> Subgroup[G] = subgroup_closure

    /// The least subgroup containing this subgroup and another subgroup.
    let sup: (Subgroup[G], Subgroup[G]) -> Subgroup[G] = subgroup_sup
}

theorem subgroup_sup_eq_closure_union[G: Group](a: Subgroup[G], b: Subgroup[G]) {
    subgroup_sup(a, b) = subgroup_closure(a.as_set.union(b.as_set))
}

theorem subgroup_subset_sup_left[G: Group](a: Subgroup[G], b: Subgroup[G]) {
    subgroup_subset(a, subgroup_sup(a, b))
}

theorem subgroup_subset_sup_right[G: Group](a: Subgroup[G], b: Subgroup[G]) {
    subgroup_subset(b, subgroup_sup(a, b))
}

theorem subgroup_sup_subset_of_subset_left_right[G: Group](
    a: Subgroup[G],
    b: Subgroup[G],
    c: Subgroup[G]
) {
    subgroup_subset(a, c) and subgroup_subset(b, c) implies subgroup_subset(subgroup_sup(a, b), c)
}

theorem subgroup_sup_subset_iff[G: Group](
    a: Subgroup[G],
    b: Subgroup[G],
    c: Subgroup[G]
) {
    subgroup_subset(subgroup_sup(a, b), c) = (subgroup_subset(a, c) and subgroup_subset(b, c))
}

define subgroup_is_finitely_generated[G: Group](s: Subgroup[G]) -> Bool {
    exists(a: Set[G]) {
        a.is_finite and subgroup_closure(a) = s
    }
}

theorem subgroup_is_finitely_generated_witness[G: Group](s: Subgroup[G]) {
    subgroup_is_finitely_generated(s) implies exists(a: Set[G]) {
        a.is_finite and subgroup_closure(a) = s
    }
}

theorem subgroup_is_finitely_generated_of_closure_eq[G: Group](a: Set[G], s: Subgroup[G]) {
    a.is_finite and subgroup_closure(a) = s implies subgroup_is_finitely_generated(s)
}

theorem subgroup_is_finitely_generated_of_eq[G: Group](s: Subgroup[G], t: Subgroup[G]) {
    subgroup_is_finitely_generated(s) and s = t implies subgroup_is_finitely_generated(t)
}

theorem subgroup_closure_is_finitely_generated[G: Group](a: Set[G]) {
    a.is_finite implies subgroup_is_finitely_generated(subgroup_closure(a))
}

theorem subgroup_closure_singleton_is_finitely_generated[G: Group](a: G) {
    subgroup_is_finitely_generated(subgroup_closure(Set[G].singleton(a)))
}

theorem subgroup_closure_singleton_contains[G: Group](a: G) {
    subgroup_closure(Set[G].singleton(a)).contains(a)
}

theorem identity_subgroup_is_finitely_generated[G: Group] {
    subgroup_is_finitely_generated(identity_subgroup[G])
}

theorem subgroup_submonoid_constraint[G: Group](s: Subgroup[G]) {
    submonoid_constraint(s.contains)
}

let subgroup_to_submonoid[G: Group](s: Subgroup[G]) -> result: Submonoid[G] satisfy {
    Submonoid.new(s.contains) = Option.some(result)
}

theorem subgroup_to_submonoid_contains[G: Group](s: Subgroup[G]) {
    subgroup_to_submonoid(s).contains = s.contains
}

theorem subgroup_to_submonoid_contains_eq[G: Group](s: Subgroup[G], x: G) {
    subgroup_to_submonoid(s).contains(x) = s.contains(x)
}

theorem subgroup_contains_to_submonoid_eq[G: Group](s: Subgroup[G], x: G) {
    s.contains(x) = subgroup_to_submonoid(s).contains(x)
}

theorem subgroup_to_submonoid_as_set[G: Group](s: Subgroup[G]) {
    subgroup_to_submonoid(s).as_set = s.as_set
}

define subgroup_preimage_contains[G: Group, H: Group](
    f: GroupHom[G, H],
    s: Subgroup[H],
    a: G
) -> Bool {
    s.contains(f.hom(a))
}

theorem subgroup_preimage_identity_constraint[G: Group, H: Group](
    f: GroupHom[G, H],
    s: Subgroup[H]
) {
    identity_constraint(subgroup_preimage_contains(f, s))
}

theorem subgroup_preimage_closure_constraint[G: Group, H: Group](
    f: GroupHom[G, H],
    s: Subgroup[H]
) {
    closure_constraint(subgroup_preimage_contains(f, s))
}

theorem subgroup_preimage_inverse_constraint[G: Group, H: Group](
    f: GroupHom[G, H],
    s: Subgroup[H]
) {
    inverse_constraint(subgroup_preimage_contains(f, s))
}

theorem subgroup_preimage_constraint[G: Group, H: Group](
    f: GroupHom[G, H],
    s: Subgroup[H]
) {
    subgroup_constraint(subgroup_preimage_contains(f, s))
}

let subgroup_preimage[G: Group, H: Group](f: GroupHom[G, H], s: Subgroup[H]) -> result: Subgroup[G] satisfy {
    Subgroup.new(subgroup_preimage_contains(f, s)) = Option.some(result)
}

theorem subgroup_preimage_contains_eq[G: Group, H: Group](
    f: GroupHom[G, H],
    s: Subgroup[H],
    a: G
) {
    subgroup_preimage(f, s).contains(a) = s.contains(f.hom(a))
}

theorem subgroup_preimage_contains_of_contains_map[G: Group, H: Group](
    f: GroupHom[G, H],
    s: Subgroup[H],
    a: G
) {
    s.contains(f.hom(a)) implies subgroup_preimage(f, s).contains(a)
}

theorem subgroup_contains_map_of_preimage_contains[G: Group, H: Group](
    f: GroupHom[G, H],
    s: Subgroup[H],
    a: G
) {
    subgroup_preimage(f, s).contains(a) implies s.contains(f.hom(a))
}

theorem subgroup_preimage_subset_of_subset[G: Group, H: Group](
    f: GroupHom[G, H],
    s: Subgroup[H],
    t: Subgroup[H]
) {
    subgroup_subset(s, t) implies subgroup_subset(subgroup_preimage(f, s), subgroup_preimage(f, t))
}

theorem subgroup_preimage_intersection[G: Group, H: Group](
    f: GroupHom[G, H],
    s: Subgroup[H],
    t: Subgroup[H]
) {
    subgroup_preimage(f, s.intersection(t)) =
        subgroup_preimage(f, s).intersection(subgroup_preimage(f, t))
}

theorem subgroup_preimage_full[G: Group, H: Group](f: GroupHom[G, H]) {
    subgroup_preimage(f, full_subgroup[H]) = full_subgroup[G]
}

define group_hom_kernel[G: Group, H: Group](f: GroupHom[G, H]) -> Subgroup[G] {
    subgroup_preimage(f, identity_subgroup[H])
}

theorem group_hom_kernel_contains_eq[G: Group, H: Group](f: GroupHom[G, H], a: G) {
    group_hom_kernel(f).contains(a) = (f.hom(a) = H.1)
}

theorem group_hom_kernel_contains_of_maps_to_identity[G: Group, H: Group](f: GroupHom[G, H], a: G) {
    f.hom(a) = H.1 implies group_hom_kernel(f).contains(a)
}

theorem group_hom_maps_to_identity_of_kernel_contains[G: Group, H: Group](f: GroupHom[G, H], a: G) {
    group_hom_kernel(f).contains(a) implies f.hom(a) = H.1
}

theorem subgroup_sup_comm[G: Group](a: Subgroup[G], b: Subgroup[G]) {
    subgroup_sup(a, b) = subgroup_sup(b, a)
}

theorem subgroup_sup_idempotent[G: Group](a: Subgroup[G]) {
    subgroup_sup(a, a) = a
}

theorem subgroup_sup_assoc[G: Group](
    a: Subgroup[G],
    b: Subgroup[G],
    c: Subgroup[G]
) {
    subgroup_sup(subgroup_sup(a, b), c) = subgroup_sup(a, subgroup_sup(b, c))
}

define left_coset_contains[G: Group](s: Subgroup[G], a: G, x: G) -> Bool {
    s.contains(a.inverse * x)
}

theorem left_coset_contains_self[G: Group](s: Subgroup[G], a: G) {
    left_coset_contains(s, a, a)
}

theorem left_coset_contains_of_mem[G: Group](s: Subgroup[G], a: G, t: G) {
    s.contains(t) implies left_coset_contains(s, a, a * t)
}

theorem left_coset_contains_iff[G: Group](s: Subgroup[G], a: G, x: G) {
    left_coset_contains(s, a, x) = exists(t: G) {
        s.contains(t) and x = a * t
    }
}

theorem left_coset_contains_right_mul[G: Group](s: Subgroup[G], a: G, x: G, t: G) {
    left_coset_contains(s, a, x) and s.contains(t) implies left_coset_contains(s, a, x * t)
}

theorem left_coset_eq_of_rep[G: Group](s: Subgroup[G], a: G, b: G, x: G) {
    s.contains(a.inverse * b) implies (left_coset_contains(s, a, x) = left_coset_contains(s, b, x))
}

theorem left_coset_intersection_eq[G: Group](s: Subgroup[G], a: G, b: G) {
    exists(x: G) {
        left_coset_contains(s, a, x) and left_coset_contains(s, b, x)
    } implies forall(y: G) {
        left_coset_contains(s, a, y) = left_coset_contains(s, b, y)
    }
}

define right_coset_contains[G: Group](s: Subgroup[G], a: G, x: G) -> Bool {
    s.contains(x * a.inverse)
}

theorem right_coset_contains_self[G: Group](s: Subgroup[G], a: G) {
    right_coset_contains(s, a, a)
}

theorem right_coset_contains_of_mem[G: Group](s: Subgroup[G], a: G, t: G) {
    s.contains(t) implies right_coset_contains(s, a, t * a)
}

theorem right_coset_contains_left_mul[G: Group](s: Subgroup[G], a: G, x: G, t: G) {
    right_coset_contains(s, a, x) and s.contains(t) implies right_coset_contains(s, a, t * x)
}

theorem group_hom_eq_iff_same_kernel_coset[G: Group, H: Group](f: GroupHom[G, H], a: G, b: G) {
    (f.hom(a) = f.hom(b)) = left_coset_contains(group_hom_kernel(f), a, b)
}

theorem subgroup_inv_mul_mem_iff[G: Group](s: Subgroup[G], a: G, b: G) {
    s.contains(a) implies (s.contains(a.inverse * b) = s.contains(b))
}

theorem left_coset_contains_mem[G: Group](s: Subgroup[G], a: G, x: G) {
    s.contains(x) implies left_coset_contains(s, x, a) = s.contains(a)
}

define is_normal_subgroup[G: Group](s: Subgroup[G]) -> Bool {
    forall(g: G, n: G) {
        s.contains(n) implies s.contains(g * n * g.inverse)
    }
}

theorem normal_conjugate_mem[G: Group](s: Subgroup[G], g: G, n: G) {
    is_normal_subgroup(s) and s.contains(n) implies s.contains(g * n * g.inverse)
}

define normal_subgroup_rel[G: Group](s: Subgroup[G], a: G, b: G) -> Bool {
    s.contains(a * b.inverse)
}

theorem normal_subgroup_rel_reflexive[G: Group](s: Subgroup[G], a: G) {
    normal_subgroup_rel(s, a, a)
}

theorem normal_subgroup_rel_symmetric[G: Group](s: Subgroup[G], a: G, b: G) {
    normal_subgroup_rel(s, a, b) implies normal_subgroup_rel(s, b, a)
}

theorem normal_subgroup_inv_chain[G: Group](a: G, b: G, c: G) {
    (a * b.inverse) * (b * c.inverse) = a * c.inverse
}

theorem normal_subgroup_rel_trans_at[G: Group](s: Subgroup[G], a: G, b: G, c: G) {
    normal_subgroup_rel(s, a, b) and normal_subgroup_rel(s, b, c)
    implies normal_subgroup_rel(s, a, c)
}

theorem normal_subgroup_rel_is_reflexive[G: Group](s: Subgroup[G]) {
    is_reflexive(normal_subgroup_rel(s))
}

theorem normal_subgroup_rel_is_symmetric[G: Group](s: Subgroup[G]) {
    is_symmetric(normal_subgroup_rel(s))
}

theorem normal_subgroup_rel_transitive_statement[G: Group](s: Subgroup[G]) {
    forall(a: G, b: G, c: G) {
        normal_subgroup_rel(s, a, b) and normal_subgroup_rel(s, b, c)
        implies normal_subgroup_rel(s, a, c)
    }
}

theorem normal_subgroup_rel_is_transitive[G: Group](s: Subgroup[G]) {
    is_transitive(normal_subgroup_rel(s))
}

theorem normal_mul_inverse_distrib[G: Group](a: G, b: G, ap: G, bp: G) {
    (a * b) * (ap * bp).inverse = (a * (b * bp.inverse) * a.inverse) * (a * ap.inverse)
}

theorem normal_subgroup_rel_mul_step[G: Group](s: Subgroup[G],
        a: G, ap: G, b: G, bp: G) {
    is_normal_subgroup(s) and normal_subgroup_rel(s, a, ap) and normal_subgroup_rel(s, b, bp)
    implies normal_subgroup_rel(s, a * b, ap * bp)
}

theorem normal_subgroup_rel_inv_step[G: Group](s: Subgroup[G], a: G, b: G) {
    is_normal_subgroup(s) and normal_subgroup_rel(s, a, b)
    implies normal_subgroup_rel(s, a.inverse, b.inverse)
}

theorem normal_subgroup_rel_respects_mul[G: Group](s: Subgroup[G]) {
    is_normal_subgroup(s) implies respects_mul(normal_subgroup_rel(s))
}

theorem normal_subgroup_rel_respects_inverse[G: Group](s: Subgroup[G]) {
    is_normal_subgroup(s) implies respects_unary_op(normal_subgroup_rel(s), G.inverse)
}

theorem normal_subgroup_rel_is_equivalence[G: Group](s: Subgroup[G]) {
    is_equivalence(normal_subgroup_rel(s))
}

let normal_subgroup_quotient_relation[G: Group](s: Subgroup[G]) -> result: QuotientRelation[G] satisfy {
    QuotientRelation[G].new(normal_subgroup_rel(s)) = Option.some(result)
}

theorem normal_subgroup_quotient_relation_rel[G: Group](s: Subgroup[G]) {
    normal_subgroup_quotient_relation(s).rel = normal_subgroup_rel(s)
}

theorem normal_subgroup_rel_is_mul_congruence[G: Group](s: Subgroup[G]) {
    is_normal_subgroup(s) implies is_mul_congruence(normal_subgroup_rel(s))
}

theorem normal_subgroup_rel_is_group_congruence[G: Group](s: Subgroup[G]) {
    is_normal_subgroup(s) implies is_group_congruence(normal_subgroup_rel(s))
}

theorem normal_subgroup_quotient_relation_respects_mul[G: Group](s: Subgroup[G]) {
    is_normal_subgroup(s) implies quotient_binary_respects(normal_subgroup_quotient_relation(s), G.mul)
}

theorem normal_subgroup_quotient_relation_respects_inverse[G: Group](s: Subgroup[G]) {
    is_normal_subgroup(s) implies quotient_unary_respects(normal_subgroup_quotient_relation(s), G.inverse)
}

define normal_subgroup_quotient_mul[G: Group](s: Subgroup[G]) ->
    (QuotientOver[G], QuotientOver[G]) -> QuotientOver[G] {
    quotient_over_binary_op(G.mul)
}

theorem normal_subgroup_quotient_mul_projection[G: Group](s: Subgroup[G], a: G, b: G) {
    is_normal_subgroup(s) implies normal_subgroup_quotient_mul(s,
        quotient_over_mk(normal_subgroup_quotient_relation(s), a),
        quotient_over_mk(normal_subgroup_quotient_relation(s), b)
    ) = quotient_over_mk(normal_subgroup_quotient_relation(s), a * b)
}

theorem normal_subgroup_quotient_mul_projection_left[G: Group](s: Subgroup[G], a1: G, a2: G, b: G) {
    is_normal_subgroup(s) and normal_subgroup_rel(s, a1, a2) implies
    normal_subgroup_quotient_mul(s,
        quotient_over_mk(normal_subgroup_quotient_relation(s), a1),
        quotient_over_mk(normal_subgroup_quotient_relation(s), b)
    ) = normal_subgroup_quotient_mul(s,
        quotient_over_mk(normal_subgroup_quotient_relation(s), a2),
        quotient_over_mk(normal_subgroup_quotient_relation(s), b)
    )
}

theorem normal_subgroup_quotient_mul_projection_right[G: Group](s: Subgroup[G], a: G, b1: G, b2: G) {
    is_normal_subgroup(s) and normal_subgroup_rel(s, b1, b2) implies
    normal_subgroup_quotient_mul(s,
        quotient_over_mk(normal_subgroup_quotient_relation(s), a),
        quotient_over_mk(normal_subgroup_quotient_relation(s), b1)
    ) = normal_subgroup_quotient_mul(s,
        quotient_over_mk(normal_subgroup_quotient_relation(s), a),
        quotient_over_mk(normal_subgroup_quotient_relation(s), b2)
    )
}

define normal_subgroup_quotient_inverse[G: Group](s: Subgroup[G]) ->
    QuotientOver[G] -> QuotientOver[G] {
    quotient_over_unary_op(normal_subgroup_quotient_relation(s), G.inverse)
}

theorem normal_subgroup_quotient_inverse_projection[G: Group](s: Subgroup[G], a: G) {
    is_normal_subgroup(s) implies
    normal_subgroup_quotient_inverse(s, quotient_over_mk(normal_subgroup_quotient_relation(s), a)) =
        quotient_over_mk(normal_subgroup_quotient_relation(s), a.inverse)
}

theorem normal_subgroup_quotient_inverse_projection_compatible[G: Group](s: Subgroup[G], a: G, b: G) {
    is_normal_subgroup(s) and normal_subgroup_rel(s, a, b) implies
    normal_subgroup_quotient_inverse(s, quotient_over_mk(normal_subgroup_quotient_relation(s), a)) =
        normal_subgroup_quotient_inverse(s, quotient_over_mk(normal_subgroup_quotient_relation(s), b))
}

theorem normal_subgroup_quotient_inverse_inverse[G: Group](s: Subgroup[G], a: G) {
    is_normal_subgroup(s) implies
    normal_subgroup_quotient_inverse(s,
        normal_subgroup_quotient_inverse(s, quotient_over_mk(normal_subgroup_quotient_relation(s), a))) =
        quotient_over_mk(normal_subgroup_quotient_relation(s), a)
}

define normal_subgroup_quotient_one[G: Group](s: Subgroup[G]) -> QuotientOver[G] {
    quotient_over_mk(normal_subgroup_quotient_relation(s), G.1)
}

theorem normal_subgroup_quotient_one_projection[G: Group](s: Subgroup[G]) {
    normal_subgroup_quotient_one(s) = quotient_over_mk(normal_subgroup_quotient_relation(s), G.1)
}

define normal_subgroup_quotient_project[G: Group](s: Subgroup[G], a: G) -> QuotientOver[G] {
    quotient_over_mk(normal_subgroup_quotient_relation(s), a)
}

theorem normal_subgroup_quotient_project_eq_mk[G: Group](s: Subgroup[G], a: G) {
    normal_subgroup_quotient_project(s, a) = quotient_over_mk(normal_subgroup_quotient_relation(s), a)
}

theorem normal_subgroup_quotient_project_eq_of_rel[G: Group](s: Subgroup[G], a: G, b: G) {
    normal_subgroup_rel(s, a, b) implies
    normal_subgroup_quotient_project(s, a) = normal_subgroup_quotient_project(s, b)
}

theorem normal_subgroup_rel_of_quotient_project_eq[G: Group](s: Subgroup[G], a: G, b: G) {
    normal_subgroup_quotient_project(s, a) = normal_subgroup_quotient_project(s, b)
    implies normal_subgroup_rel(s, a, b)
}

theorem normal_subgroup_quotient_project_eq_iff_rel[G: Group](s: Subgroup[G], a: G, b: G) {
    (normal_subgroup_quotient_project(s, a) = normal_subgroup_quotient_project(s, b)) =
    normal_subgroup_rel(s, a, b)
}

theorem normal_subgroup_quotient_project_one[G: Group](s: Subgroup[G]) {
    normal_subgroup_quotient_project(s, G.1) = normal_subgroup_quotient_one(s)
}

theorem normal_subgroup_rel_one_right[G: Group](s: Subgroup[G], a: G) {
    normal_subgroup_rel(s, a, G.1) = s.contains(a)
}

theorem normal_subgroup_rel_one_left[G: Group](s: Subgroup[G], a: G) {
    normal_subgroup_rel(s, G.1, a) = s.contains(a)
}

theorem normal_subgroup_rel_of_contains_inverse_mul[G: Group](s: Subgroup[G], a: G, b: G) {
    is_normal_subgroup(s) and s.contains(b.inverse * a) implies normal_subgroup_rel(s, a, b)
}

theorem normal_subgroup_contains_inverse_mul_of_rel[G: Group](s: Subgroup[G], a: G, b: G) {
    is_normal_subgroup(s) and normal_subgroup_rel(s, a, b) implies s.contains(b.inverse * a)
}

theorem normal_subgroup_contains_inverse_mul_iff_rel[G: Group](s: Subgroup[G], a: G, b: G) {
    is_normal_subgroup(s) implies
    s.contains(b.inverse * a) = normal_subgroup_rel(s, a, b)
}

theorem normal_subgroup_quotient_project_eq_one_iff_contains[G: Group](s: Subgroup[G], a: G) {
    (normal_subgroup_quotient_project(s, a) = normal_subgroup_quotient_one(s)) = s.contains(a)
}

theorem normal_subgroup_quotient_one_eq_project_iff_contains[G: Group](s: Subgroup[G], a: G) {
    (normal_subgroup_quotient_one(s) = normal_subgroup_quotient_project(s, a)) = s.contains(a)
}

theorem normal_subgroup_quotient_project_eq_one_of_contains[G: Group](s: Subgroup[G], a: G) {
    s.contains(a) implies normal_subgroup_quotient_project(s, a) = normal_subgroup_quotient_one(s)
}

theorem normal_subgroup_contains_of_quotient_project_eq_one[G: Group](s: Subgroup[G], a: G) {
    normal_subgroup_quotient_project(s, a) = normal_subgroup_quotient_one(s) implies s.contains(a)
}

theorem normal_subgroup_quotient_one_eq_project_of_contains[G: Group](s: Subgroup[G], a: G) {
    s.contains(a) implies normal_subgroup_quotient_one(s) = normal_subgroup_quotient_project(s, a)
}

theorem normal_subgroup_contains_of_quotient_one_eq_project[G: Group](s: Subgroup[G], a: G) {
    normal_subgroup_quotient_one(s) = normal_subgroup_quotient_project(s, a) implies s.contains(a)
}

theorem normal_subgroup_quotient_project_mul[G: Group](s: Subgroup[G], a: G, b: G) {
    is_normal_subgroup(s) implies
    normal_subgroup_quotient_project(s, a * b) =
    normal_subgroup_quotient_mul(s,
        normal_subgroup_quotient_project(s, a),
        normal_subgroup_quotient_project(s, b))
}

theorem normal_subgroup_quotient_project_inverse[G: Group](s: Subgroup[G], a: G) {
    is_normal_subgroup(s) implies
    normal_subgroup_quotient_project(s, a.inverse) =
    normal_subgroup_quotient_inverse(s, normal_subgroup_quotient_project(s, a))
}

theorem normal_subgroup_quotient_project_mul_left_of_rel[G: Group](
    s: Subgroup[G], a1: G, a2: G, b: G
) {
    is_normal_subgroup(s) and normal_subgroup_rel(s, a1, a2) implies
    normal_subgroup_quotient_mul(s,
        normal_subgroup_quotient_project(s, a1),
        normal_subgroup_quotient_project(s, b)) =
    normal_subgroup_quotient_mul(s,
        normal_subgroup_quotient_project(s, a2),
        normal_subgroup_quotient_project(s, b))
}

