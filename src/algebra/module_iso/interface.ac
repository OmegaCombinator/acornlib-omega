theorem subsemigroup_closure_closure_constraint[S: Semigroup](a: Set[S]) {
    subsemigroup_closure_constraint(subsemigroup_closure_contains(a))
}

theorem subsemigroup_generated_constraint[S: Semigroup](a: Set[S]) {
    subsemigroup_closure_constraint(subsemigroup_closure_contains(a))
