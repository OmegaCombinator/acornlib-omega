let submonoid_preimage[M: Monoid, N: Monoid](f: MonoidHom[M, N], s: Submonoid[N]) -> result: Submonoid[M] satisfy {
    Submonoid.new(submonoid_preimage_contains(f, s)) = Option.some(result)
