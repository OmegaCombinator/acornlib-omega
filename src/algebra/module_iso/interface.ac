theorem group_hom_injective_of_trivial_kernel[G: Group, H: Group](f: GroupHom[G, H]) {
    is_trivial_group_hom_kernel(f) implies is_injective_fn(f.hom)
}

theorem group_hom_kernel_element_eq_one_of_injective[G: Group, H: Group](f: GroupHom[G, H], a: G) {
    is_injective_fn(f.hom) and f.hom(a) = H.1 implies a = G.1
}

theorem ring_hom_trivial_kernel_of_injective[R: Ring, S: Ring](f: RingHom[R, S]) {
    is_injective_fn(f.hom) implies is_trivial_ring_hom_kernel(f)
}

theorem ring_hom_injective_of_trivial_kernel[R: Ring, S: Ring](f: RingHom[R, S]) {
    is_trivial_ring_hom_kernel(f) implies is_injective_fn(f.hom)
}

theorem ring_hom_kernel_element_eq_zero_of_injective[R: Ring, S: Ring](f: RingHom[R, S], a: R) {
    is_injective_fn(f.hom) and f.hom(a) = S.0 implies a = R.0
}

theorem spec_ext[R: CommRing](a: Spec[R], b: Spec[R]) {
    a.point = b.point implies a = b
}

theorem spec_ext_contains[R: CommRing](a: Spec[R], b: Spec[R]) {
    (forall(x: R) { a.point.contains(x) = b.point.contains(x) }) implies a = b
}

define spec_of_prime[R: CommRing](p: PrimeIdeal[R]) -> Spec[R] {
    Spec[R].new(p)
}

attributes Spec[R: CommRing] {
    /// Extensionality: equality of points reduces to equality of prime ideals.
    let ext = spec_ext[R]

    /// Extensionality via membership predicates.
    let ext_contains = spec_ext_contains[R]

    /// The point of `Spec(R)` corresponding to a prime ideal of `R`.
    let of_prime: PrimeIdeal[R] -> Spec[R] = spec_of_prime[R]
}

theorem spec_of_prime_point[R: CommRing](p: PrimeIdeal[R]) {
    spec_of_prime(p).point = p
}

theorem spec_of_prime_eq[R: CommRing](p: PrimeIdeal[R], q: PrimeIdeal[R]) {
    Spec[R].of_prime(p) = Spec[R].of_prime(q) implies p = q
}

define spec_of_maximal[R: CommRing](m: MaximalIdeal[R]) -> Spec[R] {
    Spec[R].of_prime(m.as_prime_ideal)
}

define spec_in_vanishing[R: CommRing](i: Ideal[R], p: Spec[R]) -> Bool {
    bundled_ideal_subset(i, p.point.as_ideal)
}

define spec_vanishing[R: CommRing](i: Ideal[R]) -> Set[Spec[R]] {
    Set[Spec[R]].new(function(p: Spec[R]) {
        spec_in_vanishing(i, p)
    })
}

attributes Spec[R: CommRing] {
    /// The point of `Spec(R)` corresponding to a maximal ideal of `R`.
    let of_maximal: MaximalIdeal[R] -> Spec[R] = spec_of_maximal[R]

    /// The vanishing set `V(I)` of an ideal of `R`.
    let vanishing: Ideal[R] -> Set[Spec[R]] = spec_vanishing[R]
}

theorem spec_vanishing_contains_eq[R: CommRing](i: Ideal[R], p: Spec[R]) {
    Spec[R].vanishing(i).contains(p) = bundled_ideal_subset(i, p.point.as_ideal)
}

theorem spec_vanishing_antitone[R: CommRing](i: Ideal[R], j: Ideal[R]) {
    bundled_ideal_subset(i, j) implies Spec[R].vanishing(j).subset(Spec[R].vanishing(i))
}

theorem spec_vanishing_zero[R: CommRing] {
    Spec[R].vanishing(Ideal[R].zero) = Set[Spec[R]].universal_set
}

theorem spec_vanishing_unit[R: CommRing] {
    Spec[R].vanishing(Ideal[R].unit) = Set[Spec[R]].empty_set
}

theorem spec_of_maximal_point[R: CommRing](m: MaximalIdeal[R]) {
    Spec[R].of_maximal(m).point = m.as_prime_ideal
}

theorem spec_vanishing_principal_contains_eq[R: CommRing](f: R, p: Spec[R]) {
    Spec[R].vanishing(Ideal[R].principal(f)).contains(p) = p.point.contains(f)
}

theorem spec_vanishing_principal_zero[R: CommRing] {
    Spec[R].vanishing(Ideal[R].principal(R.0)) = Set[Spec[R]].universal_set
}

theorem spec_vanishing_principal_one[R: CommRing] {
    Spec[R].vanishing(Ideal[R].principal(R.1)) = Set[Spec[R]].empty_set
}

define spec_basic_open[R: CommRing](f: R) -> Set[Spec[R]] {
    Spec[R].vanishing(Ideal[R].principal(f)).c
}

attributes Spec[R: CommRing] {
    /// The distinguished open set `D(f)` complementary to `V(principal(f))`.
    let basic_open: R -> Set[Spec[R]] = spec_basic_open[R]
}

theorem spec_basic_open_contains_eq[R: CommRing](f: R, p: Spec[R]) {
    Spec[R].basic_open(f).contains(p) = not p.point.contains(f)
}

theorem spec_basic_open_zero[R: CommRing] {
    Spec[R].basic_open(R.0) = Set[Spec[R]].empty_set
}

theorem spec_basic_open_one[R: CommRing] {
    Spec[R].basic_open(R.1) = Set[Spec[R]].universal_set
}

theorem spec_basic_open_compl[R: CommRing](f: R) {
    Spec[R].basic_open(f).c = Spec[R].vanishing(Ideal[R].principal(f))
}

theorem spec_vanishing_principal_compl[R: CommRing](f: R) {
    Spec[R].vanishing(Ideal[R].principal(f)).c = Spec[R].basic_open(f)
}

theorem spec_of_prime_inj[R: CommRing](p: PrimeIdeal[R], q: PrimeIdeal[R]) {
    Spec[R].of_prime(p) = Spec[R].of_prime(q) implies p = q
}

define spec_vanishing_family[R: CommRing, I](family: I -> Ideal[R], i: I) -> Set[Spec[R]] {
    Spec[R].vanishing(family(i))
}

theorem spec_vanishing_indexed_union_subset_inter[R: CommRing, I](family: I -> Ideal[R]) {
    indexed_union(spec_vanishing_family(family)).subset(
        Spec[R].vanishing(ideal_indexed_inter(family)))
}

theorem spec_of_prime_in_vanishing[R: CommRing](i: Ideal[R], p: PrimeIdeal[R]) {
    Spec[R].vanishing(i).contains(Spec[R].of_prime(p)) = bundled_ideal_subset(i, p.as_ideal)
}

theorem spec_of_maximal_in_vanishing[R: CommRing](i: Ideal[R], m: MaximalIdeal[R]) {
    Spec[R].vanishing(i).contains(Spec[R].of_maximal(m)) =
        bundled_ideal_subset(i, m.as_prime_ideal.as_ideal)
}

theorem spec_vanishing_zero_compl[R: CommRing] {
    Spec[R].vanishing(Ideal[R].zero).c = Set[Spec[R]].empty_set
}

theorem spec_vanishing_unit_compl[R: CommRing] {
    Spec[R].vanishing(Ideal[R].unit).c = Set[Spec[R]].universal_set
}

theorem spec_vanishing_sum_compl[R: CommRing](i: Ideal[R], j: Ideal[R]) {
    Spec[R].vanishing(i.sum(j)).c =
        Spec[R].vanishing(i).c.union(Spec[R].vanishing(j).c)
}

theorem spec_basic_open_subset_one[R: CommRing](f: R) {
    Spec[R].basic_open(f).subset(Spec[R].basic_open(R.1))
}

theorem spec_basic_open_mul_subset_left[R: CommRing](f: R, g: R) {
    Spec[R].basic_open(f * g).subset(Spec[R].basic_open(f))
}

theorem spec_basic_open_mul_subset_right[R: CommRing](f: R, g: R) {
    Spec[R].basic_open(f * g).subset(Spec[R].basic_open(g))
}

define spec_zariski_closed[R: CommRing](s: Set[Spec[R]]) -> Bool {
    exists(i: Ideal[R]) {
        s = Spec[R].vanishing(i)
    }
}

theorem spec_zariski_closed_empty[R: CommRing] {
    spec_zariski_closed(Set[Spec[R]].empty_set)
}

theorem spec_zariski_closed_universal[R: CommRing] {
    spec_zariski_closed(Set[Spec[R]].universal_set)
}

theorem spec_zariski_closed_vanishing[R: CommRing](i: Ideal[R]) {
    spec_zariski_closed(Spec[R].vanishing(i))
}

theorem spec_zariski_closed_union[R: CommRing](s: Set[Spec[R]], t: Set[Spec[R]]) {
    spec_zariski_closed(s) and spec_zariski_closed(t)
        implies spec_zariski_closed(s.union(t))
}

define spec_basic_open_family[R: CommRing](s: Set[Spec[R]]) -> Bool {
    exists(f: R) {
        s = Spec[R].basic_open(f)
    }
}

theorem spec_basic_open_family_member[R: CommRing](f: R) {
    spec_basic_open_family(Spec[R].basic_open(f))
}

define spec_zariski_open[R: CommRing](s: Set[Spec[R]]) -> Bool {
    exists(i: Ideal[R]) {
        s = Spec[R].vanishing(i).c
    }
}

theorem spec_zariski_open_vanishing_compl[R: CommRing](i: Ideal[R]) {
    spec_zariski_open(Spec[R].vanishing(i).c)
}

theorem spec_zariski_open_empty[R: CommRing] {
    spec_zariski_open(Set[Spec[R]].empty_set)
}

theorem spec_zariski_open_universal[R: CommRing] {
    spec_zariski_open(Set[Spec[R]].universal_set)
}

theorem spec_zariski_open_basic[R: CommRing](f: R) {
    spec_zariski_open(Spec[R].basic_open(f))
}

theorem spec_zariski_open_union[R: CommRing](s: Set[Spec[R]], t: Set[Spec[R]]) {
    spec_zariski_open(s) and spec_zariski_open(t)
        implies spec_zariski_open(s.union(t))
}

theorem spec_of_maximal_inj[R: CommRing](m: MaximalIdeal[R], n: MaximalIdeal[R]) {
    Spec[R].of_maximal(m) = Spec[R].of_maximal(n) implies m.as_prime_ideal = n.as_prime_ideal
}

define subfield_zero_constraint[F: Field](contains: F -> Bool) -> Bool {
    contains(F.0)
}

define subfield_one_constraint[F: Field](contains: F -> Bool) -> Bool {
    contains(F.1)
}

define subfield_add_constraint[F: Field](contains: F -> Bool) -> Bool {
    forall(a: F, b: F) {
        contains(a) and contains(b) implies contains(a + b)
    }
}

define subfield_neg_constraint[F: Field](contains: F -> Bool) -> Bool {
    forall(a: F) {
        contains(a) implies contains(-a)
    }
}

define subfield_mul_constraint[F: Field](contains: F -> Bool) -> Bool {
    forall(a: F, b: F) {
        contains(a) and contains(b) implies contains(a * b)
    }
}

define subfield_inverse_constraint[F: Field](contains: F -> Bool) -> Bool {
    forall(a: F) {
        contains(a) and a != F.0 implies contains(a.inverse)
    }
}

define subfield_additive_constraint[F: Field](contains: F -> Bool) -> Bool {
    subfield_zero_constraint(contains) and subfield_add_constraint(contains) and
        subfield_neg_constraint(contains)
}

define subfield_multiplicative_constraint[F: Field](contains: F -> Bool) -> Bool {
    subfield_one_constraint(contains) and subfield_mul_constraint(contains) and
        subfield_inverse_constraint(contains)
}

define subfield_constraint[F: Field](contains: F -> Bool) -> Bool {
    subfield_additive_constraint(contains) and subfield_multiplicative_constraint(contains)
}

structure Subfield[F: Field] {
    /// True if the given element is a member of this subfield.
    contains: F -> Bool
} constraint {
    subfield_constraint(contains)
}

theorem subfield_ext[F: Field](a: Subfield[F], b: Subfield[F]) {
    (forall(x: F) { a.contains(x) = b.contains(x) }) implies a = b
}

theorem subfield_eq_contains[F: Field](a: Subfield[F], b: Subfield[F]) {
    a = b implies a.contains = b.contains
}

theorem subfield_satisfies_constraint[F: Field](s: Subfield[F]) {
    subfield_constraint(s.contains)
}

theorem subfield_satisfies_additive[F: Field](s: Subfield[F]) {
    subfield_additive_constraint(s.contains)
}

theorem subfield_satisfies_multiplicative[F: Field](s: Subfield[F]) {
    subfield_multiplicative_constraint(s.contains)
}

theorem subfield_satisfies_zero[F: Field](s: Subfield[F]) {
    subfield_zero_constraint(s.contains)
}

theorem subfield_satisfies_one[F: Field](s: Subfield[F]) {
    subfield_one_constraint(s.contains)
}

theorem subfield_satisfies_add[F: Field](s: Subfield[F]) {
    subfield_add_constraint(s.contains)
}

theorem subfield_satisfies_neg[F: Field](s: Subfield[F]) {
    subfield_neg_constraint(s.contains)
}

theorem subfield_satisfies_mul[F: Field](s: Subfield[F]) {
    subfield_mul_constraint(s.contains)
}

theorem subfield_satisfies_inverse[F: Field](s: Subfield[F]) {
    subfield_inverse_constraint(s.contains)
}

theorem subfield_contains_zero[F: Field](s: Subfield[F]) {
    s.contains(F.0)
}

theorem subfield_contains_one[F: Field](s: Subfield[F]) {
    s.contains(F.1)
}

theorem subfield_contains_add[F: Field](s: Subfield[F], a: F, b: F) {
    s.contains(a) and s.contains(b) implies s.contains(a + b)
}

theorem subfield_contains_neg[F: Field](s: Subfield[F], a: F) {
    s.contains(a) implies s.contains(-a)
}

theorem subfield_contains_sub[F: Field](s: Subfield[F], a: F, b: F) {
    s.contains(a) and s.contains(b) implies s.contains(a - b)
}

theorem subfield_contains_mul[F: Field](s: Subfield[F], a: F, b: F) {
    s.contains(a) and s.contains(b) implies s.contains(a * b)
}

define subfield_le[F: Field](a: Subfield[F], b: Subfield[F]) -> Bool {
    forall(x: F) { a.contains(x) implies b.contains(x) }
}

theorem subfield_le_intro[F: Field](a: Subfield[F], b: Subfield[F]) {
    (forall(x: F) { a.contains(x) implies b.contains(x) }) implies subfield_le(a, b)
}

theorem subfield_le_refl[F: Field](a: Subfield[F]) {
    subfield_le(a, a)
}

theorem subfield_le_trans[F: Field](a: Subfield[F], b: Subfield[F], c: Subfield[F]) {
    subfield_le(a, b) and subfield_le(b, c) implies subfield_le(a, c)
}

theorem subfield_le_antisymm[F: Field](a: Subfield[F], b: Subfield[F]) {
    subfield_le(a, b) and subfield_le(b, a) implies a = b
}

theorem subfield_contains_inverse[F: Field](s: Subfield[F], a: F) {
    s.contains(a) and a != F.0 implies s.contains(a.inverse)
}

theorem subfield_contains_mul_inverse[F: Field](s: Subfield[F], a: F, b: F) {
    s.contains(a) and s.contains(b) and b != F.0 implies s.contains(a * b.inverse)
}

define subfield_inter_contains[F: Field](a: F -> Bool, b: F -> Bool) -> F -> Bool {
    function(x: F) { a(x) and b(x) }
}

theorem subfield_inter_is_subfield[F: Field](a: Subfield[F], b: Subfield[F]) {
    subfield_constraint(subfield_inter_contains(a.contains, b.contains))
}

let subfield_inter[F: Field](a: Subfield[F], b: Subfield[F]) -> result: Subfield[F] satisfy {
    Subfield.new(subfield_inter_contains(a.contains, b.contains)) = Option.some(result)
}

theorem subfield_inter_contains_eq[F: Field](a: Subfield[F], b: Subfield[F], x: F) {
    subfield_inter(a, b).contains(x) = (a.contains(x) and b.contains(x))
}

theorem subfield_inter_le_left[F: Field](a: Subfield[F], b: Subfield[F]) {
    subfield_le(subfield_inter(a, b), a)
}

theorem subfield_inter_le_right[F: Field](a: Subfield[F], b: Subfield[F]) {
    subfield_le(subfield_inter(a, b), b)
}

theorem subfield_inter_greatest[F: Field](a: Subfield[F], b: Subfield[F], c: Subfield[F]) {
    subfield_le(c, a) and subfield_le(c, b) implies subfield_le(c, subfield_inter(a, b))
}

theorem subfield_inter_comm[F: Field](a: Subfield[F], b: Subfield[F]) {
    subfield_inter(a, b) = subfield_inter(b, a)
}

theorem subfield_inter_idem[F: Field](a: Subfield[F]) {
    subfield_inter(a, a) = a
}

theorem subfield_inter_eq_left_iff_le[F: Field](a: Subfield[F], b: Subfield[F]) {
    (subfield_inter(a, b) = a) = subfield_le(a, b)
}

theorem subfield_inter_mono_left[F: Field](a: Subfield[F], b: Subfield[F], c: Subfield[F]) {
    subfield_le(a, b) implies subfield_le(subfield_inter(a, c), subfield_inter(b, c))
}

theorem subfield_inter_mono_right[F: Field](a: Subfield[F], b: Subfield[F], c: Subfield[F]) {
    subfield_le(a, b) implies subfield_le(subfield_inter(c, a), subfield_inter(c, b))
}

theorem subfield_inter_mono[F: Field](a: Subfield[F], b: Subfield[F], c: Subfield[F], d: Subfield[F]) {
    subfield_le(a, b) and subfield_le(c, d) implies subfield_le(subfield_inter(a, c), subfield_inter(b, d))
}

theorem subfield_le_inter_iff[F: Field](a: Subfield[F], b: Subfield[F], c: Subfield[F]) {
    subfield_le(c, subfield_inter(a, b)) = (subfield_le(c, a) and subfield_le(c, b))
}

theorem subfield_inter_assoc[F: Field](a: Subfield[F], b: Subfield[F], c: Subfield[F]) {
    subfield_inter(subfield_inter(a, b), c) = subfield_inter(a, subfield_inter(b, c))
}

define field_hom_image_contains[F: Field, E: Field](phi: FieldHom[F, E], y: E) -> Bool {
    exists(x: F) { phi.hom(x) = y }
}

let field_hom_image[F: Field, E: Field](phi: FieldHom[F, E]) -> result: Subfield[E] satisfy {
    Subfield.new(field_hom_image_contains(phi)) = Option.some(result)
}

theorem field_hom_image_contains_eq[F: Field, E: Field](phi: FieldHom[F, E]) {
    field_hom_image(phi).contains = field_hom_image_contains(phi)
}

theorem field_hom_image_contains_hom[F: Field, E: Field](phi: FieldHom[F, E], x: F) {
    field_hom_image(phi).contains(phi.hom(x))
}

define top_subfield_contains[F: Field](x: F) -> Bool {
    true
}

theorem top_subfield_contains_is_subfield[F: Field] {
    subfield_constraint(top_subfield_contains[F])
}

let top_subfield[F: Field]: Subfield[F] satisfy {
    Subfield.new(top_subfield_contains[F]) = Option.some(top_subfield)
}

theorem top_subfield_contains_all[F: Field](x: F) {
    top_subfield[F].contains(x)
}

theorem field_hom_image_identity[F: Field] {
    field_hom_image(identity_field_hom[F]) = top_subfield[F]
}

theorem top_subfield_ge[F: Field](s: Subfield[F]) {
    subfield_le(s, top_subfield[F])
}

theorem field_hom_image_le_top[F: Field, E: Field](phi: FieldHom[F, E]) {
    subfield_le(field_hom_image(phi), top_subfield[E])
}

theorem field_hom_image_compose_contains[F: Field, E: Field, K: Field](f: FieldHom[E, K], g: FieldHom[F, E], y: K) {
    field_hom_image(compose_field_hom(f, g)).contains(y) implies field_hom_image(f).contains(y)
}

theorem field_hom_image_compose_le[F: Field, E: Field, K: Field](f: FieldHom[E, K], g: FieldHom[F, E]) {
    subfield_le(field_hom_image(compose_field_hom(f, g)), field_hom_image(f))
}

define subfield_preimage_contains[F: Field, E: Field](phi: FieldHom[F, E], s: Subfield[E]) -> F -> Bool {
    function(x: F) { s.contains(phi.hom(x)) }
}

let subfield_preimage[F: Field, E: Field](phi: FieldHom[F, E], s: Subfield[E]) -> result: Subfield[F] satisfy {
    Subfield.new(subfield_preimage_contains(phi, s)) = Option.some(result)
}

theorem subfield_preimage_contains_eq[F: Field, E: Field](phi: FieldHom[F, E], s: Subfield[E], x: F) {
    subfield_preimage(phi, s).contains(x) = s.contains(phi.hom(x))
