define is_lower_bound_linear[L: LinearOrder](p: L -> Bool, a: L) -> Bool {
    forall(x: L) {
        p(x) implies a <= x
    }
}

define is_upper_bound_linear[L: LinearOrder](p: L -> Bool, b: L) -> Bool {
    forall(x: L) {
        p(x) implies x <= b
    }
}

define is_bounded_by_interval[L: LinearOrder](p: L -> Bool, a: L, b: L) -> Bool {
    forall(x: L) {
        p(x) implies closed_interval(a, b, x)
    }
}

define is_bounded_below_linear[L: LinearOrder](p: L -> Bool) -> Bool {
    exists(a: L) {
        is_lower_bound_linear(p, a)
    }
}

define is_bounded_above_linear[L: LinearOrder](p: L -> Bool) -> Bool {
    exists(b: L) {
        is_upper_bound_linear(p, b)
    }
}

define is_bounded_linear[L: LinearOrder](p: L -> Bool) -> Bool {
    exists(a: L, b: L) {
        is_bounded_by_interval(p, a, b)
    }
}

theorem lower_bound_step[L: LinearOrder](p: L -> Bool, a: L, x: L) {
    is_lower_bound_linear(p, a) and p(x) implies a <= x
}

theorem upper_bound_step[L: LinearOrder](p: L -> Bool, b: L, x: L) {
    is_upper_bound_linear(p, b) and p(x) implies x <= b
}

theorem bounded_by_interval_step[L: LinearOrder](p: L -> Bool, a: L, b: L, x: L) {
    is_bounded_by_interval(p, a, b) and p(x) implies closed_interval(a, b, x)
}

theorem bounds_imp_bounded_by_interval[L: LinearOrder](p: L -> Bool, a: L, b: L) {
    is_lower_bound_linear(p, a) and is_upper_bound_linear(p, b) implies is_bounded_by_interval(p, a, b)
}

theorem bounded_by_interval_imp_lower_bound[L: LinearOrder](p: L -> Bool, a: L, b: L) {
    is_bounded_by_interval(p, a, b) implies is_lower_bound_linear(p, a)
}

theorem bounded_by_interval_imp_upper_bound[L: LinearOrder](p: L -> Bool, a: L, b: L) {
    is_bounded_by_interval(p, a, b) implies is_upper_bound_linear(p, b)
}

theorem bounded_by_interval_iff_bounds[L: LinearOrder](p: L -> Bool, a: L, b: L) {
    is_bounded_by_interval(p, a, b) = (is_lower_bound_linear(p, a) and is_upper_bound_linear(p, b))
}

theorem closed_interval_lower_bound[L: LinearOrder](a: L, b: L) {
    is_lower_bound_linear(closed_interval(a, b), a)
