theorem is_upper_bound_pred_eq_iff[P: PartialOrder](p: P -> Bool, q: P -> Bool, b: P) {
    forall(x: P) { p(x) iff q(x) } implies (is_upper_bound(p, b) iff is_upper_bound(q, b))
