theorem quadratic_mul_coeff_four[R: CommRing](a: R, b: R, c: R, d: R, e: R, g: R) {
    polynomial_mul(quadratic_polynomial(a, b, c), quadratic_polynomial(d, e, g)).coeff(Nat.4) = a * d
