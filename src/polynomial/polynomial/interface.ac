}

theorem polynomial_eval_at_zero[R: Semiring](x: R) {
    polynomial_eval_at(x, Polynomial[R].zero) = R.0
}

theorem polynomial_eval_at_constant[R: Semiring](x: R, r: R) {
    polynomial_eval_at(x, Polynomial[R].constant(r)) = r
}

theorem polynomial_eval_at_one[R: Semiring](x: R) {
    polynomial_eval_at(x, Polynomial[R].one) = R.1
}

theorem polynomial_eval_at_add[R: Semiring](x: R, p: Polynomial[R], q: Polynomial[R]) {
    polynomial_eval_at(x, p + q) = polynomial_eval_at(x, p) + polynomial_eval_at(x, q)
}

theorem polynomial_eval_at_mul[R: CommRing](x: R, p: Polynomial[R], q: Polynomial[R]) {
    polynomial_eval_at(x, polynomial_mul(p, q)) = polynomial_eval_at(x, p) * polynomial_eval_at(x, q)
}

theorem polynomial_eval_at_neg[R: Ring](x: R, p: Polynomial[R]) {
    polynomial_eval_at(x, p.neg) = -polynomial_eval_at(x, p)
}

theorem polynomial_eval_at_sub[R: Ring](x: R, p: Polynomial[R], q: Polynomial[R]) {
    polynomial_eval_at(x, p.sub(q)) = polynomial_eval_at(x, p) - polynomial_eval_at(x, q)
}

define is_int_root(p: Polynomial[Int], r: Int) -> Bool {
    polynomial_eval(p, r) = Int.0
}

theorem is_int_root_apply(p: Polynomial[Int], r: Int) {
    is_int_root(p, r) implies polynomial_eval(p, r) = Int.0
}

theorem is_int_root_intro(p: Polynomial[Int], r: Int) {
    polynomial_eval(p, r) = Int.0 implies is_int_root(p, r)
}

theorem polynomial_int_eval_split(p: Polynomial[Int], r: Int, n: Nat) {
    polynomial_support_bounded_by(p, n.suc) implies polynomial_eval(p, r)
        = p.coeff(Nat.0) + r * coeff_eval(coeff_tail(p.coeff), r, n)
}

theorem int_root_divides_constant_coeff(p: Polynomial[Int], r: Int) {
    is_int_root(p, r) implies r.divides(p.coeff(Nat.0))
}

theorem not_int_root_of_not_divides(p: Polynomial[Int], r: Int) {
    not r.divides(p.coeff(Nat.0)) implies not is_int_root(p, r)
}

theorem int_root_zero_iff_constant_coeff_zero(p: Polynomial[Int]) {
    is_int_root(p, Int.0) = (p.coeff(Nat.0) = Int.0)
}

theorem int_root_abs_lte(p: Polynomial[Int], r: Int) {
    is_int_root(p, r) and p.coeff(Nat.0) != Int.0
        implies abs(r) <= abs(p.coeff(Nat.0))
}

theorem polynomial_mul_coeff_one[R: CommRing](p: Polynomial[R], k: Nat) {
    polynomial_mul_coeff(p, Polynomial[R].one, k) = p.coeff(k)
}

theorem polynomial_mul_one_right[R: CommRing](p: Polynomial[R]) {
    polynomial_mul(p, Polynomial[R].one) = p
}

theorem polynomial_mul_one_left[R: CommRing](p: Polynomial[R]) {
    polynomial_mul(Polynomial[R].one, p) = p
}

theorem mul_term_coeff_add[R: CommRing](
    p: Polynomial[R], q: Polynomial[R], r: Polynomial[R], k: Nat
) {
    polynomial_mul_term_coeff(p, q + r, k)
        = add_fn(polynomial_mul_term_coeff(p, q, k), polynomial_mul_term_coeff(p, r, k))
}

theorem polynomial_mul_coeff_add[R: CommRing](
    p: Polynomial[R], q: Polynomial[R], r: Polynomial[R], k: Nat
) {
    polynomial_mul_coeff(p, q + r, k)
        = polynomial_mul_coeff(p, q, k) + polynomial_mul_coeff(p, r, k)
}

theorem polynomial_mul_add_left[R: CommRing](
    p: Polynomial[R], q: Polynomial[R], r: Polynomial[R]
) {
    polynomial_mul(p, q + r) = polynomial_mul(p, q) + polynomial_mul(p, r)
}

define coeff_hom_eval(c: Nat -> Int, a: Int, b: Int, n: Nat) -> Int {
    match n {
        Nat.zero {
            Int.0
        }
        Nat.suc(pred) {
            c(Nat.0) * b.pow(pred) + a * coeff_hom_eval(coeff_tail(c), a, b, pred)
        }
    }
}

theorem coeff_hom_eval_suc(c: Nat -> Int, a: Int, b: Int, n: Nat) {
    coeff_hom_eval(c, a, b, n.suc)
        = c(Nat.0) * b.pow(n) + a * coeff_hom_eval(coeff_tail(c), a, b, n)
}

theorem coeff_hom_eval_zero(c: Nat -> Int, a: Int, b: Int) {
    coeff_hom_eval(c, a, b, Nat.0) = Int.0
}

theorem coeff_hom_eval_one(c: Nat -> Int, a: Int, n: Nat) {
    coeff_hom_eval(c, a, Int.1, n) = coeff_eval(c, a, n)
}

theorem hom_root_numerator_divides(c: Nat -> Int, a: Int, b: Int, n: Nat) {
    coeff_hom_eval(c, a, b, n.suc) = Int.0 and is_coprime(a, b)
        implies a.divides(c(Nat.0))
}

theorem hom_eval_minus_top_divisible(c: Nat -> Int, a: Int, b: Int, n: Nat) {
    b.divides(coeff_hom_eval(c, a, b, n.suc) - c(n) * a.pow(n))
}

theorem hom_root_denominator_divides(c: Nat -> Int, a: Int, b: Int, n: Nat) {
    coeff_hom_eval(c, a, b, n.suc) = Int.0 and is_coprime(a, b)
        implies b.divides(c(n))
}

theorem coeff_eval_fraction_cleared(c: Nat -> Int, a: Int, b: Int, n: Nat) {
    b != Int.0 implies
        coeff_eval(rat_coeffs(c), Rat.from_int(a) / Rat.from_int(b), n.suc)
            * Rat.from_int(b).pow(n)
        = Rat.from_int(coeff_hom_eval(c, a, b, n.suc))
}

theorem rat_root_iff_hom_eval_zero(c: Nat -> Int, a: Int, b: Int, n: Nat) {
    b != Int.0 implies
        (coeff_eval(rat_coeffs(c), Rat.from_int(a) / Rat.from_int(b), n.suc) = Rat.0)
            = (coeff_hom_eval(c, a, b, n.suc) = Int.0)
}

theorem rat_root_numerator_divides(c: Nat -> Int, a: Int, b: Int, n: Nat) {
    b != Int.0 and is_coprime(a, b)
        and coeff_eval(rat_coeffs(c), Rat.from_int(a) / Rat.from_int(b), n.suc) = Rat.0
        implies a.divides(c(Nat.0))
}

theorem rat_root_denominator_divides(c: Nat -> Int, a: Int, b: Int, n: Nat) {
    b != Int.0 and is_coprime(a, b)
        and coeff_eval(rat_coeffs(c), Rat.from_int(a) / Rat.from_int(b), n.suc) = Rat.0
        implies b.divides(c(n))
}

theorem monic_rat_root_denominator_divides_one(c: Nat -> Int, a: Int, b: Int, n: Nat) {
    b != Int.0 and is_coprime(a, b) and c(n) = Int.1
        and coeff_eval(rat_coeffs(c), Rat.from_int(a) / Rat.from_int(b), n.suc) = Rat.0
        implies b.divides(Int.1)
}

define int_cubic_polynomial(a: Int, b: Int, c: Int, d: Int) -> Polynomial[Int] {
    polynomial_constant(d) + polynomial_monomial(Nat.1, c) + polynomial_monomial(Nat.2, b) +
        polynomial_monomial(Nat.3, a)
}

theorem cubic_coeff_zero(a: Int, b: Int, c: Int, d: Int) {
    int_cubic_polynomial(a, b, c, d).coeff(Nat.0) = d
}

theorem cubic_coeff_one(a: Int, b: Int, c: Int, d: Int) {
    int_cubic_polynomial(a, b, c, d).coeff(Nat.1) = c
}

theorem cubic_coeff_two(a: Int, b: Int, c: Int, d: Int) {
    int_cubic_polynomial(a, b, c, d).coeff(Nat.2) = b
}

theorem cubic_coeff_three(a: Int, b: Int, c: Int, d: Int) {
    int_cubic_polynomial(a, b, c, d).coeff(Nat.3) = a
}

theorem monomial_support_bounded_by_suc(n: Nat, r: Int) {
    polynomial_support_bounded_by(Polynomial[Int].monomial(n, r), n.suc)
}

theorem cubic_support_bounded_by_four(a: Int, b: Int, c: Int, d: Int) {
    polynomial_support_bounded_by(int_cubic_polynomial(a, b, c, d), Nat.4)
}

define rat_cubic_polynomial(a: Int, b: Int, c: Int, d: Int) -> Polynomial[Rat] {
    polynomial_map(int_to_rat_hom, int_cubic_polynomial(a, b, c, d))
}

theorem rat_cubic_coeff_apply(a: Int, b: Int, c: Int, d: Int, i: Nat) {
    rat_cubic_polynomial(a, b, c, d).coeff(i) = Rat.from_int(int_cubic_polynomial(a, b, c, d).coeff(i))
}

theorem cubic_rat_root_coeff_eval_zero(a: Int, b: Int, c: Int, d: Int, p: Int, q: Int) {
    q != Int.0 and is_coprime(p, q) and
    polynomial_eval(rat_cubic_polynomial(a, b, c, d),
        Rat.from_int(p) / Rat.from_int(q)) = Rat.0
    implies coeff_eval(rat_coeffs(int_cubic_polynomial(a, b, c, d).coeff),
        Rat.from_int(p) / Rat.from_int(q), Nat.3.suc) = Rat.0
}

theorem cubic_rat_root_denominator_divide(c: Nat -> Int, a: Int, b: Int, n: Nat) {
    b != Int.0 and is_coprime(a, b) and
        coeff_eval(rat_coeffs(c), Rat.from_int(a) / Rat.from_int(b), n.suc) = Rat.0
    implies b.divides(c(n))
}

theorem cubic_rat_root_numerator_divide(c: Nat -> Int, a: Int, b: Int, n: Nat) {
    b != Int.0 and is_coprime(a, b) and
        coeff_eval(rat_coeffs(c), Rat.from_int(a) / Rat.from_int(b), n.suc) = Rat.0
    implies a.divides(c(Nat.0))
}

theorem cubic_rational_root_numerator_divides(a: Int, b: Int, c: Int, d: Int, p: Int, q: Int) {
    q != Int.0 and is_coprime(p, q) and
    polynomial_eval(rat_cubic_polynomial(a, b, c, d),
        Rat.from_int(p) / Rat.from_int(q)) = Rat.0
    implies p.divides(d)
}

theorem cubic_rational_root_denominator_divides(a: Int, b: Int, c: Int, d: Int, p: Int, q: Int) {
    q != Int.0 and is_coprime(p, q) and
    polynomial_eval(rat_cubic_polynomial(a, b, c, d),
        Rat.from_int(p) / Rat.from_int(q)) = Rat.0
    implies q.divides(a)
}

theorem int_neg_from_nat_add(n: Nat, m: Nat) {
    -Int.from_nat(m) + Int.from_nat(n) = sub_nat(n, m)
}

theorem int_neg_from_nat_add_cancel(m: Nat, n: Nat, k: Nat) {
    m + k = n implies -Int.from_nat(m) + Int.from_nat(n) = Int.from_nat(k)
}

theorem int_neg_from_nat_add_neg(m: Nat, n: Nat, k: Nat) {
    n + k = m implies -Int.from_nat(m) + Int.from_nat(n) = -Int.from_nat(k)
}

theorem int_neg_six_add_two {
