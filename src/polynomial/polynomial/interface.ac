}

theorem int_three_mul_neg_three {
    Int.3 * -Int.3 = -Int.9
}

let int_cubic_x3_minus_6x2_plus_11x_minus_6: Polynomial[Int] =
    int_cubic_polynomial(Int.1, -Int.6, Int.11, -Int.6)

theorem int_cubic_root_two {
    polynomial_eval(int_cubic_x3_minus_6x2_plus_11x_minus_6, Int.2) = Int.0
}

theorem int_cubic_root_three {
    polynomial_eval(int_cubic_x3_minus_6x2_plus_11x_minus_6, Int.3) = Int.0
}

theorem int_cubic_root_one {
    polynomial_eval(int_cubic_x3_minus_6x2_plus_11x_minus_6, Int.1) = Int.0
}

theorem rat_cubic_x3_minus_6x2_plus_11x_minus_6_root_one {
    polynomial_eval(rat_cubic_polynomial(Int.1, -Int.6, Int.11, -Int.6), Rat.from_int(Int.1)) = Rat.0
}

theorem rat_cubic_x3_minus_6x2_plus_11x_minus_6_root_two {
    polynomial_eval(rat_cubic_polynomial(Int.1, -Int.6, Int.11, -Int.6), Rat.from_int(Int.2)) = Rat.0
}

theorem rat_cubic_x3_minus_6x2_plus_11x_minus_6_root_three {
    polynomial_eval(rat_cubic_polynomial(Int.1, -Int.6, Int.11, -Int.6), Rat.from_int(Int.3)) = Rat.0
}

define linear_polynomial[R: Semiring](a: R, b: R) -> Polynomial[R] {
    polynomial_constant(b) + polynomial_monomial(Nat.1, a)
}

define quadratic_polynomial[R: Semiring](a: R, b: R, c: R) -> Polynomial[R] {
    polynomial_constant(c) + polynomial_monomial(Nat.1, b) + polynomial_monomial(Nat.2, a)
}

theorem polynomial_monomial_support_bounded_by_suc[R: Semiring](n: Nat, r: R) {
    polynomial_support_bounded_by(Polynomial[R].monomial(n, r), n.suc)
}

theorem linear_polynomial_coeff_zero[R: Semiring](a: R, b: R) {
    linear_polynomial(a, b).coeff(Nat.0) = b
}

theorem linear_polynomial_coeff_one[R: Semiring](a: R, b: R) {
    linear_polynomial(a, b).coeff(Nat.1) = a
}

theorem linear_polynomial_support_bounded_by_two[R: Semiring](a: R, b: R) {
    polynomial_support_bounded_by(linear_polynomial(a, b), Nat.2)
}

theorem quadratic_polynomial_coeff_zero[R: Semiring](a: R, b: R, c: R) {
    quadratic_polynomial(a, b, c).coeff(Nat.0) = c
}

theorem quadratic_polynomial_coeff_one[R: Semiring](a: R, b: R, c: R) {
    quadratic_polynomial(a, b, c).coeff(Nat.1) = b
}

theorem quadratic_polynomial_coeff_two[R: Semiring](a: R, b: R, c: R) {
    quadratic_polynomial(a, b, c).coeff(Nat.2) = a
}

theorem quadratic_polynomial_support_bounded_by_three[R: Semiring](a: R, b: R, c: R) {
    polynomial_support_bounded_by(quadratic_polynomial(a, b, c), Nat.3)
}

theorem polynomial_degree_sum_le_max[R: Semiring](
    p: Polynomial[R], q: Polynomial[R], m: Nat, n: Nat
) {
    polynomial_degree_le(p, m) and polynomial_degree_le(q, n) implies
    polynomial_degree_le(p + q, m.max(n))
}

theorem monomial_one_eval[R: CommRing](r: R, x: R) {
    polynomial_eval(Polynomial[R].monomial(Nat.1, r), x) = r * x
}

theorem monomial_two_eval[R: CommRing](r: R, x: R) {
    polynomial_eval(Polynomial[R].monomial(Nat.2, r), x) = r * x * x
}

theorem linear_polynomial_eval[R: CommRing](a: R, b: R, x: R) {
    polynomial_eval(linear_polynomial(a, b), x) = b + a * x
}

theorem quadratic_polynomial_eval[R: CommRing](a: R, b: R, c: R, x: R) {
    polynomial_eval(quadratic_polynomial(a, b, c), x) = c + b * x + a * x * x
}

theorem linear_mul_coeff_zero[R: CommRing](a: R, b: R, c: R, d: R) {
    polynomial_mul(linear_polynomial(a, b), linear_polynomial(c, d)).coeff(Nat.0) = b * d
}

theorem linear_mul_coeff_one[R: CommRing](a: R, b: R, c: R, d: R) {
    polynomial_mul(linear_polynomial(a, b), linear_polynomial(c, d)).coeff(Nat.1) = a * d + b * c
}

theorem linear_mul_coeff_two[R: CommRing](a: R, b: R, c: R, d: R) {
    polynomial_mul(linear_polynomial(a, b), linear_polynomial(c, d)).coeff(Nat.2) = a * c
}

theorem linear_mul_coeff_three[R: CommRing](a: R, b: R, c: R, d: R) {
    polynomial_mul(linear_polynomial(a, b), linear_polynomial(c, d)).coeff(Nat.3) = R.0
}

theorem linear_mul_support_bounded_by_four[R: CommRing](a: R, b: R, c: R, d: R) {
    polynomial_support_bounded_by(polynomial_mul(linear_polynomial(a, b), linear_polynomial(c, d)), Nat.4)
}

theorem quadratic_mul_coeff_four[R: CommRing](a: R, b: R, c: R, d: R, e: R, g: R) {
    polynomial_mul(quadratic_polynomial(a, b, c), quadratic_polynomial(d, e, g)).coeff(Nat.4) = a * d
}

theorem quadratic_mul_coeff_five[R: CommRing](a: R, b: R, c: R, d: R, e: R, g: R) {
    polynomial_mul(quadratic_polynomial(a, b, c), quadratic_polynomial(d, e, g)).coeff(Nat.5) = R.0
}

theorem quadratic_mul_support_bounded_by_five[R: CommRing](
    a: R, b: R, c: R, d: R, e: R, g: R
) {
    polynomial_support_bounded_by(polynomial_mul(quadratic_polynomial(a, b, c), quadratic_polynomial(d, e, g)), Nat.5)
}

theorem quadratic_product_degree[F: Field](a: F, b: F, c: F, d: F, e: F, g: F) {
    a != F.0 and d != F.0 implies
    polynomial_degree_le(polynomial_mul(quadratic_polynomial(a, b, c), quadratic_polynomial(d, e, g)), Nat.4) and
    not polynomial_degree_le(polynomial_mul(quadratic_polynomial(a, b, c), quadratic_polynomial(d, e, g)), Nat.3)
}

theorem polynomial_eval_homomorphism[R: CommRing](x: R, p: Polynomial[R], q: Polynomial[R]) {
    polynomial_eval(p + q, x) = polynomial_eval(p, x) + polynomial_eval(q, x) and
    polynomial_eval(polynomial_mul(p, q), x) = polynomial_eval(p, x) * polynomial_eval(q, x)
}

let field_x_minus_one[F: Field]: Polynomial[F] = linear_polynomial(F.1, -F.1)

let field_x_plus_one[F: Field]: Polynomial[F] = linear_polynomial(F.1, F.1)

let field_x_squared_minus_one[F: Field]: Polynomial[F] = quadratic_polynomial(F.1, F.0, -F.1)

theorem field_eval_add_concrete[F: Field](x: F) {
    polynomial_eval(field_x_minus_one[F] + field_x_plus_one[F], x) = (F.1 + F.1) * x
}

theorem field_eval_mul_concrete[F: Field](x: F) {
    polynomial_eval(polynomial_mul(field_x_minus_one[F], field_x_plus_one[F]), x) = x * x - F.1
}

theorem polynomial_remainder_theorem_global[R: CommRing](p: Polynomial[R], a: R) {
    polynomial_eval(p, a) = R.0 iff polynomial_divisible_by_x_minus_a_polynomial(p, a)
}

theorem field_x_squared_minus_one_has_root_one[F: Field] {
    polynomial_eval(field_x_squared_minus_one[F], F.1) = F.0
}

theorem field_x_minus_one_divides_x_squared_minus_one[F: Field] {
    polynomial_divisible_by_x_minus_a_polynomial(field_x_squared_minus_one[F], F.1)
}

theorem field_x_minus_one_divides_imp_root_one[F: Field] {
    polynomial_divisible_by_x_minus_a_polynomial(field_x_squared_minus_one[F], F.1) implies
    polynomial_eval(field_x_squared_minus_one[F], F.1) = F.0
}

theorem field_x_squared_minus_one_root_iff_divisible[F: Field] {
    polynomial_eval(field_x_squared_minus_one[F], F.1) = F.0 iff
        polynomial_divisible_by_x_minus_a_polynomial(field_x_squared_minus_one[F], F.1)
}

theorem field_x_plus_one_witnesses_factor[F: Field] {
    polynomial_x_minus_a_polynomial_witness(field_x_squared_minus_one[F], F.1, field_x_plus_one[F])
}

theorem linear_zero_product[F: Field](a: F, b: F, c: F, d: F) {
    a != F.0 and
    polynomial_mul(linear_polynomial(a, b), linear_polynomial(c, d)) = Polynomial[F].zero
    implies linear_polynomial(c, d) = Polynomial[F].zero
}

theorem field_x_squared_minus_one_eq_mul[F: Field] {
    polynomial_mul(field_x_minus_one[F], field_x_plus_one[F]) = field_x_squared_minus_one[F]
}

theorem polynomial_constant_add[R: Semiring](r: R, s: R) {
    polynomial_constant(r + s) = polynomial_constant(r) + polynomial_constant(s)
}

theorem polynomial_constant_one[R: Semiring] {
    polynomial_constant(R.1) = Polynomial[R].one
}

theorem polynomial_constant_zero_poly[R: Semiring] {
    polynomial_constant(R.0) = Polynomial[R].zero
}

theorem polynomial_constant_eq_zero[R: Semiring](r: R) {
    (polynomial_constant(r) = Polynomial[R].zero) = (r = R.0)
}

theorem polynomial_constant_ne_zero[R: Semiring](r: R) {
    r != R.0 implies polynomial_constant(r) != Polynomial[R].zero
}

theorem polynomial_mul_add_right[R: CommRing](
    p: Polynomial[R], q: Polynomial[R], r: Polynomial[R]
) {
    polynomial_mul(p + q, r) = polynomial_mul(p, r) + polynomial_mul(q, r)
}

theorem polynomial_mul_neg_right[R: Ring](p: Polynomial[R], q: Polynomial[R]) {
    polynomial_mul(p, q.neg) = polynomial_mul(p, q).neg
}

theorem polynomial_mul_neg_left[R: CommRing](p: Polynomial[R], q: Polynomial[R]) {
    polynomial_mul(p.neg, q) = polynomial_mul(p, q).neg
}

theorem polynomial_scalar_distrib[R: CommRing](r: R, s: R, p: Polynomial[R]) {
    polynomial_mul(polynomial_constant(r + s), p) =
        polynomial_mul(polynomial_constant(r), p) + polynomial_mul(polynomial_constant(s), p)
}

theorem polynomial_mul_zero_left[R: CommRing](p: Polynomial[R]) {
    polynomial_mul(Polynomial[R].zero, p) = Polynomial[R].zero
}

theorem polynomial_mul_zero_right[R: CommRing](p: Polynomial[R]) {
    polynomial_mul(p, Polynomial[R].zero) = Polynomial[R].zero
}

theorem polynomial_divides_zero_right[R: CommRing](p: Polynomial[R]) {
    polynomial_divides(p, Polynomial[R].zero)
}

theorem polynomial_divides_zero_left_imp[R: CommRing](p: Polynomial[R]) {
    polynomial_divides(Polynomial[R].zero, p) implies p = Polynomial[R].zero
}

theorem polynomial_divides_zero_iff[R: CommRing](p: Polynomial[R]) {
    polynomial_divides(Polynomial[R].zero, p) iff p = Polynomial[R].zero
}

theorem polynomial_divides_add[R: CommRing](
    d: Polynomial[R], p: Polynomial[R], q: Polynomial[R]
) {
    polynomial_divides(d, p) and polynomial_divides(d, q) implies polynomial_divides(d, p + q)
}

theorem polynomial_divides_sub[R: CommRing](
    d: Polynomial[R], p: Polynomial[R], q: Polynomial[R]
) {
    polynomial_divides(d, p) and polynomial_divides(d, q) implies polynomial_divides(d, p.sub(q))
}

theorem polynomial_divides_eval_witness[R: CommRing](
    d: Polynomial[R], p: Polynomial[R], r: Polynomial[R], x: R
) {
    polynomial_mul(d, r) = p implies
    polynomial_eval(p, x) = polynomial_eval(d, x) * polynomial_eval(r, x)
}

theorem polynomial_divides_eval[R: CommRing](
    d: Polynomial[R], p: Polynomial[R], x: R
) {
    polynomial_divides(d, p) implies
    exists(r: Polynomial[R]) {
        polynomial_eval(p, x) = polynomial_eval(d, x) * polynomial_eval(r, x)
    }
}

theorem polynomial_eval_zero_point[R: Semiring](p: Polynomial[R]) {
    polynomial_eval(p, R.0) = p.coeff(Nat.0)
}

theorem polynomial_eval_monomial[R: CommRing](n: Nat, r: R, x: R) {
    polynomial_eval(Polynomial[R].monomial(n, r), x) = r * x.pow(n)
}

theorem polynomial_eval_constant_eq_zero[R: Semiring](r: R, x: R) {
    (polynomial_eval(Polynomial[R].constant(r), x) = R.0) = (r = R.0)
}

theorem polynomial_eval_constant_mul[R: CommRing](r: R, p: Polynomial[R], x: R) {
    polynomial_eval(polynomial_mul(polynomial_constant(r), p), x) =
        r * polynomial_eval(p, x)
}

theorem polynomial_eval_mul_add_distributive[R: CommRing](
    p: Polynomial[R], q: Polynomial[R], r: Polynomial[R], x: R
) {
    polynomial_eval(polynomial_mul(p, q + r), x) =
        polynomial_eval(p, x) * (polynomial_eval(q, x) + polynomial_eval(r, x))
}

theorem polynomial_eval_add_mul_distributive[R: CommRing](
    p: Polynomial[R], q: Polynomial[R], r: Polynomial[R], x: R
) {
    polynomial_eval(polynomial_mul(p + q, r), x) =
        (polynomial_eval(p, x) + polynomial_eval(q, x)) * polynomial_eval(r, x)
}

theorem polynomial_eval_mul_one[R: CommRing](p: Polynomial[R], x: R) {
    polynomial_eval(polynomial_mul(p, Polynomial[R].one), x) = polynomial_eval(p, x)
}

theorem polynomial_eval_one_mul[R: CommRing](p: Polynomial[R], x: R) {
    polynomial_eval(polynomial_mul(Polynomial[R].one, p), x) = polynomial_eval(p, x)
}

theorem polynomial_eval_linear_combination[R: CommRing](
    r1: R, r2: R, p: Polynomial[R], q: Polynomial[R], x: R
) {
    polynomial_eval(polynomial_mul(polynomial_constant(r1), p) +
        polynomial_mul(polynomial_constant(r2), q), x) =
        r1 * polynomial_eval(p, x) + r2 * polynomial_eval(q, x)
}

theorem polynomial_eval_scalar_mul_comm[R: CommRing](r: R, p: Polynomial[R], x: R) {
    polynomial_eval(polynomial_mul(polynomial_constant(r), p), x) =
        polynomial_eval(polynomial_mul(p, polynomial_constant(r)), x)
}

theorem polynomial_monomial_eq_zero[R: Semiring](n: Nat, r: R) {
    (polynomial_monomial(n, r) = Polynomial[R].zero) = (r = R.0)
}

theorem polynomial_monomial_ne_zero_of_ne[R: Semiring](n: Nat, r: R) {
    r != R.0 implies polynomial_monomial(n, r) != Polynomial[R].zero
}

theorem polynomial_constant_ne_zero_of_ne[R: Semiring](r: R) {
    r != R.0 implies polynomial_constant(r) != Polynomial[R].zero
}

theorem polynomial_x_pow_eval[R: CommRing](n: Nat, x: R) {
    polynomial_eval(polynomial_monomial(n, R.1), x) = x.pow(n)
}

theorem polynomial_x_pow_zero_eval[R: CommRing](n: Nat) {
    polynomial_eval(polynomial_monomial(n.suc, R.1), R.0) = R.0
}

theorem polynomial_degree_le_zero[R: Semiring](d: Nat) {
    polynomial_degree_le(Polynomial[R].zero, d)
}

theorem polynomial_degree_le_one_iff_linear[R: Semiring](p: Polynomial[R]) {
    polynomial_degree_le(p, Nat.1) iff
        p = polynomial_constant(p.coeff(Nat.0)) + polynomial_monomial(Nat.1, p.coeff(Nat.1))
}

theorem polynomial_degree_sum_leading_coeff[R: Semiring](
    p: Polynomial[R], q: Polynomial[R], m: Nat, n: Nat
) {
    polynomial_degree_le(p, m) and polynomial_degree_le(q, n) and m < n implies
    (p + q).coeff(n) = q.coeff(n)
}

theorem polynomial_degree_sum_exact[F: Field](
    p: Polynomial[F], q: Polynomial[F], m: Nat, n: Nat, k: Nat
) {
    polynomial_degree_le(p, m) and polynomial_degree_le(q, n) and m < n and k < n and
    q.coeff(n) != F.0 implies not polynomial_degree_le(p + q, k)
}

theorem polynomial_degree_neg_iff[R: Ring](p: Polynomial[R], d: Nat) {
    polynomial_degree_le(p.neg, d) = polynomial_degree_le(p, d)
}

theorem polynomial_degree_sub_le_max[R: Ring](
    p: Polynomial[R], q: Polynomial[R], m: Nat, n: Nat
) {
    polynomial_degree_le(p, m) and polynomial_degree_le(q, n) implies
    polynomial_degree_le(p.sub(q), m.max(n))
}

define degree_bound_at[R: Semiring](p: Polynomial[R], n: Nat) -> Bool {
    polynomial_support_bounded_by(p, n) implies
    (p = Polynomial[R].zero or
        exists(d: Nat) {
            d < n and polynomial_degree_le(p, d) and p.coeff(d) != R.0
        })
}

theorem polynomial_exact_degree_bound[R: Semiring](p: Polynomial[R], n: Nat) {
    polynomial_support_bounded_by(p, n) implies
    (p = Polynomial[R].zero or
        exists(d: Nat) {
            d < n and polynomial_degree_le(p, d) and p.coeff(d) != R.0
        })
}

theorem polynomial_degree_exists[R: Semiring](p: Polynomial[R]) {
    exists(result: Nat) {
        (p = Polynomial[R].zero implies result = Nat.0) and
        (p != Polynomial[R].zero implies polynomial_degree_le(p, result) and p.coeff(result) != R.0)
    }
}

let polynomial_degree[R: Semiring](p: Polynomial[R]) -> result: Nat satisfy {
    (p = Polynomial[R].zero implies result = Nat.0) and
    (p != Polynomial[R].zero implies polynomial_degree_le(p, result) and p.coeff(result) != R.0)
}

theorem polynomial_degree_le_self[R: Semiring](p: Polynomial[R]) {
    polynomial_degree_le(p, polynomial_degree(p))
}

theorem polynomial_degree_zero[R: Semiring] {
    polynomial_degree(Polynomial[R].zero) = Nat.0
}

theorem polynomial_degree_coeff_nonzero[R: Semiring](p: Polynomial[R]) {
    p != Polynomial[R].zero implies p.coeff(polynomial_degree(p)) != R.0
}

theorem polynomial_degree_exact[R: Semiring](p: Polynomial[R], d: Nat) {
    polynomial_degree_le(p, d) and p.coeff(d) != R.0 implies polynomial_degree(p) = d
}

theorem polynomial_degree_monomial[R: Semiring](n: Nat, r: R) {
    r != R.0 implies polynomial_degree(polynomial_monomial(n, r)) = n
}

theorem polynomial_sub_add_cancel[R: Ring](p: Polynomial[R], t: Polynomial[R]) {
    p.sub(t) + t = p
}

define division_claim_at[F: Field](d: Polynomial[F], n: Nat, m: Nat, p: Polynomial[F]) -> Bool {
    polynomial_support_bounded_by(p, m) implies
    exists(q: Polynomial[F], r: Polynomial[F]) {
        p = polynomial_mul(q, d) + r and polynomial_support_bounded_by(r, n)
    }
}

define division_claim[F: Field](d: Polynomial[F], n: Nat, m: Nat) -> Bool {
    forall(p: Polynomial[F]) {
        division_claim_at(d, n, m, p)
    }
}

theorem division_claim_apply[F: Field](d: Polynomial[F], n: Nat, m: Nat, p: Polynomial[F]) {
    division_claim(d, n, m) implies division_claim_at(d, n, m, p)
}

theorem polynomial_euclidean_division[F: Field](p: Polynomial[F], d: Polynomial[F], n: Nat) {
    polynomial_degree_le(d, n) and d.coeff(n) != F.0
    implies exists(q: Polynomial[F], r: Polynomial[F]) {
        p = polynomial_mul(q, d) + r and polynomial_support_bounded_by(r, n)
    }
}

define polynomial_monomial_partial_sum[R: Semiring](p: Polynomial[R], n: Nat) -> Polynomial[R] {
    match n {
        Nat.zero {
            Polynomial[R].zero
        }
        Nat.suc(pred) {
            polynomial_monomial_partial_sum(p, pred) + polynomial_monomial(pred, p.coeff(pred))
        }
    }
}

theorem polynomial_eq_monomial_partial_sum_of_support_bounded[R: Semiring](
    p: Polynomial[R], n: Nat
) {
    polynomial_support_bounded_by(p, n) implies p = polynomial_monomial_partial_sum(p, n)
}

theorem polynomial_eq_monomial_partial_sum[R: Semiring](p: Polynomial[R]) {
    exists(n: Nat) {
        p = polynomial_monomial_partial_sum(p, n)
    }
}

theorem polynomial_neg_support_bounded_by[R: Ring](p: Polynomial[R], n: Nat) {
    polynomial_support_bounded_by(p, n)
        implies polynomial_support_bounded_by(p.neg, n)
}

theorem polynomial_sub_support_bounded_by[R: Ring](
    p: Polynomial[R], q: Polynomial[R], n: Nat
) {
    polynomial_support_bounded_by(p, n) and polynomial_support_bounded_by(q, n)
        implies polynomial_support_bounded_by(p.sub(q), n)
}

theorem remainder_theorem_global[R: CommRing](p: Polynomial[R], a: R, x: R) {
    exists(q: Polynomial[R]) {
        polynomial_eval(p, x) = polynomial_eval(p, a) + polynomial_eval(q, x) * (x - a)
    }
}

theorem remainder_theorem_root_form[R: CommRing](p: Polynomial[R], a: R) {
    polynomial_eval(p, a) = R.0 iff polynomial_divisible_by_x_minus_a_polynomial(p, a)
}

theorem x_squared_minus_one_remainder_at_one[F: Field] {
    polynomial_eval(field_x_squared_minus_one[F], F.1) = F.0
}

theorem x_minus_one_divides_x_squared_minus_one[F: Field] {
    polynomial_divisible_by_x_minus_a_polynomial(field_x_squared_minus_one[F], F.1)
}

theorem x_squared_minus_one_remainder_identity[F: Field] {
    polynomial_x_minus_a_polynomial_witness(field_x_squared_minus_one[F], F.1, field_x_plus_one[F])
}

theorem factor_theorem[R: CommRing](p: Polynomial[R], a: R) {
    polynomial_eval(p, a) = R.0 iff polynomial_divisible_by_x_minus_a_polynomial(p, a)
}

theorem x_squared_minus_one_root_one[F: Field] {
    polynomial_eval(field_x_squared_minus_one[F], F.1) = F.0
}

theorem x_squared_minus_one_root_neg_one[F: Field] {
    polynomial_eval(field_x_squared_minus_one[F], -F.1) = F.0
}

theorem x_plus_one_divides_x_squared_minus_one[F: Field] {
    polynomial_divisible_by_x_minus_a_polynomial(field_x_squared_minus_one[F], -F.1)
}

theorem x_squared_minus_one_factorization[F: Field] {
    polynomial_mul(field_x_minus_one[F], field_x_plus_one[F]) = field_x_squared_minus_one[F]
}

theorem x_minus_one_witnesses_factor_neg_one[F: Field] {
    polynomial_x_minus_a_polynomial_witness(field_x_squared_minus_one[F], -F.1, field_x_minus_one[F])
}

define cubic_polynomial[R: Semiring](a: R, b: R, c: R, d: R) -> Polynomial[R] {
    polynomial_constant(d) + polynomial_monomial(Nat.1, c) + polynomial_monomial(Nat.2, b) +
        polynomial_monomial(Nat.3, a)
}

theorem cubic_polynomial_coeff_zero[R: Semiring](a: R, b: R, c: R, d: R) {
    cubic_polynomial(a, b, c, d).coeff(Nat.0) = d
}

theorem cubic_polynomial_coeff_three[R: Semiring](a: R, b: R, c: R, d: R) {
    cubic_polynomial(a, b, c, d).coeff(Nat.3) = a
}

theorem cubic_polynomial_coeff_one[R: Semiring](a: R, b: R, c: R, d: R) {
    cubic_polynomial(a, b, c, d).coeff(Nat.1) = c
}

theorem cubic_polynomial_coeff_two[R: Semiring](a: R, b: R, c: R, d: R) {
    cubic_polynomial(a, b, c, d).coeff(Nat.2) = b
}

theorem cubic_polynomial_support_bounded_by_four[R: Semiring](a: R, b: R, c: R, d: R) {
    polynomial_support_bounded_by(cubic_polynomial(a, b, c, d), Nat.4)
}

theorem monomial_three_eval[R: CommRing](r: R, x: R) {
    polynomial_eval(Polynomial[R].monomial(Nat.3, r), x) = r * x * x * x
}

theorem cubic_polynomial_eval[R: CommRing](a: R, b: R, c: R, d: R, x: R) {
    polynomial_eval(cubic_polynomial(a, b, c, d), x) = d + c * x + b * x * x + a * x * x * x
}

theorem int_mul_neg_from_nat(m: Nat, n: Nat) {
    Int.from_nat(m) * -Int.from_nat(n) = -Int.from_nat(m * n)
}

theorem int_cubic_x3_minus_6x2_plus_11x_minus_6_root_one {
    polynomial_eval(int_cubic_x3_minus_6x2_plus_11x_minus_6, Int.1) = Int.0
}

theorem int_cubic_x3_minus_6x2_plus_11x_minus_6_root_two {
    polynomial_eval(int_cubic_x3_minus_6x2_plus_11x_minus_6, Int.2) = Int.0
}

theorem int_cubic_x3_minus_6x2_plus_11x_minus_6_root_three {
    polynomial_eval(int_cubic_x3_minus_6x2_plus_11x_minus_6, Int.3) = Int.0
}

let real_x_cubed_minus_one: Polynomial[Real] = cubic_polynomial[Real](Real.1, Real.0, Real.0, -Real.1)

theorem real_x_cubed_minus_one_root_one {
    polynomial_eval(real_x_cubed_minus_one, Real.1) = Real.0
}

let int_cubic_x3_minus_x: Polynomial[Int] = cubic_polynomial[Int](Int.1, Int.0, -Int.1, Int.0)

theorem int_cubic_x3_minus_x_root_zero {
    polynomial_eval(int_cubic_x3_minus_x, Int.0) = Int.0
}

theorem int_cubic_x3_minus_x_root_one {
    polynomial_eval(int_cubic_x3_minus_x, Int.1) = Int.0
}

theorem int_cubic_x3_minus_x_root_neg_one {
    polynomial_eval(int_cubic_x3_minus_x, -Int.1) = Int.0
}

theorem polynomial_eval_eq_of_eq[R: Semiring](p: Polynomial[R], q: Polynomial[R], x: R) {
    p = q implies polynomial_eval(p, x) = polynomial_eval(q, x)
}

theorem polynomial_eval_ext[R: Semiring](p: Polynomial[R], q: Polynomial[R]) {
    p = q implies forall(x: R) { polynomial_eval(p, x) = polynomial_eval(q, x) }
}

theorem polynomial_eval_eq_of_coeff_eq[R: Semiring](p: Polynomial[R], q: Polynomial[R], x: R) {
    (forall(n: Nat) { p.coeff(n) = q.coeff(n) }) implies polynomial_eval(p, x) = polynomial_eval(q, x)
}

theorem polynomial_eval_constant_add[R: Semiring](r: R, p: Polynomial[R], x: R) {
    polynomial_eval(Polynomial[R].constant(r) + p, x) = r + polynomial_eval(p, x)
}

theorem polynomial_eval_mul_assoc[R: CommRing](
    p: Polynomial[R],
    q: Polynomial[R],
    r: Polynomial[R],
    x: R
) {
    polynomial_eval(polynomial_mul(polynomial_mul(p, q), r), x) =
        polynomial_eval(polynomial_mul(p, polynomial_mul(q, r)), x)
}

theorem polynomial_eval_mul_comm[R: CommRing](p: Polynomial[R], q: Polynomial[R], x: R) {
    polynomial_eval(polynomial_mul(p, q), x) = polynomial_eval(polynomial_mul(q, p), x)
}

theorem polynomial_eval_mul_add_distrib[R: CommRing](
    p: Polynomial[R],
    q: Polynomial[R],
    r: Polynomial[R],
    s: Polynomial[R],
    x: R
) {
    polynomial_eval(polynomial_mul(p, q) + polynomial_mul(r, s), x) =
        polynomial_eval(p, x) * polynomial_eval(q, x) + polynomial_eval(r, x) * polynomial_eval(s, x)
}

theorem polynomial_factor_theorem_quotient_form[R: CommRing](p: Polynomial[R], a: R, n: Nat) {
    polynomial_support_bounded_by(p, n) and polynomial_eval(p, a) = R.0 implies
    polynomial_x_minus_a_polynomial_witness(p, a, polynomial_quotient(p, a, n))
}

theorem polynomial_eval_of_root_factor[R: CommRing](p: Polynomial[R], a: R, n: Nat, x: R) {
    polynomial_support_bounded_by(p, n) and polynomial_eval(p, a) = R.0 implies
    polynomial_eval(p, x) = polynomial_eval(polynomial_quotient(p, a, n), x) * (x - a)
}

theorem polynomial_remainder_theorem_iff[R: CommRing](p: Polynomial[R], a: R) {
    polynomial_eval(p, a) = R.0 iff polynomial_divisible_by_x_minus_a_polynomial(p, a)
}

theorem polynomial_root_mul_left[R: CommRing](p: Polynomial[R], q: Polynomial[R], a: R) {
    polynomial_eval(p, a) = R.0 implies polynomial_eval(polynomial_mul(p, q), a) = R.0
}

theorem polynomial_root_mul_right[R: CommRing](p: Polynomial[R], q: Polynomial[R], a: R) {
    polynomial_eval(q, a) = R.0 implies polynomial_eval(polynomial_mul(p, q), a) = R.0
}

theorem polynomial_root_of_product[F: Field](p: Polynomial[F], q: Polynomial[F], x: F) {
    polynomial_eval(polynomial_mul(p, q), x) = F.0 implies
    polynomial_eval(p, x) = F.0 or polynomial_eval(q, x) = F.0
}

define polynomial_shift_eval[R: CommRing](p: Polynomial[R], a: R, x: R) -> R {
    polynomial_eval(p, x + a)
}

theorem polynomial_shift_eval_zero[R: CommRing](p: Polynomial[R], x: R) {
    polynomial_shift_eval(p, R.0, x) = polynomial_eval(p, x)
}

theorem polynomial_shift_eval_twice[R: CommRing](p: Polynomial[R], a: R, b: R, x: R) {
    polynomial_eval(p, (x + a) + b) = polynomial_shift_eval(p, a + b, x)
}

theorem polynomial_shift_eval_constant[R: CommRing](r: R, a: R, x: R) {
    polynomial_shift_eval(Polynomial[R].constant(r), a, x) = r
}

theorem linear_polynomial_shift_eval[R: CommRing](a: R, b: R, t: R, x: R) {
    polynomial_eval(linear_polynomial(a, b + a * t), x) =
        polynomial_eval(linear_polynomial(a, b), x + t)
}

theorem polynomial_eq_zero_iff_coeff_zero[R: Semiring](p: Polynomial[R]) {
    (p = Polynomial[R].zero) iff (forall(n: Nat) { p.coeff(n) = R.0 })
}

theorem polynomial_eval_of_coeff_zero[R: Semiring](p: Polynomial[R], x: R) {
    (forall(n: Nat) { p.coeff(n) = R.0 }) implies polynomial_eval(p, x) = R.0
}

theorem polynomial_eval_constant_zero[R: Semiring](x: R) {
    polynomial_eval(Polynomial[R].constant(R.0), x) = R.0
}

theorem polynomial_monomial_add_same[R: Semiring](n: Nat, r: R, s: R) {
    polynomial_monomial(n, r) + polynomial_monomial(n, s) = polynomial_monomial(n, r + s)
}

theorem linear_polynomial_neg_root[R: CommRing](a: R) {
    polynomial_eval(linear_polynomial(R.1, -a), a) = R.0
}

theorem polynomial_linear_mul_quadratic[R: CommRing](a: R, b: R) {
    polynomial_mul(linear_polynomial(R.1, -a), linear_polynomial(R.1, -b)) =
        quadratic_polynomial(R.1, -(a + b), a * b)
}

theorem quadratic_root_vieta_a[R: CommRing](a: R, b: R) {
    polynomial_eval(quadratic_polynomial(R.1, -(a + b), a * b), a) = R.0
}

theorem quadratic_root_vieta_b[R: CommRing](a: R, b: R) {
    polynomial_eval(quadratic_polynomial(R.1, -(a + b), a * b), b) = R.0
}

theorem quadratic_eval_factorized[R: CommRing](a: R, b: R, x: R) {
    polynomial_eval(quadratic_polynomial(R.1, -(a + b), a * b), x) =
        polynomial_eval(linear_polynomial(R.1, -b), x) * (x - a)
}

theorem polynomial_linear_vieta_witness[R: CommRing](a: R, b: R) {
    polynomial_x_minus_a_polynomial_witness(
        quadratic_polynomial(R.1, -(a + b), a * b), a, linear_polynomial(R.1, -b))
}

theorem polynomial_linear_vieta_divides[R: CommRing](a: R, b: R) {
    polynomial_divisible_by_x_minus_a_polynomial(
        quadratic_polynomial(R.1, -(a + b), a * b), a)
}

theorem polynomial_linear_shift_eval[R: CommRing](a: R, b: R, t: R, x: R) {
    polynomial_eval(linear_polynomial(a, b + a * t), x) =
        polynomial_eval(linear_polynomial(a, b), x + t)
}

theorem polynomial_linear_compose_eval[R: CommRing](a: R, b: R, c: R, d: R, x: R) {
    polynomial_eval(linear_polynomial(a, b), polynomial_eval(linear_polynomial(c, d), x)) =
        (b + a * d) + (a * c) * x
}

theorem vieta_quadratic_coeff_linear[R: CommRing](r1: R, r2: R) {
    quadratic_polynomial(R.1, -(r1 + r2), r1 * r2).coeff(Nat.1) = -(r1 + r2)
}

theorem vieta_quadratic_coeff_constant[R: CommRing](r1: R, r2: R) {
    quadratic_polynomial(R.1, -(r1 + r2), r1 * r2).coeff(Nat.0) = r1 * r2
}

theorem vieta_quadratic_coeff_leading[R: CommRing](r1: R, r2: R) {
    quadratic_polynomial(R.1, -(r1 + r2), r1 * r2).coeff(Nat.2) = R.1
}

let real_x_squared_minus_one: Polynomial[Real] =
    quadratic_polynomial(Real.1, Real.0, -Real.1)

theorem polynomial_real_factor_theorem(p: Polynomial[Real], a: Real) {
    (polynomial_eval(p, a) = Real.0) =
        polynomial_divisible_by_x_minus_a_polynomial(p, a)
}

theorem polynomial_real_factor_theorem_forward(p: Polynomial[Real], a: Real) {
    polynomial_eval(p, a) = Real.0 implies
    polynomial_divisible_by_x_minus_a_polynomial(p, a)
}

theorem real_x_squared_minus_one_eq_vieta {
    real_x_squared_minus_one =
        quadratic_polynomial(Real.1, -(Real.1 + -Real.1), Real.1 * -Real.1)
}

theorem real_x_squared_minus_one_root_one {
    polynomial_eval(real_x_squared_minus_one, Real.1) = Real.0
}

theorem real_x_squared_minus_one_root_neg_one {
    polynomial_eval(real_x_squared_minus_one, -Real.1) = Real.0
}

theorem real_x_minus_one_divides_x_squared_minus_one {
    polynomial_divisible_by_x_minus_a_polynomial(real_x_squared_minus_one, Real.1)
}

theorem real_x_squared_minus_one_root_iff_divides {
    (polynomial_eval(real_x_squared_minus_one, Real.1) = Real.0) =
        polynomial_divisible_by_x_minus_a_polynomial(real_x_squared_minus_one, Real.1)
}

theorem real_x_squared_minus_one_eval_factorized(x: Real) {
    polynomial_eval(real_x_squared_minus_one, x) =
        polynomial_eval(linear_polynomial(Real.1, Real.1), x) * (x - Real.1)
}

let real_x_squared_minus_x: Polynomial[Real] =
    quadratic_polynomial(Real.1, -Real.1, Real.0)

theorem real_x_squared_minus_x_eq_vieta {
    real_x_squared_minus_x =
        quadratic_polynomial(Real.1, -(Real.0 + Real.1), Real.0 * Real.1)
}

theorem real_x_squared_minus_x_root_zero {
    polynomial_eval(real_x_squared_minus_x, Real.0) = Real.0
}

theorem real_x_squared_minus_x_root_one {
    polynomial_eval(real_x_squared_minus_x, Real.1) = Real.0
}

theorem real_x_squared_minus_one_eq_mul {
    polynomial_mul(linear_polynomial(Real.1, -Real.1), linear_polynomial(Real.1, Real.1)) =
        real_x_squared_minus_one
}

theorem real_x_squared_minus_one_degree {
    polynomial_degree_le(real_x_squared_minus_one, Nat.2) and
    not polynomial_degree_le(real_x_squared_minus_one, Nat.1)
}

define polynomial_scale_eval[R: CommRing](p: Polynomial[R], c: R, x: R) -> R {
    polynomial_eval(p, c * x)
}
