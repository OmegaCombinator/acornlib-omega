}

theorem r2_sub_add_eq_sub_sub(
    x: Pair[Real, Real], y: Pair[Real, Real], z: Pair[Real, Real]
) {
    r2_sub(x, r2_add(y, z)) = r2_sub(r2_sub(x, y), z)
