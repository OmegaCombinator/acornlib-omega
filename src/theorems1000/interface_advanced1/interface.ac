define quadratic_value(b: Real, c: Real, x: Real) -> Real {
    x * x + b * x + c
}

theorem real_square_diff(x: Real, y: Real) {
    x * x - y * y = (x - y) * (x + y)
}

theorem real_sub_add_three(a: Real, b: Real, c: Real, d: Real, e: Real, f: Real) {
    a + b + c - (d + e + f) = (a - d) + (b - e) + (c - f)
}

theorem quadratic_value_expand(b: Real, c: Real, x: Real) {
    quadratic_value(b, c, x) = x * x + b * x + c
}

theorem vieta_root_sum(r1: Real, r2: Real, b: Real, c: Real) {
    r1 != r2 and quadratic_value(b, c, r1) = Real.0 and quadratic_value(b, c, r2) = Real.0 implies
    r1 + r2 = -b
}

theorem vieta_root_product(r1: Real, r2: Real, b: Real, c: Real) {
    r1 != r2 and quadratic_value(b, c, r1) = Real.0 and quadratic_value(b, c, r2) = Real.0 implies
    r1 * r2 = c
}

theorem theorems1000_vieta_quadratic(r1: Real, r2: Real, b: Real, c: Real) {
    r1 != r2 and quadratic_value(b, c, r1) = Real.0 and quadratic_value(b, c, r2) = Real.0 implies
    r1 + r2 = -b and r1 * r2 = c
}

theorem theorems1000_viviani_area(
    a: Pair[Real, Real], b: Pair[Real, Real], c: Pair[Real, Real],
    p: Pair[Real, Real]
) {
    r2_cross(r2_sub(b, p), r2_sub(c, p)) +
        r2_cross(r2_sub(c, p), r2_sub(a, p)) +
        r2_cross(r2_sub(a, p), r2_sub(b, p)) =
        r2_cross(r2_sub(b, a), r2_sub(c, a))
}

theorem theorems1000_wilson_prime_imp_congr(p: Nat) {
    p.is_prime implies (p - Nat.1).factorial.congr_mod(p - Nat.1, p)
}

theorem theorems1000_wilson_congr_imp_prime(p: Nat) {
    p != Nat.1 and (p - Nat.1).factorial.congr_mod(p - Nat.1, p) implies p.is_prime
}

theorem wilson_sub_sub(p: Nat) {
    Nat.1 < p implies (p - Nat.1) - Nat.1 = p - Nat.2
}

theorem wilson_pred_coprime(p: Nat) {
    p.is_prime implies (p - Nat.1).coprime(p)
}

theorem theorems1000_wilson_corollary(p: Nat) {
    p.is_prime implies (p - Nat.2).factorial.congr_mod(Nat.1, p)
}
