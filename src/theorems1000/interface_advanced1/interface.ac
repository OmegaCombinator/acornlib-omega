theorem ptolemy_parall_dc(a: Pair[Real, Real], b: Pair[Real, Real], c: Pair[Real, Real], d: Pair[Real, Real]) {
    r2_add(a, c) = r2_add(b, d) implies r2_sub(d, c) = r2_sub(a, b)
}

theorem ptolemy_parall_ad(a: Pair[Real, Real], b: Pair[Real, Real], c: Pair[Real, Real], d: Pair[Real, Real]) {
    r2_add(a, c) = r2_add(b, d) implies r2_sub(a, d) = r2_sub(b, c)
}

theorem ptolemy_diag_norm_eq(a: Pair[Real, Real], b: Pair[Real, Real], c: Pair[Real, Real], d: Pair[Real, Real]) {
    r2_add(a, c) = r2_add(b, d) and r2_orthogonal(r2_sub(a, b), r2_sub(c, b)) implies
    r2_norm_sq(r2_sub(c, a)) = r2_norm_sq(r2_sub(d, b))
}

theorem theorems1000_ptolemy_rectangle(
    a: Pair[Real, Real], b: Pair[Real, Real], c: Pair[Real, Real], d: Pair[Real, Real],
    w: Real, x: Real, y: Real, z: Real, p: Real, q: Real
) {
    r2_add(a, c) = r2_add(b, d) and
    r2_orthogonal(r2_sub(a, b), r2_sub(c, b)) and
    w * w = r2_norm_sq(r2_sub(b, a)) and
    x * x = r2_norm_sq(r2_sub(c, b)) and
    y * y = r2_norm_sq(r2_sub(d, c)) and
    z * z = r2_norm_sq(r2_sub(a, d)) and
    p * p = r2_norm_sq(r2_sub(c, a)) and
    q * q = r2_norm_sq(r2_sub(d, b)) and
    Real.0 <= w and Real.0 <= x and Real.0 <= y and Real.0 <= z and
    Real.0 <= p and Real.0 <= q
    implies p * q = w * y + x * z
}

theorem theorems1000_rolle(f: Real -> Real, a: Real, b: Real) {
    continuous_on_closed(f, a, b) and a < b and differentiable_on_open(f, a, b) and f(a) = f(b)
    implies exists(c: Real) {
        a < c and c < b and has_derivative_at(f, c, Real.0)
    }
}

let real_two: Real = Real.1 + Real.1

/// The real number four, `1 + 1 + 1 + 1` (the digit `Real.4` is not defined
/// in the library).

let real_four: Real = Real.1 + Real.1 + Real.1 + Real.1

/// Two times two is four.
theorem sg_two_times_two {
    real_two * real_two = real_four
}

theorem sg_difference_of_squares(x: Real, y: Real) {
    (x + y) * (x - y) = x * x - y * y
}

theorem sg_square_add(x: Real, y: Real) {
    (x + y) * (x + y) = x * x + y * x + (x * y + y * y)
}

theorem sg_regroup_first(a: Real, b: Real) {
    a * a + real_two * a * b + real_two * (b * b) =
        (a * a + real_two * (b * b)) + real_two * a * b
}

theorem sg_regroup_second(a: Real, b: Real) {
    a * a - real_two * a * b + real_two * (b * b) =
        (a * a + real_two * (b * b)) - real_two * a * b
}

theorem sg_u_square(a: Real, b: Real) {
    (a * a + real_two * (b * b)) * (a * a + real_two * (b * b)) =
        a * a * (a * a) + real_two * (b * b) * (a * a) +
            (a * a * (real_two * (b * b)) + real_two * (b * b) * (real_two * (b * b)))
}

theorem sg_middle_terms(a: Real, b: Real) {
    real_two * (b * b) * (a * a) = real_two * (a * a) * (b * b) and
    a * a * (real_two * (b * b)) = real_two * (a * a) * (b * b)
}

theorem sg_middle_sum(a: Real, b: Real) {
    real_two * (a * a) * (b * b) + real_two * (a * a) * (b * b) =
        real_four * (a * a) * (b * b)
}

theorem sg_last_term(a: Real, b: Real) {
    real_two * (b * b) * (real_two * (b * b)) = real_four * (b * b * b * b)
}

theorem sg_v_square(a: Real, b: Real) {
    (real_two * a * b) * (real_two * a * b) = real_four * (a * a) * (b * b)
}

theorem sg_expansion_combine(a: Real, b: Real) {
    real_two * (b * b) * (a * a) +
        (a * a * (real_two * (b * b)) + real_two * (b * b) * (real_two * (b * b))) =
        real_four * (a * a) * (b * b) + real_four * (b * b * b * b)
}

theorem sg_cancel_middle(a: Real, b: Real) {
    a * a * (a * a) + real_four * (a * a) * (b * b) +
        real_four * (b * b * b * b) - real_four * (a * a) * (b * b) =
        a * a * a * a + real_four * (b * b * b * b)
}

theorem theorems1000_sophie_germain(a: Real, b: Real) {
    (a * a + real_two * a * b + real_two * (b * b)) *
        (a * a - real_two * a * b + real_two * (b * b)) =
        a * a * a * a + real_four * (b * b * b * b)
}

theorem theorems1000_squeeze(a: Nat -> Real, b: Nat -> Real, c: Nat -> Real, l: Real) {
    seq_lte(a, b) and seq_lte(b, c) and converges_to(a, l) and converges_to(c, l)
    implies converges_to(b, l)
}

theorem star_factorial_form(n: Nat, k: Nat) {
    k <= n implies n.binom(k) * k.factorial * (n - k).factorial = n.factorial
}

theorem star_sub_one(a: Nat, b: Nat) {
    b + Nat.1 <= a implies a + Nat.1 - (b + Nat.2) = a - (b + Nat.1)
}

theorem star_sub_two(a: Nat, b: Nat) {
    b + Nat.1 <= a implies a + Nat.2 - (b + Nat.1) = a + Nat.1 - b
}

theorem star_sub_three(a: Nat, b: Nat) {
    b + Nat.1 <= a implies a + Nat.2 - (b + Nat.2) = a - b
}

theorem star_cancel(x: Nat, y: Nat, f: Nat) {
    f != Nat.0 and x * f = y * f implies x = y
}

theorem star_swap_groups23(a: Nat, b: Nat, c: Nat, d: Nat, e: Nat, f: Nat) {
    (a * b) * (c * d) * (e * f) = (a * b) * (e * f) * (c * d)
}

theorem star_swap_pair_middles(a: Nat, b: Nat, c: Nat, d: Nat) {
    (a * b) * (c * d) = (a * d) * (c * b)
}

theorem star_subst(b1: Nat, b2: Nat, b3: Nat, x: Nat, y: Nat) {
    x = y implies b1 * b2 * b3 * x = b1 * b2 * b3 * y
}

theorem star_mul_nonzero(x: Nat, y: Nat) {
    x != Nat.0 and y != Nat.0 implies x * y != Nat.0
}

theorem star_perm(f1: Nat, f2: Nat, f3: Nat, f4: Nat, f5: Nat, f6: Nat) {
    (f1 * f4) * (f3 * f5) * (f2 * f6) = (f2 * f5) * (f1 * f6) * (f3 * f4)
}

theorem star_regroup_left(b1: Nat, b2: Nat, b3: Nat, f1: Nat, f2: Nat, f3: Nat, f4: Nat, f5: Nat, f6: Nat) {
    b1 * b2 * b3 * (f1 * f4) * (f3 * f5) * (f2 * f6) =
        (b1 * f1 * f4) * (b2 * f3 * f5) * (b3 * f2 * f6)
}

theorem star_regroup_right(b1: Nat, b2: Nat, b3: Nat, f1: Nat, f2: Nat, f3: Nat, f4: Nat, f5: Nat, f6: Nat) {
    b1 * b2 * b3 * (f2 * f5) * (f1 * f6) * (f3 * f4) =
        (b1 * f2 * f5) * (b2 * f1 * f6) * (b3 * f3 * f4)
}

theorem theorems1000_star_of_david(a: Nat, b: Nat) {
    b + Nat.1 <= a implies
    a.binom(b) * a.suc.binom(b.suc.suc) * a.suc.suc.binom(b.suc) =
        a.binom(b.suc) * a.suc.binom(b) * a.suc.suc.binom(b.suc.suc)
}

theorem real_stewart_expand(u2: Real, v2: Real, uv: Real, t: Real) {
    t * (u2 + v2 + uv + uv) = t * u2 + t * v2 + t * uv + t * uv
}

theorem real_stewart_cancel(u2: Real, v2: Real, uv: Real, t: Real) {
    (t * u2 + t * v2 + t * uv + t * uv) + (Real.1 - t) * u2 =
        u2 + t * v2 + t * uv + t * uv
}

theorem real_stewart_split(t: Real, v2: Real) {
    t * v2 = (t * t) * v2 + t * (Real.1 - t) * v2
}

theorem real_stewart_scalar(u2: Real, v2: Real, uv: Real, t: Real) {
    t * (u2 + v2 + uv + uv) + (Real.1 - t) * u2 =
        u2 + (t * t) * v2 + t * uv + t * uv + t * (Real.1 - t) * v2
}

theorem theorems1000_stewart(
    a: Pair[Real, Real], b: Pair[Real, Real], c: Pair[Real, Real],
    d: Pair[Real, Real], t: Real
) {
    r2_add(b, r2_smul(t, r2_sub(c, b))) = d implies
    t * r2_norm_sq(r2_sub(c, a)) + (Real.1 - t) * r2_norm_sq(r2_sub(b, a)) =
        r2_norm_sq(r2_sub(d, a)) + t * (Real.1 - t) * r2_norm_sq(r2_sub(c, b))
}

theorem r2_smul_add_scalar(k1: Real, k2: Real, a: Pair[Real, Real]) {
    r2_add(r2_smul(k1, a), r2_smul(k2, a)) = r2_smul(k1 + k2, a)
}

theorem stewart_vector_identity(
    b: Pair[Real, Real], c: Pair[Real, Real], d: Pair[Real, Real],
    m: Real, n: Real
) {
    r2_add(r2_smul(n, b), r2_smul(m, c)) = r2_smul(m + n, d) implies
    r2_add(r2_smul(n, r2_sub(b, d)), r2_smul(m, r2_sub(c, d))) = Pair.new(Real.0, Real.0)
}

theorem stewart_dot_zero(
    a: Pair[Real, Real], b: Pair[Real, Real], c: Pair[Real, Real], d: Pair[Real, Real],
    m: Real, n: Real
) {
    r2_add(r2_smul(n, r2_sub(b, d)), r2_smul(m, r2_sub(c, d))) = Pair.new(Real.0, Real.0) implies
    m * r2_dot(r2_sub(a, d), r2_sub(c, d)) + n * r2_dot(r2_sub(a, d), r2_sub(b, d)) = Real.0
}

theorem stewart_expand_ab(
    a: Pair[Real, Real], b: Pair[Real, Real], d: Pair[Real, Real],
    w: Real, m: Real, c_len: Real
) {
    w * w = r2_norm_sq(r2_sub(a, d)) and
    m * m = r2_norm_sq(r2_sub(b, d)) and
    c_len * c_len = r2_norm_sq(r2_sub(b, a))
    implies
    c_len * c_len = w * w + m * m - r2_dot(r2_sub(a, d), r2_sub(b, d)) - r2_dot(r2_sub(a, d), r2_sub(b, d))
}

theorem stewart_expand_ac(
    a: Pair[Real, Real], c: Pair[Real, Real], d: Pair[Real, Real],
    w: Real, n: Real, b_len: Real
) {
    w * w = r2_norm_sq(r2_sub(a, d)) and
    n * n = r2_norm_sq(r2_sub(c, d)) and
    b_len * b_len = r2_norm_sq(r2_sub(c, a))
    implies
    b_len * b_len = w * w + n * n - r2_dot(r2_sub(a, d), r2_sub(c, d)) - r2_dot(r2_sub(a, d), r2_sub(c, d))
}

theorem real_stewart_core(w2: Real, m: Real, n: Real, tu: Real, tv: Real) {
    m * tv + n * tu = Real.0 implies
    (w2 + n * n - tv - tv) * m + (w2 + m * m - tu - tu) * n = (m + n) * (w2 + m * n)
}

theorem ts_quadratic_move_term(x: Real, y: Real, z: Real) {
    x + y + z = Real.0 implies x + z = -y
}

theorem ts_equality_sub_rhs_zero(x: Real, y: Real) {
    x = y implies x - y = Real.0
}

theorem ts_difference_factor(u: Real, c: Real, s: Real, t: Real) {
    (u * s + c * t) - (u * t + c * s) = u * (s - t) - c * (s - t)
}

theorem ts_factor_move(u: Real, c: Real, s: Real, t: Real) {
    u * s + c * t = u * t + c * s implies
    u * (s - t) = c * (s - t)
}

theorem ts_equality_to_zero_product(u: Real, c: Real, s: Real, t: Real) {
    u * (s - t) = c * (s - t) implies
    (s - t) * (u - c) = Real.0
}

theorem ts_root_product(a: Real, b: Real, c: Real, s: Real, t: Real) {
    a * s * s + b * s + c = Real.0 and
    a * t * t + b * t + c = Real.0 and
    s != t
    implies a * s * t = c
}

theorem ts_secant_product_square(w_sq: Real, s: Real, t: Real) {
    (s * s * w_sq) * (t * t * w_sq) = (w_sq * s * t) * (w_sq * s * t)
}

theorem ts_quadratic_rearrange(u: Real, a: Real, d: Real, s: Real, r: Real) {
    u + s * s * a + s * d + s * d = r implies
    a * s * s + (d + d) * s + (u - r) = Real.0
}

theorem ts_sub_through_tangent(a: Pair[Real, Real], o: Pair[Real, Real], p: Pair[Real, Real]) {
    r2_sub(p, o) = r2_add(r2_sub(p, a), r2_sub(a, o))
}

theorem ts_tangent_power(
    o: Pair[Real, Real], radius_sq: Real,
    p: Pair[Real, Real], a: Pair[Real, Real]
) {
    r2_norm_sq(r2_sub(a, o)) = radius_sq and
    r2_dot(r2_sub(p, a), r2_sub(a, o)) = Real.0
    implies r2_norm_sq(r2_sub(p, a)) = r2_norm_sq(r2_sub(p, o)) - radius_sq
}

theorem ts_secant_segment_sq(
    p: Pair[Real, Real], b: Pair[Real, Real], w: Pair[Real, Real], s: Real
) {
    r2_add(p, r2_smul(s, w)) = b
    implies r2_norm_sq(r2_sub(p, b)) = s * s * r2_norm_sq(w)
}

theorem theorems1000_tangent_secant(
    o: Pair[Real, Real], radius_sq: Real,
    p: Pair[Real, Real], a: Pair[Real, Real],
    b: Pair[Real, Real], c: Pair[Real, Real],
    w: Pair[Real, Real], s: Real, t: Real
) {
    r2_norm_sq(r2_sub(a, o)) = radius_sq and
    r2_dot(r2_sub(p, a), r2_sub(a, o)) = Real.0 and
    r2_add(p, r2_smul(s, w)) = b and
    r2_add(p, r2_smul(t, w)) = c and
    r2_norm_sq(r2_sub(b, o)) = radius_sq and
    r2_norm_sq(r2_sub(c, o)) = radius_sq and
    s != t
    implies
    r2_norm_sq(r2_sub(p, a)) * r2_norm_sq(r2_sub(p, a)) =
        r2_norm_sq(r2_sub(p, b)) * r2_norm_sq(r2_sub(p, c))
}

theorem thales_diameter_opposite(a: Pair[Real, Real], b: Pair[Real, Real], center: Pair[Real, Real]) {
    r2_add(a, b) = r2_add(center, center) implies
    r2_sub(b, center) = r2_neg(r2_sub(a, center))
}

theorem theorems1000_thales(
    center: Pair[Real, Real], radius_sq: Real,
    a: Pair[Real, Real], b: Pair[Real, Real], c: Pair[Real, Real]
) {
    r2_norm_sq(r2_sub(a, center)) = radius_sq and
    r2_norm_sq(r2_sub(b, center)) = radius_sq and
    r2_norm_sq(r2_sub(c, center)) = radius_sq and
    r2_add(a, b) = r2_add(center, center)
    implies r2_dot(r2_sub(c, a), r2_sub(c, b)) = Real.0
}

theorem theorems1000_two_square_closure(m: Real, n: Real) {
    exists(a: Real, b: Real) { m = a * a + b * b } and
    exists(c: Real, d: Real) { n = c * c + d * d }
        implies exists(x: Real, y: Real) { m * n = x * x + y * y }
}

theorem theorems1000_three_square_product(
    a: Real, b: Real, c: Real, d: Real, e: Real, f: Real
) {
    (a * a + b * b) * (c * c + d * d) * (e * e + f * f) =
        ((a * c - b * d) * e - (a * d + b * c) * f) *
            ((a * c - b * d) * e - (a * d + b * c) * f) +
        ((a * c - b * d) * f + (a * d + b * c) * e) *
            ((a * c - b * d) * f + (a * d + b * c) * e)
}

theorem van_aubel_m1m3(
    a: Pair[Real, Real], b: Pair[Real, Real], c: Pair[Real, Real], d: Pair[Real, Real],
    m1: Pair[Real, Real], m3: Pair[Real, Real]
) {
    r2_add(m1, m1) = r2_add(r2_add(a, b), r2_rot90(r2_sub(b, a))) and
    r2_add(m3, m3) = r2_add(r2_add(c, d), r2_rot90(r2_sub(d, c)))
    implies
    r2_add(r2_sub(m1, m3), r2_sub(m1, m3)) =
        r2_add(
            r2_add(r2_sub(a, c), r2_sub(b, d)),
            r2_rot90(r2_sub(r2_sub(b, d), r2_sub(a, c))))
}

theorem van_aubel_m2m4(
    a: Pair[Real, Real], b: Pair[Real, Real], c: Pair[Real, Real], d: Pair[Real, Real],
    m2: Pair[Real, Real], m4: Pair[Real, Real]
) {
    r2_add(m2, m2) = r2_add(r2_add(b, c), r2_rot90(r2_sub(c, b))) and
    r2_add(m4, m4) = r2_add(r2_add(d, a), r2_rot90(r2_sub(a, d)))
    implies
    r2_add(r2_sub(m2, m4), r2_sub(m2, m4)) =
        r2_sub(
            r2_sub(r2_sub(b, d), r2_sub(a, c)),
            r2_rot90(r2_add(r2_sub(a, c), r2_sub(b, d))))
}

theorem van_aubel_norm_rot90_sum(u: Pair[Real, Real], v: Pair[Real, Real]) {
    r2_norm_sq(r2_add(r2_add(u, v), r2_rot90(r2_sub(v, u)))) =
        r2_norm_sq(r2_add(u, v)) + r2_norm_sq(r2_sub(v, u)) +
        r2_dot(r2_add(u, v), r2_rot90(r2_sub(v, u))) +
        r2_dot(r2_add(u, v), r2_rot90(r2_sub(v, u)))
}

theorem van_aubel_norm_rot90_sub(u: Pair[Real, Real], v: Pair[Real, Real]) {
    r2_norm_sq(r2_sub(r2_sub(v, u), r2_rot90(r2_add(u, v)))) =
        r2_norm_sq(r2_sub(v, u)) + r2_norm_sq(r2_add(u, v)) -
        r2_dot(r2_sub(v, u), r2_rot90(r2_add(u, v))) -
        r2_dot(r2_sub(v, u), r2_rot90(r2_add(u, v)))
}

theorem van_aubel_add_rearrange(p: Real, q: Real, a: Real) {
    p + q + a + a = q + p + a + a
}

theorem van_aubel_neg_neg_form(p: Real, q: Real, x: Real) {
    p + q - x - x = p + q + -x + -x
}

theorem van_aubel_norm_equality(u: Pair[Real, Real], v: Pair[Real, Real]) {
    r2_norm_sq(r2_add(r2_add(u, v), r2_rot90(r2_sub(v, u)))) =
        r2_norm_sq(r2_sub(r2_sub(v, u), r2_rot90(r2_add(u, v))))
}

theorem van_aubel_norm_cancel(x: Real, y: Real) {
    (Real.1 + Real.1) * ((Real.1 + Real.1) * x) =
        (Real.1 + Real.1) * ((Real.1 + Real.1) * y)
    implies x = y
}

theorem van_aubel_dot_zero(u: Pair[Real, Real], v: Pair[Real, Real]) {
    r2_dot(
        r2_add(r2_add(u, v), r2_rot90(r2_sub(v, u))),
        r2_sub(r2_sub(v, u), r2_rot90(r2_add(u, v)))) = Real.0
}

theorem r2_dot_double_double(x: Pair[Real, Real], y: Pair[Real, Real]) {
    r2_dot(r2_add(x, x), r2_add(y, y)) =
        (Real.1 + Real.1) * ((Real.1 + Real.1) * r2_dot(x, y))
}

theorem van_aubel_dot_cancel(d: Real) {
    (Real.1 + Real.1) * ((Real.1 + Real.1) * d) = Real.0 implies d = Real.0
}

theorem theorems1000_van_aubel(
    a: Pair[Real, Real], b: Pair[Real, Real], c: Pair[Real, Real], d: Pair[Real, Real],
    m1: Pair[Real, Real], m2: Pair[Real, Real], m3: Pair[Real, Real], m4: Pair[Real, Real]
) {
    r2_add(m1, m1) = r2_add(r2_add(a, b), r2_rot90(r2_sub(b, a))) and
    r2_add(m2, m2) = r2_add(r2_add(b, c), r2_rot90(r2_sub(c, b))) and
    r2_add(m3, m3) = r2_add(r2_add(c, d), r2_rot90(r2_sub(d, c))) and
    r2_add(m4, m4) = r2_add(r2_add(d, a), r2_rot90(r2_sub(a, d)))
    implies
    r2_norm_sq(r2_sub(m1, m3)) = r2_norm_sq(r2_sub(m2, m4)) and
    r2_dot(r2_sub(m1, m3), r2_sub(m2, m4)) = Real.0
}

theorem theorems1000_varignon(
    a: Pair[Real, Real], b: Pair[Real, Real], c: Pair[Real, Real], d: Pair[Real, Real],
    m1: Pair[Real, Real], m2: Pair[Real, Real], m3: Pair[Real, Real], m4: Pair[Real, Real]
) {
    r2_add(m1, m1) = r2_add(a, b) and
    r2_add(m2, m2) = r2_add(b, c) and
    r2_add(m3, m3) = r2_add(c, d) and
    r2_add(m4, m4) = r2_add(d, a)
    implies r2_parallelogram(m1, m2, m3, m4)
