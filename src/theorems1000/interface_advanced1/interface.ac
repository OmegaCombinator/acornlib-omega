theorem r2_sub_zero_left(a: Pair[Real, Real]) {
    r2_sub(Pair.new(Real.0, Real.0), a) = r2_neg(a)
}

theorem r2_sub_sub_eq_sub_add(
    x: Pair[Real, Real], y: Pair[Real, Real], z: Pair[Real, Real]
) {
