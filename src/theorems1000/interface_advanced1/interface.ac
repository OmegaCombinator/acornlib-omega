theorem lg_pure_reassemble(a: Real, b: Real, c: Real, d: Real, e: Real, f: Real) {
    a * d * a * d + b * e * b * e + c * f * c * f +
    a * e * a * e + b * d * b * d + a * f * a * f + c * d * c * d +
    b * f * b * f + c * e * c * e =
        a * a * d * d + a * a * e * e + a * a * f * f +
        b * b * d * d + b * b * e * e + b * b * f * f +
