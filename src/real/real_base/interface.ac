theorem lt_neg_swap_neg(a: Real, b: Real) {
    a < -b implies b < -a
}

theorem neg_neg(a: Real) {
    -(-a) = a
}

theorem neg_lt_neg_swap_neg(a: Real, b: Real) {
    -a < -b implies b < a
}

theorem min_lte_left(a: Real, b: Real) {
    a.min(b) <= a
}

theorem max_gte_left(a: Real, b: Real) {
    a.max(b) >= a
}

theorem min_lte_right(a: Real, b: Real) {
    a.min(b) <= b
}

theorem max_gte_right(a: Real, b: Real) {
    a.max(b) >= b
}

theorem lt_both_imp_lt_min(a: Real, b: Real, c: Real) {
    a < b and a < c implies a < b.min(c)
}

theorem lt_min_imp_lt_left(a: Real, b: Real, c: Real) {
    a < b.min(c) implies a < b
}

theorem lt_min_imp_lt_right(a: Real, b: Real, c: Real) {
    a < b.min(c) implies a < c
}

theorem gt_both_imp_gt_max(a: Real, b: Real, c: Real) {
    a > b and a > c implies a > b.max(c)
}

theorem gt_max_imp_gt_left(a: Real, b: Real, c: Real) {
    a > b.max(c) implies a > b
}

theorem gt_max_imp_gt_right(a: Real, b: Real, c: Real) {
    a > b.max(c) implies a > c
}

theorem real_meet_lte_left(a: Real, b: Real) {
    a.meet(b) <= a
}

theorem real_meet_lte_right(a: Real, b: Real) {
    a.meet(b) <= b
}

theorem real_lte_meet_of_bounds(c: Real, a: Real, b: Real) {
    c <= a and c <= b implies c <= a.meet(b)
}

theorem real_lte_join_left(a: Real, b: Real) {
    a <= a.join(b)
}

theorem real_lte_join_right(a: Real, b: Real) {
    b <= a.join(b)
}

theorem real_join_lte_of_bounds(a: Real, b: Real, c: Real) {
    a <= c and b <= c implies a.join(b) <= c
}

theorem real_meet_join_distrib_left(a: Real, b: Real, c: Real) {
    a.meet(b.join(c)) = a.meet(b).join(a.meet(c))
}

theorem real_join_meet_distrib_left(a: Real, b: Real, c: Real) {
    a.join(b.meet(c)) = a.join(b).meet(a.join(c))
}

theorem rat_dual_upper_bound(a: Real, b: Real) {
    exists(r: Rat) {
        a < Real.from_rat(r) and b < Real.from_rat(r)
    }
}

define eventual_lb(q: Nat -> Real, lb: Real) -> Bool {
    exists(n: Nat) {
        forall(i: Nat) {
            n <= i implies lb <= q(i)
        }
    }
}

theorem eventual_lb_gte(q: Nat -> Real, lb: Real) {
    eventual_lb(q, lb) implies exists(n: Nat) {
        forall(i: Nat) {
            n <= i implies q(i) >= lb
        }
    }
}

define cauchy_gt_rat(q: Nat -> Real, r: Rat) -> Bool {
    exists(lb: Real) {
        lb > Real.from_rat(r) and eventual_lb(q, lb)
    }
}

theorem cauchy_gt_exists_lb(q: Nat -> Real, r: Rat) {
    cauchy_gt_rat(q, r) implies exists(lb: Real) {
        Real.from_rat(r) < lb and eventual_lb(q, lb)
    }
}

theorem cauchy_gt_lower_step(q: Nat -> Real, r1: Rat, r2: Rat) {
    r1 < r2 and cauchy_gt_rat(q, r2) implies cauchy_gt_rat(q, r1)
}

theorem cauchy_gt_lower_step_ordered(q: Nat -> Real, r1: Rat, r2: Rat) {
    cauchy_gt_rat(q, r2) and r1 < r2 implies cauchy_gt_rat(q, r1)
}

theorem eventual_lb_extends(q: Nat -> Real, lb1: Real, lb2: Real) {
    eventual_lb(q, lb1) and lb2 < lb1 implies eventual_lb(q, lb2)
}

define eventual_ub(q: Nat -> Real, ub: Real) -> Bool {
    exists(n: Nat) {
        forall(i: Nat) {
            n <= i implies q(i) <= ub
        }
    }
}

theorem eventual_ub_extends(q: Nat -> Real, ub1: Real, ub2: Real) {
    eventual_ub(q, ub1) and ub1 < ub2 implies eventual_ub(q, ub2)
}

define eventual_eq(q: Nat -> Real, a: Real) -> Bool {
    exists(n: Nat) {
        forall(i: Nat) {
            n <= i implies q(i) = a
        }
    }
}

theorem eventual_eq_imp_ub(q: Nat -> Real, a: Real) {
    eventual_eq(q, a) implies eventual_lb(q, a)
}

theorem eventual_eq_imp_lb(q: Nat -> Real, a: Real) {
    eventual_eq(q, a) implies eventual_ub(q, a)
}

theorem lb_ub_imp_eq(q: Nat -> Real, a: Real) {
    eventual_lb(q, a) and eventual_ub(q, a) implies eventual_eq(q, a)
}

theorem lb_lte_ub(q: Nat -> Real, lb: Real, ub: Real) {
    eventual_lb(q, lb) and eventual_ub(q, ub)
    implies
    lb <= ub
}

define lift_seq(q: Nat -> Rat) -> Nat -> Real {
    compose(Real.from_rat, q)
}

theorem lift_seq_elt(q: Nat -> Rat, n: Nat) {
    lift_seq(q)(n) = Real.from_rat(q(n))
}

define add_seq(a: Nat -> Real, b: Nat -> Real, n: Nat) -> Real {
    a(n) + b(n)
}

theorem real_lte_imp_rat_lte(p: Rat, q: Rat) {
    Real.from_rat(p) <= Real.from_rat(q) implies
    p <= q
}

theorem from_nat_is_from_rat(n: Nat) {
    from_nat[Real](n) = Real.from_rat(Rat.from_nat(n))
}

define is_nonempty_pred(s: Real -> Bool) -> Bool {
    exists(x: Real) {
        s(x)
    }
}

define flip(f: Real -> Bool, x: Real) -> Bool {
    f(-x)
}

theorem flip_flip(f: Real -> Bool) {
    flip(flip(f)) = f
}

define seq_lte(a: Nat -> Real, b: Nat -> Real) -> Bool {
    forall(n: Nat) {
        a(n) <= b(n)
    }
}

define prod_fn(a: Nat -> Real, b: Nat -> Real) -> ((Nat, Nat) -> Real) {
    function(i: Nat, j: Nat) { a(i) * b(j) }
}

theorem partial_suc(a: Nat -> Real, n: Nat) {
    partial(a, n.suc) = partial(a, n) + a(n)
}

theorem partial_seq_lte(a: Nat -> Real, b: Nat -> Real) {
    seq_lte(a, b) implies seq_lte(partial(a), partial(b))
}

define is_increasing(a: Nat -> Real) -> Bool {
    forall(n: Nat) {
        a(n) <= a(n.suc)
    }
}

theorem distant_increasing(a: Nat -> Real, m: Nat, n: Nat) {
    is_increasing(a) and m <= n implies a(m) <= a(n)
}

define is_upper_bound(a: Nat -> Real, b: Real) -> Bool {
    forall(n: Nat) {
        a(n) <= b
    }
}

define has_upper_bound_seq(a: Nat -> Real) -> Bool {
    exists(ub: Real) {
        is_upper_bound(a, ub)
    }
}

define is_least_upper_bound(a: Nat -> Real, l: Real) -> Bool {
    is_upper_bound(a, l) and forall(x: Real) {
        x < l implies not is_upper_bound(a, x)
    }
}

define is_lower_bound(a: Nat -> Real, b: Real) -> Bool {
    forall(n: Nat) {
        b <= a(n)
    }
}

define has_lower_bound_seq(a: Nat -> Real) -> Bool {
    exists(lb: Real) {
        is_lower_bound(a, lb)
    }
}

define image(a: Nat -> Real, x: Real) -> Bool {
    exists(n: Nat) {
        a(n) = x
    }
}

theorem seq_lte_ub(a: Nat -> Real, b: Nat -> Real, ub: Real) {
    seq_lte(a, b) and is_upper_bound(b, ub)
    implies is_upper_bound(a, ub)
}

theorem partial_add_seq_comm(a: Nat -> Real, b: Nat -> Real) {
    partial(add_seq(a, b)) = add_seq(partial(a), partial(b))
}

theorem partial_tail(a: Nat -> Real, m: Nat, n: Nat) {
    partial(a, m + n) = partial(a, m) + partial(tail(a, m), n)
}

let const_seq = constant[Nat, Real]

theorem const_seq_n(a: Real, n: Nat) {
    const_seq(a)(n) = a
}

theorem tail_partial(a: Nat -> Real, n: Nat) {
    tail(partial(a), n) = add_seq(partial(tail(a, n)), const_seq(partial(a, n)))
}

theorem partial_tail_rewrite(a: Nat -> Real, n: Nat) {
    partial(tail(a, n)) = add_seq(tail(partial(a), n), const_seq(-partial(a, n)))
}

define is_decreasing_seq(a: Nat -> Real) -> Bool {
    forall(n: Nat) {
        a(n.suc) <= a(n)
    }
}

theorem distant_decreasing(a: Nat -> Real, m: Nat, n: Nat) {
    is_decreasing_seq(a) and m <= n implies a(n) <= a(m)
}

theorem increasing_lower_bound_first(a: Nat -> Real) {
    is_increasing(a) implies is_lower_bound(a, a(Nat.0))
}

theorem decreasing_upper_bound_first(a: Nat -> Real) {
    is_decreasing_seq(a) implies is_upper_bound(a, a(Nat.0))
}

theorem partial_one(a: Nat -> Real) {
    partial(a, Nat.1) = a(Nat.0)
}

theorem partial_sum_split_tail(a: Nat -> Real, m: Nat, n: Nat) {
    partial(a, m + n) = partial(a, m) + partial(tail(a, m), n)
}

theorem partial_sums_seq_lte(a: Nat -> Real, b: Nat -> Real) {
    seq_lte(a, b) implies seq_lte(partial(a), partial(b))
}

define pointwise_le[T](f: T -> Real, g: T -> Real) -> Bool {
    forall(t: T) { f(t) <= g(t) }
}

theorem pointwise_le_at[T](f: T -> Real, g: T -> Real, t: T) {
    pointwise_le(f, g) implies f(t) <= g(t)
}

theorem list_map_sum_le_cons[T](head: T, tail: List[T], f: T -> Real, g: T -> Real) {
    sum[Real](map(tail, f)) <= sum[Real](map(tail, g)) and f(head) <= g(head)
        implies sum[Real](map(List.cons(head, tail), f)) <= sum[Real](map(List.cons(head, tail), g))
}

theorem list_map_sum_le[T](items: List[T], f: T -> Real, g: T -> Real) {
    pointwise_le(f, g) implies sum[Real](map(items, f)) <= sum[Real](map(items, g))
}

theorem finite_set_sum_le[T](s: FiniteSet[T], f: T -> Real, g: T -> Real) {
    pointwise_le(f, g) implies finite_set_sum(s, f) <= finite_set_sum(s, g)
}

theorem finite_set_sum_monotone_of_pointwise_le[T](s: FiniteSet[T], f: T -> Real, g: T -> Real) {
    pointwise_le(f, g) implies finite_set_sum(s, f) <= finite_set_sum(s, g)
}

theorem pointwise_le_intro[T](f: T -> Real, g: T -> Real) {
    (forall(t: T) { f(t) <= g(t) }) implies pointwise_le(f, g)
}

theorem pointwise_le_iff_forall[T](f: T -> Real, g: T -> Real) {
    pointwise_le(f, g) iff forall(t: T) { f(t) <= g(t) }
}

theorem pointwise_le_elim[T](f: T -> Real, g: T -> Real, t: T) {
    pointwise_le(f, g) implies f(t) <= g(t)
}

define prod_seq(a: Nat -> Real, b: Nat -> Real, n: Nat) -> Real {
    a(n) * b(n)
}

theorem real_strict_upper_bound_pair(a: Real, b: Real) {
    exists(c: Real) {
        a < c and b < c
    }
}

define tends_to_infinity(f: Nat -> Nat) -> Bool {
    forall(big_n: Nat) {
        exists(m: Nat) {
            forall(n: Nat) {
                m <= n implies big_n <= f(n)
            }
        }
    }
}

theorem nondecreasing_unbounded_tends_to_infinity(f: Nat -> Nat) {
    is_nondecreasing_nat(f) and is_unbounded(f)
    implies
    tends_to_infinity(f)
}

theorem monotone_unbounded_tends_to_infinity(f: Nat -> Nat) {
    is_monotone(f) and is_unbounded(f)
    implies
    tends_to_infinity(f)
}

define subsequence(a: Nat -> Real, f: Nat -> Nat, n: Nat) -> Real {
    compose(a, f)(n)
}

theorem subsequence_index_tends_to_infinity(f: Nat -> Nat) {
    is_subsequence_index(f) implies tends_to_infinity(f)
}

theorem subsequence_eq_compose(a: Nat -> Real, f: Nat -> Nat) {
    subsequence(a, f) = compose(a, f)
}

define sub_seq(s: Nat -> Real, t: Nat -> Real, n: Nat) -> Real {
    s(n) - t(n)
}

theorem prod_seq_comm(a: Nat -> Real, b: Nat -> Real) {
    prod_seq(a, b) = prod_seq(b, a)
}

define rat_increasing(f: Rat -> Real) -> Bool {
    forall(r1: Rat, r2: Rat) {
        r1 < r2 implies f(r1) < f(r2)
    }
}

define increasing(f: Real -> Real) -> Bool {
    forall(x: Real, y: Real) {
        x < y implies f(x) < f(y)
    }
}

define add_fns[T](f: T -> Real, g: T -> Real, t: T) -> Real {
    f(t) + g(t)
}

define sub_fns(f: Real -> Real, g: Real -> Real, x: Real) -> Real {
    f(x) - g(x)
}

theorem sub_fns_eq_add_fns_neg(f: Real -> Real, g: Real -> Real) {
    sub_fns(f, g) = add_fns[Real](f, pointwise_neg[Real, Real](g))
}

define pointwise_div_real(f: Real -> Real, g: Real -> Real, x: Real) -> Real {
    f(x) / g(x)
}

theorem pointwise_div_real_apply(f: Real -> Real, g: Real -> Real, x: Real) {
    pointwise_div_real(f, g, x) = f(x) / g(x)
}

define real_from_rat_fn(r: Rat) -> Real {
    Real.from_rat(r)
}

theorem real_from_rat_is_ring_hom {
    is_ring_hom(real_from_rat_fn)
}

theorem real_from_rat_is_field_hom {
    is_field_hom(real_from_rat_fn)
}

theorem real_from_rat_injective(p: Rat, q: Rat) {
    Real.from_rat(p) = Real.from_rat(q) implies p = q
}

theorem real_from_rat_eq_of_eq(p: Rat, q: Rat) {
    p = q implies Real.from_rat(p) = Real.from_rat(q)
}

theorem real_from_rat_preserves_lt(p: Rat, q: Rat) {
    p < q implies Real.from_rat(p) < Real.from_rat(q)
}

theorem real_from_rat_preserves_lte(p: Rat, q: Rat) {
    p <= q implies Real.from_rat(p) <= Real.from_rat(q)
}

theorem real_from_rat_reflects_lt(p: Rat, q: Rat) {
    Real.from_rat(p) < Real.from_rat(q) implies p < q
}

theorem real_from_rat_reflects_lte(p: Rat, q: Rat) {
    Real.from_rat(p) <= Real.from_rat(q) implies p <= q
}

define is_upper_bound_fn_2(f: (Nat, Nat) -> Real, bound: Real) -> Bool {
    forall(i: Nat, j: Nat) {
        f(i, j) <= bound
    }
}

define is_lower_bound_fn_2(f: (Nat, Nat) -> Real, bound: Real) -> Bool {
    forall(i: Nat, j: Nat) {
        f(i, j) >= bound
    }
}

define lte_fn_2(f: (Nat, Nat) -> Real, g: (Nat, Nat) -> Real) -> Bool {
    forall(i: Nat, j: Nat) {
        f(i, j) <= g(i, j)
    }
}

define const_fn_2(c: Real, i: Nat, j: Nat) -> Real {
    c
}

define row_sum(f: (Nat, Nat) -> Real, m: Nat, i: Nat) -> Real {
    partial(f(i), m)
}

define col_sum(f: (Nat, Nat) -> Real, n: Nat, j: Nat) -> Real {
    partial(flip(f, j), n)
}

define rectangular_sum(f: (Nat, Nat) -> Real, m: Nat, n: Nat) -> Real {
    partial(row_sum(f, n), m)
}

define rectangular_sum_col_first(f: (Nat, Nat) -> Real, m: Nat, n: Nat) -> Real {
    partial(col_sum(f, m), n)
}

define rectangular_sum_by_rows(f: (Nat, Nat) -> Real, n: Nat, m: Nat) -> Real {
    rectangular_sum(f, m, n)
}

define rectangular_sum_by_cols(f: (Nat, Nat) -> Real, m: Nat, n: Nat) -> Real {
    rectangular_sum(f, m, n)
}

theorem rectangular_fubini(f: (Nat, Nat) -> Real, m: Nat, n: Nat) {
    rectangular_sum(f, m, n) = rectangular_sum_col_first(f, m, n)
}

theorem rectangular_sum_monotone(f: (Nat, Nat) -> Real, g: (Nat, Nat) -> Real, m: Nat, n: Nat) {
    lte_fn_2(f, g)
    implies
    rectangular_sum(f, m, n) <= rectangular_sum(g, m, n)
}

define product_sum(a: Nat -> Real, b: Nat -> Real, m: Nat, n: Nat) -> Real {
    rectangular_sum(prod_fn(a, b), m, n)
}

theorem rectangular_sum_le_of_lte_fn(f: (Nat, Nat) -> Real, g: (Nat, Nat) -> Real, m: Nat, n: Nat) {
    lte_fn_2(f, g) implies rectangular_sum(f, m, n) <= rectangular_sum(g, m, n)
}

define pointwise_product(a: Nat -> Real, b: Nat -> Real, i: Nat) -> Real {
    a(i) * b(i)
}

define pointwise_square(a: Nat -> Real, i: Nat) -> Real {
    a(i) * a(i)
}

define finite_dot(a: Nat -> Real, b: Nat -> Real, n: Nat) -> Real {
    partial(pointwise_product(a, b), n)
}

define finite_square_sum(a: Nat -> Real, n: Nat) -> Real {
    partial(pointwise_square(a), n)
}

theorem finite_dot_symm(a: Nat -> Real, b: Nat -> Real, n: Nat) {
    finite_dot(a, b, n) = finite_dot(b, a, n)
}

theorem finite_dot_suc(a: Nat -> Real, b: Nat -> Real, n: Nat) {
    finite_dot(a, b, n.suc) = finite_dot(a, b, n) + a(n) * b(n)
}

theorem finite_square_sum_suc(a: Nat -> Real, n: Nat) {
    finite_square_sum(a, n.suc) = finite_square_sum(a, n) + a(n) * a(n)
}

theorem row_sum_pointwise_eq(
    f: (Nat, Nat) -> Real, g: (Nat, Nat) -> Real, i: Nat, n: Nat
) {
    (forall(j: Nat) {
        j < n implies f(i, j) = g(i, j)
    }) implies row_sum(f, n, i) = row_sum(g, n, i)
}

theorem rectangular_sum_row_eq(
    f: (Nat, Nat) -> Real, g: (Nat, Nat) -> Real, m: Nat, n: Nat
) {
    (forall(i: Nat) {
        i < m implies row_sum(f, n, i) = row_sum(g, n, i)
    }) implies rectangular_sum(f, m, n) = rectangular_sum(g, m, n)
}

theorem rectangular_sum_pointwise_eq(
    f: (Nat, Nat) -> Real, g: (Nat, Nat) -> Real, m: Nat, n: Nat
) {
    (forall(i: Nat, j: Nat) {
        i < m and j < n implies f(i, j) = g(i, j)
    }) implies rectangular_sum(f, m, n) = rectangular_sum(g, m, n)
}

define doubly_increasing(f: (Nat, Nat) -> Real) -> Bool {
    forall(i: Nat, j: Nat) {
        f(i, j) <= f(i, j.suc) and f(i, j) <= f(i.suc, j)
    }
}

theorem doubly_increasing_right(f: (Nat, Nat) -> Real, i: Nat) {
    doubly_increasing(f) implies is_increasing(function(j: Nat) { f(i, j) })
}

theorem doubly_increasing_left(f: (Nat, Nat) -> Real, j: Nat) {
    doubly_increasing(f) implies is_increasing(function(i: Nat) { f(i, j) })
}

theorem doubly_increasing_flip(f: (Nat, Nat) -> Real, j: Nat) {
    doubly_increasing(f) implies is_increasing(function(i: Nat) { flip(f, j, i) })
}

theorem doubly_increasing_first_mono(f: (Nat, Nat) -> Real, i1: Nat, i2: Nat, j: Nat) {
    doubly_increasing(f) and i1 <= i2 implies f(i1, j) <= f(i2, j)
}

theorem doubly_increasing_second_mono(f: (Nat, Nat) -> Real, i: Nat, j1: Nat, j2: Nat) {
    doubly_increasing(f) and j1 <= j2 implies f(i, j1) <= f(i, j2)
}

theorem doubly_increasing_monotone(f: (Nat, Nat) -> Real, i1: Nat, i2: Nat, j1: Nat, j2: Nat) {
    doubly_increasing(f) and i1 <= i2 and j1 <= j2 implies f(i1, j1) <= f(i2, j2)
}

define double_image(f: (Nat, Nat) -> Real, x: Real) -> Bool {
    exists(i: Nat, j: Nat) {
        f(i, j) = x
    }
}

define double_is_upper_bound(f: (Nat, Nat) -> Real, b: Real) -> Bool {
    forall(i: Nat, j: Nat) {
        f(i, j) <= b
    }
}

theorem double_is_upper_bound_from_forall(f: (Nat, Nat) -> Real, b: Real) {
    (forall(i: Nat, j: Nat) {
        f(i, j) <= b
    })
    implies
    double_is_upper_bound(f, b)
}

define double_image_is_supremum(f: (Nat, Nat) -> Real, s: Real) -> Bool {
    double_is_upper_bound(f, s) and
    forall(b: Real) {
        b < s implies not double_is_upper_bound(f, b)
    }
}

theorem double_image_is_supremum_from_parts(f: (Nat, Nat) -> Real, s: Real) {
    double_is_upper_bound(f, s) and
    forall(b: Real) {
        b < s implies not double_is_upper_bound(f, b)
    }
    implies
    double_image_is_supremum(f, s)
}

theorem supremum_lte_upper_bound(f: (Nat, Nat) -> Real, s: Real, b: Real) {
    double_image_is_supremum(f, s) and double_is_upper_bound(f, b)
    implies
    s <= b
}

define seq_in_real_set(s: Set[Real], a: Nat -> Real) -> Bool {
    forall(n: Nat) {
        s.contains(a(n))
    }
}

define seq_eventually_in_real_set(s: Set[Real], a: Nat -> Real) -> Bool {
    exists(n0: Nat) {
        forall(n: Nat) {
            n0 <= n implies s.contains(a(n))
        }
    }
}

define seq_frequently_in_real_set(s: Set[Real], a: Nat -> Real) -> Bool {
    forall(n_start: Nat) {
        exists(n_witness: Nat) {
            n_start <= n_witness and s.contains(a(n_witness))
        }
    }
}

theorem seq_frequently_in_real_set_at(s: Set[Real], a: Nat -> Real, n_start: Nat) {
    seq_frequently_in_real_set(s, a) implies exists(n_witness: Nat) {
        n_start <= n_witness and s.contains(a(n_witness))
    }
}

theorem seq_in_real_set_at(s: Set[Real], a: Nat -> Real, n: Nat) {
    seq_in_real_set(s, a) implies s.contains(a(n))
}

theorem seq_in_real_set_intro(s: Set[Real], a: Nat -> Real) {
    forall(n: Nat) { s.contains(a(n)) } implies seq_in_real_set(s, a)
}

theorem seq_in_real_set_of_subset(s: Set[Real], t: Set[Real], a: Nat -> Real) {
    s.subset(t) and seq_in_real_set(s, a) implies seq_in_real_set(t, a)
}

theorem seq_in_real_set_intersection(s: Set[Real], t: Set[Real], a: Nat -> Real) {
    seq_in_real_set(s, a) and seq_in_real_set(t, a) implies seq_in_real_set(s.intersection(t), a)
