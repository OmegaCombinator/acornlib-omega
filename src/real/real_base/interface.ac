theorem seq_eventually_in_real_set_intersection(s: Set[Real], t: Set[Real], a: Nat -> Real) {
    seq_eventually_in_real_set(s, a) and seq_eventually_in_real_set(t, a)
    implies seq_eventually_in_real_set(s.intersection(t), a)
