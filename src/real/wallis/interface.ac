theorem uniform_variance_unit {
    uniform_variance(identity_fn[Real]) = (Real.1 / (Real.1 + Real.1 + Real.1)) * (Real.one_half * Real.one_half)
}

define uniform_cdf_unit(x: Real) -> Real {
