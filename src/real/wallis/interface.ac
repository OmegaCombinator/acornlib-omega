}

theorem ps_radius_exists_of_divergence(a: Nat -> Real, x1: Real) {
    not absolutely_converges(power_series_term(a, x1))
    implies exists(rho: Real) { is_ps_radius(a, rho) }
}

theorem ps_term_eq_power_series_term(a: Nat -> Real, x: Real, n: Nat) {
    ps_term(a, x, n) = power_series_term(a, x, n)
}

theorem exp_series_abs_conv_everywhere(r: Real) {
    absolutely_converges(power_series_term(exp_coeff, r))
}

theorem exp_radii_contains_every_nonneg(r: Real) {
    Real.0 <= r implies ps_conv_radii_set(exp_coeff).contains(r)
}

theorem exp_radii_set_unbounded {
    forall(m: Real) {
        exists(r: Real) {
            ps_conv_radii_set(exp_coeff).contains(r) and m < r
        }
    }
}

theorem exp_series_radius_infinite {
    not exists(rho: Real) { is_ps_radius(exp_coeff, rho) }
}

define abel_seq(a: Nat -> Real, x: Real, n: Nat) -> Real {
    partial(a, n.suc) * x.pow(n)
}

define abel_center_seq(a: Nat -> Real, s: Real, x: Real, n: Nat) -> Real {
    (partial(a, n.suc) - s) * x.pow(n)
}

define abel_diff_abs(a: Nat -> Real, s: Real, n: Nat) -> Real {
    (partial(a, n.suc) - s).abs
}

theorem pow_le_one(x: Real, n: Nat) {
    Real.0 <= x and x <= Real.1 implies x.pow(n) <= Real.1
}

theorem converges_to_intro(q: Nat -> Real, a: Real) {
    (forall(eps: Real) { eps.is_positive implies exists(n: Nat) { tail_bound(q, a, n, eps) } })
    implies converges_to(q, a)
}

theorem abs_add_le(a: Real, b: Real) {
    (a + b).abs <= a.abs + b.abs
}

theorem geom_partial_sum_eq(r: Real, n: Nat) {
    partial(r.pow, n) * (Real.1 - r) = Real.1 - r.pow(n)
}

theorem abel_seq_split(a: Nat -> Real, s: Real, x: Real, n: Nat) {
    abel_seq(a, x, n) = abel_center_seq(a, s, x, n) + s * x.pow(n)
}

theorem abel_finite_identity(a: Nat -> Real, x: Real, n: Nat) {
    partial(power_series_term(a, x), n) =
        (Real.1 - x) * partial(abel_seq(a, x), n) + partial(a, n) * x.pow(n)
}

theorem abel_center_abs_conv(a: Nat -> Real, s: Real, x: Real) {
    converges_to(partial(a), s) and Real.0 <= x and x < Real.1
    implies absolutely_converges(abel_center_seq(a, s, x))
}

theorem abel_seq_partial_split(a: Nat -> Real, s: Real, x: Real, n: Nat) {
    partial(abel_seq(a, x), n) =
        partial(abel_center_seq(a, s, x), n) + s * partial(x.pow, n)
}

theorem abel_ps_conv(a: Nat -> Real, x: Real) {
    converges(partial(a)) and Real.0 <= x and x < Real.1
    implies converges(partial(power_series_term(a, x)))
}

theorem ps_sum_eq_power_series_limit(a: Nat -> Real, x: Real) {
    converges(partial(power_series_term(a, x)))
    implies ps_sum(a, x) = limit(partial(power_series_term(a, x)))
}

theorem abel_center_converges(a: Nat -> Real, s: Real, x: Real) {
    converges_to(partial(a), s) and Real.0 <= x and x < Real.1
    implies converges(partial(abel_center_seq(a, s, x)))
}

theorem abel_seq_converges(a: Nat -> Real, s: Real, x: Real) {
    converges_to(partial(a), s) and Real.0 <= x and x < Real.1
    implies converges(partial(abel_seq(a, x)))
}

theorem abel_limit_center_identity(a: Nat -> Real, s: Real, x: Real) {
    converges_to(partial(a), s) and Real.0 <= x and x < Real.1
    implies ps_sum(a, x) - s =
        (Real.1 - x) * limit(partial(abel_center_seq(a, s, x)))
}

theorem abel_center_term_abs_le_diff(a: Nat -> Real, s: Real, x: Real, k: Nat) {
    Real.0 <= x and x <= Real.1
    implies abs_fn(abel_center_seq(a, s, x))(k) <= abel_diff_abs(a, s, k)
}

theorem abel_tail_limit_bound(a: Nat -> Real, s: Real, x: Real, n0: Nat, eps: Real) {
    converges_to(partial(a), s) and Real.0 <= x and x < Real.1
    and (forall(k: Nat) { n0 <= k implies abel_diff_abs(a, s, k) < eps })
    implies limit(partial(tail(abel_center_seq(a, s, x), n0))).abs <= eps * x.pow(n0) / (Real.1 - x)
}

theorem abel_estimate(a: Nat -> Real, s: Real, x: Real, n0: Nat, eps: Real) {
    converges_to(partial(a), s) and Real.0 <= x and x < Real.1
    and (forall(k: Nat) { n0 <= k implies abel_diff_abs(a, s, k) < eps })
    implies (ps_sum(a, x) - s).abs <= (Real.1 - x) * partial(abel_diff_abs(a, s), n0) + eps * x.pow(n0)
}

theorem half_plus_half(eps: Real) {
    eps / two + eps / two = eps
}

theorem abel_theorem_at(a: Nat -> Real, s: Real, q: Nat -> Real) {
    converges_to(partial(a), s)
    and (forall(n: Nat) { Real.0 <= q(n) and q(n) < Real.1 })
    and converges_to(q, Real.1)
    implies converges_to(compose(ps_sum(a), q), s)
}

theorem abel_theorem(a: Nat -> Real, q: Nat -> Real) {
    converges(partial(a))
    and (forall(n: Nat) { Real.0 <= q(n) and q(n) < Real.1 })
    and converges_to(q, Real.1)
    implies converges_to(compose(ps_sum(a), q), limit(partial(a)))
}

theorem geometric_series_converges(r: Real) {
    r.abs < Real.1 implies converges(partial(r.pow))
}

theorem geometric_series_sum(r: Real) {
    r.abs < Real.1 implies limit(partial(r.pow)) = Real.1 / (Real.1 - r)
}

theorem p_series_two_converges {
    converges(partial(zeta2_term))
}

theorem p_series_two_partials_le_two(n: Nat) {
    partial(zeta2_term, n) <= Real.1 + Real.1
}

theorem ratio_test_series_abs_converges(a: Nat -> Real, l: Real) {
    converges_to(ratio_seq(a), l) and l < Real.1 and always_nonzero(a)
    implies absolutely_converges(a)
}

theorem ratio_test_series_converges(a: Nat -> Real, l: Real) {
    converges_to(ratio_seq(a), l) and l < Real.1 and always_nonzero(a)
    implies converges(partial(a))
}

theorem alternating_series_test_series_converges(a: Nat -> Real) {
    is_decreasing_seq(a) and vanishes(a) implies converges(partial(alt_term(a)))
}

theorem real_add_two_lower(a: Real, b: Real, u: Real, v: Real) {
    a >= u and b >= v implies a + b >= u + v
}

theorem from_nat_suc_mul_recip_step(x: Nat, d: Nat) {
    from_nat[Real](x.suc) * (Real.1 / from_nat[Real](d)) = from_nat[Real](x) * (Real.1 / from_nat[Real](d)) + (Real.1 / from_nat[Real](d))
}

theorem partial_real_lower_step_generic(f: Nat -> Real, x: Nat, d: Nat) {
    partial(f, x) >= from_nat[Real](x) * (Real.1 / from_nat[Real](d)) and
    f(x) >= Real.1 / from_nat[Real](d) implies
    partial(f, x.suc) >= from_nat[Real](x.suc) * (Real.1 / from_nat[Real](d))
}

theorem lte_suc_imp_lt(a: Nat, b: Nat) {
    a.suc <= b implies a < b
}

theorem harmonic_block_partial_lower_step(n: Nat, x: Nat) {
    n > Nat.0 and x.suc <= n and
    partial(function(k: Nat) { harmonic(n + k) }, x) >= from_nat[Real](x) * (Real.1 / from_nat[Real](n + n)) implies
    partial(function(k: Nat) { harmonic(n + k) }, x.suc) >= from_nat[Real](x.suc) * (Real.1 / from_nat[Real](n + n))
}

theorem harmonic_block_partial_lower(n: Nat, m: Nat) {
    n > Nat.0 and m <= n implies
    partial(function(k: Nat) { harmonic(n + k) }, m) >= from_nat[Real](m) * (Real.1 / from_nat[Real](n + n))
}

theorem two_mul_one_half_real {
    (Real.1 + Real.1) * Real.one_half = Real.1
}

theorem half_is_inverse_two {
    Real.one_half = (Real.1 + Real.1).inverse
}

theorem real_one_div_two_eq_half {
    Real.1 / (Real.1 + Real.1) = Real.one_half
}

theorem real_half_ratio_nonzero(a: Real) {
    a != Real.0 implies a * (Real.1 / ((Real.1 + Real.1) * a)) = Real.one_half
}

theorem from_nat_suc_half_ratio(k: Nat) {
    from_nat[Real](k.suc) * (Real.1 / from_nat[Real](k.suc + k.suc)) = Real.one_half
}

theorem nat_pos_ne_zero_atomic(n: Nat) {
    n > Nat.0 implies n != Nat.0
}

theorem from_nat_half_ratio_ne_zero(n: Nat) {
    n != Nat.0 implies from_nat[Real](n) * (Real.1 / from_nat[Real](n + n)) = Real.one_half
}

theorem from_nat_half_ratio(n: Nat) {
    n > Nat.0 implies from_nat[Real](n) * (Real.1 / from_nat[Real](n + n)) = Real.one_half
}

theorem harmonic_block_lower(n: Nat) {
    n > Nat.0 implies partial(function(k: Nat) { harmonic(n + k) }, n) >= Real.one_half
}

theorem partial_add_shift_real(f: Nat -> Real, n: Nat, m: Nat) {
    partial(f, n + m) = partial(f, n) + partial(function(k: Nat) { f(n + k) }, m)
}

theorem harmonic_tail_half_jump(k: Nat) {
    k > Nat.0 implies partial(harmonic, k + k) >= partial(harmonic, k) + Real.one_half
}

theorem real_one_half_is_positive {
    Real.one_half.is_positive
}

theorem converges_has_half_cauchy_bound(q: Nat -> Real) {
    converges(q) implies exists(n: Nat) { cauchy_bound(q, n, Real.one_half) }
}

theorem not_close_if_ge_half(a: Real, b: Real) {
    b >= a + Real.one_half implies not b.is_close(a, Real.one_half)
}

theorem harmonic_series_diverges {
    not converges(partial(harmonic))
}
