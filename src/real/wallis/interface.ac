theorem wallis_field_step(e: Real, o: Real, s: Real, a: Real, b: Real, c: Real) {
    o != Real.0 and s != Real.0 and b != Real.0 and c != Real.0 implies
    (e * a).pow(Nat.2) / ((o * b) * (s * c)) =
    (e.pow(Nat.2) / (o * s)) * (a / b) * (a / c)
}

