theorem scalar_mul_close(c: Real, a: Real, b: Real, eps2: Real, eps: Real) {
    eps.is_positive and a.is_close(b, eps2) and c.abs * eps2 < eps
    implies (c * a).is_close(c * b, eps)
}

theorem mul_div_left(c: Real, a: Real, b: Real) {
