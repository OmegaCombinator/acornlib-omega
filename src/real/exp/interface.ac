theorem injective_on_pointwise_neg(f: Real -> Real, a: Real, b: Real) {
    injective_on(f, a, b) implies injective_on(pointwise_neg(f), a, b)
}

theorem increasing_on_values_imp_args_lt(f: Real -> Real, a: Real, b: Real, x: Real, y: Real) {
    increasing_on(f, a, b) and
    closed_interval_set(a, b).contains(x) and closed_interval_set(a, b).contains(y) and
    f(x) < f(y)
    implies x < y
}

theorem closed_interval_set_contains_of_bounds(a: Real, b: Real, x: Real) {
    a <= x and x <= b implies closed_interval_set(a, b).contains(x)
}

define disconnecting_triple(s: Set[Real], x: Real, y: Real, z: Real) -> Bool {
    s.contains(x) and s.contains(y) and x < y and x <= z and z <= y and not s.contains(z)
}

define is_connected_real_set(s: Set[Real]) -> Bool {
    forall(x: Real, y: Real, z: Real) {
        not disconnecting_triple(s, x, y, z)
    }
}

theorem disconnecting_triple_contains_left(s: Set[Real], x: Real, y: Real, z: Real) {
    disconnecting_triple(s, x, y, z) implies s.contains(x)
}

theorem disconnecting_triple_not_contains_middle(s: Set[Real], x: Real, y: Real, z: Real) {
    disconnecting_triple(s, x, y, z) implies not s.contains(z)
}

theorem empty_set_is_connected {
    is_connected_real_set(Set[Real].empty_set)
}

theorem universal_set_is_connected {
    is_connected_real_set(Set[Real].universal_set)
}

theorem connected_real_set_contains_between(s: Set[Real], x: Real, y: Real, z: Real) {
    is_connected_real_set(s) and s.contains(x) and s.contains(y) and x < y and x <= z and z <= y
    implies s.contains(z)
}

theorem connected_intersection_between_left(s: Set[Real], t: Set[Real], x: Real, y: Real, z: Real) {
    is_connected_real_set(s) and s.intersection(t).contains(x) and s.intersection(t).contains(y) and
    x < y and x <= z and z <= y implies s.contains(z)
}

theorem connected_intersection_between_right(s: Set[Real], t: Set[Real], x: Real, y: Real, z: Real) {
    is_connected_real_set(t) and s.intersection(t).contains(x) and s.intersection(t).contains(y) and
    x < y and x <= z and z <= y implies t.contains(z)
}

theorem intersection_of_connected_real_sets_is_connected(s: Set[Real], t: Set[Real]) {
    is_connected_real_set(s) and is_connected_real_set(t) implies is_connected_real_set(s.intersection(t))
}

theorem singleton_real_set_is_connected(a: Real) {
    is_connected_real_set(Set[Real].singleton(a))
}

theorem connected_real_set_of_eq(s: Set[Real], t: Set[Real]) {
    s = t and is_connected_real_set(s) implies is_connected_real_set(t)
}

theorem connected_real_set_of_eq_rev(s: Set[Real], t: Set[Real]) {
    s = t and is_connected_real_set(t) implies is_connected_real_set(s)
}

define is_order_convex_real_set(s: Set[Real]) -> Bool {
    forall(x: Real, y: Real, z: Real) {
        s.contains(x) and s.contains(y) and x <= z and z <= y implies s.contains(z)
    }
}

theorem order_convex_real_set_contains_between(s: Set[Real], x: Real, y: Real, z: Real) {
    is_order_convex_real_set(s) and s.contains(x) and s.contains(y) and x <= z and z <= y
    implies s.contains(z)
}

theorem connected_real_set_contains_between_le(s: Set[Real], x: Real, y: Real, z: Real) {
    is_connected_real_set(s) and s.contains(x) and s.contains(y) and x <= z and z <= y
    implies s.contains(z)
}

theorem order_convex_real_set_is_connected(s: Set[Real]) {
    is_order_convex_real_set(s) implies is_connected_real_set(s)
}

theorem connected_real_set_contains_closed_interval_between(s: Set[Real], x: Real, y: Real) {
    is_connected_real_set(s) and s.contains(x) and s.contains(y) and x <= y
    implies closed_interval_set(x, y).subset(s)
}

theorem connected_real_set_contains_open_interval_between(s: Set[Real], x: Real, y: Real) {
    is_connected_real_set(s) and s.contains(x) and s.contains(y) and x <= y
    implies open_interval_set(x, y).subset(s)
}

theorem connected_real_set_contains_left_open_interval_between(s: Set[Real], x: Real, y: Real) {
    is_connected_real_set(s) and s.contains(x) and s.contains(y) and x <= y
    implies left_open_interval_set(x, y).subset(s)
}

theorem connected_real_set_contains_right_open_interval_between(s: Set[Real], x: Real, y: Real) {
    is_connected_real_set(s) and s.contains(x) and s.contains(y) and x <= y
    implies right_open_interval_set(x, y).subset(s)
}

define is_bounded_interval_real_set(s: Set[Real]) -> Bool {
    exists(a: Real, b: Real) {
        s = closed_interval_set(a, b) or
        s = open_interval_set(a, b) or
        s = left_open_interval_set(a, b) or
        s = right_open_interval_set(a, b)
    }
}

theorem set_not_lower_bound_witness(s: Set[Real], bound: Real) {
    not is_set_lower_bound(s, bound) implies exists(x: Real) {
        s.contains(x) and not bound <= x
    }
}

theorem order_convex_between_inf_sup(
    s: Set[Real], l: Real, u: Real, x: Real
) {
    is_order_convex_real_set(s) and is_set_infimum(s, l) and is_set_supremum(s, u) and
    l < x and x < u
    implies s.contains(x)
}

theorem order_convex_subset_closed_interval_inf_sup(
    s: Set[Real], l: Real, u: Real, x: Real
) {
    is_set_infimum(s, l) and is_set_supremum(s, u) and s.contains(x)
    implies closed_interval_set(l, u).contains(x)
}

theorem order_convex_bounded_real_set_is_interval(s: Set[Real], l: Real, u: Real) {
    is_order_convex_real_set(s) and is_set_infimum(s, l) and is_set_supremum(s, u)
    implies is_bounded_interval_real_set(s)
}

theorem singleton_difference_subset_of_subset(s: Set[Real], t: Set[Real], x: Real) {
    s.subset(t) implies s.difference(Set[Real].singleton(x)).subset(t.difference(Set[Real].singleton(x)))
}

theorem union_singleton_difference_member_cases(s: Set[Real], t: Set[Real], x: Real, y: Real) {
    s.union(t).difference(Set[Real].singleton(x)).contains(y) implies
        s.difference(Set[Real].singleton(x)).contains(y) or
        t.difference(Set[Real].singleton(x)).contains(y)
}

theorem complement_union_eq_intersection_complements(s: Set[Real], t: Set[Real]) {
    s.union(t).c = s.c.intersection(t.c)
}

theorem real_set_difference_eq_intersection_complement(s: Set[Real], t: Set[Real]) {
    s.difference(t) = s.intersection(t.c)
}

theorem real_difference_eq_intersection_complement(s: Set[Real], t: Set[Real]) {
    s.difference(t) = s.intersection(t.c)
}

theorem clopen_real_sets_difference_union_contains_eq(s: Set[Real], t: Set[Real], x: Real) {
    s.difference(t).union(t.difference(s)).contains(x) =
        ((s.contains(x) and not t.contains(x)) or (t.contains(x) and not s.contains(x)))
}

theorem clopen_real_sets_symmetric_difference_comm(s: Set[Real], t: Set[Real]) {
    s.difference(t).union(t.difference(s)) = t.difference(s).union(s.difference(t))
}

define open_upper_ray_contains(lower: Real, x: Real) -> Bool {
    lower < x
}

define open_lower_ray_contains(upper: Real, x: Real) -> Bool {
    x < upper
}

define closed_upper_ray_contains(lower: Real, x: Real) -> Bool {
    lower <= x
}

define closed_lower_ray_contains(upper: Real, x: Real) -> Bool {
    x <= upper
}

define open_upper_ray(lower: Real) -> Set[Real] {
    Set[Real].new(open_upper_ray_contains(lower))
}

define open_lower_ray(upper: Real) -> Set[Real] {
    Set[Real].new(open_lower_ray_contains(upper))
}

define closed_upper_ray(lower: Real) -> Set[Real] {
    Set[Real].new(closed_upper_ray_contains(lower))
}

define closed_lower_ray(upper: Real) -> Set[Real] {
    Set[Real].new(closed_lower_ray_contains(upper))
}

theorem open_upper_ray_contains_eq(lower: Real, x: Real) {
    open_upper_ray(lower).contains(x) = (lower < x)
}

theorem open_lower_ray_contains_eq(upper: Real, x: Real) {
    open_lower_ray(upper).contains(x) = (x < upper)
}

theorem closed_upper_ray_contains_eq(lower: Real, x: Real) {
    closed_upper_ray(lower).contains(x) = (lower <= x)
}

theorem closed_lower_ray_contains_eq(upper: Real, x: Real) {
    closed_lower_ray(upper).contains(x) = (x <= upper)
}

theorem closed_upper_ray_eq_complement_open_lower_ray(lower: Real) {
    closed_upper_ray(lower) = open_lower_ray(lower).c
}

theorem closed_lower_ray_eq_complement_open_upper_ray(upper: Real) {
    closed_lower_ray(upper) = open_upper_ray(upper).c
}

theorem eventual_lb_iff_seq_eventually_in_closed_upper_ray(a: Nat -> Real, lb: Real) {
    eventual_lb(a, lb) = seq_eventually_in_real_set(closed_upper_ray(lb), a)
}

theorem eventual_ub_iff_seq_eventually_in_closed_lower_ray(a: Nat -> Real, ub: Real) {
    eventual_ub(a, ub) = seq_eventually_in_real_set(closed_lower_ray(ub), a)
}

theorem eventual_lb_compose_tends_to_infinity(a: Nat -> Real, f: Nat -> Nat, lb: Real) {
    eventual_lb(a, lb) and tends_to_infinity(f) implies eventual_lb(compose(a, f), lb)
}

theorem eventual_ub_compose_tends_to_infinity(a: Nat -> Real, f: Nat -> Nat, ub: Real) {
    eventual_ub(a, ub) and tends_to_infinity(f) implies eventual_ub(compose(a, f), ub)
}

theorem eventual_lb_subsequence(a: Nat -> Real, f: Nat -> Nat, lb: Real) {
    eventual_lb(a, lb) and is_subsequence_index(f) implies eventual_lb(subsequence(a, f), lb)
}

theorem eventual_ub_subsequence(a: Nat -> Real, f: Nat -> Nat, ub: Real) {
    eventual_ub(a, ub) and is_subsequence_index(f) implies eventual_ub(subsequence(a, f), ub)
}

theorem seq_in_real_set_converges_to_external_point_imp_frequently_punctured(
    s: Set[Real], a: Nat -> Real, x: Real
) {
    seq_in_real_set(s, a) and not s.contains(x)
    implies seq_frequently_in_real_set(s.difference(Set[Real].singleton(x)), a)
}

theorem open_interval_set_eq_open_ray_intersection(lower: Real, upper: Real) {
    open_interval_set(lower, upper) = open_upper_ray(lower).intersection(open_lower_ray(upper))
}

theorem closed_interval_set_eq_closed_ray_intersection(lower: Real, upper: Real) {
    closed_interval_set(lower, upper) = closed_upper_ray(lower).intersection(closed_lower_ray(upper))
}

theorem left_open_interval_set_eq_ray_intersection(lower: Real, upper: Real) {
    left_open_interval_set(lower, upper) = open_upper_ray(lower).intersection(closed_lower_ray(upper))
}

theorem right_open_interval_set_eq_ray_intersection(lower: Real, upper: Real) {
    right_open_interval_set(lower, upper) = closed_upper_ray(lower).intersection(open_lower_ray(upper))
}

theorem open_upper_ray_is_connected(lower: Real) {
    is_connected_real_set(open_upper_ray(lower))
}

theorem open_lower_ray_is_connected(upper: Real) {
    is_connected_real_set(open_lower_ray(upper))
}

theorem closed_upper_ray_is_connected(lower: Real) {
    is_connected_real_set(closed_upper_ray(lower))
}

theorem closed_lower_ray_is_connected(upper: Real) {
    is_connected_real_set(closed_lower_ray(upper))
}

theorem open_interval_set_is_connected(lower: Real, upper: Real) {
    is_connected_real_set(open_interval_set(lower, upper))
}

theorem closed_interval_set_is_connected(lower: Real, upper: Real) {
    is_connected_real_set(closed_interval_set(lower, upper))
}

theorem left_open_interval_set_is_connected(lower: Real, upper: Real) {
    is_connected_real_set(left_open_interval_set(lower, upper))
}

theorem right_open_interval_set_is_connected(lower: Real, upper: Real) {
    is_connected_real_set(right_open_interval_set(lower, upper))
}

theorem function_extensionality_on_range(f: Nat -> Real, g: Nat -> Real, n: Nat) {
    (forall(k: Nat) { k < n implies f(k) = g(k) })
    implies
    partial(f, n) = partial(g, n)
}

theorem from_nat_2_lt_3 {
    from_nat[Real](Nat.2) < from_nat[Real](Nat.3)
}

define seq_mul(a: Nat -> Real, b: Nat -> Real, n: Nat) -> Real {
    a(n) * b(n)
}

define geom_square_coeff_seq(n: Nat) -> Real {
    from_nat[Real](n.suc)
}

define binom_series_coeff(k: Nat, n: Nat) -> Real {
    from_nat[Real]((n + k).binom(k))
}

define binom_row_coeff(m: Nat, n: Nat) -> Real {
    from_nat[Real](m.binom(n))
}

theorem from_nat_partial(f: Nat -> Nat, n: Nat) {
    from_nat[Real](partial(f, n)) = partial(compose(from_nat[Real], f), n)
}

theorem binom_series_sums(k: Nat, m: Nat) {
    partial(binom_series_coeff(k), m.suc) = binom_series_coeff(k.suc, m)
}

theorem touch_real_from_nat_instance(k: Nat) {
    from_nat[Real](k) = Real.from_rat(Rat.from_nat(k))
}

theorem from_nat_real_suc_lte_of_nat_lte(m: Nat, n: Nat) {
    m <= n implies from_nat[Real](m.suc) <= from_nat[Real](n.suc)
}

theorem factorial_real_lte_suc(n: Nat) {
    Real.from_rat(Rat.from_nat(n.factorial)) <= Real.from_rat(Rat.from_nat(n.suc.factorial))
}

theorem partial_le_range(f: Nat -> Real, g: Nat -> Real, n: Nat) {
    (forall(i: Nat) { i < n implies f(i) <= g(i) }) implies partial(f, n) <= partial(g, n)
}

define const_real_fn(c: Real) -> (Nat -> Real) {
    function(i: Nat) { c }
}

define neg_fn(f: Nat -> Real) -> (Nat -> Real) {
    function(i: Nat) { -f(i) }
}

theorem partial_neg(f: Nat -> Real, n: Nat) {
    partial(neg_fn(f), n) = -partial(f, n)
}

define seq_tends_to_infinity(a: Nat -> Real) -> Bool {
    forall(b: Real) {
        exists(n0: Nat) {
            forall(n: Nat) {
                n0 <= n implies b < a(n)
            }
        }
    }
}

define seq_tends_to_neg_infinity(a: Nat -> Real) -> Bool {
    forall(b: Real) {
        exists(n0: Nat) {
            forall(n: Nat) {
                n0 <= n implies a(n) < b
            }
        }
    }
}

theorem from_nat_seq_tends_to_infinity {
    seq_tends_to_infinity(from_nat[Real])
}

define bounded_above_on_prefix(f: Real -> Real, lower: Real, x: Real) -> Bool {
    exists(bound: Real) {
        forall(y: Real) {
            closed_interval_set(lower, x).contains(y) implies f(y) <= bound
        }
    }
}

define bounded_prefix_contains(f: Real -> Real, a: Real, b: Real, x: Real) -> Bool {
    a <= x and x <= b and bounded_above_on_prefix(f, a, x)
}

define bounded_prefix_set(f: Real -> Real, a: Real, b: Real) -> Set[Real] {
    Set[Real].new(bounded_prefix_contains(f, a, b))
}

theorem bounded_prefix_set_contains_eq(f: Real -> Real, a: Real, b: Real, x: Real) {
    bounded_prefix_set(f, a, b).contains(x) = bounded_prefix_contains(f, a, b, x)
}

theorem bounded_prefix_contains_lower(f: Real -> Real, a: Real, b: Real) {
    a <= b implies bounded_prefix_set(f, a, b).contains(a)
}

theorem bounded_prefix_set_is_nonempty(f: Real -> Real, a: Real, b: Real) {
    a <= b implies is_nonempty(bounded_prefix_set(f, a, b))
}

theorem bounded_prefix_set_upper_bound(f: Real -> Real, a: Real, b: Real) {
    is_set_upper_bound(bounded_prefix_set(f, a, b), b)
}

theorem bounded_prefix_set_has_upper_bound(f: Real -> Real, a: Real, b: Real) {
    has_upper_bound(bounded_prefix_set(f, a, b))
}

theorem bounded_prefix_set_supremum_exists(f: Real -> Real, a: Real, b: Real) {
    a <= b implies exists(t: Real) {
        is_set_supremum(bounded_prefix_set(f, a, b), t)
    }
}

theorem bounded_prefix_member_in_interval(f: Real -> Real, a: Real, b: Real, x: Real) {
    bounded_prefix_set(f, a, b).contains(x) implies a <= x and x <= b
}

theorem bounded_prefix_member_bound(f: Real -> Real, a: Real, b: Real, x: Real) {
    bounded_prefix_set(f, a, b).contains(x) implies exists(bound: Real) {
        forall(y: Real) {
            closed_interval_set(a, x).contains(y) implies f(y) <= bound
        }
    }
}

define is_peak(a: Nat -> Real, m: Nat) -> Bool {
    forall(k: Nat) {
        m < k implies a(k) <= a(m)
    }
}

theorem peak_later_le(a: Nat -> Real, m: Nat, k: Nat) {
    is_peak(a, m) and m < k implies a(k) <= a(m)
}

theorem not_peak_imp_later_strict(a: Nat -> Real, x: Nat) {
    (not is_peak(a, x)) implies exists(k: Nat) { x < k and a(x) < a(k) }
}

let peak_after(a: Nat -> Real, x: Nat) -> y: Nat satisfy {
    (exists(z: Nat) { x < z and is_peak(a, z) }) implies (x < y and is_peak(a, y))
}

let strict_after(a: Nat -> Real, x: Nat) -> y: Nat satisfy {
    (exists(z: Nat) { x < z and a(x) < a(z) }) implies (x < y and a(x) < a(y))
}

theorem peak_after_spec(a: Nat -> Real, x: Nat) {
    (exists(z: Nat) { x < z and is_peak(a, z) })
    implies (x < peak_after(a, x) and is_peak(a, peak_after(a, x)))
}

theorem strict_after_spec(a: Nat -> Real, x: Nat) {
    (exists(z: Nat) { x < z and a(x) < a(z) })
    implies (x < strict_after(a, x) and a(x) < a(strict_after(a, x)))
}

theorem unbounded_peaks_subsequence(a: Nat -> Real) {
    (forall(m: Nat) { exists(p: Nat) { m < p and is_peak(a, p) } })
    implies exists(f: Nat -> Nat) {
        is_subsequence_index(f) and is_decreasing_seq(subsequence(a, f))
    }
}

theorem no_peaks_subsequence(a: Nat -> Real) {
    (exists(m0: Nat) { forall(p: Nat) { m0 < p implies not is_peak(a, p) } })
    implies exists(f: Nat -> Nat) {
        is_subsequence_index(f) and is_increasing(subsequence(a, f))
    }
}

theorem image_upper_bound(f: Real -> Real, x: Real, y: Real, ub: Real) {
    (forall(t: Real) { interval_contains(x, y, t) implies f(t) <= ub })
    implies
    is_set_upper_bound(interval_image(f, x, y), ub)
}

define partition_g_values(g: Real -> Real, p: Nat -> Real, i: Nat) -> Real {
    g(p(i))
}

theorem from_nat_lte_mono(m: Nat, n: Nat) {
    m <= n implies from_nat[Real](m) <= from_nat[Real](n)
}

define pointwise_apply(f: Real -> Real, x: Nat -> Real, i: Nat) -> Real {
    f(x(i))
}

define weighted_point_sum(w: Nat -> Real, x: Nat -> Real, n: Nat) -> Real {
    partial(pointwise_product(w, x), n)
}

define weighted_value_sum(f: Real -> Real, w: Nat -> Real, x: Nat -> Real, n: Nat) -> Real {
    partial(pointwise_product(w, pointwise_apply(f, x)), n)
}

define jensen_point_in_interval_at(a: Real, b: Real, x: Nat -> Real, i: Nat) -> Bool {
    a <= x(i) and x(i) <= b
}

define jensen_points_in_interval(a: Real, b: Real, x: Nat -> Real, n: Nat) -> Bool {
    forall(i: Nat) {
        i < n implies jensen_point_in_interval_at(a, b, x, i)
    }
}

theorem jensen_points_in_interval_apply(a: Real, b: Real, x: Nat -> Real, n: Nat, i: Nat) {
    jensen_points_in_interval(a, b, x, n) and i < n implies a <= x(i) and x(i) <= b
}

theorem jensen_points_in_interval_restrict(a: Real, b: Real, x: Nat -> Real, n: Nat) {
    jensen_points_in_interval(a, b, x, n.suc) implies jensen_points_in_interval(a, b, x, n)
}

define quotient_fn(f: Real -> Real, g: Real -> Real, x: Real) -> Real {
    f(x) / g(x)
}

define div_seq(a: Nat -> Real, b: Nat -> Real, n: Nat) -> Real {
    a(n) / b(n)
}

define iterated_derivative(f: Real -> Real, dfs: Nat -> Real -> Real, k: Nat, x: Real) -> Real {
    dfs(k, x)
}

theorem partial_two_sum(f: Nat -> Real) {
    partial(f, Nat.2) = f(Nat.0) + f(Nat.1)
}

theorem partial_three_sum(f: Nat -> Real) {
    partial(f, Nat.3) = f(Nat.0) + f(Nat.1) + f(Nat.2)
}

theorem partial_four_sum(f: Nat -> Real) {
    partial(f, Nat.4) = f(Nat.0) + f(Nat.1) + f(Nat.2) + f(Nat.3)
}

theorem taylor_partial_neg(f: Nat -> Real, n: Nat) {
    partial(pointwise_neg(f), n) = -partial(f, n)
}

theorem two_mul_ge_one_step(k: Nat) {
    Nat.2 * k.suc >= Nat.1
}

define alt_term(a: Nat -> Real, n: Nat) -> Real {
    alternating_sign[Real](n) * a(n)
}

theorem tail_decreasing_seq(a: Nat -> Real, k: Nat) {
    is_decreasing_seq(a) implies is_decreasing_seq(tail(a, k))
}

theorem tail_lower_bound_seq(a: Nat -> Real, k: Nat, lb: Real) {
    is_lower_bound(a, lb) implies is_lower_bound(tail(a, k), lb)
}

theorem tail_zero_at(a: Nat -> Real, k: Nat) {
    tail(a, k)(Nat.0) = a(k)
}

define alt_even_ub_pred(c: Nat -> Real, k: Nat) -> Bool {
    partial(alt_term(c), Nat.2 * k) <= c(Nat.0) - c(Nat.2 * k)
}

define even_subseq(f: Nat -> Real, k: Nat) -> Real {
    f(Nat.2 * k)
}

define odd_subseq(f: Nat -> Real, k: Nat) -> Real {
    f(Nat.2 * k + Nat.1)
}

define row_pair_sum(x: Real, y: Real, n: Nat, k: Nat) -> Real {
    binomial_term[Real](x, y, Nat.2 * n + Nat.1, Nat.2 * k) + binomial_term[Real](x, y, Nat.2 * n + Nat.1, Nat.2 * k + Nat.1)
}

theorem const_self_lb(m: Real, a: Real, b: Real) {
    forall(t: Real) { interval_contains(a, b, t) implies m <= constant[Real, Real](m, t) }
}

theorem const_le_fn(f: Real -> Real, x0: Real, x: Real, c: Real) {
    (forall(t: Real) { interval_contains(x0, x, t) implies c <= f(t) })
    implies forall(t: Real) { interval_contains(x0, x, t) implies constant[Real, Real](c, t) <= f(t) }
}

theorem fn_le_const(f: Real -> Real, x0: Real, x: Real, c2: Real) {
    (forall(t: Real) { interval_contains(x0, x, t) implies f(t) <= c2 })
    implies forall(t: Real) { interval_contains(x0, x, t) implies f(t) <= constant[Real, Real](c2, t) }
}

theorem strict_lb_imp_lb(f: Real -> Real, x0: Real, x: Real, c: Real) {
    (forall(t: Real) { interval_contains(x0, x, t) implies c < f(t) })
    implies forall(t: Real) { interval_contains(x0, x, t) implies c <= f(t) }
}

theorem strict_ub_imp_ub(f: Real -> Real, x0: Real, x: Real, c: Real) {
    (forall(t: Real) { interval_contains(x0, x, t) implies f(t) < c })
    implies forall(t: Real) { interval_contains(x0, x, t) implies f(t) <= c }
}

theorem interior_constant_cell_point(f: Real -> Real, a: Real, b: Real, c: Real, x: Real, y: Real) {
    a <= x and x < y and y <= b and
    (forall(t: Real) { a < t and t < b implies f(t) = c })
    implies
    exists(t: Real) {
        interval_contains(x, y, t) and f(t) = c
    }
}

theorem negate_negate_set_eq(s: Set[Real]) {
    negate_set(negate_set(s)) = s
}

theorem set_infimum_le_lower_bound(s: Set[Real], inf: Real, b: Real) {
    is_set_infimum(s, inf) and is_set_lower_bound(s, b) implies b <= inf
}

theorem set_bound_above_infimum_not_lower(s: Set[Real], inf: Real, bound: Real) {
    is_set_infimum(s, inf) and inf < bound implies not is_set_lower_bound(s, bound)
}

theorem not_lt_and_ne_imp_gt(x: Real, y: Real) {
    not x < y and x != y implies y < x
}

define family_at(f: Nat -> Real -> Real, t: Real, j: Nat) -> Real {
    f(j)(t)
}

define partial_of_family(f: Nat -> Real -> Real, m: Nat, t: Real) -> Real {
    partial[Real](family_at(f, t), m)
}

define partial_x_fn(f: Real -> Real -> Real, y: Real, x: Real) -> Real {
    f(x, y)
}

define partial_y_fn(f: Real -> Real -> Real, x: Real, y: Real) -> Real {
    f(x, y)
}

theorem nondecreasing_on_endpoint_extrema(f: Real -> Real, a: Real, b: Real, x: Real) {
    nondecreasing_on(f, a, b) and closed_interval_set(a, b).contains(x)
    implies f(a) <= f(x) and f(x) <= f(b)
}

theorem nonincreasing_on_endpoint_extrema(f: Real -> Real, a: Real, b: Real, x: Real) {
    nonincreasing_on(f, a, b) and closed_interval_set(a, b).contains(x)
    implies f(x) <= f(a) and f(b) <= f(x)
}

define f_inv_pred(f: Real -> Real, a: Real, b: Real, y: Real, x: Real) -> Bool {
    closed_interval_set(a, b).contains(x) and f(x) = y
}

theorem f_inv_pred_contains_eq(f: Real -> Real, a: Real, b: Real, y: Real, x: Real) {
    f_inv_pred(f, a, b, y, x) = (closed_interval_set(a, b).contains(x) and f(x) = y)
}

define f_inv_of(f: Real -> Real, a: Real, b: Real, y: Real) -> Real {
    choose_or_default(f_inv_pred(f, a, b, y), a)
}

define function_sequence_value(f: Nat -> Real -> Real, x: Real, n: Nat) -> Real {
    f(n, x)
}

define even_term(k: Nat) -> Real {
    from_nat[Real](Nat.2 * k + Nat.2)
}

define odd_term(k: Nat) -> Real {
    from_nat[Real](Nat.2 * k + Nat.1)
}

define odd_shifted_term(k: Nat) -> Real {
    from_nat[Real](Nat.2 * k + Nat.3)
}

theorem even_term_eq(k: Nat) {
    even_term(k) = from_nat[Real](Nat.2 * k + Nat.2)
}

theorem odd_term_eq(k: Nat) {
    odd_term(k) = from_nat[Real](Nat.2 * k + Nat.1)
}

theorem odd_shifted_term_eq(k: Nat) {
    odd_shifted_term(k) = from_nat[Real](Nat.2 * k + Nat.3)
}

define ps_diff_coeff(a: Nat -> Real, n: Nat) -> Real {
    Real.from_rat(Rat.from_nat(n.suc)) * a(n.suc)
