define nonneg_seq(a: Nat -> Real) -> Bool {
    forall(n: Nat) {
        not a(n).is_negative
    }
}

theorem nonneg_imp_partial_increasing(a: Nat -> Real) {
    nonneg_seq(a) implies is_increasing(partial(a))
}

theorem increasing_from_nonneg_start(a: Nat -> Real) {
    not a(Nat.0).is_negative and is_increasing(a) implies nonneg_seq(a)
}

theorem nonneg_partial_nonneg(a: Nat -> Real) {
    nonneg_seq(a) implies
    nonneg_seq(partial(a))
}

theorem partial_nonneg(f: Nat -> Real, n: Nat) {
    is_lower_bound(f, Real.0) implies partial(f, n) >= Real.0
}

theorem nonneg_pow(r: Real) {
    0 <= r implies nonneg_seq(r.pow)
}

theorem pos_geom_has_upper_bound(r: Real) {
    0 <= r and r < 1 implies
    exists(ub: Real) {
        is_upper_bound(partial(r.pow), ub)
    }
}

theorem pos_geom_converges(r: Real) {
    0 <= r and r < 1 implies converges(partial(r.pow))
}

theorem abs_pow(r: Real, n: Nat) {
    r.abs.pow(n) = r.pow(n).abs
}

theorem abs_geom_comm(r: Real) {
    compose(Real.abs, r.pow) = r.abs.pow
}

theorem geom_converges(r: Real) {
    r.abs < 1 implies converges(partial(r.pow))
}

theorem partial_tail_decomp(a: Nat -> Real, m: Nat) {
    converges(partial(a)) implies
    limit(partial(a)) = partial(a, m) + limit(partial(tail(a, m)))
}

theorem pow_tail(r: Real) {
    tail(r.pow, Nat.1) = mul_seq(r, r.pow)
}

theorem partial_one(a: Nat -> Real) {
    partial(a, Nat.1) = a(Nat.0)
}

theorem geom_series_no_div(r: Real) {
    r.abs < 1 implies
    1 + r * limit(partial(r.pow)) = limit(partial(r.pow))
}

define delta(v: Real, a: Nat, k: Nat) -> Real {
    if k = a {
        v
    } else {
        Real.0
    }
}

theorem delta_before(v: Real, a: Nat, k: Nat) {
    k < a implies delta(v, a, k) = Real.0
}

theorem delta_at(v: Real, a: Nat) {
    delta(v, a, a) = v
}

theorem delta_after(v: Real, a: Nat, k: Nat) {
    k > a implies delta(v, a, k) = Real.0
}

define delta_seq(v: Real, a: Nat) -> (Nat -> Real) {
    function(k: Nat) {
        delta(v, a, k)
    }
}

theorem partial_delta_before(v: Real, a: Nat, n: Nat) {
    n <= a implies partial(delta_seq(v, a), n) = Real.0
}

theorem partial_delta_at_or_after(v: Real, a: Nat, n: Nat) {
    a < n implies partial(delta_seq(v, a), n) = v
}

theorem delta_partial_converges(v: Real, a: Nat) {
    converges_to(partial(delta_seq(v, a)), v)
}

theorem delta_abs_commute(v: Real, a: Nat, k: Nat) {
    delta(v, a, k).abs = delta(v.abs, a, k)
}

theorem delta_absolutely_converges(v: Real, a: Nat) {
    converges(partial(compose(Real.abs, delta_seq(v, a))))
}

theorem partial_sum_split_tail(a: Nat -> Real, m: Nat, n: Nat) {
    partial(a, m + n) = partial(a, m) + partial(tail(a, m), n)
}

theorem tail_partial_sum_sub(a: Nat -> Real, m: Nat, n: Nat) {
    partial(tail(a, m), n) = partial(a, m + n) - partial(a, m)
}

theorem partial_sums_seq_lte(a: Nat -> Real, b: Nat -> Real) {
    seq_lte(a, b) implies seq_lte(partial(a), partial(b))
}

theorem series_comparison_converges(a: Nat -> Real, b: Nat -> Real) {
    is_lower_bound(a, Real.0)
    and seq_lte(a, b)
    and converges(partial(b))
    implies converges(partial(a))
}

theorem nonnegative_series_partials_monotone(a: Nat -> Real) {
    is_lower_bound(a, Real.0) implies is_monotone(partial(a))
}

theorem series_limit_split_tail(a: Nat -> Real, m: Nat) {
    converges(partial(a)) implies
    limit(partial(a)) = partial(a, m) + limit(partial(tail(a, m)))
}

define pointwise_le[T](f: T -> Real, g: T -> Real) -> Bool {
    forall(t: T) { f(t) <= g(t) }
}

theorem pointwise_le_at[T](f: T -> Real, g: T -> Real, t: T) {
    pointwise_le(f, g) implies f(t) <= g(t)
}

theorem list_map_sum_le_cons[T](head: T, tail: List[T], f: T -> Real, g: T -> Real) {
    sum[Real](map(tail, f)) <= sum[Real](map(tail, g)) and f(head) <= g(head)
        implies sum[Real](map(List.cons(head, tail), f)) <= sum[Real](map(List.cons(head, tail), g))
}

define list_map_term[T](items: List[T], f: T -> Real, index: Nat) -> Real {
    match items.get_idx(index) {
        Option.none {
            Real.0
        }
        Option.some(item) {
            f(item)
        }
    }
}

theorem list_map_sum_le[T](items: List[T], f: T -> Real, g: T -> Real) {
    pointwise_le(f, g) implies sum[Real](map(items, f)) <= sum[Real](map(items, g))
}

theorem finite_set_sum_le[T](s: FiniteSet[T], f: T -> Real, g: T -> Real) {
    pointwise_le(f, g) implies finite_set_sum(s, f) <= finite_set_sum(s, g)
}

theorem finite_set_sum_nonneg[T](s: FiniteSet[T], f: T -> Real) {
    (forall(item: T) { Real.0 <= f(item) }) implies Real.0 <= finite_set_sum(s, f)
}

theorem finite_set_sum_eq_of_pointwise_on_set[T, A: AddCommMonoid](
    s: FiniteSet[T], f: T -> A, g: T -> A
) {
    (forall(x: T) { s.contains(x) implies f(x) = g(x) }) implies
        finite_set_sum(s, f) = finite_set_sum(s, g)
}

theorem finite_set_sum_eq_of_function_eq_global[T, A: AddCommMonoid](
    s: FiniteSet[T], f: T -> A, g: T -> A
) {
    f = g implies finite_set_sum(s, f) = finite_set_sum(s, g)
}

theorem finite_set_sum_pointwise_add[T, A: AddCommMonoid](s: FiniteSet[T], f: T -> A, g: T -> A) {
    finite_set_sum(s, add_fn(f, g)) = finite_set_sum(s, f) + finite_set_sum(s, g)
}

theorem finite_set_sum_insert_right[T, A: AddCommMonoid](s: FiniteSet[T], item: T, f: T -> A) {
    not s.contains(item) implies finite_set_sum(fs_insert(s, item), f) = finite_set_sum(s, f) + f(item)
}

theorem finite_set_sum_disjoint_union_commuted[T, A: AddCommMonoid](
    a: FiniteSet[T], b: FiniteSet[T], f: T -> A
) {
    a.is_disjoint(b) implies
        finite_set_sum(fs_union(a, b), f) = finite_set_sum(b, f) + finite_set_sum(a, f)
}

theorem finite_set_sum_scalar_mul_right_form[T, S: Semiring](c: S, s: FiniteSet[T], f: T -> S) {
    finite_set_sum(s, mul_fn(c, f)) = c * finite_set_sum(s, f)
}

theorem finite_set_product_contains_iff_components[T, U](
    a: FiniteSet[T], b: FiniteSet[U], p: Pair[T, U]
) {
    finite_set_product(a, b).contains(p) iff (a.contains(p.first) and b.contains(p.second))
}

theorem finite_set_product_contains_of_components[T, U](
    a: FiniteSet[T], b: FiniteSet[U], p: Pair[T, U]
) {
    a.contains(p.first) and b.contains(p.second) implies finite_set_product(a, b).contains(p)
}

theorem finite_set_product_contains_first[T, U](a: FiniteSet[T], b: FiniteSet[U], p: Pair[T, U]) {
    finite_set_product(a, b).contains(p) implies a.contains(p.first)
}

theorem finite_set_product_contains_second[T, U](a: FiniteSet[T], b: FiniteSet[U], p: Pair[T, U]) {
    finite_set_product(a, b).contains(p) implies b.contains(p.second)
}

theorem finite_set_product_subset_left[T, U](a: FiniteSet[T], a_target: FiniteSet[T], b: FiniteSet[U]) {
    a.subset_eq(a_target) implies finite_set_product(a, b).subset_eq(finite_set_product(a_target, b))
}

theorem finite_set_product_subset_right[T, U](a: FiniteSet[T], b: FiniteSet[U], b_target: FiniteSet[U]) {
    b.subset_eq(b_target) implies finite_set_product(a, b).subset_eq(finite_set_product(a, b_target))
}

theorem finite_set_sum_product_fubini_rows_rev[T, U, A: AddCommMonoid](
    a: FiniteSet[T], b: FiniteSet[U], f: Pair[T, U] -> A
) {
    finite_set_sum(a, function(x: T) { finite_set_sum(b, function(y: U) { f(Pair.new(x, y)) }) }) =
        finite_set_sum(finite_set_product(a, b), f)
}

theorem finite_set_product_row_fn_apply[T, U, A](f: Pair[T, U] -> A, x: T, y: U) {
    finite_set_product_row_fn(f, x, y) = f(Pair.new(x, y))
}

theorem finite_set_sum_nonnegative_of_pointwise[T](s: FiniteSet[T], f: T -> Real) {
    (forall(item: T) { Real.0 <= f(item) }) implies Real.0 <= finite_set_sum(s, f)
}

theorem finite_set_sum_monotone_of_pointwise_le[T](s: FiniteSet[T], f: T -> Real, g: T -> Real) {
    pointwise_le(f, g) implies finite_set_sum(s, f) <= finite_set_sum(s, g)
}

theorem pointwise_le_intro[T](f: T -> Real, g: T -> Real) {
    (forall(t: T) { f(t) <= g(t) }) implies pointwise_le(f, g)
}

theorem pointwise_le_iff_forall[T](f: T -> Real, g: T -> Real) {
    pointwise_le(f, g) iff forall(t: T) { f(t) <= g(t) }
}

theorem pointwise_le_elim[T](f: T -> Real, g: T -> Real, t: T) {
    pointwise_le(f, g) implies f(t) <= g(t)
}

define prod_seq(a: Nat -> Real, b: Nat -> Real, n: Nat) -> Real {
    a(n) * b(n)
}

theorem abs_le_abs_add_eps(x: Real, y: Real, eps: Real) {
    x.is_close(y, eps) implies x.abs <= y.abs + eps
}

theorem mul_le_lt_of_nonneg_pos(a: Real, b: Real, c: Real, d: Real) {
    a <= b and c < d
    and not a.is_negative and not c.is_negative
    and b.is_positive and d.is_positive
    implies
    a * c < b * d
}

theorem mul_close_from_close(a1: Real, a2: Real, b1: Real, b2: Real,
                              a_eps: Real, b_eps: Real,
                              a_bound: Real, b_bound: Real) {
    a1.is_close(a2, a_eps) and b1.is_close(b2, b_eps)
    and a1.abs <= a_bound and b2.abs <= b_bound
    and a_bound.is_positive and b_bound.is_positive
    and a_eps.is_positive and b_eps.is_positive
    implies
    (a1 * b1).is_close(a2 * b2, a_bound * b_eps + a_eps * b_bound)
}

theorem limit_prod_seq(a: Nat -> Real, b: Nat -> Real) {
    converges(a) and converges(b)
    implies
    converges_to(prod_seq(a, b), limit(a) * limit(b))
}

theorem prod_seq_converges(a: Nat -> Real, b: Nat -> Real) {
    converges(a) and converges(b)
    implies
    converges(prod_seq(a, b))
}

theorem limit_of_prod(a: Nat -> Real, b: Nat -> Real) {
    converges(a) and converges(b)
    implies
    limit(prod_seq(a, b)) = limit(a) * limit(b)
}

define is_bounded_seq(a: Nat -> Real) -> Bool {
    exists(bound: Real) {
        forall(n: Nat) {
            a(n).abs < bound
        }
    }
}

theorem real_strict_upper_bound_pair(a: Real, b: Real) {
    exists(c: Real) {
        a < c and b < c
    }
}

theorem finite_seq_real_abs_bounded(a: Nat -> Real, n: Nat) {
    exists(bound: Real) {
        forall(i: Nat) {
            i <= n implies a(i).abs < bound
        }
    }
}

theorem converges_to_imp_bounded_seq(a: Nat -> Real, x: Real) {
    converges_to(a, x) implies is_bounded_seq(a)
}

theorem converges_imp_bounded_seq(a: Nat -> Real) {
    converges(a) implies is_bounded_seq(a)
}

define same_limit(a: Nat -> Real, b: Nat -> Real) -> Bool {
    converges(a) and converges(b) and limit(a) = limit(b)
}

define vanishes(a: Nat -> Real) -> Bool {
    converges(a) and limit(a) = Real.0
}

define abs_seq(a: Nat -> Real, n: Nat) -> Real {
    a(n).abs
}

theorem same_limit_refl(a: Nat -> Real) {
    converges(a) implies same_limit(a, a)
}

theorem same_limit_symm(a: Nat -> Real, b: Nat -> Real) {
    same_limit(a, b) implies same_limit(b, a)
}

theorem same_limit_trans(a: Nat -> Real, b: Nat -> Real, c: Nat -> Real) {
    same_limit(a, b) and same_limit(b, c) implies same_limit(a, c)
}

theorem abs_abs_sub_le_abs_sub(a: Real, b: Real) {
    (a.abs - b.abs).abs <= (a - b).abs
}

theorem abs_abs(a: Real) {
    a.abs.abs = a.abs
}

theorem abs_close_of_close(a: Real, b: Real, eps: Real) {
    a.is_close(b, eps) implies a.abs.is_close(b.abs, eps)
}

theorem limit_abs_seq(a: Nat -> Real) {
    converges(a) implies converges_to(abs_seq(a), limit(a).abs)
}

theorem same_limit_add_seq(a: Nat -> Real, b: Nat -> Real, c: Nat -> Real, d: Nat -> Real) {
    same_limit(a, b) and same_limit(c, d)
    implies same_limit(add_seq(a, c), add_seq(b, d))
}

theorem same_limit_prod_seq(a: Nat -> Real, b: Nat -> Real, c: Nat -> Real, d: Nat -> Real) {
    same_limit(a, b) and same_limit(c, d)
    implies same_limit(prod_seq(a, c), prod_seq(b, d))
}

theorem same_limit_abs_seq(a: Nat -> Real, b: Nat -> Real) {
    same_limit(a, b) implies same_limit(abs_seq(a), abs_seq(b))
}

theorem vanishes_abs_seq(a: Nat -> Real) {
    vanishes(a) implies vanishes(abs_seq(a))
}

theorem vanishes_of_abs_lte_abs(a: Nat -> Real, b: Nat -> Real) {
    seq_lte(abs_seq(a), abs_seq(b)) and vanishes(b)
    implies vanishes(a)
}

theorem same_limit_add_vanish_right(a: Nat -> Real, b: Nat -> Real) {
    converges(a) and vanishes(b)
    implies same_limit(add_seq(a, b), a)
}

theorem vanishes_prod_seq(a: Nat -> Real, b: Nat -> Real) {
    converges(a) and vanishes(b)
    implies vanishes(prod_seq(a, b))
}

theorem same_limit_imp_vanishes(a: Nat -> Real, b: Nat -> Real) {
    same_limit(a, b) implies vanishes(add_seq(a, neg_seq(b)))
}

theorem vanishes_squeeze(a: Nat -> Real, b: Nat -> Real) {
    seq_lte(const_seq(Real.0), a) and seq_lte(a, b) and vanishes(b)
    implies vanishes(a)
}

theorem squeeze_theorem(a: Nat -> Real, b: Nat -> Real, c: Nat -> Real) {
    seq_lte(a, b) and seq_lte(b, c) and same_limit(a, c)
    implies same_limit(a, b)
}

define tends_to_infinity(f: Nat -> Nat) -> Bool {
    forall(big_n: Nat) {
        exists(m: Nat) {
            forall(n: Nat) {
                m <= n implies big_n <= f(n)
            }
        }
    }
}

define is_nondecreasing_nat(f: Nat -> Nat) -> Bool {
    forall(i: Nat, j: Nat) {
        i <= j implies f(i) <= f(j)
    }
}

theorem monotone_is_nondecreasing_nat(f: Nat -> Nat) {
    is_monotone(f) implies is_nondecreasing_nat(f)
}

define is_unbounded(f: Nat -> Nat) -> Bool {
    forall(bound: Nat) {
        exists(n: Nat) {
            bound < f(n)
        }
    }
}

theorem nondecreasing_unbounded_tends_to_infinity(f: Nat -> Nat) {
    is_nondecreasing_nat(f) and is_unbounded(f)
    implies
    tends_to_infinity(f)
}

theorem monotone_unbounded_tends_to_infinity(f: Nat -> Nat) {
    is_monotone(f) and is_unbounded(f)
    implies
    tends_to_infinity(f)
}

theorem converges_compose_tends_to_infinity(a: Nat -> Real, f: Nat -> Nat) {
    converges(a) and tends_to_infinity(f)
    implies
    converges_to(compose(a, f), limit(a))
}

theorem converges_compose_nondecreasing_unbounded(a: Nat -> Real, f: Nat -> Nat) {
    converges(a) and is_nondecreasing_nat(f) and is_unbounded(f)
    implies
    converges_to(compose(a, f), limit(a))
}

theorem converges_compose_monotone_unbounded(a: Nat -> Real, f: Nat -> Nat) {
    converges(a) and is_monotone(f) and is_unbounded(f)
    implies
    converges_to(compose(a, f), limit(a))
}

define is_subsequence_index(f: Nat -> Nat) -> Bool {
    is_monotone(f) and is_unbounded(f)
}

define subsequence(a: Nat -> Real, f: Nat -> Nat, n: Nat) -> Real {
    compose(a, f)(n)
}

theorem subsequence_index_is_monotone(f: Nat -> Nat) {
    is_subsequence_index(f) implies is_monotone(f)
}

theorem subsequence_index_is_unbounded(f: Nat -> Nat) {
    is_subsequence_index(f) implies is_unbounded(f)
}

theorem subsequence_index_of_monotone_unbounded(f: Nat -> Nat) {
    is_monotone(f) and is_unbounded(f) implies is_subsequence_index(f)
}

theorem subsequence_index_tends_to_infinity(f: Nat -> Nat) {
    is_subsequence_index(f) implies tends_to_infinity(f)
}

theorem subsequence_eq_compose(a: Nat -> Real, f: Nat -> Nat) {
    subsequence(a, f) = compose(a, f)
}

theorem converges_subsequence(a: Nat -> Real, f: Nat -> Nat) {
    converges(a) and is_subsequence_index(f)
    implies
    converges_to(subsequence(a, f), limit(a))
}

theorem subsequence_converges(a: Nat -> Real, f: Nat -> Nat) {
    converges(a) and is_subsequence_index(f)
    implies
    converges(subsequence(a, f))
}

theorem limit_subsequence(a: Nat -> Real, f: Nat -> Nat) {
    converges(a) and is_subsequence_index(f)
    implies
    limit(subsequence(a, f)) = limit(a)
}

theorem subsequence_same_limit_left(a: Nat -> Real, f: Nat -> Nat) {
    converges(a) and is_subsequence_index(f)
    implies
    same_limit(subsequence(a, f), a)
}

theorem subsequence_same_limit_right(a: Nat -> Real, f: Nat -> Nat) {
    converges(a) and is_subsequence_index(f)
    implies
    same_limit(a, subsequence(a, f))
}

theorem mul_nondecreasing(k: Nat) {
    Nat.1 <= k implies is_nondecreasing_nat(k.mul)
}

theorem mul_monotone(k: Nat) {
    Nat.1 <= k implies is_monotone(k.mul)
}

theorem mul_unbounded(k: Nat) {
    Nat.1 <= k implies is_unbounded(k.mul)
}

theorem add_nondecreasing(k: Nat) {
    is_nondecreasing_nat(k.add)
}

theorem add_monotone(k: Nat) {
    is_monotone(k.add)
}

theorem add_unbounded(k: Nat) {
    is_unbounded(k.add)
}

theorem mul_subsequence_index(k: Nat) {
    Nat.1 <= k implies is_subsequence_index(k.mul)
}

theorem add_subsequence_index(k: Nat) {
    is_subsequence_index(k.add)
}

theorem double_subsequence_index {
    is_subsequence_index(Nat.2.mul)
}

theorem suc_subsequence_index {
    is_subsequence_index(Nat.suc)
}

theorem converges_compose_mul(a: Nat -> Real, k: Nat) {
    converges(a) and Nat.1 <= k
    implies
    converges_to(compose(a, k.mul), limit(a))
}

theorem converges_compose_add(a: Nat -> Real, k: Nat) {
    converges(a)
    implies
    converges_to(compose(a, k.add), limit(a))
}

theorem converges_compose_double(a: Nat -> Real) {
    converges(a)
    implies
    converges_to(compose(a, Nat.2.mul), limit(a))
}

theorem converges_compose_suc(a: Nat -> Real) {
    converges(a)
    implies
    converges_to(compose(a, Nat.suc), limit(a))
}

theorem converges_subsequence_mul(a: Nat -> Real, k: Nat) {
    converges(a) and Nat.1 <= k
    implies
    converges_to(subsequence(a, k.mul), limit(a))
}

theorem converges_subsequence_add(a: Nat -> Real, k: Nat) {
    converges(a)
    implies
    converges_to(subsequence(a, k.add), limit(a))
}

theorem converges_subsequence_double(a: Nat -> Real) {
    converges(a)
    implies
    converges_to(subsequence(a, Nat.2.mul), limit(a))
}

theorem converges_subsequence_suc(a: Nat -> Real) {
    converges(a)
    implies
    converges_to(subsequence(a, Nat.suc), limit(a))
}

theorem subsequence_converges_to_limit(a: Nat -> Real, f: Nat -> Nat) {
    converges(a) and is_subsequence_index(f)
    implies
    converges_to(subsequence(a, f), limit(a))
}

theorem subsequence_of_convergent_converges(a: Nat -> Real, f: Nat -> Nat) {
    converges(a) and is_subsequence_index(f)
    implies
    converges(subsequence(a, f))
}

theorem subsequence_limit_eq_original(a: Nat -> Real, f: Nat -> Nat) {
    converges(a) and is_subsequence_index(f)
    implies
    limit(subsequence(a, f)) = limit(a)
}

theorem abs_of_vanishing_vanishes(a: Nat -> Real) {
    vanishes(a) implies vanishes(abs_seq(a))
}

theorem vanishes_by_squeeze(a: Nat -> Real, b: Nat -> Real) {
    seq_lte(const_seq(Real.0), a) and seq_lte(a, b) and vanishes(b)
    implies vanishes(a)
}

theorem vanishes_by_abs_domination(a: Nat -> Real, b: Nat -> Real) {
    seq_lte(abs_seq(a), abs_seq(b)) and vanishes(b)
    implies vanishes(a)
}

theorem same_limit_add_vanishing(a: Nat -> Real, b: Nat -> Real) {
    converges(a) and vanishes(b)
    implies same_limit(add_seq(a, b), a)
}

define abs_fn(a: Nat -> Real) -> (Nat -> Real) {
    function(n: Nat) { a(n).abs }
}

define filter_seq(f: Nat -> Real, p: Nat -> Bool, n: Nat) -> Real {
    if p(n) { f(n) } else { Real.0 }
}

define mask(f: Nat -> Real, s: Set[Nat], n: Nat) -> Real {
    filter_seq(f, s.contains, n)
}

define mask_seq_sum(a: Nat -> Real, s: Nat -> Set[Nat], i: Nat) -> Real {
    limit(partial(mask(a, s(i))))
}

