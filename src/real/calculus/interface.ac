define regular_open_hull(s: Set[Real]) -> Set[Real] {
    interior(closure(s))
}

define regular_closed_hull(s: Set[Real]) -> Set[Real] {
    closure(interior(s))
}

define is_regular_open_real_set(s: Set[Real]) -> Bool {
