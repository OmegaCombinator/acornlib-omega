theorem differentiable_square_real_mul(f: Real -> Real, x0: Real) {
    differentiable_at(f, x0) implies differentiable_at(pointwise_mul(square_real, f), x0)
}

theorem differentiable_mul_square_real(f: Real -> Real, x0: Real) {
