define sequence_cluster_contains(a: Nat -> Real, x: Real) -> Bool {
    forall(m: Nat) {
        closure(sequence_tail_set(a, m)).contains(x)
    }
}

define sequence_cluster_set(a: Nat -> Real) -> Set[Real] {
