        pointwise_div_real(square_real, affine_real(a, b)),
        pointwise_div_real(
            pointwise_add(
                pointwise_mul(pointwise_add(identity_fn[Real], identity_fn[Real]), affine_real(a, b)),
                pointwise_neg(pointwise_mul(square_real, constant[Real, Real](a)))
