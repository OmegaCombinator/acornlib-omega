define seq_in_real_set(s: Set[Real], a: Nat -> Real) -> Bool {
    forall(n: Nat) {
        s.contains(a(n))
    }
}

define seq_eventually_in_real_set(s: Set[Real], a: Nat -> Real) -> Bool {
    exists(n0: Nat) {
        forall(n: Nat) {
            n0 <= n implies s.contains(a(n))
        }
    }
}

define seq_frequently_in_real_set(s: Set[Real], a: Nat -> Real) -> Bool {
    forall(n_start: Nat) {
        exists(n_witness: Nat) {
            n_start <= n_witness and s.contains(a(n_witness))
        }
    }
}

theorem seq_frequently_in_real_set_at(s: Set[Real], a: Nat -> Real, n_start: Nat) {
    seq_frequently_in_real_set(s, a) implies exists(n_witness: Nat) {
        n_start <= n_witness and s.contains(a(n_witness))
    }
}

theorem seq_in_real_set_at(s: Set[Real], a: Nat -> Real, n: Nat) {
    seq_in_real_set(s, a) implies s.contains(a(n))
}

theorem seq_in_real_set_intro(s: Set[Real], a: Nat -> Real) {
    forall(n: Nat) { s.contains(a(n)) } implies seq_in_real_set(s, a)
}

theorem seq_in_real_set_of_subset(s: Set[Real], t: Set[Real], a: Nat -> Real) {
    s.subset(t) and seq_in_real_set(s, a) implies seq_in_real_set(t, a)
}

theorem seq_in_real_set_intersection(s: Set[Real], t: Set[Real], a: Nat -> Real) {
    seq_in_real_set(s, a) and seq_in_real_set(t, a) implies seq_in_real_set(s.intersection(t), a)
}

theorem seq_in_real_set_union_left(s: Set[Real], t: Set[Real], a: Nat -> Real) {
    seq_in_real_set(s, a) implies seq_in_real_set(s.union(t), a)
}

theorem seq_in_real_set_union_right(s: Set[Real], t: Set[Real], a: Nat -> Real) {
    seq_in_real_set(t, a) implies seq_in_real_set(s.union(t), a)
}

theorem seq_in_real_set_eventually(s: Set[Real], a: Nat -> Real) {
    seq_in_real_set(s, a) implies seq_eventually_in_real_set(s, a)
}

theorem seq_in_real_set_frequently(s: Set[Real], a: Nat -> Real) {
    seq_in_real_set(s, a) implies seq_frequently_in_real_set(s, a)
}

theorem seq_eventually_in_real_set_of_subset(s: Set[Real], t: Set[Real], a: Nat -> Real) {
    s.subset(t) and seq_eventually_in_real_set(s, a) implies seq_eventually_in_real_set(t, a)
}

theorem seq_eventually_in_real_set_intersection(s: Set[Real], t: Set[Real], a: Nat -> Real) {
    seq_eventually_in_real_set(s, a) and seq_eventually_in_real_set(t, a)
    implies seq_eventually_in_real_set(s.intersection(t), a)
}

theorem seq_eventually_in_real_set_union_left(s: Set[Real], t: Set[Real], a: Nat -> Real) {
    seq_eventually_in_real_set(s, a) implies seq_eventually_in_real_set(s.union(t), a)
}

theorem seq_eventually_in_real_set_union_right(s: Set[Real], t: Set[Real], a: Nat -> Real) {
    seq_eventually_in_real_set(t, a) implies seq_eventually_in_real_set(s.union(t), a)
}

theorem seq_eventually_in_real_set_frequently(s: Set[Real], a: Nat -> Real) {
    seq_eventually_in_real_set(s, a) implies seq_frequently_in_real_set(s, a)
}

theorem seq_frequently_in_real_set_of_subset(s: Set[Real], t: Set[Real], a: Nat -> Real) {
    s.subset(t) and seq_frequently_in_real_set(s, a) implies seq_frequently_in_real_set(t, a)
}

theorem seq_frequently_eventually_in_real_set_intersection(s: Set[Real], t: Set[Real], a: Nat -> Real) {
    seq_frequently_in_real_set(s, a) and seq_eventually_in_real_set(t, a)
    implies seq_frequently_in_real_set(s.intersection(t), a)
}

define sequence_range_set(a: Nat -> Real) -> Set[Real] {
    Set[Real].new(sequence_range_contains(a))
}

define sequence_tail_set(a: Nat -> Real, m: Nat) -> Set[Real] {
    Set[Real].new(sequence_tail_contains(a, m))
}

define sequence_tail_meets_set(a: Nat -> Real, m: Nat, s: Set[Real]) -> Bool {
    exists(x: Real) {
        sequence_tail_set(a, m).contains(x) and s.contains(x)
    }
}

theorem sequence_range_set_contains_eq(a: Nat -> Real, x: Real) {
    sequence_range_set(a).contains(x) = exists(n: Nat) { x = a(n) }
}

theorem sequence_tail_set_contains_eq(a: Nat -> Real, m: Nat, x: Real) {
    sequence_tail_set(a, m).contains(x) = exists(n: Nat) { m <= n and x = a(n) }
}

theorem sequence_range_set_contains_term(a: Nat -> Real, n: Nat) {
    sequence_range_set(a).contains(a(n))
}

theorem sequence_tail_set_contains_term(a: Nat -> Real, m: Nat, n: Nat) {
    m <= n implies sequence_tail_set(a, m).contains(a(n))
}

theorem sequence_tail_set_subset_range_set(a: Nat -> Real, m: Nat) {
    sequence_tail_set(a, m).subset(sequence_range_set(a))
}

theorem sequence_tail_set_subset_of_le(a: Nat -> Real, m: Nat, n: Nat) {
    m <= n implies sequence_tail_set(a, n).subset(sequence_tail_set(a, m))
}

theorem sequence_tail_set_subset_self(a: Nat -> Real, m: Nat) {
    sequence_tail_set(a, m).subset(sequence_tail_set(a, m))
}

theorem sequence_tail_set_contains_of_le(a: Nat -> Real, m: Nat, n: Nat, x: Real) {
    m <= n and sequence_tail_set(a, n).contains(x) implies sequence_tail_set(a, m).contains(x)
}

theorem sequence_range_set_contains_sequence(a: Nat -> Real) {
    seq_in_real_set(sequence_range_set(a), a)
}

theorem sequence_range_set_frequently_contains_sequence(a: Nat -> Real) {
    seq_frequently_in_real_set(sequence_range_set(a), a)
}

theorem sequence_tail_set_eventually_contains_sequence(a: Nat -> Real, m: Nat) {
    seq_eventually_in_real_set(sequence_tail_set(a, m), a)
}

theorem sequence_tail_set_frequently_contains_sequence(a: Nat -> Real, m: Nat) {
    seq_frequently_in_real_set(sequence_tail_set(a, m), a)
}

theorem seq_in_real_set_iff_range_subset(s: Set[Real], a: Nat -> Real) {
    seq_in_real_set(s, a) = sequence_range_set(a).subset(s)
}

theorem seq_eventually_in_real_set_iff_tail_subset(s: Set[Real], a: Nat -> Real) {
    seq_eventually_in_real_set(s, a) = exists(m: Nat) { sequence_tail_set(a, m).subset(s) }
}

theorem seq_frequently_in_real_set_iff_tail_meets(s: Set[Real], a: Nat -> Real) {
    seq_frequently_in_real_set(s, a) = forall(m: Nat) { sequence_tail_meets_set(a, m, s) }
}

theorem sequence_tail_meets_set_of_le(a: Nat -> Real, m: Nat, n: Nat, s: Set[Real]) {
    m <= n and sequence_tail_meets_set(a, n, s) implies sequence_tail_meets_set(a, m, s)
}

theorem sequence_tail_subset_of_tail_subset(a: Nat -> Real, m: Nat, n: Nat, s: Set[Real]) {
    m <= n and sequence_tail_set(a, m).subset(s) implies sequence_tail_set(a, n).subset(s)
}

theorem sequence_tail_meets_set_intersection_contains(a: Nat -> Real, m: Nat, s: Set[Real], x: Real) {
    sequence_tail_set(a, m).contains(x) and s.contains(x)
    implies sequence_tail_set(a, m).intersection(s).contains(x)
}

theorem sequence_tail_meets_set_iff_intersection_inhabited(a: Nat -> Real, m: Nat, s: Set[Real]) {
    sequence_tail_meets_set(a, m, s) = exists(x: Real) {
        sequence_tail_set(a, m).intersection(s).contains(x)
    }
}

theorem seq_eventually_in_real_set_iff_pullback_eventually(s: Set[Real], a: Nat -> Real) {
    seq_eventually_in_real_set(s, a) = eventually_predicate_nat(predicate_pullback(a, s.contains))
}

theorem eventually_pullback_iff_sequence_tail_subset(s: Set[Real], a: Nat -> Real) {
    eventually_predicate_nat(predicate_pullback(a, s.contains)) = exists(m: Nat) {
        sequence_tail_set(a, m).subset(s)
    }
}

theorem seq_eventually_equal_real_preserves_eventual_membership(
    s: Set[Real],
    a: Nat -> Real,
    b: Nat -> Real
) {
    seq_eventually_equal_real(a, b) and seq_eventually_in_real_set(s, a)
    implies seq_eventually_in_real_set(s, b)
}

theorem seq_eventually_in_real_set_of_pullback_subset(s: Set[Real], t: Set[Real], a: Nat -> Real) {
    predicate_subset(predicate_pullback(a, s.contains), predicate_pullback(a, t.contains)) and
    seq_eventually_in_real_set(s, a) implies seq_eventually_in_real_set(t, a)
}

theorem seq_eventually_in_real_set_compose_tends_to_infinity(
    s: Set[Real],
    a: Nat -> Real,
    f: Nat -> Nat
) {
    seq_eventually_in_real_set(s, a) and tends_to_infinity(f)
    implies seq_eventually_in_real_set(s, compose(a, f))
}

theorem seq_eventually_in_real_set_shift_add(s: Set[Real], a: Nat -> Real, k: Nat) {
    seq_eventually_in_real_set(s, a) implies seq_eventually_in_real_set(s, compose(a, k.add))
}

theorem seq_eventually_in_real_set_subsequence(
    s: Set[Real],
    a: Nat -> Real,
    f: Nat -> Nat
) {
    seq_eventually_in_real_set(s, a) and is_subsequence_index(f)
    implies seq_eventually_in_real_set(s, subsequence(a, f))
}

theorem seq_eventually_in_real_set_tail_subsequence(s: Set[Real], a: Nat -> Real, k: Nat) {
    seq_eventually_in_real_set(s, a) implies seq_eventually_in_real_set(s, subsequence(a, k.add))
}

define is_nonempty(s: Set[Real]) -> Bool {
    exists(x: Real) {
        s.contains(x)
    }
}

define is_set_upper_bound(s: Set[Real], b: Real) -> Bool {
    forall(x: Real) {
        s.contains(x) implies x <= b
    }
}

define has_upper_bound(s: Set[Real]) -> Bool {
    exists(b: Real) {
        is_set_upper_bound(s, b)
    }
}

define is_set_lower_bound(s: Set[Real], b: Real) -> Bool {
    forall(x: Real) {
        s.contains(x) implies b <= x
    }
}

attributes Real {
    /// True if this real number is an upper bound for the set s.
    define is_set_upper_bound(self, s: Real -> Bool) -> Bool {
        forall(y: Real) {
            s(y) implies y <= self
        }
    }

    /// True if this real number is a lower bound for the set s.
    define is_set_lower_bound(self, s: Real -> Bool) -> Bool {
        forall(y: Real) {
            s(y) implies self <= y
        }
    }

    /// True if this real number is the least upper bound (supremum) for the set s.
    define is_set_least_upper_bound(self, s: Real -> Bool) -> Bool {
        self.is_set_upper_bound(s) and
        forall(y: Real) {
            y.is_set_upper_bound(s) implies self <= y
        }
    }

    /// True if this real number is the greatest lower bound (infimum) for the set s.
    define is_set_greatest_lower_bound(self, s: Real -> Bool) -> Bool {
        self.is_set_lower_bound(s) and
        forall(y: Real) {
            y.is_set_lower_bound(s) implies y <= self
        }
    }
}

define sup_cut(s: Real -> Bool, r: Rat) -> Bool {
    not Real.from_rat(r).is_set_upper_bound(s)
}

theorem sup_cut_is_cut(s: Real -> Bool, ub: Real) {
    is_nonempty_pred(s) and ub.is_set_upper_bound(s)
    implies
    is_cut(sup_cut(s))
}

theorem sup_cut_is_lower(s: Real -> Bool, ub: Real) {
    is_nonempty_pred(s) and ub.is_set_upper_bound(s)
    implies
    is_lower(sup_cut(s))
}

theorem sup_cut_not_has_greatest(s: Real -> Bool, ub: Real) {
    is_nonempty_pred(s) and ub.is_set_upper_bound(s)
    implies
    not has_greatest(sup_cut(s))
}

theorem sup_cut_is_dedekind_cut(s: Real -> Bool, ub: Real) {
    is_nonempty_pred(s) and ub.is_set_upper_bound(s)
    implies
    is_dedekind_cut(sup_cut(s))
}

theorem ub_imp_lub(s: Real -> Bool, x: Real) {
    is_nonempty_pred(s) and x.is_set_upper_bound(s)
    implies exists(y: Real) {
        y.is_set_least_upper_bound(s)
    }
}

theorem lb_imp_flip_ub(f: Real -> Bool, x: Real) {
    x.is_set_lower_bound(f) implies (-x).is_set_upper_bound(flip(f))
}

theorem ub_imp_flip_lb(f: Real -> Bool, x: Real) {
    x.is_set_upper_bound(f) implies (-x).is_set_lower_bound(flip(f))
}

theorem glb_imp_flip_lub(f: Real -> Bool, x: Real) {
    x.is_set_greatest_lower_bound(f)
    implies (-x).is_set_least_upper_bound(flip(f))
}

theorem lub_imp_flip_glb(f: Real -> Bool, x: Real) {
    x.is_set_least_upper_bound(f)
    implies (-x).is_set_greatest_lower_bound(flip(f))
}

theorem lb_imp_glb(s: Real -> Bool, x: Real) {
    is_nonempty_pred(s) and x.is_set_lower_bound(s)
    implies exists(y: Real) {
        y.is_set_greatest_lower_bound(s)
    }
}

theorem ub_imp_image_ub(a: Nat -> Real, b: Real) {
    is_upper_bound(a, b)
    implies b.is_set_upper_bound(image(a))
}

define is_set_supremum(s: Set[Real], sup: Real) -> Bool {
    is_set_upper_bound(s, sup) and
    forall(b: Real) {
        is_set_upper_bound(s, b) implies sup <= b
    }
}

define is_set_infimum(s: Set[Real], inf: Real) -> Bool {
    is_set_lower_bound(s, inf) and
    forall(b: Real) {
        is_set_lower_bound(s, b) implies b <= inf
    }
}

theorem set_supremum_is_upper_bound(s: Set[Real], sup: Real) {
    is_set_supremum(s, sup) implies is_set_upper_bound(s, sup)
}

theorem set_upper_bound_contains_le(s: Set[Real], bound: Real, x: Real) {
    is_set_upper_bound(s, bound) and s.contains(x) implies x <= bound
}

theorem set_supremum_le_upper_bound(s: Set[Real], sup: Real, bound: Real) {
    is_set_supremum(s, sup) and is_set_upper_bound(s, bound) implies sup <= bound
}

theorem set_member_le_supremum(s: Set[Real], sup: Real, x: Real) {
    is_set_supremum(s, sup) and s.contains(x) implies x <= sup
}

theorem set_bound_below_supremum_not_upper(s: Set[Real], sup: Real, bound: Real) {
    is_set_supremum(s, sup) and bound < sup implies not is_set_upper_bound(s, bound)
}

theorem set_not_upper_bound_witness(s: Set[Real], bound: Real) {
    not is_set_upper_bound(s, bound) implies exists(x: Real) {
        s.contains(x) and not x <= bound
    }
}

theorem set_supremum_close_from_below(s: Set[Real], sup: Real, eps: Real) {
    is_set_supremum(s, sup) and eps.is_positive implies exists(x: Real) {
        s.contains(x) and sup - eps < x and x <= sup and x.is_close(sup, eps)
    }
}

theorem completeness(s: Set[Real]) {
    is_nonempty(s) and has_upper_bound(s)
    implies
    exists(sup: Real) {
        is_set_supremum(s, sup)
    }
}

theorem supremum_exists_for_subset(s: Set[Real], t: Set[Real], sup_t: Real) {
    s.subset(t) and is_nonempty(s) and is_set_supremum(t, sup_t)
    implies
    exists(sup_s: Real) {
        is_set_supremum(s, sup_s)
    }
}

theorem supremum_subset_le(s: Set[Real], t: Set[Real], sup_s: Real, sup_t: Real) {
    s.subset(t) and is_set_supremum(s, sup_s) and is_set_supremum(t, sup_t)
    implies
    sup_s <= sup_t
}

theorem supremum_union_max(s: Set[Real], t: Set[Real], sup_s: Real, sup_t: Real) {
    is_set_supremum(s, sup_s) and is_set_supremum(t, sup_t)
    implies
    is_set_supremum(s.union(t), sup_s.max(sup_t))
}

define setwise_add_contains(s: Set[Real], t: Set[Real], x: Real) -> Bool {
    exists(a: Real, b: Real) {
        s.contains(a) and t.contains(b) and x = a + b
    }
}

define setwise_add(s: Set[Real], t: Set[Real]) -> Set[Real] {
    Set[Real].new(setwise_add_contains(s, t))
}

theorem setwise_add_contains_iff(s: Set[Real], t: Set[Real], x: Real) {
    setwise_add(s, t).contains(x) = setwise_add_contains(s, t, x)
}

theorem setwise_add_membership(s: Set[Real], t: Set[Real], a: Real, b: Real) {
    s.contains(a) and t.contains(b)
    implies
    setwise_add(s, t).contains(a + b)
}

theorem supremum_setwise_add(s: Set[Real], t: Set[Real], sup_s: Real, sup_t: Real) {
    is_set_supremum(s, sup_s) and is_set_supremum(t, sup_t)
    implies
    is_set_supremum(setwise_add(s, t), sup_s + sup_t)
}

define negate_set_contains(s: Set[Real], x: Real) -> Bool {
    exists(a: Real) {
        s.contains(a) and x = -a
    }
}

define negate_set(s: Set[Real]) -> Set[Real] {
    Set[Real].new(negate_set_contains(s))
}

theorem supremum_infimum_duality(s: Set[Real], sup_s: Real) {
    is_set_supremum(s, sup_s)
    implies
    is_set_infimum(negate_set(s), -sup_s)
}

define scalar_contains(alpha: Real, s: Set[Real], x: Real) -> Bool {
    exists(a: Real) {
        s.contains(a) and x = alpha * a
    }
}

define scalar_mult(alpha: Real, s: Set[Real]) -> Set[Real] {
    Set[Real].new(scalar_contains(alpha, s))
}

theorem scalar_mult_contains_iff(alpha: Real, s: Set[Real], x: Real) {
    scalar_mult(alpha, s).contains(x) = scalar_contains(alpha, s, x)
}

theorem scalar_mult_witness(alpha: Real, s: Set[Real], x: Real) {
    scalar_mult(alpha, s).contains(x)
    implies
    exists(a: Real) {
        s.contains(a) and x = alpha * a
    }
}

theorem scalar_mult_membership(alpha: Real, s: Set[Real], a: Real) {
    s.contains(a)
    implies
    scalar_mult(alpha, s).contains(alpha * a)
}

theorem mul_supremum_le(alpha: Real, s: Set[Real], sup_s: Real, ub: Real) {
    alpha >= Real.0 and is_set_supremum(s, sup_s) and is_nonempty(s) and
    (forall(a: Real) { s.contains(a) implies alpha * a <= ub })
    implies
    alpha * sup_s <= ub
}

theorem supremum_scalar_mult(alpha: Real, s: Set[Real], sup_s: Real) {
    alpha >= Real.0 and is_nonempty(s) and is_set_supremum(s, sup_s)
    implies
    is_set_supremum(scalar_mult(alpha, s), alpha * sup_s)
}

theorem supremum_scalar_mult_neg(alpha: Real, s: Set[Real], inf_s: Real) {
    alpha < Real.0 and is_nonempty(s) and is_set_infimum(s, inf_s)
    implies
    is_set_supremum(scalar_mult(alpha, s), alpha * inf_s)
}

define seq_image(a: Nat -> Real) -> Set[Real] {
    set_image(Set[Nat].universal_set, a)
}

theorem seq_image_contains_iff(a: Nat -> Real, x: Real) {
    seq_image(a).contains(x) = image(a, x)
}

theorem monotone_convergence_seq(a: Nat -> Real, b: Real) {
    is_increasing(a) and is_upper_bound(a, b)
    implies
    is_set_supremum(seq_image(a), limit(a))
}

define function_image_contains(f: Real -> Real, s: Set[Real], y: Real) -> Bool {
    image_contains(f, s, y)
}

define function_image(f: Real -> Real, s: Set[Real]) -> Set[Real] {
    set_image(s, f)
}

theorem function_image_contains_iff(f: Real -> Real, s: Set[Real], y: Real) {
    function_image(f, s).contains(y) = function_image_contains(f, s, y)
}

theorem function_image_compose(f: Real -> Real, g: Real -> Real, s: Set[Real]) {
    function_image(f, function_image(g, s)) = function_image(compose(f, g), s)
}

theorem supremum_order_preserving(f: Real -> Real, s: Set[Real], sup_s: Real) {
    is_nondecreasing(f) and is_set_supremum(s, sup_s) and is_nonempty(function_image(f, s))
    implies
    exists(sup_fs: Real) {
        is_set_supremum(function_image(f, s), sup_fs) and sup_fs <= f(sup_s)
    }
}

theorem supremum_monotone_image_le(f: Real -> Real, s: Set[Real], sup_s: Real) {
    is_monotone(f) and is_set_supremum(s, sup_s) and is_nonempty(function_image(f, s))
    implies
    exists(sup_fs: Real) {
        is_set_supremum(function_image(f, s), sup_fs) and sup_fs <= f(sup_s)
    }
}

define double_image_set(f: (Nat, Nat) -> Real) -> Set[Real] {
    Set[Real].new(double_image(f))
}

theorem double_image_set_nonempty(f: (Nat, Nat) -> Real) {
    is_nonempty(double_image_set(f))
}

theorem double_image_set_upper_bound_of_double_is_upper_bound(f: (Nat, Nat) -> Real, b: Real) {
    double_is_upper_bound(f, b) implies is_set_upper_bound(double_image_set(f), b)
}

theorem double_image_supremum_equiv(f: (Nat, Nat) -> Real, s_val: Real) {
    is_set_supremum(double_image_set(f), s_val)
    implies
    double_image_is_supremum(f, s_val)
}

define interval_set(a: Real, b: Real) -> Set[Real] {
    Set[Real].new(interval_contains(a, b))
}

define interval_image(f: Real -> Real, x: Real, y: Real) -> Set[Real] {
    function_image(f, interval_set(x, y))
}

define has_lower_bound(s: Set[Real]) -> Bool {
    exists(b: Real) {
        is_set_lower_bound(s, b)
    }
}

theorem set_supremum_unique(s: Set[Real], m1: Real, m2: Real) {
    is_set_supremum(s, m1) and is_set_supremum(s, m2) implies m1 = m2
}

theorem set_infimum_is_lower_bound(s: Set[Real], inf: Real) {
    is_set_infimum(s, inf) implies is_set_lower_bound(s, inf)
}

theorem set_lower_bound_le_infimum(s: Set[Real], inf: Real, lb: Real) {
    is_set_infimum(s, inf) and is_set_lower_bound(s, lb) implies lb <= inf
}

theorem set_lower_bound_contains_le(s: Set[Real], lb: Real, x: Real) {
    is_set_lower_bound(s, lb) and s.contains(x) implies lb <= x
}

theorem set_infimum_unique(s: Set[Real], m1: Real, m2: Real) {
    is_set_infimum(s, m1) and is_set_infimum(s, m2) implies m1 = m2
}

theorem interval_set_contains_left(a: Real, b: Real) {
    a <= b implies interval_set(a, b).contains(a)
}

theorem interval_set_contains_right(a: Real, b: Real) {
    a <= b implies interval_set(a, b).contains(b)
}

theorem image_nonempty(f: Real -> Real, s: Set[Real]) {
    is_nonempty(s) implies is_nonempty(function_image(f, s))
}

theorem neg_upper_bound_of_lower(s: Set[Real], lb: Real) {
    is_set_lower_bound(s, lb)
    implies
    is_set_upper_bound(negate_set(s), -lb)
}

theorem negate_set_nonempty(s: Set[Real]) {
    is_nonempty(s) implies is_nonempty(negate_set(s))
}

theorem inf_of_neg_sup(s: Set[Real], sup: Real) {
    is_set_supremum(negate_set(s), sup)
    implies
    is_set_infimum(s, -sup)
}

theorem interval_sup_exists(f: Real -> Real, x: Real, y: Real) {
    is_nonempty(interval_set(x, y)) and has_upper_bound(interval_image(f, x, y))
    implies
    exists(m: Real) {
        is_set_supremum(interval_image(f, x, y), m)
    }
}

theorem interval_inf_exists(f: Real -> Real, x: Real, y: Real) {
    is_nonempty(interval_set(x, y)) and has_lower_bound(interval_image(f, x, y))
    implies
    exists(m: Real) {
        is_set_infimum(interval_image(f, x, y), m)
    }
}
