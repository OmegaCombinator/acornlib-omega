theorem div_le_of_le_mul_pos(a: Real, b: Real, c: Real) {
    a * c <= b and c.is_positive implies a <= b / c
}

theorem le_div_of_mul_le_pos(a: Real, b: Real, c: Real) {
    b <= a * c and c.is_positive implies b / c <= a
