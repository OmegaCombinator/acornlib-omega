theorem log_value_three_lt_two {
    three.log.get_or_else(Real.0) < two
}

theorem log_value_three_gt_one {
    three.log.get_or_else(Real.0) > Real.1
}

theorem log_value_e_sq {
    (Real.e * Real.e).log.get_or_else(Real.0) = two
