theorem e_sq_gt_four {
    Real.e * Real.e > two * two
}

theorem e_sq_lt_nine {
    Real.e * Real.e < three * three
}

theorem exp_two_gt_three {
    two.exp > three
}

theorem exp_two_gt_e {
    two.exp > Real.e
}

theorem e_gt_five_over_two {
    Real.e > Real.1 + Real.1 + Real.one_half
