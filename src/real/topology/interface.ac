theorem secant_remainder_is_derivative_on_open_local(f: Real -> Real, df: Real -> Real, a: Real, b: Real) {
    is_derivative_on_open(f, df, a, b)
    implies is_derivative_on_open(secant_remainder(f, a, b),
        secant_remainder_derivative(df, f, a, b), a, b)
}

theorem is_derivative_on_open_imp_differentiable_on_open(
    f: Real -> Real, df: Real -> Real, a: Real, b: Real
) {
    is_derivative_on_open(f, df, a, b) implies differentiable_on_open(f, a, b)
}

theorem secant_remainder_endpoints_equal(f: Real -> Real, a: Real, b: Real) {
    a < b implies secant_remainder(f, a, b, a) = secant_remainder(f, a, b, b)
}

theorem mean_value_theorem(f: Real -> Real, df: Real -> Real, a: Real, b: Real) {
    continuous(f) and a < b and is_derivative_fn(f, df)
    implies exists(c: Real) {
        a < c and c < b and has_derivative_at(f, c, secant_slope(f, a, b))
    }
}

theorem mean_value_theorem_local(f: Real -> Real, df: Real -> Real, a: Real, b: Real) {
    continuous_on_closed(f, a, b) and a < b and is_derivative_on_open(f, df, a, b)
    implies exists(c: Real) {
        a < c and c < b and has_derivative_at(f, c, secant_slope(f, a, b))
    }
}

theorem zero_derivative_imp_constant(
    f: Real -> Real, a: Real, b: Real, x: Real
) {
    continuous(f) and a < b and is_derivative_fn(f, constant[Real, Real](Real.0)) and
    closed_interval_set(a, b).contains(x)
    implies f(x) = f(a)
}

theorem nonneg_derivative_imp_nondecreasing(
    f: Real -> Real, df: Real -> Real, a: Real, b: Real, x: Real, y: Real
) {
    continuous(f) and a < b and is_derivative_fn(f, df) and
    (forall(z: Real) { Real.0 <= df(z) }) and
    closed_interval_set(a, b).contains(x) and closed_interval_set(a, b).contains(y) and
    x <= y
    implies f(x) <= f(y)
}

theorem one_half_le_one {
    Real.one_half <= Real.1
}

theorem one_minus_half_eq_half {
    Real.1 - Real.one_half = Real.one_half
}

theorem convex_midpoint_inequality(f: Real -> Real, a: Real, b: Real, x: Real, y: Real) {
    convex_on(f, a, b) and a <= x and x <= b and a <= y and y <= b
    implies f((x + y) * Real.one_half) <= (f(x) + f(y)) * Real.one_half
}

theorem ge_zero_div_pos_ge_zero(a: Real, b: Real) {
    Real.0 <= a and b.is_positive implies Real.0 <= a / b
}

theorem neg_inverse(a: Real) {
    a != Real.0 implies (-a).inverse = -a.inverse
}

theorem neg_div_neg_eq(a: Real, b: Real) {
    b != Real.0 implies (-a) / (-b) = a / b
}

theorem difference_quotient_eq_secant_slope(f: Real -> Real, x0: Real, x: Real) {
    x != x0 implies difference_quotient(f, x0, x) = secant_slope(f, x0, x)
}

theorem difference_quotient_swap_eq_secant_slope(f: Real -> Real, x0: Real, x: Real) {
    x != x0 implies difference_quotient(f, x0, x) = secant_slope(f, x, x0)
}

theorem convex_chord_combination(f: Real -> Real, a: Real, b: Real, x: Real, z: Real, w: Real) {
    convex_on(f, a, b) and a <= x and x < z and z < w and w <= b
    implies f(z) <= (Real.1 - (z - x) * (w - x).inverse) * f(x) + (z - x) * (w - x).inverse * f(w)
}

theorem convex_slope_second_arg_monotone(f: Real -> Real, a: Real, b: Real, x: Real, z: Real, w: Real) {
    convex_on(f, a, b) and a <= x and x < z and z < w and w <= b
    implies secant_slope(f, x, z) <= secant_slope(f, x, w)
}

theorem convex_slope_first_arg_monotone(f: Real -> Real, a: Real, b: Real, x: Real, z: Real, w: Real) {
    convex_on(f, a, b) and a <= x and x < z and z < w and w <= b
    implies secant_slope(f, x, w) <= secant_slope(f, z, w)
}

theorem convex_imp_df_le_chord_slope(f: Real -> Real, df: Real -> Real, a: Real, b: Real, x: Real, y: Real) {
    convex_on(f, a, b) and is_derivative_fn(f, df) and a <= x and x < y and y <= b
    implies df(x) <= secant_slope(f, x, y)
}

theorem convex_imp_chord_slope_le_df(f: Real -> Real, df: Real -> Real, a: Real, b: Real, x: Real, y: Real) {
    convex_on(f, a, b) and is_derivative_fn(f, df) and a <= x and x < y and y <= b
    implies secant_slope(f, x, y) <= df(y)
}

theorem convex_imp_derivative_nondecreasing(f: Real -> Real, df: Real -> Real, a: Real, b: Real, x: Real, y: Real) {
    convex_on(f, a, b) and is_derivative_fn(f, df) and a < x and x < y and y < b
    implies df(x) <= df(y)
}

theorem convex_imp_derivative_fn_nondecreasing_on(f: Real -> Real, df: Real -> Real, a: Real, b: Real) {
    convex_on(f, a, b) and is_derivative_fn(f, df) and a < b
    implies forall(x: Real, y: Real) { a < x and x < y and y < b implies df(x) <= df(y) }
}

theorem slope_inequality_imp_convex_combination(f: Real -> Real, x: Real, z: Real, y: Real, t: Real) {
    x < z and z < y and z = (Real.1 - t) * x + t * y and
    secant_slope(f, x, z) <= secant_slope(f, z, y)
    implies f(z) <= (Real.1 - t) * f(x) + t * f(y)
}

theorem derivative_nondecreasing_imp_convex_condition(f: Real -> Real, df: Real -> Real, a: Real, b: Real) {
    a < b and is_derivative_fn(f, df) and
    (forall(u: Real, v: Real) { u <= v implies df(u) <= df(v) })
    implies forall(x: Real, y: Real, t: Real) {
        a <= x and x <= y and y <= b and Real.0 <= t and t <= Real.1
        implies f((Real.1 - t) * x + t * y) <= (Real.1 - t) * f(x) + t * f(y)
    }
}

theorem derivative_nondecreasing_imp_convex(f: Real -> Real, df: Real -> Real, a: Real, b: Real) {
    a < b and is_derivative_fn(f, df) and
    (forall(u: Real, v: Real) { u <= v implies df(u) <= df(v) })
    implies convex_on(f, a, b)
}

theorem convex_imp_second_derivative_nonneg(f: Real -> Real, df: Real -> Real, ddf: Real -> Real, a: Real, b: Real, x0: Real) {
    convex_on(f, a, b) and is_derivative_fn(f, df) and is_derivative_fn(df, ddf) and
    a < x0 and x0 < b
    implies Real.0 <= ddf(x0)
}

theorem darboux_aux_has_derivative_at(f: Real -> Real, df: Real -> Real, t: Real, x: Real) {
    has_derivative_at(f, x, df(x))
    implies has_derivative_at(darboux_aux(f, t), x, df(x) - t)
}

theorem darboux_aux_continuous_at(f: Real -> Real, df: Real -> Real, t: Real, x: Real) {
    has_derivative_at(f, x, df(x))
    implies continuous_at(darboux_aux(f, t), x)
}

theorem darboux_aux_continuous_on_closed(
    f: Real -> Real, df: Real -> Real, t: Real, a: Real, b: Real
) {
    (forall(x: Real) { has_derivative_at(f, x, df(x)) })
    implies continuous_on_closed(darboux_aux(f, t), a, b)
}

theorem div_neg_denominator(a: Real, b: Real) {
    b != Real.0 implies a / (-b) = -(a / b)
}

theorem derivative_negative_imp_dips_right(h: Real -> Real, a: Real, b: Real, d: Real) {
    a < b and has_derivative_at(h, a, d) and d < Real.0
    implies exists(x: Real) { a < x and x < b and h(x) < h(a) }
}

theorem derivative_positive_imp_dips_left(h: Real -> Real, a: Real, b: Real, d: Real) {
    a < b and has_derivative_at(h, b, d) and Real.0 < d
    implies exists(x: Real) { a < x and x < b and h(x) < h(b) }
}

theorem darboux_theorem(f: Real -> Real, df: Real -> Real, a: Real, b: Real, t: Real) {
    a < b and
    (forall(x: Real) { has_derivative_at(f, x, df(x)) }) and
    df(a) < t and t < df(b)
    implies exists(c: Real) {
        a < c and c < b and df(c) = t
    }
}

theorem exp_lte_mono(x: Real, y: Real) {
    x <= y implies x.exp <= y.exp
}

theorem exp_lower_bound_on(a: Real, b: Real) {
    a <= b implies forall(t: Real) { interval_contains(a, b, t) implies a.exp <= t.exp }
}

theorem exp_upper_bound_on(a: Real, b: Real) {
    a <= b implies forall(t: Real) { interval_contains(a, b, t) implies t.exp <= b.exp }
}

theorem image_upper_bound(f: Real -> Real, x: Real, y: Real, ub: Real) {
    (forall(t: Real) { interval_contains(x, y, t) implies f(t) <= ub })
    implies
    is_set_upper_bound(interval_image(f, x, y), ub)
}

theorem step_lower_le_g_increment(f: Real -> Real, g: Real -> Real, a: Real, b: Real, lb: Real, p: Nat -> Real, n: Nat, i: Nat) {
    is_partition(p, a, b, n) and i < n and a <= b and continuous(g) and is_derivative_fn(g, f) and
    (forall(t: Real) { interval_contains(a, b, t) implies lb <= f(t) })
    implies
    partition_step_lower(f, p, i) <= diff_step(partition_g_values(g, p), i)
}

theorem step_upper_ge_g_increment(f: Real -> Real, g: Real -> Real, a: Real, b: Real, ub: Real, p: Nat -> Real, n: Nat, i: Nat) {
    is_partition(p, a, b, n) and i < n and a <= b and continuous(g) and is_derivative_fn(g, f) and
    (forall(t: Real) { interval_contains(a, b, t) implies f(t) <= ub })
    implies
    diff_step(partition_g_values(g, p), i) <= partition_step_upper(f, p, i)
}

theorem lower_sum_le_g_diff(f: Real -> Real, g: Real -> Real, a: Real, b: Real, lb: Real, p: Nat -> Real, n: Nat) {
    a <= b and continuous(g) and is_derivative_fn(g, f) and
    is_partition(p, a, b, n) and
    (forall(t: Real) { interval_contains(a, b, t) implies lb <= f(t) })
    implies
    lower_sum(f, p, n) <= g(b) - g(a)
}

theorem g_diff_le_upper_sum(f: Real -> Real, g: Real -> Real, a: Real, b: Real, ub: Real, p: Nat -> Real, n: Nat) {
    a <= b and continuous(g) and is_derivative_fn(g, f) and
    is_partition(p, a, b, n) and
    (forall(t: Real) { interval_contains(a, b, t) implies f(t) <= ub })
    implies
    g(b) - g(a) <= upper_sum(f, p, n)
}

theorem ftc2_general(f: Real -> Real, g: Real -> Real, a: Real, b: Real, lb: Real, ub: Real) {
    a <= b and continuous(g) and is_derivative_fn(g, f) and is_integrable(f, a, b) and
    (forall(t: Real) { interval_contains(a, b, t) implies lb <= f(t) }) and
    (forall(t: Real) { interval_contains(a, b, t) implies f(t) <= ub })
    implies
    integral(f, a, b) = g(b) - g(a)
}

theorem integral_exp_ftc2(a: Real, b: Real) {
    a <= b and is_integrable(Real.exp, a, b)
    implies
    integral(Real.exp, a, b) = b.exp - a.exp
}

theorem mul_frac_right(a: Real, b: Real, c: Real) {
    b != Real.0 implies (a / b) * c = (a * c) / b
}

theorem interval_sup_exp_right(x: Real, y: Real) {
    x <= y implies interval_sup(Real.exp, x, y) = y.exp
}

theorem interval_inf_exp_left(x: Real, y: Real) {
    x <= y implies interval_inf(Real.exp, x, y) = x.exp
}

theorem div_nonneg_pos_denom(a: Real, d: Real) {
    Real.0 <= a and d > Real.0 implies Real.0 <= a / d
}

theorem from_nat_lte_mono(m: Nat, n: Nat) {
    m <= n implies from_nat[Real](m) <= from_nat[Real](n)
}

define uniform_partition(a: Real, b: Real, n: Nat, i: Nat) -> Real {
    a + from_nat[Real](i) * ((b - a) / from_nat[Real](n.suc))
}

theorem uniform_partition_start(a: Real, b: Real, n: Nat) {
    uniform_partition(a, b, n, Nat.0) = a
}

theorem uniform_partition_end(a: Real, b: Real, n: Nat) {
    uniform_partition(a, b, n, n.suc) = b
}

theorem uniform_partition_monotone(a: Real, b: Real, n: Nat, i: Nat, j: Nat) {
    a <= b and i <= j and j <= n.suc
    implies uniform_partition(a, b, n, i) <= uniform_partition(a, b, n, j)
}

theorem uniform_partition_is_partition(a: Real, b: Real, n: Nat) {
    a <= b implies is_partition(uniform_partition(a, b, n), a, b, n.suc)
}

theorem uniform_partition_width(a: Real, b: Real, n: Nat, i: Nat) {
    i < n.suc implies
    uniform_partition(a, b, n, i + 1) - uniform_partition(a, b, n, i) =
        (b - a) / from_nat[Real](n.suc)
}

theorem uniform_upper_minus_lower(a: Real, b: Real, n: Nat) {
    a <= b implies
    upper_sum(Real.exp, uniform_partition(a, b, n), n.suc) -
        lower_sum(Real.exp, uniform_partition(a, b, n), n.suc) =
        ((b - a) / from_nat[Real](n.suc)) * (b.exp - a.exp)
}

theorem exp_lower_sum_set_bounded_above(a: Real, b: Real) {
    a <= b implies is_set_upper_bound(lower_sum_set(Real.exp, a, b), b.exp - a.exp)
}

theorem exp_upper_sum_set_bounded_below(a: Real, b: Real) {
    a <= b implies is_set_lower_bound(upper_sum_set(Real.exp, a, b), b.exp - a.exp)
}

theorem exp_lower_sum_set_sup_exists(a: Real, b: Real) {
    a <= b implies exists(l: Real) {
        is_set_supremum(lower_sum_set(Real.exp, a, b), l)
    }
}

theorem exp_upper_sum_set_inf_exists(a: Real, b: Real) {
    a <= b implies exists(u: Real) {
        is_set_infimum(upper_sum_set(Real.exp, a, b), u)
    }
}

theorem frac_all_n_imp_lte_zero(c: Real, d: Real) {
    (forall(n: Nat) { d <= c / from_nat[Real](n.suc) })
    implies d <= Real.0
}

theorem nonneg_frac_all_n_imp_zero(c: Real, d: Real) {
    Real.0 <= d and (forall(n: Nat) { d <= c / from_nat[Real](n.suc) })
    implies d = Real.0
}

theorem exp_integrable(a: Real, b: Real) {
    a <= b implies is_integrable(Real.exp, a, b)
}

theorem integral_exp(a: Real, b: Real) {
    a <= b implies integral(Real.exp, a, b) = b.exp - a.exp
}

theorem integral_exp_unit_value {
    integral(Real.exp, Real.0, Real.1) = Real.e - Real.1
}

define scaled_weight(c: Real, w: Nat -> Real, i: Nat) -> Real {
    c.inverse * w(i)
}

theorem scaled_weight_nonneg(c: Real, w: Nat -> Real, i: Nat) {
    Real.0 < c and Real.0 <= w(i) implies Real.0 <= scaled_weight(c, w, i)
}

theorem partial_scaled_weight(c: Real, w: Nat -> Real, n: Nat) {
    partial(scaled_weight(c, w), n) = c.inverse * partial(w, n)
}

theorem partial_weighted_scaled(c: Real, w: Nat -> Real, y: Nat -> Real, n: Nat) {
    c != Real.0 implies
    partial(pointwise_product(w, y), n) = c * partial(pointwise_product(scaled_weight(c, w), y), n)
}

define quotient_fn(f: Real -> Real, g: Real -> Real, x: Real) -> Real {
    f(x) / g(x)
}

theorem cauchy_combination_eq_pointwise(f: Real -> Real, g: Real -> Real, a: Real, b: Real) {
    cauchy_combination(f, g, a, b) = pointwise_add(
        pointwise_mul(constant[Real, Real](f(b) - f(a)), g),
        pointwise_mul(constant[Real, Real](-(g(b) - g(a))), f))
}

theorem cauchy_combination_is_derivative_on_open(f: Real -> Real, g: Real -> Real,
    df: Real -> Real, dg: Real -> Real, a: Real, b: Real) {
    is_derivative_fn(f, df) and is_derivative_fn(g, dg)
    implies is_derivative_on_open(cauchy_combination(f, g, a, b),
        cauchy_combination_derivative(f, g, df, dg, a, b), a, b)
}

theorem cauchy_mean_value_theorem(f: Real -> Real, g: Real -> Real, df: Real -> Real,
    dg: Real -> Real, a: Real, b: Real) {
    continuous(f) and continuous(g) and a < b and is_derivative_fn(f, df) and
    is_derivative_fn(g, dg)
    implies exists(c: Real) {
        a < c and c < b and (f(b) - f(a)) * dg(c) = (g(b) - g(a)) * df(c)
    }
}

theorem lhopital_ratio_cauchy_mvt(f: Real -> Real, g: Real -> Real, df: Real -> Real,
    dg: Real -> Real, a: Real, x: Real) {
    continuous(f) and continuous(g) and is_derivative_fn(f, df) and
    is_derivative_fn(g, dg) and f(a) = Real.0 and g(a) = Real.0 and a < x and
    g(x) != Real.0 and (forall(z: Real) { a < z and z < x implies dg(z) != Real.0 })
    implies exists(c: Real) {
        a < c and c < x and quotient_fn(f, g, x) = quotient_fn(df, dg, c)
    }
}

theorem div_not_zero(u: Real, v: Real) {
    u != Real.0 and v != Real.0 implies u / v != Real.0
}

theorem dq_seq_tail_bounds(f: Real -> Real, a: Real, d: Real, q: Nat -> Real) {
    has_derivative_at(f, a, d) and converges_to(q, a) and
    (forall(n: Nat) { q(n) != a })
    implies forall(eps2: Real) {
        eps2.is_positive implies exists(n2: Nat) {
            tail_bound(compose(difference_quotient(f, a), q), d, n2, eps2)
        }
    }
}

theorem difference_quotient_seq_limit(f: Real -> Real, a: Real, d: Real, q: Nat -> Real) {
    has_derivative_at(f, a, d) and converges_to(q, a) and
    (forall(n: Nat) { q(n) != a })
    implies converges_to(compose(difference_quotient(f, a), q), d)
}

theorem dq_denominator_seq_nonzero(g: Real -> Real, a: Real, q: Nat -> Real) {
    g(a) = Real.0 and (forall(n: Nat) { q(n) != a }) and
    (forall(x: Real) { x != a implies g(x) != Real.0 })
    implies forall(n: Nat) { compose(difference_quotient(g, a), q, n) != Real.0 }
}

theorem lhopital_pointwise_dq_ratio(f: Real -> Real, g: Real -> Real, a: Real, x: Real) {
    f(a) = Real.0 and g(a) = Real.0 and x != a and g(x) != Real.0
    implies difference_quotient(f, a, x) / difference_quotient(g, a, x) =
        quotient_fn(f, g, x)
}

define recip_seq(b: Nat -> Real, n: Nat) -> Real {
    b(n).inverse
}

theorem converges_to_recip_seq(b: Nat -> Real, b_lim: Real) {
    converges_to(b, b_lim) and b_lim != Real.0
    implies converges_to(recip_seq(b), b_lim.inverse)
}

define div_seq(a: Nat -> Real, b: Nat -> Real, n: Nat) -> Real {
    a(n) / b(n)
}

theorem div_seq_eq_prod_recip(a: Nat -> Real, b: Nat -> Real) {
    div_seq(a, b) = prod_seq(a, recip_seq(b))
}

theorem converges_to_div_seq(a: Nat -> Real, b: Nat -> Real, a_lim: Real, b_lim: Real) {
    converges_to(a, a_lim) and converges_to(b, b_lim) and b_lim != Real.0
    implies converges_to(div_seq(a, b), a_lim / b_lim)
}

theorem lhopital_derivative_ratio_seq_limit(
    f: Real -> Real, g: Real -> Real, df: Real -> Real, dg: Real -> Real,
    a: Real, q: Nat -> Real) {
    is_derivative_fn(f, df) and is_derivative_fn(g, dg) and
    f(a) = Real.0 and g(a) = Real.0 and dg(a) != Real.0 and
    (forall(x: Real) { x != a implies g(x) != Real.0 }) and
    (forall(n: Nat) { q(n) != a }) and converges_to(q, a)
    implies converges_to(compose(quotient_fn(f, g), q), df(a) / dg(a))
}

theorem lhopital_continuous_derivatives(f: Real -> Real, g: Real -> Real,
    df: Real -> Real, dg: Real -> Real, a: Real) {
    continuous_at(df, a) and continuous_at(dg, a) and is_derivative_fn(f, df) and
    is_derivative_fn(g, dg) and f(a) = Real.0 and g(a) = Real.0 and
    dg(a) != Real.0 and (forall(x: Real) { x != a implies g(x) != Real.0 })
    implies limit_at(quotient_fn(f, g), a, df(a) / dg(a))
}

theorem limit_at_pointwise_mul(f: Real -> Real, g: Real -> Real, a: Real, l: Real, m: Real) {
    limit_at(f, a, l) and limit_at(g, a, m)
    implies limit_at(pointwise_mul[Real, Real](f, g), a, l * m)
}

theorem limit_at_quotient_fn(f: Real -> Real, g: Real -> Real, a: Real, l: Real, m: Real) {
    limit_at(f, a, l) and limit_at(g, a, m) and m != Real.0
    implies limit_at(quotient_fn(f, g), a, l / m)
}

theorem limit_at_const(c: Real, a: Real) {
    limit_at(constant[Real, Real](c), a, c)
}

theorem limit_at_const_mul(f: Real -> Real, a: Real, l: Real, c: Real) {
    limit_at(f, a, l)
    implies limit_at(pointwise_mul[Real, Real](constant[Real, Real](c), f), a, c * l)
}

theorem derivative_bound_imp_lipschitz(
    f: Real -> Real, df: Real -> Real, k: Real, a: Real, b: Real
) {
    is_derivative_fn(f, df) and (forall(z: Real) { df(z).abs <= k }) and
    continuous(f) and Real.0 <= k and a <= b
    implies (f(b) - f(a)).abs <= k * (b - a).abs
}

theorem rpow_prod_base(x: Real, y: Real, a: Real) {
    x > Real.0 and y > Real.0 implies
        (x * y).rpow(a) = Option.some((a * (x.log.get_or_else(Real.0) + y.log.get_or_else(Real.0))).exp)
}

theorem rpow_prod_base_val(x: Real, y: Real, a: Real, u: Real, v: Real) {
    x > Real.0 and y > Real.0 and x.rpow(a) = Option.some(u) and y.rpow(a) = Option.some(v)
    implies (x * y).rpow(a) = Option.some(u * v)
}

theorem rpow_quot_base(x: Real, y: Real, a: Real) {
    x > Real.0 and y > Real.0 implies
        (x / y).rpow(a) = Option.some((a * (x.log.get_or_else(Real.0) - y.log.get_or_else(Real.0))).exp)
}

theorem rpow_quot_base_val(x: Real, y: Real, a: Real, u: Real, v: Real) {
    x > Real.0 and y > Real.0 and x.rpow(a) = Option.some(u) and y.rpow(a) = Option.some(v)
    implies (x / y).rpow(a) = Option.some(u / v)
}

theorem rpow_inv_base(x: Real, a: Real, u: Real) {
    x > Real.0 and x.rpow(a) = Option.some(u)
    implies (Real.1 / x).rpow(a) = Option.some(Real.1 / u)
}

theorem rpow_rpow(x: Real, a: Real, b: Real, u: Real, v: Real) {
    x > Real.0 and x.rpow(a) = Option.some(u) and u.rpow(b) = Option.some(v)
    implies x.rpow(a * b) = Option.some(v)
}

theorem rpow_mul_val(x: Real, a: Real, b: Real, u: Real, v: Real, w: Real) {
    x > Real.0 and x.rpow(a) = Option.some(u) and x.rpow(b) = Option.some(v) and
    x.rpow(a + b) = Option.some(w)
    implies w = u * v
}

theorem rpow_neg(x: Real, a: Real, u: Real) {
    x > Real.0 and x.rpow(a) = Option.some(u)
    implies x.rpow(-a) = Option.some(Real.1 / u)
}

theorem rpow_sub(x: Real, a: Real, b: Real, u: Real, v: Real) {
    x > Real.0 and x.rpow(a) = Option.some(u) and x.rpow(b) = Option.some(v)
    implies x.rpow(a - b) = Option.some(u / v)
}

theorem rpow_of_one(a: Real) {
    (Real.1).rpow(a) = Option.some(Real.1)
}

theorem rpow_e(a: Real) {
    (Real.e).rpow(a) = Option.some(a.exp)
}

theorem rpow_e_nat(n: Nat) {
    (Real.e).rpow(from_nat[Real](n)) = Option.some((from_nat[Real](n)).exp)
}

theorem rpow_gt_one_strict(x: Real, a: Real, u: Real) {
    x > Real.1 and a > Real.0 and x.rpow(a) = Option.some(u)
    implies u > Real.1
}

theorem rpow_lt_one_strict(x: Real, a: Real, u: Real) {
    x > Real.0 and x < Real.1 and a > Real.0 and x.rpow(a) = Option.some(u)
    implies u < Real.1
}

theorem exp_upper_recip_one_plus_x(x: Real) {
    x >= Real.0 implies (-x).exp <= Real.1 / (Real.1 + x)
}

theorem e_sq_gt_four {
    Real.e * Real.e > two * two
}

theorem e_sq_lt_nine {
    Real.e * Real.e < three * three
}

theorem exp_two_gt_three {
    two.exp > three
}

theorem exp_two_gt_e {
    two.exp > Real.e
}

theorem e_gt_five_over_two {
    Real.e > Real.1 + Real.1 + Real.one_half
}

theorem log_value_three_lt_two {
    three.log.get_or_else(Real.0) < two
}

theorem log_value_three_gt_one {
    three.log.get_or_else(Real.0) > Real.1
}

theorem log_value_e_sq {
    (Real.e * Real.e).log.get_or_else(Real.0) = two
}

theorem log_value_two_gt_half {
    two.log.get_or_else(Real.0) > Real.one_half
}

theorem rpow_e_gt_one_strict(a: Real, u: Real) {
    a > Real.0 and (Real.e).rpow(a) = Option.some(u)
    implies u > Real.1
}

define rpow_root_value(base: Real, exponent: Real) -> Real {
    if base > Real.0 {
        (exponent * base.log.get_or_else(Real.0)).exp
    } else {
        Real.0
    }
}

theorem rpow_root_value_eq(base: Real, exponent: Real) {
    base >= Real.0 and exponent > Real.0 implies
        base.rpow(exponent) = Option.some(rpow_root_value(base, exponent))
}

theorem rpow_nonneg_base_value(base: Real, exponent: Real) {
    base >= Real.0 and exponent > Real.0 implies exists(value: Real) {
        base.rpow(exponent) = Option.some(value) and value >= Real.0
    }
}

define abs_pow_value(a: Nat -> Real, p: Real, i: Nat) -> Real {
    if a(i).abs > Real.0 {
        (p * (a(i).abs).log.get_or_else(Real.0)).exp
    } else {
        Real.0
    }
}

define abs_pow_sum(a: Nat -> Real, p: Real, n: Nat) -> Real {
    partial(abs_pow_value(a, p), n)
}

theorem abs_pow_value_nonneg(a: Nat -> Real, p: Real, i: Nat) {
    p > Real.0 implies abs_pow_value(a, p, i) >= Real.0
}

theorem abs_pow_value_rpow(a: Nat -> Real, p: Real, i: Nat) {
    p > Real.0 implies (a(i).abs).rpow(p) = Option.some(abs_pow_value(a, p, i))
}

theorem abs_pow_value_of_abs_zero(a: Nat -> Real, p: Real, i: Nat) {
    a(i).abs = Real.0 implies abs_pow_value(a, p, i) = Real.0
}

theorem abs_pow_value_zero_imp_abs_zero(a: Nat -> Real, p: Real, i: Nat) {
    p > Real.0 and abs_pow_value(a, p, i) = Real.0 implies a(i).abs = Real.0
}

theorem abs_pow_value_root(a: Nat -> Real, p: Real, i: Nat) {
    p > Real.0 implies
        (abs_pow_value(a, p, i)).rpow(Real.1 / p) = Option.some(a(i).abs)
}

theorem normalized_abs_pow_root_eq(a: Nat -> Real, p: Real, aa: Real, uu: Real, i: Nat) {
    p > Real.1 and aa > Real.0 and aa.rpow(Real.1 / p) = Option.some(uu)
    implies (abs_pow_value(a, p, i) / aa).rpow(Real.1 / p) = Option.some(a(i).abs / uu)
}

theorem recip_pos_of_gt_one(p: Real) {
    p > Real.1 implies Real.0 < Real.1 / p
}

theorem recip_lt_one_of_gt_one(p: Real) {
    p > Real.1 implies Real.1 / p < Real.1
}

theorem conjugate_recip(p: Real, q: Real) {
    Real.1 / p + Real.1 / q = Real.1 implies Real.1 - Real.1 / p = Real.1 / q
}

theorem exp_convex_on(a: Real, b: Real) {
    a < b implies convex_on(Real.exp, a, b)
}

theorem exp_convex_combine(x: Real, y: Real, p: Real, q: Real) {
    x > Real.0 and y > Real.0 and p > Real.1 and q > Real.1 and Real.1 / p + Real.1 / q = Real.1
    implies (x.log.get_or_else(Real.0) / p + y.log.get_or_else(Real.0) / q).exp <= x / p + y / q
}

theorem young_nonneg(x: Real, y: Real, p: Real, q: Real) {
    x >= Real.0 and y >= Real.0 and p > Real.1 and q > Real.1 and
        Real.1 / p + Real.1 / q = Real.1
    implies exists(uu: Real, vv: Real) {
        x.rpow(Real.1 / p) = Option.some(uu)
        and y.rpow(Real.1 / q) = Option.some(vv)
        and uu * vv <= x / p + y / q
    }
}

theorem abs_pow_sum_nonneg(a: Nat -> Real, p: Real, n: Nat) {
    p > Real.0 implies abs_pow_sum(a, p, n) >= Real.0
}

define norm_abs_pow(a: Nat -> Real, p: Real, aa: Real, i: Nat) -> Real {
    abs_pow_value(a, p, i) / aa
}

theorem norm_abs_pow_sum_eq_one(a: Nat -> Real, p: Real, n: Nat) {
    abs_pow_sum(a, p, n) > Real.0 implies
        partial(norm_abs_pow(a, p, abs_pow_sum(a, p, n)), n) = Real.1
}

define holder_rhs_first(a: Nat -> Real, p: Real, aa: Real, i: Nat) -> Real {
    (abs_pow_value(a, p, i) / aa) / p
}

define holder_rhs_second(b: Nat -> Real, q: Real, bb: Real, i: Nat) -> Real {
    (abs_pow_value(b, q, i) / bb) / q
}

define holder_rhs(a: Nat -> Real, b: Nat -> Real, p: Real, q: Real, aa: Real, bb: Real, i: Nat) -> Real {
    holder_rhs_first(a, p, aa, i) + holder_rhs_second(b, q, bb, i)
}

theorem holder_rhs_first_sum(a: Nat -> Real, n: Nat, p: Real) {
    p > Real.0 and abs_pow_sum(a, p, n) > Real.0 implies
        partial(holder_rhs_first(a, p, abs_pow_sum(a, p, n)), n) = Real.1 / p
}

theorem holder_rhs_second_sum(b: Nat -> Real, n: Nat, q: Real) {
    q > Real.0 and abs_pow_sum(b, q, n) > Real.0 implies
        partial(holder_rhs_second(b, q, abs_pow_sum(b, q, n)), n) = Real.1 / q
}

theorem holder_rhs_sum_eq_one(a: Nat -> Real, b: Nat -> Real, n: Nat, p: Real, q: Real) {
    p > Real.0 and q > Real.0 and Real.1 / p + Real.1 / q = Real.1
    and abs_pow_sum(a, p, n) > Real.0 and abs_pow_sum(b, q, n) > Real.0
    implies partial(holder_rhs(a, b, p, q, abs_pow_sum(a, p, n), abs_pow_sum(b, q, n)), n) = Real.1
}

define holder_lhs(a: Nat -> Real, b: Nat -> Real, uu: Real, vv: Real, i: Nat) -> Real {
    (a(i).abs / uu) * (b(i).abs / vv)
}

theorem holder_lhs_scaled(a: Nat -> Real, b: Nat -> Real, n: Nat, uu: Real, vv: Real) {
    uu > Real.0 and vv > Real.0
    implies partial(holder_lhs(a, b, uu, vv), n) = (Real.1 / (uu * vv)) * partial(abs_product(a, b), n)
}

theorem abs_product_sum_zero_of_abs_pow_sum_zero(a: Nat -> Real, b: Nat -> Real, n: Nat, p: Real) {
    p > Real.0 and abs_pow_sum(a, p, n) = Real.0 implies partial(abs_product(a, b), n) = Real.0
}

theorem rpow_root_zero_of_sum_zero(a: Nat -> Real, n: Nat, p: Real, uu: Real) {
    p > Real.0 and abs_pow_sum(a, p, n) = Real.0 and (abs_pow_sum(a, p, n)).rpow(Real.1 / p) = Option.some(uu)
    implies uu = Real.0
}

theorem finite_holder(a: Nat -> Real, b: Nat -> Real, n: Nat, p: Real, q: Real, uu: Real, vv: Real) {
    p > Real.1 and q > Real.1 and Real.1 / p + Real.1 / q = Real.1
    and (abs_pow_sum(a, p, n)).rpow(Real.1 / p) = Option.some(uu)
    and (abs_pow_sum(b, q, n)).rpow(Real.1 / q) = Option.some(vv)
    implies partial(abs_product(a, b), n) <= uu * vv
}

theorem finite_holder_exists(a: Nat -> Real, b: Nat -> Real, n: Nat, p: Real, q: Real) {
    p > Real.1 and q > Real.1 and Real.1 / p + Real.1 / q = Real.1
    implies exists(uu: Real, vv: Real) {
        (abs_pow_sum(a, p, n)).rpow(Real.1 / p) = Option.some(uu)
        and (abs_pow_sum(b, q, n)).rpow(Real.1 / q) = Option.some(vv)
        and partial(abs_product(a, b), n) <= uu * vv
    }
}

define conjugate_exponent(p: Real) -> Real {
    p / (p - Real.1)
}

theorem div_add_same_denom(a: Real, b: Real, p: Real) {
    p != Real.0 implies a / p + b / p = (a + b) / p
}

theorem conjugate_exponent_recip_value(p: Real) {
    p > Real.1 implies Real.1 / conjugate_exponent(p) = (p - Real.1) / p
}

theorem conjugate_exponent_recip(p: Real) {
    p > Real.1 implies Real.1 / p + Real.1 / conjugate_exponent(p) = Real.1
}

theorem conjugate_exponent_gt_one(p: Real) {
    p > Real.1 implies conjugate_exponent(p) > Real.1
}

theorem conjugate_exponent_pow(p: Real) {
    p > Real.1 implies (p - Real.1) * conjugate_exponent(p) = p
}

theorem rpow_value_nonneg(base: Real, exponent: Real, value: Real) {
    base >= Real.0 and exponent > Real.0 and base.rpow(exponent) = Option.some(value)
    implies value >= Real.0
}

theorem rpow_value_pos(base: Real, exponent: Real, value: Real) {
    base > Real.0 and exponent > Real.0 and base.rpow(exponent) = Option.some(value)
    implies value > Real.0
}

define abs_sum_pow_minus_one(a: Nat -> Real, b: Nat -> Real, p: Real, i: Nat) -> Real {
    abs_pow_value(add_fn(a, b), p - Real.1, i)
}

define abs_mul_conjugate(a: Nat -> Real, b: Nat -> Real, p: Real, i: Nat) -> Real {
    a(i).abs * abs_sum_pow_minus_one(a, b, p, i)
}

define abs_triangle_expand(a: Nat -> Real, b: Nat -> Real, p: Real, i: Nat) -> Real {
    (a(i).abs + b(i).abs) * abs_sum_pow_minus_one(a, b, p, i)
}

define abs_sum_triangle_term(a: Nat -> Real, b: Nat -> Real, p: Real, i: Nat) -> Real {
    (a(i) + b(i)).abs * abs_sum_pow_minus_one(a, b, p, i)
}

theorem abs_pow_value_split(a: Nat -> Real, p: Real, i: Nat) {
    p > Real.1 implies abs_pow_value(a, p, i) = a(i).abs * abs_pow_value(a, p - Real.1, i)
}

theorem abs_triangle_term_le(a: Nat -> Real, b: Nat -> Real, p: Real, i: Nat) {
    p > Real.1 implies abs_sum_triangle_term(a, b, p, i) <= abs_triangle_expand(a, b, p, i)
}

theorem abs_triangle_expand_add(a: Nat -> Real, b: Nat -> Real, p: Real, i: Nat) {
    abs_triangle_expand(a, b, p, i) = abs_mul_conjugate(a, b, p, i) + abs_mul_conjugate(b, a, p, i)
}

theorem abs_product_conjugate_eq(a: Nat -> Real, b: Nat -> Real, p: Real, i: Nat) {
    p > Real.1 implies abs_product(a, abs_sum_pow_minus_one(a, b, p), i) = abs_mul_conjugate(a, b, p, i)
}

theorem abs_pow_value_pow_pow(a: Nat -> Real, b: Nat -> Real, p: Real, q: Real, i: Nat) {
    p > Real.1 and q > Real.0 and (p - Real.1) * q = p
    implies abs_pow_value(abs_sum_pow_minus_one(a, b, p), q, i) = abs_pow_value(add_fn(a, b), p, i)
}

theorem abs_pow_sum_c_eq_w(a: Nat -> Real, b: Nat -> Real, n: Nat, p: Real, q: Real) {
    p > Real.1 and q > Real.0 and (p - Real.1) * q = p
    implies abs_pow_sum(abs_sum_pow_minus_one(a, b, p), q, n) = abs_pow_sum(add_fn(a, b), p, n)
}

theorem holder_lhs_conjugate_sum(a: Nat -> Real, b: Nat -> Real, n: Nat, p: Real) {
    p > Real.1 implies
        partial(abs_product(a, abs_sum_pow_minus_one(a, b, p)), n) = partial(abs_mul_conjugate(a, b, p), n)
}

theorem finite_minkowski(a: Nat -> Real, b: Nat -> Real, n: Nat, p: Real, uu: Real, vv: Real, ww: Real, ww_q: Real) {
    p > Real.1
    and (abs_pow_sum(a, p, n)).rpow(Real.1 / p) = Option.some(uu)
    and (abs_pow_sum(b, p, n)).rpow(Real.1 / p) = Option.some(vv)
    and (abs_pow_sum(add_fn(a, b), p, n)).rpow(Real.1 / p) = Option.some(ww)
    and (abs_pow_sum(add_fn(a, b), p, n)).rpow(Real.1 / conjugate_exponent(p)) = Option.some(ww_q)
    implies ww <= uu + vv
}

theorem finite_minkowski_exists(a: Nat -> Real, b: Nat -> Real, n: Nat, p: Real) {
    p > Real.1 implies exists(uu: Real, vv: Real, ww: Real) {
        (abs_pow_sum(a, p, n)).rpow(Real.1 / p) = Option.some(uu)
        and (abs_pow_sum(b, p, n)).rpow(Real.1 / p) = Option.some(vv)
        and (abs_pow_sum(add_fn(a, b), p, n)).rpow(Real.1 / p) = Option.some(ww)
        and ww <= uu + vv
    }
}

define recip_fn(f: Nat -> Real, i: Nat) -> Real {
    Real.1 / f(i)
}

define finite_harmonic_mean(f: Nat -> Real, n: Nat) -> Real {
    from_nat[Real](n) / partial(recip_fn(f), n)
}

theorem positive_on_recip(f: Nat -> Real, n: Nat) {
    positive_on(f, n) implies positive_on(recip_fn(f), n)
}

theorem finite_real_product_recip(f: Nat -> Real, n: Nat) {
    positive_on(f, n) implies finite_real_product(recip_fn(f), n) = Real.1 / finite_real_product(f, n)
}

theorem recip_geometric_mean(f: Nat -> Real, n: Nat, g: Real) {
    n != Nat.0 and positive_on(f, n) and (finite_real_product(f, n)).rpow(Real.1 / from_nat[Real](n)) = Option.some(g)
    implies (finite_real_product(recip_fn(f), n)).rpow(Real.1 / from_nat[Real](n)) = Option.some(Real.1 / g)
}

theorem harmonic_mean_eq_recip_am(f: Nat -> Real, n: Nat) {
    n != Nat.0 and positive_on(f, n) implies
        finite_harmonic_mean(f, n) = Real.1 / finite_real_mean(recip_fn(f), n)
}

theorem harmonic_mean_le_geometric_mean(f: Nat -> Real, n: Nat) {
    n != Nat.0 and positive_on(f, n) implies exists(g: Real) {
        (finite_real_product(f, n)).rpow(Real.1 / from_nat[Real](n)) = Option.some(g)
        and finite_harmonic_mean(f, n) <= g
    }
}

theorem harmonic_mean_le_arithmetic_mean(f: Nat -> Real, n: Nat) {
    n != Nat.0 and positive_on(f, n) implies exists(a: Real) {
        a = finite_real_mean(f, n)
        and finite_harmonic_mean(f, n) <= a
    }
}

theorem finite_holder_p2(a: Nat -> Real, b: Nat -> Real, n: Nat) {
    exists(uu: Real, vv: Real) {
        (abs_pow_sum(a, Real.1 + Real.1, n)).rpow(Real.1 / (Real.1 + Real.1)) = Option.some(uu)
        and (abs_pow_sum(b, Real.1 + Real.1, n)).rpow(Real.1 / (Real.1 + Real.1)) = Option.some(vv)
        and partial(abs_product(a, b), n) <= uu * vv
    }
}

theorem rpow_ge_one_of_base_ge_one_exp_nonneg(base: Real, exponent: Real) {
    base >= Real.1 and exponent >= Real.0 implies exists(value: Real) {
        base.rpow(exponent) = Option.some(value) and value >= Real.1
    }
}

theorem rpow_le_one_of_base_ge_one_exp_nonpos(base: Real, exponent: Real) {
    base >= Real.1 and exponent <= Real.0 implies exists(value: Real) {
        base.rpow(exponent) = Option.some(value) and value <= Real.1
    }
}

theorem rpow_le_one_of_pos_base_le_one_exp_nonneg(base: Real, exponent: Real) {
    base > Real.0 and base <= Real.1 and exponent >= Real.0 implies exists(value: Real) {
        base.rpow(exponent) = Option.some(value) and value <= Real.1
    }
}

theorem rpow_ge_one_of_pos_base_le_one_exp_nonpos(base: Real, exponent: Real) {
    base > Real.0 and base <= Real.1 and exponent <= Real.0 implies exists(value: Real) {
        base.rpow(exponent) = Option.some(value) and value >= Real.1
    }
}

theorem rpow_exponent_monotone_base_ge_one(base: Real, a: Real, b: Real, va: Real, vb: Real) {
    base >= Real.1 and a <= b and base.rpow(a) = Option.some(va) and base.rpow(b) = Option.some(vb)
    implies va <= vb
}

theorem div_lt_one(a: Real, b: Real) {
    a < b and b > Real.0 implies a / b < Real.1
}

theorem div_nonneg_of_nonneg(a: Real, b: Real) {
    Real.0 <= a and b > Real.0 implies Real.0 <= a / b
}

theorem sqrt_zero {
    Real.0.sqrt = Option.some(Real.0)
}

theorem sqrt_pos(x: Real) {
    x > Real.0 implies exists(y: Real) {
        x.sqrt = Option.some(y) and y > Real.0
    }
}

theorem sqrt_mul_self(x: Real) {
    x >= Real.0 implies exists(y: Real) {
        x.sqrt = Option.some(y) and y * y = x
    }
}

theorem sqrt_square_of_nonneg(x: Real) {
    x >= Real.0 implies (x * x).sqrt = Option.some(x)
}

theorem sqrt_unique_nonneg(x: Real, y: Real) {
    x >= Real.0 and y >= Real.0 and y * y = x implies x.sqrt = Option.some(y)
}

theorem sqrt_one {
    Real.1.sqrt = Option.some(Real.1)
}

theorem sqrt_abs_square(x: Real) {
    (x.abs * x.abs).sqrt = Option.some(x.abs)
}

theorem sqrt_square_eq_abs(x: Real) {
    (x * x).sqrt = Option.some(x.abs)
}

theorem sqrt_abs_mul_abs_eq_abs(x: Real) {
    (x.abs * x.abs).sqrt = Option.some(x.abs)
}

theorem one_half_mul_double(x: Real) {
    Real.one_half * (x + x) = x
}

theorem one_half_eq_one_div_two {
    Real.one_half = Real.1 / (Real.1 + Real.1)
}

theorem double_le_imp_le_half(x: Real, y: Real) {
    x + x <= y implies x <= Real.one_half * y
}

theorem sqrt_value_nonneg(x: Real, y: Real) {
    x.sqrt = Option.some(y) implies y >= Real.0
}

theorem sqrt_value_mul_self(x: Real, y: Real) {
    x >= Real.0 and x.sqrt = Option.some(y) implies y * y = x
}

theorem sqrt_mul(a: Real, b: Real, x: Real, y: Real) {
    a >= Real.0 and b >= Real.0 and a.sqrt = Option.some(x) and b.sqrt = Option.some(y)
    implies (a * b).sqrt = Option.some(x * y)
}

theorem sqrt_monotone(a: Real, b: Real, x: Real, y: Real) {
    Real.0 <= a and a <= b and a.sqrt = Option.some(x) and b.sqrt = Option.some(y)
    implies x <= y
}

theorem sqrt_mul_le_arithmetic_mean(a: Real, b: Real) {
    a >= Real.0 and b >= Real.0 implies exists(g: Real) {
        (a * b).sqrt = Option.some(g) and g <= Real.one_half * (a + b)
    }
}

theorem sqrt_mul_le_arithmetic_mean_div(a: Real, b: Real) {
    a >= Real.0 and b >= Real.0 implies exists(g: Real) {
        (a * b).sqrt = Option.some(g) and g <= (a + b) / (Real.1 + Real.1)
    }
}

theorem sqrt_mul_eq_arithmetic_mean_imp_eq(a: Real, b: Real) {
    a > Real.0 and b > Real.0 and (a * b).sqrt = Option.some((a + b) / (Real.1 + Real.1))
    implies a = b
}

theorem taylor_order_one(f: Real -> Real, df: Real -> Real, a: Real, b: Real) {
    continuous(f) and a < b and is_derivative_fn(f, df)
    implies exists(c: Real) {
        a < c and c < b and f(b) = f(a) + df(c) * (b - a)
    }
}

theorem taylor2_aux_eq_pointwise(f: Real -> Real, df: Real -> Real, a: Real, b: Real) {
    taylor2_aux(f, df, a, b) = pointwise_add(
        pointwise_mul(constant[Real, Real](square_real(b - a)),
            pointwise_add(f, pointwise_neg(affine_real(df(a), f(a) - df(a) * a)))),
        pointwise_neg(pointwise_mul(constant[Real, Real](taylor2_delta(f, df, a, b)),
            compose(square_real, affine_real(Real.1, -a)))))
}

theorem taylor2_aux_derivative_eq_pointwise(f: Real -> Real, df: Real -> Real, a: Real, b: Real) {
    taylor2_aux_derivative(f, df, a, b) = pointwise_add(
        pointwise_mul(constant[Real, Real](square_real(b - a)),
            pointwise_add(df, pointwise_neg(constant[Real, Real](df(a))))),
        pointwise_neg(pointwise_mul(constant[Real, Real](taylor2_delta(f, df, a, b) * taylor_two),
            affine_real(Real.1, -a))))
}

theorem taylor2_aux_continuous_on_closed(f: Real -> Real, df: Real -> Real, a: Real, b: Real, u: Real, v: Real) {
    is_derivative_fn(f, df)
    implies continuous_on_closed(taylor2_aux(f, df, a, b), u, v)
}

theorem is_derivative_fn_imp_is_derivative_on_open(
    f: Real -> Real, df: Real -> Real, a: Real, b: Real
) {
    is_derivative_fn(f, df) implies is_derivative_on_open(f, df, a, b)
}

theorem taylor2_sq_has_derivative_at(a: Real, x0: Real) {
    has_derivative_at(compose(square_real, affine_real(Real.1, -a)), x0, taylor_two * (x0 - a))
}

theorem taylor2_aux_derivative_continuous_on_closed(f: Real -> Real, df: Real -> Real, ddf: Real -> Real, a: Real, b: Real, u: Real, v: Real) {
    is_derivative_fn(df, ddf)
    implies continuous_on_closed(taylor2_aux_derivative(f, df, a, b), u, v)
}

theorem taylor2_aux_is_derivative_fn(f: Real -> Real, df: Real -> Real, a: Real, b: Real) {
    is_derivative_fn(f, df)
    implies is_derivative_fn(taylor2_aux(f, df, a, b), taylor2_aux_derivative(f, df, a, b))
}

theorem taylor2_aux_derivative_is_derivative_fn(f: Real -> Real, df: Real -> Real, ddf: Real -> Real, a: Real, b: Real) {
    is_derivative_fn(df, ddf)
    implies is_derivative_fn(taylor2_aux_derivative(f, df, a, b),
        taylor2_aux_second_derivative(f, df, ddf, a, b))
}

theorem taylor2_conclusion_from_second_derivative(f: Real -> Real, df: Real -> Real, ddf: Real -> Real, a: Real, b: Real, c: Real) {
    taylor2_aux_second_derivative(f, df, ddf, a, b, c) = Real.0
    implies f(b) = f(a) + df(a) * (b - a) + (ddf(c) / taylor_two) * (b - a) * (b - a)
}

theorem taylor_order_two(f: Real -> Real, df: Real -> Real, ddf: Real -> Real, a: Real, b: Real) {
    a < b and is_derivative_fn(f, df) and is_derivative_fn(df, ddf)
    implies exists(c: Real) {
        a < c and c < b and
        f(b) = f(a) + df(a) * (b - a) + (ddf(c) / taylor_two) * (b - a) * (b - a)
    }
}

define newton_step(f: Real -> Real, fp: Real -> Real, x: Real) -> Real {
    x - f(x) / fp(x)
}

define newton_seq(f: Real -> Real, fp: Real -> Real, x0: Real, n: Nat) -> Real {
    match n {
        Nat.zero {
            x0
        }
        Nat.suc(m) {
            newton_step(f, fp, newton_seq(f, fp, x0, m))
        }
    }
}

theorem newton_seq_zero(f: Real -> Real, fp: Real -> Real, x0: Real) {
    newton_seq(f, fp, x0, Nat.0) = x0
}

theorem newton_seq_suc(f: Real -> Real, fp: Real -> Real, x0: Real, n: Nat) {
    newton_seq(f, fp, x0, n.suc) = newton_step(f, fp, newton_seq(f, fp, x0, n))
}

theorem newton_step_root_fixed_point(f: Real -> Real, fp: Real -> Real, xstar: Real) {
    f(xstar) = Real.0 and fp(xstar) != Real.0 implies
        newton_step(f, fp, xstar) = xstar
}

theorem newton_seq_root_constant(f: Real -> Real, fp: Real -> Real, xstar: Real) {
    f(xstar) = Real.0 and fp(xstar) != Real.0 implies
        forall(n: Nat) { newton_seq(f, fp, xstar, n) = xstar }
}

theorem newton_error_quadratic(f: Real -> Real, fp: Real -> Real, ddf: Real -> Real, x: Real, xstar: Real) {
    x < xstar and f(xstar) = Real.0 and fp(x) != Real.0 and
    is_derivative_fn(f, fp) and is_derivative_fn(fp, ddf)
    implies exists(c: Real) {
        x < c and c < xstar and
        newton_step(f, fp, x) - xstar =
            ((ddf(c) / taylor_two) * (xstar - x) * (xstar - x)) / fp(x)
    }
}

theorem newton_seq_error_quadratic(f: Real -> Real, fp: Real -> Real, ddf: Real -> Real, x0: Real, xstar: Real, n: Nat) {
    newton_seq(f, fp, x0, n) < xstar and f(xstar) = Real.0 and
    fp(newton_seq(f, fp, x0, n)) != Real.0 and
    is_derivative_fn(f, fp) and is_derivative_fn(fp, ddf)
    implies exists(c: Real) {
        newton_seq(f, fp, x0, n) < c and c < xstar and
        newton_seq(f, fp, x0, n.suc) - xstar =
            ((ddf(c) / taylor_two) * (xstar - newton_seq(f, fp, x0, n)) *
                (xstar - newton_seq(f, fp, x0, n))) /
                fp(newton_seq(f, fp, x0, n))
    }
}

theorem newton_error_bounded(f: Real -> Real, fp: Real -> Real, ddf: Real -> Real, x: Real, xstar: Real, m: Real, bigm: Real) {
    x < xstar and f(xstar) = Real.0 and fp(x) != Real.0 and
    is_derivative_fn(f, fp) and is_derivative_fn(fp, ddf) and
    m.is_positive and m <= fp(x).abs and
    (forall(z: Real) { x <= z and z <= xstar implies ddf(z).abs <= bigm })
    implies (newton_step(f, fp, x) - xstar).abs <=
        ((bigm / taylor_two) * (xstar - x) * (xstar - x)) / m
}

theorem from_nat_two_real {
    from_nat[Real](Nat.2) = taylor_two
}

theorem from_nat_three_real {
    from_nat[Real](Nat.3) = taylor_three
}

theorem from_nat_six_real {
    from_nat[Real](Nat.6) = taylor_six
}

define is_derivative_chain(f: Real -> Real, dfs: Nat -> Real -> Real, n: Nat) -> Bool {
    dfs(Nat.0) = f and forall(k: Nat) {
        k < n implies is_derivative_fn(dfs(k), dfs(k.suc))
    }
}

define taylor_term(f: Real -> Real, dfs: Nat -> Real -> Real, a: Real, x: Real, k: Nat) -> Real {
    (iterated_derivative(f, dfs, k, a) / from_nat[Real](k.factorial)) * (x - a).pow(k)
}

define taylor_poly(f: Real -> Real, dfs: Nat -> Real -> Real, a: Real, x: Real, n: Nat) -> Real {
    partial(taylor_term(f, dfs, a, x), n.suc)
}

define taylor_remainder(f: Real -> Real, dfs: Nat -> Real -> Real, a: Real, x: Real, c: Real, n: Nat) -> Real {
    (iterated_derivative(f, dfs, n.suc, c) / from_nat[Real](n.suc.factorial)) * (x - a).pow(n.suc)
}

theorem from_nat_factorial_two_real {
    from_nat[Real](Nat.2.factorial) = taylor_two
}

theorem from_nat_factorial_three_real {
    from_nat[Real](Nat.3.factorial) = taylor_six
}

theorem from_nat_factorial_one_real {
    from_nat[Real](Nat.1.factorial) = Real.1
}

theorem from_nat_factorial_zero_real {
    from_nat[Real](Nat.0.factorial) = Real.1
}

theorem real_div_one(a: Real) {
    a / Real.1 = a
}

theorem real_mul_inverse_comm(a: Real, b: Real) {
    a != Real.0 implies (a * b) * a.inverse = b
}

theorem taylor_general_zero(f: Real -> Real, df: Real -> Real, a: Real, b: Real) {
    a < b and is_derivative_fn(f, df)
    implies exists(c: Real) {
        a < c and c < b and
        f(b) = taylor_poly(f, taylor_chain1(f, df), a, b, Nat.0) +
            taylor_remainder(f, taylor_chain1(f, df), a, b, c, Nat.0)
    }
}

theorem taylor_general_one(f: Real -> Real, df: Real -> Real, ddf: Real -> Real, a: Real, b: Real) {
    a < b and is_derivative_fn(f, df) and is_derivative_fn(df, ddf)
    implies exists(c: Real) {
        a < c and c < b and
        f(b) = taylor_poly(f, taylor_chain2(f, df, ddf), a, b, Nat.1) +
            taylor_remainder(f, taylor_chain2(f, df, ddf), a, b, c, Nat.1)
    }
}

define taylor3_remainder_coeff(f: Real -> Real, df: Real -> Real, ddf: Real -> Real, a: Real, b: Real) -> Real {
    taylor3_doubled_delta(f, df, ddf, a, b) / (b - a).pow(Nat.3)
}

define taylor3_aux(f: Real -> Real, df: Real -> Real, ddf: Real -> Real, a: Real, b: Real, x: Real) -> Real {
    taylor_two * f(b) - taylor_two * f(x) - taylor_two * df(x) * (b - x) -
        ddf(x) * (b - x).pow(Nat.2) -
        taylor3_remainder_coeff(f, df, ddf, a, b) * (b - x).pow(Nat.3)
}

define taylor3_aux_derivative(f: Real -> Real, df: Real -> Real, ddf: Real -> Real, dddf: Real -> Real, a: Real, b: Real, x: Real) -> Real {
    (b - x).pow(Nat.2) * (taylor_three * taylor3_remainder_coeff(f, df, ddf, a, b) - dddf(x))
}

define taylor3_aux_pointwise(f: Real -> Real, df: Real -> Real, ddf: Real -> Real, a: Real, b: Real) -> Real -> Real {
    pointwise_add(
        pointwise_add(
            pointwise_add(
                pointwise_add(constant[Real, Real](taylor_two * f(b)),
                    pointwise_neg(pointwise_mul(constant[Real, Real](taylor_two), f))),
                pointwise_neg(pointwise_mul(
                    pointwise_mul(constant[Real, Real](taylor_two), df),
                    affine_real(-Real.1, b)))),
            pointwise_neg(pointwise_mul(ddf,
                compose(square_real, affine_real(-Real.1, b))))),
        pointwise_neg(pointwise_mul(
            constant[Real, Real](taylor3_remainder_coeff(f, df, ddf, a, b)),
            compose(cube_real, affine_real(-Real.1, b)))))
}

theorem taylor3_aux_eq_pointwise(f: Real -> Real, df: Real -> Real, ddf: Real -> Real, a: Real, b: Real) {
    taylor3_aux(f, df, ddf, a, b) = taylor3_aux_pointwise(f, df, ddf, a, b)
}

theorem taylor3_aux_at_a_zero(f: Real -> Real, df: Real -> Real, ddf: Real -> Real, a: Real, b: Real) {
    a < b implies taylor3_aux(f, df, ddf, a, b, a) = Real.0
}

theorem taylor3_aux_at_b_zero(f: Real -> Real, df: Real -> Real, ddf: Real -> Real, a: Real, b: Real) {
    taylor3_aux(f, df, ddf, a, b, b) = Real.0
}

theorem taylor3_aux_endpoints_equal(f: Real -> Real, df: Real -> Real, ddf: Real -> Real, a: Real, b: Real) {
    a < b implies taylor3_aux(f, df, ddf, a, b, a) = taylor3_aux(f, df, ddf, a, b, b)
}

theorem taylor3_aux_continuous_on_closed(f: Real -> Real, df: Real -> Real, ddf: Real -> Real, dddf: Real -> Real, a: Real, b: Real, u: Real, v: Real) {
    is_derivative_fn(f, df) and is_derivative_fn(df, ddf) and is_derivative_fn(ddf, dddf)
    implies continuous_on_closed(taylor3_aux(f, df, ddf, a, b), u, v)
}

theorem taylor3_sq_has_derivative_at(b: Real, x0: Real) {
    has_derivative_at(compose(square_real, affine_real(-Real.1, b)), x0,
        -taylor_two * (b - x0))
}

theorem taylor3_cube_has_derivative_at(b: Real, x0: Real) {
    has_derivative_at(compose(cube_real, affine_real(-Real.1, b)), x0,
        -taylor_three * (b - x0).pow(Nat.2))
}

theorem taylor3_aux_is_derivative_fn(f: Real -> Real, df: Real -> Real, ddf: Real -> Real, dddf: Real -> Real, a: Real, b: Real) {
    is_derivative_fn(f, df) and is_derivative_fn(df, ddf) and is_derivative_fn(ddf, dddf)
    implies is_derivative_fn(taylor3_aux(f, df, ddf, a, b),
        taylor3_aux_derivative(f, df, ddf, dddf, a, b))
}

theorem taylor3_div_two_chain(a: Real, b: Real, c: Real, d: Real) {
    (taylor_two * a - taylor_two * b - taylor_two * c - d) / taylor_two =
        a - b - c - d / taylor_two
}

theorem taylor3_div_six_prod(x: Real, y: Real) {
    ((x / taylor_three) * y) / taylor_two = (x / taylor_six) * y
}

theorem taylor3_conclusion_from_derivative(f: Real -> Real, df: Real -> Real, ddf: Real -> Real, dddf: Real -> Real, a: Real, b: Real, c: Real) {
    a < c and c < b and taylor3_aux_derivative(f, df, ddf, dddf, a, b, c) = Real.0
    implies f(b) = f(a) + df(a) * (b - a) + ddf(a) * (b - a).pow(Nat.2) / taylor_two +
        (dddf(c) / taylor_six) * (b - a).pow(Nat.3)
}

theorem taylor_general_two(f: Real -> Real, df: Real -> Real, ddf: Real -> Real, dddf: Real -> Real, a: Real, b: Real) {
    a < b and is_derivative_fn(f, df) and is_derivative_fn(df, ddf) and is_derivative_fn(ddf, dddf)
    implies exists(c: Real) {
        a < c and c < b and
        f(b) = taylor_poly(f, taylor_chain3(f, df, ddf, dddf), a, b, Nat.2) +
            taylor_remainder(f, taylor_chain3(f, df, ddf, dddf), a, b, c, Nat.2)
    }
}

theorem from_nat_four_real {
    from_nat[Real](Nat.4) = taylor_four
}

theorem from_nat_24_real {
    from_nat[Real](Nat.4 * Nat.6) = taylor_24
}

theorem from_nat_factorial_four_real {
    from_nat[Real](Nat.4.factorial) = taylor_24
}

define taylor4_remainder_coeff(f: Real -> Real, df: Real -> Real, ddf: Real -> Real, dddf: Real -> Real, a: Real, b: Real) -> Real {
    taylor4_doubled_delta(f, df, ddf, dddf, a, b) / (b - a).pow(Nat.4)
}

define taylor4_aux(f: Real -> Real, df: Real -> Real, ddf: Real -> Real, dddf: Real -> Real, a: Real, b: Real, x: Real) -> Real {
    taylor_six * f(b) - taylor_six * f(x) - taylor_six * df(x) * (b - x) -
        taylor_three * ddf(x) * (b - x).pow(Nat.2) - dddf(x) * (b - x).pow(Nat.3) -
        taylor4_remainder_coeff(f, df, ddf, dddf, a, b) * (b - x).pow(Nat.4)
}

define taylor4_aux_derivative(f: Real -> Real, df: Real -> Real, ddf: Real -> Real, dddf: Real -> Real, dddd: Real -> Real, a: Real, b: Real, x: Real) -> Real {
    (b - x).pow(Nat.3) * (taylor_four * taylor4_remainder_coeff(f, df, ddf, dddf, a, b) - dddd(x))
}

theorem taylor4_quartic_has_derivative_at(b: Real, x0: Real) {
    has_derivative_at(pointwise_mul(compose(square_real, affine_real(-Real.1, b)),
        compose(square_real, affine_real(-Real.1, b))), x0,
        -taylor_four * (b - x0).pow(Nat.3))
}

define taylor4_aux_left(f: Real -> Real, df: Real -> Real, a: Real, b: Real) -> Real -> Real {
    pointwise_add(
        pointwise_add(constant[Real, Real](taylor_six * f(b)),
            pointwise_neg(pointwise_mul(constant[Real, Real](taylor_six), f))),
        pointwise_neg(pointwise_mul(pointwise_mul(constant[Real, Real](taylor_six), df),
            affine_real(-Real.1, b))))
}

define taylor4_aux_right(f: Real -> Real, df: Real -> Real, ddf: Real -> Real, dddf: Real -> Real, a: Real, b: Real) -> Real -> Real {
    pointwise_add(
        pointwise_add(
            pointwise_neg(pointwise_mul(pointwise_mul(constant[Real, Real](taylor_three), ddf),
                compose(square_real, affine_real(-Real.1, b)))),
            pointwise_neg(pointwise_mul(dddf, compose(cube_real, affine_real(-Real.1, b))))),
        pointwise_neg(pointwise_mul(constant[Real, Real](taylor4_remainder_coeff(f, df, ddf, dddf, a, b)),
            pointwise_mul(compose(square_real, affine_real(-Real.1, b)),
                compose(square_real, affine_real(-Real.1, b))))))
}

define taylor4_aux_pointwise(f: Real -> Real, df: Real -> Real, ddf: Real -> Real, dddf: Real -> Real, a: Real, b: Real) -> Real -> Real {
    pointwise_add(taylor4_aux_left(f, df, a, b), taylor4_aux_right(f, df, ddf, dddf, a, b))
}

theorem taylor4_aux_eq_pointwise(f: Real -> Real, df: Real -> Real, ddf: Real -> Real, dddf: Real -> Real, a: Real, b: Real) {
    taylor4_aux(f, df, ddf, dddf, a, b) = taylor4_aux_pointwise(f, df, ddf, dddf, a, b)
}

theorem taylor4_aux_continuous_on_closed(f: Real -> Real, df: Real -> Real, ddf: Real -> Real, dddf: Real -> Real, dddd: Real -> Real, a: Real, b: Real, u: Real, v: Real) {
    is_derivative_fn(f, df) and is_derivative_fn(df, ddf) and is_derivative_fn(ddf, dddf) and is_derivative_fn(dddf, dddd)
    implies continuous_on_closed(taylor4_aux(f, df, ddf, dddf, a, b), u, v)
}

theorem taylor4_aux_at_a_zero(f: Real -> Real, df: Real -> Real, ddf: Real -> Real, dddf: Real -> Real, a: Real, b: Real) {
    a < b implies taylor4_aux(f, df, ddf, dddf, a, b, a) = Real.0
}

theorem taylor4_aux_at_b_zero(f: Real -> Real, df: Real -> Real, ddf: Real -> Real, dddf: Real -> Real, a: Real, b: Real) {
    taylor4_aux(f, df, ddf, dddf, a, b, b) = Real.0
}

theorem taylor4_aux_endpoints_equal(f: Real -> Real, df: Real -> Real, ddf: Real -> Real, dddf: Real -> Real, a: Real, b: Real) {
    a < b implies taylor4_aux(f, df, ddf, dddf, a, b, a) = taylor4_aux(f, df, ddf, dddf, a, b, b)
}

theorem taylor4_aux_is_derivative_fn(f: Real -> Real, df: Real -> Real, ddf: Real -> Real, dddf: Real -> Real, dddd: Real -> Real, a: Real, b: Real) {
    is_derivative_fn(f, df) and is_derivative_fn(df, ddf) and is_derivative_fn(ddf, dddf) and is_derivative_fn(dddf, dddd)
    implies is_derivative_fn(taylor4_aux(f, df, ddf, dddf, a, b),
        taylor4_aux_derivative(f, df, ddf, dddf, dddd, a, b))
}

theorem taylor4_div_six_chain(a: Real, b: Real, c: Real, d: Real, e: Real) {
    (taylor_six * a - taylor_six * b - taylor_six * c - taylor_three * d - e) / taylor_six =
        a - b - c - d / taylor_two - e / taylor_six
}

theorem taylor4_div_24_prod(x: Real, y: Real) {
    ((x / taylor_four) * y) / taylor_six = (x / taylor_24) * y
}

theorem taylor4_conclusion_from_derivative(f: Real -> Real, df: Real -> Real, ddf: Real -> Real, dddf: Real -> Real, dddd: Real -> Real, a: Real, b: Real, c: Real) {
    a < c and c < b and taylor4_aux_derivative(f, df, ddf, dddf, dddd, a, b, c) = Real.0
    implies f(b) = f(a) + df(a) * (b - a) + ddf(a) * (b - a).pow(Nat.2) / taylor_two +
        dddf(a) * (b - a).pow(Nat.3) / taylor_six + (dddd(c) / taylor_24) * (b - a).pow(Nat.4)
}

theorem taylor_general_three(f: Real -> Real, df: Real -> Real, ddf: Real -> Real, dddf: Real -> Real, dddd: Real -> Real, a: Real, b: Real) {
    a < b and is_derivative_fn(f, df) and is_derivative_fn(df, ddf) and is_derivative_fn(ddf, dddf) and is_derivative_fn(dddf, dddd)
    implies exists(c: Real) {
        a < c and c < b and
        f(b) = taylor_poly(f, taylor_chain4(f, df, ddf, dddf, dddd), a, b, Nat.3) +
            taylor_remainder(f, taylor_chain4(f, df, ddf, dddf, dddd), a, b, c, Nat.3)
    }
}

define pow_fn(k: Nat) -> Real -> Real {
    match k {
        Nat.zero { constant[Real, Real](Real.1) }
        Nat.suc(m) { pointwise_mul(identity_fn[Real], pow_fn(m)) }
    }
}

theorem pow_fn_zero_eq {
    pow_fn(Nat.0) = constant[Real, Real](Real.1)
}

theorem pow_fn_suc_eq(k: Nat) {
    pow_fn(k.suc) = pointwise_mul(identity_fn[Real], pow_fn(k))
}

theorem pow_fn_value(n: Nat, z: Real) {
    pow_fn(n, z) = z.pow(n)
}

theorem pow_fn_has_derivative_at_suc(q: Nat, x0: Real) {
    has_derivative_at(pow_fn(q.suc), x0, from_nat[Real](q.suc) * x0.pow(q))
}

define taylor_shift_pow(b: Real, k: Nat) -> Real -> Real {
    compose(pow_fn(k), affine_real(-Real.1, b))
}

theorem taylor_shift_pow_value(b: Real, k: Nat, x: Real) {
    taylor_shift_pow(b, k, x) = (b - x).pow(k)
}

theorem taylor_shift_pow_suc_has_derivative_at(b: Real, m: Nat, x0: Real) {
    has_derivative_at(taylor_shift_pow(b, m.suc), x0,
        -(from_nat[Real](m.suc)) * (b - x0).pow(m))
}

theorem taylor_shift_pow_zero_has_derivative_at(b: Real, x0: Real) {
    has_derivative_at(taylor_shift_pow(b, Nat.0), x0, Real.0)
}

theorem taylor_shift_pow_has_derivative_at(b: Real, k: Nat, x0: Real) {
    has_derivative_at(taylor_shift_pow(b, k), x0,
        -(from_nat[Real](k)) * (b - x0).pow(k - Nat.1))
}

define taylor_bt_term(dfs: Nat -> Real -> Real, b: Real, x: Real, k: Nat) -> Real {
    (dfs(k, x) / from_nat[Real](k.factorial)) * (b - x).pow(k)
}

define taylor_bt_term_deriv(dfs: Nat -> Real -> Real, b: Real, x: Real, k: Nat) -> Real {
    (dfs(k.suc, x) / from_nat[Real](k.factorial)) * (b - x).pow(k) -
        (dfs(k, x) / from_nat[Real](k.factorial)) * from_nat[Real](k) * (b - x).pow(k - Nat.1)
}

define taylor_bt_term_fn(dfs: Nat -> Real -> Real, b: Real, k: Nat) -> Real -> Real {
    pointwise_mul(
        pointwise_mul(constant[Real, Real](from_nat[Real](k.factorial).inverse), dfs(k)),
        taylor_shift_pow(b, k))
}

theorem taylor_bt_term_fn_value(dfs: Nat -> Real -> Real, b: Real, k: Nat, x: Real) {
    taylor_bt_term_fn(dfs, b, k, x) = taylor_bt_term(dfs, b, x, k)
}

theorem taylor_bt_term_fn_has_derivative_at(dfs: Nat -> Real -> Real, k: Nat, b: Real, x0: Real) {
    is_derivative_fn(dfs(k), dfs(k.suc))
    implies has_derivative_at(taylor_bt_term_fn(dfs, b, k), x0,
        taylor_bt_term_deriv(dfs, b, x0, k))
}

define taylor_bt_sum_fn(dfs: Nat -> Real -> Real, b: Real, m: Nat) -> Real -> Real {
    function(x: Real) { partial(taylor_bt_term(dfs, b, x), m) }
}

define taylor_bt_sum_deriv(dfs: Nat -> Real -> Real, b: Real, x: Real, m: Nat) -> Real {
    partial(taylor_bt_term_deriv(dfs, b, x), m)
}

theorem taylor_bt_sum_fn_zero(dfs: Nat -> Real -> Real, b: Real) {
    taylor_bt_sum_fn(dfs, b, Nat.0) = constant[Real, Real](Real.0)
}

theorem taylor_bt_sum_fn_suc(dfs: Nat -> Real -> Real, b: Real, m: Nat) {
    taylor_bt_sum_fn(dfs, b, m.suc) =
        pointwise_add(taylor_bt_sum_fn(dfs, b, m), taylor_bt_term_fn(dfs, b, m))
}

theorem taylor_bt_sum_deriv_suc(dfs: Nat -> Real -> Real, b: Real, x: Real, m: Nat) {
    taylor_bt_sum_deriv(dfs, b, x, m.suc) =
        taylor_bt_sum_deriv(dfs, b, x, m) + taylor_bt_term_deriv(dfs, b, x, m)
}

theorem taylor_bt_sum_fn_has_derivative_at(dfs: Nat -> Real -> Real, b: Real, m: Nat, x0: Real) {
    forall(k: Nat) { k < m implies is_derivative_fn(dfs(k), dfs(k.suc)) }
    implies has_derivative_at(taylor_bt_sum_fn(dfs, b, m), x0,
        taylor_bt_sum_deriv(dfs, b, x0, m))
}

theorem from_nat_factorial_suc_real(n: Nat) {
    from_nat[Real](n.suc.factorial) = from_nat[Real](n.suc) * from_nat[Real](n.factorial)
}

theorem taylor_factorial_real_ne_zero(n: Nat) {
    from_nat[Real](n.factorial) != Real.0
}

theorem from_nat_suc_ne_zero(n: Nat) {
    from_nat[Real](n.suc) != Real.0
}

theorem taylor_bt_term_zero_at(dfs: Nat -> Real -> Real, b: Real, x: Real) {
    taylor_bt_term(dfs, b, x, Nat.0) = dfs(Nat.0, x)
}

theorem taylor_bt_term_zero_shift(dfs: Nat -> Real -> Real, b: Real, k: Nat) {
    taylor_bt_term(dfs, b, b, k.suc) = Real.0
}

theorem taylor_ratio_mul(n: Nat, a: Real) {
    (a / from_nat[Real](n.suc.factorial)) * from_nat[Real](n.suc) =
        a / from_nat[Real](n.factorial)
}

theorem taylor_ratio_div(n: Nat, a: Real) {
    (a / from_nat[Real](n.factorial)) / from_nat[Real](n.suc) =
        a / from_nat[Real](n.suc.factorial)
}

define taylor_aux_coeff(f: Real -> Real, dfs: Nat -> Real -> Real, a: Real, b: Real, n: Nat) -> Real {
    (f(b) - partial(taylor_bt_term(dfs, b, a), n.suc)) / (b - a).pow(n.suc)
}

define taylor_aux_val(f: Real -> Real, dfs: Nat -> Real -> Real, a: Real, b: Real, n: Nat, x: Real) -> Real {
    f(b) - partial(taylor_bt_term(dfs, b, x), n.suc) -
        taylor_aux_coeff(f, dfs, a, b, n) * (b - x).pow(n.suc)
}

define taylor_aux_fn(f: Real -> Real, dfs: Nat -> Real -> Real, a: Real, b: Real, n: Nat) -> Real -> Real {
    pointwise_add(
        pointwise_add(
            constant[Real, Real](f(b)),
            pointwise_neg(taylor_bt_sum_fn(dfs, b, n.suc))),
        pointwise_neg(pointwise_mul(
            constant[Real, Real](taylor_aux_coeff(f, dfs, a, b, n)),
            taylor_shift_pow(b, n.suc))))
}

define taylor_aux_deriv_val(f: Real -> Real, dfs: Nat -> Real -> Real, a: Real, b: Real, n: Nat, x: Real) -> Real {
    -partial(taylor_bt_term_deriv(dfs, b, x), n.suc) +
        from_nat[Real](n.suc) * taylor_aux_coeff(f, dfs, a, b, n) * (b - x).pow(n)
}

define taylor_aux_deriv_fn(f: Real -> Real, dfs: Nat -> Real -> Real, a: Real, b: Real, n: Nat) -> Real -> Real {
    function(x: Real) { taylor_aux_deriv_val(f, dfs, a, b, n, x) }
}

theorem taylor_aux_fn_value(f: Real -> Real, dfs: Nat -> Real -> Real, a: Real, b: Real, n: Nat, x: Real) {
    taylor_aux_fn(f, dfs, a, b, n, x) = taylor_aux_val(f, dfs, a, b, n, x)
}

theorem taylor_aux_at_a_zero(f: Real -> Real, dfs: Nat -> Real -> Real, a: Real, b: Real, n: Nat) {
    a < b implies taylor_aux_val(f, dfs, a, b, n, a) = Real.0
}

theorem taylor_aux_at_b_zero(f: Real -> Real, dfs: Nat -> Real -> Real, a: Real, b: Real, n: Nat) {
    dfs(Nat.0) = f
    implies taylor_aux_val(f, dfs, a, b, n, b) = Real.0
}

theorem taylor_aux_endpoints_equal(f: Real -> Real, dfs: Nat -> Real -> Real, a: Real, b: Real, n: Nat) {
    a < b and dfs(Nat.0) = f
    implies taylor_aux_fn(f, dfs, a, b, n, a) = taylor_aux_fn(f, dfs, a, b, n, b)
}

theorem is_derivative_fn_imp_continuous_on_closed(f: Real -> Real, df: Real -> Real, u: Real, v: Real) {
    is_derivative_fn(f, df) implies continuous_on_closed(f, u, v)
}

theorem taylor_chain_first(f: Real -> Real, dfs: Nat -> Real -> Real, n: Nat) {
    is_derivative_chain(f, dfs, n) implies dfs(Nat.0) = f
}

theorem taylor_chain_all(f: Real -> Real, dfs: Nat -> Real -> Real, n: Nat, k: Nat) {
    is_derivative_chain(f, dfs, n) and k < n implies is_derivative_fn(dfs(k), dfs(k.suc))
}

theorem taylor_aux_fn_is_derivative_fn(f: Real -> Real, dfs: Nat -> Real -> Real, a: Real, b: Real, n: Nat) {
    is_derivative_chain(f, dfs, n.suc)
    implies is_derivative_fn(taylor_aux_fn(f, dfs, a, b, n), taylor_aux_deriv_fn(f, dfs, a, b, n))
}

theorem taylor_deriv_sum_telescopes(dfs: Nat -> Real -> Real, b: Real, x: Real, n: Nat) {
    partial(taylor_bt_term_deriv(dfs, b, x), n.suc) =
        (dfs(n.suc, x) / from_nat[Real](n.factorial)) * (b - x).pow(n)
}

theorem taylor_aux_deriv_telescopes(f: Real -> Real, dfs: Nat -> Real -> Real, a: Real, b: Real, n: Nat, x: Real) {
    taylor_aux_deriv_val(f, dfs, a, b, n, x) =
        (b - x).pow(n) * (from_nat[Real](n.suc) * taylor_aux_coeff(f, dfs, a, b, n) -
            dfs(n.suc, x) / from_nat[Real](n.factorial))
}

theorem taylor_general(n: Nat, f: Real -> Real, dfs: Nat -> Real -> Real, a: Real, b: Real) {
    a < b and is_derivative_chain(f, dfs, n.suc)
    implies exists(c: Real) {
        a < c and c < b and
        f(b) = taylor_poly(f, dfs, a, b, n) + taylor_remainder(f, dfs, a, b, c, n)
    }
}

theorem taylor_chain1_is_derivative_chain(f: Real -> Real, df: Real -> Real) {
    is_derivative_fn(f, df)
    implies is_derivative_chain(f, taylor_chain1(f, df), Nat.1)
}

theorem taylor_chain2_is_derivative_chain(f: Real -> Real, df: Real -> Real, ddf: Real -> Real) {
    is_derivative_fn(f, df) and is_derivative_fn(df, ddf)
    implies is_derivative_chain(f, taylor_chain2(f, df, ddf), Nat.2)
}

theorem taylor_chain3_is_derivative_chain(f: Real -> Real, df: Real -> Real, ddf: Real -> Real, dddf: Real -> Real) {
    is_derivative_fn(f, df) and is_derivative_fn(df, ddf) and is_derivative_fn(ddf, dddf)
    implies is_derivative_chain(f, taylor_chain3(f, df, ddf, dddf), Nat.3)
}

theorem taylor_chain4_is_derivative_chain(f: Real -> Real, df: Real -> Real, ddf: Real -> Real, dddf: Real -> Real, dddd: Real -> Real) {
    is_derivative_fn(f, df) and is_derivative_fn(df, ddf) and is_derivative_fn(ddf, dddf) and is_derivative_fn(dddf, dddd)
    implies is_derivative_chain(f, taylor_chain4(f, df, ddf, dddf, dddd), Nat.4)
}

theorem taylor_general_inst_zero(f: Real -> Real, df: Real -> Real, a: Real, b: Real) {
    a < b and is_derivative_fn(f, df)
    implies exists(c: Real) {
        a < c and c < b and
        f(b) = taylor_poly(f, taylor_chain1(f, df), a, b, Nat.0) +
            taylor_remainder(f, taylor_chain1(f, df), a, b, c, Nat.0)
    }
}

theorem taylor_general_inst_one(f: Real -> Real, df: Real -> Real, ddf: Real -> Real, a: Real, b: Real) {
    a < b and is_derivative_fn(f, df) and is_derivative_fn(df, ddf)
    implies exists(c: Real) {
        a < c and c < b and
        f(b) = taylor_poly(f, taylor_chain2(f, df, ddf), a, b, Nat.1) +
            taylor_remainder(f, taylor_chain2(f, df, ddf), a, b, c, Nat.1)
    }
}

theorem taylor_general_inst_two(f: Real -> Real, df: Real -> Real, ddf: Real -> Real, dddf: Real -> Real, a: Real, b: Real) {
    a < b and is_derivative_fn(f, df) and is_derivative_fn(df, ddf) and is_derivative_fn(ddf, dddf)
    implies exists(c: Real) {
        a < c and c < b and
        f(b) = taylor_poly(f, taylor_chain3(f, df, ddf, dddf), a, b, Nat.2) +
            taylor_remainder(f, taylor_chain3(f, df, ddf, dddf), a, b, c, Nat.2)
    }
}

theorem taylor_general_inst_three(f: Real -> Real, df: Real -> Real, ddf: Real -> Real, dddf: Real -> Real, dddd: Real -> Real, a: Real, b: Real) {
    a < b and is_derivative_fn(f, df) and is_derivative_fn(df, ddf) and is_derivative_fn(ddf, dddf) and is_derivative_fn(dddf, dddd)
    implies exists(c: Real) {
        a < c and c < b and
        f(b) = taylor_poly(f, taylor_chain4(f, df, ddf, dddf, dddd), a, b, Nat.3) +
            taylor_remainder(f, taylor_chain4(f, df, ddf, dddf, dddd), a, b, c, Nat.3)
    }
}

define exp_chain(k: Nat) -> Real -> Real {
    Real.exp
}

theorem exp_chain_is_derivative_chain(n: Nat) {
    is_derivative_chain(Real.exp, exp_chain, n.suc)
}

theorem exp_term_from_nat(x: Real, k: Nat) {
    exp_term(x, k) = x.pow(k) / from_nat[Real](k.factorial)
}

theorem exp_series_eq(x: Real) {
    x.exp = limit(partial(exp_term(x)))
}

theorem taylor_exp_series_converges(x: Real) {
    converges_to(partial(exp_term(x)), x.exp)
}

theorem taylor_exp_remainder(n: Nat, x: Real) {
    Real.0 < x
    implies exists(c: Real) {
        Real.0 < c and c < x and
        x.exp = partial(exp_term(x), n.suc) +
            (c.exp / from_nat[Real](n.suc.factorial)) * x.pow(n.suc)
    }
}

theorem taylor_exp_remainder_bound(n: Nat, x: Real) {
    Real.0 < x
    implies exists(c: Real) {
        Real.0 < c and c < x and c.exp < x.exp and
        x.exp = partial(exp_term(x), n.suc) +
            (c.exp / from_nat[Real](n.suc.factorial)) * x.pow(n.suc)
    }
}

define sin_term(x: Real, n: Nat) -> Real {
    alternating_sign[Real](n) * x.pow(Nat.2 * n + Nat.1) / Real.from_rat(Rat.from_nat((Nat.2 * n + Nat.1).factorial))
}

define cos_term(x: Real, n: Nat) -> Real {
    alternating_sign[Real](n) * x.pow(Nat.2 * n) / Real.from_rat(Rat.from_nat((Nat.2 * n).factorial))
}

attributes Real {
    /// The sine function, defined by its power series.
    define sin(self) -> Real {
        limit(partial(sin_term(self)))
    }

    /// The cosine function, defined by its power series.
    define cos(self) -> Real {
        limit(partial(cos_term(self)))
    }
}

theorem alt_abs_step(k: Nat) {
    alternating_sign[Real](k).abs = Real.1 implies alternating_sign[Real](k.suc).abs = Real.1
}

theorem alternating_sign_abs(n: Nat) {
    alternating_sign[Real](n).abs = Real.1
}

theorem alt_double_step(k: Nat) {
    alternating_sign[Real](Nat.2 * k) = Real.1 implies alternating_sign[Real](Nat.2 * k.suc) = Real.1
}

theorem alternating_sign_double(n: Nat) {
    alternating_sign[Real](Nat.2 * n) = Real.1
}

theorem alt_double_suc_step(k: Nat) {
    alternating_sign[Real](Nat.2 * k + Nat.1) = -Real.1 implies alternating_sign[Real](Nat.2 * k.suc + Nat.1) = -Real.1
}

theorem alternating_sign_double_suc(n: Nat) {
    alternating_sign[Real](Nat.2 * n + Nat.1) = -Real.1
}

theorem sin_term_abs(x: Real, n: Nat) {
    sin_term(x, n).abs = x.abs.pow(Nat.2 * n + Nat.1) / Real.from_rat(Rat.from_nat((Nat.2 * n + Nat.1).factorial))
}

theorem sin_term_abs_exp(x: Real, n: Nat) {
    sin_term(x, n).abs = exp_term(x.abs, Nat.2 * n + Nat.1)
}

theorem cos_term_abs(x: Real, n: Nat) {
    cos_term(x, n).abs = x.abs.pow(Nat.2 * n) / Real.from_rat(Rat.from_nat((Nat.2 * n).factorial))
}

theorem cos_term_abs_exp(x: Real, n: Nat) {
    cos_term(x, n).abs = exp_term(x.abs, Nat.2 * n)
}

theorem exp_term_nonneg(x: Real, n: Nat) {
    x >= Real.0 implies exp_term(x, n) >= Real.0
}

theorem sin_bound_base(x: Real) {
    Real.0 <= partial(exp_term(x.abs), Nat.1)
}

theorem sin_partial_bound_step(x: Real, k: Nat) {
    partial(abs_fn(sin_term(x)), k) <= partial(exp_term(x.abs), Nat.2 * k + Nat.1)
    implies
    partial(abs_fn(sin_term(x)), k.suc) <= partial(exp_term(x.abs), Nat.2 * k.suc + Nat.1)
}

theorem sin_partial_bound(x: Real, n: Nat) {
    partial(abs_fn(sin_term(x)), n) <= partial(exp_term(x.abs), Nat.2 * n + Nat.1)
}

theorem cos_partial_bound_step(x: Real, k: Nat) {
    partial(abs_fn(cos_term(x)), k) <= partial(exp_term(x.abs), Nat.2 * k)
    implies
    partial(abs_fn(cos_term(x)), k.suc) <= partial(exp_term(x.abs), Nat.2 * k.suc)
}

theorem cos_partial_bound(x: Real, n: Nat) {
    partial(abs_fn(cos_term(x)), n) <= partial(exp_term(x.abs), Nat.2 * n)
}

theorem sin_term_abs_converges(x: Real) {
    absolutely_converges(sin_term(x))
}

theorem cos_term_abs_converges(x: Real) {
    absolutely_converges(cos_term(x))
}

theorem sin_term_zero(n: Nat) {
    sin_term(Real.0, n) = Real.0
}

theorem sin_partial_zero_step(k: Nat) {
    partial(sin_term(Real.0), k) = Real.0 implies partial(sin_term(Real.0), k.suc) = Real.0
}

theorem sin_partial_zero(n: Nat) {
    partial(sin_term(Real.0), n) = Real.0
}

theorem sin_zero {
    (Real.0).sin = Real.0
}

theorem cos_term_zero(n: Nat) {
    n >= Nat.1 implies cos_term(Real.0, n) = Real.0
}

theorem cos_zero_partial_step(k: Nat) {
    partial(cos_term(Real.0), k.suc) = Real.1 implies partial(cos_term(Real.0), k.suc.suc) = Real.1
}

theorem cos_zero_partial(k: Nat) {
    partial(cos_term(Real.0), k.suc) = Real.1
}

theorem cos_zero {
    (Real.0).cos = Real.1
}

theorem cos_term_neg(x: Real, n: Nat) {
    cos_term(-x, n) = cos_term(x, n)
}

theorem sin_term_neg(x: Real, n: Nat) {
    sin_term(-x, n) = -sin_term(x, n)
}

theorem cos_neg(x: Real) {
    (-x).cos = x.cos
}

theorem sin_neg(x: Real) {
    (-x).sin = -x.sin
}

define alt_term(a: Nat -> Real, n: Nat) -> Real {
    alternating_sign[Real](n) * a(n)
}

theorem alt_sign_abs_one(n: Nat) {
    alternating_sign[Real](n).abs = Real.1
}

theorem alt_sign_add(n: Nat, m: Nat) {
    alternating_sign[Real](n + m) = alternating_sign[Real](n) * alternating_sign[Real](m)
}

theorem alt_term_tail(a: Nat -> Real, k: Nat) {
    tail(alt_term(a), k) = mul_seq(alternating_sign[Real](k), alt_term(tail(a, k)))
}

define alt_even_ub_pred(c: Nat -> Real, k: Nat) -> Bool {
    partial(alt_term(c), Nat.2 * k) <= c(Nat.0) - c(Nat.2 * k)
}

define alt_even_lb_pred(c: Nat -> Real, k: Nat) -> Bool {
    Real.0 <= partial(alt_term(c), Nat.2 * k)
}

theorem alt_even_ub_suc(c: Nat -> Real, k: Nat) {
    is_decreasing_seq(c) and is_lower_bound(c, Real.0)
    and alt_even_ub_pred(c, k)
    implies alt_even_ub_pred(c, k.suc)
}

theorem alt_even_ub_step(c: Nat -> Real) {
    is_decreasing_seq(c) and is_lower_bound(c, Real.0)
    implies forall(k: Nat) {
        alt_even_ub_pred(c, k) implies alt_even_ub_pred(c, k.suc)
    }
}

theorem alt_even_ub(c: Nat -> Real, q: Nat) {
    is_decreasing_seq(c) and is_lower_bound(c, Real.0)
    implies partial(alt_term(c), Nat.2 * q) <= c(Nat.0) - c(Nat.2 * q)
}

theorem alt_even_lb_suc(c: Nat -> Real, k: Nat) {
    is_decreasing_seq(c) and is_lower_bound(c, Real.0)
    and alt_even_lb_pred(c, k)
    implies alt_even_lb_pred(c, k.suc)
}

theorem alt_even_lb_step(c: Nat -> Real) {
    is_decreasing_seq(c) and is_lower_bound(c, Real.0)
    implies forall(k: Nat) {
        alt_even_lb_pred(c, k) implies alt_even_lb_pred(c, k.suc)
    }
}

theorem alt_even_lb(c: Nat -> Real, q: Nat) {
    is_decreasing_seq(c) and is_lower_bound(c, Real.0)
    implies Real.0 <= partial(alt_term(c), Nat.2 * q)
}

theorem alt_odd_ub(c: Nat -> Real, q: Nat) {
    is_decreasing_seq(c) and is_lower_bound(c, Real.0)
    implies partial(alt_term(c), Nat.2 * q + Nat.1) <= c(Nat.0)
}

theorem alt_odd_lb(c: Nat -> Real, q: Nat) {
    is_decreasing_seq(c) and is_lower_bound(c, Real.0)
    implies c(Nat.2 * q + Nat.1) <= partial(alt_term(c), Nat.2 * q + Nat.1)
}

theorem alt_partial_abs_bound(c: Nat -> Real, p: Nat) {
    is_decreasing_seq(c) and is_lower_bound(c, Real.0)
    implies partial(alt_term(c), p).abs <= c(Nat.0)
}

theorem alt_window_abs_bound(a: Nat -> Real, k: Nat, m: Nat) {
    is_decreasing_seq(a) and is_lower_bound(a, Real.0) and k <= m
    implies sum(map(k.until(m), alt_term(a))).abs <= a(k)
}

theorem alt_is_cauchy_series(a: Nat -> Real) {
    is_decreasing_seq(a) and is_lower_bound(a, Real.0) and converges_to(a, Real.0)
    implies is_cauchy_series(alt_term(a))
}

theorem alternating_series_test(a: Nat -> Real) {
    is_decreasing_seq(a) and vanishes(a) implies converges(partial(alt_term(a)))
}

define ratio_seq(a: Nat -> Real, n: Nat) -> Real {
    a(n.suc).abs / a(n).abs
}

theorem ratio_test_abs_conv(a: Nat -> Real, l: Real, alpha: Real) {
    converges_to(ratio_seq(a), l)
    and l < alpha
    and alpha < Real.1
    and Real.0 <= alpha
    and always_nonzero(a)
    implies absolutely_converges(a)
}

theorem ratio_test(a: Nat -> Real, l: Real) {
    converges_to(ratio_seq(a), l) and l < Real.1 and always_nonzero(a)
    implies absolutely_converges(a)
}

define root_seq(a: Nat -> Real, n: Nat) -> Real {
    abs_pow_value(a, Real.1 / from_nat[Real](n.suc), n.suc)
}

theorem root_exp_pos(n: Nat) {
    Real.1 / from_nat[Real](n.suc) > Real.0
}

theorem root_exp_recip(n: Nat) {
    Real.1 / (Real.1 / from_nat[Real](n.suc)) = from_nat[Real](n.suc)
}

theorem root_pow_eq_abs(a: Nat -> Real, n: Nat) {
    root_seq(a, n).pow(n.suc) = a(n.suc).abs
}

theorem root_lt_alpha_imp_abs_le(a: Nat -> Real, n: Nat, alpha: Real) {
    root_seq(a, n) < alpha and Real.0 <= alpha
    implies a(n.suc).abs <= alpha.pow(n.suc)
}

theorem root_test_eventual_majorant(a: Nat -> Real, alpha: Real, n0: Nat) {
    (forall(n: Nat) { n0 <= n implies root_seq(a, n) < alpha })
    and Real.0 <= alpha
    implies
    forall(k: Nat) { n0.suc <= k implies abs_fn(a)(k) <= geometric_majorant(Real.1, alpha, k) }
}

theorem root_test(a: Nat -> Real, l: Real) {
    converges_to(root_seq(a), l) and l < Real.1
    implies absolutely_converges(a)
}

theorem alternating_sign_mul(a: Nat, b: Nat) {
    alternating_sign[Real](a) * alternating_sign[Real](b) = alternating_sign[Real](a + b)
}

theorem signed_terms_binom_product(x: Real, y: Real, a: Nat, b: Nat, e: Nat, f: Nat) {
    (alternating_sign[Real](a) * x.pow(Nat.2 * a + e) / Real.from_rat(Rat.from_nat((Nat.2 * a + e).factorial))) *
    (alternating_sign[Real](b) * y.pow(Nat.2 * b + f) / Real.from_rat(Rat.from_nat((Nat.2 * b + f).factorial))) =
        alternating_sign[Real](a + b) * binomial_term[Real](x, y, Nat.2 * a + e + Nat.2 * b + f, Nat.2 * a + e) /
        Real.from_rat(Rat.from_nat((Nat.2 * a + e + Nat.2 * b + f).factorial))
}

theorem sin_cos_term_product(x: Real, y: Real, n: Nat, k: Nat) {
    k <= n implies
    sin_term(x, k) * cos_term(y, n - k) =
        alternating_sign[Real](n) * binomial_term[Real](x, y, Nat.2 * n + Nat.1, Nat.2 * k + Nat.1) /
        Real.from_rat(Rat.from_nat((Nat.2 * n + Nat.1).factorial))
}

theorem cos_sin_term_product(x: Real, y: Real, n: Nat, k: Nat) {
    k <= n implies
    cos_term(x, k) * sin_term(y, n - k) =
        alternating_sign[Real](n) * binomial_term[Real](x, y, Nat.2 * n + Nat.1, Nat.2 * k) /
        Real.from_rat(Rat.from_nat((Nat.2 * n + Nat.1).factorial))
}

theorem cos_cos_term_product(x: Real, y: Real, n: Nat, k: Nat) {
    k <= n implies
    cos_term(x, k) * cos_term(y, n - k) =
        alternating_sign[Real](n) * binomial_term[Real](x, y, Nat.2 * n, Nat.2 * k) /
        Real.from_rat(Rat.from_nat((Nat.2 * n).factorial))
}

theorem sin_sin_term_product(x: Real, y: Real, m: Nat, k: Nat) {
    k <= m implies
    sin_term(x, k) * sin_term(y, m - k) =
        alternating_sign[Real](m) * binomial_term[Real](x, y, Nat.2 * m + Nat.2, Nat.2 * k + Nat.1) /
        Real.from_rat(Rat.from_nat((Nat.2 * m + Nat.2).factorial))
}

define sin_row_odd(x: Real, y: Real, n: Nat, k: Nat) -> Real {
    alternating_sign[Real](n) * binomial_term[Real](x, y, Nat.2 * n + Nat.1, Nat.2 * k + Nat.1) /
    Real.from_rat(Rat.from_nat((Nat.2 * n + Nat.1).factorial))
}

define sin_row_even(x: Real, y: Real, n: Nat, k: Nat) -> Real {
    alternating_sign[Real](n) * binomial_term[Real](x, y, Nat.2 * n + Nat.1, Nat.2 * k) /
    Real.from_rat(Rat.from_nat((Nat.2 * n + Nat.1).factorial))
}

define row_pair_sum(x: Real, y: Real, n: Nat, k: Nat) -> Real {
    binomial_term[Real](x, y, Nat.2 * n + Nat.1, Nat.2 * k) + binomial_term[Real](x, y, Nat.2 * n + Nat.1, Nat.2 * k + Nat.1)
}

define sin_row_sum(x: Real, y: Real, n: Nat, k: Nat) -> Real {
    alternating_sign[Real](n) * row_pair_sum(x, y, n, k) /
    Real.from_rat(Rat.from_nat((Nat.2 * n + Nat.1).factorial))
}

theorem sin_add_cauchy(x: Real, y: Real, n: Nat) {
    cauchy_product(sin_term(x), cos_term(y), n) + cauchy_product(cos_term(x), sin_term(y), n) = sin_term(x + y, n)
}

theorem div_sub_same_denom(a: Real, b: Real, x: Real, y: Real, f: Real) {
    f != Real.0 implies a * x / f - b * y / f = (a * x - b * y) / f
}

define cos_row_even(x: Real, y: Real, n: Nat, k: Nat) -> Real {
    alternating_sign[Real](n) * binomial_term[Real](x, y, Nat.2 * n, Nat.2 * k) /
    Real.from_rat(Rat.from_nat((Nat.2 * n).factorial))
}

define sin_row_odd_shift(x: Real, y: Real, m: Nat, k: Nat) -> Real {
    alternating_sign[Real](m) * binomial_term[Real](x, y, Nat.2 * m + Nat.2, Nat.2 * k + Nat.1) /
    Real.from_rat(Rat.from_nat((Nat.2 * m + Nat.2).factorial))
}

theorem cos_add_cauchy(x: Real, y: Real, n: Nat) {
    n >= Nat.1 implies
    cauchy_product(cos_term(x), cos_term(y), n) - cauchy_product(sin_term(x), sin_term(y), n - Nat.1) = cos_term(x + y, n)
}

theorem cos_add_cauchy_seq(x: Real, y: Real, n: Nat) {
    partial(cos_term(x + y), n) =
        partial(cauchy_seq(cos_term(x), cos_term(y)), n) -
        partial(cauchy_seq(sin_term(x), sin_term(y)), n - Nat.1)
}

theorem sin_add(x: Real, y: Real) {
    (x + y).sin = x.sin * y.cos + x.cos * y.sin
}

theorem cos_add(x: Real, y: Real) {
    (x + y).cos = x.cos * y.cos - x.sin * y.sin
}

theorem sin_sq_add_cos_sq(x: Real) {
    x.sin.pow(Nat.2) + x.cos.pow(Nat.2) = Real.1
}

define sin_shift_term(x: Real, n: Nat) -> Real {
    alternating_sign[Real](n) * x.pow(Nat.2 * n) / Real.from_rat(Rat.from_nat((Nat.2 * n + Nat.1).factorial))
}

theorem sin_shift_term_mul_x(x: Real, n: Nat) {
    x * sin_shift_term(x, n) = sin_term(x, n)
}

theorem mul_seq_sin_shift_eq_sin_term(x: Real) {
    mul_seq(x, sin_shift_term(x)) = sin_term(x)
}

theorem sin_shift_term_abs(x: Real, n: Nat) {
    sin_shift_term(x, n).abs = x.abs.pow(Nat.2 * n) / Real.from_rat(Rat.from_nat((Nat.2 * n + Nat.1).factorial))
}

theorem sin_shift_term_abs_le_geom(x: Real, n: Nat) {
    sin_shift_term(x, n).abs <= x.abs.pow(Nat.2).pow(n)
}

theorem sin_shift_term_abs_converges_small(x: Real) {
    x.abs < Real.1 implies absolutely_converges(sin_shift_term(x))
}

define sin_shift_sum(x: Real) -> Real {
    limit(partial(sin_shift_term(x)))
}

theorem sin_shift_partial_mul(x: Real, n: Nat) {
    x * partial(sin_shift_term(x), n) = partial(sin_term(x), n)
}

theorem sin_series_small(x: Real) {
    x.abs < Real.1 implies x.sin = x * sin_shift_sum(x)
}

define cos_shift_term(x: Real, n: Nat) -> Real {
    alternating_sign[Real](n.suc) * x.pow(Nat.2 * n) / Real.from_rat(Rat.from_nat((Nat.2 * n.suc).factorial))
}

theorem cos_shift_term_mul_x2(x: Real, n: Nat) {
    x.pow(Nat.2) * cos_shift_term(x, n) = cos_term(x, n.suc)
}

theorem mul_seq_cos_shift_eq_tail(x: Real) {
    mul_seq(x.pow(Nat.2), cos_shift_term(x)) = tail(cos_term(x), Nat.1)
}

theorem cos_shift_term_abs(x: Real, n: Nat) {
    cos_shift_term(x, n).abs = x.abs.pow(Nat.2 * n) / Real.from_rat(Rat.from_nat((Nat.2 * n.suc).factorial))
}

theorem cos_shift_term_abs_le_geom(x: Real, n: Nat) {
    cos_shift_term(x, n).abs <= x.abs.pow(Nat.2).pow(n)
}

theorem cos_shift_term_abs_converges_small(x: Real) {
    x.abs < Real.1 implies absolutely_converges(cos_shift_term(x))
}

define cos_shift_sum(x: Real) -> Real {
    limit(partial(cos_shift_term(x)))
}

theorem cos_shift_partial_mul(x: Real, n: Nat) {
    x.pow(Nat.2) * partial(cos_shift_term(x), n) = partial(cos_term(x), n.suc) - Real.1
}

theorem cos_sub_one_series_small(x: Real) {
    x.abs < Real.1 implies x.cos - Real.1 = x.pow(Nat.2) * cos_shift_sum(x)
}

theorem sin_shift_tail_partial_bound(h: Real, n: Nat) {
    h.abs < Real.1 / two implies partial(tail(abs_fn(sin_shift_term(h)), Nat.1), n) <= two * h.abs.pow(Nat.2)
}

theorem sin_shift_sum_close_one(h: Real) {
    h.abs < Real.1 / two implies (sin_shift_sum(h) - Real.1).abs <= two * h.abs.pow(Nat.2)
}

theorem cos_shift_sum_bound(h: Real) {
    h.abs < Real.1 / two implies cos_shift_sum(h).abs <= two
}

theorem sin_has_derivative_at(x0: Real) {
    has_derivative_at(Real.sin, x0, x0.cos)
}

theorem sin_is_derivative_fn {
    is_derivative_fn(Real.sin, Real.cos)
}

theorem cos_has_derivative_at(x0: Real) {
    has_derivative_at(Real.cos, x0, -x0.sin)
}

theorem cos_is_derivative_fn {
    is_derivative_fn(Real.cos, pointwise_neg(Real.sin))
}

theorem cos_derivative_is_neg_sin {
    is_derivative_fn(Real.cos, pointwise_neg(Real.sin))
}

define integral_function(f: Real -> Real, a: Real, x: Real) -> Real {
    integral(f, a, x)
}

theorem const_self_lb(m: Real, a: Real, b: Real) {
    forall(t: Real) { interval_contains(a, b, t) implies m <= constant[Real, Real](m, t) }
}

theorem const_neg_self_lb(m: Real, a: Real, b: Real) {
    forall(t: Real) { interval_contains(a, b, t) implies -m <= constant[Real, Real](-m, t) }
}

theorem integral_bounds(f: Real -> Real, m: Real, a: Real, b: Real) {
    a <= b and is_integrable(f, a, b) and
    (forall(t: Real) { interval_contains(a, b, t) implies -m <= f(t) }) and
    (forall(t: Real) { interval_contains(a, b, t) implies f(t) <= m }) and
    (forall(t: Real) { interval_contains(a, b, t) implies m <= constant[Real, Real](m, t) }) and
    (forall(t: Real) { interval_contains(a, b, t) implies -m <= constant[Real, Real](-m, t) })
    implies
    (-m) * (b - a) <= integral(f, a, b) and integral(f, a, b) <= m * (b - a)
}

theorem derivative_on_closed_imp_continuous_on_closed(g: Real -> Real, f: Real -> Real, x: Real, y: Real) {
    (forall(t: Real) { interval_contains(x, y, t) implies has_derivative_at(g, t, f(t)) })
    implies continuous_on_closed(g, x, y)
}

theorem derivative_on_closed_imp_derivative_on_open(g: Real -> Real, f: Real -> Real, x: Real, y: Real) {
    (forall(t: Real) { interval_contains(x, y, t) implies has_derivative_at(g, t, f(t)) })
    implies is_derivative_on_open(g, f, x, y)
}

theorem ftc2_cell_mvt_result(f: Real -> Real, g: Real -> Real, x: Real, y: Real) {
    x <= y and
    (forall(t: Real) { interval_contains(x, y, t) implies has_derivative_at(g, t, f(t)) })
    implies exists(c: Real) {
        interval_contains(x, y, c) and g(y) - g(x) = f(c) * (y - x)
    }
}

theorem ftc2_cell_lower(f: Real -> Real, g: Real -> Real, x: Real, y: Real, lb: Real, ub: Real) {
    x <= y and
    (forall(t: Real) { interval_contains(x, y, t) implies has_derivative_at(g, t, f(t)) }) and
    (forall(t: Real) { interval_contains(x, y, t) implies lb <= f(t) }) and
    (forall(t: Real) { interval_contains(x, y, t) implies f(t) <= ub })
    implies
    interval_inf(f, x, y) * (y - x) <= g(y) - g(x)
}

theorem ftc2_cell_upper(f: Real -> Real, g: Real -> Real, x: Real, y: Real, lb: Real, ub: Real) {
    x <= y and
    (forall(t: Real) { interval_contains(x, y, t) implies has_derivative_at(g, t, f(t)) }) and
    (forall(t: Real) { interval_contains(x, y, t) implies lb <= f(t) }) and
    (forall(t: Real) { interval_contains(x, y, t) implies f(t) <= ub })
    implies
    g(y) - g(x) <= interval_sup(f, x, y) * (y - x)
}

theorem partition_cell_has_derivative(f: Real -> Real, g: Real -> Real, p: Nat -> Real, a: Real, b: Real, n: Nat, k: Nat) {
    is_partition(p, a, b, n) and k < n and
    (forall(t: Real) { interval_contains(a, b, t) implies has_derivative_at(g, t, f(t)) })
    implies forall(t: Real) { interval_contains(p(k), p(k + 1), t) implies has_derivative_at(g, t, f(t)) }
}

theorem ftc2_partition_cell_lower(f: Real -> Real, g: Real -> Real, p: Nat -> Real, a: Real, b: Real, n: Nat, k: Nat, lb: Real, ub: Real) {
    is_partition(p, a, b, n) and k < n and
    (forall(t: Real) { interval_contains(a, b, t) implies has_derivative_at(g, t, f(t)) }) and
    (forall(t: Real) { interval_contains(a, b, t) implies lb <= f(t) }) and
    (forall(t: Real) { interval_contains(a, b, t) implies f(t) <= ub })
    implies
    interval_inf(f, p(k), p(k + 1)) * (p(k + 1) - p(k)) <= g(p(k + 1)) - g(p(k))
}

theorem ftc2_partition_cell_upper(f: Real -> Real, g: Real -> Real, p: Nat -> Real, a: Real, b: Real, n: Nat, k: Nat, lb: Real, ub: Real) {
    is_partition(p, a, b, n) and k < n and
    (forall(t: Real) { interval_contains(a, b, t) implies has_derivative_at(g, t, f(t)) }) and
    (forall(t: Real) { interval_contains(a, b, t) implies lb <= f(t) }) and
    (forall(t: Real) { interval_contains(a, b, t) implies f(t) <= ub })
    implies
    g(p(k + 1)) - g(p(k)) <= interval_sup(f, p(k), p(k + 1)) * (p(k + 1) - p(k))
}

theorem ftc2_lower_sum_le(f: Real -> Real, g: Real -> Real, p: Nat -> Real, a: Real, b: Real, n: Nat, lb: Real, ub: Real) {
    a <= b and is_partition(p, a, b, n) and
    (forall(t: Real) { interval_contains(a, b, t) implies has_derivative_at(g, t, f(t)) }) and
    (forall(t: Real) { interval_contains(a, b, t) implies lb <= f(t) }) and
    (forall(t: Real) { interval_contains(a, b, t) implies f(t) <= ub })
    implies
    lower_sum(f, p, n) <= g(b) - g(a)
}

theorem ftc2_upper_sum_ge(f: Real -> Real, g: Real -> Real, p: Nat -> Real, a: Real, b: Real, n: Nat, lb: Real, ub: Real) {
    a <= b and is_partition(p, a, b, n) and
    (forall(t: Real) { interval_contains(a, b, t) implies has_derivative_at(g, t, f(t)) }) and
    (forall(t: Real) { interval_contains(a, b, t) implies lb <= f(t) }) and
    (forall(t: Real) { interval_contains(a, b, t) implies f(t) <= ub })
    implies
    g(b) - g(a) <= upper_sum(f, p, n)
}

theorem ftc2(f: Real -> Real, g: Real -> Real, a: Real, b: Real, lb: Real, ub: Real) {
    a <= b and is_integrable(f, a, b) and
    (forall(t: Real) { interval_contains(a, b, t) implies has_derivative_at(g, t, f(t)) }) and
    (forall(t: Real) { interval_contains(a, b, t) implies lb <= f(t) }) and
    (forall(t: Real) { interval_contains(a, b, t) implies f(t) <= ub })
    implies
    integral(f, a, b) = g(b) - g(a)
}

theorem ftc2_const(f: Real -> Real, c: Real, a: Real, b: Real, d: Real) {
    a <= b and (forall(t: Real) { interval_contains(a, b, t) implies f(t) = c })
    implies
    integral(f, a, b) = affine_real(c, d, b) - affine_real(c, d, a)
}

theorem ftc2_const_derivative(c: Real, d: Real, x0: Real) {
    has_derivative_at(affine_real(c, d), x0, c)
}

theorem integral_function_eq_affine(f: Real -> Real, c: Real, a: Real, x: Real) {
    (forall(t: Real) { f(t) = c }) and a <= x
    implies
    integral_function(f, a, x) = affine_real(c, -(c * a), x)
}

theorem difference_quotient_affine_eq_slope(c: Real, d: Real, x0: Real, x: Real) {
    x != x0 implies difference_quotient(affine_real(c, d), x0, x) = c
}

theorem integral_function_difference_quotient_const(
    f: Real -> Real, c: Real, a: Real, x0: Real, x: Real
) {
    (forall(t: Real) { f(t) = c }) and a < x0 and x != x0 and x.is_close(x0, x0 - a)
    implies
    difference_quotient(integral_function(f, a), x0, x) = c
}

theorem ftc1_const(f: Real -> Real, c: Real, a: Real, x0: Real) {
    (forall(t: Real) { f(t) = c }) and a < x0
    implies
    has_derivative_at(integral_function(f, a), x0, c)
}

theorem ftc1_const_differentiable(f: Real -> Real, c: Real, a: Real, x0: Real) {
    (forall(t: Real) { f(t) = c }) and a < x0
    implies
    differentiable_at(integral_function(f, a), x0)
}

theorem ftc1_const_continuous(f: Real -> Real, c: Real, a: Real, x0: Real) {
    (forall(t: Real) { f(t) = c }) and a < x0
    implies
    continuous_at(integral_function(f, a), x0)
}

theorem const_le_fn(f: Real -> Real, x0: Real, x: Real, c: Real) {
    (forall(t: Real) { interval_contains(x0, x, t) implies c <= f(t) })
    implies forall(t: Real) { interval_contains(x0, x, t) implies constant[Real, Real](c, t) <= f(t) }
}

theorem fn_le_const(f: Real -> Real, x0: Real, x: Real, c2: Real) {
    (forall(t: Real) { interval_contains(x0, x, t) implies f(t) <= c2 })
    implies forall(t: Real) { interval_contains(x0, x, t) implies f(t) <= constant[Real, Real](c2, t) }
}

theorem integral_average_bounds(f: Real -> Real, x0: Real, x: Real, c1: Real, c2: Real) {
    x0 < x and is_integrable(f, x0, x) and
    (forall(t: Real) { interval_contains(x0, x, t) implies c1 <= f(t) }) and
    (forall(t: Real) { interval_contains(x0, x, t) implies f(t) <= c2 })
    implies
    c1 <= integral(f, x0, x) / (x - x0) and integral(f, x0, x) / (x - x0) <= c2
}

theorem ftc1_dq_eq_average_right(f: Real -> Real, a: Real, x0: Real, x: Real) {
    x0 < x and integral(f, a, x) = integral(f, a, x0) + integral(f, x0, x)
    implies
    difference_quotient(integral_function(f, a), x0, x) = integral(f, x0, x) / (x - x0)
}

theorem ftc1_dq_eq_average_left(f: Real -> Real, a: Real, x0: Real, x: Real) {
    x < x0 and integral(f, a, x0) = integral(f, a, x) + integral(f, x, x0)
    implies
    difference_quotient(integral_function(f, a), x0, x) = integral(f, x, x0) / (x0 - x)
}

theorem half_lt_self(eps: Real) {
    eps.is_positive implies eps / two < eps
}

theorem div_le_of_le_mul_pos(a: Real, b: Real, c: Real) {
    a * c <= b and c.is_positive implies a <= b / c
}

theorem le_div_of_mul_le_pos(a: Real, b: Real, c: Real) {
    b <= a * c and c.is_positive implies b / c <= a
}

theorem integral_ge_const_width(f: Real -> Real, x0: Real, x: Real, c: Real) {
    x0 < x and is_integrable(f, x0, x) and
    (forall(t: Real) { interval_contains(x0, x, t) implies c <= f(t) })
    implies c * (x - x0) <= integral(f, x0, x)
}

theorem integral_le_const_width(f: Real -> Real, x0: Real, x: Real, c1: Real, c2: Real) {
    x0 < x and is_integrable(f, x0, x) and
    (forall(t: Real) { interval_contains(x0, x, t) implies c1 <= f(t) }) and
    (forall(t: Real) { interval_contains(x0, x, t) implies f(t) <= c2 })
    implies integral(f, x0, x) <= c2 * (x - x0)
}

theorem interval_inf_le_interval_sup(f: Real -> Real, x: Real, y: Real, lb: Real, ub: Real) {
    x <= y and (forall(t: Real) { interval_contains(x, y, t) implies lb <= f(t) }) and (forall(t: Real) { interval_contains(x, y, t) implies f(t) <= ub })
    implies interval_inf(f, x, y) <= interval_sup(f, x, y)
}

theorem partition_step_lower_le_upper(f: Real -> Real, p: Nat -> Real, a: Real, b: Real, n: Nat, k: Nat, lb: Real, ub: Real) {
    a <= b and is_partition(p, a, b, n) and k < n and (forall(t: Real) { interval_contains(a, b, t) implies lb <= f(t) }) and (forall(t: Real) { interval_contains(a, b, t) implies f(t) <= ub })
    implies partition_step_lower(f, p, k) <= partition_step_upper(f, p, k)
}

theorem lower_sum_le_upper_sum(f: Real -> Real, p: Nat -> Real, a: Real, b: Real, n: Nat, lb: Real, ub: Real) {
    a <= b and is_partition(p, a, b, n) and (forall(t: Real) { interval_contains(a, b, t) implies lb <= f(t) }) and (forall(t: Real) { interval_contains(a, b, t) implies f(t) <= ub })
    implies lower_sum(f, p, n) <= upper_sum(f, p, n)
}

theorem partition_step_lower_le_ub_width(f: Real -> Real, p: Nat -> Real, a: Real, b: Real, n: Nat, k: Nat, lb: Real, ub: Real) {
    a <= b and is_partition(p, a, b, n) and k < n and (forall(t: Real) { interval_contains(a, b, t) implies lb <= f(t) }) and (forall(t: Real) { interval_contains(a, b, t) implies f(t) <= ub })
    implies partition_step_lower(f, p, k) <= ub * diff_step(p, k)
}

theorem lower_sum_le_ub_width(f: Real -> Real, p: Nat -> Real, a: Real, b: Real, n: Nat, lb: Real, ub: Real) {
    a <= b and is_partition(p, a, b, n) and (forall(t: Real) { interval_contains(a, b, t) implies lb <= f(t) }) and (forall(t: Real) { interval_contains(a, b, t) implies f(t) <= ub })
    implies lower_sum(f, p, n) <= ub * (b - a)
}

theorem partition_step_upper_ge_lb_width(f: Real -> Real, p: Nat -> Real, a: Real, b: Real, n: Nat, k: Nat, lb: Real, ub: Real) {
    a <= b and is_partition(p, a, b, n) and k < n and (forall(t: Real) { interval_contains(a, b, t) implies lb <= f(t) }) and (forall(t: Real) { interval_contains(a, b, t) implies f(t) <= ub })
    implies lb * diff_step(p, k) <= partition_step_upper(f, p, k)
}

theorem lb_width_le_upper_sum(f: Real -> Real, p: Nat -> Real, a: Real, b: Real, n: Nat, lb: Real, ub: Real) {
    a <= b and is_partition(p, a, b, n) and (forall(t: Real) { interval_contains(a, b, t) implies lb <= f(t) }) and (forall(t: Real) { interval_contains(a, b, t) implies f(t) <= ub })
    implies lb * (b - a) <= upper_sum(f, p, n)
}

theorem lower_sum_set_bounded_above(f: Real -> Real, a: Real, b: Real, lb: Real, ub: Real) {
    a <= b and (forall(t: Real) { interval_contains(a, b, t) implies lb <= f(t) }) and (forall(t: Real) { interval_contains(a, b, t) implies f(t) <= ub })
    implies is_set_upper_bound(lower_sum_set(f, a, b), ub * (b - a))
}

theorem upper_sum_set_bounded_below(f: Real -> Real, a: Real, b: Real, lb: Real, ub: Real) {
    a <= b and (forall(t: Real) { interval_contains(a, b, t) implies lb <= f(t) }) and (forall(t: Real) { interval_contains(a, b, t) implies f(t) <= ub })
    implies is_set_lower_bound(upper_sum_set(f, a, b), lb * (b - a))
}

theorem lower_sum_set_sup_exists_of_bounded(f: Real -> Real, a: Real, b: Real, lb: Real, ub: Real) {
    a <= b and (forall(t: Real) { interval_contains(a, b, t) implies lb <= f(t) }) and (forall(t: Real) { interval_contains(a, b, t) implies f(t) <= ub })
    implies exists(l: Real) {
        is_set_supremum(lower_sum_set(f, a, b), l)
    }
}

theorem upper_sum_set_inf_exists_of_bounded(f: Real -> Real, a: Real, b: Real, lb: Real, ub: Real) {
    a <= b and (forall(t: Real) { interval_contains(a, b, t) implies lb <= f(t) }) and (forall(t: Real) { interval_contains(a, b, t) implies f(t) <= ub })
    implies exists(u: Real) {
        is_set_infimum(upper_sum_set(f, a, b), u)
    }
}

define darboux_partition_exists(f: Real -> Real, a: Real, b: Real, eps: Real) -> Bool {
    exists(p: Nat -> Real, n: Nat) {
        is_partition(p, a, b, n) and upper_sum(f, p, n) - lower_sum(f, p, n) < eps
    }
}

define darboux_condition(f: Real -> Real, a: Real, b: Real) -> Bool {
    forall(eps: Real) {
        eps.is_positive implies darboux_partition_exists(f, a, b, eps)
    }
}

theorem darboux_eps_imp_inf_le_sup(f: Real -> Real, a: Real, b: Real, l: Real, u: Real) {
    is_set_supremum(lower_sum_set(f, a, b), l) and is_set_infimum(upper_sum_set(f, a, b), u) and darboux_condition(f, a, b)
    implies u <= l
}

theorem darboux_criterion(f: Real -> Real, a: Real, b: Real, lb: Real, ub: Real) {
    a <= b and (forall(t: Real) { interval_contains(a, b, t) implies lb <= f(t) }) and (forall(t: Real) { interval_contains(a, b, t) implies f(t) <= ub }) and darboux_condition(f, a, b) and (forall(l: Real, u: Real) {
        is_set_supremum(lower_sum_set(f, a, b), l) and is_set_infimum(upper_sum_set(f, a, b), u)
        implies l <= u
    })
    implies is_integrable(f, a, b)
}

theorem exists_n_frac_lt(c: Real, d: Real) {
    d.is_positive implies exists(n: Nat) {
        c / from_nat[Real](n.suc) < d
    }
}

theorem uniform_cell_oscillation(f: Real -> Real, a: Real, b: Real, n: Nat, i: Nat, delta: Real, eps1: Real) {
    a <= b and i < n.suc and delta.is_positive and eps1.is_positive and uniform_condition(f, delta, eps1) and (b - a) / from_nat[Real](n.suc) < delta
    implies interval_sup(f, uniform_partition(a, b, n, i), uniform_partition(a, b, n, i + 1)) - interval_inf(f, uniform_partition(a, b, n, i), uniform_partition(a, b, n, i + 1)) <= two * eps1
}

theorem uniform_upper_minus_lower_osc(f: Real -> Real, a: Real, b: Real, n: Nat, delta: Real, eps1: Real) {
    a <= b and delta.is_positive and eps1.is_positive and uniform_condition(f, delta, eps1) and (b - a) / from_nat[Real](n.suc) < delta
    implies upper_sum(f, uniform_partition(a, b, n), n.suc) - lower_sum(f, uniform_partition(a, b, n), n.suc) <= two * eps1 * (b - a)
}

theorem uniform_bounded_imp_darboux_condition(f: Real -> Real, a: Real, b: Real, lb: Real, ub: Real) {
    a <= b and uniform(f) and
    (forall(t: Real) { interval_contains(a, b, t) implies lb <= f(t) }) and
    (forall(t: Real) { interval_contains(a, b, t) implies f(t) <= ub })
    implies
    darboux_condition(f, a, b)
}

theorem uniform_bounded_integrable(f: Real -> Real, a: Real, b: Real, lb: Real, ub: Real) {
    a <= b and uniform(f) and
    (forall(t: Real) { interval_contains(a, b, t) implies lb <= f(t) }) and
    (forall(t: Real) { interval_contains(a, b, t) implies f(t) <= ub }) and
    (forall(l: Real, u: Real) {
        is_set_supremum(lower_sum_set(f, a, b), l) and is_set_infimum(upper_sum_set(f, a, b), u)
        implies l <= u
    })
    implies
    is_integrable(f, a, b)
}

define discontinuity_set(f: Real -> Real) -> Set[Real] {
    Set[Real].new(function(x: Real) {
        not continuous_at(f, x)
    })
}

theorem interior_constant_inf_le_c(f: Real -> Real, a: Real, b: Real, c: Real, x: Real, y: Real, lb: Real) {
    a <= x and x < y and y <= b and
    (forall(t: Real) { a < t and t < b implies f(t) = c }) and
    (forall(t: Real) { interval_contains(a, b, t) implies lb <= f(t) })
    implies
    interval_inf(f, x, y) <= c
}

theorem interior_constant_c_le_sup(f: Real -> Real, a: Real, b: Real, c: Real, x: Real, y: Real, ub: Real) {
    a <= x and x < y and y <= b and
    (forall(t: Real) { a < t and t < b implies f(t) = c }) and
    (forall(t: Real) { interval_contains(a, b, t) implies f(t) <= ub })
    implies
    c <= interval_sup(f, x, y)
}

theorem interior_constant_step_lower_le_c_width(f: Real -> Real, p: Nat -> Real, a: Real, b: Real, n: Nat, k: Nat, c: Real, lb: Real, ub: Real) {
    a <= b and is_partition(p, a, b, n) and k < n and
    (forall(t: Real) { a < t and t < b implies f(t) = c }) and
    (forall(t: Real) { interval_contains(a, b, t) implies lb <= f(t) }) and
    (forall(t: Real) { interval_contains(a, b, t) implies f(t) <= ub })
    implies
    partition_step_lower(f, p, k) <= c * diff_step(p, k)
}

theorem interior_constant_step_upper_ge_c_width(f: Real -> Real, p: Nat -> Real, a: Real, b: Real, n: Nat, k: Nat, c: Real, lb: Real, ub: Real) {
    a <= b and is_partition(p, a, b, n) and k < n and
    (forall(t: Real) { a < t and t < b implies f(t) = c }) and
    (forall(t: Real) { interval_contains(a, b, t) implies lb <= f(t) }) and
    (forall(t: Real) { interval_contains(a, b, t) implies f(t) <= ub })
    implies
    c * diff_step(p, k) <= partition_step_upper(f, p, k)
}

theorem interior_constant_lower_sum_le_c_width(f: Real -> Real, p: Nat -> Real, a: Real, b: Real, n: Nat, c: Real, lb: Real, ub: Real) {
    a <= b and is_partition(p, a, b, n) and
    (forall(t: Real) { a < t and t < b implies f(t) = c }) and
    (forall(t: Real) { interval_contains(a, b, t) implies lb <= f(t) }) and
    (forall(t: Real) { interval_contains(a, b, t) implies f(t) <= ub })
    implies
    lower_sum(f, p, n) <= c * (b - a)
}

theorem interior_constant_c_width_le_upper_sum(f: Real -> Real, p: Nat -> Real, a: Real, b: Real, n: Nat, c: Real, lb: Real, ub: Real) {
    a <= b and is_partition(p, a, b, n) and
    (forall(t: Real) { a < t and t < b implies f(t) = c }) and
    (forall(t: Real) { interval_contains(a, b, t) implies lb <= f(t) }) and
    (forall(t: Real) { interval_contains(a, b, t) implies f(t) <= ub })
    implies
    c * (b - a) <= upper_sum(f, p, n)
}

theorem bounded_step_upper_minus_lower_le_width(f: Real -> Real, p: Nat -> Real, a: Real, b: Real, n: Nat, k: Nat, lb: Real, ub: Real) {
    a <= b and is_partition(p, a, b, n) and k < n and
    (forall(t: Real) { interval_contains(a, b, t) implies lb <= f(t) }) and
    (forall(t: Real) { interval_contains(a, b, t) implies f(t) <= ub })
    implies
    partition_step_upper(f, p, k) - partition_step_lower(f, p, k) <= (ub - lb) * diff_step(p, k)
}

theorem uniform_interior_cell_constant(f: Real -> Real, a: Real, b: Real, m: Nat, i: Nat, c: Real) {
    a < b and Nat.1 <= i and i + 1 <= m and
    (forall(t: Real) { a < t and t < b implies f(t) = c })
    implies
    interval_inf(f, uniform_partition(a, b, m, i), uniform_partition(a, b, m, i + 1)) = c and
        interval_sup(f, uniform_partition(a, b, m, i), uniform_partition(a, b, m, i + 1)) = c
}
