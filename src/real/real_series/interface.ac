theorem convex_weighted_inequality(f: Real -> Real, a: Real, b: Real, x: Real, y: Real, t: Real) {
    convex_on(f, a, b) and a <= x and x <= b and a <= y and y <= b and Real.0 <= t and t <= Real.1
    implies f(t * x + (Real.1 - t) * y) <= t * f(x) + (Real.1 - t) * f(y)
}

