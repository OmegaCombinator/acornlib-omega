theorem eventually_abs_le_geometric_absolutely_converges(f: Nat -> Real, c: Real, r: Real, n: Nat) {
    Real.0 <= c
    and Real.0 <= r
    and r < Real.1
    and (forall(k: Nat) { n <= k implies abs_fn(f)(k) <= geometric_majorant(c, r, k) })
