theorem neg_part_2_nonneg(f: (Nat, Nat) -> Real) {
    nonneg_fn_2(neg_part_2(f))
}

theorem pos_neg_decomposition(f: (Nat, Nat) -> Real, m: Nat, n: Nat) {
