theorem bounded_mul_tail_nonneg_le_geometric_terms_vanish(
    a: Nat -> Real,
    f: Nat -> Real,
    c: Real,
    r: Real,
    n: Nat
) {
    is_bounded_seq(a)
    and Real.0 <= c
    and Real.0 <= r
    and r < Real.1
    and (forall(k: Nat) { Real.0 <= tail(f, n)(k) })
    and (forall(k: Nat) { tail(f, n)(k) <= geometric_majorant(c, r, k) })
    implies vanishes(prod_seq(a, f))
}

theorem tail_nonneg_le_geometric_mul_bounded_terms_vanish(
    f: Nat -> Real,
    a: Nat -> Real,
    c: Real,
    r: Real,
    n: Nat
) {
    is_bounded_seq(a)
    and Real.0 <= c
    and Real.0 <= r
    and r < Real.1
    and (forall(k: Nat) { Real.0 <= tail(f, n)(k) })
    and (forall(k: Nat) { tail(f, n)(k) <= geometric_majorant(c, r, k) })
    implies vanishes(prod_seq(f, a))
}

theorem series_scalar_mul_converges(c: Real, a: Nat -> Real) {
    converges(partial(a)) implies converges(partial(mul_seq(c, a)))
}

theorem series_neg_converges(a: Nat -> Real) {
    converges(partial(a)) implies converges(partial(neg_seq(a)))
}

theorem series_add_converges(a: Nat -> Real, b: Nat -> Real) {
    converges(partial(a)) and converges(partial(b)) implies converges(partial(add_seq(a, b)))
}

theorem series_sub_converges(a: Nat -> Real, b: Nat -> Real) {
    converges(partial(a)) and converges(partial(b)) implies converges(partial(sub_seq(a, b)))
}

theorem series_scalar_add_converges(a: Nat -> Real, b: Nat -> Real, c: Real) {
    converges(partial(a)) and converges(partial(b)) implies
        converges(partial(add_seq(mul_seq(c, a), b)))
}

theorem series_linear_combination_two_converges(a: Nat -> Real, b: Nat -> Real, c: Real, d: Real) {
    converges(partial(a)) and converges(partial(b)) implies
        converges(partial(add_seq(mul_seq(c, a), mul_seq(d, b))))
}

theorem series_difference_of_scalar_muls_converges(a: Nat -> Real, b: Nat -> Real, c: Real, d: Real) {
    converges(partial(a)) and converges(partial(b)) implies
        converges(partial(sub_seq(mul_seq(c, a), mul_seq(d, b))))
}

theorem series_scalar_mul_absolutely_converges(c: Real, a: Nat -> Real) {
    absolutely_converges(a) implies absolutely_converges(mul_seq(c, a))
}

theorem series_neg_absolutely_converges(a: Nat -> Real) {
    absolutely_converges(a) implies absolutely_converges(neg_seq(a))
}

theorem series_add_absolutely_converges(a: Nat -> Real, b: Nat -> Real) {
    absolutely_converges(a) and absolutely_converges(b) implies absolutely_converges(add_seq(a, b))
}

theorem series_sub_absolutely_converges(a: Nat -> Real, b: Nat -> Real) {
    absolutely_converges(a) and absolutely_converges(b) implies absolutely_converges(sub_seq(a, b))
}

theorem series_scalar_add_absolutely_converges(a: Nat -> Real, b: Nat -> Real, c: Real) {
    absolutely_converges(a) and absolutely_converges(b) implies
        absolutely_converges(add_seq(mul_seq(c, a), b))
}

theorem series_linear_combination_two_absolutely_converges(a: Nat -> Real, b: Nat -> Real, c: Real, d: Real) {
    absolutely_converges(a) and absolutely_converges(b) implies
        absolutely_converges(add_seq(mul_seq(c, a), mul_seq(d, b)))
}

theorem series_difference_of_scalar_muls_absolutely_converges(
    a: Nat -> Real,
    b: Nat -> Real,
    c: Real,
    d: Real
) {
    absolutely_converges(a) and absolutely_converges(b) implies
        absolutely_converges(sub_seq(mul_seq(c, a), mul_seq(d, b)))
}

theorem series_sub_converges_of_tails(a: Nat -> Real, b: Nat -> Real, n: Nat) {
    converges(partial(tail(a, n))) and converges(partial(tail(b, n))) implies
        converges(partial(sub_seq(a, b)))
}

theorem series_linear_combination_two_converges_of_tails(
    a: Nat -> Real,
    b: Nat -> Real,
    c: Real,
    d: Real,
    n: Nat
) {
    converges(partial(tail(a, n))) and converges(partial(tail(b, n))) implies
        converges(partial(add_seq(mul_seq(c, a), mul_seq(d, b))))
}

theorem series_sub_absolutely_converges_of_tails(a: Nat -> Real, b: Nat -> Real, n: Nat) {
    absolutely_converges(tail(a, n)) and absolutely_converges(tail(b, n)) implies
        absolutely_converges(sub_seq(a, b))
}

theorem series_linear_combination_two_absolutely_converges_of_tails(
    a: Nat -> Real,
    b: Nat -> Real,
    c: Real,
    d: Real,
    n: Nat
) {
    absolutely_converges(tail(a, n)) and absolutely_converges(tail(b, n)) implies
        absolutely_converges(add_seq(mul_seq(c, a), mul_seq(d, b)))
}

define is_nonempty(s: Set[Real]) -> Bool {
    exists(x: Real) {
        s.contains(x)
    }
}

define is_set_upper_bound(s: Set[Real], b: Real) -> Bool {
    forall(x: Real) {
        s.contains(x) implies x <= b
    }
}

define has_upper_bound(s: Set[Real]) -> Bool {
    exists(b: Real) {
        is_set_upper_bound(s, b)
    }
}

define is_set_lower_bound(s: Set[Real], b: Real) -> Bool {
    forall(x: Real) {
        s.contains(x) implies b <= x
    }
}

attributes Real {
    /// True if this real number is an upper bound for the set s.
    define is_set_upper_bound(self, s: Real -> Bool) -> Bool {
        forall(y: Real) {
            s(y) implies y <= self
        }
    }

    /// True if this real number is a lower bound for the set s.
    define is_set_lower_bound(self, s: Real -> Bool) -> Bool {
        forall(y: Real) {
            s(y) implies self <= y
        }
    }

    /// True if this real number is the least upper bound (supremum) for the set s.
    define is_set_least_upper_bound(self, s: Real -> Bool) -> Bool {
        self.is_set_upper_bound(s) and
        forall(y: Real) {
            y.is_set_upper_bound(s) implies self <= y
        }
    }

    /// True if this real number is the greatest lower bound (infimum) for the set s.
    define is_set_greatest_lower_bound(self, s: Real -> Bool) -> Bool {
        self.is_set_lower_bound(s) and
        forall(y: Real) {
            y.is_set_lower_bound(s) implies y <= self
        }
    }
}

define sup_cut(s: Real -> Bool, r: Rat) -> Bool {
    not Real.from_rat(r).is_set_upper_bound(s)
}

theorem sup_cut_is_cut(s: Real -> Bool, ub: Real) {
    is_nonempty_pred(s) and ub.is_set_upper_bound(s)
    implies
    is_cut(sup_cut(s))
}

theorem sup_cut_is_lower(s: Real -> Bool, ub: Real) {
    is_nonempty_pred(s) and ub.is_set_upper_bound(s)
    implies
    is_lower(sup_cut(s))
}

theorem sup_cut_not_has_greatest(s: Real -> Bool, ub: Real) {
    is_nonempty_pred(s) and ub.is_set_upper_bound(s)
    implies
    not has_greatest(sup_cut(s))
}

theorem sup_cut_is_dedekind_cut(s: Real -> Bool, ub: Real) {
    is_nonempty_pred(s) and ub.is_set_upper_bound(s)
    implies
    is_dedekind_cut(sup_cut(s))
}

theorem ub_imp_lub(s: Real -> Bool, x: Real) {
    is_nonempty_pred(s) and x.is_set_upper_bound(s)
    implies exists(y: Real) {
        y.is_set_least_upper_bound(s)
    }
}

theorem lb_imp_flip_ub(f: Real -> Bool, x: Real) {
    x.is_set_lower_bound(f) implies (-x).is_set_upper_bound(flip(f))
}

theorem ub_imp_flip_lb(f: Real -> Bool, x: Real) {
    x.is_set_upper_bound(f) implies (-x).is_set_lower_bound(flip(f))
}

theorem glb_imp_flip_lub(f: Real -> Bool, x: Real) {
    x.is_set_greatest_lower_bound(f)
    implies (-x).is_set_least_upper_bound(flip(f))
}

theorem lub_imp_flip_glb(f: Real -> Bool, x: Real) {
    x.is_set_least_upper_bound(f)
    implies (-x).is_set_greatest_lower_bound(flip(f))
}

theorem lb_imp_glb(s: Real -> Bool, x: Real) {
    is_nonempty_pred(s) and x.is_set_lower_bound(s)
    implies exists(y: Real) {
        y.is_set_greatest_lower_bound(s)
    }
}

theorem ub_imp_image_ub(a: Nat -> Real, b: Real) {
    is_upper_bound(a, b)
    implies b.is_set_upper_bound(image(a))
}

define is_set_supremum(s: Set[Real], sup: Real) -> Bool {
    is_set_upper_bound(s, sup) and
    forall(b: Real) {
        is_set_upper_bound(s, b) implies sup <= b
    }
}

define is_set_infimum(s: Set[Real], inf: Real) -> Bool {
    is_set_lower_bound(s, inf) and
    forall(b: Real) {
        is_set_lower_bound(s, b) implies b <= inf
    }
}

theorem set_supremum_is_upper_bound(s: Set[Real], sup: Real) {
    is_set_supremum(s, sup) implies is_set_upper_bound(s, sup)
}

theorem set_upper_bound_contains_le(s: Set[Real], bound: Real, x: Real) {
    is_set_upper_bound(s, bound) and s.contains(x) implies x <= bound
}

theorem set_supremum_le_upper_bound(s: Set[Real], sup: Real, bound: Real) {
    is_set_supremum(s, sup) and is_set_upper_bound(s, bound) implies sup <= bound
}

theorem set_member_le_supremum(s: Set[Real], sup: Real, x: Real) {
    is_set_supremum(s, sup) and s.contains(x) implies x <= sup
}

theorem set_bound_below_supremum_not_upper(s: Set[Real], sup: Real, bound: Real) {
    is_set_supremum(s, sup) and bound < sup implies not is_set_upper_bound(s, bound)
}

theorem set_not_upper_bound_witness(s: Set[Real], bound: Real) {
    not is_set_upper_bound(s, bound) implies exists(x: Real) {
        s.contains(x) and not x <= bound
    }
}

theorem set_supremum_close_from_below(s: Set[Real], sup: Real, eps: Real) {
    is_set_supremum(s, sup) and eps.is_positive implies exists(x: Real) {
        s.contains(x) and sup - eps < x and x <= sup and x.is_close(sup, eps)
    }
}

theorem completeness(s: Set[Real]) {
    is_nonempty(s) and has_upper_bound(s)
    implies
    exists(sup: Real) {
        is_set_supremum(s, sup)
    }
}

theorem supremum_exists_for_subset(s: Set[Real], t: Set[Real], sup_t: Real) {
    s.subset(t) and is_nonempty(s) and is_set_supremum(t, sup_t)
    implies
    exists(sup_s: Real) {
        is_set_supremum(s, sup_s)
    }
}

theorem supremum_subset_le(s: Set[Real], t: Set[Real], sup_s: Real, sup_t: Real) {
    s.subset(t) and is_set_supremum(s, sup_s) and is_set_supremum(t, sup_t)
    implies
    sup_s <= sup_t
}

theorem supremum_union_max(s: Set[Real], t: Set[Real], sup_s: Real, sup_t: Real) {
    is_set_supremum(s, sup_s) and is_set_supremum(t, sup_t)
    implies
    is_set_supremum(s.union(t), sup_s.max(sup_t))
}

define setwise_add_contains(s: Set[Real], t: Set[Real], x: Real) -> Bool {
    exists(a: Real, b: Real) {
        s.contains(a) and t.contains(b) and x = a + b
    }
}

define setwise_add(s: Set[Real], t: Set[Real]) -> Set[Real] {
    Set[Real].new(setwise_add_contains(s, t))
}

theorem setwise_add_contains_iff(s: Set[Real], t: Set[Real], x: Real) {
    setwise_add(s, t).contains(x) = setwise_add_contains(s, t, x)
}

theorem setwise_add_membership(s: Set[Real], t: Set[Real], a: Real, b: Real) {
    s.contains(a) and t.contains(b)
    implies
    setwise_add(s, t).contains(a + b)
}

theorem supremum_setwise_add(s: Set[Real], t: Set[Real], sup_s: Real, sup_t: Real) {
    is_set_supremum(s, sup_s) and is_set_supremum(t, sup_t)
    implies
    is_set_supremum(setwise_add(s, t), sup_s + sup_t)
}

define negate_set_contains(s: Set[Real], x: Real) -> Bool {
    exists(a: Real) {
        s.contains(a) and x = -a
    }
}

define negate_set(s: Set[Real]) -> Set[Real] {
    Set[Real].new(negate_set_contains(s))
}

theorem supremum_infimum_duality(s: Set[Real], sup_s: Real) {
    is_set_supremum(s, sup_s)
    implies
    is_set_infimum(negate_set(s), -sup_s)
}

define scalar_contains(alpha: Real, s: Set[Real], x: Real) -> Bool {
    exists(a: Real) {
        s.contains(a) and x = alpha * a
    }
}

define scalar_mult(alpha: Real, s: Set[Real]) -> Set[Real] {
    Set[Real].new(scalar_contains(alpha, s))
}

theorem scalar_mult_contains_iff(alpha: Real, s: Set[Real], x: Real) {
    scalar_mult(alpha, s).contains(x) = scalar_contains(alpha, s, x)
}

theorem scalar_mult_witness(alpha: Real, s: Set[Real], x: Real) {
    scalar_mult(alpha, s).contains(x)
    implies
    exists(a: Real) {
        s.contains(a) and x = alpha * a
    }
}

theorem scalar_mult_membership(alpha: Real, s: Set[Real], a: Real) {
    s.contains(a)
    implies
    scalar_mult(alpha, s).contains(alpha * a)
}

theorem mul_supremum_le(alpha: Real, s: Set[Real], sup_s: Real, ub: Real) {
    alpha >= Real.0 and is_set_supremum(s, sup_s) and is_nonempty(s) and
    (forall(a: Real) { s.contains(a) implies alpha * a <= ub })
    implies
    alpha * sup_s <= ub
}

theorem supremum_scalar_mult(alpha: Real, s: Set[Real], sup_s: Real) {
    alpha >= Real.0 and is_nonempty(s) and is_set_supremum(s, sup_s)
    implies
    is_set_supremum(scalar_mult(alpha, s), alpha * sup_s)
}

theorem supremum_scalar_mult_neg(alpha: Real, s: Set[Real], inf_s: Real) {
    alpha < Real.0 and is_nonempty(s) and is_set_infimum(s, inf_s)
    implies
    is_set_supremum(scalar_mult(alpha, s), alpha * inf_s)
}

define seq_image(a: Nat -> Real) -> Set[Real] {
    set_image(Set[Nat].universal_set, a)
}

theorem seq_image_contains_iff(a: Nat -> Real, x: Real) {
    seq_image(a).contains(x) = image(a, x)
}

theorem monotone_convergence_seq(a: Nat -> Real, b: Real) {
    is_increasing(a) and is_upper_bound(a, b)
    implies
    is_set_supremum(seq_image(a), limit(a))
}

define is_nondecreasing(f: Real -> Real) -> Bool {
    forall(x: Real, y: Real) {
        x <= y implies f(x) <= f(y)
    }
}

theorem monotone_is_nondecreasing(f: Real -> Real) {
    is_monotone(f) implies is_nondecreasing(f)
}

define function_image_contains(f: Real -> Real, s: Set[Real], y: Real) -> Bool {
    image_contains(f, s, y)
}

define function_image(f: Real -> Real, s: Set[Real]) -> Set[Real] {
    set_image(s, f)
}

theorem function_image_contains_iff(f: Real -> Real, s: Set[Real], y: Real) {
    function_image(f, s).contains(y) = function_image_contains(f, s, y)
}

theorem function_image_compose(f: Real -> Real, g: Real -> Real, s: Set[Real]) {
    function_image(f, function_image(g, s)) = function_image(compose(f, g), s)
}

theorem supremum_order_preserving(f: Real -> Real, s: Set[Real], sup_s: Real) {
    is_nondecreasing(f) and is_set_supremum(s, sup_s) and is_nonempty(function_image(f, s))
    implies
    exists(sup_fs: Real) {
        is_set_supremum(function_image(f, s), sup_fs) and sup_fs <= f(sup_s)
    }
}

theorem supremum_monotone_image_le(f: Real -> Real, s: Set[Real], sup_s: Real) {
    is_monotone(f) and is_set_supremum(s, sup_s) and is_nonempty(function_image(f, s))
    implies
    exists(sup_fs: Real) {
        is_set_supremum(function_image(f, s), sup_fs) and sup_fs <= f(sup_s)
    }
}

define double_sum_bounded(f: (Nat, Nat) -> Real, a: Real, n: Nat, eps: Real) -> Bool {
    double_limit_condition(rectangular_sum(f), a, n, eps)
}

define double_sum_converges_to(f: (Nat, Nat) -> Real, a: Real) -> Bool {
    double_converges_to(rectangular_sum(f), a)
}

define double_sum_converges(f: (Nat, Nat) -> Real) -> Bool {
    double_converges(rectangular_sum(f))
}

define double_sum(f: (Nat, Nat) -> Real) -> Real {
    double_limit(rectangular_sum(f))
}

define row_infinite_sum(f: (Nat, Nat) -> Real, i: Nat) -> Real {
    limit(partial(f(i)))
}

define col_infinite_sum(f: (Nat, Nat) -> Real, j: Nat) -> Real {
    limit(partial(flip(f, j)))
}

define row_sums_seq(f: (Nat, Nat) -> Real, i: Nat) -> Real {
    row_infinite_sum(f, i)
}

define col_sums_seq(f: (Nat, Nat) -> Real, j: Nat) -> Real {
    col_infinite_sum(f, j)
}

define square_sum(f: (Nat, Nat) -> Real, n: Nat) -> Real {
    rectangular_sum(f, n, n)
}

define square_sum_seq(f: (Nat, Nat) -> Real, n: Nat) -> Real {
    square_sum(f, n)
}

theorem row_partial_increasing(f: (Nat, Nat) -> Real, i: Nat) {
    nonneg_fn_2(f)
    implies
    is_increasing(partial(f(i)))
}

theorem row_partial_monotone(f: (Nat, Nat) -> Real, i: Nat) {
    nonneg_fn_2(f)
    implies
    is_monotone(partial(f(i)))
}

theorem col_partial_increasing(f: (Nat, Nat) -> Real, j: Nat) {
    nonneg_fn_2(f)
    implies
    is_increasing(partial(flip(f, j)))
}

theorem col_partial_monotone(f: (Nat, Nat) -> Real, j: Nat) {
    nonneg_fn_2(f)
    implies
    is_monotone(partial(flip(f, j)))
}

theorem square_sum_is_increasing(f: (Nat, Nat) -> Real) {
    nonneg_fn_2(f)
    implies
    is_increasing(square_sum_seq(f))
}

theorem square_sum_is_monotone(f: (Nat, Nat) -> Real) {
    nonneg_fn_2(f)
    implies
    is_monotone(square_sum_seq(f))
}

theorem row_sum_bounded_by_infinite(f: (Nat, Nat) -> Real, i: Nat, n: Nat) {
    nonneg_fn_2(f) and converges(partial(f(i)))
    implies
    row_sum(f, n, i) <= row_infinite_sum(f, i)
}

theorem col_sum_bounded_by_infinite(f: (Nat, Nat) -> Real, j: Nat, m: Nat) {
    nonneg_fn_2(f) and converges(partial(flip(f, j)))
    implies
    col_sum(f, m, j) <= col_infinite_sum(f, j)
}

theorem rectangular_sum_bounded_by_row_sums(f: (Nat, Nat) -> Real, m: Nat, n: Nat) {
    nonneg_fn_2(f) and all_rows_converge(f)
    implies
    rectangular_sum(f, m, n) <= partial(row_sums_seq(f), m)
}

theorem rectangular_sum_bounded_by_col_sums(f: (Nat, Nat) -> Real, m: Nat, n: Nat) {
    nonneg_fn_2(f) and all_cols_converge(f)
    implies
    rectangular_sum(f, m, n) <= partial(col_sums_seq(f), n)
}

theorem rectangular_sum_succ_row(f: (Nat, Nat) -> Real, k: Nat, n: Nat) {
    rectangular_sum(f, k.suc, n) = rectangular_sum(f, k, n) + row_sum(f, n, k)
}

theorem rectangular_sum_succ_col(f: (Nat, Nat) -> Real, m: Nat, k: Nat) {
    rectangular_sum(f, m, k.suc) = rectangular_sum(f, m, k) + col_sum(f, m, k)
}

theorem row_sum_bounded_by_supremum(f: (Nat, Nat) -> Real, s: Real, i: Nat, n: Nat) {
    nonneg_fn_2(f) and double_image_is_supremum(rectangular_sum(f), s)
    implies
    row_sum(f, n, i) <= s
}

theorem col_sum_bounded_by_supremum(f: (Nat, Nat) -> Real, s: Real, j: Nat, m: Nat) {
    nonneg_fn_2(f) and double_image_is_supremum(rectangular_sum(f), s)
    implies
    col_sum(f, m, j) <= s
}

theorem row_partial_bounded_by_supremum(f: (Nat, Nat) -> Real, s: Real, i: Nat) {
    nonneg_fn_2(f) and double_image_is_supremum(rectangular_sum(f), s)
    implies
    is_upper_bound(partial(f(i)), s)
}

theorem col_partial_bounded_by_supremum(f: (Nat, Nat) -> Real, s: Real, j: Nat) {
    nonneg_fn_2(f) and double_image_is_supremum(rectangular_sum(f), s)
    implies
    is_upper_bound(partial(flip(f, j)), s)
}

theorem row_partial_converges_of_supremum(f: (Nat, Nat) -> Real, s: Real, i: Nat) {
    nonneg_fn_2(f) and double_image_is_supremum(rectangular_sum(f), s)
    implies
    converges(partial(f(i)))
}

theorem col_partial_converges_of_supremum(f: (Nat, Nat) -> Real, s: Real, j: Nat) {
    nonneg_fn_2(f) and double_image_is_supremum(rectangular_sum(f), s)
    implies
    converges(partial(flip(f, j)))
}

theorem all_rows_converge_of_supremum(f: (Nat, Nat) -> Real, s: Real) {
    nonneg_fn_2(f) and double_image_is_supremum(rectangular_sum(f), s)
    implies
    all_rows_converge(f)
}

theorem all_cols_converge_of_supremum(f: (Nat, Nat) -> Real, s: Real) {
    nonneg_fn_2(f) and double_image_is_supremum(rectangular_sum(f), s)
    implies
    all_cols_converge(f)
}

theorem row_limit_rectangular_sum(f: (Nat, Nat) -> Real, m: Nat) {
    all_rows_converge(f)
    implies
    row_limit(rectangular_sum(f), m) = partial(row_sums_seq(f), m)
}

theorem col_limit_rectangular_sum(f: (Nat, Nat) -> Real, n: Nat) {
    all_cols_converge(f)
    implies
    col_limit(rectangular_sum(f), n) = partial(col_sums_seq(f), n)
}

theorem iterated_row_sum_eq_limit(f: (Nat, Nat) -> Real) {
    all_rows_converge(f)
    implies
    iterated_limit_rows(rectangular_sum(f)) = limit(partial(row_sums_seq(f)))
}

