theorem rectangular_sum_split_rows(f: (Nat, Nat) -> Real, m1: Nat, m2: Nat, n: Nat) {
    rectangular_sum(f, m1 + m2, n)
    =
    rectangular_sum(f, m1, n) + rectangular_sum(shift_rows(f, m1), m2, n)
}

theorem rectangular_sum_split_cols(f: (Nat, Nat) -> Real, m: Nat, n1: Nat, n2: Nat) {
    rectangular_sum(f, m, n1 + n2)
    =
    rectangular_sum(f, m, n1) + rectangular_sum(shift_cols(f, n1), m, n2)
}

theorem shift_rows_scale(c: Real, f: (Nat, Nat) -> Real, k: Nat, i: Nat, j: Nat) {
    shift_rows(scalar_mul_fn_2(c, f), k, i, j) = scalar_mul_fn_2(c, shift_rows(f, k), i, j)
}

theorem shift_cols_scale(c: Real, f: (Nat, Nat) -> Real, k: Nat, i: Nat, j: Nat) {
    shift_cols(scalar_mul_fn_2(c, f), k, i, j) = scalar_mul_fn_2(c, shift_cols(f, k), i, j)
}

theorem rectangular_sum_zero_height(f: (Nat, Nat) -> Real, n: Nat) {
    rectangular_sum(f, Nat.0, n) = Real.0
}

theorem rectangular_sum_zero_width(f: (Nat, Nat) -> Real, m: Nat) {
    rectangular_sum(f, m, Nat.0) = Real.0
}

theorem rectangular_sum_succ_rows(f: (Nat, Nat) -> Real, m: Nat, n: Nat) {
    rectangular_sum(f, m.suc, n) = rectangular_sum(f, m, n) + row_sum(f, n, m)
}

theorem rectangular_sum_succ_cols(f: (Nat, Nat) -> Real, m: Nat, n: Nat) {
    rectangular_sum(f, m, n.suc) = rectangular_sum(f, m, n) + col_sum(f, m, n)
}

theorem rectangular_sum_add_distrib(f: (Nat, Nat) -> Real, g: (Nat, Nat) -> Real, m: Nat, n: Nat) {
    rectangular_sum(add_fn_2(f, g), m, n) = rectangular_sum(f, m, n) + rectangular_sum(g, m, n)
}

theorem rectangular_sum_scale_left(c: Real, f: (Nat, Nat) -> Real, m: Nat, n: Nat) {
    rectangular_sum(scalar_mul_fn_2(c, f), m, n) = c * rectangular_sum(f, m, n)
}

theorem rectangular_sum_le_of_lte_fn(f: (Nat, Nat) -> Real, g: (Nat, Nat) -> Real, m: Nat, n: Nat) {
    lte_fn_2(f, g) implies rectangular_sum(f, m, n) <= rectangular_sum(g, m, n)
}

theorem rectangular_sum_bound_above(f: (Nat, Nat) -> Real, bound: Real, m: Nat, n: Nat) {
    nonneg_fn_2(f) and is_upper_bound_fn_2(f, bound)
    implies
    rectangular_sum(f, m, n) <= nat_to_real(m) * nat_to_real(n) * bound
}

theorem rectangular_sum_bound_below(f: (Nat, Nat) -> Real, bound: Real, m: Nat, n: Nat) {
    is_lower_bound_fn_2(f, bound)
    implies
    rectangular_sum(f, m, n) >= nat_to_real(m) * nat_to_real(n) * bound
}

theorem rectangular_sum_rows_split_at(f: (Nat, Nat) -> Real, m1: Nat, m2: Nat, n: Nat) {
    rectangular_sum(f, m1 + m2, n)
    =
    rectangular_sum(f, m1, n) + rectangular_sum(shift_rows(f, m1), m2, n)
}

theorem rectangular_sum_cols_split_at(f: (Nat, Nat) -> Real, m: Nat, n1: Nat, n2: Nat) {
    rectangular_sum(f, m, n1 + n2)
    =
    rectangular_sum(f, m, n1) + rectangular_sum(shift_cols(f, n1), m, n2)
}

define pointwise_product(a: Nat -> Real, b: Nat -> Real, i: Nat) -> Real {
    a(i) * b(i)
}

define pointwise_square(a: Nat -> Real, i: Nat) -> Real {
    a(i) * a(i)
}

define finite_dot(a: Nat -> Real, b: Nat -> Real, n: Nat) -> Real {
    partial(pointwise_product(a, b), n)
}

define finite_square_sum(a: Nat -> Real, n: Nat) -> Real {
    partial(pointwise_square(a), n)
}

theorem finite_dot_symm(a: Nat -> Real, b: Nat -> Real, n: Nat) {
    finite_dot(a, b, n) = finite_dot(b, a, n)
}

theorem finite_dot_zero(a: Nat -> Real, b: Nat -> Real) {
    finite_dot(a, b, Nat.0) = Real.0
}

theorem finite_dot_suc(a: Nat -> Real, b: Nat -> Real, n: Nat) {
    finite_dot(a, b, n.suc) = finite_dot(a, b, n) + a(n) * b(n)
}

theorem finite_square_sum_zero(a: Nat -> Real) {
    finite_square_sum(a, Nat.0) = Real.0
}

theorem finite_square_sum_suc(a: Nat -> Real, n: Nat) {
    finite_square_sum(a, n.suc) = finite_square_sum(a, n) + a(n) * a(n)
}

define lagrange_square(a: Nat -> Real, b: Nat -> Real, i: Nat, j: Nat) -> Real {
    (a(i) * b(j) - a(j) * b(i)) * (a(i) * b(j) - a(j) * b(i))
}

define square_outer(a: Nat -> Real, b: Nat -> Real, i: Nat, j: Nat) -> Real {
    pointwise_square(a, i) * pointwise_square(b, j)
}

define dot_outer(a: Nat -> Real, b: Nat -> Real, i: Nat, j: Nat) -> Real {
    pointwise_product(a, b, i) * pointwise_product(a, b, j)
}

define lagrange_expanded(a: Nat -> Real, b: Nat -> Real, i: Nat, j: Nat) -> Real {
    square_outer(a, b, i, j) + -dot_outer(a, b, i, j) +
        (-dot_outer(a, b, i, j) + square_outer(b, a, i, j))
}

define neg_dot_outer(a: Nat -> Real, b: Nat -> Real, i: Nat, j: Nat) -> Real {
    -dot_outer(a, b, i, j)
}

define lagrange_first(a: Nat -> Real, b: Nat -> Real, i: Nat, j: Nat) -> Real {
    square_outer(a, b, i, j) + neg_dot_outer(a, b, i, j)
}

define lagrange_second(a: Nat -> Real, b: Nat -> Real, i: Nat, j: Nat) -> Real {
    neg_dot_outer(a, b, i, j) + square_outer(b, a, i, j)
}

define lagrange_pair(a: Nat -> Real, b: Nat -> Real, i: Nat, j: Nat) -> Real {
    lagrange_first(a, b, i, j) + lagrange_second(a, b, i, j)
}

theorem pointwise_square_nonnegative(a: Nat -> Real, i: Nat) {
    pointwise_square(a, i) >= Real.0
}

theorem finite_square_sum_nonnegative(a: Nat -> Real, n: Nat) {
    finite_square_sum(a, n) >= Real.0
}

theorem lagrange_square_nonnegative(a: Nat -> Real, b: Nat -> Real, i: Nat, j: Nat) {
    lagrange_square(a, b, i, j) >= Real.0
}

theorem lagrange_square_sum_nonnegative(a: Nat -> Real, b: Nat -> Real, n: Nat) {
    rectangular_sum(lagrange_square(a, b), n, n) >= Real.0
}

theorem real_square_add_expanded(x: Real, y: Real) {
    (x + y) * (x + y) = x * x + x * y + (x * y + y * y)
}

theorem product_pair_square_rearrange(x: Real, y: Real) {
    (x * y) * (x * y) = (x * x) * (y * y)
}

theorem product_cross_rearrange(w: Real, x: Real, y: Real, z: Real) {
    (w * x) * (y * z) = (w * z) * (y * x)
}

theorem lagrange_square_eq_expanded(a: Nat -> Real, b: Nat -> Real, i: Nat, j: Nat) {
    lagrange_square(a, b, i, j) = lagrange_expanded(a, b, i, j)
}

theorem row_sum_pointwise_eq(
    f: (Nat, Nat) -> Real, g: (Nat, Nat) -> Real, i: Nat, n: Nat
) {
    (forall(j: Nat) {
        j < n implies f(i, j) = g(i, j)
    }) implies row_sum(f, n, i) = row_sum(g, n, i)
}

theorem rectangular_sum_row_eq(
    f: (Nat, Nat) -> Real, g: (Nat, Nat) -> Real, m: Nat, n: Nat
) {
    (forall(i: Nat) {
        i < m implies row_sum(f, n, i) = row_sum(g, n, i)
    }) implies rectangular_sum(f, m, n) = rectangular_sum(g, m, n)
}

theorem rectangular_sum_pointwise_eq(
    f: (Nat, Nat) -> Real, g: (Nat, Nat) -> Real, m: Nat, n: Nat
) {
    (forall(i: Nat, j: Nat) {
        i < m and j < n implies f(i, j) = g(i, j)
    }) implies rectangular_sum(f, m, n) = rectangular_sum(g, m, n)
}

theorem square_outer_sum_factors(a: Nat -> Real, b: Nat -> Real, n: Nat) {
    rectangular_sum(square_outer(a, b), n, n) =
        finite_square_sum(a, n) * finite_square_sum(b, n)
}

theorem dot_outer_sum_factors(a: Nat -> Real, b: Nat -> Real, n: Nat) {
    rectangular_sum(dot_outer(a, b), n, n) = finite_dot(a, b, n) * finite_dot(a, b, n)
}

theorem neg_dot_outer_sum(a: Nat -> Real, b: Nat -> Real, n: Nat) {
    rectangular_sum(neg_dot_outer(a, b), n, n) = -rectangular_sum(dot_outer(a, b), n, n)
}

theorem lagrange_first_sum(a: Nat -> Real, b: Nat -> Real, n: Nat) {
    rectangular_sum(lagrange_first(a, b), n, n) =
        finite_square_sum(a, n) * finite_square_sum(b, n) +
            -(finite_dot(a, b, n) * finite_dot(a, b, n))
}

theorem lagrange_second_sum(a: Nat -> Real, b: Nat -> Real, n: Nat) {
    rectangular_sum(lagrange_second(a, b), n, n) =
        finite_square_sum(a, n) * finite_square_sum(b, n) +
            -(finite_dot(a, b, n) * finite_dot(a, b, n))
}

theorem lagrange_pair_sum(a: Nat -> Real, b: Nat -> Real, n: Nat) {
    rectangular_sum(lagrange_pair(a, b), n, n) =
        (finite_square_sum(a, n) * finite_square_sum(b, n) +
            -(finite_dot(a, b, n) * finite_dot(a, b, n))) +
        (finite_square_sum(a, n) * finite_square_sum(b, n) +
            -(finite_dot(a, b, n) * finite_dot(a, b, n)))
}

theorem lagrange_expanded_eq_pair(a: Nat -> Real, b: Nat -> Real, i: Nat, j: Nat) {
    lagrange_expanded(a, b, i, j) = lagrange_pair(a, b, i, j)
}

theorem lagrange_square_sum_eq_gap_double(a: Nat -> Real, b: Nat -> Real, n: Nat) {
    rectangular_sum(lagrange_square(a, b), n, n) =
        (finite_square_sum(a, n) * finite_square_sum(b, n) +
            -(finite_dot(a, b, n) * finite_dot(a, b, n))) +
        (finite_square_sum(a, n) * finite_square_sum(b, n) +
            -(finite_dot(a, b, n) * finite_dot(a, b, n)))
}

theorem double_nonnegative_imp_nonnegative(x: Real) {
    x + x >= Real.0 implies x >= Real.0
}

theorem nonnegative_gap_imp_lte(a: Real, b: Real) {
    a + -b >= Real.0 implies b <= a
}

theorem finite_cauchy_schwarz(a: Nat -> Real, b: Nat -> Real, n: Nat) {
    finite_dot(a, b, n) * finite_dot(a, b, n) <= finite_square_sum(a, n) * finite_square_sum(b, n)
}

define double_limit_condition(f: (Nat, Nat) -> Real, val: Real, n: Nat, eps: Real) -> Bool {
    forall(i: Nat, j: Nat) {
        n <= i and n <= j implies f(i, j).is_close(val, eps)
    }
}

define double_converges_to(f: (Nat, Nat) -> Real, val: Real) -> Bool {
    forall(eps: Real) {
        eps.is_positive implies exists(n: Nat) {
            double_limit_condition(f, val, n, eps)
        }
    }
}

define double_converges(f: (Nat, Nat) -> Real) -> Bool {
    exists(val: Real) {
        double_converges_to(f, val)
    }
}

let double_limit(f: (Nat, Nat) -> Real) -> val: Real satisfy {
    double_converges(f) implies double_converges_to(f, val)
}

theorem doubly_increasing_right_monotone(f: (Nat, Nat) -> Real, i: Nat) {
    doubly_increasing(f) implies is_monotone(function(j: Nat) { f(i, j) })
}

theorem doubly_increasing_left_monotone(f: (Nat, Nat) -> Real, j: Nat) {
    doubly_increasing(f) implies is_monotone(function(i: Nat) { f(i, j) })
}

theorem doubly_increasing_flip_monotone(f: (Nat, Nat) -> Real, j: Nat) {
    doubly_increasing(f) implies is_monotone(function(i: Nat) { flip(f, j, i) })
}

theorem doubly_increasing_bounded_converges(f: (Nat, Nat) -> Real, s: Real) {
    doubly_increasing(f) and double_image_is_supremum(f, s)
    implies
    double_converges_to(f, s)
}

define row_converges(f: (Nat, Nat) -> Real, i: Nat) -> Bool {
    converges(f(i))
}

define row_limit(f: (Nat, Nat) -> Real, i: Nat) -> Real {
    limit(f(i))
}

define col_converges(f: (Nat, Nat) -> Real, j: Nat) -> Bool {
    converges(flip(f, j))
}

define col_limit(f: (Nat, Nat) -> Real, j: Nat) -> Real {
    limit(flip(f, j))
}

define all_rows_converge(f: (Nat, Nat) -> Real) -> Bool {
    forall(i: Nat) {
        row_converges(f, i)
    }
}

define all_cols_converge(f: (Nat, Nat) -> Real) -> Bool {
    forall(j: Nat) {
        col_converges(f, j)
    }
}

define iterated_limit_rows(f: (Nat, Nat) -> Real) -> Real {
    limit(row_limit(f))
}

define iterated_limit_cols(f: (Nat, Nat) -> Real) -> Real {
    limit(col_limit(f))
}

theorem row_limit_unfold(f: (Nat, Nat) -> Real, i: Nat) {
    row_limit(f, i) = limit(f(i))
}

theorem col_limit_unfold(f: (Nat, Nat) -> Real, j: Nat) {
    col_limit(f, j) = limit(flip(f, j))
}

theorem row_converges_unfold(f: (Nat, Nat) -> Real, i: Nat) {
    row_converges(f, i) = converges(f(i))
}

theorem col_converges_unfold(f: (Nat, Nat) -> Real, j: Nat) {
    col_converges(f, j) = converges(flip(f, j))
}

theorem row_sequence_converges(f: (Nat, Nat) -> Real, i: Nat, b: Real) {
    doubly_increasing(f) and double_is_upper_bound(f, b)
    implies
    converges(f(i))
}

theorem col_sequence_converges(f: (Nat, Nat) -> Real, j: Nat, b: Real) {
    doubly_increasing(f) and double_is_upper_bound(f, b)
    implies
    converges(flip(f, j))
}

theorem row_limits_increasing(f: (Nat, Nat) -> Real, b: Real, i: Nat) {
    doubly_increasing(f) and double_is_upper_bound(f, b)
    implies
    limit(f(i)) <= limit(f(i.suc))
}

theorem col_limits_increasing(f: (Nat, Nat) -> Real, b: Real, j: Nat) {
    doubly_increasing(f) and double_is_upper_bound(f, b)
    implies
    limit(flip(f, j)) <= limit(flip(f, j.suc))
}

theorem row_limit_bounded(f: (Nat, Nat) -> Real, i: Nat, b: Real) {
    doubly_increasing(f) and double_is_upper_bound(f, b)
    implies
    limit(f(i)) <= b
}

theorem col_limit_bounded(f: (Nat, Nat) -> Real, j: Nat, b: Real) {
    doubly_increasing(f) and double_is_upper_bound(f, b)
    implies
    limit(flip(f, j)) <= b
}

theorem row_limits_is_increasing(f: (Nat, Nat) -> Real, b: Real) {
    doubly_increasing(f) and double_is_upper_bound(f, b)
    implies
    real_is_increasing(row_limit(f))
}

theorem row_limits_is_monotone(f: (Nat, Nat) -> Real, b: Real) {
    doubly_increasing(f) and double_is_upper_bound(f, b)
    implies
    is_monotone(row_limit(f))
}

theorem col_limits_is_increasing(f: (Nat, Nat) -> Real, b: Real) {
    doubly_increasing(f) and double_is_upper_bound(f, b)
    implies
    real_is_increasing(col_limit(f))
}

theorem col_limits_is_monotone(f: (Nat, Nat) -> Real, b: Real) {
    doubly_increasing(f) and double_is_upper_bound(f, b)
    implies
    is_monotone(col_limit(f))
}

theorem row_limits_bounded(f: (Nat, Nat) -> Real, b: Real) {
    doubly_increasing(f) and double_is_upper_bound(f, b)
    implies
    is_upper_bound(row_limit(f), b)
}

theorem col_limits_bounded(f: (Nat, Nat) -> Real, b: Real) {
    doubly_increasing(f) and double_is_upper_bound(f, b)
    implies
    is_upper_bound(col_limit(f), b)
}

theorem iterated_rows_converges(f: (Nat, Nat) -> Real, b: Real) {
    doubly_increasing(f) and double_is_upper_bound(f, b)
    implies
    converges(row_limit(f))
}

theorem iterated_rows_converges_monotone(f: (Nat, Nat) -> Real, b: Real) {
    doubly_increasing(f) and double_is_upper_bound(f, b)
    implies
    converges(row_limit(f))
}

theorem iterated_cols_converges(f: (Nat, Nat) -> Real, b: Real) {
    doubly_increasing(f) and double_is_upper_bound(f, b)
    implies
    converges(col_limit(f))
}

theorem iterated_cols_converges_monotone(f: (Nat, Nat) -> Real, b: Real) {
    doubly_increasing(f) and double_is_upper_bound(f, b)
    implies
    converges(col_limit(f))
}

theorem iterated_limit_rows_is_upper_bound(f: (Nat, Nat) -> Real, b: Real) {
    doubly_increasing(f) and double_is_upper_bound(f, b)
    implies
    double_is_upper_bound(f, iterated_limit_rows(f))
}

theorem iterated_limit_cols_is_upper_bound(f: (Nat, Nat) -> Real, b: Real) {
    doubly_increasing(f) and double_is_upper_bound(f, b)
    implies
    double_is_upper_bound(f, iterated_limit_cols(f))
}

theorem double_converges_to_unique(f: (Nat, Nat) -> Real, a: Real, b: Real) {
    double_converges_to(f, a) and double_converges_to(f, b)
    implies
    a = b
}

theorem double_limit_eq_of_converges_to(f: (Nat, Nat) -> Real, s: Real) {
    double_converges_to(f, s) implies double_limit(f) = s
}

theorem iterated_limit_rows_eq_supremum(f: (Nat, Nat) -> Real, s: Real) {
    doubly_increasing(f) and double_image_is_supremum(f, s)
    implies
    iterated_limit_rows(f) = s
}

theorem iterated_limit_cols_eq_supremum(f: (Nat, Nat) -> Real, s: Real) {
    doubly_increasing(f) and double_image_is_supremum(f, s)
    implies
    iterated_limit_cols(f) = s
}

theorem monotone_convergence_interchange(f: (Nat, Nat) -> Real, s: Real) {
    doubly_increasing(f) and double_image_is_supremum(f, s)
    implies
    double_limit(f) = s and
    iterated_limit_rows(f) = s and
    iterated_limit_cols(f) = s and
    double_limit(f) = iterated_limit_rows(f) and
    double_limit(f) = iterated_limit_cols(f) and
    iterated_limit_rows(f) = iterated_limit_cols(f)
}

theorem double_limit_add(f: (Nat, Nat) -> Real, g: (Nat, Nat) -> Real) {
    double_converges(f) and double_converges(g)
    implies
    double_converges_to(add_fn_2(f, g), double_limit(f) + double_limit(g))
}

theorem double_limit_sub(f: (Nat, Nat) -> Real, g: (Nat, Nat) -> Real) {
    double_converges(f) and double_converges(g)
    implies
    double_converges_to(sub_fn_2(f, g), double_limit(f) - double_limit(g))
}

define is_eps_adherent_from(a: Nat -> Real, m: Nat, u: Real, eps: Real) -> Bool {
    forall(n_start: Nat) {
        m <= n_start implies exists(n_witness: Nat) {
            n_start <= n_witness and a(n_witness).is_close(u, eps)
        }
    }
}

define is_limit_point_from(a: Nat -> Real, m: Nat, u: Real) -> Bool {
    forall(eps: Real) {
        eps.is_positive implies is_eps_adherent_from(a, m, u, eps)
    }
}

theorem converges_to_has_tail_bound(a: Nat -> Real, u: Real, eps: Real) {
    converges_to(a, u) and eps.is_positive implies exists(n: Nat) {
        tail_bound(a, u, n, eps)
    }
}

theorem tail_bound_imp_eps_adherent_from(a: Nat -> Real, m: Nat, u: Real, eps: Real, n0: Nat) {
    tail_bound(a, u, n0, eps) implies is_eps_adherent_from(a, m, u, eps)
}

theorem converges_to_imp_limit_point_from(a: Nat -> Real, m: Nat, u: Real) {
    converges_to(a, u) implies is_limit_point_from(a, m, u)
}

define seq_in_real_set(s: Set[Real], a: Nat -> Real) -> Bool {
    forall(n: Nat) {
        s.contains(a(n))
    }
}

define seq_eventually_in_real_set(s: Set[Real], a: Nat -> Real) -> Bool {
    exists(n0: Nat) {
        forall(n: Nat) {
            n0 <= n implies s.contains(a(n))
        }
    }
}

define seq_frequently_in_real_set(s: Set[Real], a: Nat -> Real) -> Bool {
    forall(n_start: Nat) {
        exists(n_witness: Nat) {
            n_start <= n_witness and s.contains(a(n_witness))
        }
    }
}

theorem seq_frequently_in_real_set_at(s: Set[Real], a: Nat -> Real, n_start: Nat) {
    seq_frequently_in_real_set(s, a) implies exists(n_witness: Nat) {
        n_start <= n_witness and s.contains(a(n_witness))
    }
}

theorem seq_in_real_set_at(s: Set[Real], a: Nat -> Real, n: Nat) {
    seq_in_real_set(s, a) implies s.contains(a(n))
}

theorem seq_in_real_set_intro(s: Set[Real], a: Nat -> Real) {
    forall(n: Nat) { s.contains(a(n)) } implies seq_in_real_set(s, a)
}

theorem seq_in_real_set_of_subset(s: Set[Real], t: Set[Real], a: Nat -> Real) {
    s.subset(t) and seq_in_real_set(s, a) implies seq_in_real_set(t, a)
}

theorem seq_in_real_set_intersection(s: Set[Real], t: Set[Real], a: Nat -> Real) {
    seq_in_real_set(s, a) and seq_in_real_set(t, a) implies seq_in_real_set(s.intersection(t), a)
}

theorem seq_in_real_set_union_left(s: Set[Real], t: Set[Real], a: Nat -> Real) {
    seq_in_real_set(s, a) implies seq_in_real_set(s.union(t), a)
}

theorem seq_in_real_set_union_right(s: Set[Real], t: Set[Real], a: Nat -> Real) {
    seq_in_real_set(t, a) implies seq_in_real_set(s.union(t), a)
}

theorem seq_in_real_set_eventually(s: Set[Real], a: Nat -> Real) {
    seq_in_real_set(s, a) implies seq_eventually_in_real_set(s, a)
}

theorem seq_in_real_set_frequently(s: Set[Real], a: Nat -> Real) {
