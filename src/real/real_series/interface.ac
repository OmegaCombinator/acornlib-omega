theorem limit_point_union_left(s: Set[Real], t: Set[Real], x: Real) {
    is_limit_point_of_set(s, x) implies is_limit_point_of_set(s.union(t), x)
}

theorem limit_point_union_right(s: Set[Real], t: Set[Real], x: Real) {
    is_limit_point_of_set(t, x) implies is_limit_point_of_set(s.union(t), x)
}

theorem limit_point_union_cases(s: Set[Real], t: Set[Real], x: Real) {
    is_limit_point_of_set(s.union(t), x) implies
        is_limit_point_of_set(s, x) or is_limit_point_of_set(t, x)
}

theorem derived_set_union_superset(s: Set[Real], t: Set[Real]) {
    derived_set(s).union(derived_set(t)).subset(derived_set(s.union(t)))
}

theorem derived_set_union_member_subset(s: Set[Real], t: Set[Real], x: Real) {
    derived_set(s.union(t)).contains(x) implies derived_set(s).union(derived_set(t)).contains(x)
}

theorem derived_set_union_subset(s: Set[Real], t: Set[Real]) {
    derived_set(s.union(t)).subset(derived_set(s).union(derived_set(t)))
}

theorem derived_set_union_eq(s: Set[Real], t: Set[Real]) {
    derived_set(s.union(t)) = derived_set(s).union(derived_set(t))
}

theorem smaller_ball_subset_left(s: Set[Real], x: Real, eps: Real, eps1: Real) {
    eps <= eps1 and forall(y: Real) {
        y.is_close(x, eps1) implies s.contains(y)
    } implies forall(y: Real) {
        y.is_close(x, eps) implies s.contains(y)
    }
}

theorem ball_subset_intersection(s: Set[Real], t: Set[Real], x: Real, eps: Real) {
    forall(y: Real) {
        y.is_close(x, eps) implies s.contains(y)
    } and forall(y: Real) {
        y.is_close(x, eps) implies t.contains(y)
    } implies forall(y: Real) {
        y.is_close(x, eps) implies s.intersection(t).contains(y)
    }
}

theorem interior_point_intersection(s: Set[Real], t: Set[Real], x: Real) {
    is_interior_point(s, x) and is_interior_point(t, x) implies
    is_interior_point(s.intersection(t), x)
}

theorem intersection_of_open_is_open(s: Set[Real], t: Set[Real]) {
    is_open_set(s) and is_open_set(t) implies is_open_set(s.intersection(t))
}

theorem union_of_closed_is_closed(s: Set[Real], t: Set[Real]) {
    is_closed_set(s) and is_closed_set(t) implies is_closed_set(s.union(t))
}

theorem closure_union_subset(s: Set[Real], t: Set[Real]) {
    closure(s.union(t)).subset(closure(s).union(closure(t)))
}

theorem closure_union_eq(s: Set[Real], t: Set[Real]) {
    closure(s.union(t)) = closure(s).union(closure(t))
}

theorem interior_mono(s: Set[Real], t: Set[Real]) {
    s.subset(t) implies interior(s).subset(interior(t))
}

theorem open_set_eq_interior(s: Set[Real]) {
    is_open_set(s) implies s = interior(s)
}

theorem interior_intersection_subset(s: Set[Real], t: Set[Real]) {
    interior(s.intersection(t)).subset(interior(s).intersection(interior(t)))
}

theorem intersection_interior_subset_interior_intersection(s: Set[Real], t: Set[Real]) {
    interior(s).intersection(interior(t)).subset(interior(s.intersection(t)))
}

theorem interior_intersection_eq(s: Set[Real], t: Set[Real]) {
    interior(s.intersection(t)) = interior(s).intersection(interior(t))
}

theorem union_interior_subset_interior_union(s: Set[Real], t: Set[Real]) {
    interior(s).union(interior(t)).subset(interior(s.union(t)))
}

define exterior(s: Set[Real]) -> Set[Real] {
    interior(s.c)
}

define boundary(s: Set[Real]) -> Set[Real] {
    closure(s).intersection(closure(s.c))
}

theorem exterior_contains_eq(s: Set[Real], x: Real) {
    exterior(s).contains(x) = interior(s.c).contains(x)
}

theorem boundary_contains_eq(s: Set[Real], x: Real) {
    boundary(s).contains(x) = (closure(s).contains(x) and closure(s.c).contains(x))
}

theorem boundary_contains_closure(s: Set[Real], x: Real) {
    boundary(s).contains(x) implies closure(s).contains(x)
}

theorem boundary_contains_closure_complement(s: Set[Real], x: Real) {
    boundary(s).contains(x) implies closure(s.c).contains(x)
}

theorem boundary_subset_closure(s: Set[Real]) {
    boundary(s).subset(closure(s))
}

theorem boundary_subset_closure_complement(s: Set[Real]) {
    boundary(s).subset(closure(s.c))
}

theorem boundary_is_closed(s: Set[Real]) {
    is_closed_set(boundary(s))
}

theorem exterior_eq_closure_complement(s: Set[Real]) {
    exterior(s) = closure(s).c
}

theorem exterior_not_closure(s: Set[Real], x: Real) {
    exterior(s).contains(x) implies not closure(s).contains(x)
}

theorem interior_not_boundary(s: Set[Real], x: Real) {
    interior(s).contains(x) implies not boundary(s).contains(x)
}

theorem exterior_not_boundary(s: Set[Real], x: Real) {
    exterior(s).contains(x) implies not boundary(s).contains(x)
}

theorem boundary_subset_interior_complement(s: Set[Real]) {
    boundary(s).subset(interior(s).c)
}

theorem interior_subset_boundary_complement(s: Set[Real]) {
    interior(s).subset(boundary(s).c)
}

theorem exterior_subset_boundary_complement(s: Set[Real]) {
    exterior(s).subset(boundary(s).c)
}

theorem boundary_eq_closure_difference_interior(s: Set[Real]) {
    boundary(s) = closure(s).difference(interior(s))
}

theorem closure_subset_interior_union_boundary(s: Set[Real]) {
    closure(s).subset(interior(s).union(boundary(s)))
}

theorem interior_union_boundary_subset_closure(s: Set[Real]) {
    interior(s).union(boundary(s)).subset(closure(s))
}

theorem closure_eq_interior_union_boundary(s: Set[Real]) {
    closure(s) = interior(s).union(boundary(s))
}

theorem boundary_complement_eq(s: Set[Real]) {
    boundary(s.c) = boundary(s)
}

theorem boundary_eq_boundary_complement(s: Set[Real]) {
    boundary(s) = boundary(s.c)
}

theorem boundary_subset_of_closed_set(s: Set[Real]) {
    is_closed_set(s) implies boundary(s).subset(s)
}

theorem boundary_subset_complement_of_open_set(s: Set[Real]) {
    is_open_set(s) implies boundary(s).subset(s.c)
}

theorem boundary_eq_closure_difference_of_open_set(s: Set[Real]) {
    is_open_set(s) implies boundary(s) = closure(s).difference(s)
}

theorem boundary_eq_set_difference_interior_of_closed_set(s: Set[Real]) {
    is_closed_set(s) implies boundary(s) = s.difference(interior(s))
}

theorem boundary_intersection_interior_is_empty(s: Set[Real]) {
    boundary(s).intersection(interior(s)) = Set[Real].empty_set
}

theorem boundary_intersection_exterior_is_empty(s: Set[Real]) {
    boundary(s).intersection(exterior(s)) = Set[Real].empty_set
}

theorem exterior_intersection_boundary_is_empty(s: Set[Real]) {
    exterior(s).intersection(boundary(s)) = Set[Real].empty_set
}

define is_codense_real_set(s: Set[Real]) -> Bool {
    is_dense_real_set(s.c)
}

theorem codense_real_set_eq_dense_complement(s: Set[Real]) {
    is_codense_real_set(s) = is_dense_real_set(s.c)
}

theorem exterior_of_dense_real_set_is_empty(s: Set[Real]) {
    is_dense_real_set(s) implies exterior(s) = Set[Real].empty_set
}

theorem interior_complement_of_dense_real_set_is_empty(s: Set[Real]) {
    is_dense_real_set(s) implies interior(s.c) = Set[Real].empty_set
}

theorem interior_of_codense_real_set_is_empty(s: Set[Real]) {
    is_codense_real_set(s) implies interior(s) = Set[Real].empty_set
}

theorem empty_real_set_is_codense {
    is_codense_real_set(Set[Real].empty_set)
}

theorem boundary_of_dense_codense_real_set_is_universal(s: Set[Real]) {
    is_dense_real_set(s) and is_codense_real_set(s) implies boundary(s) = Set[Real].universal_set
}

theorem dense_real_set_of_universal_boundary(s: Set[Real]) {
    boundary(s) = Set[Real].universal_set implies is_dense_real_set(s)
}

theorem codense_real_set_of_universal_boundary(s: Set[Real]) {
    boundary(s) = Set[Real].universal_set implies is_codense_real_set(s)
}

theorem universal_boundary_eq_dense_and_codense(s: Set[Real]) {
    (boundary(s) = Set[Real].universal_set) = (is_dense_real_set(s) and is_codense_real_set(s))
}

theorem interior_is_open(s: Set[Real]) {
    is_open_set(interior(s))
}

theorem interior_idempotent(s: Set[Real]) {
    interior(interior(s)) = interior(s)
}

theorem open_set_iff_eq_interior(s: Set[Real]) {
    is_open_set(s) = (s = interior(s))
}

theorem closed_set_iff_eq_closure(s: Set[Real]) {
    is_closed_set(s) = (s = closure(s))
}

theorem complement_of_interior_is_closed(s: Set[Real]) {
    is_closed_set(interior(s).c)
}

theorem complement_of_closure_is_open(s: Set[Real]) {
    is_open_set(closure(s).c)
}

theorem closure_empty_real_set {
    closure(Set[Real].empty_set) = Set[Real].empty_set
}

theorem closure_universal_real_set {
    closure(Set[Real].universal_set) = Set[Real].universal_set
}

theorem interior_empty_real_set {
    interior(Set[Real].empty_set) = Set[Real].empty_set
}

theorem interior_universal_real_set {
    interior(Set[Real].universal_set) = Set[Real].universal_set
}

theorem open_set_iff_complement_closed(s: Set[Real]) {
    is_open_set(s) = is_closed_set(s.c)
}

theorem closed_set_iff_complement_open(s: Set[Real]) {
    is_closed_set(s) = is_open_set(s.c)
}

theorem interior_complement_empty_real_set {
    interior(Set[Real].empty_set.c) = Set[Real].universal_set
}

theorem interior_complement_universal_real_set {
    interior(Set[Real].universal_set.c) = Set[Real].empty_set
}

theorem closure_complement_empty_real_set {
    closure(Set[Real].empty_set.c) = Set[Real].universal_set
}

theorem closure_complement_universal_real_set {
    closure(Set[Real].universal_set.c) = Set[Real].empty_set
}

theorem closure_interior_subset_closure(s: Set[Real]) {
    closure(interior(s)).subset(closure(s))
}

theorem interior_subset_interior_closure(s: Set[Real]) {
    interior(s).subset(interior(closure(s)))
}

theorem interior_closure_is_open(s: Set[Real]) {
    is_open_set(interior(closure(s)))
}

theorem closure_interior_is_closed(s: Set[Real]) {
    is_closed_set(closure(interior(s)))
}

define is_clopen_real_set(s: Set[Real]) -> Bool {
    is_open_set(s) and is_closed_set(s)
}

theorem clopen_real_set_is_open(s: Set[Real]) {
    is_clopen_real_set(s) implies is_open_set(s)
}

theorem clopen_real_set_is_closed(s: Set[Real]) {
    is_clopen_real_set(s) implies is_closed_set(s)
}
