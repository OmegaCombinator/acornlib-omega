    closed_interval_set(a, b).contains(x_l) and closed_interval_set(a, b).contains(x_r) and
    x_l < x_r and
    closed_interval_set(f(a), f(b)).contains(y1) and
    f(x_l) < y1 and y1 < f(x_r)
