}

theorem abs_eq_pos_plus_neg(f: (Nat, Nat) -> Real, m: Nat, n: Nat) {
    abs_fn_2(f, m, n) = pos_part_2(f, m, n) + neg_part_2(f, m, n)
}

theorem pos_part_le_abs(f: (Nat, Nat) -> Real, m: Nat, n: Nat) {
    pos_part_2(f, m, n) <= abs_fn_2(f, m, n)
