theorem nat_sub_le_sub(a: Nat, b: Nat, k: Nat) {
    a <= b implies a - k <= b - k
}

theorem nat_suc_sub(a: Nat, b: Nat) {
    b <= a implies (a + 1) - b = (a - b) + 1
}

theorem ring_add_sub_cancel(a: Real, b: Real) {
    (a + b) - b = a
}

theorem ring_sub_add_cancel(a: Real, b: Real) {
    (a - b) + b = a
}

define concat_partition(p1: Nat -> Real, n1: Nat, p2: Nat -> Real, i: Nat) -> Real {
    if i <= n1 {
        p1(i)
    } else {
        p2(i - n1)
    }
}

theorem concat_partition_start(p1: Nat -> Real, n1: Nat, p2: Nat -> Real) {
    concat_partition(p1, n1, p2, Nat.0) = p1(Nat.0)
}

theorem concat_partition_tail_point(p1: Nat -> Real, n1: Nat, p2: Nat -> Real, a: Real, b: Real, c: Real, n2: Nat, i: Nat) {
    is_partition(p1, a, b, n1) and is_partition(p2, b, c, n2)
    implies concat_partition(p1, n1, p2, n1 + i) = p2(i)
}

theorem concat_partition_end(p1: Nat -> Real, n1: Nat, p2: Nat -> Real, a: Real, b: Real, c: Real, n2: Nat) {
    is_partition(p1, a, b, n1) and is_partition(p2, b, c, n2)
    implies concat_partition(p1, n1, p2, n1 + n2) = c
}

theorem concat_partition_prefix_point(p1: Nat -> Real, n1: Nat, p2: Nat -> Real, i: Nat) {
    i <= n1 implies concat_partition(p1, n1, p2, i) = p1(i)
}

theorem concat_partition_suffix_point(p1: Nat -> Real, n1: Nat, p2: Nat -> Real, a: Real, b: Real, c: Real, n2: Nat, i: Nat) {
    is_partition(p1, a, b, n1) and is_partition(p2, b, c, n2) and n1 <= i and i < n1 + n2
    implies concat_partition(p1, n1, p2, i) = p2(i - n1)
}

theorem concat_partition_suffix_suc_point(p1: Nat -> Real, n1: Nat, p2: Nat -> Real, a: Real, b: Real, c: Real, n2: Nat, i: Nat) {
    is_partition(p1, a, b, n1) and is_partition(p2, b, c, n2) and n1 <= i and i < n1 + n2
    implies concat_partition(p1, n1, p2, i + 1) = p2((i + 1) - n1)
}

theorem concat_partition_mono(p1: Nat -> Real, p2: Nat -> Real, a: Real, b: Real, c: Real, n1: Nat, n2: Nat, i: Nat, j: Nat) {
    is_partition(p1, a, b, n1) and is_partition(p2, b, c, n2) and i <= j and j <= n1 + n2
    implies concat_partition(p1, n1, p2, i) <= concat_partition(p1, n1, p2, j)
}

theorem concat_partition_is_partition(p1: Nat -> Real, p2: Nat -> Real, a: Real, b: Real, c: Real, n1: Nat, n2: Nat) {
    is_partition(p1, a, b, n1) and is_partition(p2, b, c, n2)
    implies is_partition(concat_partition(p1, n1, p2), a, c, n1 + n2)
}

theorem concat_partition_step_lower_prefix(f: Real -> Real, p1: Nat -> Real, n1: Nat, p2: Nat -> Real, i: Nat) {
    i < n1 implies partition_step_lower(f, concat_partition(p1, n1, p2), i) = partition_step_lower(f, p1, i)
}

theorem concat_partition_step_lower_suffix(f: Real -> Real, p1: Nat -> Real, n1: Nat, p2: Nat -> Real, a: Real, b: Real, c: Real, n2: Nat, i: Nat) {
    is_partition(p1, a, b, n1) and is_partition(p2, b, c, n2) and n1 <= i and i < n1 + n2
    implies partition_step_lower(f, concat_partition(p1, n1, p2), i) = partition_step_lower(f, p2, i - n1)
}

theorem concat_partition_lower_sum(f: Real -> Real, p1: Nat -> Real, p2: Nat -> Real, a: Real, b: Real, c: Real, n1: Nat, n2: Nat) {
    is_partition(p1, a, b, n1) and is_partition(p2, b, c, n2)
    implies lower_sum(f, concat_partition(p1, n1, p2), n1 + n2) = lower_sum(f, p1, n1) + lower_sum(f, p2, n2)
}

theorem concat_partition_step_upper_prefix(f: Real -> Real, p1: Nat -> Real, n1: Nat, p2: Nat -> Real, i: Nat) {
    i < n1 implies partition_step_upper(f, concat_partition(p1, n1, p2), i) = partition_step_upper(f, p1, i)
}

theorem concat_partition_step_upper_suffix(f: Real -> Real, p1: Nat -> Real, n1: Nat, p2: Nat -> Real, a: Real, b: Real, c: Real, n2: Nat, i: Nat) {
    is_partition(p1, a, b, n1) and is_partition(p2, b, c, n2) and n1 <= i and i < n1 + n2
    implies partition_step_upper(f, concat_partition(p1, n1, p2), i) = partition_step_upper(f, p2, i - n1)
}

theorem concat_partition_upper_sum(f: Real -> Real, p1: Nat -> Real, p2: Nat -> Real, a: Real, b: Real, c: Real, n1: Nat, n2: Nat) {
    is_partition(p1, a, b, n1) and is_partition(p2, b, c, n2)
    implies upper_sum(f, concat_partition(p1, n1, p2), n1 + n2) = upper_sum(f, p1, n1) + upper_sum(f, p2, n2)
}

theorem additivity_concat_lower(f: Real -> Real, a: Real, b: Real, c: Real, m_ac: Real) {
    a <= b and b <= c and is_set_supremum(lower_sum_set(f, a, c), m_ac)
    implies forall(x1: Real, x2: Real) {
        lower_sum_set(f, a, b).contains(x1) and lower_sum_set(f, b, c).contains(x2)
        implies x1 + x2 <= m_ac
    }
}

theorem sup_lower_add_le(f: Real -> Real, a: Real, b: Real, c: Real, m_ab: Real, m_bc: Real, m_ac: Real) {
    a <= b and b <= c and
    is_set_supremum(lower_sum_set(f, a, b), m_ab) and
    is_set_supremum(lower_sum_set(f, b, c), m_bc) and
    is_set_supremum(lower_sum_set(f, a, c), m_ac)
    implies m_ab + m_bc <= m_ac
}

theorem additivity_concat_upper(f: Real -> Real, a: Real, b: Real, c: Real, m_ac: Real) {
    a <= b and b <= c and is_set_infimum(upper_sum_set(f, a, c), m_ac)
    implies forall(x1: Real, x2: Real) {
        upper_sum_set(f, a, b).contains(x1) and upper_sum_set(f, b, c).contains(x2)
        implies m_ac <= x1 + x2
    }
}

theorem inf_upper_add_ge(f: Real -> Real, a: Real, b: Real, c: Real, m_ab: Real, m_bc: Real, m_ac: Real) {
    a <= b and b <= c and
    is_set_infimum(upper_sum_set(f, a, b), m_ab) and
    is_set_infimum(upper_sum_set(f, b, c), m_bc) and
    is_set_infimum(upper_sum_set(f, a, c), m_ac)
    implies m_ac <= m_ab + m_bc
}

theorem integral_additivity(f: Real -> Real, a: Real, b: Real, c: Real) {
    a <= b and b <= c and is_integrable(f, a, b) and is_integrable(f, b, c) and is_integrable(f, a, c)
    implies integral(f, a, c) = integral(f, a, b) + integral(f, b, c)
}

theorem integral_additivity_symm(f: Real -> Real, a: Real, b: Real, c: Real) {
    a <= b and b <= c and is_integrable(f, a, b) and is_integrable(f, b, c) and is_integrable(f, a, c)
    implies integral(f, a, b) + integral(f, b, c) = integral(f, a, c)
}

define const_sub_left(c: Real, f: Real -> Real, x: Real) -> Real {
    c - f(x)
}

define const_sub_right(f: Real -> Real, c: Real, x: Real) -> Real {
    f(x) - c
}

theorem const_sub_left_eq_const_add_left_neg(c: Real, f: Real -> Real) {
    const_sub_left(c, f) = const_add_left(c, pointwise_neg[Real, Real](f))
}

theorem const_sub_right_eq_const_add_right_neg(f: Real -> Real, c: Real) {
    const_sub_right(f, c) = const_add_right(f, -c)
}

theorem continuous_at_const_sub_left(c: Real, f: Real -> Real, x: Real) {
    continuous_at(f, x)
    implies continuous_at(const_sub_left(c, f), x)
}

theorem continuous_const_sub_left(c: Real, f: Real -> Real) {
    continuous(f) implies continuous(const_sub_left(c, f))
}

theorem continuous_at_const_sub_right(f: Real -> Real, c: Real, x: Real) {
    continuous_at(f, x)
    implies continuous_at(const_sub_right(f, c), x)
}

theorem continuous_const_sub_right(f: Real -> Real, c: Real) {
    continuous(f) implies continuous(const_sub_right(f, c))
}

theorem derivative_compose_three_right(
    f: Real -> Real, g: Real -> Real, h: Real -> Real,
    x0: Real, df: Real, dg: Real, dh: Real
) {
    has_derivative_at(f, x0, df) and
    has_derivative_at(g, f(x0), dg) and
    has_derivative_at(h, g(f(x0)), dh)
    implies has_derivative_at(compose(h, compose(g, f)), x0, dh * (dg * df))
}

theorem derivative_compose_three_left(
    f: Real -> Real, g: Real -> Real, h: Real -> Real,
    x0: Real, df: Real, dg: Real, dh: Real
) {
    has_derivative_at(f, x0, df) and
    has_derivative_at(g, f(x0), dg) and
    has_derivative_at(h, g(f(x0)), dh)
    implies has_derivative_at(compose(compose(h, g), f), x0, (dh * dg) * df)
}

theorem differentiable_compose_three_right(f: Real -> Real, g: Real -> Real, h: Real -> Real, x0: Real) {
    differentiable_at(f, x0) and differentiable_at(g, f(x0)) and differentiable_at(h, g(f(x0)))
    implies differentiable_at(compose(h, compose(g, f)), x0)
}

theorem differentiable_compose_three_left(f: Real -> Real, g: Real -> Real, h: Real -> Real, x0: Real) {
    differentiable_at(f, x0) and differentiable_at(g, f(x0)) and differentiable_at(h, g(f(x0)))
    implies differentiable_at(compose(compose(h, g), f), x0)
}

theorem derivative_compose_four_right(
    f: Real -> Real, g: Real -> Real, h: Real -> Real, k: Real -> Real,
    x0: Real, df: Real, dg: Real, dh: Real, dk: Real
) {
    has_derivative_at(f, x0, df) and
    has_derivative_at(g, f(x0), dg) and
    has_derivative_at(h, g(f(x0)), dh) and
    has_derivative_at(k, h(g(f(x0))), dk)
    implies has_derivative_at(compose(k, compose(h, compose(g, f))), x0, dk * (dh * (dg * df)))
}

theorem derivative_compose_four_left(
    f: Real -> Real, g: Real -> Real, h: Real -> Real, k: Real -> Real,
    x0: Real, df: Real, dg: Real, dh: Real, dk: Real
) {
    has_derivative_at(f, x0, df) and
    has_derivative_at(g, f(x0), dg) and
    has_derivative_at(h, g(f(x0)), dh) and
    has_derivative_at(k, h(g(f(x0))), dk)
    implies has_derivative_at(compose(compose(compose(k, h), g), f), x0, ((dk * dh) * dg) * df)
}

theorem differentiable_compose_four_right(
    f: Real -> Real, g: Real -> Real, h: Real -> Real, k: Real -> Real, x0: Real
) {
    differentiable_at(f, x0) and differentiable_at(g, f(x0)) and
    differentiable_at(h, g(f(x0))) and differentiable_at(k, h(g(f(x0))))
    implies differentiable_at(compose(k, compose(h, compose(g, f))), x0)
}

theorem differentiable_compose_four_left(
    f: Real -> Real, g: Real -> Real, h: Real -> Real, k: Real -> Real, x0: Real
) {
    differentiable_at(f, x0) and differentiable_at(g, f(x0)) and
    differentiable_at(h, g(f(x0))) and differentiable_at(k, h(g(f(x0))))
    implies differentiable_at(compose(compose(compose(k, h), g), f), x0)
}

theorem derivative_compose_identity_outer(f: Real -> Real, x0: Real, d: Real) {
    has_derivative_at(f, x0, d) implies has_derivative_at(compose(identity_fn[Real], f), x0, d)
}

theorem derivative_compose_identity_inner(f: Real -> Real, x0: Real, d: Real) {
    has_derivative_at(f, x0, d) implies has_derivative_at(compose(f, identity_fn[Real]), x0, d)
}

theorem differentiable_compose_identity_outer(f: Real -> Real, x0: Real) {
    differentiable_at(f, x0) implies differentiable_at(compose(identity_fn[Real], f), x0)
}

theorem differentiable_compose_identity_inner(f: Real -> Real, x0: Real) {
    differentiable_at(f, x0) implies differentiable_at(compose(f, identity_fn[Real]), x0)
}

theorem derivative_self_compose(f: Real -> Real, x0: Real, d0: Real, d1: Real) {
    has_derivative_at(f, x0, d0) and has_derivative_at(f, f(x0), d1)
    implies has_derivative_at(compose(f, f), x0, d1 * d0)
}

theorem differentiable_self_compose(f: Real -> Real, x0: Real) {
    differentiable_at(f, x0) and differentiable_at(f, f(x0))
    implies differentiable_at(compose(f, f), x0)
}

theorem derivative_self_compose_three_right(f: Real -> Real, x0: Real, d0: Real, d1: Real, d2: Real) {
    has_derivative_at(f, x0, d0) and has_derivative_at(f, f(x0), d1) and
    has_derivative_at(f, f(f(x0)), d2)
    implies has_derivative_at(compose(f, compose(f, f)), x0, d2 * (d1 * d0))
}

theorem derivative_self_compose_three_left(f: Real -> Real, x0: Real, d0: Real, d1: Real, d2: Real) {
    has_derivative_at(f, x0, d0) and has_derivative_at(f, f(x0), d1) and
    has_derivative_at(f, f(f(x0)), d2)
    implies has_derivative_at(compose(compose(f, f), f), x0, (d2 * d1) * d0)
}

theorem differentiable_self_compose_three_right(f: Real -> Real, x0: Real) {
    differentiable_at(f, x0) and differentiable_at(f, f(x0)) and differentiable_at(f, f(f(x0)))
    implies differentiable_at(compose(f, compose(f, f)), x0)
}

theorem differentiable_self_compose_three_left(f: Real -> Real, x0: Real) {
    differentiable_at(f, x0) and differentiable_at(f, f(x0)) and differentiable_at(f, f(f(x0)))
    implies differentiable_at(compose(compose(f, f), f), x0)
}

theorem derivative_affine_after(
    c: Real, b: Real, f: Real -> Real, x0: Real, d: Real
) {
    has_derivative_at(f, x0, d)
    implies has_derivative_at(
        compose(pointwise_add(pointwise_mul(constant[Real, Real](c), identity_fn[Real]), constant[Real, Real](b)), f),
        x0,
        c * d
    )
}

theorem differentiable_affine_after(c: Real, b: Real, f: Real -> Real, x0: Real) {
    differentiable_at(f, x0)
    implies differentiable_at(
        compose(pointwise_add(pointwise_mul(constant[Real, Real](c), identity_fn[Real]), constant[Real, Real](b)), f),
        x0
    )
}

theorem derivative_after_affine(
    c: Real, b: Real, f: Real -> Real, x0: Real, d: Real
) {
    has_derivative_at(
        f,
        pointwise_add(pointwise_mul(constant[Real, Real](c), identity_fn[Real]), constant[Real, Real](b), x0),
        d
    )
    implies has_derivative_at(
        compose(f, pointwise_add(pointwise_mul(constant[Real, Real](c), identity_fn[Real]), constant[Real, Real](b))),
        x0,
        d * c
    )
}

theorem differentiable_after_affine(c: Real, b: Real, f: Real -> Real, x0: Real) {
    differentiable_at(
        f,
        pointwise_add(pointwise_mul(constant[Real, Real](c), identity_fn[Real]), constant[Real, Real](b), x0)
    )
    implies differentiable_at(
        compose(f, pointwise_add(pointwise_mul(constant[Real, Real](c), identity_fn[Real]), constant[Real, Real](b))),
        x0
    )
}

theorem derivative_affine_after_affine(c: Real, b: Real, a: Real, r: Real, x0: Real) {
    has_derivative_at(
        compose(
            pointwise_add(pointwise_mul(constant[Real, Real](c), identity_fn[Real]), constant[Real, Real](b)),
            pointwise_add(pointwise_mul(constant[Real, Real](a), identity_fn[Real]), constant[Real, Real](r))
        ),
        x0,
        c * a
    )
}

theorem differentiable_affine_after_affine(c: Real, b: Real, a: Real, r: Real, x0: Real) {
    differentiable_at(
        compose(
            pointwise_add(pointwise_mul(constant[Real, Real](c), identity_fn[Real]), constant[Real, Real](b)),
            pointwise_add(pointwise_mul(constant[Real, Real](a), identity_fn[Real]), constant[Real, Real](r))
        ),
        x0
    )
}

theorem derivative_affine_three_right(
    e: Real, s: Real, c: Real, b: Real, a: Real, r: Real, x0: Real
) {
    has_derivative_at(
        compose(
            pointwise_add(pointwise_mul(constant[Real, Real](e), identity_fn[Real]), constant[Real, Real](s)),
            compose(
                pointwise_add(pointwise_mul(constant[Real, Real](c), identity_fn[Real]), constant[Real, Real](b)),
                pointwise_add(pointwise_mul(constant[Real, Real](a), identity_fn[Real]), constant[Real, Real](r))
            )
        ),
        x0,
        e * (c * a)
    )
}

theorem differentiable_affine_three_right(
    e: Real, s: Real, c: Real, b: Real, a: Real, r: Real, x0: Real
) {
    differentiable_at(
        compose(
            pointwise_add(pointwise_mul(constant[Real, Real](e), identity_fn[Real]), constant[Real, Real](s)),
            compose(
                pointwise_add(pointwise_mul(constant[Real, Real](c), identity_fn[Real]), constant[Real, Real](b)),
                pointwise_add(pointwise_mul(constant[Real, Real](a), identity_fn[Real]), constant[Real, Real](r))
            )
        ),
        x0
    )
}

theorem affine_real_eq_pointwise_affine(a: Real, b: Real) {
    affine_real(a, b) =
        pointwise_add(pointwise_mul(constant[Real, Real](a), identity_fn[Real]), constant[Real, Real](b))
}

theorem affine_real_has_derivative_at(a: Real, b: Real, x0: Real) {
    has_derivative_at(affine_real(a, b), x0, a)
}

theorem affine_real_differentiable_at(a: Real, b: Real, x0: Real) {
    differentiable_at(affine_real(a, b), x0)
}

theorem derivative_affine_real_after(
    f: Real -> Real, a: Real, b: Real, x0: Real, d: Real
) {
    has_derivative_at(f, x0, d)
        implies has_derivative_at(compose(affine_real(a, b), f), x0, a * d)
}

theorem differentiable_affine_real_after(f: Real -> Real, a: Real, b: Real, x0: Real) {
    differentiable_at(f, x0)
        implies differentiable_at(compose(affine_real(a, b), f), x0)
}

define differentiable_on_open(f: Real -> Real, lower: Real, upper: Real) -> Bool {
    forall(x: Real) {
        lower < x and x < upper implies differentiable_at(f, x)
    }
}

define is_derivative_on_open(f: Real -> Real, df: Real -> Real, lower: Real, upper: Real) -> Bool {
    forall(x: Real) {
        lower < x and x < upper implies has_derivative_at(f, x, df(x))
    }
}

define continuous_on_closed(f: Real -> Real, lower: Real, upper: Real) -> Bool {
    forall(x: Real) {
        closed_interval_set(lower, upper).contains(x) implies continuous_at(f, x)
    }
}

theorem le_zero_div_pos_le_zero(a: Real, b: Real) {
    a <= Real.0 and b.is_positive implies a / b <= Real.0
}

theorem le_zero_div_neg_ge_zero(a: Real, b: Real) {
    a <= Real.0 and b.is_negative implies Real.0 <= a / b
}

theorem lt_all_eps_imp_lte_zero(d: Real) {
    (forall(eps: Real) { eps.is_positive implies d < eps }) implies d <= Real.0
}

theorem close_le_zero_imp_lt_eps(q: Real, d: Real, eps: Real) {
    q.is_close(d, eps) and q <= Real.0 implies d < eps
}

theorem close_ge_zero_imp_neg_lt_eps(q: Real, d: Real, eps: Real) {
    q.is_close(d, eps) and Real.0 <= q implies -d < eps
}

theorem neg_le_zero_imp_ge_zero(x: Real) {
    -x <= Real.0 implies Real.0 <= x
}

theorem lte_imp_sub_le_zero(u: Real, v: Real) {
    u <= v implies u - v <= Real.0
}

theorem lte_imp_zero_le_sub(u: Real, v: Real) {
    u <= v implies Real.0 <= v - u
}

theorem fermat_interior_maximum(f: Real -> Real, a: Real, b: Real, x0: Real, d: Real) {
    a < x0 and x0 < b and
    (forall(y: Real) { a < y and y < b implies f(y) <= f(x0) }) and
    has_derivative_at(f, x0, d)
    implies d = Real.0
}

theorem pos_add_one_is_pos(x: Real) {
    x.is_positive implies (x + Real.1).is_positive
}

theorem abs_add_one_is_pos(x: Real) {
    (x.abs + Real.1).is_positive
}

define bounded_above_on_prefix(f: Real -> Real, lower: Real, x: Real) -> Bool {
    exists(bound: Real) {
        forall(y: Real) {
            closed_interval_set(lower, x).contains(y) implies f(y) <= bound
        }
    }
}

define bounded_prefix_contains(f: Real -> Real, a: Real, b: Real, x: Real) -> Bool {
    a <= x and x <= b and bounded_above_on_prefix(f, a, x)
}

define bounded_prefix_set(f: Real -> Real, a: Real, b: Real) -> Set[Real] {
    Set[Real].new(bounded_prefix_contains(f, a, b))
}

theorem bounded_prefix_set_contains_eq(f: Real -> Real, a: Real, b: Real, x: Real) {
    bounded_prefix_set(f, a, b).contains(x) = bounded_prefix_contains(f, a, b, x)
}

theorem bounded_prefix_contains_lower(f: Real -> Real, a: Real, b: Real) {
    a <= b implies bounded_prefix_set(f, a, b).contains(a)
}

theorem bounded_prefix_set_is_nonempty(f: Real -> Real, a: Real, b: Real) {
    a <= b implies is_nonempty(bounded_prefix_set(f, a, b))
}

theorem bounded_prefix_set_upper_bound(f: Real -> Real, a: Real, b: Real) {
    is_set_upper_bound(bounded_prefix_set(f, a, b), b)
}

theorem bounded_prefix_set_has_upper_bound(f: Real -> Real, a: Real, b: Real) {
    has_upper_bound(bounded_prefix_set(f, a, b))
}

theorem bounded_prefix_set_supremum_exists(f: Real -> Real, a: Real, b: Real) {
    a <= b implies exists(t: Real) {
        is_set_supremum(bounded_prefix_set(f, a, b), t)
    }
}

theorem bounded_prefix_member_in_interval(f: Real -> Real, a: Real, b: Real, x: Real) {
