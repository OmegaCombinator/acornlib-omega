    x <= y and is_nonempty(interval_set(x, y)) and has_upper_bound(interval_image(f, x, y)) and
    has_lower_bound(interval_image(f, x, y)) and
    (forall(u: Real, v: Real) {
        interval_contains(x, y, u) and interval_contains(x, y, v) implies (f(u) - f(v)).abs <= y - x
    }) implies
    interval_sup(f, x, y) - interval_inf(f, x, y) <= y - x
}

theorem sin_interval_sup_sub_inf_le_width(x: Real, y: Real) {
    x <= y implies interval_sup(Real.sin, x, y) - interval_inf(Real.sin, x, y) <= y - x
}

theorem cos_interval_sup_sub_inf_le_width(x: Real, y: Real) {
    x <= y implies interval_sup(Real.cos, x, y) - interval_inf(Real.cos, x, y) <= y - x
}

define uniform_mesh(a: Real, b: Real, n: Nat) -> Real {
    (b - a) / from_nat[Real](n.suc)
}

theorem lipschitz_uniform_upper_minus_lower(f: Real -> Real, a: Real, b: Real, n: Nat) {
    a <= b and
    (forall(u: Real, v: Real) { (f(u) - f(v)).abs <= (u - v).abs }) and
    (forall(t: Real) { interval_contains(a, b, t) implies -Real.1 <= f(t) }) and
    (forall(t: Real) { interval_contains(a, b, t) implies f(t) <= Real.1 }) implies
    upper_sum(f, uniform_partition(a, b, n), n.suc) -
        lower_sum(f, uniform_partition(a, b, n), n.suc) <= ((b - a) * (b - a)) / from_nat[Real](n.suc)
}

theorem fn_lower_sum_set_bounded_above(f: Real -> Real, g: Real -> Real, a: Real, b: Real, lb: Real) {
    a <= b and continuous(g) and is_derivative_fn(g, f) and
    (forall(t: Real) { interval_contains(a, b, t) implies lb <= f(t) }) implies
    is_set_upper_bound(lower_sum_set(f, a, b), g(b) - g(a))
}

theorem fn_upper_sum_set_bounded_below(f: Real -> Real, g: Real -> Real, a: Real, b: Real, ub: Real) {
    a <= b and continuous(g) and is_derivative_fn(g, f) and
    (forall(t: Real) { interval_contains(a, b, t) implies f(t) <= ub }) implies
    is_set_lower_bound(upper_sum_set(f, a, b), g(b) - g(a))
}

theorem fn_lower_sum_set_sup_exists(f: Real -> Real, g: Real -> Real, a: Real, b: Real, lb: Real) {
    a <= b and continuous(g) and is_derivative_fn(g, f) and
    (forall(t: Real) { interval_contains(a, b, t) implies lb <= f(t) }) implies exists(l: Real) {
        is_set_supremum(lower_sum_set(f, a, b), l)
    }
}

theorem fn_upper_sum_set_inf_exists(f: Real -> Real, g: Real -> Real, a: Real, b: Real, ub: Real) {
    a <= b and continuous(g) and is_derivative_fn(g, f) and
    (forall(t: Real) { interval_contains(a, b, t) implies f(t) <= ub }) implies exists(u: Real) {
        is_set_infimum(upper_sum_set(f, a, b), u)
    }
}

theorem fn_integrable(f: Real -> Real, g: Real -> Real, a: Real, b: Real) {
    a <= b and continuous(g) and is_derivative_fn(g, f) and
    (forall(u: Real, v: Real) { (f(u) - f(v)).abs <= (u - v).abs }) and
    (forall(t: Real) { interval_contains(a, b, t) implies -Real.1 <= f(t) }) and
    (forall(t: Real) { interval_contains(a, b, t) implies f(t) <= Real.1 }) implies
    is_integrable(f, a, b)
}

theorem sin_integrable(a: Real, b: Real) {
    a <= b implies is_integrable(Real.sin, a, b)
}

theorem cos_integrable(a: Real, b: Real) {
    a <= b implies is_integrable(Real.cos, a, b)
}

theorem integral_sin(a: Real, b: Real) {
    a <= b implies integral(Real.sin, a, b) = a.cos - b.cos
}

theorem integral_cos(a: Real, b: Real) {
    a <= b implies integral(Real.cos, a, b) = b.sin - a.sin
}

theorem integral_sin_zero_pi {
    integral(Real.sin, Real.0, pi) = two
}

theorem integral_cos_zero_pi_over_two {
    integral(Real.cos, Real.0, pi_over_two) = Real.1
}

theorem interval_sup_sub_inf_le_lipschitz_m(f: Real -> Real, m: Real, x: Real, y: Real) {
    x <= y and is_nonempty(interval_set(x, y)) and has_upper_bound(interval_image(f, x, y)) and
    has_lower_bound(interval_image(f, x, y)) and
    (forall(u: Real, v: Real) {
        interval_contains(x, y, u) and interval_contains(x, y, v) implies (f(u) - f(v)).abs <= m * (y - x)
    }) implies
    interval_sup(f, x, y) - interval_inf(f, x, y) <= m * (y - x)
}

theorem lipschitz_uniform_upper_minus_lower_m(f: Real -> Real, m: Real, a: Real, b: Real, n: Nat, lb: Real, ub: Real) {
    a <= b and Real.0 <= m and
    (forall(u: Real, v: Real) {
        interval_contains(a, b, u) and interval_contains(a, b, v) implies (f(u) - f(v)).abs <= m * (u - v).abs
    }) and
    (forall(t: Real) { interval_contains(a, b, t) implies lb <= f(t) }) and
    (forall(t: Real) { interval_contains(a, b, t) implies f(t) <= ub }) implies
    upper_sum(f, uniform_partition(a, b, n), n.suc) -
        lower_sum(f, uniform_partition(a, b, n), n.suc) <= m * (((b - a) * (b - a)) / from_nat[Real](n.suc))
}

theorem fn_integrable_gen(f: Real -> Real, g: Real -> Real, a: Real, b: Real, m: Real, lb: Real, ub: Real) {
    a <= b and Real.0 <= m and continuous(g) and is_derivative_fn(g, f) and
    (forall(u: Real, v: Real) {
        interval_contains(a, b, u) and interval_contains(a, b, v) implies (f(u) - f(v)).abs <= m * (u - v).abs
    }) and
    (forall(t: Real) { interval_contains(a, b, t) implies lb <= f(t) }) and
    (forall(t: Real) { interval_contains(a, b, t) implies f(t) <= ub }) implies
    is_integrable(f, a, b)
}

define pow_deriv_suc(n: Nat, x: Real) -> Real {
    from_nat[Real](n.suc) * pow_real_fn(n, x)
}

theorem derivative_pow_real_suc(n: Nat) {
    is_derivative_fn(pow_real_fn(n.suc), pow_deriv_suc(n))
}

define unit_pow_anti(n: Nat, x: Real) -> Real {
    pointwise_mul[Real, Real](
        constant[Real, Real](Real.1 / from_nat[Real](n.suc)),
        pow_real_fn(n.suc))(x)
}

theorem unit_pow_anti_derivative(n: Nat) {
    is_derivative_fn(
        pointwise_mul[Real, Real](
            constant[Real, Real](Real.1 / from_nat[Real](n.suc)),
            pow_real_fn(n.suc)),
        pow_real_fn(n))
}

theorem pow_real_fn_nonneg_unit(n: Nat) {
    forall(t: Real) {
        interval_contains(Real.0, Real.1, t) implies Real.0 <= pow_real_fn(n, t)
    }
}

theorem pow_real_fn_le_one_unit(n: Nat) {
    forall(t: Real) {
        interval_contains(Real.0, Real.1, t) implies pow_real_fn(n, t) <= Real.1
    }
}

theorem monomial_lipschitz_unit(n: Nat) {
    forall(u: Real, v: Real) {
        interval_contains(Real.0, Real.1, u) and interval_contains(Real.0, Real.1, v) implies
        (pow_real_fn(n, u) - pow_real_fn(n, v)).abs <= from_nat[Real](n) * (u - v).abs
    }
}

theorem monomial_integrable_unit(n: Nat) {
    is_integrable(pow_real_fn(n), Real.0, Real.1)
}

theorem integral_unit_pow(n: Nat) {
    integral(pow_real_fn(n), Real.0, Real.1) = Real.1 / from_nat[Real](n.suc)
}

define unit_minus(x: Real) -> Real {
    affine_real(-Real.1, Real.1, x)
}

define beta_fn(n: Nat, m: Nat, t: Real) -> Real {
    pow_real_fn(n, t) * pow_real_fn(m, unit_minus(t))
}

define beta_anti_coeff(n: Nat, m: Nat, j: Nat) -> Real {
    alternating_sign[Real](j) * from_nat[Real](m.binom(j)) / from_nat[Real](n.suc + j)
}

define beta_anti_term_fn(n: Nat, m: Nat, j: Nat, t: Real) -> Real {
    beta_anti_coeff(n, m, j) * pow_real_fn(n.suc + j, t)
}

define beta_anti_seq(n: Nat, m: Nat, t: Real, j: Nat) -> Real {
    beta_anti_term_fn(n, m, j, t)
}

define beta_anti(n: Nat, m: Nat, t: Real) -> Real {
    partial[Real](beta_anti_seq(n, m, t), m.suc)
}

define beta_deriv_term_fn(n: Nat, m: Nat, j: Nat, t: Real) -> Real {
    alternating_sign[Real](j) * from_nat[Real](m.binom(j)) * pow_real_fn(n + j, t)
}

define beta_deriv_seq(n: Nat, m: Nat, t: Real, j: Nat) -> Real {
    beta_deriv_term_fn(n, m, j, t)
}

define beta_anti_deriv(n: Nat, m: Nat, t: Real) -> Real {
    partial[Real](beta_deriv_seq(n, m, t), m.suc)
}

define beta_sum_term(n: Nat, m: Nat, j: Nat) -> Real {
    alternating_sign[Real](j) * from_nat[Real](m.binom(j)) / from_nat[Real](n.suc + j)
}

define beta_sum(n: Nat, m: Nat) -> Real {
    partial[Real](beta_sum_term(n, m), m.suc)
}

define beta_closed(n: Nat, m: Nat) -> Real {
    from_nat[Real](n.factorial) * from_nat[Real](m.factorial) / from_nat[Real]((n + m + Nat.1).factorial)
}

define beta(n: Nat, m: Nat) -> Real {
    integral(beta_fn(n, m), Real.0, Real.1)
}

define family_at(f: Nat -> Real -> Real, t: Real, j: Nat) -> Real {
    f(j)(t)
}

define partial_of_family(f: Nat -> Real -> Real, m: Nat, t: Real) -> Real {
    partial[Real](family_at(f, t), m)
}

theorem family_partial_derivative(f: Nat -> Real -> Real, df: Nat -> Real -> Real, m: Nat) {
    (forall(j: Nat) { is_derivative_fn(f(j), df(j)) }) implies
    is_derivative_fn(partial_of_family(f, m), partial_of_family(df, m))
}

theorem family_partial_continuous(f: Nat -> Real -> Real, m: Nat) {
    (forall(j: Nat) { continuous(f(j)) }) implies
    continuous(partial_of_family(f, m))
}

theorem beta_anti_term_derivative(n: Nat, m: Nat, j: Nat) {
    is_derivative_fn(beta_anti_term_fn(n, m, j), beta_deriv_term_fn(n, m, j))
}

theorem beta_anti_derivative(n: Nat, m: Nat) {
    is_derivative_fn(beta_anti(n, m), beta_anti_deriv(n, m))
}

theorem beta_anti_continuous(n: Nat, m: Nat) {
    continuous(beta_anti(n, m))
}

define beta_pow_seq(m: Nat, t: Real, j: Nat) -> Real {
    alternating_sign[Real](j) * from_nat[Real](m.binom(j)) * pow_real_fn(j, t)
}

theorem beta_alternating_pow(m: Nat) {
    forall(t: Real) {
        partial[Real](beta_pow_seq(m, t), m.suc) = pow_real_fn(m, unit_minus(t))
    }
}

theorem beta_anti_deriv_eq_beta_fn(n: Nat, m: Nat) {
    beta_anti_deriv(n, m) = beta_fn(n, m)
}

theorem beta_anti_derivative_is_beta_fn(n: Nat, m: Nat) {
    is_derivative_fn(beta_anti(n, m), beta_fn(n, m))
}

theorem beta_fn_unit_bounds(n: Nat, m: Nat) {
    forall(t: Real) {
        interval_contains(Real.0, Real.1, t) implies
        Real.0 <= beta_fn(n, m, t) and beta_fn(n, m, t) <= Real.1
    }
}

theorem lipschitz_mul_on(
    f: Real -> Real, g: Real -> Real, a: Real, b: Real, lf: Real, lg: Real, bf: Real, bg: Real
) {
    Real.0 <= lf and Real.0 <= lg and Real.0 <= bf and Real.0 <= bg and
    (forall(u: Real, v: Real) {
        interval_contains(a, b, u) and interval_contains(a, b, v) implies
        (f(u) - f(v)).abs <= lf * (u - v).abs
    }) and
    (forall(u: Real, v: Real) {
        interval_contains(a, b, u) and interval_contains(a, b, v) implies
        (g(u) - g(v)).abs <= lg * (u - v).abs
    }) and
    (forall(t: Real) { interval_contains(a, b, t) implies f(t).abs <= bf }) and
    (forall(t: Real) { interval_contains(a, b, t) implies g(t).abs <= bg })
    implies
    (forall(u: Real, v: Real) {
        interval_contains(a, b, u) and interval_contains(a, b, v) implies
        (f(u) * g(u) - f(v) * g(v)).abs <= (bf * lg + bg * lf) * (u - v).abs
    })
}

theorem beta_fn_lipschitz_unit(n: Nat, m: Nat) {
    forall(u: Real, v: Real) {
        interval_contains(Real.0, Real.1, u) and interval_contains(Real.0, Real.1, v) implies
        (beta_fn(n, m, u) - beta_fn(n, m, v)).abs <= from_nat[Real](n + m) * (u - v).abs
    }
}

theorem beta_integrable(n: Nat, m: Nat) {
    is_integrable(beta_fn(n, m), Real.0, Real.1)
}

theorem beta_value(n: Nat, m: Nat) {
    beta(n, m) = beta_sum(n, m)
}

theorem beta_sum_recurrence(n: Nat, m: Nat) {
    beta_sum(n, m.suc) = beta_sum(n, m) - beta_sum(n + Nat.1, m)
}

theorem beta_sum_base(n: Nat) {
    beta_sum(n, Nat.0) = Real.1 / from_nat[Real](n.suc)
}

theorem beta_sum_value(n: Nat, m: Nat) {
    beta_sum(n, m) = beta_closed(n, m)
}

theorem beta_closed_value(n: Nat, m: Nat) {
    beta(n, m) = beta_closed(n, m)
}

theorem beta_n_zero(n: Nat) {
    beta(n, Nat.0) = Real.1 / from_nat[Real](n.suc)
}

theorem beta_sym(n: Nat, m: Nat) {
    beta(n, m) = beta(m, n)
}

theorem beta_shifted(n: Nat, m: Nat) {
    Nat.1 <= n and Nat.1 <= m implies
    beta(n - Nat.1, m - Nat.1) =
        from_nat[Real]((n - Nat.1).factorial) * from_nat[Real]((m - Nat.1).factorial) /
            from_nat[Real]((n + m - Nat.1).factorial)
}

define is_peak(a: Nat -> Real, m: Nat) -> Bool {
    forall(k: Nat) {
        m < k implies a(k) <= a(m)
    }
}

theorem peak_later_le(a: Nat -> Real, m: Nat, k: Nat) {
    is_peak(a, m) and m < k implies a(k) <= a(m)
}

theorem not_peak_imp_later_strict(a: Nat -> Real, x: Nat) {
    (not is_peak(a, x)) implies exists(k: Nat) { x < k and a(x) < a(k) }
}

theorem nat_zero_lte(n: Nat) {
    Nat.0 <= n
}

let peak_after(a: Nat -> Real, x: Nat) -> y: Nat satisfy {
    (exists(z: Nat) { x < z and is_peak(a, z) }) implies (x < y and is_peak(a, y))
}

let strict_after(a: Nat -> Real, x: Nat) -> y: Nat satisfy {
    (exists(z: Nat) { x < z and a(x) < a(z) }) implies (x < y and a(x) < a(y))
}

theorem peak_after_spec(a: Nat -> Real, x: Nat) {
    (exists(z: Nat) { x < z and is_peak(a, z) })
    implies (x < peak_after(a, x) and is_peak(a, peak_after(a, x)))
}

theorem strict_after_spec(a: Nat -> Real, x: Nat) {
    (exists(z: Nat) { x < z and a(x) < a(z) })
    implies (x < strict_after(a, x) and a(x) < a(strict_after(a, x)))
}

define peak_index(a: Nat -> Real, n: Nat) -> Nat {
    match n {
        Nat.zero { peak_after(a, Nat.0) }
        Nat.suc(pred) { peak_after(a, peak_index(a, pred)) }
    }
}

define strict_index(a: Nat -> Real, base: Nat, n: Nat) -> Nat {
    match n {
        Nat.zero { base }
        Nat.suc(pred) { strict_after(a, strict_index(a, base, pred)) }
    }
}

theorem peak_index_strict_at(a: Nat -> Real, n: Nat) {
    (forall(m: Nat) { exists(p: Nat) { m < p and is_peak(a, p) } })
    implies peak_index(a, n) < peak_index(a, n.suc)
}

theorem peak_index_later_le_at(a: Nat -> Real, n: Nat) {
    (forall(m: Nat) { exists(p: Nat) { m < p and is_peak(a, p) } })
    implies a(peak_index(a, n.suc)) <= a(peak_index(a, n))
}

theorem strict_index_strict_at(a: Nat -> Real, m0: Nat, n: Nat) {
    (forall(p: Nat) { m0 < p implies not is_peak(a, p) })
    implies strict_index(a, m0.suc, n) < strict_index(a, m0.suc, n.suc)
}

theorem strict_index_incr_at(a: Nat -> Real, m0: Nat, n: Nat) {
    (forall(p: Nat) { m0 < p implies not is_peak(a, p) })
    implies a(strict_index(a, m0.suc, n)) < a(strict_index(a, m0.suc, n.suc))
}

theorem strict_increasing_nat_distant(f: Nat -> Nat, m: Nat, n: Nat) {
    (forall(n0: Nat) { f(n0) < f(n0.suc) }) and m <= n implies f(m) <= f(n)
}

theorem strict_increasing_nat_is_nondecreasing(f: Nat -> Nat) {
    (forall(n: Nat) { f(n) < f(n.suc) })
    implies is_nondecreasing_nat(f)
}

theorem strict_increasing_nat_is_monotone(f: Nat -> Nat) {
    (forall(n: Nat) { f(n) < f(n.suc) }) implies is_monotone(f)
}

theorem strict_increasing_nat_gte_base_plus(f: Nat -> Nat, n: Nat) {
    (forall(n0: Nat) { f(n0) < f(n0.suc) })
    implies f(Nat.0) + n <= f(n)
}

theorem strict_increasing_nat_is_unbounded(f: Nat -> Nat) {
    (forall(n: Nat) { f(n) < f(n.suc) }) implies is_unbounded(f)
}

theorem unbounded_peaks_subsequence(a: Nat -> Real) {
    (forall(m: Nat) { exists(p: Nat) { m < p and is_peak(a, p) } })
    implies exists(f: Nat -> Nat) {
        is_subsequence_index(f) and is_decreasing_seq(subsequence(a, f))
    }
}

theorem no_peaks_subsequence(a: Nat -> Real) {
    (exists(m0: Nat) { forall(p: Nat) { m0 < p implies not is_peak(a, p) } })
    implies exists(f: Nat -> Nat) {
        is_subsequence_index(f) and is_increasing(subsequence(a, f))
    }
}

theorem bolzano_weierstrass(a: Nat -> Real) {
    exists(lo: Real, hi: Real) {
        forall(n: Nat) { lo <= a(n) and a(n) <= hi }
    } implies
        exists(f: Nat -> Nat, l: Real) {
            is_monotone(f) and is_unbounded(f) and converges_to(subsequence(a, f), l)
        }
}

theorem reciprocal_affine_real_has_derivative_at(a: Real, b: Real, x0: Real) {
    affine_real(a, b, x0) != Real.0 implies has_derivative_at(
        pointwise_reciprocal_real(affine_real(a, b)),
        x0,
        (-Real.1 / (affine_real(a, b, x0) * affine_real(a, b, x0))) * a
    )
}

theorem reciprocal_affine_real_differentiable_at(a: Real, b: Real, x0: Real) {
    affine_real(a, b, x0) != Real.0 implies
        differentiable_at(pointwise_reciprocal_real(affine_real(a, b)), x0)
}

theorem reciprocal_square_real_has_derivative_at(x0: Real) {
    square_real(x0) != Real.0 implies has_derivative_at(
        pointwise_reciprocal_real(square_real),
        x0,
        (-Real.1 / (square_real(x0) * square_real(x0))) * (x0 * Real.1 + x0 * Real.1)
    )
}

theorem reciprocal_square_real_differentiable_at(x0: Real) {
    square_real(x0) != Real.0 implies differentiable_at(pointwise_reciprocal_real(square_real), x0)
}

theorem affine_over_identity_has_derivative_at(a: Real, b: Real, x0: Real) {
    identity_fn[Real](x0) != Real.0 implies has_derivative_at(
        pointwise_div_real(affine_real(a, b), identity_fn[Real]),
        x0,
        (a * identity_fn[Real](x0) - affine_real(a, b, x0) * Real.1) /
            (identity_fn[Real](x0) * identity_fn[Real](x0))
    )
}

theorem affine_over_identity_differentiable_at(a: Real, b: Real, x0: Real) {
    identity_fn[Real](x0) != Real.0 implies
        differentiable_at(pointwise_div_real(affine_real(a, b), identity_fn[Real]), x0)
}

theorem square_over_identity_has_derivative_at(x0: Real) {
    identity_fn[Real](x0) != Real.0 implies has_derivative_at(
        pointwise_div_real(square_real, identity_fn[Real]),
        x0,
        ((x0 * Real.1 + x0 * Real.1) * identity_fn[Real](x0) - square_real(x0) * Real.1) /
            (identity_fn[Real](x0) * identity_fn[Real](x0))
    )
}

theorem square_over_identity_differentiable_at(x0: Real) {
    identity_fn[Real](x0) != Real.0 implies
        differentiable_at(pointwise_div_real(square_real, identity_fn[Real]), x0)
}

theorem identity_over_affine_has_derivative_at(a: Real, b: Real, x0: Real) {
    affine_real(a, b, x0) != Real.0 implies has_derivative_at(
        pointwise_div_real(identity_fn[Real], affine_real(a, b)),
        x0,
        (Real.1 * affine_real(a, b, x0) - identity_fn[Real](x0) * a) /
            (affine_real(a, b, x0) * affine_real(a, b, x0))
    )
}

theorem identity_over_affine_differentiable_at(a: Real, b: Real, x0: Real) {
    affine_real(a, b, x0) != Real.0 implies
        differentiable_at(pointwise_div_real(identity_fn[Real], affine_real(a, b)), x0)
}

theorem square_over_affine_has_derivative_at(a: Real, b: Real, x0: Real) {
    affine_real(a, b, x0) != Real.0 implies has_derivative_at(
        pointwise_div_real(square_real, affine_real(a, b)),
        x0,
        ((x0 * Real.1 + x0 * Real.1) * affine_real(a, b, x0) - square_real(x0) * a) /
            (affine_real(a, b, x0) * affine_real(a, b, x0))
    )
}

theorem square_over_affine_differentiable_at(a: Real, b: Real, x0: Real) {
    affine_real(a, b, x0) != Real.0 implies
        differentiable_at(pointwise_div_real(square_real, affine_real(a, b)), x0)
}

define seq_in_real_set(s: Set[Real], a: Nat -> Real) -> Bool {
    forall(n: Nat) {
        s.contains(a(n))
    }
}

define seq_eventually_in_real_set(s: Set[Real], a: Nat -> Real) -> Bool {
    exists(n0: Nat) {
        forall(n: Nat) {
            n0 <= n implies s.contains(a(n))
        }
    }
}

define seq_frequently_in_real_set(s: Set[Real], a: Nat -> Real) -> Bool {
    forall(n_start: Nat) {
        exists(n_witness: Nat) {
            n_start <= n_witness and s.contains(a(n_witness))
        }
    }
}

theorem seq_frequently_in_real_set_at(s: Set[Real], a: Nat -> Real, n_start: Nat) {
    seq_frequently_in_real_set(s, a) implies exists(n_witness: Nat) {
        n_start <= n_witness and s.contains(a(n_witness))
    }
}
