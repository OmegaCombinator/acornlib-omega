theorem secant_remainder_is_derivative_on_open(f: Real -> Real, df: Real -> Real, a: Real, b: Real) {
    is_derivative_fn(f, df)
    implies is_derivative_on_open(secant_remainder(f, a, b),
        secant_remainder_derivative(df, f, a, b), a, b)
}

