theorem slope_inequality_imp_convex_combination(f: Real -> Real, x: Real, z: Real, y: Real, t: Real) {
    x < z and z < y and z = (Real.1 - t) * x + t * y and
    secant_slope(f, x, z) <= secant_slope(f, z, y)
    implies f(z) <= (Real.1 - t) * f(x) + t * f(y)
