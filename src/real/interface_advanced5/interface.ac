attributes Real {
    /// The real cube root, with the negative branch defined by odd symmetry.
    define cbrt(self) -> Real {
        if self < Real.0 {
            -(one_third * (-self).log.get_or_else(Real.0)).exp
        } else {
            if self > Real.0 {
                (one_third * self.log.get_or_else(Real.0)).exp
            } else {
                Real.0
            }
        }
    }
}

theorem cbrt_zero {
