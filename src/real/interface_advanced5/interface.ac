define beta_deriv_term_fn(n: Nat, m: Nat, j: Nat, t: Real) -> Real {
    alternating_sign[Real](j) * from_nat[Real](m.binom(j)) * pow_real_fn(n + j, t)
}

define beta_deriv_seq(n: Nat, m: Nat, t: Real, j: Nat) -> Real {
