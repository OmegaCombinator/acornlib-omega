define beta_anti_coeff(n: Nat, m: Nat, j: Nat) -> Real {
    alternating_sign[Real](j) * from_nat[Real](m.binom(j)) / from_nat[Real](n.suc + j)
}

define beta_anti_term_fn(n: Nat, m: Nat, j: Nat, t: Real) -> Real {
