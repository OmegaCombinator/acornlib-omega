    x < Real.0 implies x.cbrt < Real.0
}

theorem one_third_exp_cube_pos(x: Real) {
    x > Real.0 implies
    (one_third * x.log.get_or_else(Real.0)).exp * (one_third * x.log.get_or_else(Real.0)).exp * (one_third * x.log.get_or_else(Real.0)).exp = x
}

