theorem exp_convex_combine(x: Real, y: Real, p: Real, q: Real) {
    x > Real.0 and y > Real.0 and p > Real.1 and q > Real.1 and Real.1 / p + Real.1 / q = Real.1
    implies (x.log.get_or_else(Real.0) / p + y.log.get_or_else(Real.0) / q).exp <= x / p + y / q
}

theorem young_nonneg(x: Real, y: Real, p: Real, q: Real) {
    x >= Real.0 and y >= Real.0 and p > Real.1 and q > Real.1 and
        Real.1 / p + Real.1 / q = Real.1
    implies exists(uu: Real, vv: Real) {
        x.rpow(Real.1 / p) = Option.some(uu)
        and y.rpow(Real.1 / q) = Option.some(vv)
        and uu * vv <= x / p + y / q
    }
}

theorem abs_pow_sum_nonneg(a: Nat -> Real, p: Real, n: Nat) {
    p > Real.0 implies abs_pow_sum(a, p, n) >= Real.0
}

define norm_abs_pow(a: Nat -> Real, p: Real, aa: Real, i: Nat) -> Real {
    abs_pow_value(a, p, i) / aa
}

theorem norm_abs_pow_sum_eq_one(a: Nat -> Real, p: Real, n: Nat) {
    abs_pow_sum(a, p, n) > Real.0 implies
        partial(norm_abs_pow(a, p, abs_pow_sum(a, p, n)), n) = Real.1
}

define holder_rhs_first(a: Nat -> Real, p: Real, aa: Real, i: Nat) -> Real {
    (abs_pow_value(a, p, i) / aa) / p
}

define holder_rhs_second(b: Nat -> Real, q: Real, bb: Real, i: Nat) -> Real {
    (abs_pow_value(b, q, i) / bb) / q
}

define holder_rhs(a: Nat -> Real, b: Nat -> Real, p: Real, q: Real, aa: Real, bb: Real, i: Nat) -> Real {
    holder_rhs_first(a, p, aa, i) + holder_rhs_second(b, q, bb, i)
}

theorem holder_rhs_first_sum(a: Nat -> Real, n: Nat, p: Real) {
    p > Real.0 and abs_pow_sum(a, p, n) > Real.0 implies
        partial(holder_rhs_first(a, p, abs_pow_sum(a, p, n)), n) = Real.1 / p
}

theorem holder_rhs_second_sum(b: Nat -> Real, n: Nat, q: Real) {
    q > Real.0 and abs_pow_sum(b, q, n) > Real.0 implies
        partial(holder_rhs_second(b, q, abs_pow_sum(b, q, n)), n) = Real.1 / q
}

theorem holder_rhs_sum_eq_one(a: Nat -> Real, b: Nat -> Real, n: Nat, p: Real, q: Real) {
    p > Real.0 and q > Real.0 and Real.1 / p + Real.1 / q = Real.1
    and abs_pow_sum(a, p, n) > Real.0 and abs_pow_sum(b, q, n) > Real.0
    implies partial(holder_rhs(a, b, p, q, abs_pow_sum(a, p, n), abs_pow_sum(b, q, n)), n) = Real.1
}

define holder_lhs(a: Nat -> Real, b: Nat -> Real, uu: Real, vv: Real, i: Nat) -> Real {
    (a(i).abs / uu) * (b(i).abs / vv)
}

theorem holder_lhs_scaled(a: Nat -> Real, b: Nat -> Real, n: Nat, uu: Real, vv: Real) {
    uu > Real.0 and vv > Real.0
    implies partial(holder_lhs(a, b, uu, vv), n) = (Real.1 / (uu * vv)) * partial(abs_product(a, b), n)
}

theorem abs_product_sum_zero_of_abs_pow_sum_zero(a: Nat -> Real, b: Nat -> Real, n: Nat, p: Real) {
    p > Real.0 and abs_pow_sum(a, p, n) = Real.0 implies partial(abs_product(a, b), n) = Real.0
}

theorem rpow_root_zero_of_sum_zero(a: Nat -> Real, n: Nat, p: Real, uu: Real) {
    p > Real.0 and abs_pow_sum(a, p, n) = Real.0 and (abs_pow_sum(a, p, n)).rpow(Real.1 / p) = Option.some(uu)
    implies uu = Real.0
}

theorem abs_product_symm(a: Nat -> Real, b: Nat -> Real, n: Nat) {
    partial(abs_product(a, b), n) = partial(abs_product(b, a), n)
}

theorem finite_holder(a: Nat -> Real, b: Nat -> Real, n: Nat, p: Real, q: Real, uu: Real, vv: Real) {
    p > Real.1 and q > Real.1 and Real.1 / p + Real.1 / q = Real.1
    and (abs_pow_sum(a, p, n)).rpow(Real.1 / p) = Option.some(uu)
    and (abs_pow_sum(b, q, n)).rpow(Real.1 / q) = Option.some(vv)
    implies partial(abs_product(a, b), n) <= uu * vv
}

theorem finite_holder_exists(a: Nat -> Real, b: Nat -> Real, n: Nat, p: Real, q: Real) {
    p > Real.1 and q > Real.1 and Real.1 / p + Real.1 / q = Real.1
    implies exists(uu: Real, vv: Real) {
        (abs_pow_sum(a, p, n)).rpow(Real.1 / p) = Option.some(uu)
        and (abs_pow_sum(b, q, n)).rpow(Real.1 / q) = Option.some(vv)
        and partial(abs_product(a, b), n) <= uu * vv
    }
}

define conjugate_exponent(p: Real) -> Real {
    p / (p - Real.1)
}

theorem sub_one_pos(x: Real) {
    x > Real.1 implies x - Real.1 > Real.0
}

theorem div_add_same_denom_simple(a: Real, b: Real, p: Real) {
    p != Real.0 implies a / p + b / p = (a + b) / p
}

theorem conjugate_exponent_recip_value(p: Real) {
    p > Real.1 implies Real.1 / conjugate_exponent(p) = (p - Real.1) / p
}

theorem conjugate_exponent_recip(p: Real) {
    p > Real.1 implies Real.1 / p + Real.1 / conjugate_exponent(p) = Real.1
}

theorem conjugate_exponent_gt_one(p: Real) {
    p > Real.1 implies conjugate_exponent(p) > Real.1
}

theorem conjugate_exponent_pow(p: Real) {
    p > Real.1 implies (p - Real.1) * conjugate_exponent(p) = p
}

theorem abs_eq_self_of_nonneg(x: Real) {
    x >= Real.0 implies x.abs = x
}

theorem abs_mul_nonneg_val(x: Real, y: Real) {
    y >= Real.0 implies (x * y).abs = x.abs * y
}

theorem rpow_value_nonneg(base: Real, exponent: Real, value: Real) {
    base >= Real.0 and exponent > Real.0 and base.rpow(exponent) = Option.some(value)
    implies value >= Real.0
}

theorem rpow_value_pos(base: Real, exponent: Real, value: Real) {
    base > Real.0 and exponent > Real.0 and base.rpow(exponent) = Option.some(value)
    implies value > Real.0
}

define abs_sum_pow_minus_one(a: Nat -> Real, b: Nat -> Real, p: Real, i: Nat) -> Real {
    abs_pow_value(add_fn(a, b), p - Real.1, i)
}

define abs_mul_conjugate(a: Nat -> Real, b: Nat -> Real, p: Real, i: Nat) -> Real {
    a(i).abs * abs_sum_pow_minus_one(a, b, p, i)
}

define abs_triangle_expand(a: Nat -> Real, b: Nat -> Real, p: Real, i: Nat) -> Real {
    (a(i).abs + b(i).abs) * abs_sum_pow_minus_one(a, b, p, i)
}

define abs_sum_triangle_term(a: Nat -> Real, b: Nat -> Real, p: Real, i: Nat) -> Real {
    (a(i) + b(i)).abs * abs_sum_pow_minus_one(a, b, p, i)
}

theorem abs_pow_value_split(a: Nat -> Real, p: Real, i: Nat) {
    p > Real.1 implies abs_pow_value(a, p, i) = a(i).abs * abs_pow_value(a, p - Real.1, i)
}

theorem abs_triangle_term_le(a: Nat -> Real, b: Nat -> Real, p: Real, i: Nat) {
    p > Real.1 implies abs_sum_triangle_term(a, b, p, i) <= abs_triangle_expand(a, b, p, i)
}

theorem abs_triangle_expand_add(a: Nat -> Real, b: Nat -> Real, p: Real, i: Nat) {
    abs_triangle_expand(a, b, p, i) = abs_mul_conjugate(a, b, p, i) + abs_mul_conjugate(b, a, p, i)
}

theorem abs_product_conjugate_eq(a: Nat -> Real, b: Nat -> Real, p: Real, i: Nat) {
    p > Real.1 implies abs_product(a, abs_sum_pow_minus_one(a, b, p), i) = abs_mul_conjugate(a, b, p, i)
}

theorem abs_pow_value_pow_pow(a: Nat -> Real, b: Nat -> Real, p: Real, q: Real, i: Nat) {
    p > Real.1 and q > Real.0 and (p - Real.1) * q = p
    implies abs_pow_value(abs_sum_pow_minus_one(a, b, p), q, i) = abs_pow_value(add_fn(a, b), p, i)
}

theorem abs_pow_sum_c_eq_w(a: Nat -> Real, b: Nat -> Real, n: Nat, p: Real, q: Real) {
    p > Real.1 and q > Real.0 and (p - Real.1) * q = p
    implies abs_pow_sum(abs_sum_pow_minus_one(a, b, p), q, n) = abs_pow_sum(add_fn(a, b), p, n)
}

theorem holder_lhs_conjugate_sum(a: Nat -> Real, b: Nat -> Real, n: Nat, p: Real) {
    p > Real.1 implies
        partial(abs_product(a, abs_sum_pow_minus_one(a, b, p)), n) = partial(abs_mul_conjugate(a, b, p), n)
}

theorem finite_minkowski(a: Nat -> Real, b: Nat -> Real, n: Nat, p: Real, uu: Real, vv: Real, ww: Real, ww_q: Real) {
    p > Real.1
    and (abs_pow_sum(a, p, n)).rpow(Real.1 / p) = Option.some(uu)
    and (abs_pow_sum(b, p, n)).rpow(Real.1 / p) = Option.some(vv)
    and (abs_pow_sum(add_fn(a, b), p, n)).rpow(Real.1 / p) = Option.some(ww)
    and (abs_pow_sum(add_fn(a, b), p, n)).rpow(Real.1 / conjugate_exponent(p)) = Option.some(ww_q)
    implies ww <= uu + vv
}

theorem finite_minkowski_exists(a: Nat -> Real, b: Nat -> Real, n: Nat, p: Real) {
    p > Real.1 implies exists(uu: Real, vv: Real, ww: Real) {
        (abs_pow_sum(a, p, n)).rpow(Real.1 / p) = Option.some(uu)
        and (abs_pow_sum(b, p, n)).rpow(Real.1 / p) = Option.some(vv)
        and (abs_pow_sum(add_fn(a, b), p, n)).rpow(Real.1 / p) = Option.some(ww)
        and ww <= uu + vv
    }
}

define recip_fn(f: Nat -> Real, i: Nat) -> Real {
    Real.1 / f(i)
}

define finite_harmonic_mean(f: Nat -> Real, n: Nat) -> Real {
    from_nat[Real](n) / partial(recip_fn(f), n)
}

theorem positive_on_recip(f: Nat -> Real, n: Nat) {
    positive_on(f, n) implies positive_on(recip_fn(f), n)
}

theorem finite_real_product_recip(f: Nat -> Real, n: Nat) {
    positive_on(f, n) implies finite_real_product(recip_fn(f), n) = Real.1 / finite_real_product(f, n)
}

theorem recip_geometric_mean(f: Nat -> Real, n: Nat, g: Real) {
    n != Nat.0 and positive_on(f, n) and (finite_real_product(f, n)).rpow(Real.1 / from_nat[Real](n)) = Option.some(g)
    implies (finite_real_product(recip_fn(f), n)).rpow(Real.1 / from_nat[Real](n)) = Option.some(Real.1 / g)
}

theorem harmonic_mean_eq_recip_am(f: Nat -> Real, n: Nat) {
    n != Nat.0 and positive_on(f, n) implies
        finite_harmonic_mean(f, n) = Real.1 / finite_real_mean(recip_fn(f), n)
}

theorem harmonic_mean_le_geometric_mean(f: Nat -> Real, n: Nat) {
    n != Nat.0 and positive_on(f, n) implies exists(g: Real) {
        (finite_real_product(f, n)).rpow(Real.1 / from_nat[Real](n)) = Option.some(g)
        and finite_harmonic_mean(f, n) <= g
    }
}

theorem harmonic_mean_le_arithmetic_mean(f: Nat -> Real, n: Nat) {
    n != Nat.0 and positive_on(f, n) implies exists(a: Real) {
        a = finite_real_mean(f, n)
        and finite_harmonic_mean(f, n) <= a
    }
}

theorem finite_holder_p2(a: Nat -> Real, b: Nat -> Real, n: Nat) {
    exists(uu: Real, vv: Real) {
        (abs_pow_sum(a, Real.1 + Real.1, n)).rpow(Real.1 / (Real.1 + Real.1)) = Option.some(uu)
        and (abs_pow_sum(b, Real.1 + Real.1, n)).rpow(Real.1 / (Real.1 + Real.1)) = Option.some(vv)
        and partial(abs_product(a, b), n) <= uu * vv
    }
}

theorem rpow_ge_one_of_base_ge_one_exp_nonneg(base: Real, exponent: Real) {
    base >= Real.1 and exponent >= Real.0 implies exists(value: Real) {
        base.rpow(exponent) = Option.some(value) and value >= Real.1
    }
}

theorem rpow_le_one_of_base_ge_one_exp_nonpos(base: Real, exponent: Real) {
    base >= Real.1 and exponent <= Real.0 implies exists(value: Real) {
        base.rpow(exponent) = Option.some(value) and value <= Real.1
    }
}

theorem rpow_le_one_of_pos_base_le_one_exp_nonneg(base: Real, exponent: Real) {
    base > Real.0 and base <= Real.1 and exponent >= Real.0 implies exists(value: Real) {
        base.rpow(exponent) = Option.some(value) and value <= Real.1
    }
}

theorem rpow_ge_one_of_pos_base_le_one_exp_nonpos(base: Real, exponent: Real) {
    base > Real.0 and base <= Real.1 and exponent <= Real.0 implies exists(value: Real) {
        base.rpow(exponent) = Option.some(value) and value >= Real.1
    }
}

theorem rpow_exponent_monotone_base_ge_one(base: Real, a: Real, b: Real, va: Real, vb: Real) {
    base >= Real.1 and a <= b and base.rpow(a) = Option.some(va) and base.rpow(b) = Option.some(vb)
    implies va <= vb
}

define power_series_term(a: Nat -> Real, x: Real, k: Nat) -> Real {
    a(k) * x.pow(k)
}

theorem pow_mul_distrib(x: Real, y: Real, n: Nat) {
    (x * y).pow(n) = x.pow(n) * y.pow(n)
}

theorem series_conv_imp_terms_bounded(a: Nat -> Real) {
    converges(partial(a)) implies is_bounded_seq(a)
}

theorem abs_pos_of_ne_zero(x: Real) {
    x != Real.0 implies x.abs > Real.0
}

theorem div_lt_one(a: Real, b: Real) {
    a < b and b > Real.0 implies a / b < Real.1
}

theorem div_nonneg_of_nonneg(a: Real, b: Real) {
    Real.0 <= a and b > Real.0 implies Real.0 <= a / b
}

theorem abs_pow_abs(x: Real, n: Nat) {
    x.pow(n).abs = x.abs.pow(n)
}

theorem power_series_abs_conv_inside_radius(a: Nat -> Real, x: Real, x0: Real) {
    converges(partial(power_series_term(a, x0))) and x0 != Real.0 and x.abs < x0.abs
    implies absolutely_converges(power_series_term(a, x))
}

define sbp_step(f: Nat -> Real, g: Nat -> Real, k: Nat) -> Real {
    partial(f, k.suc) * (g(k.suc) - g(k))
}

theorem sub_sub_cancel(x: Real, y: Real) {
    x - (x - y) = y
}

theorem mul_sub_cancel(a: Real, b: Real, c: Real) {
    a * b - a * (b - c) = a * c
}

theorem sub_add_rearrange(a: Real, b: Real, c: Real, d: Real) {
    a + b - (c + d) = (a - c) + (b - d)
}

theorem summation_by_parts(f: Nat -> Real, g: Nat -> Real, n: Nat) {
    partial(prod_seq(f, g), n) =
        partial(f, n) * g(n) - sum(map(n.range, sbp_step(f, g)))
}

theorem sqrt_zero {
    Real.0.sqrt = Option.some(Real.0)
}

theorem sqrt_pos(x: Real) {
    x > Real.0 implies exists(y: Real) {
        x.sqrt = Option.some(y) and y > Real.0
    }
}

theorem sqrt_mul_self(x: Real) {
    x >= Real.0 implies exists(y: Real) {
        x.sqrt = Option.some(y) and y * y = x
    }
}

theorem sqrt_square_of_nonneg(x: Real) {
    x >= Real.0 implies (x * x).sqrt = Option.some(x)
}

theorem sqrt_unique_nonneg(x: Real, y: Real) {
    x >= Real.0 and y >= Real.0 and y * y = x implies x.sqrt = Option.some(y)
}

theorem sqrt_one {
    Real.1.sqrt = Option.some(Real.1)
}

theorem sqrt_abs_square(x: Real) {
    (x.abs * x.abs).sqrt = Option.some(x.abs)
}

theorem sqrt_square_eq_abs(x: Real) {
    (x * x).sqrt = Option.some(x.abs)
}

theorem sqrt_abs_mul_abs_eq_abs(x: Real) {
    (x.abs * x.abs).sqrt = Option.some(x.abs)
}

theorem one_half_mul_double(x: Real) {
    Real.one_half * (x + x) = x
}

theorem one_half_eq_one_div_two {
    Real.one_half = Real.1 / (Real.1 + Real.1)
}

theorem double_le_imp_le_half(x: Real, y: Real) {
    x + x <= y implies x <= Real.one_half * y
}

theorem square_gap_imp_double_le(q: Real, p: Real, r: Real) {
    q + -p + (-p + r) >= Real.0 implies p + p <= q + r
}

theorem double_mul_le_square_sum(x: Real, y: Real) {
    x * y + x * y <= x * x + y * y
}

theorem double_mul_eq_square_sum_imp_eq(x: Real, y: Real) {
    x * y + x * y = x * x + y * y implies x = y
}

theorem square_le_square_of_nonneg(a: Real, b: Real) {
    a >= Real.0 and b >= Real.0 and a * a <= b * b implies a <= b
}

theorem sqrt_value_nonneg(x: Real, y: Real) {
    x.sqrt = Option.some(y) implies y >= Real.0
}

theorem sqrt_value_mul_self(x: Real, y: Real) {
    x >= Real.0 and x.sqrt = Option.some(y) implies y * y = x
}

theorem sqrt_mul(a: Real, b: Real, x: Real, y: Real) {
    a >= Real.0 and b >= Real.0 and a.sqrt = Option.some(x) and b.sqrt = Option.some(y)
    implies (a * b).sqrt = Option.some(x * y)
}

theorem sqrt_monotone(a: Real, b: Real, x: Real, y: Real) {
    Real.0 <= a and a <= b and a.sqrt = Option.some(x) and b.sqrt = Option.some(y)
    implies x <= y
}

theorem sqrt_mul_le_arithmetic_mean(a: Real, b: Real) {
    a >= Real.0 and b >= Real.0 implies exists(g: Real) {
        (a * b).sqrt = Option.some(g) and g <= Real.one_half * (a + b)
    }
}

theorem sqrt_mul_le_arithmetic_mean_div(a: Real, b: Real) {
    a >= Real.0 and b >= Real.0 implies exists(g: Real) {
        (a * b).sqrt = Option.some(g) and g <= (a + b) / (Real.1 + Real.1)
    }
}

theorem sqrt_mul_eq_arithmetic_mean_imp_eq(a: Real, b: Real) {
    a > Real.0 and b > Real.0 and (a * b).sqrt = Option.some((a + b) / (Real.1 + Real.1))
    implies a = b
}

let taylor_two: Real = Real.1 + Real.1

theorem taylor_two_not_zero {
    taylor_two != Real.0
}

define taylor2_lin(f: Real -> Real, df: Real -> Real, a: Real, x: Real) -> Real {
    f(a) + df(a) * (x - a)
}

define taylor2_lin_remainder(f: Real -> Real, df: Real -> Real, a: Real, x: Real) -> Real {
    f(x) - taylor2_lin(f, df, a, x)
}

define taylor2_sq(a: Real, x: Real) -> Real {
    square_real(x - a)
}

define taylor2_delta(f: Real -> Real, df: Real -> Real, a: Real, b: Real) -> Real {
    f(b) - f(a) - df(a) * (b - a)
}

define taylor2_aux(f: Real -> Real, df: Real -> Real, a: Real, b: Real, x: Real) -> Real {
    square_real(b - a) * taylor2_lin_remainder(f, df, a, x) -
        taylor2_delta(f, df, a, b) * taylor2_sq(a, x)
}

define taylor2_aux_derivative(f: Real -> Real, df: Real -> Real, a: Real, b: Real, x: Real) -> Real {
    square_real(b - a) * (df(x) - df(a)) -
        taylor2_delta(f, df, a, b) * taylor_two * (x - a)
}

define taylor2_aux_second_derivative(f: Real -> Real, df: Real -> Real, ddf: Real -> Real, a: Real, b: Real, x: Real) -> Real {
    square_real(b - a) * ddf(x) -
        taylor2_delta(f, df, a, b) * taylor_two
}

theorem taylor_order_one(f: Real -> Real, df: Real -> Real, a: Real, b: Real) {
    continuous(f) and a < b and is_derivative_fn(f, df)
    implies exists(c: Real) {
        a < c and c < b and f(b) = f(a) + df(c) * (b - a)
    }
}

theorem taylor2_aux_eq_pointwise(f: Real -> Real, df: Real -> Real, a: Real, b: Real) {
    taylor2_aux(f, df, a, b) = pointwise_add(
        pointwise_mul(constant[Real, Real](square_real(b - a)),
            pointwise_add(f, pointwise_neg(affine_real(df(a), f(a) - df(a) * a)))),
        pointwise_neg(pointwise_mul(constant[Real, Real](taylor2_delta(f, df, a, b)),
            compose(square_real, affine_real(Real.1, -a)))))
}

theorem taylor2_aux_derivative_eq_pointwise(f: Real -> Real, df: Real -> Real, a: Real, b: Real) {
    taylor2_aux_derivative(f, df, a, b) = pointwise_add(
        pointwise_mul(constant[Real, Real](square_real(b - a)),
            pointwise_add(df, pointwise_neg(constant[Real, Real](df(a))))),
        pointwise_neg(pointwise_mul(constant[Real, Real](taylor2_delta(f, df, a, b) * taylor_two),
            affine_real(Real.1, -a))))
}

theorem taylor2_aux_continuous_on_closed(f: Real -> Real, df: Real -> Real, a: Real, b: Real, u: Real, v: Real) {
    is_derivative_fn(f, df)
    implies continuous_on_closed(taylor2_aux(f, df, a, b), u, v)
}

theorem is_derivative_fn_imp_is_derivative_on_open(
    f: Real -> Real, df: Real -> Real, a: Real, b: Real
) {
    is_derivative_fn(f, df) implies is_derivative_on_open(f, df, a, b)
}

theorem taylor2_sq_has_derivative_at(a: Real, x0: Real) {
    has_derivative_at(compose(square_real, affine_real(Real.1, -a)), x0, taylor_two * (x0 - a))
}

theorem taylor2_aux_derivative_continuous_on_closed(f: Real -> Real, df: Real -> Real, ddf: Real -> Real, a: Real, b: Real, u: Real, v: Real) {
    is_derivative_fn(df, ddf)
    implies continuous_on_closed(taylor2_aux_derivative(f, df, a, b), u, v)
}

theorem taylor2_aux_is_derivative_fn(f: Real -> Real, df: Real -> Real, a: Real, b: Real) {
    is_derivative_fn(f, df)
    implies is_derivative_fn(taylor2_aux(f, df, a, b), taylor2_aux_derivative(f, df, a, b))
}

theorem taylor2_aux_derivative_is_derivative_fn(f: Real -> Real, df: Real -> Real, ddf: Real -> Real, a: Real, b: Real) {
    is_derivative_fn(df, ddf)
    implies is_derivative_fn(taylor2_aux_derivative(f, df, a, b),
        taylor2_aux_second_derivative(f, df, ddf, a, b))
}

theorem taylor2_aux_at_a_zero(f: Real -> Real, df: Real -> Real, a: Real, b: Real) {
    taylor2_aux(f, df, a, b, a) = Real.0
}

theorem taylor2_aux_at_b_zero(f: Real -> Real, df: Real -> Real, a: Real, b: Real) {
    taylor2_aux(f, df, a, b, b) = Real.0
}

theorem taylor2_aux_endpoints_equal(f: Real -> Real, df: Real -> Real, a: Real, b: Real) {
    taylor2_aux(f, df, a, b, a) = taylor2_aux(f, df, a, b, b)
}

theorem taylor2_aux_derivative_at_a_zero(f: Real -> Real, df: Real -> Real, a: Real, b: Real) {
    taylor2_aux_derivative(f, df, a, b, a) = Real.0
}

theorem taylor2_sub_add_cancel(a: Real, b: Real) {
    (a - b) + b = a
}

theorem taylor2_sub_sub_add(a: Real, b: Real, c: Real) {
    (a - b - c) + b = a - c
}

theorem taylor2_conclusion_from_second_derivative(f: Real -> Real, df: Real -> Real, ddf: Real -> Real, a: Real, b: Real, c: Real) {
    taylor2_aux_second_derivative(f, df, ddf, a, b, c) = Real.0
    implies f(b) = f(a) + df(a) * (b - a) + (ddf(c) / taylor_two) * (b - a) * (b - a)
}

theorem taylor_order_two(f: Real -> Real, df: Real -> Real, ddf: Real -> Real, a: Real, b: Real) {
    a < b and is_derivative_fn(f, df) and is_derivative_fn(df, ddf)
    implies exists(c: Real) {
        a < c and c < b and
        f(b) = f(a) + df(a) * (b - a) + (ddf(c) / taylor_two) * (b - a) * (b - a)
    }
}

define newton_step(f: Real -> Real, fp: Real -> Real, x: Real) -> Real {
    x - f(x) / fp(x)
}

define newton_seq(f: Real -> Real, fp: Real -> Real, x0: Real, n: Nat) -> Real {
    match n {
        Nat.zero {
            x0
        }
        Nat.suc(m) {
            newton_step(f, fp, newton_seq(f, fp, x0, m))
        }
    }
}

theorem newton_seq_zero(f: Real -> Real, fp: Real -> Real, x0: Real) {
    newton_seq(f, fp, x0, Nat.0) = x0
}

theorem newton_seq_suc(f: Real -> Real, fp: Real -> Real, x0: Real, n: Nat) {
    newton_seq(f, fp, x0, n.suc) = newton_step(f, fp, newton_seq(f, fp, x0, n))
}

theorem newton_step_root_fixed_point(f: Real -> Real, fp: Real -> Real, xstar: Real) {
    f(xstar) = Real.0 and fp(xstar) != Real.0 implies
        newton_step(f, fp, xstar) = xstar
}

theorem newton_seq_root_constant(f: Real -> Real, fp: Real -> Real, xstar: Real) {
    f(xstar) = Real.0 and fp(xstar) != Real.0 implies
        forall(n: Nat) { newton_seq(f, fp, xstar, n) = xstar }
}

theorem newton_error_quadratic(f: Real -> Real, fp: Real -> Real, ddf: Real -> Real, x: Real, xstar: Real) {
    x < xstar and f(xstar) = Real.0 and fp(x) != Real.0 and
    is_derivative_fn(f, fp) and is_derivative_fn(fp, ddf)
    implies exists(c: Real) {
        x < c and c < xstar and
        newton_step(f, fp, x) - xstar =
            ((ddf(c) / taylor_two) * (xstar - x) * (xstar - x)) / fp(x)
    }
}

theorem newton_taylor_two_pos {
    taylor_two > Real.0
}

theorem newton_seq_error_quadratic(f: Real -> Real, fp: Real -> Real, ddf: Real -> Real, x0: Real, xstar: Real, n: Nat) {
    newton_seq(f, fp, x0, n) < xstar and f(xstar) = Real.0 and
    fp(newton_seq(f, fp, x0, n)) != Real.0 and
    is_derivative_fn(f, fp) and is_derivative_fn(fp, ddf)
    implies exists(c: Real) {
        newton_seq(f, fp, x0, n) < c and c < xstar and
        newton_seq(f, fp, x0, n.suc) - xstar =
            ((ddf(c) / taylor_two) * (xstar - newton_seq(f, fp, x0, n)) *
                (xstar - newton_seq(f, fp, x0, n))) /
                fp(newton_seq(f, fp, x0, n))
    }
}

theorem newton_error_bounded(f: Real -> Real, fp: Real -> Real, ddf: Real -> Real, x: Real, xstar: Real, m: Real, bigm: Real) {
    x < xstar and f(xstar) = Real.0 and fp(x) != Real.0 and
    is_derivative_fn(f, fp) and is_derivative_fn(fp, ddf) and
    m.is_positive and m <= fp(x).abs and
    (forall(z: Real) { x <= z and z <= xstar implies ddf(z).abs <= bigm })
    implies (newton_step(f, fp, x) - xstar).abs <=
        ((bigm / taylor_two) * (xstar - x) * (xstar - x)) / m
}

let taylor_three: Real = Real.1 + Real.1 + Real.1

let taylor_six: Real = taylor_two * taylor_three

theorem from_nat_two_real {
    from_nat[Real](Nat.2) = taylor_two
}

theorem from_nat_three_real {
    from_nat[Real](Nat.3) = taylor_three
}

theorem from_nat_six_real {
    from_nat[Real](Nat.6) = taylor_six
}

theorem taylor_three_not_zero {
    taylor_three != Real.0
}

theorem taylor_six_not_zero {
    taylor_six != Real.0
}

define is_derivative_chain(f: Real -> Real, dfs: Nat -> Real -> Real, n: Nat) -> Bool {
    dfs(Nat.0) = f and forall(k: Nat) {
        k < n implies is_derivative_fn(dfs(k), dfs(k.suc))
    }
}

define taylor_term(f: Real -> Real, dfs: Nat -> Real -> Real, a: Real, x: Real, k: Nat) -> Real {
    (iterated_derivative(f, dfs, k, a) / from_nat[Real](k.factorial)) * (x - a).pow(k)
}

define taylor_poly(f: Real -> Real, dfs: Nat -> Real -> Real, a: Real, x: Real, n: Nat) -> Real {
    partial(taylor_term(f, dfs, a, x), n.suc)
}

define taylor_remainder(f: Real -> Real, dfs: Nat -> Real -> Real, a: Real, x: Real, c: Real, n: Nat) -> Real {
    (iterated_derivative(f, dfs, n.suc, c) / from_nat[Real](n.suc.factorial)) * (x - a).pow(n.suc)
}

define taylor_chain1(f: Real -> Real, df: Real -> Real, k: Nat) -> Real -> Real {
    match k {
        Nat.zero { f }
        Nat.suc(m) { df }
    }
}

define taylor_chain2(f: Real -> Real, df: Real -> Real, ddf: Real -> Real, k: Nat) -> Real -> Real {
    match k {
        Nat.zero { f }
        Nat.suc(m) {
            match m {
                Nat.zero { df }
                Nat.suc(m2) { ddf }
            }
        }
    }
}

define taylor_chain3_tail2(ddf: Real -> Real, dddf: Real -> Real, k: Nat) -> Real -> Real {
    match k {
        Nat.zero { ddf }
        Nat.suc(m) { dddf }
    }
}

define taylor_chain3_tail(df: Real -> Real, ddf: Real -> Real, dddf: Real -> Real, k: Nat) -> Real -> Real {
    match k {
        Nat.zero { df }
        Nat.suc(m) { taylor_chain3_tail2(ddf, dddf, m) }
    }
}

define taylor_chain3(f: Real -> Real, df: Real -> Real, ddf: Real -> Real, dddf: Real -> Real, k: Nat) -> Real -> Real {
    match k {
        Nat.zero { f }
        Nat.suc(m) { taylor_chain3_tail(df, ddf, dddf, m) }
    }
}

define taylor_chain4_tail3(dddf: Real -> Real, dddd: Real -> Real, k: Nat) -> Real -> Real {
    match k {
        Nat.zero { dddf }
        Nat.suc(m) { dddd }
    }
}

define taylor_chain4_tail2(ddf: Real -> Real, dddf: Real -> Real, dddd: Real -> Real, k: Nat) -> Real -> Real {
    match k {
        Nat.zero { ddf }
        Nat.suc(m) { taylor_chain4_tail3(dddf, dddd, m) }
    }
}

define taylor_chain4_tail(df: Real -> Real, ddf: Real -> Real, dddf: Real -> Real, dddd: Real -> Real, k: Nat) -> Real -> Real {
    match k {
        Nat.zero { df }
        Nat.suc(m) { taylor_chain4_tail2(ddf, dddf, dddd, m) }
    }
}

define taylor_chain4(f: Real -> Real, df: Real -> Real, ddf: Real -> Real, dddf: Real -> Real, dddd: Real -> Real, k: Nat) -> Real -> Real {
    match k {
        Nat.zero { f }
        Nat.suc(m) { taylor_chain4_tail(df, ddf, dddf, dddd, m) }
    }
}

theorem taylor_chain1_zero(f: Real -> Real, df: Real -> Real) {
    taylor_chain1(f, df, Nat.0) = f
}

theorem taylor_chain1_suc(f: Real -> Real, df: Real -> Real, k: Nat) {
    taylor_chain1(f, df, k.suc) = df
}

theorem taylor_chain2_zero(f: Real -> Real, df: Real -> Real, ddf: Real -> Real) {
    taylor_chain2(f, df, ddf, Nat.0) = f
}
