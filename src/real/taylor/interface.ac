theorem limit_at_compose(f: Real -> Real, g: Real -> Real, a: Real, b: Real, m: Real) {
    limit_at(f, a, b) and limit_at(g, b, m) and
    (forall(x: Real) { x != a implies f(x) != b })
    implies limit_at(compose(g, f), a, m)
}

theorem limit_at_const(c: Real, a: Real) {
    limit_at(constant[Real, Real](c), a, c)
}

theorem limit_at_const_mul(f: Real -> Real, a: Real, l: Real, c: Real) {
    limit_at(f, a, l)
    implies limit_at(pointwise_mul[Real, Real](constant[Real, Real](c), f), a, c * l)
}

define lipschitz_with(f: Real -> Real, k: Real) -> Bool {
    Real.0 < k and forall(x: Real, y: Real) {
        (f(x) - f(y)).abs <= k * (x - y).abs
    }
}

define is_lipschitz(f: Real -> Real) -> Bool {
    exists(k: Real) {
        lipschitz_with(f, k)
    }
}

theorem lipschitz_with_pos_const(f: Real -> Real, k: Real) {
    lipschitz_with(f, k) implies Real.0 < k
}

theorem lipschitz_with_apply(f: Real -> Real, k: Real, x0: Real, y0: Real) {
    lipschitz_with(f, k) implies (f(x0) - f(y0)).abs <= k * (x0 - y0).abs
}

theorem lipschitz_imp_uniform(f: Real -> Real, k: Real) {
    lipschitz_with(f, k) implies uniform(f)
}

theorem lipschitz_imp_continuous(f: Real -> Real, k: Real) {
    lipschitz_with(f, k) implies continuous(f)
}

theorem derivative_bound_imp_lipschitz(
    f: Real -> Real, df: Real -> Real, k: Real, a: Real, b: Real
) {
    is_derivative_fn(f, df) and (forall(z: Real) { df(z).abs <= k }) and
    continuous(f) and Real.0 <= k and a <= b
    implies (f(b) - f(a)).abs <= k * (b - a).abs
}

theorem rpow_prod_base(x: Real, y: Real, a: Real) {
    x > Real.0 and y > Real.0 implies
        (x * y).rpow(a) = Option.some((a * (x.log.get_or_else(Real.0) + y.log.get_or_else(Real.0))).exp)
}

theorem rpow_prod_base_val(x: Real, y: Real, a: Real, u: Real, v: Real) {
    x > Real.0 and y > Real.0 and x.rpow(a) = Option.some(u) and y.rpow(a) = Option.some(v)
    implies (x * y).rpow(a) = Option.some(u * v)
}

theorem rpow_quot_base(x: Real, y: Real, a: Real) {
    x > Real.0 and y > Real.0 implies
        (x / y).rpow(a) = Option.some((a * (x.log.get_or_else(Real.0) - y.log.get_or_else(Real.0))).exp)
}

theorem rpow_quot_base_val(x: Real, y: Real, a: Real, u: Real, v: Real) {
    x > Real.0 and y > Real.0 and x.rpow(a) = Option.some(u) and y.rpow(a) = Option.some(v)
    implies (x / y).rpow(a) = Option.some(u / v)
}

theorem rpow_inv_base(x: Real, a: Real, u: Real) {
    x > Real.0 and x.rpow(a) = Option.some(u)
    implies (Real.1 / x).rpow(a) = Option.some(Real.1 / u)
}

theorem rpow_rpow(x: Real, a: Real, b: Real, u: Real, v: Real) {
    x > Real.0 and x.rpow(a) = Option.some(u) and u.rpow(b) = Option.some(v)
    implies x.rpow(a * b) = Option.some(v)
}

theorem rpow_mul_val(x: Real, a: Real, b: Real, u: Real, v: Real, w: Real) {
    x > Real.0 and x.rpow(a) = Option.some(u) and x.rpow(b) = Option.some(v) and
    x.rpow(a + b) = Option.some(w)
    implies w = u * v
}

theorem rpow_neg(x: Real, a: Real, u: Real) {
    x > Real.0 and x.rpow(a) = Option.some(u)
    implies x.rpow(-a) = Option.some(Real.1 / u)
}

theorem rpow_sub(x: Real, a: Real, b: Real, u: Real, v: Real) {
    x > Real.0 and x.rpow(a) = Option.some(u) and x.rpow(b) = Option.some(v)
    implies x.rpow(a - b) = Option.some(u / v)
