    x > Real.0 implies x.exp > Real.1 + x + x.pow(Nat.2) / two
}

theorem exp_gt_poly3(x: Real) {
    x > Real.0 implies
        x.exp > Real.1 + x + x.pow(Nat.2) / two + x.pow(Nat.3) / Real.from_rat(Rat.from_nat(Nat.3.factorial))
}

theorem exp_gt_x2_half(x: Real) {
    x > Real.0 implies x.exp > x.pow(Nat.2) / two
}

theorem exp_shift_term_le_exp_term_of_nonneg(x: Real, n: Nat) {
    x >= Real.0 implies exp_shift_term(x, n) <= exp_term(x, n)
}

theorem exp_shift_sum_le_exp(x: Real) {
    x >= Real.0 implies exp_shift_sum(x) <= x.exp
}

theorem exp_le_one_plus_x_exp(x: Real) {
    x >= Real.0 implies x.exp <= Real.1 + x * x.exp
}

theorem exp_nat_mul_comm(x: Real, n: Nat) {
    (x * from_nat[Real](n)).exp = x.exp.pow(n)
}

theorem exp_one_half_sq {
    (Real.one_half).exp * (Real.one_half).exp = Real.e
}

theorem exp_e_pow_nat_pos(n: Nat) {
    Real.e.pow(n) > Real.0
}

theorem exp_continuous_at(x: Real) {
    continuous_at(Real.exp, x)
}

theorem exp_continuous {
    continuous(Real.exp)
}

theorem exp_preserves_converges_to(a: Nat -> Real, x: Real) {
    converges_to(a, x) implies converges_to(compose(Real.exp, a), x.exp)
}

theorem exp_limit_of_convergent(a: Nat -> Real, x: Real) {
    converges_to(a, x) implies limit(compose(Real.exp, a)) = x.exp
}

theorem exp_seq_tends_to_infinity(a: Nat -> Real) {
    seq_tends_to_infinity(a) implies seq_tends_to_infinity(compose(Real.exp, a))
}

theorem exp_seq_tends_to_neg_infinity_zero(a: Nat -> Real) {
    seq_tends_to_neg_infinity(a) implies converges_to(compose(Real.exp, a), Real.0)
}

theorem log_continuous_at_pos(x: Real) {
    x > Real.0 implies continuous_at(log_value, x)
}

theorem log_preserves_converges_to(a: Nat -> Real, x: Real) {
    converges_to(a, x) and x > Real.0 implies converges_to(compose(log_value, a), x.log.get_or_else(Real.0))
}

theorem log_seq_tends_to_infinity(a: Nat -> Real) {
    seq_tends_to_infinity(a) implies seq_tends_to_infinity(compose(log_value, a))
}

theorem log_seq_tends_to_neg_infinity_zero(a: Nat -> Real) {
    converges_to(a, Real.0) and seq_eventually_positive(a)
    implies seq_tends_to_neg_infinity(compose(log_value, a))
}

theorem log_limit_of_convergent(a: Nat -> Real, x: Real) {
    converges_to(a, x) and x > Real.0 implies limit(compose(log_value, a)) = x.log.get_or_else(Real.0)
}

theorem exp_seq_eventually_positive(a: Nat -> Real) {
    seq_eventually_positive(compose(Real.exp, a))
}

theorem from_nat_seq_tends_to_infinity {
    seq_tends_to_infinity(from_nat[Real])
}

theorem log_value_mul3(x: Real, y: Real, z: Real) {
    x > Real.0 and y > Real.0 and z > Real.0 implies
        (x * y * z).log.get_or_else(Real.0) = x.log.get_or_else(Real.0) + y.log.get_or_else(Real.0) + z.log.get_or_else(Real.0)
}

theorem log_mul3_val(x: Real, y: Real, z: Real, lx: Real, ly: Real, lz: Real) {
    x > Real.0 and y > Real.0 and z > Real.0 and
    x.log = Option.some(lx) and y.log = Option.some(ly) and z.log = Option.some(lz)
    implies (x * y * z).log = Option.some(lx + ly + lz)
}

theorem log_value_sq(x: Real) {
    x > Real.0 implies (x.pow(Nat.2)).log.get_or_else(Real.0) = two * x.log.get_or_else(Real.0)
}

theorem log_value_pow(x: Real, n: Nat) {
    x > Real.0 implies (x.pow(n)).log.get_or_else(Real.0) = from_nat[Real](n) * x.log.get_or_else(Real.0)
}

theorem log_value_e_pow(n: Nat) {
    (Real.e.pow(n)).log.get_or_else(Real.0) = from_nat[Real](n)
}

theorem log_value_exp_recip(x: Real) {
    (Real.1 / x.exp).log.get_or_else(Real.0) = -x
}

theorem log_value_div_self(x: Real) {
    x > Real.0 implies (x / x).log.get_or_else(Real.0) = Real.0
}

theorem log_value_le_sub_one(x: Real) {
    x > Real.0 implies x.log.get_or_else(Real.0) <= x - Real.1
}

theorem one_sub_recip_le_log_or_zero(x: Real) {
    x > Real.0 implies Real.1 - Real.1 / x <= x.log.get_or_else(Real.0)
}

theorem log_value_lt_self(x: Real) {
    x > Real.0 implies x.log.get_or_else(Real.0) < x
}

theorem log_one_plus_x_ge_x_over_one_plus_x(x: Real) {
    x >= Real.0 implies x / (Real.1 + x) <= (Real.1 + x).log.get_or_else(Real.0)
}

theorem log_value_lt_iff(x: Real, y: Real) {
    x > Real.0 and y > Real.0 implies (x.log.get_or_else(Real.0) < y.log.get_or_else(Real.0) iff x < y)
}

theorem log_value_le_iff(x: Real, y: Real) {
    x > Real.0 and y > Real.0 implies (x.log.get_or_else(Real.0) <= y.log.get_or_else(Real.0) iff x <= y)
}

theorem log_value_eq_iff(x: Real, y: Real) {
    x > Real.0 and y > Real.0 implies (x.log.get_or_else(Real.0) = y.log.get_or_else(Real.0) iff x = y)
}

theorem log_value_neg_iff_lt_one(x: Real) {
    x > Real.0 implies (x.log.get_or_else(Real.0) < Real.0 iff x < Real.1)
}

theorem log_value_pos_iff_gt_one(x: Real) {
    x > Real.0 implies (x.log.get_or_else(Real.0) > Real.0 iff x > Real.1)
}

theorem log_value_nonneg_iff_ge_one(x: Real) {
    x > Real.0 implies (x.log.get_or_else(Real.0) >= Real.0 iff x >= Real.1)
}

theorem log_value_nonpos_iff_le_one(x: Real) {
    x > Real.0 implies (x.log.get_or_else(Real.0) <= Real.0 iff x <= Real.1)
}

theorem log_value_two_pos {
    two.log.get_or_else(Real.0) > Real.0
}

theorem log_value_two_lt_one {
    two.log.get_or_else(Real.0) < Real.1
}

theorem log_value_exp_neg(x: Real) {
    ((-x).exp).log.get_or_else(Real.0) = -x
}

define differentiable_on_open(f: Real -> Real, lower: Real, upper: Real) -> Bool {
    forall(x: Real) {
        lower < x and x < upper implies differentiable_at(f, x)
    }
}

define is_derivative_on_open(f: Real -> Real, df: Real -> Real, lower: Real, upper: Real) -> Bool {
    forall(x: Real) {
        lower < x and x < upper implies has_derivative_at(f, x, df(x))
    }
}

theorem le_zero_div_pos_le_zero(a: Real, b: Real) {
    a <= Real.0 and b.is_positive implies a / b <= Real.0
}

theorem le_zero_div_neg_ge_zero(a: Real, b: Real) {
    a <= Real.0 and b.is_negative implies Real.0 <= a / b
}

theorem fermat_interior_maximum(f: Real -> Real, a: Real, b: Real, x0: Real, d: Real) {
    a < x0 and x0 < b and
    (forall(y: Real) { a < y and y < b implies f(y) <= f(x0) }) and
    has_derivative_at(f, x0, d)
    implies d = Real.0
}

define bounded_prefix_set(f: Real -> Real, a: Real, b: Real) -> Set[Real] {
    Set[Real].new(bounded_prefix_contains(f, a, b))
}

theorem bounded_prefix_set_contains_eq(f: Real -> Real, a: Real, b: Real, x: Real) {
    bounded_prefix_set(f, a, b).contains(x) = bounded_prefix_contains(f, a, b, x)
}

theorem bounded_prefix_contains_lower(f: Real -> Real, a: Real, b: Real) {
    a <= b implies bounded_prefix_set(f, a, b).contains(a)
}

theorem bounded_prefix_set_is_nonempty(f: Real -> Real, a: Real, b: Real) {
    a <= b implies is_nonempty(bounded_prefix_set(f, a, b))
}

theorem bounded_prefix_set_upper_bound(f: Real -> Real, a: Real, b: Real) {
    is_set_upper_bound(bounded_prefix_set(f, a, b), b)
}

theorem bounded_prefix_set_has_upper_bound(f: Real -> Real, a: Real, b: Real) {
    has_upper_bound(bounded_prefix_set(f, a, b))
}

theorem bounded_prefix_set_supremum_exists(f: Real -> Real, a: Real, b: Real) {
    a <= b implies exists(t: Real) {
        is_set_supremum(bounded_prefix_set(f, a, b), t)
    }
}

theorem bounded_prefix_member_in_interval(f: Real -> Real, a: Real, b: Real, x: Real) {
    bounded_prefix_set(f, a, b).contains(x) implies a <= x and x <= b
}

theorem bounded_prefix_member_bound(f: Real -> Real, a: Real, b: Real, x: Real) {
    bounded_prefix_set(f, a, b).contains(x) implies exists(bound: Real) {
        forall(y: Real) {
            closed_interval_set(a, x).contains(y) implies f(y) <= bound
        }
    }
}

define reciprocal_const_minus(c: Real, f: Real -> Real, x: Real) -> Real {
    (c - f(x)).inverse
}

theorem continuous_at_reciprocal_const_minus(c: Real, f: Real -> Real, x0: Real) {
    continuous_at(f, x0) and f(x0) < c implies
        continuous_at(reciprocal_const_minus(c, f), x0)
}

theorem inverse_inverse(x: Real) {
    x != Real.0 implies x.inverse.inverse = x
}

theorem constant_on_interval_has_derivative_zero(f: Real -> Real, a: Real, b: Real, c: Real) {
    a < c and c < b and
    (forall(y: Real) { closed_interval_set(a, b).contains(y) implies f(y) = f(c) })
    implies has_derivative_at(f, c, Real.0)
}

theorem rolle_theorem(f: Real -> Real, a: Real, b: Real) {
    continuous_on_closed(f, a, b) and a < b and differentiable_on_open(f, a, b) and
    f(a) = f(b)
    implies exists(c: Real) {
        a < c and c < b and has_derivative_at(f, c, Real.0)
    }
}

define secant_slope(f: Real -> Real, a: Real, b: Real) -> Real {
    (f(b) - f(a)) / (b - a)
}

define secant_remainder(f: Real -> Real, a: Real, b: Real, x: Real) -> Real {
    f(x) - secant_slope(f, a, b) * (x - a)
}

define secant_remainder_derivative(df: Real -> Real, f: Real -> Real, a: Real, b: Real, x: Real) -> Real {
    df(x) - secant_slope(f, a, b)
}

theorem secant_remainder_eq_pointwise(f: Real -> Real, a: Real, b: Real) {
    secant_remainder(f, a, b) = pointwise_add(f, pointwise_neg(
        affine_real(secant_slope(f, a, b), -(secant_slope(f, a, b)) * a)))
}

theorem secant_remainder_continuous_on_closed(f: Real -> Real, a: Real, b: Real) {
    continuous(f) implies continuous_on_closed(secant_remainder(f, a, b), a, b)
}

theorem secant_remainder_is_derivative_on_open(f: Real -> Real, df: Real -> Real, a: Real, b: Real) {
    is_derivative_fn(f, df)
    implies is_derivative_on_open(secant_remainder(f, a, b),
        secant_remainder_derivative(df, f, a, b), a, b)
}

theorem secant_remainder_continuous_on_closed_local(f: Real -> Real, a: Real, b: Real) {
    continuous_on_closed(f, a, b)
    implies continuous_on_closed(secant_remainder(f, a, b), a, b)
}
