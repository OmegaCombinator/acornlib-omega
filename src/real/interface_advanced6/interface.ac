theorem abs_le_of_lte_and_neg_lte(w: Real, c: Real) {
    w <= c and -w <= c implies w.abs <= c
}

theorem mul_nonneg_lte(a: Real, b: Real) {
    Real.0 <= a and Real.0 <= b implies Real.0 <= a * b
}

theorem mul_le_mul_nonneg_lte(a: Real, b: Real, c: Real, d: Real) {
    Real.0 <= a and Real.0 <= b and Real.0 <= c and Real.0 <= d and a <= c and b <= d
    implies a * b <= c * d
}

theorem is_derivative_fn_pointwise_add_comm(f: Real -> Real, a: Real -> Real, b: Real -> Real) {
    is_derivative_fn(f, pointwise_add(a, b))
    implies is_derivative_fn(f, pointwise_add(b, a))
}

theorem pascal_sub_form(n: Nat, k: Nat) {
    Nat.0 < k and k <= n implies
        n.binom(k) = (n - Nat.1).binom(k - Nat.1) + (n - Nat.1).binom(k)
}

theorem hockey_stick_sum_form(k: Nat, n: Nat) {
    k <= n implies
        partial(hockey_stick_term(k), (n - k).suc) = (n + Nat.1).binom(k + Nat.1)
}

define successor_summand(i: Nat) -> Nat {
    i.suc
}

theorem hockey_stick_k1(n: Nat) {
    partial(successor_summand, n) = (n + Nat.1).binom(Nat.2)
}

theorem triangular_binom(n: Nat) {
    triangular(n) = (n + Nat.1).binom(Nat.2)
}

theorem vandermonde_sum_form(m: Nat, n: Nat, r: Nat) {
    partial(vandermonde_term(m, n, r), r.suc) = (m + n).binom(r)
}

theorem vandermonde_r1(m: Nat, n: Nat) {
    partial(vandermonde_term(m, n, Nat.1), Nat.2) = (m + n).binom(Nat.1)
}

theorem vandermonde_r1_eval(m: Nat, n: Nat) {
    partial(vandermonde_term(m, n, Nat.1), Nat.2) = m + n
}

theorem binomial_one_plus_x(x: Real, n: Nat) {
    (Real.1 + x).pow(n) = partial(binomial_term[Real](x, Real.1, n), n.suc)
}

theorem binomial_square(x: Real) {
    (Real.1 + x).pow(Nat.2) = Real.1 + two * x + x.pow(Nat.2)
}

theorem subset_count_binom_sum(n: Nat) {
    partial(n.binom, n.suc) = Nat.2.pow(n)
}

structure Point4 {
    /// The first coordinate.
    a: Real
    /// The second coordinate.
    b: Real
    /// The third coordinate.
    c: Real
    /// The fourth coordinate.
    d: Real
}

define dist_sq(p: Point4, q: Point4) -> Real {
    (p.a - q.a) * (p.a - q.a) + (p.b - q.b) * (p.b - q.b) +
    (p.c - q.c) * (p.c - q.c) + (p.d - q.d) * (p.d - q.d)
}

define points_unit_distance4(p: Point4, q: Point4) -> Bool {
    dist_sq(p, q) = Real.1
}

theorem seq_eventually_equal_real_is_bounded_seq(a: Nat -> Real, b: Nat -> Real) {
    seq_eventually_equal_real(a, b) and is_bounded_seq(a) implies is_bounded_seq(b)
}

theorem seq_eventually_equal_real_zero_tail_bounds(a: Nat -> Real, b: Nat -> Real) {
    seq_eventually_equal_real(a, b) and vanishes(a) implies forall(eps: Real) {
        eps.is_positive implies exists(n: Nat) {
            tail_bound(b, Real.0, n, eps)
        }
    }
}

theorem seq_eventually_equal_real_vanishes(a: Nat -> Real, b: Nat -> Real) {
