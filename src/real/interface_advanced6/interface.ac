theorem seq_in_real_set_at(s: Set[Real], a: Nat -> Real, n: Nat) {
    seq_in_real_set(s, a) implies s.contains(a(n))
}

theorem seq_in_real_set_intro(s: Set[Real], a: Nat -> Real) {
    forall(n: Nat) { s.contains(a(n)) } implies seq_in_real_set(s, a)
}

theorem seq_in_real_set_of_subset(s: Set[Real], t: Set[Real], a: Nat -> Real) {
    s.subset(t) and seq_in_real_set(s, a) implies seq_in_real_set(t, a)
}

theorem seq_in_real_set_intersection(s: Set[Real], t: Set[Real], a: Nat -> Real) {
    seq_in_real_set(s, a) and seq_in_real_set(t, a) implies seq_in_real_set(s.intersection(t), a)
}

theorem seq_in_real_set_union_left(s: Set[Real], t: Set[Real], a: Nat -> Real) {
    seq_in_real_set(s, a) implies seq_in_real_set(s.union(t), a)
}

theorem seq_in_real_set_union_right(s: Set[Real], t: Set[Real], a: Nat -> Real) {
    seq_in_real_set(t, a) implies seq_in_real_set(s.union(t), a)
}

theorem seq_in_real_set_eventually(s: Set[Real], a: Nat -> Real) {
    seq_in_real_set(s, a) implies seq_eventually_in_real_set(s, a)
}

theorem seq_in_real_set_frequently(s: Set[Real], a: Nat -> Real) {
    seq_in_real_set(s, a) implies seq_frequently_in_real_set(s, a)
}

theorem seq_eventually_in_real_set_of_subset(s: Set[Real], t: Set[Real], a: Nat -> Real) {
    s.subset(t) and seq_eventually_in_real_set(s, a) implies seq_eventually_in_real_set(t, a)
}

theorem seq_eventually_in_real_set_intersection(s: Set[Real], t: Set[Real], a: Nat -> Real) {
    seq_eventually_in_real_set(s, a) and seq_eventually_in_real_set(t, a)
    implies seq_eventually_in_real_set(s.intersection(t), a)
}

theorem seq_eventually_in_real_set_union_left(s: Set[Real], t: Set[Real], a: Nat -> Real) {
    seq_eventually_in_real_set(s, a) implies seq_eventually_in_real_set(s.union(t), a)
}

theorem seq_eventually_in_real_set_union_right(s: Set[Real], t: Set[Real], a: Nat -> Real) {
    seq_eventually_in_real_set(t, a) implies seq_eventually_in_real_set(s.union(t), a)
}

theorem seq_eventually_in_real_set_frequently(s: Set[Real], a: Nat -> Real) {
    seq_eventually_in_real_set(s, a) implies seq_frequently_in_real_set(s, a)
}

theorem seq_frequently_in_real_set_of_subset(s: Set[Real], t: Set[Real], a: Nat -> Real) {
    s.subset(t) and seq_frequently_in_real_set(s, a) implies seq_frequently_in_real_set(t, a)
}

theorem seq_frequently_eventually_in_real_set_intersection(s: Set[Real], t: Set[Real], a: Nat -> Real) {
    seq_frequently_in_real_set(s, a) and seq_eventually_in_real_set(t, a)
    implies seq_frequently_in_real_set(s.intersection(t), a)
}

define sequence_range_contains(a: Nat -> Real, x: Real) -> Bool {
    exists(n: Nat) {
        x = a(n)
    }
}

define sequence_tail_contains(a: Nat -> Real, m: Nat, x: Real) -> Bool {
    exists(n: Nat) {
        m <= n and x = a(n)
    }
}

define sequence_range_set(a: Nat -> Real) -> Set[Real] {
    Set[Real].new(sequence_range_contains(a))
}

define sequence_tail_set(a: Nat -> Real, m: Nat) -> Set[Real] {
    Set[Real].new(sequence_tail_contains(a, m))
}

define sequence_tail_meets_set(a: Nat -> Real, m: Nat, s: Set[Real]) -> Bool {
    exists(x: Real) {
        sequence_tail_set(a, m).contains(x) and s.contains(x)
    }
}

theorem sequence_range_set_contains_eq(a: Nat -> Real, x: Real) {
    sequence_range_set(a).contains(x) = exists(n: Nat) { x = a(n) }
}

theorem sequence_tail_set_contains_eq(a: Nat -> Real, m: Nat, x: Real) {
    sequence_tail_set(a, m).contains(x) = exists(n: Nat) { m <= n and x = a(n) }
}

theorem sequence_range_set_contains_term(a: Nat -> Real, n: Nat) {
    sequence_range_set(a).contains(a(n))
}

theorem sequence_tail_set_contains_term(a: Nat -> Real, m: Nat, n: Nat) {
    m <= n implies sequence_tail_set(a, m).contains(a(n))
}

theorem sequence_tail_set_subset_range_set(a: Nat -> Real, m: Nat) {
    sequence_tail_set(a, m).subset(sequence_range_set(a))
}

theorem sequence_tail_set_subset_of_le(a: Nat -> Real, m: Nat, n: Nat) {
    m <= n implies sequence_tail_set(a, n).subset(sequence_tail_set(a, m))
}

theorem sequence_tail_set_subset_self(a: Nat -> Real, m: Nat) {
    sequence_tail_set(a, m).subset(sequence_tail_set(a, m))
}

theorem sequence_tail_set_contains_of_le(a: Nat -> Real, m: Nat, n: Nat, x: Real) {
    m <= n and sequence_tail_set(a, n).contains(x) implies sequence_tail_set(a, m).contains(x)
}

theorem sequence_range_set_contains_sequence(a: Nat -> Real) {
    seq_in_real_set(sequence_range_set(a), a)
}

theorem sequence_range_set_frequently_contains_sequence(a: Nat -> Real) {
    seq_frequently_in_real_set(sequence_range_set(a), a)
}

theorem sequence_tail_set_eventually_contains_sequence(a: Nat -> Real, m: Nat) {
    seq_eventually_in_real_set(sequence_tail_set(a, m), a)
}

theorem sequence_tail_set_frequently_contains_sequence(a: Nat -> Real, m: Nat) {
    seq_frequently_in_real_set(sequence_tail_set(a, m), a)
}

theorem seq_in_real_set_iff_range_subset(s: Set[Real], a: Nat -> Real) {
    seq_in_real_set(s, a) = sequence_range_set(a).subset(s)
}

theorem seq_eventually_in_real_set_iff_tail_subset(s: Set[Real], a: Nat -> Real) {
    seq_eventually_in_real_set(s, a) = exists(m: Nat) { sequence_tail_set(a, m).subset(s) }
}

theorem seq_frequently_in_real_set_iff_tail_meets(s: Set[Real], a: Nat -> Real) {
    seq_frequently_in_real_set(s, a) = forall(m: Nat) { sequence_tail_meets_set(a, m, s) }
}

theorem sequence_tail_meets_set_of_le(a: Nat -> Real, m: Nat, n: Nat, s: Set[Real]) {
    m <= n and sequence_tail_meets_set(a, n, s) implies sequence_tail_meets_set(a, m, s)
}

theorem sequence_tail_subset_of_tail_subset(a: Nat -> Real, m: Nat, n: Nat, s: Set[Real]) {
    m <= n and sequence_tail_set(a, m).subset(s) implies sequence_tail_set(a, n).subset(s)
}

theorem sequence_tail_meets_set_intersection_contains(a: Nat -> Real, m: Nat, s: Set[Real], x: Real) {
    sequence_tail_set(a, m).contains(x) and s.contains(x)
    implies sequence_tail_set(a, m).intersection(s).contains(x)
}

theorem sequence_tail_meets_set_iff_intersection_inhabited(a: Nat -> Real, m: Nat, s: Set[Real]) {
    sequence_tail_meets_set(a, m, s) = exists(x: Real) {
        sequence_tail_set(a, m).intersection(s).contains(x)
    }
}

define is_eps_adherent_to_set(s: Set[Real], x: Real, eps: Real) -> Bool {
    exists(y: Real) {
        s.contains(y) and y.is_close(x, eps)
    }
}

define is_adherent_point_of_set(s: Set[Real], x: Real) -> Bool {
    forall(eps: Real) {
        eps.is_positive implies is_eps_adherent_to_set(s, x, eps)
    }
}

define in_closure(s: Set[Real], x: Real) -> Bool {
    is_adherent_point_of_set(s, x)
}

define closure(s: Set[Real]) -> Set[Real] {
    Set[Real].new(in_closure(s))
}

define is_closed_set(s: Set[Real]) -> Bool {
    forall(x: Real) {
        is_adherent_point_of_set(s, x) implies s.contains(x)
    }
}

define is_limit_point_of_set(s: Set[Real], x: Real) -> Bool {
    is_adherent_point_of_set(s.difference(Set[Real].singleton(x)), x)
}

define is_isolated_point_of_set(s: Set[Real], x: Real) -> Bool {
    s.contains(x) and exists(eps: Real) {
        eps.is_positive and forall(y: Real) {
            s.contains(y) and y != x implies not y.is_close(x, eps)
        }
    }
}

define is_bounded_real_set(s: Set[Real]) -> Bool {
    exists(bound: Real) {
        bound > Real.0 and forall(x: Real) {
            s.contains(x) implies -bound <= x and x <= bound
        }
    }
}

define is_interior_point(s: Set[Real], x: Real) -> Bool {
    s.contains(x) and exists(eps: Real) {
        eps.is_positive and forall(y: Real) {
            y.is_close(x, eps) implies s.contains(y)
        }
    }
}

define in_interior(s: Set[Real], x: Real) -> Bool {
    is_interior_point(s, x)
}

define interior(s: Set[Real]) -> Set[Real] {
    Set[Real].new(in_interior(s))
}

define is_open_set(s: Set[Real]) -> Bool {
    forall(x: Real) {
        s.contains(x) implies is_interior_point(s, x)
    }
}

define disconnecting_triple(s: Set[Real], x: Real, y: Real, z: Real) -> Bool {
    s.contains(x) and s.contains(y) and x < y and x <= z and z <= y and not s.contains(z)
}

define is_connected_real_set(s: Set[Real]) -> Bool {
    forall(x: Real, y: Real, z: Real) {
        not disconnecting_triple(s, x, y, z)
    }
}

theorem closure_contains_eq(s: Set[Real], x: Real) {
    closure(s).contains(x) = is_adherent_point_of_set(s, x)
}

theorem interior_contains_eq(s: Set[Real], x: Real) {
    interior(s).contains(x) = is_interior_point(s, x)
}

theorem adherent_point_intro(s: Set[Real], x: Real) {
    forall(eps: Real) {
        eps.is_positive implies is_eps_adherent_to_set(s, x, eps)
    } implies is_adherent_point_of_set(s, x)
}

theorem adherent_point_eps(s: Set[Real], x: Real, eps: Real) {
    is_adherent_point_of_set(s, x) and eps.is_positive
    implies is_eps_adherent_to_set(s, x, eps)
}

theorem closure_contains_of_adherent(s: Set[Real], x: Real) {
    is_adherent_point_of_set(s, x) implies closure(s).contains(x)
}

theorem closure_contains_imp_adherent(s: Set[Real], x: Real) {
    closure(s).contains(x) implies is_adherent_point_of_set(s, x)
}

theorem closed_set_contains_adherent(s: Set[Real], x: Real) {
    is_closed_set(s) and is_adherent_point_of_set(s, x) implies s.contains(x)
}

theorem interior_point_intro(s: Set[Real], x: Real, eps: Real) {
    s.contains(x) and eps.is_positive and forall(y: Real) {
        y.is_close(x, eps) implies s.contains(y)
    } implies is_interior_point(s, x)
}

theorem open_set_interior_point(s: Set[Real], x: Real) {
    is_open_set(s) and s.contains(x) implies is_interior_point(s, x)
}

theorem disconnecting_triple_contains_left(s: Set[Real], x: Real, y: Real, z: Real) {
    disconnecting_triple(s, x, y, z) implies s.contains(x)
}

theorem disconnecting_triple_not_contains_middle(s: Set[Real], x: Real, y: Real, z: Real) {
    disconnecting_triple(s, x, y, z) implies not s.contains(z)
}

theorem eps_adherent_of_contains_close(s: Set[Real], x: Real, y: Real, eps: Real) {
    s.contains(y) and y.is_close(x, eps) implies is_eps_adherent_to_set(s, x, eps)
}

theorem eps_adherent_witness(s: Set[Real], x: Real, eps: Real) {
    is_eps_adherent_to_set(s, x, eps) implies exists(y: Real) {
        s.contains(y) and y.is_close(x, eps)
    }
}

theorem eps_adherent_of_subset(s: Set[Real], t: Set[Real], x: Real, eps: Real) {
    s.subset(t) and is_eps_adherent_to_set(s, x, eps)
    implies is_eps_adherent_to_set(t, x, eps)
}

theorem point_in_set_is_adherent(s: Set[Real], x: Real) {
    s.contains(x) implies is_adherent_point_of_set(s, x)
}

theorem point_in_closure_if_in_set(s: Set[Real], x: Real) {
    s.contains(x) implies closure(s).contains(x)
}

theorem set_subset_closure(s: Set[Real]) {
    s.subset(closure(s))
}

theorem closure_subset_of_closed_set(s: Set[Real]) {
    is_closed_set(s) implies closure(s).subset(s)
}

theorem closed_set_eq_closure(s: Set[Real]) {
    is_closed_set(s) implies s = closure(s)
}

theorem closure_contains_of_subset(s: Set[Real], t: Set[Real], x: Real) {
    s.subset(t) and closure(s).contains(x) implies closure(t).contains(x)
}

theorem closure_mono(s: Set[Real], t: Set[Real]) {
    s.subset(t) implies closure(s).subset(closure(t))
}

theorem closure_intersection_subset(s: Set[Real], t: Set[Real]) {
    closure(s.intersection(t)).subset(closure(s).intersection(closure(t)))
}

theorem union_closure_subset_closure_union(s: Set[Real], t: Set[Real]) {
    closure(s).union(closure(t)).subset(closure(s.union(t)))
}

theorem union_subset_union_closure(s: Set[Real], t: Set[Real]) {
    s.union(t).subset(closure(s).union(closure(t)))
}

theorem interior_subset(s: Set[Real]) {
    interior(s).subset(s)
}

theorem interior_point_is_adherent(s: Set[Real], x: Real) {
    is_interior_point(s, x) implies is_adherent_point_of_set(s, x)
}

theorem empty_set_is_open {
    is_open_set(Set[Real].empty_set)
}

theorem empty_set_is_closed {
    is_closed_set(Set[Real].empty_set)
}

theorem universal_set_is_open {
    is_open_set(Set[Real].universal_set)
}

theorem universal_set_is_closed {
    is_closed_set(Set[Real].universal_set)
}

theorem empty_set_is_connected {
    is_connected_real_set(Set[Real].empty_set)
}

theorem universal_set_is_connected {
    is_connected_real_set(Set[Real].universal_set)
}

theorem bounded_real_set_lower_bound(s: Set[Real], bound: Real, x: Real) {
    forall(y: Real) {
        s.contains(y) implies -bound <= y and y <= bound
    } and s.contains(x) implies -bound <= x
}

theorem bounded_real_set_upper_bound(s: Set[Real], bound: Real, x: Real) {
    forall(y: Real) {
        s.contains(y) implies -bound <= y and y <= bound
    } and s.contains(x) implies x <= bound
}

theorem subset_of_bounded_real_set_is_bounded(s: Set[Real], t: Set[Real]) {
    s.subset(t) and is_bounded_real_set(t) implies is_bounded_real_set(s)
}

theorem empty_real_set_is_bounded {
    is_bounded_real_set(Set[Real].empty_set)
}

theorem singleton_real_set_is_bounded(a: Real) {
    is_bounded_real_set(Set[Real].singleton(a))
}

theorem union_of_bounded_real_sets_is_bounded(s: Set[Real], t: Set[Real]) {
    is_bounded_real_set(s) and is_bounded_real_set(t) implies is_bounded_real_set(s.union(t))
}

theorem adherent_closure_eps_adherent(s: Set[Real], x: Real, eps: Real) {
    is_adherent_point_of_set(closure(s), x) and eps.is_positive
    implies is_eps_adherent_to_set(s, x, eps)
}

theorem adherent_closure_imp_adherent(s: Set[Real], x: Real) {
    is_adherent_point_of_set(closure(s), x) implies is_adherent_point_of_set(s, x)
}

theorem closure_contains_adherent_point(s: Set[Real], x: Real) {
    is_adherent_point_of_set(closure(s), x) implies closure(s).contains(x)
}

theorem closure_is_closed(s: Set[Real]) {
    is_closed_set(closure(s))
}

theorem closure_idempotent(s: Set[Real]) {
    closure(closure(s)) = closure(s)
}

define is_eps_adherent_from(a: Nat -> Real, m: Nat, u: Real, eps: Real) -> Bool {
    forall(n_start: Nat) {
        m <= n_start implies exists(n_witness: Nat) {
            n_start <= n_witness and a(n_witness).is_close(u, eps)
        }
    }
}

define is_limit_point_from(a: Nat -> Real, m: Nat, u: Real) -> Bool {
    forall(eps: Real) {
        eps.is_positive implies is_eps_adherent_from(a, m, u, eps)
    }
}

theorem converges_to_has_tail_bound(a: Nat -> Real, u: Real, eps: Real) {
    converges_to(a, u) and eps.is_positive implies exists(n: Nat) {
        tail_bound(a, u, n, eps)
    }
}

theorem tail_bound_imp_eps_adherent_from(a: Nat -> Real, m: Nat, u: Real, eps: Real, n0: Nat) {
    tail_bound(a, u, n0, eps) implies is_eps_adherent_from(a, m, u, eps)
}

theorem converges_to_imp_limit_point_from(a: Nat -> Real, m: Nat, u: Real) {
    converges_to(a, u) implies is_limit_point_from(a, m, u)
}

theorem seq_converges_imp_eps_adherent(s: Set[Real], a: Nat -> Real, x: Real, eps: Real) {
    forall(n: Nat) { s.contains(a(n)) } and converges_to(a, x) and eps.is_positive
    implies is_eps_adherent_to_set(s, x, eps)
}

theorem seq_converges_imp_adherent(s: Set[Real], a: Nat -> Real, x: Real) {
    forall(n: Nat) { s.contains(a(n)) } and converges_to(a, x)
    implies is_adherent_point_of_set(s, x)
}

theorem closed_set_contains_seq_limit(s: Set[Real], a: Nat -> Real, x: Real) {
    is_closed_set(s) and forall(n: Nat) { s.contains(a(n)) } and converges_to(a, x)
    implies s.contains(x)
}

theorem tail_bound_frequently_in_real_set_imp_eps_adherent(
    s: Set[Real], a: Nat -> Real, x: Real, eps: Real, n0: Nat
) {
    seq_frequently_in_real_set(s, a) and tail_bound(a, x, n0, eps)
    implies is_eps_adherent_to_set(s, x, eps)
}

theorem seq_frequently_converges_imp_eps_adherent(
    s: Set[Real], a: Nat -> Real, x: Real, eps: Real
) {
    seq_frequently_in_real_set(s, a) and converges_to(a, x) and eps.is_positive
    implies is_eps_adherent_to_set(s, x, eps)
}

theorem seq_frequently_converges_imp_adherent(s: Set[Real], a: Nat -> Real, x: Real) {
    seq_frequently_in_real_set(s, a) and converges_to(a, x)
    implies is_adherent_point_of_set(s, x)
}

theorem seq_frequently_converges_imp_closure_contains(s: Set[Real], a: Nat -> Real, x: Real) {
    seq_frequently_in_real_set(s, a) and converges_to(a, x) implies closure(s).contains(x)
}

theorem seq_eventually_converges_imp_adherent(s: Set[Real], a: Nat -> Real, x: Real) {
    seq_eventually_in_real_set(s, a) and converges_to(a, x)
    implies is_adherent_point_of_set(s, x)
}

theorem seq_eventually_converges_imp_closure_contains(s: Set[Real], a: Nat -> Real, x: Real) {
    seq_eventually_in_real_set(s, a) and converges_to(a, x) implies closure(s).contains(x)
}

theorem seq_in_real_set_converges_imp_adherent(s: Set[Real], a: Nat -> Real, x: Real) {
    seq_in_real_set(s, a) and converges_to(a, x) implies is_adherent_point_of_set(s, x)
}

theorem seq_in_real_set_converges_imp_closure_contains(s: Set[Real], a: Nat -> Real, x: Real) {
    seq_in_real_set(s, a) and converges_to(a, x) implies closure(s).contains(x)
}

theorem closed_set_contains_frequent_seq_limit(s: Set[Real], a: Nat -> Real, x: Real) {
    is_closed_set(s) and seq_frequently_in_real_set(s, a) and converges_to(a, x) implies s.contains(x)
}

theorem closed_set_contains_eventual_seq_limit(s: Set[Real], a: Nat -> Real, x: Real) {
    is_closed_set(s) and seq_eventually_in_real_set(s, a) and converges_to(a, x) implies s.contains(x)
