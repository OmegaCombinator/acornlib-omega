        ) * (square_real(x0) * Real.1 + x0 * (x0 * Real.1 + x0 * Real.1)) +
        cube_real(x0) * (
            pointwise_add(pointwise_mul(constant[Real, Real](c), identity_fn[Real]), constant[Real, Real](b), x0) * c +
