}

theorem darboux_aux_value(f: Real -> Real, t: Real, x: Real) {
    darboux_aux(f, t, x) = f(x) - t * x
}

theorem darboux_aux_has_derivative_at(f: Real -> Real, df: Real -> Real, t: Real, x: Real) {
