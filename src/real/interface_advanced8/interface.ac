    implies
    (x + y).cos = x.cos * y.cos * (Real.1 - tan(x) * tan(y))
}

theorem tan_add(x: Real, y: Real) {
    x.cos != Real.0 and y.cos != Real.0 and Real.1 - tan(x) * tan(y) != Real.0
    implies
    tan(x + y) = (tan(x) + tan(y)) / (Real.1 - tan(x) * tan(y))
}

theorem tan_add_pi(x: Real) {
