theorem sec_sq_sub_tan_sq(x: Real) {
    x.cos != Real.0 implies sec(x).pow(Nat.2) - tan(x).pow(Nat.2) = Real.1
}

theorem csc_sq_sub_cot_sq(x: Real) {
    x.sin != Real.0 implies csc(x).pow(Nat.2) - cot(x).pow(Nat.2) = Real.1
