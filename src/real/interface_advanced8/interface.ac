theorem sin_add_tan(x: Real, y: Real) {
    x.cos != Real.0 and y.cos != Real.0
    implies
    (x + y).sin = x.cos * y.cos * (tan(x) + tan(y))
}

theorem cos_add_tan(x: Real, y: Real) {
