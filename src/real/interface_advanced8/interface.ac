theorem lhopital_derivative_ratio_seq_limit(
    f: Real -> Real, g: Real -> Real, df: Real -> Real, dg: Real -> Real,
    a: Real, q: Nat -> Real) {
    is_derivative_fn(f, df) and is_derivative_fn(g, dg) and
