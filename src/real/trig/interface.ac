theorem half_sum_sub_half_diff_local(x: Real, y: Real) {
    (x + y) / two - (y - x) / two = x
}

theorem sinh_sub_formula(x: Real, y: Real) {
    sinh(y) - sinh(x) = two * cosh((x + y) / two) * sinh((y - x) / two)
