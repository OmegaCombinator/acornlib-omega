theorem normal_moment_deriv_bound(b: Real) {
    Real.0 <= b implies
    forall(z: Real) {
        interval_contains(-b, b, z) implies
        normal_moment_deriv(z).abs <= (Real.1 + b * b) * (Real.1 / normalizing_const)
    }
