theorem arsinh_log_form(x: Real, s: Real) {
    (x * x + Real.1).sqrt = Option.some(s) implies arsinh(x) = (x + s).log.get_or_else(Real.0)
}

theorem pi_over_two_eq_two_mul_pi_over_four {
