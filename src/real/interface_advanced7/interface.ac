theorem gamma_interval_zero(b: Real) {
    Real.0 <= b implies
    (is_integrable(gamma_fn(Nat.0), Real.0, b) and
     gamma_interval(Nat.0, Real.0, b) = Real.1 - exp_neg_fn(b))
