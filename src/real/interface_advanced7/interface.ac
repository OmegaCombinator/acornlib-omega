theorem gamma_fn_one_bounds_on(b: Real, t: Real) {
    Real.0 <= b and interval_contains(Real.0, b, t)
    implies (Real.0 <= gamma_fn(Nat.1, t) and gamma_fn(Nat.1, t) <= b)
