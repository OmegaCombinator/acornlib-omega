theorem ftc1_dq_eq_average_left(f: Real -> Real, a: Real, x0: Real, x: Real) {
    x < x0 and integral(f, a, x0) = integral(f, a, x) + integral(f, x, x0)
    implies
    difference_quotient(integral_function(f, a), x0, x) = integral(f, x, x0) / (x0 - x)
