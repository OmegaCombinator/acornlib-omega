theorem cauchy_scaled_coeff(a: Nat -> Real, b: Nat -> Real, x: Real, n: Nat) {
    cauchy_seq(seq_mul(a, x.pow), seq_mul(b, x.pow))(n) =
        cauchy_product(a, b, n) * x.pow(n)
