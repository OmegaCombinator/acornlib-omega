theorem gamma_interval_one(b: Real) {
    Real.0 <= b implies
    (is_integrable(gamma_fn(Nat.1), Real.0, b) and
     gamma_interval(Nat.1, Real.0, b) =
         Real.1 - exp_neg_fn(b) * (b + Real.1))
}

theorem neg_pair_cancel_ring(a: Real, b: Real) {
