}

theorem integral_function_eq_affine(f: Real -> Real, c: Real, a: Real, x: Real) {
    (forall(t: Real) { f(t) = c }) and a <= x
    implies
    integral_function(f, a, x) = affine_real(c, -(c * a), x)
