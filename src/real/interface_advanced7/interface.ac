theorem integral_ge_const_width(f: Real -> Real, x0: Real, x: Real, c: Real) {
    x0 < x and is_integrable(f, x0, x) and
    (forall(t: Real) { interval_contains(x0, x, t) implies c <= f(t) })
    implies c * (x - x0) <= integral(f, x0, x)
