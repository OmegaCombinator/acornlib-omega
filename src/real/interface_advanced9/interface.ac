typeclass G: LeftOrderedGroup extends Group, LinearOrder {
    /// Left multiplication preserves the order relation: if `a ≤ b`, then `c * a ≤ c * b`.
    left_invariance(a: G, b: G, c: G) {
        a <= b implies c * a <= c * b
    }
}

