}

typeclass G: OrderedGroup extends LeftOrderedGroup {
    /// Right multiplication preserves the order relation: if `a ≤ b`, then `a * c ≤ b * c`.
    right_invariance(a: G, b: G, c: G) {
        a <= b implies a * c <= b * c
    }
}

