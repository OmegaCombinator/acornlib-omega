define jensen_points_in_interval(a: Real, b: Real, x: Nat -> Real, n: Nat) -> Bool {
    forall(i: Nat) {
        i < n implies jensen_point_in_interval_at(a, b, x, i)
    }
}

theorem jensen_points_in_interval_apply(a: Real, b: Real, x: Nat -> Real, n: Nat, i: Nat) {
    jensen_points_in_interval(a, b, x, n) and i < n implies a <= x(i) and x(i) <= b
}

theorem jensen_points_in_interval_restrict(a: Real, b: Real, x: Nat -> Real, n: Nat) {
    jensen_points_in_interval(a, b, x, n.suc) implies jensen_points_in_interval(a, b, x, n)
}

theorem jensen_weight_zero_of_partial_zero(w: Nat -> Real, n: Nat, i: Nat) {
    (forall(j: Nat) { Real.0 <= w(j) }) and partial(w, n) = Real.0 and i < n implies w(i) = Real.0
}

theorem convex_combination_in_closed_interval(a: Real, b: Real, u: Real, v: Real, t: Real) {
    a <= u and u <= b and a <= v and v <= b and Real.0 <= t and t <= Real.1
    implies a <= (Real.1 - t) * u + t * v and (Real.1 - t) * u + t * v <= b
}

theorem jensen_weights_split(w: Nat -> Real, n: Nat) {
    partial(w, n.suc) = Real.1 implies partial(w, n) = Real.1 - w(n)
}

theorem scaled_weight_nonneg(c: Real, w: Nat -> Real, i: Nat) {
    Real.0 < c and Real.0 <= w(i) implies Real.0 <= scaled_weight(c, w, i)
}

theorem partial_scaled_weight(c: Real, w: Nat -> Real, n: Nat) {
    partial(scaled_weight(c, w), n) = c.inverse * partial(w, n)
}

theorem partial_weighted_scaled(c: Real, w: Nat -> Real, y: Nat -> Real, n: Nat) {
    c != Real.0 implies
    partial(pointwise_product(w, y), n) = c * partial(pointwise_product(scaled_weight(c, w), y), n)
}

define jensen_claim_at(f: Real -> Real, a: Real, b: Real, k: Nat, w0: Nat -> Real, x0: Nat -> Real) -> Bool {
    (forall(i: Nat) { Real.0 <= w0(i) }) and partial(w0, k) = Real.1 and
    jensen_points_in_interval(a, b, x0, k)
    implies (a <= weighted_point_sum(w0, x0, k) and weighted_point_sum(w0, x0, k) <= b) and
        f(weighted_point_sum(w0, x0, k)) <= weighted_value_sum(f, w0, x0, k)
}

define jensen_claim(f: Real -> Real, a: Real, b: Real, k: Nat) -> Bool {
    forall(w0: Nat -> Real, x0: Nat -> Real) {
        jensen_claim_at(f, a, b, k, w0, x0)
    }
}

theorem jensen_claim_apply(f: Real -> Real, a: Real, b: Real, k: Nat, w0: Nat -> Real, x0: Nat -> Real) {
    jensen_claim(f, a, b, k) implies jensen_claim_at(f, a, b, k, w0, x0)
}

theorem jensen_convex_inequality(f: Real -> Real, a: Real, b: Real, w: Nat -> Real, x: Nat -> Real, n: Nat) {
    convex_on(f, a, b) and (forall(i: Nat) { Real.0 <= w(i) }) and partial(w, n) = Real.1 and
    jensen_points_in_interval(a, b, x, n)
    implies f(weighted_point_sum(w, x, n)) <= weighted_value_sum(f, w, x, n)
}

theorem limit_at_seq(f: Real -> Real, a: Real, l: Real, q: Nat -> Real) {
    limit_at(f, a, l) and (forall(n: Nat) { q(n) != a }) and converges_to(q, a)
    implies converges_to(compose(f, q), l)
}

theorem converges_to_add_seq(a: Nat -> Real, b: Nat -> Real, a_lim: Real, b_lim: Real) {
    converges_to(a, a_lim) and converges_to(b, b_lim)
    implies converges_to(add_seq(a, b), a_lim + b_lim)
}

theorem converges_to_prod_seq(a: Nat -> Real, b: Nat -> Real, a_lim: Real, b_lim: Real) {
    converges_to(a, a_lim) and converges_to(b, b_lim)
    implies converges_to(prod_seq(a, b), a_lim * b_lim)
}

theorem continuous_at_imp_limit_at(f: Real -> Real, a: Real) {
    continuous_at(f, a) implies limit_at(f, a, f(a))
}

theorem limit_at_add_fns(f: Real -> Real, g: Real -> Real, a: Real, l: Real, m: Real) {
    limit_at(f, a, l) and limit_at(g, a, m)
    implies limit_at(add_fns(f, g), a, l + m)
}

theorem limit_at_pointwise_mul(f: Real -> Real, g: Real -> Real, a: Real, l: Real, m: Real) {
    limit_at(f, a, l) and limit_at(g, a, m)
    implies limit_at(pointwise_mul[Real, Real](f, g), a, l * m)
}

theorem limit_at_quotient_fn(f: Real -> Real, g: Real -> Real, a: Real, l: Real, m: Real) {
    limit_at(f, a, l) and limit_at(g, a, m) and m != Real.0
    implies limit_at(quotient_fn(f, g), a, l / m)
}

theorem limit_at_compose_continuous(f: Real -> Real, g: Real -> Real, a: Real, b: Real) {
    limit_at(f, a, b) and continuous_at(g, b)
    implies limit_at(compose(g, f), a, g(b))
}

theorem limit_at_compose(f: Real -> Real, g: Real -> Real, a: Real, b: Real, m: Real) {
    limit_at(f, a, b) and limit_at(g, b, m) and
    (forall(x: Real) { x != a implies f(x) != b })
    implies limit_at(compose(g, f), a, m)
}

theorem limit_at_const(c: Real, a: Real) {
    limit_at(constant[Real, Real](c), a, c)
}

theorem limit_at_const_mul(f: Real -> Real, a: Real, l: Real, c: Real) {
    limit_at(f, a, l)
    implies limit_at(pointwise_mul[Real, Real](constant[Real, Real](c), f), a, c * l)
}

theorem same_limit_left_converges(a: Nat -> Real, b: Nat -> Real) {
    same_limit(a, b) implies converges(a)
}

theorem same_limit_right_converges(a: Nat -> Real, b: Nat -> Real) {
    same_limit(a, b) implies converges(b)
}

theorem same_limit_limits_equal(a: Nat -> Real, b: Nat -> Real) {
    same_limit(a, b) implies limit(a) = limit(b)
}

theorem const_seq_converges(c: Real) {
    converges(const_seq(c))
}

theorem const_seq_converges_to(c: Real) {
    converges_to(const_seq(c), c)
}

theorem const_seq_has_limit(c: Real) {
    limit(const_seq(c)) = c
}

theorem limit_of_sum(a: Nat -> Real, b: Nat -> Real, l: Real, m: Real) {
    converges_to(a, l) and converges_to(b, m)
    implies converges_to(add_seq(a, b), l + m)
}

theorem limit_of_product(a: Nat -> Real, b: Nat -> Real, l: Real, m: Real) {
    converges_to(a, l) and converges_to(b, m)
    implies converges_to(prod_seq(a, b), l * m)
}

theorem one_over_suc_converges_to_zero {
    converges_to(harmonic, Real.0)
}

theorem one_over_suc_converges {
    converges(harmonic)
}

theorem limit_one_over_suc {
    limit(harmonic) = Real.0
}

theorem squeeze_converges_to(a: Nat -> Real, b: Nat -> Real, c: Nat -> Real, l: Real) {
    seq_lte(a, b) and seq_lte(b, c) and converges_to(a, l) and converges_to(c, l)
    implies converges_to(b, l)
}

define sin_over_suc(n: Nat) -> Real {
    (from_nat[Real](n.suc)).sin / from_nat[Real](n.suc)
}

define neg_one_over_suc(n: Nat) -> Real {
    -(Real.1 / from_nat[Real](n.suc))
}

theorem neg_one_over_suc_lte_sin_over_suc {
    seq_lte(neg_one_over_suc, sin_over_suc)
}

theorem sin_over_suc_lte_one_over_suc {
    seq_lte(sin_over_suc, harmonic)
}

theorem neg_one_over_suc_same_limit_one_over_suc {
    same_limit(neg_one_over_suc, harmonic)
}

theorem sin_over_suc_converges_to_zero {
    converges_to(sin_over_suc, Real.0)
}

define lipschitz_with(f: Real -> Real, k: Real) -> Bool {
    Real.0 < k and forall(x: Real, y: Real) {
        (f(x) - f(y)).abs <= k * (x - y).abs
    }
}

define is_lipschitz(f: Real -> Real) -> Bool {
    exists(k: Real) {
        lipschitz_with(f, k)
    }
}

theorem lipschitz_with_pos_const(f: Real -> Real, k: Real) {
    lipschitz_with(f, k) implies Real.0 < k
}

theorem lipschitz_with_apply(f: Real -> Real, k: Real, x0: Real, y0: Real) {
    lipschitz_with(f, k) implies (f(x0) - f(y0)).abs <= k * (x0 - y0).abs
}

theorem lipschitz_imp_uniform(f: Real -> Real, k: Real) {
    lipschitz_with(f, k) implies uniform(f)
}

theorem lipschitz_imp_continuous(f: Real -> Real, k: Real) {
    lipschitz_with(f, k) implies continuous(f)
}

theorem derivative_bound_imp_lipschitz(
    f: Real -> Real, df: Real -> Real, k: Real, a: Real, b: Real
) {
    is_derivative_fn(f, df) and (forall(z: Real) { df(z).abs <= k }) and
    continuous(f) and Real.0 <= k and a <= b
    implies (f(b) - f(a)).abs <= k * (b - a).abs
}

let taylor_two: Real = Real.1 + Real.1

/// The real number two is nonzero.
theorem taylor_two_not_zero {
    taylor_two != Real.0
}

define taylor2_lin(f: Real -> Real, df: Real -> Real, a: Real, x: Real) -> Real {
    f(a) + df(a) * (x - a)
}

define taylor2_lin_remainder(f: Real -> Real, df: Real -> Real, a: Real, x: Real) -> Real {
    f(x) - taylor2_lin(f, df, a, x)
}

define taylor2_sq(a: Real, x: Real) -> Real {
    square_real(x - a)
}

define taylor2_delta(f: Real -> Real, df: Real -> Real, a: Real, b: Real) -> Real {
    f(b) - f(a) - df(a) * (b - a)
}

define taylor2_aux(f: Real -> Real, df: Real -> Real, a: Real, b: Real, x: Real) -> Real {
    square_real(b - a) * taylor2_lin_remainder(f, df, a, x) -
        taylor2_delta(f, df, a, b) * taylor2_sq(a, x)
}

define taylor2_aux_derivative(f: Real -> Real, df: Real -> Real, a: Real, b: Real, x: Real) -> Real {
    square_real(b - a) * (df(x) - df(a)) -
        taylor2_delta(f, df, a, b) * taylor_two * (x - a)
}

define taylor2_aux_second_derivative(f: Real -> Real, df: Real -> Real, ddf: Real -> Real, a: Real, b: Real, x: Real) -> Real {
    square_real(b - a) * ddf(x) -
        taylor2_delta(f, df, a, b) * taylor_two
}

theorem taylor_order_one(f: Real -> Real, df: Real -> Real, a: Real, b: Real) {
    continuous(f) and a < b and is_derivative_fn(f, df)
    implies exists(c: Real) {
        a < c and c < b and f(b) = f(a) + df(c) * (b - a)
    }
}

theorem taylor2_aux_eq_pointwise(f: Real -> Real, df: Real -> Real, a: Real, b: Real) {
    taylor2_aux(f, df, a, b) = pointwise_add(
        pointwise_mul(constant[Real, Real](square_real(b - a)),
            pointwise_add(f, pointwise_neg(affine_real(df(a), f(a) - df(a) * a)))),
        pointwise_neg(pointwise_mul(constant[Real, Real](taylor2_delta(f, df, a, b)),
            compose(square_real, affine_real(Real.1, -a)))))
}

theorem taylor2_aux_derivative_eq_pointwise(f: Real -> Real, df: Real -> Real, a: Real, b: Real) {
    taylor2_aux_derivative(f, df, a, b) = pointwise_add(
        pointwise_mul(constant[Real, Real](square_real(b - a)),
            pointwise_add(df, pointwise_neg(constant[Real, Real](df(a))))),
        pointwise_neg(pointwise_mul(constant[Real, Real](taylor2_delta(f, df, a, b) * taylor_two),
            affine_real(Real.1, -a))))
}

theorem taylor2_aux_continuous_on_closed(f: Real -> Real, df: Real -> Real, a: Real, b: Real, u: Real, v: Real) {
    is_derivative_fn(f, df)
    implies continuous_on_closed(taylor2_aux(f, df, a, b), u, v)
}

theorem is_derivative_fn_imp_is_derivative_on_open(
    f: Real -> Real, df: Real -> Real, a: Real, b: Real
) {
    is_derivative_fn(f, df) implies is_derivative_on_open(f, df, a, b)
}

theorem taylor2_sq_has_derivative_at(a: Real, x0: Real) {
    has_derivative_at(compose(square_real, affine_real(Real.1, -a)), x0, taylor_two * (x0 - a))
}

theorem taylor2_aux_derivative_continuous_on_closed(f: Real -> Real, df: Real -> Real, ddf: Real -> Real, a: Real, b: Real, u: Real, v: Real) {
    is_derivative_fn(df, ddf)
    implies continuous_on_closed(taylor2_aux_derivative(f, df, a, b), u, v)
}

theorem taylor2_aux_is_derivative_fn(f: Real -> Real, df: Real -> Real, a: Real, b: Real) {
    is_derivative_fn(f, df)
    implies is_derivative_fn(taylor2_aux(f, df, a, b), taylor2_aux_derivative(f, df, a, b))
}

theorem taylor2_aux_derivative_is_derivative_fn(f: Real -> Real, df: Real -> Real, ddf: Real -> Real, a: Real, b: Real) {
    is_derivative_fn(df, ddf)
    implies is_derivative_fn(taylor2_aux_derivative(f, df, a, b),
        taylor2_aux_second_derivative(f, df, ddf, a, b))
}

theorem taylor2_aux_at_a_zero(f: Real -> Real, df: Real -> Real, a: Real, b: Real) {
    taylor2_aux(f, df, a, b, a) = Real.0
}

theorem taylor2_aux_at_b_zero(f: Real -> Real, df: Real -> Real, a: Real, b: Real) {
    taylor2_aux(f, df, a, b, b) = Real.0
}

theorem taylor2_aux_endpoints_equal(f: Real -> Real, df: Real -> Real, a: Real, b: Real) {
    taylor2_aux(f, df, a, b, a) = taylor2_aux(f, df, a, b, b)
}

theorem taylor2_aux_derivative_at_a_zero(f: Real -> Real, df: Real -> Real, a: Real, b: Real) {
    taylor2_aux_derivative(f, df, a, b, a) = Real.0
}

theorem taylor2_sub_add_cancel(a: Real, b: Real) {
    (a - b) + b = a
}

theorem taylor2_sub_sub_add(a: Real, b: Real, c: Real) {
    (a - b - c) + b = a - c
}

theorem taylor2_conclusion_from_second_derivative(f: Real -> Real, df: Real -> Real, ddf: Real -> Real, a: Real, b: Real, c: Real) {
    taylor2_aux_second_derivative(f, df, ddf, a, b, c) = Real.0
    implies f(b) = f(a) + df(a) * (b - a) + (ddf(c) / taylor_two) * (b - a) * (b - a)
}

theorem taylor_order_two(f: Real -> Real, df: Real -> Real, ddf: Real -> Real, a: Real, b: Real) {
    a < b and is_derivative_fn(f, df) and is_derivative_fn(df, ddf)
    implies exists(c: Real) {
        a < c and c < b and
        f(b) = f(a) + df(a) * (b - a) + (ddf(c) / taylor_two) * (b - a) * (b - a)
    }
}

define newton_step(f: Real -> Real, fp: Real -> Real, x: Real) -> Real {
    x - f(x) / fp(x)
}

define newton_seq(f: Real -> Real, fp: Real -> Real, x0: Real, n: Nat) -> Real {
    match n {
        Nat.zero {
            x0
        }
        Nat.suc(m) {
            newton_step(f, fp, newton_seq(f, fp, x0, m))
        }
    }
}

theorem newton_seq_zero(f: Real -> Real, fp: Real -> Real, x0: Real) {
    newton_seq(f, fp, x0, Nat.0) = x0
}

theorem newton_seq_suc(f: Real -> Real, fp: Real -> Real, x0: Real, n: Nat) {
    newton_seq(f, fp, x0, n.suc) = newton_step(f, fp, newton_seq(f, fp, x0, n))
}

theorem newton_step_root_fixed_point(f: Real -> Real, fp: Real -> Real, xstar: Real) {
    f(xstar) = Real.0 and fp(xstar) != Real.0 implies
        newton_step(f, fp, xstar) = xstar
}

theorem newton_seq_root_constant(f: Real -> Real, fp: Real -> Real, xstar: Real) {
    f(xstar) = Real.0 and fp(xstar) != Real.0 implies
        forall(n: Nat) { newton_seq(f, fp, xstar, n) = xstar }
}

theorem newton_error_quadratic(f: Real -> Real, fp: Real -> Real, ddf: Real -> Real, x: Real, xstar: Real) {
    x < xstar and f(xstar) = Real.0 and fp(x) != Real.0 and
    is_derivative_fn(f, fp) and is_derivative_fn(fp, ddf)
    implies exists(c: Real) {
        x < c and c < xstar and
        newton_step(f, fp, x) - xstar =
            ((ddf(c) / taylor_two) * (xstar - x) * (xstar - x)) / fp(x)
    }
}

theorem newton_taylor_two_pos {
    taylor_two > Real.0
}

theorem newton_seq_error_quadratic(f: Real -> Real, fp: Real -> Real, ddf: Real -> Real, x0: Real, xstar: Real, n: Nat) {
    newton_seq(f, fp, x0, n) < xstar and f(xstar) = Real.0 and
    fp(newton_seq(f, fp, x0, n)) != Real.0 and
    is_derivative_fn(f, fp) and is_derivative_fn(fp, ddf)
    implies exists(c: Real) {
        newton_seq(f, fp, x0, n) < c and c < xstar and
        newton_seq(f, fp, x0, n.suc) - xstar =
            ((ddf(c) / taylor_two) * (xstar - newton_seq(f, fp, x0, n)) *
                (xstar - newton_seq(f, fp, x0, n))) /
                fp(newton_seq(f, fp, x0, n))
    }
}

theorem newton_error_bounded(f: Real -> Real, fp: Real -> Real, ddf: Real -> Real, x: Real, xstar: Real, m: Real, bigm: Real) {
    x < xstar and f(xstar) = Real.0 and fp(x) != Real.0 and
    is_derivative_fn(f, fp) and is_derivative_fn(fp, ddf) and
    m.is_positive and m <= fp(x).abs and
    (forall(z: Real) { x <= z and z <= xstar implies ddf(z).abs <= bigm })
    implies (newton_step(f, fp, x) - xstar).abs <=
        ((bigm / taylor_two) * (xstar - x) * (xstar - x)) / m
}

theorem normalizing_const_exists {
    exists(y: Real) {
        (two * pi).sqrt = Option.some(y) and y > Real.0
    }
}

let normalizing_const: Real satisfy {
    (two * pi).sqrt = Option.some(normalizing_const)
}

theorem normalizing_const_pos {
    normalizing_const > Real.0
}

define normal_pdf(x: Real) -> Real {
    (-(x * x) * Real.one_half).exp * (Real.1 / normalizing_const)
}

theorem normal_pdf_pos(x: Real) {
    normal_pdf(x) > Real.0
}

theorem normal_pdf_nonneg(x: Real) {
    Real.0 <= normal_pdf(x)
}

theorem normal_pdf_even(x: Real) {
    normal_pdf(-x) = normal_pdf(x)
}

theorem normal_pdf_at_zero {
    normal_pdf(Real.0) = Real.1 / normalizing_const
}

theorem normal_pdf_upper_bound(x: Real) {
    normal_pdf(x) <= Real.1 / normalizing_const
}

theorem normal_pdf_max_at_zero(x: Real) {
    normal_pdf(x) <= normal_pdf(Real.0)
}

define normal_moment_integrand(x: Real) -> Real {
    x * normal_pdf(x)
}

define normal_moment_anti(x: Real) -> Real {
    -normal_pdf(x)
}

define normal_moment_deriv(x: Real) -> Real {
    (Real.1 - x * x) * normal_pdf(x)
}

define normal_exponent(x: Real) -> Real {
    -(x * x) * Real.one_half
}

theorem normal_exponent_continuous {
    continuous(normal_exponent)
}

theorem normal_exponent_derivative {
    is_derivative_fn(normal_exponent, neg_fn)
}

theorem normal_pdf_continuous {
    continuous(normal_pdf)
}

theorem normal_pdf_derivative {
    is_derivative_fn(normal_pdf, pointwise_neg(normal_moment_integrand))
}

theorem normal_moment_anti_derivative {
    is_derivative_fn(normal_moment_anti, normal_moment_integrand)
}

theorem normal_moment_derivative {
    is_derivative_fn(normal_moment_integrand, normal_moment_deriv)
}

theorem normal_moment_continuous {
    continuous(normal_moment_integrand)
}

theorem normal_moment_anti_continuous {
    continuous(normal_moment_anti)
}

theorem normal_moment_bound_on(b: Real) {
    Real.0 <= b implies
    forall(t: Real) {
        interval_contains(-b, b, t) implies
        (normal_moment_integrand(t).abs <= b * (Real.1 / normalizing_const))
    }
}

theorem normal_moment_lower_bound_on(b: Real) {
    Real.0 <= b implies
    forall(t: Real) {
        interval_contains(-b, b, t) implies
        -(b * (Real.1 / normalizing_const)) <= normal_moment_integrand(t)
    }
}

theorem normal_moment_upper_bound_on(b: Real) {
    Real.0 <= b implies
    forall(t: Real) {
        interval_contains(-b, b, t) implies
        normal_moment_integrand(t) <= b * (Real.1 / normalizing_const)
    }
}

theorem normal_moment_deriv_bound(b: Real) {
    Real.0 <= b implies
    forall(z: Real) {
        interval_contains(-b, b, z) implies
        normal_moment_deriv(z).abs <= (Real.1 + b * b) * (Real.1 / normalizing_const)
    }
}

theorem normal_first_moment_symmetric(b: Real) {
    Real.0 <= b implies
    integral(normal_moment_integrand, -b, b) = Real.0
}

typeclass F: OrderedField extends Field, AddOrderedGroup {
    /// product of non-negative elements is non-negative
    mul_preserves_nonnegativity(a: F, b: F) {
        F.0 <= a and F.0 <= b implies F.0 <= a * b
    }
}

theorem multiply_inequality_with_nonnegative_element[F: OrderedField](a: F, b: F, c: F) {
    a <= b and F.0 <= c implies a * c <= b * c
}

theorem multiply_with_nonpositive_flips_inequality[F: OrderedField](a: F, b: F, c: F) {
    a <= b and c <= F.0 implies b * c <= a * c
}

define mul_right_scalar_map[F: OrderedField](c: F, x: F) -> F {
    x * c
}

define mul_left_scalar_map[F: OrderedField](c: F, x: F) -> F {
    c * x
}

theorem mul_right_scalar_map_is_monotone_of_nonnegative[F: OrderedField](c: F) {
    F.0 <= c implies is_monotone(mul_right_scalar_map(c))
}

theorem mul_left_scalar_map_is_monotone_of_nonnegative[F: OrderedField](c: F) {
    F.0 <= c implies is_monotone(mul_left_scalar_map(c))
}

theorem mul_right_scalar_map_is_antitone_of_nonpositive[F: OrderedField](c: F) {
    c <= F.0 implies is_antitone(mul_right_scalar_map(c))
}

