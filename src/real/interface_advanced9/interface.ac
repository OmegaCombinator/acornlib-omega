    alternating_sign[Real](n + m) = alternating_sign[Real](n) * alternating_sign[Real](m)
}

theorem tail_decreasing_seq(a: Nat -> Real, k: Nat) {
    is_decreasing_seq(a) implies is_decreasing_seq(tail(a, k))
}

theorem tail_lower_bound_seq(a: Nat -> Real, k: Nat, lb: Real) {
    is_lower_bound(a, lb) implies is_lower_bound(tail(a, k), lb)
}

theorem tail_zero_at(a: Nat -> Real, k: Nat) {
    tail(a, k)(Nat.0) = a(k)
}

theorem alt_term_tail(a: Nat -> Real, k: Nat) {
    tail(alt_term(a), k) = mul_seq(alternating_sign[Real](k), alt_term(tail(a, k)))
}

define alt_even_ub_pred(c: Nat -> Real, k: Nat) -> Bool {
    partial(alt_term(c), Nat.2 * k) <= c(Nat.0) - c(Nat.2 * k)
}

define alt_even_lb_pred(c: Nat -> Real, k: Nat) -> Bool {
    Real.0 <= partial(alt_term(c), Nat.2 * k)
}

theorem alt_even_ub_suc(c: Nat -> Real, k: Nat) {
    is_decreasing_seq(c) and is_lower_bound(c, Real.0)
    and alt_even_ub_pred(c, k)
    implies alt_even_ub_pred(c, k.suc)
}

theorem alt_even_ub_step(c: Nat -> Real) {
    is_decreasing_seq(c) and is_lower_bound(c, Real.0)
    implies forall(k: Nat) {
        alt_even_ub_pred(c, k) implies alt_even_ub_pred(c, k.suc)
    }
}

theorem alt_even_ub(c: Nat -> Real, q: Nat) {
    is_decreasing_seq(c) and is_lower_bound(c, Real.0)
    implies partial(alt_term(c), Nat.2 * q) <= c(Nat.0) - c(Nat.2 * q)
}

theorem alt_even_lb_suc(c: Nat -> Real, k: Nat) {
    is_decreasing_seq(c) and is_lower_bound(c, Real.0)
    and alt_even_lb_pred(c, k)
    implies alt_even_lb_pred(c, k.suc)
}

theorem alt_even_lb_step(c: Nat -> Real) {
    is_decreasing_seq(c) and is_lower_bound(c, Real.0)
    implies forall(k: Nat) {
        alt_even_lb_pred(c, k) implies alt_even_lb_pred(c, k.suc)
    }
}

theorem alt_even_lb(c: Nat -> Real, q: Nat) {
    is_decreasing_seq(c) and is_lower_bound(c, Real.0)
    implies Real.0 <= partial(alt_term(c), Nat.2 * q)
}

theorem alt_odd_ub(c: Nat -> Real, q: Nat) {
    is_decreasing_seq(c) and is_lower_bound(c, Real.0)
    implies partial(alt_term(c), Nat.2 * q + Nat.1) <= c(Nat.0)
}

theorem alt_odd_lb(c: Nat -> Real, q: Nat) {
    is_decreasing_seq(c) and is_lower_bound(c, Real.0)
    implies c(Nat.2 * q + Nat.1) <= partial(alt_term(c), Nat.2 * q + Nat.1)
}

theorem alt_partial_abs_bound(c: Nat -> Real, p: Nat) {
    is_decreasing_seq(c) and is_lower_bound(c, Real.0)
    implies partial(alt_term(c), p).abs <= c(Nat.0)
}

theorem alt_window_abs_bound(a: Nat -> Real, k: Nat, m: Nat) {
    is_decreasing_seq(a) and is_lower_bound(a, Real.0) and k <= m
    implies sum(map(k.until(m), alt_term(a))).abs <= a(k)
}

theorem alt_is_cauchy_series(a: Nat -> Real) {
    is_decreasing_seq(a) and is_lower_bound(a, Real.0) and converges_to(a, Real.0)
    implies is_cauchy_series(alt_term(a))
}

theorem alternating_series_test(a: Nat -> Real) {
    is_decreasing_seq(a) and vanishes(a) implies converges(partial(alt_term(a)))
}

define ratio_seq(a: Nat -> Real, n: Nat) -> Real {
    a(n.suc).abs / a(n).abs
}

theorem converges_to_strict_ub(q: Nat -> Real, b: Real, a: Real) {
    converges_to(q, b) and b < a implies exists(n: Nat) {
        forall(i: Nat) {
            n <= i implies q(i) < a
        }
    }
}

theorem exists_alpha_between(l: Real) {
    l < Real.1 implies exists(alpha: Real) {
        l < alpha and alpha < Real.1 and Real.0 <= alpha
    }
}

theorem ratio_test_abs_conv(a: Nat -> Real, l: Real, alpha: Real) {
    converges_to(ratio_seq(a), l)
    and l < alpha
    and alpha < Real.1
    and Real.0 <= alpha
    and always_nonzero(a)
    implies absolutely_converges(a)
}

theorem ratio_test(a: Nat -> Real, l: Real) {
    converges_to(ratio_seq(a), l) and l < Real.1 and always_nonzero(a)
    implies absolutely_converges(a)
}

define zeta2_term(k: Nat) -> Real {
    Real.1 / (from_nat[Real](k.suc) * from_nat[Real](k.suc))
}

define zeta2_tel_term(k: Nat) -> Real {
    harmonic(k) - harmonic(k.suc)
}

define zeta2_neg_harmonic(k: Nat) -> Real {
    -harmonic(k)
}

theorem recip_diff(a: Real, b: Real) {
    a != Real.0 and b != Real.0
    implies Real.1 / a - Real.1 / b = (b - a) / (a * b)
}

theorem recip_sq_le_twice_tel_diff(a: Real, b: Real) {
    a > Real.0 and b > Real.0 and b = a + Real.1 and Real.1 <= a
    implies Real.1 / (a * a) <= (Real.1 + Real.1) * (Real.1 / a - Real.1 / b)
}

theorem zeta2_term_pos(k: Nat) {
    zeta2_term(k) > Real.0
}

theorem zeta2_term_nonneg(k: Nat) {
    Real.0 <= zeta2_term(k)
}

theorem zeta2_term_le_majorant(k: Nat) {
    zeta2_term(k) <= (Real.1 + Real.1) * zeta2_tel_term(k)
}

theorem zeta2_tel_diff(k: Nat) {
    diff_step(zeta2_neg_harmonic, k) = zeta2_tel_term(k)
}

theorem zeta2_tel_partial(n: Nat) {
    partial(zeta2_tel_term, n) = Real.1 - harmonic(n)
}

theorem zeta2_tel_partial_le_one(n: Nat) {
    partial(zeta2_tel_term, n) <= Real.1
}

theorem zeta2_partial_le_two(n: Nat) {
    partial(zeta2_term, n) <= (Real.1 + Real.1)
}

theorem zeta2_converges {
    converges(partial(zeta2_term))
}

theorem zeta2_converges_to_limit {
    converges_to(partial(zeta2_term), limit(partial(zeta2_term)))
}

theorem zeta2_partial_basel_form(k: Nat) {
    partial(function(n: Nat) {
        Real.1 / ((from_nat[Real](n) + Real.1) * (from_nat[Real](n) + Real.1))
    }, k) = partial(zeta2_term, k)
}

theorem harmonic_decreasing {
    is_decreasing_seq(harmonic)
}

theorem mercator_partial_two {
    partial(alt_term(harmonic), Nat.2) = Real.1 / from_nat[Real](Nat.2)
}

theorem mercator_partial_four {
    partial(alt_term(harmonic), Nat.4) = from_nat[Real](Nat.7) / from_nat[Real](Nat.12)
}

define ps_term(a: Nat -> Real, x: Real, n: Nat) -> Real {
    a(n) * x.pow(n)
}

define ps_sum(a: Nat -> Real, x: Real) -> Real {
    limit(partial(ps_term(a, x)))
}

define ps_diff_coeff(a: Nat -> Real, n: Nat) -> Real {
    Real.from_rat(Rat.from_nat(n.suc)) * a(n.suc)
}

define ps_diff_term(a: Nat -> Real, x: Real, n: Nat) -> Real {
    ps_term(ps_diff_coeff(a), x, n)
}

define ps_int_coeff(a: Nat -> Real, n: Nat) -> Real {
    a(n) / Real.from_rat(Rat.from_nat(n.suc))
}

define ps_int_term(a: Nat -> Real, x: Real, n: Nat) -> Real {
    a(n) * x.pow(n.suc) / Real.from_rat(Rat.from_nat(n.suc))
}

theorem converges_to_pointwise_eq(q: Nat -> Real, r: Nat -> Real, a: Real) {
    (forall(n: Nat) { q(n) = r(n) }) implies (converges_to(q, a) implies converges_to(r, a))
}

theorem converges_pointwise_eq(q: Nat -> Real, r: Nat -> Real) {
    (forall(n: Nat) { q(n) = r(n) }) implies (converges(q) implies converges(r))
}

theorem limit_pointwise_eq(s: Nat -> Real, t: Nat -> Real) {
    (forall(n: Nat) { s(n) = t(n) }) and converges(s)
    implies
    limit(t) = limit(s)
}

theorem mul_recip_prod_cancel(a: Real, b: Real) {
    a != Real.0 and b != Real.0 implies a * (Real.1 / (a * b)) = Real.1 / b
}

theorem mul_div_prod_cancel(a: Real, b: Real, c: Real) {
    a != Real.0 and b != Real.0 implies a * (c / (a * b)) = c / b
}

theorem recip_div(a: Real, b: Real) {
    a != Real.0 and b != Real.0 implies (Real.1 / b) / a = Real.1 / (a * b)
}

theorem div_nonneg_le_self(c: Real, d: Real) {
    Real.0 <= c and Real.1 <= d implies c / d <= c
}

define exp_coeff(n: Nat) -> Real {
    Real.1 / Real.from_rat(Rat.from_nat(n.factorial))
}

theorem ps_term_exp_coeff(x: Real, n: Nat) {
    ps_term(exp_coeff, x, n) = exp_term(x, n)
}

theorem exp_diff_coeff_eq_exp_coeff(n: Nat) {
    ps_diff_coeff(exp_coeff, n) = exp_coeff(n)
}

theorem exp_int_coeff_eq_shifted(n: Nat) {
    ps_int_coeff(exp_coeff, n) = exp_coeff(n.suc)
}

theorem ps_diff_term_exp_coeff_eq_exp_term(x: Real, n: Nat) {
    ps_diff_term(exp_coeff, x, n) = exp_term(x, n)
}

theorem ps_int_term_exp_coeff_eq_shift(x: Real, n: Nat) {
    ps_int_term(exp_coeff, x, n) = exp_term(x, n.suc)
}

theorem exp_diff_series_eq_exp(x: Real) {
    limit(partial(ps_diff_term(exp_coeff, x))) = x.exp
}

theorem exp_int_series_eq_exp_sub_one(x: Real) {
    limit(partial(ps_int_term(exp_coeff, x))) = x.exp - Real.1
}

define sin_diff_term(x: Real, n: Nat) -> Real {
    Real.from_rat(Rat.from_nat(Nat.2 * n + Nat.1)) * alternating_sign[Real](n) *
        x.pow(Nat.2 * n) / Real.from_rat(Rat.from_nat((Nat.2 * n + Nat.1).factorial))
}

theorem sin_diff_term_eq_cos_term(x: Real, n: Nat) {
    sin_diff_term(x, n) = cos_term(x, n)
}

define cos_diff_term(x: Real, n: Nat) -> Real {
    Real.from_rat(Rat.from_nat(Nat.2 * n + Nat.2)) * alternating_sign[Real](n.suc) *
        x.pow(Nat.2 * n + Nat.1) / Real.from_rat(Rat.from_nat((Nat.2 * n + Nat.2).factorial))
}

theorem cos_diff_term_eq_neg_sin_term(x: Real, n: Nat) {
    cos_diff_term(x, n) = -sin_term(x, n)
}

theorem sin_diff_series_eq_cos(x: Real) {
    limit(partial(sin_diff_term(x))) = x.cos
}

theorem cos_diff_series_eq_neg_sin(x: Real) {
    limit(partial(cos_diff_term(x))) = -x.sin
}

theorem ps_int_coeff_abs_le(a: Nat -> Real, n: Nat) {
    ps_int_coeff(a, n).abs <= a(n).abs
}

theorem ps_int_term_abs_le(a: Nat -> Real, x: Real, n: Nat) {
    ps_int_term(a, x, n).abs <= x.abs * ps_term(a, x, n).abs
}

theorem ps_int_term_abs_converges_of_abs_converges(a: Nat -> Real, x: Real) {
    absolutely_converges(ps_term(a, x)) implies absolutely_converges(ps_int_term(a, x))
}

define mercator_term(x: Real, n: Nat) -> Real {
    alternating_sign[Real](n) * x.pow(n.suc) / Real.from_rat(Rat.from_nat(n.suc))
}

define mercator_sum(x: Real) -> Real {
    limit(partial(mercator_term(x)))
}

define mercator_diff_term(x: Real, n: Nat) -> Real {
    alternating_sign[Real](n) * x.pow(n)
}

theorem mercator_term_abs(x: Real, n: Nat) {
    mercator_term(x, n).abs = x.abs.pow(n.suc) / Real.from_rat(Rat.from_nat(n.suc))
}

theorem mercator_term_abs_le_geom(x: Real, n: Nat) {
    mercator_term(x, n).abs <= x.abs * x.abs.pow(n)
}

theorem mercator_term_abs_converges_small(x: Real) {
    x.abs < Real.1 implies absolutely_converges(mercator_term(x))
}

theorem mercator_diff_coeff(n: Nat) {
    Real.from_rat(Rat.from_nat(n.suc)) * (Real.1 / Real.from_rat(Rat.from_nat(n.suc))) = Real.1
}

theorem mercator_diff_term_eq_alt_pow(x: Real, n: Nat) {
    mercator_diff_term(x, n) = (-x).pow(n)
}

theorem alt_geom_series_eq_recip(x: Real) {
    x.abs < Real.1 implies limit(partial((-x).pow)) = Real.1 / (Real.1 + x)
}

theorem mercator_diff_series_eq_recip(x: Real) {
    x.abs < Real.1 implies limit(partial(mercator_diff_term(x))) = Real.1 / (Real.1 + x)
}

theorem mercator_series_at_one_converges {
    converges(partial(mercator_term(Real.1)))
}

theorem real_partial_interval_sum(f: Nat -> Real, a: Nat, b: Nat) {
    a <= b implies partial(f, b) = partial(f, a) + sum(map(a.until(b), f))
}

theorem real_partial_interval_sum_comm(f: Nat -> Real, a: Nat, b: Nat) {
    a <= b implies sum(map(a.until(b), f)) + partial(f, a) = partial(f, b)
}

theorem real_interval_sum_eq_partial_sub(f: Nat -> Real, a: Nat, b: Nat) {
    a <= b implies sum(map(a.until(b), f)) = partial(f, b) - partial(f, a)
}

theorem real_partial_add_offset_sum(f: Nat -> Real, a: Nat, k: Nat) {
    partial(f, a + k) = partial(f, a) + sum(map(a.until(a + k), f))
}

theorem real_partial_add_offset_sum_comm(f: Nat -> Real, a: Nat, k: Nat) {
    sum(map(a.until(a + k), f)) + partial(f, a) = partial(f, a + k)
}

theorem real_offset_interval_sum_eq_partial_sub(f: Nat -> Real, a: Nat, k: Nat) {
    sum(map(a.until(a + k), f)) = partial(f, a + k) - partial(f, a)
}

theorem real_partial_interval_suc(f: Nat -> Real, n: Nat) {
    partial(f, n.suc) = partial(f, n) + sum(map(n.until(n.suc), f))
}

theorem real_partial_tail_eq_interval_sum(f: Nat -> Real, a: Nat, k: Nat) {
    partial(tail(f, a), k) = sum(map(a.until(a + k), f))
}

theorem real_partial_tail_add_initial(f: Nat -> Real, a: Nat, k: Nat) {
    partial(f, a) + partial(tail(f, a), k) = partial(f, a + k)
}

theorem real_partial_tail_add_initial_comm(f: Nat -> Real, a: Nat, k: Nat) {
    partial(tail(f, a), k) + partial(f, a) = partial(f, a + k)
}

theorem real_partial_range_take_drop_sum(f: Nat -> Real, n: Nat, k: Nat) {
    partial(f, n) = sum(map(list_take(n.range, k), f)) + sum(map(n.range.drop(k), f))
}

theorem real_sum_map_take_range_length(f: Nat -> Real, n: Nat) {
    sum(map(list_take(n.range, n), f)) = partial(f, n)
}

theorem real_sum_map_drop_range_length(f: Nat -> Real, n: Nat) {
    sum(map(n.range.drop(n), f)) = Real.0
}

theorem series_converges_of_tail(f: Nat -> Real, n: Nat) {
    converges(partial(tail(f, n))) implies converges(partial(f))
}

theorem tail_series_converges_of_series(f: Nat -> Real, n: Nat) {
    converges(partial(f)) implies converges(partial(tail(f, n)))
}

theorem series_converges_iff_tail(f: Nat -> Real, n: Nat) {
    converges(partial(f)) = converges(partial(tail(f, n)))
}

theorem absolutely_converges_of_tail(f: Nat -> Real, n: Nat) {
    absolutely_converges(tail(f, n)) implies absolutely_converges(f)
}

theorem tail_absolutely_converges_of_abs_converges(f: Nat -> Real, n: Nat) {
    absolutely_converges(f) implies absolutely_converges(tail(f, n))
}

theorem absolutely_converges_iff_tail(f: Nat -> Real, n: Nat) {
    absolutely_converges(f) = absolutely_converges(tail(f, n))
}

theorem partial_sums_lte_of_seq_lte(f: Nat -> Real, g: Nat -> Real) {
    seq_lte(f, g) implies seq_lte(partial(f), partial(g))
}

theorem tail_partial_sums_lte_of_tail_seq_lte(f: Nat -> Real, g: Nat -> Real, n: Nat) {
    seq_lte(tail(f, n), tail(g, n)) implies seq_lte(partial(tail(f, n)), partial(tail(g, n)))
}

theorem tail_seq_lte_of_eventual_index_lte(f: Nat -> Real, g: Nat -> Real, n: Nat) {
    (forall(k: Nat) { n <= k implies f(k) <= g(k) }) implies seq_lte(tail(f, n), tail(g, n))
}

theorem tail_lower_bound_of_eventual_nonneg(f: Nat -> Real, n: Nat) {
    (forall(k: Nat) { n <= k implies Real.0 <= f(k) }) implies is_lower_bound(tail(f, n), Real.0)
}

theorem eventually_dominated_nonneg_series_converges(f: Nat -> Real, g: Nat -> Real, n: Nat) {
    (forall(k: Nat) { n <= k implies Real.0 <= f(k) })
    and (forall(k: Nat) { n <= k implies f(k) <= g(k) })
    and converges(partial(g))
    implies converges(partial(f))
}

theorem eventually_abs_dominated_absolutely_converges(f: Nat -> Real, g: Nat -> Real, n: Nat) {
    (forall(k: Nat) { n <= k implies Real.0 <= g(k) })
    and (forall(k: Nat) { n <= k implies abs_fn(f)(k) <= g(k) })
    and converges(partial(g))
    implies absolutely_converges(f)
}

theorem tail_interval_sum_lte_of_tail_partial_lte(f: Nat -> Real, g: Nat -> Real, n: Nat, k: Nat) {
    seq_lte(partial(tail(f, n)), partial(tail(g, n))) implies
        partial(tail(f, n), k) <= partial(tail(g, n), k)
}

theorem eventually_dominated_tail_interval_sum_lte(f: Nat -> Real, g: Nat -> Real, n: Nat, k: Nat) {
    (forall(i: Nat) { n <= i implies f(i) <= g(i) }) implies
        partial(tail(f, n), k) <= partial(tail(g, n), k)
}

theorem eventually_dominated_interval_sum_lte(f: Nat -> Real, g: Nat -> Real, n: Nat, k: Nat) {
    (forall(i: Nat) { n <= i implies f(i) <= g(i) }) implies
        sum(map(n.until(n + k), f)) <= sum(map(n.until(n + k), g))
}

theorem eventually_abs_dominated_series_converges(f: Nat -> Real, g: Nat -> Real, n: Nat) {
    (forall(k: Nat) { n <= k implies Real.0 <= g(k) })
    and (forall(k: Nat) { n <= k implies abs_fn(f)(k) <= g(k) })
    and converges(partial(g))
    implies converges(partial(f))
}

define geometric_majorant(c: Real, r: Real, k: Nat) -> Real {
    c * r.pow(k)
}

theorem geometric_majorant_eq_mul_seq(c: Real, r: Real) {
    geometric_majorant(c, r) = mul_seq(c, r.pow)
}

theorem geometric_majorant_nonneg(c: Real, r: Real, k: Nat) {
    Real.0 <= c and Real.0 <= r implies Real.0 <= geometric_majorant(c, r, k)
}

theorem geometric_majorant_lower_bound_zero(c: Real, r: Real) {
    Real.0 <= c and Real.0 <= r implies is_lower_bound(geometric_majorant(c, r), Real.0)
}

theorem partial_geometric_majorant_eq_mul_seq_partial(c: Real, r: Real) {
    partial(geometric_majorant(c, r)) = mul_seq(c, partial(r.pow))
}

theorem geometric_majorant_series_converges(c: Real, r: Real) {
    Real.0 <= r and r < Real.1 implies converges(partial(geometric_majorant(c, r)))
}

theorem eventually_abs_le_geometric_absolutely_converges(f: Nat -> Real, c: Real, r: Real, n: Nat) {
    Real.0 <= c
    and Real.0 <= r
    and r < Real.1
    and (forall(k: Nat) { n <= k implies abs_fn(f)(k) <= geometric_majorant(c, r, k) })
    implies absolutely_converges(f)
}

theorem eventually_abs_le_geometric_series_converges(f: Nat -> Real, c: Real, r: Real, n: Nat) {
    Real.0 <= c
    and Real.0 <= r
    and r < Real.1
    and (forall(k: Nat) { n <= k implies abs_fn(f)(k) <= geometric_majorant(c, r, k) })
    implies converges(partial(f))
}

theorem eventually_nonneg_le_geometric_series_converges(f: Nat -> Real, c: Real, r: Real, n: Nat) {
    Real.0 <= c
    and Real.0 <= r
    and r < Real.1
    and (forall(k: Nat) { n <= k implies Real.0 <= f(k) })
    and (forall(k: Nat) { n <= k implies f(k) <= geometric_majorant(c, r, k) })
    implies converges(partial(f))
}

theorem tail_abs_le_geometric_absolutely_converges(f: Nat -> Real, c: Real, r: Real, n: Nat) {
    Real.0 <= c
    and Real.0 <= r
    and r < Real.1
    and (forall(k: Nat) { abs_fn(tail(f, n))(k) <= geometric_majorant(c, r, k) })
    implies absolutely_converges(f)
}

theorem tail_nonneg_le_geometric_series_converges(f: Nat -> Real, c: Real, r: Real, n: Nat) {
    Real.0 <= c
    and Real.0 <= r
    and r < Real.1
    and (forall(k: Nat) { Real.0 <= tail(f, n)(k) })
    and (forall(k: Nat) { tail(f, n)(k) <= geometric_majorant(c, r, k) })
    implies converges(partial(f))
}

theorem eventually_geometric_tail_interval_sum_lte(f: Nat -> Real, c: Real, r: Real, n: Nat, k: Nat) {
    (forall(i: Nat) { n <= i implies f(i) <= geometric_majorant(c, r, i) }) implies
        partial(tail(f, n), k) <= partial(tail(geometric_majorant(c, r), n), k)
}

theorem eventually_geometric_interval_sum_lte(f: Nat -> Real, c: Real, r: Real, n: Nat, k: Nat) {
    (forall(i: Nat) { n <= i implies f(i) <= geometric_majorant(c, r, i) }) implies
        sum(map(n.until(n + k), f)) <= sum(map(n.until(n + k), geometric_majorant(c, r)))
}

theorem tail_seq_lte_geometric_of_eventual_lte(f: Nat -> Real, c: Real, r: Real, n: Nat) {
    (forall(i: Nat) { n <= i implies f(i) <= geometric_majorant(c, r, i) }) implies
        seq_lte(tail(f, n), tail(geometric_majorant(c, r), n))
}

theorem tail_lower_bound_zero_of_eventual_nonneg(f: Nat -> Real, n: Nat) {
    (forall(i: Nat) { n <= i implies Real.0 <= f(i) }) implies is_lower_bound(tail(f, n), Real.0)
}

theorem partial_sums_lte_of_geometric_seq_lte(f: Nat -> Real, c: Real, r: Real) {
    seq_lte(f, geometric_majorant(c, r)) implies seq_lte(partial(f), partial(geometric_majorant(c, r)))
}

define power_series_term(a: Nat -> Real, x: Real, k: Nat) -> Real {
    a(k) * x.pow(k)
}

theorem pow_mul_distrib(x: Real, y: Real, n: Nat) {
    (x * y).pow(n) = x.pow(n) * y.pow(n)
}

theorem series_conv_imp_terms_bounded(a: Nat -> Real) {
    converges(partial(a)) implies is_bounded_seq(a)
}

theorem abs_pos_of_ne_zero(x: Real) {
    x != Real.0 implies x.abs > Real.0
}

theorem div_lt_one(a: Real, b: Real) {
    a < b and b > Real.0 implies a / b < Real.1
}

theorem div_nonneg_of_nonneg(a: Real, b: Real) {
    Real.0 <= a and b > Real.0 implies Real.0 <= a / b
}

theorem abs_pow_abs(x: Real, n: Nat) {
    x.pow(n).abs = x.abs.pow(n)
}

theorem power_series_abs_conv_inside_radius(a: Nat -> Real, x: Real, x0: Real) {
    converges(partial(power_series_term(a, x0))) and x0 != Real.0 and x.abs < x0.abs
    implies absolutely_converges(power_series_term(a, x))
}

define sbp_step(f: Nat -> Real, g: Nat -> Real, k: Nat) -> Real {
    partial(f, k.suc) * (g(k.suc) - g(k))
}

theorem mul_sub_cancel(a: Real, b: Real, c: Real) {
    a * b - a * (b - c) = a * c
}

theorem sub_add_rearrange(a: Real, b: Real, c: Real, d: Real) {
    a + b - (c + d) = (a - c) + (b - d)
}

theorem summation_by_parts(f: Nat -> Real, g: Nat -> Real, n: Nat) {
    partial(prod_seq(f, g), n) =
        partial(f, n) * g(n) - sum(map(n.range, sbp_step(f, g)))
}

define ps_conv_radii_contains(a: Nat -> Real, r: Real) -> Bool {
    Real.0 <= r and absolutely_converges(power_series_term(a, r))
}

define ps_conv_radii_set(a: Nat -> Real) -> Set[Real] {
    Set[Real].new(ps_conv_radii_contains(a))
}

theorem ps_conv_radii_set_contains_iff(a: Nat -> Real, r: Real) {
    ps_conv_radii_set(a).contains(r) = ps_conv_radii_contains(a, r)
}

define is_ps_radius(a: Nat -> Real, rho: Real) -> Bool {
    is_set_supremum(ps_conv_radii_set(a), rho)
}

theorem ps_term_at_zero_zero(a: Nat -> Real) {
    power_series_term(a, Real.0, Nat.0) = a(Nat.0)
}

theorem ps_term_at_zero_tail(a: Nat -> Real, n: Nat) {
    n >= Nat.1 implies power_series_term(a, Real.0, n) = Real.0
}

theorem ps_abs_partial_at_zero_suc(a: Nat -> Real, n: Nat) {
    partial(abs_fn(power_series_term(a, Real.0)), n.suc) = a(Nat.0).abs
}

theorem ps_conv_radii_contains_zero(a: Nat -> Real) {
    ps_conv_radii_set(a).contains(Real.0)
}

theorem ps_radius_nonneg(a: Nat -> Real, rho: Real) {
    is_ps_radius(a, rho) implies Real.0 <= rho
}

theorem ps_abs_conv_inside_radius(a: Nat -> Real, x: Real, rho: Real) {
    is_ps_radius(a, rho) and x.abs < rho
    implies absolutely_converges(power_series_term(a, x))
}

theorem ps_conv_radii_contains_below(a: Nat -> Real, x: Real, r: Real) {
    converges(partial(power_series_term(a, x))) and x != Real.0
    and Real.0 <= r and r < x.abs
    implies ps_conv_radii_set(a).contains(r)
}

theorem ps_conv_imp_radius_ub(a: Nat -> Real, x: Real, rho: Real) {
    converges(partial(power_series_term(a, x))) and is_ps_radius(a, rho)
    implies x.abs <= rho
}

theorem ps_radius_exists_of_divergence(a: Nat -> Real, x1: Real) {
    not absolutely_converges(power_series_term(a, x1))
    implies exists(rho: Real) { is_ps_radius(a, rho) }
}

theorem ps_term_eq_power_series_term(a: Nat -> Real, x: Real, n: Nat) {
    ps_term(a, x, n) = power_series_term(a, x, n)
}

theorem exp_series_abs_conv_everywhere(r: Real) {
    absolutely_converges(power_series_term(exp_coeff, r))
}

theorem exp_radii_contains_every_nonneg(r: Real) {
    Real.0 <= r implies ps_conv_radii_set(exp_coeff).contains(r)
}

theorem exp_radii_set_unbounded {
    forall(m: Real) {
        exists(r: Real) {
            ps_conv_radii_set(exp_coeff).contains(r) and m < r
        }
    }
}

theorem exp_series_radius_infinite {
    not exists(rho: Real) { is_ps_radius(exp_coeff, rho) }
}

theorem rpow_ge_one_of_base_ge_one_exp_nonneg(base: Real, exponent: Real) {
    base >= Real.1 and exponent >= Real.0 implies exists(value: Real) {
        base.rpow(exponent) = Option.some(value) and value >= Real.1
    }
}

theorem rpow_le_one_of_base_ge_one_exp_nonpos(base: Real, exponent: Real) {
    base >= Real.1 and exponent <= Real.0 implies exists(value: Real) {
        base.rpow(exponent) = Option.some(value) and value <= Real.1
    }
}

theorem rpow_le_one_of_pos_base_le_one_exp_nonneg(base: Real, exponent: Real) {
    base > Real.0 and base <= Real.1 and exponent >= Real.0 implies exists(value: Real) {
        base.rpow(exponent) = Option.some(value) and value <= Real.1
    }
}

theorem rpow_ge_one_of_pos_base_le_one_exp_nonpos(base: Real, exponent: Real) {
    base > Real.0 and base <= Real.1 and exponent <= Real.0 implies exists(value: Real) {
        base.rpow(exponent) = Option.some(value) and value >= Real.1
    }
}

theorem rpow_exponent_monotone_base_ge_one(base: Real, a: Real, b: Real, va: Real, vb: Real) {
    base >= Real.1 and a <= b and base.rpow(a) = Option.some(va) and base.rpow(b) = Option.some(vb)
    implies va <= vb
}

theorem closure_of_bounded_real_set_is_bounded(s: Set[Real]) {
    is_bounded_real_set(s) implies is_bounded_real_set(closure(s))
}

theorem eps_adherent_intersection_left(s: Set[Real], t: Set[Real], x: Real, eps: Real) {
    is_eps_adherent_to_set(s.intersection(t), x, eps) implies is_eps_adherent_to_set(s, x, eps)
}

theorem eps_adherent_intersection_right(s: Set[Real], t: Set[Real], x: Real, eps: Real) {
    is_eps_adherent_to_set(s.intersection(t), x, eps) implies is_eps_adherent_to_set(t, x, eps)
}

theorem adherent_intersection_left(s: Set[Real], t: Set[Real], x: Real) {
    is_adherent_point_of_set(s.intersection(t), x) implies is_adherent_point_of_set(s, x)
}

theorem adherent_intersection_right(s: Set[Real], t: Set[Real], x: Real) {
    is_adherent_point_of_set(s.intersection(t), x) implies is_adherent_point_of_set(t, x)
}

theorem closed_intersection_contains_adherent(s: Set[Real], t: Set[Real], x: Real) {
    is_closed_set(s) and is_closed_set(t) and is_adherent_point_of_set(s.intersection(t), x)
    implies s.intersection(t).contains(x)
}

theorem intersection_of_closed_is_closed(s: Set[Real], t: Set[Real]) {
    is_closed_set(s) and is_closed_set(t) implies is_closed_set(s.intersection(t))
}

theorem complement_of_open_is_closed(s: Set[Real]) {
    is_open_set(s) implies is_closed_set(s.c)
}

theorem union_of_open_is_open(s: Set[Real], t: Set[Real]) {
    is_open_set(s) and is_open_set(t) implies is_open_set(s.union(t))
}

theorem closed_complement_not_adherent(s: Set[Real], x: Real) {
    is_closed_set(s) and s.c.contains(x) implies not is_adherent_point_of_set(s, x)
}

theorem not_adherent_has_missing_eps(s: Set[Real], x: Real) {
    not is_adherent_point_of_set(s, x) implies exists(eps: Real) {
        eps.is_positive and not is_eps_adherent_to_set(s, x, eps)
    }
}

theorem missing_eps_adherent_excludes_member(s: Set[Real], x: Real, eps: Real, y: Real) {
    not is_eps_adherent_to_set(s, x, eps) and y.is_close(x, eps) implies not s.contains(y)
}

theorem closed_complement_interior_point(s: Set[Real], x: Real) {
    is_closed_set(s) and s.c.contains(x) implies is_interior_point(s.c, x)
}

theorem complement_of_closed_is_open(s: Set[Real]) {
    is_closed_set(s) implies is_open_set(s.c)
}

theorem smaller_ball_subset_left(s: Set[Real], x: Real, eps: Real, eps1: Real) {
    eps <= eps1 and forall(y: Real) {
        y.is_close(x, eps1) implies s.contains(y)
    } implies forall(y: Real) {
        y.is_close(x, eps) implies s.contains(y)
    }
}

theorem ball_subset_intersection(s: Set[Real], t: Set[Real], x: Real, eps: Real) {
    forall(y: Real) {
        y.is_close(x, eps) implies s.contains(y)
    } and forall(y: Real) {
        y.is_close(x, eps) implies t.contains(y)
    } implies forall(y: Real) {
        y.is_close(x, eps) implies s.intersection(t).contains(y)
    }
}

theorem interior_point_intersection(s: Set[Real], t: Set[Real], x: Real) {
    is_interior_point(s, x) and is_interior_point(t, x) implies
    is_interior_point(s.intersection(t), x)
}

theorem intersection_of_open_is_open(s: Set[Real], t: Set[Real]) {
    is_open_set(s) and is_open_set(t) implies is_open_set(s.intersection(t))
}

theorem complement_union_eq_intersection_complements(s: Set[Real], t: Set[Real]) {
    s.union(t).c = s.c.intersection(t.c)
}

theorem union_of_closed_is_closed(s: Set[Real], t: Set[Real]) {
    is_closed_set(s) and is_closed_set(t) implies is_closed_set(s.union(t))
}

theorem closure_union_subset(s: Set[Real], t: Set[Real]) {
    closure(s.union(t)).subset(closure(s).union(closure(t)))
}

theorem closure_union_eq(s: Set[Real], t: Set[Real]) {
    closure(s.union(t)) = closure(s).union(closure(t))
}

theorem singleton_real_set_is_closed(a: Real) {
    is_closed_set(Set[Real].singleton(a))
}

theorem singleton_real_set_isolated(a: Real) {
    is_isolated_point_of_set(Set[Real].singleton(a), a)
}

theorem singleton_real_set_has_no_limit_points(a: Real, x: Real) {
    not is_limit_point_of_set(Set[Real].singleton(a), x)
}

define is_compact_real_set(s: Set[Real]) -> Bool {
    is_closed_set(s) and is_bounded_real_set(s)
}

theorem compact_real_set_is_closed(s: Set[Real]) {
    is_compact_real_set(s) implies is_closed_set(s)
}

theorem compact_real_set_is_bounded(s: Set[Real]) {
    is_compact_real_set(s) implies is_bounded_real_set(s)
}

theorem closed_bounded_real_set_is_compact(s: Set[Real]) {
    is_closed_set(s) and is_bounded_real_set(s) implies is_compact_real_set(s)
}

theorem empty_real_set_is_compact {
    is_compact_real_set(Set[Real].empty_set)
}

theorem singleton_real_set_is_compact(a: Real) {
    is_compact_real_set(Set[Real].singleton(a))
}

theorem closed_subset_of_compact_real_set_is_compact(s: Set[Real], t: Set[Real]) {
    s.subset(t) and is_closed_set(s) and is_compact_real_set(t) implies is_compact_real_set(s)
}

theorem intersection_of_compact_real_sets_is_compact(s: Set[Real], t: Set[Real]) {
    is_compact_real_set(s) and is_compact_real_set(t) implies is_compact_real_set(s.intersection(t))
}

theorem union_of_compact_real_sets_is_compact(s: Set[Real], t: Set[Real]) {
    is_compact_real_set(s) and is_compact_real_set(t) implies is_compact_real_set(s.union(t))
}

theorem compact_real_set_eq_closure(s: Set[Real]) {
    is_compact_real_set(s) implies s = closure(s)
}
