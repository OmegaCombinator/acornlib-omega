define is_bounded_connected_real_set(s: Set[Real]) -> Bool {
    is_bounded_real_set(s) and is_connected_real_set(s)
}

theorem bounded_connected_real_set_is_bounded(s: Set[Real]) {
    is_bounded_connected_real_set(s) implies is_bounded_real_set(s)
}

theorem bounded_connected_real_set_is_connected(s: Set[Real]) {
    is_bounded_connected_real_set(s) implies is_connected_real_set(s)
}

theorem bounded_connected_real_set_intro(s: Set[Real]) {
    is_bounded_real_set(s) and is_connected_real_set(s) implies is_bounded_connected_real_set(s)
}

theorem empty_real_set_is_bounded_connected {
    is_bounded_connected_real_set(Set[Real].empty_set)
}

theorem singleton_real_set_is_bounded_connected(a: Real) {
    is_bounded_connected_real_set(Set[Real].singleton(a))
}

theorem intersection_of_bounded_connected_real_sets_is_bounded_connected(s: Set[Real], t: Set[Real]) {
    is_bounded_connected_real_set(s) and is_bounded_connected_real_set(t)
    implies is_bounded_connected_real_set(s.intersection(t))
}

theorem compact_connected_real_set_is_bounded_connected(s: Set[Real]) {
    is_compact_real_set(s) and is_connected_real_set(s) implies is_bounded_connected_real_set(s)
}

theorem closed_interval_set_is_bounded_connected(lower: Real, upper: Real) {
    is_bounded_connected_real_set(closed_interval_set(lower, upper))
}

theorem open_interval_set_is_bounded_connected(lower: Real, upper: Real) {
    is_bounded_connected_real_set(open_interval_set(lower, upper))
}

theorem left_open_interval_set_is_bounded_connected(lower: Real, upper: Real) {
    is_bounded_connected_real_set(left_open_interval_set(lower, upper))
}

theorem right_open_interval_set_is_bounded_connected(lower: Real, upper: Real) {
    is_bounded_connected_real_set(right_open_interval_set(lower, upper))
}

theorem adherent_difference_left(s: Set[Real], t: Set[Real], x: Real) {
    is_adherent_point_of_set(s.difference(t), x) implies is_adherent_point_of_set(s, x)
}

theorem adherent_difference_not_open_right(s: Set[Real], t: Set[Real], x: Real) {
    is_open_set(t) and is_adherent_point_of_set(s.difference(t), x) implies not t.contains(x)
}

theorem difference_of_closed_and_open_is_closed(s: Set[Real], t: Set[Real]) {
    is_closed_set(s) and is_open_set(t) implies is_closed_set(s.difference(t))
}

define derived_set_contains(s: Set[Real], x: Real) -> Bool {
    is_limit_point_of_set(s, x)
}

define derived_set(s: Set[Real]) -> Set[Real] {
    Set[Real].new(derived_set_contains(s))
}

theorem derived_set_contains_eq(s: Set[Real], x: Real) {
    derived_set(s).contains(x) = is_limit_point_of_set(s, x)
}

theorem limit_point_is_adherent(s: Set[Real], x: Real) {
    is_limit_point_of_set(s, x) implies is_adherent_point_of_set(s, x)
}

theorem limit_point_in_closure(s: Set[Real], x: Real) {
    is_limit_point_of_set(s, x) implies closure(s).contains(x)
}

theorem derived_set_member_in_closure(s: Set[Real], x: Real) {
    derived_set(s).contains(x) implies closure(s).contains(x)
}

theorem derived_set_subset_closure(s: Set[Real]) {
    derived_set(s).subset(closure(s))
}

theorem closed_set_contains_limit_point(s: Set[Real], x: Real) {
    is_closed_set(s) and is_limit_point_of_set(s, x) implies s.contains(x)
}

theorem derived_set_subset_of_closed_set(s: Set[Real]) {
    is_closed_set(s) implies derived_set(s).subset(s)
}

theorem singleton_difference_subset_of_subset(s: Set[Real], t: Set[Real], x: Real) {
    s.subset(t) implies s.difference(Set[Real].singleton(x)).subset(t.difference(Set[Real].singleton(x)))
}

theorem limit_point_of_subset(s: Set[Real], t: Set[Real], x: Real) {
    s.subset(t) and is_limit_point_of_set(s, x) implies is_limit_point_of_set(t, x)
}

theorem derived_set_mono(s: Set[Real], t: Set[Real]) {
    s.subset(t) implies derived_set(s).subset(derived_set(t))
}

theorem isolated_point_not_limit_point(s: Set[Real], x: Real) {
    is_isolated_point_of_set(s, x) implies not is_limit_point_of_set(s, x)
}

theorem isolated_point_not_in_derived_set(s: Set[Real], x: Real) {
    is_isolated_point_of_set(s, x) implies not derived_set(s).contains(x)
}

theorem derived_set_member_not_isolated(s: Set[Real], x: Real) {
    derived_set(s).contains(x) implies not is_isolated_point_of_set(s, x)
}

theorem limit_point_not_isolated(s: Set[Real], x: Real) {
    is_limit_point_of_set(s, x) implies not is_isolated_point_of_set(s, x)
}

theorem isolated_point_in_derived_set_complement(s: Set[Real], x: Real) {
    is_isolated_point_of_set(s, x) implies derived_set(s).c.contains(x)
}

theorem derived_set_member_adherent_to_superset(s: Set[Real], t: Set[Real], x: Real) {
    s.subset(t) and derived_set(s).contains(x) implies is_adherent_point_of_set(t, x)
}

theorem close_of_close_le(a: Real, b: Real, eps: Real, delta: Real) {
    a.is_close(b, eps) and eps <= delta implies a.is_close(b, delta)
}

theorem union_singleton_difference_member_cases(s: Set[Real], t: Set[Real], x: Real, y: Real) {
    s.union(t).difference(Set[Real].singleton(x)).contains(y) implies
        s.difference(Set[Real].singleton(x)).contains(y) or
        t.difference(Set[Real].singleton(x)).contains(y)
}

theorem missing_eps_union_diff_of_missing_parts(
    s: Set[Real], t: Set[Real], x: Real, eps_s: Real, eps_t: Real
) {
    eps_s.is_positive and eps_t.is_positive and
    not is_eps_adherent_to_set(s.difference(Set[Real].singleton(x)), x, eps_s) and
    not is_eps_adherent_to_set(t.difference(Set[Real].singleton(x)), x, eps_t)
    implies
    not is_eps_adherent_to_set(s.union(t).difference(Set[Real].singleton(x)), x, eps_s.min(eps_t))
}

theorem limit_point_union_left(s: Set[Real], t: Set[Real], x: Real) {
    is_limit_point_of_set(s, x) implies is_limit_point_of_set(s.union(t), x)
}

theorem limit_point_union_right(s: Set[Real], t: Set[Real], x: Real) {
    is_limit_point_of_set(t, x) implies is_limit_point_of_set(s.union(t), x)
}

theorem limit_point_union_cases(s: Set[Real], t: Set[Real], x: Real) {
    is_limit_point_of_set(s.union(t), x) implies
        is_limit_point_of_set(s, x) or is_limit_point_of_set(t, x)
}

theorem derived_set_union_superset(s: Set[Real], t: Set[Real]) {
    derived_set(s).union(derived_set(t)).subset(derived_set(s.union(t)))
}

theorem derived_set_union_member_subset(s: Set[Real], t: Set[Real], x: Real) {
    derived_set(s.union(t)).contains(x) implies derived_set(s).union(derived_set(t)).contains(x)
}

theorem derived_set_union_subset(s: Set[Real], t: Set[Real]) {
    derived_set(s.union(t)).subset(derived_set(s).union(derived_set(t)))
}

theorem derived_set_union_eq(s: Set[Real], t: Set[Real]) {
    derived_set(s.union(t)) = derived_set(s).union(derived_set(t))
}

define isolated_set_contains(s: Set[Real], x: Real) -> Bool {
    is_isolated_point_of_set(s, x)
}

define isolated_set(s: Set[Real]) -> Set[Real] {
    Set[Real].new(isolated_set_contains(s))
}

theorem isolated_set_contains_eq(s: Set[Real], x: Real) {
    isolated_set(s).contains(x) = is_isolated_point_of_set(s, x)
}

theorem isolated_point_member(s: Set[Real], x: Real) {
    is_isolated_point_of_set(s, x) implies s.contains(x)
}

theorem isolated_set_member_in_set(s: Set[Real], x: Real) {
    isolated_set(s).contains(x) implies s.contains(x)
}

theorem isolated_set_subset_self(s: Set[Real]) {
    isolated_set(s).subset(s)
}

theorem isolated_point_of_subset(s: Set[Real], t: Set[Real], x: Real) {
    s.subset(t) and s.contains(x) and is_isolated_point_of_set(t, x) implies is_isolated_point_of_set(s, x)
}

theorem isolated_point_in_intersection_left(s: Set[Real], t: Set[Real], x: Real) {
    is_isolated_point_of_set(s, x) and t.contains(x)
    implies is_isolated_point_of_set(s.intersection(t), x)
}

theorem isolated_point_in_intersection_right(s: Set[Real], t: Set[Real], x: Real) {
    is_isolated_point_of_set(t, x) and s.contains(x)
    implies is_isolated_point_of_set(s.intersection(t), x)
}

theorem singleton_isolated_set_contains_self(a: Real) {
    isolated_set(Set[Real].singleton(a)).contains(a)
}

theorem isolated_set_singleton_eq_singleton(a: Real) {
    isolated_set(Set[Real].singleton(a)) = Set[Real].singleton(a)
}

theorem isolated_set_singleton_subset(a: Real) {
    isolated_set(Set[Real].singleton(a)).subset(Set[Real].singleton(a))
}

theorem singleton_subset_isolated_set_singleton(a: Real) {
    Set[Real].singleton(a).subset(isolated_set(Set[Real].singleton(a)))
}

theorem isolated_set_intersection_left_contains(s: Set[Real], t: Set[Real], x: Real) {
    isolated_set(s).contains(x) and t.contains(x) implies isolated_set(s.intersection(t)).contains(x)
}

theorem isolated_set_intersection_right_contains(s: Set[Real], t: Set[Real], x: Real) {
    isolated_set(t).contains(x) and s.contains(x) implies isolated_set(s.intersection(t)).contains(x)
}

define is_perfect_real_set(s: Set[Real]) -> Bool {
    is_closed_set(s) and s.subset(derived_set(s))
}

theorem perfect_real_set_is_closed(s: Set[Real]) {
    is_perfect_real_set(s) implies is_closed_set(s)
}

theorem perfect_real_set_subset_derived_set(s: Set[Real]) {
    is_perfect_real_set(s) implies s.subset(derived_set(s))
}

theorem perfect_real_set_intro(s: Set[Real]) {
    is_closed_set(s) and s.subset(derived_set(s)) implies is_perfect_real_set(s)
}

theorem perfect_real_set_derived_set_subset(s: Set[Real]) {
    is_perfect_real_set(s) implies derived_set(s).subset(s)
}

theorem perfect_real_set_eq_derived_set(s: Set[Real]) {
    is_perfect_real_set(s) implies s = derived_set(s)
}

theorem derived_set_of_perfect_real_set_eq_self(s: Set[Real]) {
    is_perfect_real_set(s) implies derived_set(s) = s
}

theorem perfect_real_set_member_not_isolated(s: Set[Real], x: Real) {
    is_perfect_real_set(s) and s.contains(x) implies not is_isolated_point_of_set(s, x)
}

theorem perfect_real_set_no_isolated_set_members(s: Set[Real], x: Real) {
    is_perfect_real_set(s) implies not isolated_set(s).contains(x)
}

theorem perfect_real_set_isolated_set_is_empty(s: Set[Real]) {
    is_perfect_real_set(s) implies isolated_set(s).is_empty
}

theorem perfect_real_set_isolated_set_eq_empty(s: Set[Real]) {
    is_perfect_real_set(s) implies isolated_set(s) = Set[Real].empty_set
}

theorem isolated_set_member_not_in_derived_set(s: Set[Real], x: Real) {
    isolated_set(s).contains(x) implies not derived_set(s).contains(x)
}

theorem derived_set_member_not_in_isolated_set(s: Set[Real], x: Real) {
    derived_set(s).contains(x) implies not isolated_set(s).contains(x)
}

theorem isolated_set_subset_derived_set_complement(s: Set[Real]) {
    isolated_set(s).subset(derived_set(s).c)
}

theorem derived_set_subset_isolated_set_complement(s: Set[Real]) {
    derived_set(s).subset(isolated_set(s).c)
}

theorem isolated_set_disjoint_derived_set(s: Set[Real]) {
    isolated_set(s).is_disjoint(derived_set(s))
}

theorem derived_set_disjoint_isolated_set(s: Set[Real]) {
    derived_set(s).is_disjoint(isolated_set(s))
}

theorem isolated_set_intersection_derived_set_eq_empty(s: Set[Real]) {
    isolated_set(s).intersection(derived_set(s)) = Set[Real].empty_set
}

theorem derived_set_intersection_isolated_set_eq_empty(s: Set[Real]) {
    derived_set(s).intersection(isolated_set(s)) = Set[Real].empty_set
}

theorem empty_real_set_is_perfect {
    is_perfect_real_set(Set[Real].empty_set)
}

theorem closed_set_with_subset_derived_set_is_perfect(s: Set[Real]) {
    is_closed_set(s) and s.subset(derived_set(s)) implies is_perfect_real_set(s)
}

theorem member_not_in_derived_set_is_isolated_point(s: Set[Real], x: Real) {
    s.contains(x) and not derived_set(s).contains(x) implies is_isolated_point_of_set(s, x)
}

theorem member_not_in_derived_set_is_isolated_set_member(s: Set[Real], x: Real) {
    s.contains(x) and not derived_set(s).contains(x) implies isolated_set(s).contains(x)
}
