theorem abs_abs(a: Real) {
    a.abs.abs = a.abs
}

theorem abs_close_of_close(a: Real, b: Real, eps: Real) {
    a.is_close(b, eps) implies a.abs.is_close(b.abs, eps)
}

theorem limit_abs_seq(a: Nat -> Real) {
    converges(a) implies converges_to(abs_seq(a), limit(a).abs)
}

theorem same_limit_add_seq(a: Nat -> Real, b: Nat -> Real, c: Nat -> Real, d: Nat -> Real) {
    same_limit(a, b) and same_limit(c, d)
    implies same_limit(add_seq(a, c), add_seq(b, d))
}

theorem same_limit_prod_seq(a: Nat -> Real, b: Nat -> Real, c: Nat -> Real, d: Nat -> Real) {
    same_limit(a, b) and same_limit(c, d)
    implies same_limit(prod_seq(a, c), prod_seq(b, d))
}

theorem same_limit_abs_seq(a: Nat -> Real, b: Nat -> Real) {
    same_limit(a, b) implies same_limit(abs_seq(a), abs_seq(b))
}

theorem vanishes_abs_seq(a: Nat -> Real) {
    vanishes(a) implies vanishes(abs_seq(a))
}

theorem vanishes_of_abs_lte_abs(a: Nat -> Real, b: Nat -> Real) {
    seq_lte(abs_seq(a), abs_seq(b)) and vanishes(b)
    implies vanishes(a)
}

theorem same_limit_add_vanish_right(a: Nat -> Real, b: Nat -> Real) {
    converges(a) and vanishes(b)
    implies same_limit(add_seq(a, b), a)
}

theorem vanishes_prod_seq(a: Nat -> Real, b: Nat -> Real) {
    converges(a) and vanishes(b)
    implies vanishes(prod_seq(a, b))
}

theorem same_limit_imp_vanishes(a: Nat -> Real, b: Nat -> Real) {
    same_limit(a, b) implies vanishes(add_seq(a, neg_seq(b)))
}

theorem vanishes_squeeze(a: Nat -> Real, b: Nat -> Real) {
    seq_lte(const_seq(Real.0), a) and seq_lte(a, b) and vanishes(b)
    implies vanishes(a)
}

theorem squeeze_theorem(a: Nat -> Real, b: Nat -> Real, c: Nat -> Real) {
    seq_lte(a, b) and seq_lte(b, c) and same_limit(a, c)
    implies same_limit(a, b)
}

define tends_to_infinity(f: Nat -> Nat) -> Bool {
    forall(big_n: Nat) {
        exists(m: Nat) {
            forall(n: Nat) {
                m <= n implies big_n <= f(n)
            }
        }
    }
}

define is_nondecreasing_nat(f: Nat -> Nat) -> Bool {
    forall(i: Nat, j: Nat) {
        i <= j implies f(i) <= f(j)
    }
}

theorem monotone_is_nondecreasing_nat(f: Nat -> Nat) {
    is_monotone(f) implies is_nondecreasing_nat(f)
}

define is_unbounded(f: Nat -> Nat) -> Bool {
    forall(bound: Nat) {
        exists(n: Nat) {
            bound < f(n)
        }
    }
}

theorem nondecreasing_unbounded_tends_to_infinity(f: Nat -> Nat) {
    is_nondecreasing_nat(f) and is_unbounded(f)
    implies
    tends_to_infinity(f)
}

theorem monotone_unbounded_tends_to_infinity(f: Nat -> Nat) {
    is_monotone(f) and is_unbounded(f)
    implies
    tends_to_infinity(f)
}

theorem converges_compose_tends_to_infinity(a: Nat -> Real, f: Nat -> Nat) {
    converges(a) and tends_to_infinity(f)
    implies
    converges_to(compose(a, f), limit(a))
}

theorem converges_compose_nondecreasing_unbounded(a: Nat -> Real, f: Nat -> Nat) {
    converges(a) and is_nondecreasing_nat(f) and is_unbounded(f)
    implies
    converges_to(compose(a, f), limit(a))
}

theorem converges_compose_monotone_unbounded(a: Nat -> Real, f: Nat -> Nat) {
    converges(a) and is_monotone(f) and is_unbounded(f)
    implies
    converges_to(compose(a, f), limit(a))
}

define is_subsequence_index(f: Nat -> Nat) -> Bool {
    is_monotone(f) and is_unbounded(f)
}

define subsequence(a: Nat -> Real, f: Nat -> Nat, n: Nat) -> Real {
    compose(a, f)(n)
}

theorem subsequence_index_is_monotone(f: Nat -> Nat) {
    is_subsequence_index(f) implies is_monotone(f)
}

theorem subsequence_index_is_unbounded(f: Nat -> Nat) {
    is_subsequence_index(f) implies is_unbounded(f)
}

theorem subsequence_index_of_monotone_unbounded(f: Nat -> Nat) {
    is_monotone(f) and is_unbounded(f) implies is_subsequence_index(f)
}

theorem subsequence_index_tends_to_infinity(f: Nat -> Nat) {
    is_subsequence_index(f) implies tends_to_infinity(f)
}

theorem subsequence_eq_compose(a: Nat -> Real, f: Nat -> Nat) {
    subsequence(a, f) = compose(a, f)
}

theorem converges_subsequence(a: Nat -> Real, f: Nat -> Nat) {
    converges(a) and is_subsequence_index(f)
    implies
    converges_to(subsequence(a, f), limit(a))
}

theorem subsequence_converges(a: Nat -> Real, f: Nat -> Nat) {
    converges(a) and is_subsequence_index(f)
    implies
    converges(subsequence(a, f))
}

theorem limit_subsequence(a: Nat -> Real, f: Nat -> Nat) {
    converges(a) and is_subsequence_index(f)
    implies
    limit(subsequence(a, f)) = limit(a)
}

theorem subsequence_same_limit_left(a: Nat -> Real, f: Nat -> Nat) {
    converges(a) and is_subsequence_index(f)
    implies
    same_limit(subsequence(a, f), a)
}

theorem subsequence_same_limit_right(a: Nat -> Real, f: Nat -> Nat) {
    converges(a) and is_subsequence_index(f)
    implies
    same_limit(a, subsequence(a, f))
}

theorem mul_nondecreasing(k: Nat) {
    Nat.1 <= k implies is_nondecreasing_nat(k.mul)
}

theorem mul_monotone(k: Nat) {
    Nat.1 <= k implies is_monotone(k.mul)
}

theorem mul_unbounded(k: Nat) {
    Nat.1 <= k implies is_unbounded(k.mul)
}

theorem add_nondecreasing(k: Nat) {
    is_nondecreasing_nat(k.add)
}

theorem add_monotone(k: Nat) {
    is_monotone(k.add)
}

theorem add_unbounded(k: Nat) {
    is_unbounded(k.add)
}

theorem mul_subsequence_index(k: Nat) {
    Nat.1 <= k implies is_subsequence_index(k.mul)
}

theorem add_subsequence_index(k: Nat) {
    is_subsequence_index(k.add)
}

theorem double_subsequence_index {
    is_subsequence_index(Nat.2.mul)
}

theorem suc_subsequence_index {
    is_subsequence_index(Nat.suc)
}

theorem converges_compose_mul(a: Nat -> Real, k: Nat) {
    converges(a) and Nat.1 <= k
    implies
    converges_to(compose(a, k.mul), limit(a))
}

theorem converges_compose_add(a: Nat -> Real, k: Nat) {
    converges(a)
    implies
    converges_to(compose(a, k.add), limit(a))
}

theorem converges_compose_double(a: Nat -> Real) {
    converges(a)
    implies
    converges_to(compose(a, Nat.2.mul), limit(a))
}

theorem converges_compose_suc(a: Nat -> Real) {
    converges(a)
    implies
    converges_to(compose(a, Nat.suc), limit(a))
}

theorem converges_subsequence_mul(a: Nat -> Real, k: Nat) {
    converges(a) and Nat.1 <= k
    implies
    converges_to(subsequence(a, k.mul), limit(a))
}

theorem converges_subsequence_add(a: Nat -> Real, k: Nat) {
    converges(a)
    implies
    converges_to(subsequence(a, k.add), limit(a))
}

theorem converges_subsequence_double(a: Nat -> Real) {
    converges(a)
    implies
    converges_to(subsequence(a, Nat.2.mul), limit(a))
}

theorem converges_subsequence_suc(a: Nat -> Real) {
    converges(a)
    implies
    converges_to(subsequence(a, Nat.suc), limit(a))
}

theorem subsequence_converges_to_limit(a: Nat -> Real, f: Nat -> Nat) {
    converges(a) and is_subsequence_index(f)
    implies
    converges_to(subsequence(a, f), limit(a))
}

theorem subsequence_of_convergent_converges(a: Nat -> Real, f: Nat -> Nat) {
    converges(a) and is_subsequence_index(f)
    implies
    converges(subsequence(a, f))
}

theorem subsequence_limit_eq_original(a: Nat -> Real, f: Nat -> Nat) {
    converges(a) and is_subsequence_index(f)
    implies
    limit(subsequence(a, f)) = limit(a)
}

theorem abs_of_vanishing_vanishes(a: Nat -> Real) {
    vanishes(a) implies vanishes(abs_seq(a))
}

theorem vanishes_by_squeeze(a: Nat -> Real, b: Nat -> Real) {
    seq_lte(const_seq(Real.0), a) and seq_lte(a, b) and vanishes(b)
    implies vanishes(a)
}

theorem vanishes_by_abs_domination(a: Nat -> Real, b: Nat -> Real) {
    seq_lte(abs_seq(a), abs_seq(b)) and vanishes(b)
    implies vanishes(a)
}

theorem same_limit_add_vanishing(a: Nat -> Real, b: Nat -> Real) {
    converges(a) and vanishes(b)
    implies same_limit(add_seq(a, b), a)
}

define abs_fn(a: Nat -> Real) -> (Nat -> Real) {
    function(n: Nat) { a(n).abs }
}

define filter_seq(f: Nat -> Real, p: Nat -> Bool, n: Nat) -> Real {
    if p(n) { f(n) } else { Real.0 }
}

define mask(f: Nat -> Real, s: Set[Nat], n: Nat) -> Real {
    filter_seq(f, s.contains, n)
}

define mask_seq_sum(a: Nat -> Real, s: Nat -> Set[Nat], i: Nat) -> Real {
    limit(partial(mask(a, s(i))))
}

define absolutely_converges(a: Nat -> Real) -> Bool {
    converges(partial(abs_fn(a)))
}

theorem abs_fn_zero(n: Nat) {
    abs_fn(constant[Nat, Real](Real.0))(n) = Real.0
}

theorem abs_fn_nonneg(a: Nat -> Real, n: Nat) {
    abs_fn(a)(n) >= Real.0
}

theorem abs_fn_scalar_mul(c: Real, a: Nat -> Real, n: Nat) {
    abs_fn(mul_fn(c, a))(n) = c.abs * abs_fn(a)(n)
}

theorem abs_fn_eq_compose(a: Nat -> Real, n: Nat) {
    abs_fn(a)(n) = compose(Real.abs, a)(n)
}

theorem abs_fn_prod_seq(a: Nat -> Real, b: Nat -> Real, n: Nat) {
    abs_fn(prod_seq(a, b))(n) = abs_fn(a)(n) * abs_fn(b)(n)
}

define partial_diff(f: Nat -> Real, m: Nat, n: Nat) -> Real {
    partial(f, n) - partial(f, m)
}

define tail_limit_diff(f: Nat -> Real, m: Nat) -> Real {
    limit(partial(f)) - partial(f, m)
}

define sub_seq(s: Nat -> Real, t: Nat -> Real, n: Nat) -> Real {
    s(n) - t(n)
}

define abs_diff_seq(s: Nat -> Real, t: Nat -> Real, n: Nat) -> Real {
    sub_seq(s, t, n).abs
}

define vanishing_diff(s: Nat -> Real, t: Nat -> Real) -> Bool {
    vanishes(abs_diff_seq(s, t))
}

theorem vanishes_of_abs_seq(a: Nat -> Real) {
    vanishes(abs_seq(a))
    implies
    vanishes(a)
}

theorem vanishes_neg_seq(a: Nat -> Real) {
    vanishes(a)
    implies
    vanishes(neg_seq(a))
}

theorem vanishes_congr_left(a: Nat -> Real, b: Nat -> Real) {
    a = b and vanishes(b)
    implies
    vanishes(a)
}

theorem neg_seq_sub_seq_eq(s: Nat -> Real, t: Nat -> Real) {
    neg_seq(sub_seq(s, t)) = sub_seq(t, s)
}

theorem abs_seq_sub_seq_eq_abs_diff_left(s: Nat -> Real, t: Nat -> Real) {
    abs_seq(sub_seq(s, t)) = abs_diff_seq(s, t)
}

theorem abs_seq_sub_seq_eq_abs_diff_right(s: Nat -> Real, t: Nat -> Real) {
    abs_seq(sub_seq(t, s)) = abs_diff_seq(s, t)
}

theorem vanishing_diff_abs_eq(s: Nat -> Real, t: Nat -> Real) {
    vanishing_diff(s, t)
    implies
    vanishes(sub_seq(t, s))
}

theorem limit_preserved_by_vanishing_diff(s: Nat -> Real, t: Nat -> Real) {
    converges(s) and vanishing_diff(s, t)
    implies
    converges(t) and limit(s) = limit(t)
}

theorem absolutely_converges_imp_converges(a: Nat -> Real) {
    absolutely_converges(a) implies converges(partial(a))
}

theorem absolutely_converges_scalar_mul(c: Real, a: Nat -> Real) {
    absolutely_converges(a) implies absolutely_converges(mul_fn(c, a))
}

theorem absolutely_converges_mul_bounded(a: Nat -> Real, b: Nat -> Real) {
    absolutely_converges(a)
    and has_upper_bound_seq(abs_fn(b))
    implies
    absolutely_converges(prod_seq(a, b))
}

theorem absolutely_converges_add(a: Nat -> Real, b: Nat -> Real) {
    absolutely_converges(a) and absolutely_converges(b)
    implies
    absolutely_converges(add_fn(a, b))
}

theorem absolutely_converges_filter_seq(a: Nat -> Real, p: Nat -> Bool) {
    absolutely_converges(a)
    implies
    absolutely_converges(filter_seq(a, p))
}

theorem absolutely_converges_mask(a: Nat -> Real, s: Set[Nat]) {
    absolutely_converges(a)
    implies
    absolutely_converges(mask(a, s))
}

theorem absolutely_converges_comparison(a: Nat -> Real, b: Nat -> Real) {
    is_lower_bound(b, Real.0)
    and seq_lte(abs_fn(a), b)
    and converges(partial(b))
    implies
    absolutely_converges(a)
}

theorem tail_diff_converges(a: Nat -> Real, m: Nat) {
    absolutely_converges(a)
    implies
    converges_to(partial_diff(abs_fn(a), m), tail_limit_diff(abs_fn(a), m))
}

theorem abs_conv_tail_bound(a: Nat -> Real, eps: Real) {
    absolutely_converges(a) and eps.is_positive
    implies
    exists(big_n: Nat) {
        forall(n: Nat, m: Nat) {
            big_n <= n and n <= m
            implies
            partial(abs_fn(a), m) - partial(abs_fn(a), n) < eps
        }
    }
}

theorem abs_conv_tail_sum_small(a: Nat -> Real, eps: Real) {
    absolutely_converges(a) and eps.is_positive
    implies
    exists(big_n: Nat) {
        tail_limit_diff(abs_fn(a), big_n) < eps
    }
}

theorem abs_fn_tail_comm(a: Nat -> Real, n: Nat) {
    abs_fn(tail(a, n)) = tail(abs_fn(a), n)
}

theorem abs_conv_tail_imp_abs_conv(a: Nat -> Real, n: Nat) {
    absolutely_converges(tail(a, n)) implies absolutely_converges(a)
}

theorem mask_disjoint_add(f: Nat -> Real, s1: Set[Nat], s2: Set[Nat], u: Set[Nat]) {
    s1.is_disjoint(s2) and u = s1.union(s2)
    implies
    add_fn(mask(f, s1), mask(f, s2)) = mask(f, u)
}

theorem mask_disjoint_union_sum(f: Nat -> Real, s1: Set[Nat], s2: Set[Nat], u: Set[Nat]) {
    absolutely_converges(f) and s1.is_disjoint(s2) and u = s1.union(s2)
    implies
    limit(partial(mask(f, u))) = limit(partial(mask(f, s1))) + limit(partial(mask(f, s2)))
}

theorem abs_fn_mask(f: Nat -> Real, s: Set[Nat]) {
    abs_fn(mask(f, s)) = mask(abs_fn(f), s)
}

theorem mask_abs_sum_superset(f: Nat -> Real, s1: Set[Nat], s2: Set[Nat]) {
    absolutely_converges(f) and s1.superset(s2)
    implies
    limit(partial(mask(abs_fn(f), s1))) >= limit(partial(mask(abs_fn(f), s2)))
}

theorem mask_abs_sum_subset(f: Nat -> Real, s1: Set[Nat], s2: Set[Nat]) {
    absolutely_converges(f) and s1.subset(s2)
    implies
    limit(partial(mask(abs_fn(f), s1))) <= limit(partial(mask(abs_fn(f), s2)))
}

theorem partial_mask_from_eq(a: Nat -> Real, n: Nat, m: Nat) {
    n <= m
    implies
    partial(mask(a, nat_from(n)), m) = partial(a, m) - partial(a, n)
}

theorem mask_from_eq_tail(a: Nat -> Real, n: Nat) {
    absolutely_converges(a)
    implies
    limit(partial(mask(abs_fn(a), nat_from(n)))) = tail_limit_diff(abs_fn(a), n)
}

theorem mask_bounded_by_tail(a: Nat -> Real, s: Set[Nat], n: Nat) {
    absolutely_converges(a) and set_lower_bound(s, n)
    implies
    limit(partial(mask(abs_fn(a), s))) <= tail_limit_diff(abs_fn(a), n)
}

theorem map_compose_helper(f: Nat -> Real, n: Nat) {
    map(map(n.range, f), Real.abs) = map(n.range, compose(Real.abs, f))
}

theorem partial_abs_fn_eq(a: Nat -> Real, n: Nat) {
    partial(abs_fn(a), n) = sum(map(map(n.range, a), Real.abs))
}

theorem abs_limit_le_abs_series(a: Nat -> Real) {
    absolutely_converges(a)
    implies
    limit(partial(a)).abs <= limit(partial(abs_fn(a)))
}

theorem decreasing_empty_intersection_mask_vanishes(a: Nat -> Real, s: Nat -> Set[Nat]) {
    absolutely_converges(a)
    and is_decreasing(s)
    and seq_intersection(s).is_empty
    implies
    vanishes(mask_seq_sum(a, s))
}

theorem increasing_universal_union_mask_limit(a: Nat -> Real, s: Nat -> Set[Nat]) {
    absolutely_converges(a)
    and is_increasing(s)
    and seq_union(s) = Set[Nat].universal_set
    implies
    converges_to(mask_seq_sum(a, s), limit(partial(a)))
}

theorem mask_singleton_zero_after(a: Nat -> Real, n: Nat, m: Nat) {
    n < m
    implies
    mask(a, Set[Nat].singleton(n), m) = Real.0
}

define point_mass(a: Nat -> Real, n: Nat, i: Nat) -> Real {
    if i = n { a(n) } else { Real.0 }
}

theorem partial_point_mass(a: Nat -> Real, n: Nat) {
    partial(point_mass(a, n), n.suc) = a(n)
}

theorem mask_singleton_eq_point_mass(a: Nat -> Real, n: Nat, i: Nat) {
    mask(a, Set[Nat].singleton(n), i) = point_mass(a, n, i)
}

theorem mask_singleton_base_case(a: Nat -> Real, n: Nat) {
    partial(mask(a, Set[Nat].singleton(n)), n.suc) = a(n)
}

theorem mask_singleton_eventually_constant(a: Nat -> Real, n: Nat, m: Nat) {
    n.suc <= m
    implies
    partial(mask(a, Set[Nat].singleton(n)), m) = a(n)
}

theorem mask_singleton_limit(a: Nat -> Real, n: Nat) {
    limit(partial(mask(a, Set[Nat].singleton(n)))) = a(n)
}

theorem partial_constant_zero(n: Nat) {
    partial(constant[Nat, Real](Real.0), n) = Real.0
}

theorem partial_constant_zero_is_constant {
    partial(constant[Nat, Real](Real.0)) = constant[Nat, Real](Real.0)
}

theorem partial_compose_eq_mask_sum(a: Nat -> Real, p: Nat -> Nat, k: Nat) {
    absolutely_converges(a) and is_injective(p)
    implies
    partial(compose(a, p), k) = limit(partial(mask(a, image_of_range(p, k))))
}

theorem riemann_rearrangement_absolutely_converges(a: Nat -> Real, p: Nat -> Nat) {
    absolutely_converges(a) and is_bijection(p)
    implies
    absolutely_converges(compose(a, p))
}

theorem riemann_rearrangement_theorem(a: Nat -> Real, p: Nat -> Nat) {
    absolutely_converges(a) and is_bijection(p)
    implies
    converges_to(partial(compose(a, p)), limit(partial(a)))
}

define recip_rat_seq(a: Nat -> Rat, n: Nat) -> Rat {
    a(n).inverse
}

theorem neg_recip_rat_seq(a: Nat -> Rat) {
    neg_rat_seq(recip_rat_seq(a)) = recip_rat_seq(neg_rat_seq(a))
}

theorem recip_rat_seq_pos_converges(a: Nat -> Rat, b: Real) {
    converges_to(lift_seq(a), b) and b.is_positive
    implies converges(lift_seq(recip_rat_seq(a)))
}

theorem recip_rat_seq_converges(a: Nat -> Rat, b: Real) {
    converges_to(lift_seq(a), b) and b != Real.0
    implies converges(lift_seq(recip_rat_seq(a)))
}

define eventually_nonzero(a: Nat -> Real) -> Bool {
    exists(n: Nat) {
        forall(i: Nat) {
            n <= i implies a(i) != Real.0
        }
    }
}

theorem pos_imp_eventually_nonzero(a: Nat -> Real) {
    converges(a) and limit(a).is_positive
    implies eventually_nonzero(a)
}

theorem nonzero_imp_eventually_nonzero(a: Nat -> Real) {
    converges(a) and limit(a) != Real.0
    implies eventually_nonzero(a)
}

theorem mul_inverse(a: Real) {
    a != Real.0 implies a * a.inverse = Real.1
}

theorem zero_inverse {
    Real.0.inverse = Real.0
}

theorem zero_is_different_than_one {
    Real.0 != Real.1
}

theorem mul_left_cancel(a: Real, b: Real, c: Real) {
    a = b * c and b != Real.0 implies a / b = c
}

theorem div_le_of_mul_le(a: Real, b: Real, c: Real) {
    a * b <= c and b > Real.0
    implies
    a <= c / b
}

theorem mul_le_mul_pos_right(a: Real, b: Real, c: Real) {
    a <= b and c > Real.0
    implies
    a * c <= b * c
}

theorem mul_le_mul_pos_left(a: Real, b: Real, c: Real) {
    a <= b and c > Real.0
    implies
    c * a <= c * b
}

theorem div_lt_mul_pos(a: Real, b: Real, c: Real) {
    a / b < c and b > Real.0
    implies
    a < b * c
}

theorem mul_div_cancel(b: Real, c: Real) {
    c != Real.0
    implies
    c * (b / c) = b
}

theorem mul_inverse_comm(a: Real, b: Real, c: Real) {
    a * (b * c) = b * (a * c)
}

theorem div_mul_cancel_right(a: Real, b: Real) {
    a != Real.0 and b != Real.0
    implies
    a / (b * a) = Real.1 / b
}

theorem div_mul_cancel_left(a: Real, b: Real) {
    a != Real.0
    implies
    (a * b) / a = b
}

theorem div_cancel_common(a: Real, b: Real, c: Real) {
    b != Real.0 and c != Real.0
    implies
    (a * b) / (c * b) = a / c
}

theorem prod_eq_to_div_eq(a: Real, b: Real, c: Real, d: Real) {
    a * b = c * d and b != Real.0 and d != Real.0
    implies
    a / d = c / b
}

theorem inverse_div(a: Real, b: Real) {
    a != Real.0 and b != Real.0
    implies
    (a / b).inverse = b / a
}

theorem mul_div(a: Real, b: Real, c: Real, d: Real) {
    b != Real.0 and d != Real.0
    implies
    (a / b) * (c / d) = (a * c) / (b * d)
}

theorem div_by_fraction(a: Real, b: Real, c: Real, d: Real) {
    c != Real.0 and d != Real.0
    implies
    (a / b) / (c / d) = (a / b) * (d / c)
}

theorem div_div(a: Real, b: Real, c: Real, d: Real) {
    b != Real.0 and c != Real.0 and d != Real.0
    implies
    (a / b) / (c / d) = (a * d) / (b * c)
}

theorem geom_series(r: Real) {
    r.abs < 1 implies
    limit(partial(r.pow)) = 1 / (1 - r)
}

define nat_to_real(n: Nat) -> Real {
    match n {
        Nat.zero {
            Real.0
        }
        Nat.suc(pred) {
            nat_to_real(pred) + Real.1
        }
    }
}

define nonneg_fn_2(f: (Nat, Nat) -> Real) -> Bool {
    forall(i: Nat, j: Nat) {
        f(i, j) >= Real.0
    }
}

define is_upper_bound_fn_2(f: (Nat, Nat) -> Real, bound: Real) -> Bool {
    forall(i: Nat, j: Nat) {
        f(i, j) <= bound
    }
}

define is_lower_bound_fn_2(f: (Nat, Nat) -> Real, bound: Real) -> Bool {
    forall(i: Nat, j: Nat) {
        f(i, j) >= bound
    }
}

define lte_fn_2(f: (Nat, Nat) -> Real, g: (Nat, Nat) -> Real) -> Bool {
    forall(i: Nat, j: Nat) {
        f(i, j) <= g(i, j)
    }
}

define const_fn_2(c: Real, i: Nat, j: Nat) -> Real {
    c
}

define add_fn_2(f: (Nat, Nat) -> Real, g: (Nat, Nat) -> Real, i: Nat, j: Nat) -> Real {
    f(i, j) + g(i, j)
}

define sub_fn_2(f: (Nat, Nat) -> Real, g: (Nat, Nat) -> Real, i: Nat, j: Nat) -> Real {
    f(i, j) - g(i, j)
}

define scalar_mul_fn_2(c: Real, f: (Nat, Nat) -> Real, i: Nat, j: Nat) -> Real {
    c * f(i, j)
}

define shift_rows(f: (Nat, Nat) -> Real, offset: Nat, i: Nat, j: Nat) -> Real {
    f(offset + i, j)
}

define shift_cols(f: (Nat, Nat) -> Real, offset: Nat, i: Nat, j: Nat) -> Real {
    f(i, offset + j)
}

define row_sum(f: (Nat, Nat) -> Real, m: Nat, i: Nat) -> Real {
    partial(f(i), m)
}

define col_sum(f: (Nat, Nat) -> Real, n: Nat, j: Nat) -> Real {
    partial(flip(f, j), n)
}

define rectangular_sum(f: (Nat, Nat) -> Real, m: Nat, n: Nat) -> Real {
    partial(row_sum(f, n), m)
}

define rectangular_sum_col_first(f: (Nat, Nat) -> Real, m: Nat, n: Nat) -> Real {
    partial(col_sum(f, m), n)
}

define rectangular_sum_by_rows(f: (Nat, Nat) -> Real, n: Nat, m: Nat) -> Real {
    rectangular_sum(f, m, n)
}

define rectangular_sum_by_cols(f: (Nat, Nat) -> Real, m: Nat, n: Nat) -> Real {
    rectangular_sum(f, m, n)
}

theorem rectangular_sum_zero_rows(f: (Nat, Nat) -> Real, n: Nat) {
    rectangular_sum(f, Nat.0, n) = Real.0
}

theorem rectangular_sum_zero_cols(f: (Nat, Nat) -> Real, m: Nat) {
    rectangular_sum(f, m, Nat.0) = Real.0
}

theorem rectangular_fubini(f: (Nat, Nat) -> Real, m: Nat, n: Nat) {
    rectangular_sum(f, m, n) = rectangular_sum_col_first(f, m, n)
}

theorem rectangular_sum_nonneg(f: (Nat, Nat) -> Real, m: Nat, n: Nat) {
    nonneg_fn_2(f)
    implies
    rectangular_sum(f, m, n) >= Real.0
}

theorem rectangular_sum_monotone(f: (Nat, Nat) -> Real, g: (Nat, Nat) -> Real, m: Nat, n: Nat) {
    lte_fn_2(f, g)
    implies
    rectangular_sum(f, m, n) <= rectangular_sum(g, m, n)
}

theorem rectangular_sum_add(f: (Nat, Nat) -> Real, g: (Nat, Nat) -> Real, m: Nat, n: Nat) {
    rectangular_sum(add_fn_2(f, g), m, n)
    =
    rectangular_sum(f, m, n) + rectangular_sum(g, m, n)
}

theorem rectangular_sum_scale(c: Real, f: (Nat, Nat) -> Real, m: Nat, n: Nat) {
    rectangular_sum(scalar_mul_fn_2(c, f), m, n)
    =
    c * rectangular_sum(f, m, n)
}

theorem row_sum_const_one(n: Nat, i: Nat) {
    row_sum(const_fn_2(Real.1), n, i) = nat_to_real(n)
}

theorem rectangular_sum_const_one(m: Nat, n: Nat) {
    rectangular_sum(const_fn_2(Real.1), m, n) = nat_to_real(m) * nat_to_real(n)
}

theorem rectangular_sum_const(c: Real, m: Nat, n: Nat) {
    rectangular_sum(const_fn_2(c), m, n) = nat_to_real(m) * nat_to_real(n) * c
}

theorem rectangular_sum_upper_bound(f: (Nat, Nat) -> Real, bound: Real, m: Nat, n: Nat) {
    nonneg_fn_2(f) and is_upper_bound_fn_2(f, bound)
    implies
    rectangular_sum(f, m, n) <= nat_to_real(m) * nat_to_real(n) * bound
}

theorem rectangular_sum_lower_bound(f: (Nat, Nat) -> Real, bound: Real, m: Nat, n: Nat) {
    is_lower_bound_fn_2(f, bound)
    implies
    rectangular_sum(f, m, n) >= nat_to_real(m) * nat_to_real(n) * bound
}

theorem rectangular_sum_sub(f: (Nat, Nat) -> Real, g: (Nat, Nat) -> Real, m: Nat, n: Nat) {
    rectangular_sum(sub_fn_2(f, g), m, n)
    =
    rectangular_sum(f, m, n) - rectangular_sum(g, m, n)
}

theorem rectangular_sum_extend_row(f: (Nat, Nat) -> Real, m: Nat, n: Nat) {
    rectangular_sum(f, m.suc, n) = rectangular_sum(f, m, n) + row_sum(f, n, m)
}

theorem rectangular_sum_extend_col(f: (Nat, Nat) -> Real, m: Nat, n: Nat) {
    rectangular_sum(f, m, n.suc) = rectangular_sum(f, m, n) + col_sum(f, m, n)
}

theorem rectangular_sum_increasing_rows(f: (Nat, Nat) -> Real, m: Nat, n: Nat) {
    nonneg_fn_2(f)
    implies
    rectangular_sum(f, m, n) <= rectangular_sum(f, m.suc, n)
}

theorem rectangular_sum_rows_increasing(f: (Nat, Nat) -> Real, n: Nat) {
    nonneg_fn_2(f)
    implies
    is_increasing(rectangular_sum_by_rows(f, n))
}

theorem rectangular_sum_rows_monotone(f: (Nat, Nat) -> Real, n: Nat) {
    nonneg_fn_2(f)
    implies
    is_monotone(rectangular_sum_by_rows(f, n))
}

theorem rectangular_sum_increasing_cols(f: (Nat, Nat) -> Real, m: Nat, n: Nat) {
    nonneg_fn_2(f)
    implies
    rectangular_sum(f, m, n) <= rectangular_sum(f, m, n.suc)
}

theorem rectangular_sum_cols_increasing(f: (Nat, Nat) -> Real, m: Nat) {
    nonneg_fn_2(f)
    implies
    is_increasing(rectangular_sum_by_cols(f, m))
}

theorem rectangular_sum_cols_monotone(f: (Nat, Nat) -> Real, m: Nat) {
    nonneg_fn_2(f)
    implies
    is_monotone(rectangular_sum_by_cols(f, m))
}

define product_sum(a: Nat -> Real, b: Nat -> Real, m: Nat, n: Nat) -> Real {
    rectangular_sum(prod_fn(a, b), m, n)
}

theorem product_sum_factors(a: Nat -> Real, b: Nat -> Real, m: Nat, n: Nat) {
    product_sum(a, b, m, n) = partial(a, m) * partial(b, n)
}

theorem rectangular_sum_split_rows(f: (Nat, Nat) -> Real, m1: Nat, m2: Nat, n: Nat) {
    rectangular_sum(f, m1 + m2, n)
    =
    rectangular_sum(f, m1, n) + rectangular_sum(shift_rows(f, m1), m2, n)
}

theorem rectangular_sum_split_cols(f: (Nat, Nat) -> Real, m: Nat, n1: Nat, n2: Nat) {
    rectangular_sum(f, m, n1 + n2)
    =
    rectangular_sum(f, m, n1) + rectangular_sum(shift_cols(f, n1), m, n2)
}

theorem shift_rows_compose(f: (Nat, Nat) -> Real, k1: Nat, k2: Nat, i: Nat, j: Nat) {
    shift_rows(shift_rows(f, k1), k2, i, j) = shift_rows(f, k1 + k2, i, j)
}

theorem shift_cols_compose(f: (Nat, Nat) -> Real, k1: Nat, k2: Nat, i: Nat, j: Nat) {
    shift_cols(shift_cols(f, k1), k2, i, j) = shift_cols(f, k1 + k2, i, j)
}

theorem shift_rows_add(f: (Nat, Nat) -> Real, g: (Nat, Nat) -> Real, k: Nat, i: Nat, j: Nat) {
    shift_rows(add_fn_2(f, g), k, i, j) = add_fn_2(shift_rows(f, k), shift_rows(g, k), i, j)
}

theorem shift_cols_add(f: (Nat, Nat) -> Real, g: (Nat, Nat) -> Real, k: Nat, i: Nat, j: Nat) {
    shift_cols(add_fn_2(f, g), k, i, j) = add_fn_2(shift_cols(f, k), shift_cols(g, k), i, j)
}

theorem shift_rows_scale(c: Real, f: (Nat, Nat) -> Real, k: Nat, i: Nat, j: Nat) {
    shift_rows(scalar_mul_fn_2(c, f), k, i, j) = scalar_mul_fn_2(c, shift_rows(f, k), i, j)
}

theorem shift_cols_scale(c: Real, f: (Nat, Nat) -> Real, k: Nat, i: Nat, j: Nat) {
    shift_cols(scalar_mul_fn_2(c, f), k, i, j) = scalar_mul_fn_2(c, shift_cols(f, k), i, j)
}

theorem shift_rows_cols_commute(f: (Nat, Nat) -> Real, k1: Nat, k2: Nat, i: Nat, j: Nat) {
    shift_rows(shift_cols(f, k2), k1, i, j) = shift_cols(shift_rows(f, k1), k2, i, j)
}

theorem rectangular_sum_zero_height(f: (Nat, Nat) -> Real, n: Nat) {
    rectangular_sum(f, Nat.0, n) = Real.0
}

theorem rectangular_sum_zero_width(f: (Nat, Nat) -> Real, m: Nat) {
    rectangular_sum(f, m, Nat.0) = Real.0
}

theorem rectangular_sum_succ_rows(f: (Nat, Nat) -> Real, m: Nat, n: Nat) {
    rectangular_sum(f, m.suc, n) = rectangular_sum(f, m, n) + row_sum(f, n, m)
}

theorem rectangular_sum_succ_cols(f: (Nat, Nat) -> Real, m: Nat, n: Nat) {
    rectangular_sum(f, m, n.suc) = rectangular_sum(f, m, n) + col_sum(f, m, n)
}

theorem rectangular_sum_add_distrib(f: (Nat, Nat) -> Real, g: (Nat, Nat) -> Real, m: Nat, n: Nat) {
    rectangular_sum(add_fn_2(f, g), m, n) = rectangular_sum(f, m, n) + rectangular_sum(g, m, n)
}

theorem rectangular_sum_scale_left(c: Real, f: (Nat, Nat) -> Real, m: Nat, n: Nat) {
    rectangular_sum(scalar_mul_fn_2(c, f), m, n) = c * rectangular_sum(f, m, n)
}

theorem rectangular_sum_le_of_lte_fn(f: (Nat, Nat) -> Real, g: (Nat, Nat) -> Real, m: Nat, n: Nat) {
    lte_fn_2(f, g) implies rectangular_sum(f, m, n) <= rectangular_sum(g, m, n)
}

theorem rectangular_sum_bound_above(f: (Nat, Nat) -> Real, bound: Real, m: Nat, n: Nat) {
    nonneg_fn_2(f) and is_upper_bound_fn_2(f, bound)
    implies
    rectangular_sum(f, m, n) <= nat_to_real(m) * nat_to_real(n) * bound
}

theorem rectangular_sum_bound_below(f: (Nat, Nat) -> Real, bound: Real, m: Nat, n: Nat) {
    is_lower_bound_fn_2(f, bound)
    implies
    rectangular_sum(f, m, n) >= nat_to_real(m) * nat_to_real(n) * bound
}

theorem rectangular_sum_rows_split_at(f: (Nat, Nat) -> Real, m1: Nat, m2: Nat, n: Nat) {
    rectangular_sum(f, m1 + m2, n)
    =
    rectangular_sum(f, m1, n) + rectangular_sum(shift_rows(f, m1), m2, n)
}

theorem rectangular_sum_cols_split_at(f: (Nat, Nat) -> Real, m: Nat, n1: Nat, n2: Nat) {
    rectangular_sum(f, m, n1 + n2)
    =
    rectangular_sum(f, m, n1) + rectangular_sum(shift_cols(f, n1), m, n2)
}

define pointwise_product(a: Nat -> Real, b: Nat -> Real, i: Nat) -> Real {
    a(i) * b(i)
}

define pointwise_square(a: Nat -> Real, i: Nat) -> Real {
    a(i) * a(i)
}

define finite_dot(a: Nat -> Real, b: Nat -> Real, n: Nat) -> Real {
    partial(pointwise_product(a, b), n)
}

define finite_square_sum(a: Nat -> Real, n: Nat) -> Real {
    partial(pointwise_square(a), n)
}

theorem finite_dot_symm(a: Nat -> Real, b: Nat -> Real, n: Nat) {
    finite_dot(a, b, n) = finite_dot(b, a, n)
}

theorem finite_dot_zero(a: Nat -> Real, b: Nat -> Real) {
    finite_dot(a, b, Nat.0) = Real.0
}

theorem finite_dot_suc(a: Nat -> Real, b: Nat -> Real, n: Nat) {
    finite_dot(a, b, n.suc) = finite_dot(a, b, n) + a(n) * b(n)
}

theorem finite_square_sum_zero(a: Nat -> Real) {
    finite_square_sum(a, Nat.0) = Real.0
}

theorem finite_square_sum_suc(a: Nat -> Real, n: Nat) {
    finite_square_sum(a, n.suc) = finite_square_sum(a, n) + a(n) * a(n)
}

define lagrange_square(a: Nat -> Real, b: Nat -> Real, i: Nat, j: Nat) -> Real {
    (a(i) * b(j) - a(j) * b(i)) * (a(i) * b(j) - a(j) * b(i))
}

define square_outer(a: Nat -> Real, b: Nat -> Real, i: Nat, j: Nat) -> Real {
    pointwise_square(a, i) * pointwise_square(b, j)
}

define dot_outer(a: Nat -> Real, b: Nat -> Real, i: Nat, j: Nat) -> Real {
    pointwise_product(a, b, i) * pointwise_product(a, b, j)
}

define lagrange_expanded(a: Nat -> Real, b: Nat -> Real, i: Nat, j: Nat) -> Real {
    square_outer(a, b, i, j) + -dot_outer(a, b, i, j) +
        (-dot_outer(a, b, i, j) + square_outer(b, a, i, j))
}

define neg_dot_outer(a: Nat -> Real, b: Nat -> Real, i: Nat, j: Nat) -> Real {
    -dot_outer(a, b, i, j)
}

define lagrange_first(a: Nat -> Real, b: Nat -> Real, i: Nat, j: Nat) -> Real {
    square_outer(a, b, i, j) + neg_dot_outer(a, b, i, j)
}

define lagrange_second(a: Nat -> Real, b: Nat -> Real, i: Nat, j: Nat) -> Real {
    neg_dot_outer(a, b, i, j) + square_outer(b, a, i, j)
}

define lagrange_pair(a: Nat -> Real, b: Nat -> Real, i: Nat, j: Nat) -> Real {
    lagrange_first(a, b, i, j) + lagrange_second(a, b, i, j)
}

theorem pointwise_square_nonnegative(a: Nat -> Real, i: Nat) {
    pointwise_square(a, i) >= Real.0
}

theorem finite_square_sum_nonnegative(a: Nat -> Real, n: Nat) {
    finite_square_sum(a, n) >= Real.0
}

theorem lagrange_square_nonnegative(a: Nat -> Real, b: Nat -> Real, i: Nat, j: Nat) {
    lagrange_square(a, b, i, j) >= Real.0
}

theorem lagrange_square_sum_nonnegative(a: Nat -> Real, b: Nat -> Real, n: Nat) {
    rectangular_sum(lagrange_square(a, b), n, n) >= Real.0
}

theorem real_square_add_expanded(x: Real, y: Real) {
    (x + y) * (x + y) = x * x + x * y + (x * y + y * y)
}

theorem product_pair_square_rearrange(x: Real, y: Real) {
    (x * y) * (x * y) = (x * x) * (y * y)
}

theorem product_cross_rearrange(w: Real, x: Real, y: Real, z: Real) {
    (w * x) * (y * z) = (w * z) * (y * x)
}

theorem lagrange_square_eq_expanded(a: Nat -> Real, b: Nat -> Real, i: Nat, j: Nat) {
    lagrange_square(a, b, i, j) = lagrange_expanded(a, b, i, j)
}

theorem row_sum_pointwise_eq(
    f: (Nat, Nat) -> Real, g: (Nat, Nat) -> Real, i: Nat, n: Nat
) {
    (forall(j: Nat) {
        j < n implies f(i, j) = g(i, j)
    }) implies row_sum(f, n, i) = row_sum(g, n, i)
}

theorem rectangular_sum_row_eq(
    f: (Nat, Nat) -> Real, g: (Nat, Nat) -> Real, m: Nat, n: Nat
) {
    (forall(i: Nat) {
        i < m implies row_sum(f, n, i) = row_sum(g, n, i)
    }) implies rectangular_sum(f, m, n) = rectangular_sum(g, m, n)
}

theorem rectangular_sum_pointwise_eq(
    f: (Nat, Nat) -> Real, g: (Nat, Nat) -> Real, m: Nat, n: Nat
) {
    (forall(i: Nat, j: Nat) {
        i < m and j < n implies f(i, j) = g(i, j)
    }) implies rectangular_sum(f, m, n) = rectangular_sum(g, m, n)
}

theorem square_outer_sum_factors(a: Nat -> Real, b: Nat -> Real, n: Nat) {
    rectangular_sum(square_outer(a, b), n, n) =
        finite_square_sum(a, n) * finite_square_sum(b, n)
}

theorem dot_outer_sum_factors(a: Nat -> Real, b: Nat -> Real, n: Nat) {
    rectangular_sum(dot_outer(a, b), n, n) = finite_dot(a, b, n) * finite_dot(a, b, n)
}

theorem neg_dot_outer_sum(a: Nat -> Real, b: Nat -> Real, n: Nat) {
    rectangular_sum(neg_dot_outer(a, b), n, n) = -rectangular_sum(dot_outer(a, b), n, n)
}

theorem lagrange_first_sum(a: Nat -> Real, b: Nat -> Real, n: Nat) {
    rectangular_sum(lagrange_first(a, b), n, n) =
        finite_square_sum(a, n) * finite_square_sum(b, n) +
            -(finite_dot(a, b, n) * finite_dot(a, b, n))
}

theorem lagrange_second_sum(a: Nat -> Real, b: Nat -> Real, n: Nat) {
    rectangular_sum(lagrange_second(a, b), n, n) =
        finite_square_sum(a, n) * finite_square_sum(b, n) +
            -(finite_dot(a, b, n) * finite_dot(a, b, n))
}

theorem lagrange_pair_sum(a: Nat -> Real, b: Nat -> Real, n: Nat) {
    rectangular_sum(lagrange_pair(a, b), n, n) =
        (finite_square_sum(a, n) * finite_square_sum(b, n) +
            -(finite_dot(a, b, n) * finite_dot(a, b, n))) +
        (finite_square_sum(a, n) * finite_square_sum(b, n) +
            -(finite_dot(a, b, n) * finite_dot(a, b, n)))
}

theorem lagrange_expanded_eq_pair(a: Nat -> Real, b: Nat -> Real, i: Nat, j: Nat) {
    lagrange_expanded(a, b, i, j) = lagrange_pair(a, b, i, j)
}

theorem lagrange_square_sum_eq_gap_double(a: Nat -> Real, b: Nat -> Real, n: Nat) {
    rectangular_sum(lagrange_square(a, b), n, n) =
        (finite_square_sum(a, n) * finite_square_sum(b, n) +
            -(finite_dot(a, b, n) * finite_dot(a, b, n))) +
        (finite_square_sum(a, n) * finite_square_sum(b, n) +
            -(finite_dot(a, b, n) * finite_dot(a, b, n)))
}

theorem double_nonnegative_imp_nonnegative(x: Real) {
    x + x >= Real.0 implies x >= Real.0
}

theorem nonnegative_gap_imp_lte(a: Real, b: Real) {
    a + -b >= Real.0 implies b <= a
}

theorem finite_cauchy_schwarz(a: Nat -> Real, b: Nat -> Real, n: Nat) {
    finite_dot(a, b, n) * finite_dot(a, b, n) <= finite_square_sum(a, n) * finite_square_sum(b, n)
}

define double_limit_condition(f: (Nat, Nat) -> Real, val: Real, n: Nat, eps: Real) -> Bool {
    forall(i: Nat, j: Nat) {
        n <= i and n <= j implies f(i, j).is_close(val, eps)
    }
}

define double_converges_to(f: (Nat, Nat) -> Real, val: Real) -> Bool {
    forall(eps: Real) {
        eps.is_positive implies exists(n: Nat) {
            double_limit_condition(f, val, n, eps)
        }
    }
}

define double_converges(f: (Nat, Nat) -> Real) -> Bool {
    exists(val: Real) {
        double_converges_to(f, val)
    }
}

let double_limit(f: (Nat, Nat) -> Real) -> val: Real satisfy {
    double_converges(f) implies double_converges_to(f, val)
}

define doubly_increasing(f: (Nat, Nat) -> Real) -> Bool {
    forall(i: Nat, j: Nat) {
        f(i, j) <= f(i, j.suc) and f(i, j) <= f(i.suc, j)
    }
}

theorem doubly_increasing_right(f: (Nat, Nat) -> Real, i: Nat) {
    doubly_increasing(f) implies is_increasing(function(j: Nat) { f(i, j) })
}

theorem doubly_increasing_right_monotone(f: (Nat, Nat) -> Real, i: Nat) {
    doubly_increasing(f) implies is_monotone(function(j: Nat) { f(i, j) })
}

theorem doubly_increasing_left(f: (Nat, Nat) -> Real, j: Nat) {
    doubly_increasing(f) implies is_increasing(function(i: Nat) { f(i, j) })
}

theorem doubly_increasing_left_monotone(f: (Nat, Nat) -> Real, j: Nat) {
    doubly_increasing(f) implies is_monotone(function(i: Nat) { f(i, j) })
}

theorem doubly_increasing_flip(f: (Nat, Nat) -> Real, j: Nat) {
    doubly_increasing(f) implies is_increasing(function(i: Nat) { flip(f, j, i) })
}

theorem doubly_increasing_flip_monotone(f: (Nat, Nat) -> Real, j: Nat) {
    doubly_increasing(f) implies is_monotone(function(i: Nat) { flip(f, j, i) })
}

theorem doubly_increasing_first_mono(f: (Nat, Nat) -> Real, i1: Nat, i2: Nat, j: Nat) {
    doubly_increasing(f) and i1 <= i2 implies f(i1, j) <= f(i2, j)
}

theorem doubly_increasing_second_mono(f: (Nat, Nat) -> Real, i: Nat, j1: Nat, j2: Nat) {
    doubly_increasing(f) and j1 <= j2 implies f(i, j1) <= f(i, j2)
}

theorem doubly_increasing_monotone(f: (Nat, Nat) -> Real, i1: Nat, i2: Nat, j1: Nat, j2: Nat) {
    doubly_increasing(f) and i1 <= i2 and j1 <= j2 implies f(i1, j1) <= f(i2, j2)
}

define double_image(f: (Nat, Nat) -> Real, x: Real) -> Bool {
    exists(i: Nat, j: Nat) {
        f(i, j) = x
    }
}

define double_is_upper_bound(f: (Nat, Nat) -> Real, b: Real) -> Bool {
    forall(i: Nat, j: Nat) {
        f(i, j) <= b
    }
}

theorem double_is_upper_bound_from_forall(f: (Nat, Nat) -> Real, b: Real) {
    (forall(i: Nat, j: Nat) {
        f(i, j) <= b
    })
    implies
    double_is_upper_bound(f, b)
}

define double_image_is_supremum(f: (Nat, Nat) -> Real, s: Real) -> Bool {
    double_is_upper_bound(f, s) and
    forall(b: Real) {
        b < s implies not double_is_upper_bound(f, b)
    }
}

theorem double_image_is_supremum_from_parts(f: (Nat, Nat) -> Real, s: Real) {
    double_is_upper_bound(f, s) and
    forall(b: Real) {
        b < s implies not double_is_upper_bound(f, b)
    }
    implies
    double_image_is_supremum(f, s)
}

theorem doubly_increasing_bounded_converges(f: (Nat, Nat) -> Real, s: Real) {
    doubly_increasing(f) and double_image_is_supremum(f, s)
    implies
    double_converges_to(f, s)
}

define row_converges(f: (Nat, Nat) -> Real, i: Nat) -> Bool {
    converges(f(i))
}

define row_limit(f: (Nat, Nat) -> Real, i: Nat) -> Real {
    limit(f(i))
}

define col_converges(f: (Nat, Nat) -> Real, j: Nat) -> Bool {
    converges(flip(f, j))
}

define col_limit(f: (Nat, Nat) -> Real, j: Nat) -> Real {
    limit(flip(f, j))
}

define all_rows_converge(f: (Nat, Nat) -> Real) -> Bool {
    forall(i: Nat) {
        row_converges(f, i)
    }
}

define all_cols_converge(f: (Nat, Nat) -> Real) -> Bool {
    forall(j: Nat) {
        col_converges(f, j)
    }
}

define iterated_limit_rows(f: (Nat, Nat) -> Real) -> Real {
    limit(row_limit(f))
}

define iterated_limit_cols(f: (Nat, Nat) -> Real) -> Real {
    limit(col_limit(f))
}

theorem row_limit_unfold(f: (Nat, Nat) -> Real, i: Nat) {
    row_limit(f, i) = limit(f(i))
}

theorem col_limit_unfold(f: (Nat, Nat) -> Real, j: Nat) {
    col_limit(f, j) = limit(flip(f, j))
}

theorem row_converges_unfold(f: (Nat, Nat) -> Real, i: Nat) {
    row_converges(f, i) = converges(f(i))
}

theorem col_converges_unfold(f: (Nat, Nat) -> Real, j: Nat) {
    col_converges(f, j) = converges(flip(f, j))
}

theorem row_sequence_converges(f: (Nat, Nat) -> Real, i: Nat, b: Real) {
    doubly_increasing(f) and double_is_upper_bound(f, b)
    implies
    converges(f(i))
}

theorem col_sequence_converges(f: (Nat, Nat) -> Real, j: Nat, b: Real) {
    doubly_increasing(f) and double_is_upper_bound(f, b)
    implies
    converges(flip(f, j))
}

theorem row_limits_increasing(f: (Nat, Nat) -> Real, b: Real, i: Nat) {
    doubly_increasing(f) and double_is_upper_bound(f, b)
    implies
    limit(f(i)) <= limit(f(i.suc))
}

theorem col_limits_increasing(f: (Nat, Nat) -> Real, b: Real, j: Nat) {
    doubly_increasing(f) and double_is_upper_bound(f, b)
    implies
    limit(flip(f, j)) <= limit(flip(f, j.suc))
}

theorem row_limit_bounded(f: (Nat, Nat) -> Real, i: Nat, b: Real) {
    doubly_increasing(f) and double_is_upper_bound(f, b)
    implies
    limit(f(i)) <= b
}

theorem col_limit_bounded(f: (Nat, Nat) -> Real, j: Nat, b: Real) {
    doubly_increasing(f) and double_is_upper_bound(f, b)
    implies
    limit(flip(f, j)) <= b
}

theorem row_limits_is_increasing(f: (Nat, Nat) -> Real, b: Real) {
    doubly_increasing(f) and double_is_upper_bound(f, b)
    implies
    is_increasing(row_limit(f))
}

theorem row_limits_is_monotone(f: (Nat, Nat) -> Real, b: Real) {
    doubly_increasing(f) and double_is_upper_bound(f, b)
    implies
    is_monotone(row_limit(f))
}

theorem col_limits_is_increasing(f: (Nat, Nat) -> Real, b: Real) {
    doubly_increasing(f) and double_is_upper_bound(f, b)
    implies
    is_increasing(col_limit(f))
}

theorem col_limits_is_monotone(f: (Nat, Nat) -> Real, b: Real) {
    doubly_increasing(f) and double_is_upper_bound(f, b)
    implies
    is_monotone(col_limit(f))
}

theorem row_limits_bounded(f: (Nat, Nat) -> Real, b: Real) {
    doubly_increasing(f) and double_is_upper_bound(f, b)
    implies
    is_upper_bound(row_limit(f), b)
}

theorem col_limits_bounded(f: (Nat, Nat) -> Real, b: Real) {
    doubly_increasing(f) and double_is_upper_bound(f, b)
    implies
    is_upper_bound(col_limit(f), b)
}

theorem iterated_rows_converges(f: (Nat, Nat) -> Real, b: Real) {
    doubly_increasing(f) and double_is_upper_bound(f, b)
    implies
    converges(row_limit(f))
}

theorem iterated_rows_converges_monotone(f: (Nat, Nat) -> Real, b: Real) {
    doubly_increasing(f) and double_is_upper_bound(f, b)
    implies
    converges(row_limit(f))
}

theorem iterated_cols_converges(f: (Nat, Nat) -> Real, b: Real) {
    doubly_increasing(f) and double_is_upper_bound(f, b)
    implies
    converges(col_limit(f))
}

theorem iterated_cols_converges_monotone(f: (Nat, Nat) -> Real, b: Real) {
    doubly_increasing(f) and double_is_upper_bound(f, b)
    implies
    converges(col_limit(f))
}

theorem iterated_limit_rows_is_upper_bound(f: (Nat, Nat) -> Real, b: Real) {
    doubly_increasing(f) and double_is_upper_bound(f, b)
    implies
    double_is_upper_bound(f, iterated_limit_rows(f))
}

theorem iterated_limit_cols_is_upper_bound(f: (Nat, Nat) -> Real, b: Real) {
    doubly_increasing(f) and double_is_upper_bound(f, b)
    implies
    double_is_upper_bound(f, iterated_limit_cols(f))
}

theorem supremum_lte_upper_bound(f: (Nat, Nat) -> Real, s: Real, b: Real) {
    double_image_is_supremum(f, s) and double_is_upper_bound(f, b)
    implies
    s <= b
}

theorem double_converges_to_unique(f: (Nat, Nat) -> Real, a: Real, b: Real) {
    double_converges_to(f, a) and double_converges_to(f, b)
    implies
    a = b
}

theorem double_limit_eq_of_converges_to(f: (Nat, Nat) -> Real, s: Real) {
    double_converges_to(f, s) implies double_limit(f) = s
}

theorem iterated_limit_rows_eq_supremum(f: (Nat, Nat) -> Real, s: Real) {
    doubly_increasing(f) and double_image_is_supremum(f, s)
    implies
    iterated_limit_rows(f) = s
}

theorem iterated_limit_cols_eq_supremum(f: (Nat, Nat) -> Real, s: Real) {
    doubly_increasing(f) and double_image_is_supremum(f, s)
    implies
    iterated_limit_cols(f) = s
}

theorem monotone_convergence_interchange(f: (Nat, Nat) -> Real, s: Real) {
    doubly_increasing(f) and double_image_is_supremum(f, s)
    implies
    double_limit(f) = s and
    iterated_limit_rows(f) = s and
    iterated_limit_cols(f) = s and
    double_limit(f) = iterated_limit_rows(f) and
    double_limit(f) = iterated_limit_cols(f) and
    iterated_limit_rows(f) = iterated_limit_cols(f)
}

theorem double_limit_add(f: (Nat, Nat) -> Real, g: (Nat, Nat) -> Real) {
    double_converges(f) and double_converges(g)
    implies
    double_converges_to(add_fn_2(f, g), double_limit(f) + double_limit(g))
}

theorem double_limit_sub(f: (Nat, Nat) -> Real, g: (Nat, Nat) -> Real) {
    double_converges(f) and double_converges(g)
    implies
    double_converges_to(sub_fn_2(f, g), double_limit(f) - double_limit(g))
}

define is_nonempty(s: Set[Real]) -> Bool {
    exists(x: Real) {
        s.contains(x)
    }
}

define is_set_upper_bound(s: Set[Real], b: Real) -> Bool {
    forall(x: Real) {
        s.contains(x) implies x <= b
    }
}

define has_upper_bound(s: Set[Real]) -> Bool {
    exists(b: Real) {
        is_set_upper_bound(s, b)
    }
}

define is_set_lower_bound(s: Set[Real], b: Real) -> Bool {
    forall(x: Real) {
        s.contains(x) implies b <= x
    }
}

define is_set_supremum(s: Set[Real], sup: Real) -> Bool {
    is_set_upper_bound(s, sup) and
    forall(b: Real) {
        is_set_upper_bound(s, b) implies sup <= b
    }
}

define is_set_infimum(s: Set[Real], inf: Real) -> Bool {
    is_set_lower_bound(s, inf) and
    forall(b: Real) {
        is_set_lower_bound(s, b) implies b <= inf
    }
}

theorem set_supremum_is_upper_bound(s: Set[Real], sup: Real) {
    is_set_supremum(s, sup) implies is_set_upper_bound(s, sup)
}

theorem set_upper_bound_contains_le(s: Set[Real], bound: Real, x: Real) {
    is_set_upper_bound(s, bound) and s.contains(x) implies x <= bound
}

theorem set_supremum_le_upper_bound(s: Set[Real], sup: Real, bound: Real) {
    is_set_supremum(s, sup) and is_set_upper_bound(s, bound) implies sup <= bound
}

theorem set_member_le_supremum(s: Set[Real], sup: Real, x: Real) {
    is_set_supremum(s, sup) and s.contains(x) implies x <= sup
}

theorem set_bound_below_supremum_not_upper(s: Set[Real], sup: Real, bound: Real) {
    is_set_supremum(s, sup) and bound < sup implies not is_set_upper_bound(s, bound)
}

theorem set_not_upper_bound_witness(s: Set[Real], bound: Real) {
    not is_set_upper_bound(s, bound) implies exists(x: Real) {
        s.contains(x) and not x <= bound
    }
}

theorem set_supremum_close_from_below(s: Set[Real], sup: Real, eps: Real) {
    is_set_supremum(s, sup) and eps.is_positive implies exists(x: Real) {
        s.contains(x) and sup - eps < x and x <= sup and x.is_close(sup, eps)
    }
}

theorem completeness(s: Set[Real]) {
    is_nonempty(s) and has_upper_bound(s)
    implies
    exists(sup: Real) {
        is_set_supremum(s, sup)
    }
}

theorem supremum_exists_for_subset(s: Set[Real], t: Set[Real], sup_t: Real) {
    s.subset(t) and is_nonempty(s) and is_set_supremum(t, sup_t)
    implies
    exists(sup_s: Real) {
        is_set_supremum(s, sup_s)
    }
}

theorem supremum_subset_le(s: Set[Real], t: Set[Real], sup_s: Real, sup_t: Real) {
    s.subset(t) and is_set_supremum(s, sup_s) and is_set_supremum(t, sup_t)
    implies
    sup_s <= sup_t
}

theorem supremum_union_max(s: Set[Real], t: Set[Real], sup_s: Real, sup_t: Real) {
    is_set_supremum(s, sup_s) and is_set_supremum(t, sup_t)
    implies
    is_set_supremum(s.union(t), sup_s.max(sup_t))
}

define setwise_add_contains(s: Set[Real], t: Set[Real], x: Real) -> Bool {
    exists(a: Real, b: Real) {
        s.contains(a) and t.contains(b) and x = a + b
    }
}

define setwise_add(s: Set[Real], t: Set[Real]) -> Set[Real] {
    Set[Real].new(setwise_add_contains(s, t))
}

theorem setwise_add_contains_iff(s: Set[Real], t: Set[Real], x: Real) {
    setwise_add(s, t).contains(x) = setwise_add_contains(s, t, x)
}

theorem setwise_add_membership(s: Set[Real], t: Set[Real], a: Real, b: Real) {
    s.contains(a) and t.contains(b)
    implies
    setwise_add(s, t).contains(a + b)
}

theorem supremum_setwise_add(s: Set[Real], t: Set[Real], sup_s: Real, sup_t: Real) {
    is_set_supremum(s, sup_s) and is_set_supremum(t, sup_t)
    implies
    is_set_supremum(setwise_add(s, t), sup_s + sup_t)
}

define negate_set_contains(s: Set[Real], x: Real) -> Bool {
    exists(a: Real) {
        s.contains(a) and x = -a
    }
}

define negate_set(s: Set[Real]) -> Set[Real] {
    Set[Real].new(negate_set_contains(s))
}

theorem supremum_infimum_duality(s: Set[Real], sup_s: Real) {
    is_set_supremum(s, sup_s)
    implies
    is_set_infimum(negate_set(s), -sup_s)
}

define scalar_contains(alpha: Real, s: Set[Real], x: Real) -> Bool {
    exists(a: Real) {
        s.contains(a) and x = alpha * a
    }
}

define scalar_mult(alpha: Real, s: Set[Real]) -> Set[Real] {
    Set[Real].new(scalar_contains(alpha, s))
}

theorem scalar_mult_contains_iff(alpha: Real, s: Set[Real], x: Real) {
    scalar_mult(alpha, s).contains(x) = scalar_contains(alpha, s, x)
}

theorem scalar_mult_witness(alpha: Real, s: Set[Real], x: Real) {
    scalar_mult(alpha, s).contains(x)
    implies
    exists(a: Real) {
        s.contains(a) and x = alpha * a
    }
}

theorem scalar_mult_membership(alpha: Real, s: Set[Real], a: Real) {
    s.contains(a)
    implies
    scalar_mult(alpha, s).contains(alpha * a)
}

theorem mul_supremum_le(alpha: Real, s: Set[Real], sup_s: Real, ub: Real) {
    alpha >= Real.0 and is_set_supremum(s, sup_s) and is_nonempty(s) and
    (forall(a: Real) { s.contains(a) implies alpha * a <= ub })
    implies
    alpha * sup_s <= ub
}

theorem supremum_scalar_mult(alpha: Real, s: Set[Real], sup_s: Real) {
    alpha >= Real.0 and is_nonempty(s) and is_set_supremum(s, sup_s)
    implies
    is_set_supremum(scalar_mult(alpha, s), alpha * sup_s)
}

theorem mul_infimum_le(beta: Real, s: Set[Real], inf_s: Real, ub: Real) {
    beta <= Real.0 and is_set_infimum(s, inf_s) and is_nonempty(s) and
    (forall(a: Real) { s.contains(a) implies beta * a <= ub })
    implies
    beta * inf_s <= ub
}

theorem supremum_scalar_mult_neg(alpha: Real, s: Set[Real], inf_s: Real) {
    alpha < Real.0 and is_nonempty(s) and is_set_infimum(s, inf_s)
    implies
    is_set_supremum(scalar_mult(alpha, s), alpha * inf_s)
}

define seq_image(a: Nat -> Real) -> Set[Real] {
    set_image(Set[Nat].universal_set, a)
}

theorem seq_image_contains_iff(a: Nat -> Real, x: Real) {
    seq_image(a).contains(x) = image(a, x)
}

theorem monotone_convergence_seq(a: Nat -> Real, b: Real) {
    is_increasing(a) and is_upper_bound(a, b)
    implies
    is_set_supremum(seq_image(a), limit(a))
}

define is_nondecreasing(f: Real -> Real) -> Bool {
    forall(x: Real, y: Real) {
        x <= y implies f(x) <= f(y)
    }
}

theorem monotone_is_nondecreasing(f: Real -> Real) {
    is_monotone(f) implies is_nondecreasing(f)
}

define function_image_contains(f: Real -> Real, s: Set[Real], y: Real) -> Bool {
    image_contains(f, s, y)
}

define function_image(f: Real -> Real, s: Set[Real]) -> Set[Real] {
    set_image(s, f)
}

theorem function_image_contains_iff(f: Real -> Real, s: Set[Real], y: Real) {
    function_image(f, s).contains(y) = function_image_contains(f, s, y)
}

theorem function_image_compose(f: Real -> Real, g: Real -> Real, s: Set[Real]) {
    function_image(f, function_image(g, s)) = function_image(compose(f, g), s)
}

theorem supremum_order_preserving(f: Real -> Real, s: Set[Real], sup_s: Real) {
    is_nondecreasing(f) and is_set_supremum(s, sup_s) and is_nonempty(function_image(f, s))
    implies
    exists(sup_fs: Real) {
        is_set_supremum(function_image(f, s), sup_fs) and sup_fs <= f(sup_s)
    }
}

theorem supremum_monotone_image_le(f: Real -> Real, s: Set[Real], sup_s: Real) {
    is_monotone(f) and is_set_supremum(s, sup_s) and is_nonempty(function_image(f, s))
    implies
    exists(sup_fs: Real) {
        is_set_supremum(function_image(f, s), sup_fs) and sup_fs <= f(sup_s)
    }
}

define double_sum_bounded(f: (Nat, Nat) -> Real, a: Real, n: Nat, eps: Real) -> Bool {
    double_limit_condition(rectangular_sum(f), a, n, eps)
}

define double_sum_converges_to(f: (Nat, Nat) -> Real, a: Real) -> Bool {
    double_converges_to(rectangular_sum(f), a)
}

define double_sum_converges(f: (Nat, Nat) -> Real) -> Bool {
    double_converges(rectangular_sum(f))
}

define double_sum(f: (Nat, Nat) -> Real) -> Real {
    double_limit(rectangular_sum(f))
}

define row_infinite_sum(f: (Nat, Nat) -> Real, i: Nat) -> Real {
    limit(partial(f(i)))
}

define col_infinite_sum(f: (Nat, Nat) -> Real, j: Nat) -> Real {
    limit(partial(flip(f, j)))
}

define row_sums_seq(f: (Nat, Nat) -> Real, i: Nat) -> Real {
    row_infinite_sum(f, i)
}

define col_sums_seq(f: (Nat, Nat) -> Real, j: Nat) -> Real {
    col_infinite_sum(f, j)
}

define square_sum(f: (Nat, Nat) -> Real, n: Nat) -> Real {
    rectangular_sum(f, n, n)
}

define square_sum_seq(f: (Nat, Nat) -> Real, n: Nat) -> Real {
    square_sum(f, n)
}

theorem row_partial_increasing(f: (Nat, Nat) -> Real, i: Nat) {
    nonneg_fn_2(f)
    implies
    is_increasing(partial(f(i)))
}

theorem row_partial_monotone(f: (Nat, Nat) -> Real, i: Nat) {
    nonneg_fn_2(f)
    implies
    is_monotone(partial(f(i)))
}

theorem col_partial_increasing(f: (Nat, Nat) -> Real, j: Nat) {
    nonneg_fn_2(f)
    implies
    is_increasing(partial(flip(f, j)))
}

theorem col_partial_monotone(f: (Nat, Nat) -> Real, j: Nat) {
    nonneg_fn_2(f)
    implies
    is_monotone(partial(flip(f, j)))
}

theorem square_sum_is_increasing(f: (Nat, Nat) -> Real) {
    nonneg_fn_2(f)
    implies
    is_increasing(square_sum_seq(f))
}

theorem square_sum_is_monotone(f: (Nat, Nat) -> Real) {
    nonneg_fn_2(f)
    implies
    is_monotone(square_sum_seq(f))
}

theorem row_sum_bounded_by_infinite(f: (Nat, Nat) -> Real, i: Nat, n: Nat) {
    nonneg_fn_2(f) and converges(partial(f(i)))
    implies
    row_sum(f, n, i) <= row_infinite_sum(f, i)
}

theorem col_sum_bounded_by_infinite(f: (Nat, Nat) -> Real, j: Nat, m: Nat) {
    nonneg_fn_2(f) and converges(partial(flip(f, j)))
    implies
    col_sum(f, m, j) <= col_infinite_sum(f, j)
}

theorem rectangular_sum_bounded_by_row_sums(f: (Nat, Nat) -> Real, m: Nat, n: Nat) {
    nonneg_fn_2(f) and all_rows_converge(f)
    implies
    rectangular_sum(f, m, n) <= partial(row_sums_seq(f), m)
}

theorem rectangular_sum_bounded_by_col_sums(f: (Nat, Nat) -> Real, m: Nat, n: Nat) {
    nonneg_fn_2(f) and all_cols_converge(f)
    implies
    rectangular_sum(f, m, n) <= partial(col_sums_seq(f), n)
}

theorem rectangular_sum_succ_row(f: (Nat, Nat) -> Real, k: Nat, n: Nat) {
    rectangular_sum(f, k.suc, n) = rectangular_sum(f, k, n) + row_sum(f, n, k)
}

theorem rectangular_sum_succ_col(f: (Nat, Nat) -> Real, m: Nat, k: Nat) {
    rectangular_sum(f, m, k.suc) = rectangular_sum(f, m, k) + col_sum(f, m, k)
}

theorem row_sum_bounded_by_supremum(f: (Nat, Nat) -> Real, s: Real, i: Nat, n: Nat) {
    nonneg_fn_2(f) and double_image_is_supremum(rectangular_sum(f), s)
    implies
    row_sum(f, n, i) <= s
}

theorem col_sum_bounded_by_supremum(f: (Nat, Nat) -> Real, s: Real, j: Nat, m: Nat) {
    nonneg_fn_2(f) and double_image_is_supremum(rectangular_sum(f), s)
    implies
    col_sum(f, m, j) <= s
}

theorem row_partial_bounded_by_supremum(f: (Nat, Nat) -> Real, s: Real, i: Nat) {
    nonneg_fn_2(f) and double_image_is_supremum(rectangular_sum(f), s)
    implies
    is_upper_bound(partial(f(i)), s)
}

theorem col_partial_bounded_by_supremum(f: (Nat, Nat) -> Real, s: Real, j: Nat) {
    nonneg_fn_2(f) and double_image_is_supremum(rectangular_sum(f), s)
    implies
    is_upper_bound(partial(flip(f, j)), s)
}

theorem row_partial_converges_of_supremum(f: (Nat, Nat) -> Real, s: Real, i: Nat) {
    nonneg_fn_2(f) and double_image_is_supremum(rectangular_sum(f), s)
    implies
    converges(partial(f(i)))
}

theorem col_partial_converges_of_supremum(f: (Nat, Nat) -> Real, s: Real, j: Nat) {
    nonneg_fn_2(f) and double_image_is_supremum(rectangular_sum(f), s)
    implies
    converges(partial(flip(f, j)))
}

theorem all_rows_converge_of_supremum(f: (Nat, Nat) -> Real, s: Real) {
    nonneg_fn_2(f) and double_image_is_supremum(rectangular_sum(f), s)
    implies
    all_rows_converge(f)
}

theorem all_cols_converge_of_supremum(f: (Nat, Nat) -> Real, s: Real) {
    nonneg_fn_2(f) and double_image_is_supremum(rectangular_sum(f), s)
    implies
    all_cols_converge(f)
}

theorem row_limit_rectangular_sum(f: (Nat, Nat) -> Real, m: Nat) {
    all_rows_converge(f)
    implies
