theorem triangular_sum_split_rectangles(f: (Nat, Nat) -> Real, m: Nat, n: Nat) {
    triangular_sum(f, m + n) =
        rectangular_sum(f, m, n) +
        triangular_sum(shift_cols(f, n), m) +
