}

theorem triangular_sum_le_of_lte_fn(f: (Nat, Nat) -> Real, g: (Nat, Nat) -> Real, n: Nat) {
    lte_fn_2(f, g) implies triangular_sum(f, n) <= triangular_sum(g, n)
