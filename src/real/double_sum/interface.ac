}

theorem exp_shift_term_abs_le_half_pow(h: Real, j: Nat) {
    h.abs < Real.1 / two and j >= Nat.1 implies exp_shift_term(h, j).abs <= h.abs.pow(j) / two
}

theorem geom_partial_bound(h: Real, n: Nat) {
    h.abs < Real.1 implies partial(h.abs.pow, n) <= Real.1 / (Real.1 - h.abs)
}

theorem geom_partial_minus_one_bound(h: Real, n: Nat) {
    h.abs < Real.1 implies partial(h.abs.pow, n.suc) - Real.1 <= h.abs / (Real.1 - h.abs)
}

theorem half_geom_tail_bound(h: Real) {
    h.abs < Real.1 / two implies (Real.1 / two) * (h.abs / (Real.1 - h.abs)) <= h.abs
}

theorem shift_partial_sum_bound(h: Real, n: Nat) {
    h.abs < Real.1 / two implies partial(tail(abs_fn(exp_shift_term(h)), Nat.1), n) <= h.abs
}

theorem exp_shift_sum_close_one(h: Real) {
    h.abs < Real.1 / two implies
        (limit(partial(exp_shift_term(h))) - Real.1).abs <= h.abs
}

define exp_shift_sum(x: Real) -> Real {
    limit(partial(exp_shift_term(x)))
}

theorem exp_sub_one_series_sum(x: Real) {
    x.exp - Real.1 = x * exp_shift_sum(x)
}

theorem exp_shift_sum_close_one_sum(h: Real) {
    h.abs < Real.1 / two implies (exp_shift_sum(h) - Real.1).abs <= h.abs
}

theorem exp_has_derivative_at(x0: Real) {
    has_derivative_at(Real.exp, x0, x0.exp)
}

theorem exp_is_derivative_fn {
    is_derivative_fn(Real.exp, Real.exp)
}

theorem close_from_both_sides(a: Real, b: Real, eps: Real) {
    a > b - eps and a < b + eps implies a.is_close(b, eps)
}

theorem log_value_close(x0: Real, delta2: Real) {
    x0 > Real.0 and delta2.is_positive implies exists(delta: Real) {
        delta.is_positive and delta < x0 and forall(x: Real) {
            x.is_close(x0, delta) implies x.log.get_or_else(Real.0).is_close(x0.log.get_or_else(Real.0), delta2)
        }
    }
}

theorem log_has_derivative_at_pos(x0: Real) {
    x0 > Real.0 implies has_derivative_at(log_value, x0, Real.1 / x0)
}

theorem log_is_derivative_fn_on_positives {
    forall(x: Real) {
        x > Real.0 implies has_derivative_at(log_value, x, Real.1 / x)
    }
}

theorem has_derivative_at_eq_right(f: Real -> Real, x0: Real, d1: Real, d2: Real) {
    has_derivative_at(f, x0, d1) and d1 = d2 implies has_derivative_at(f, x0, d2)
}

theorem square_real_has_derivative_at_two_x(x0: Real) {
    has_derivative_at(square_real, x0, two * x0)
}

theorem square_real_differentiable_at_any(x0: Real) {
    differentiable_at(square_real, x0)
}

theorem two_mul_real(e: Real) {
    two * e = e + e
}

theorem three_mul_real(e: Real) {
    three * e = e + e + e
}

theorem three_mul_square(x0: Real) {
    three * (x0 * x0) = x0 * x0 + x0 * x0 + x0 * x0
}

theorem cube_derivative_value_three_square(x0: Real) {
    square_real(x0) * Real.1 + x0 * (x0 * Real.1 + x0 * Real.1) = three * square_real(x0)
}

theorem cube_real_has_derivative_at_three_square(x0: Real) {
    has_derivative_at(cube_real, x0, three * square_real(x0))
}

theorem cube_real_differentiable_at_any(x0: Real) {
    differentiable_at(cube_real, x0)
}

theorem pow_real_fn_derivative_value_suc(k: Nat, x0: Real) {
    x0 * (from_nat[Real](k.suc) * x0.pow(k)) + x0 * x0.pow(k) =
        from_nat[Real](k.suc.suc) * x0.pow(k.suc)
}

theorem pow_real_fn_has_derivative_at_base(x0: Real) {
    has_derivative_at(pow_real_fn(Nat.1), x0, from_nat[Real](Nat.1) * x0.pow(Nat.0))
}

theorem pow_real_fn_has_derivative_at_suc(k: Nat, x0: Real) {
    has_derivative_at(pow_real_fn(k.suc), x0, from_nat[Real](k.suc) * x0.pow(k))
    implies has_derivative_at(pow_real_fn(k.suc.suc), x0, from_nat[Real](k.suc.suc) * x0.pow(k.suc))
}

theorem pow_real_fn_has_derivative_at(n: Nat, x0: Real) {
    has_derivative_at(pow_real_fn(n.suc), x0, from_nat[Real](n.suc) * x0.pow(n))
}

theorem pow_real_fn_differentiable_at(n: Nat, x0: Real) {
    differentiable_at(pow_real_fn(n.suc), x0)
}

theorem derivative_pointwise_mul_restated(f: Real -> Real, g: Real -> Real, x0: Real, df: Real, dg: Real) {
    has_derivative_at(f, x0, df) and has_derivative_at(g, x0, dg)
    implies has_derivative_at(pointwise_mul(f, g), x0, f(x0) * dg + g(x0) * df)
}

theorem derivative_fn_mul_restated(f: Real -> Real, g: Real -> Real, df: Real -> Real, dg: Real -> Real) {
    is_derivative_fn(f, df) and is_derivative_fn(g, dg)
    implies is_derivative_fn(
        pointwise_mul(f, g),
        pointwise_add(pointwise_mul(f, dg), pointwise_mul(g, df))
    )
}

theorem derivative_compose_restated(f: Real -> Real, g: Real -> Real, x0: Real, df: Real, dg: Real) {
    has_derivative_at(f, x0, df) and has_derivative_at(g, f(x0), dg)
    implies has_derivative_at(compose(g, f), x0, dg * df)
}

theorem derivative_fn_compose_restated(f: Real -> Real, g: Real -> Real, df: Real -> Real, dg: Real -> Real) {
    is_derivative_fn(f, df) and is_derivative_fn(g, dg)
    implies is_derivative_fn(compose(g, f), pointwise_mul(compose(dg, f), df))
}

theorem exp_has_derivative_at_self(x0: Real) {
    has_derivative_at(Real.exp, x0, x0.exp)
}

theorem exp_is_derivative_fn_self {
    is_derivative_fn(Real.exp, Real.exp)
}

theorem one_div_one_div(c: Real) {
    c != Real.0 implies Real.1 / (Real.1 / c) = c
}

theorem one_sub_nonpositive_of_ge_one(t: Real) {
    t >= Real.1 implies Real.1 - t <= Real.0
}

theorem exp_neg_ge_one_sub(t: Real) {
    t >= Real.0 implies (-t).exp >= Real.1 - t
}

theorem exp_ge_one_plus_self(x: Real) {
    x.exp >= Real.1 + x
}

theorem exp_ge_one_of_nonneg(x: Real) {
    x >= Real.0 implies x.exp >= Real.1
}

theorem exp_lt_one_of_neg(x: Real) {
    x < Real.0 implies x.exp < Real.1
}

theorem exp_monotone(x: Real, y: Real) {
    x <= y implies x.exp <= y.exp
}

theorem exp_le_one_of_nonpos(x: Real) {
    x <= Real.0 implies x.exp <= Real.1
}

theorem exp_neg_le_one_of_nonneg(t: Real) {
    t >= Real.0 implies (-t).exp <= Real.1
}

theorem exp_neg_lt_one_of_pos(t: Real) {
    t > Real.0 implies (-t).exp < Real.1
}

theorem exp_neg_ge_one_sub_self(x: Real) {
    (-x).exp >= Real.1 - x
}

theorem one_sub_exp_neg_le_self(t: Real) {
    t >= Real.0 implies Real.1 - (-t).exp <= t
}

theorem self_le_exp_sub_one(x: Real) {
    x <= x.exp - Real.1
}

theorem exp_sub_one_nonneg_of_nonneg(x: Real) {
    x >= Real.0 implies x.exp - Real.1 >= Real.0
}

theorem exp_sub_one_pos_of_pos(x: Real) {
    x > Real.0 implies x.exp - Real.1 > Real.0
}

theorem log_le_sub_one(x: Real, y: Real) {
    x > Real.0 and x.log = Option.some(y) implies y <= x - Real.1
}

theorem one_sub_recip_le_log(x: Real, y: Real) {
    x > Real.0 and x.log = Option.some(y) implies Real.1 - Real.1 / x <= y
}

theorem log_nonneg_of_ge_one(x: Real, y: Real) {
    x >= Real.1 and x.log = Option.some(y) implies y >= Real.0
}

theorem log_nonpos_of_pos_le_one(x: Real, y: Real) {
    x > Real.0 and x <= Real.1 and x.log = Option.some(y) implies y <= Real.0
}

theorem log_pos_of_gt_one(x: Real, y: Real) {
    x > Real.1 and x.log = Option.some(y) implies y > Real.0
}

theorem log_neg_of_pos_lt_one(x: Real, y: Real) {
    x > Real.0 and x < Real.1 and x.log = Option.some(y) implies y < Real.0
}

theorem eq_one_of_log_eq_zero(x: Real) {
    x > Real.0 and x.log = Option.some(Real.0) implies x = Real.1
}

theorem log_eq_zero_of_eq_one(x: Real) {
    x = Real.1 implies x.log = Option.some(Real.0)
}

theorem log_ne_zero_of_pos_ne_one(x: Real, y: Real) {
    x > Real.0 and x != Real.1 and x.log = Option.some(y) implies y != Real.0
}

theorem log_monotone(x: Real, y: Real, lx: Real, ly: Real) {
    x > Real.0 and y > Real.0 and x <= y and x.log = Option.some(lx) and y.log = Option.some(ly)
    implies lx <= ly
}

theorem log_strict_monotone(x: Real, y: Real, lx: Real, ly: Real) {
    x > Real.0 and y > Real.0 and x < y and x.log = Option.some(lx) and y.log = Option.some(ly)
    implies lx < ly
}

define positive_on(f: Nat -> Real, n: Nat) -> Bool {
    forall(i: Nat) { i < n implies f(i) > Real.0 }
}

theorem positive_on_prefix(f: Nat -> Real, n: Nat, m: Nat) {
    positive_on(f, n) and m <= n implies positive_on(f, m)
}

theorem positive_on_imp_nonnegative_on(f: Nat -> Real, n: Nat) {
    positive_on(f, n) implies nonnegative_on(f, n)
}

theorem finite_real_product_pos(f: Nat -> Real, n: Nat) {
    positive_on(f, n) implies finite_real_product(f, n) > Real.0
}

theorem partial_nonneg_bounded(f: Nat -> Real, n: Nat) {
    nonnegative_on(f, n) implies partial(f, n) >= Real.0
}

theorem add_nonneg_pos(a: Real, b: Real) {
    a >= Real.0 and b > Real.0 implies a + b > Real.0
}

theorem partial_pos_bounded(f: Nat -> Real, n: Nat) {
    positive_on(f, n) and n != Nat.0 implies partial(f, n) > Real.0
}

theorem recip_pos(x: Real) {
    x > Real.0 implies x.inverse > Real.0
}

theorem div_pos_of_pos_pos(x: Real, c: Real) {
    x > Real.0 and c > Real.0 implies x / c > Real.0
}

theorem div_nonneg_of_nonneg_pos(x: Real, c: Real) {
    x >= Real.0 and c > Real.0 implies x / c >= Real.0
}
