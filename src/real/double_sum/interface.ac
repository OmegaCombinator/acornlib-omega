theorem finite_real_product_zero_of_factor(f: Nat -> Real, n: Nat, i: Nat) {
    i < n and f(i) = Real.0 implies finite_real_product(f, n) = Real.0
}

define tri_fn(a: Real, b: Real, c: Real) -> (Nat -> Real) {
    function(i: Nat) {
        if i = Nat.0 {
            a
        } else {
            if i = Nat.1 {
                b
            } else {
                if i = Nat.2 {
                    c
                } else {
                    Real.0
                }
            }
        }
    }
}

theorem tri_fn_zero(a: Real, b: Real, c: Real) {
    tri_fn(a, b, c)(Nat.0) = a
}

theorem tri_fn_one(a: Real, b: Real, c: Real) {
    tri_fn(a, b, c)(Nat.1) = b
}

theorem tri_fn_two(a: Real, b: Real, c: Real) {
    tri_fn(a, b, c)(Nat.2) = c
}

define seq_eventually_positive(a: Nat -> Real) -> Bool {
    exists(n0: Nat) {
        forall(n: Nat) {
            n0 <= n implies a(n) > Real.0
        }
    }
}

define continuous_on_closed(f: Real -> Real, lower: Real, upper: Real) -> Bool {
    forall(x: Real) {
        closed_interval_set(lower, upper).contains(x) implies continuous_at(f, x)
    }
}

theorem lt_all_eps_imp_lte_zero(d: Real) {
    (forall(eps: Real) { eps.is_positive implies d < eps }) implies d <= Real.0
}

theorem close_le_zero_imp_lt_eps(q: Real, d: Real, eps: Real) {
    q.is_close(d, eps) and q <= Real.0 implies d < eps
}

theorem close_ge_zero_imp_neg_lt_eps(q: Real, d: Real, eps: Real) {
    q.is_close(d, eps) and Real.0 <= q implies -d < eps
}

theorem neg_le_zero_imp_ge_zero(x: Real) {
    -x <= Real.0 implies Real.0 <= x
}

theorem lte_imp_sub_le_zero(u: Real, v: Real) {
    u <= v implies u - v <= Real.0
}

theorem lte_imp_zero_le_sub(u: Real, v: Real) {
    u <= v implies Real.0 <= v - u
}

theorem pos_add_one_is_pos(x: Real) {
    x.is_positive implies (x + Real.1).is_positive
}

theorem abs_add_one_is_pos(x: Real) {
    (x.abs + Real.1).is_positive
}

theorem continuous_closed_interval_bounded_above(f: Real -> Real, a: Real, b: Real) {
    continuous_on_closed(f, a, b) and a < b
    implies exists(bound: Real) {
        forall(y: Real) {
            closed_interval_set(a, b).contains(y) implies f(y) <= bound
        }
    }
}

theorem continuous_closed_interval_attains_maximum(f: Real -> Real, a: Real, b: Real) {
    continuous_on_closed(f, a, b) and a < b
    implies exists(x0: Real) {
        closed_interval_set(a, b).contains(x0) and
        (forall(y: Real) { closed_interval_set(a, b).contains(y) implies f(y) <= f(x0) })
    }
}

theorem lte_imp_neg_lte_neg(a: Real, b: Real) {
    a <= b implies -b <= -a
}

theorem continuous_closed_interval_attains_minimum(f: Real -> Real, a: Real, b: Real) {
    continuous_on_closed(f, a, b) and a < b
    implies exists(x0: Real) {
        closed_interval_set(a, b).contains(x0) and
        (forall(y: Real) { closed_interval_set(a, b).contains(y) implies f(x0) <= f(y) })
    }
}

define peak_index(a: Nat -> Real, n: Nat) -> Nat {
    match n {
        Nat.zero { peak_after(a, Nat.0) }
        Nat.suc(pred) { peak_after(a, peak_index(a, pred)) }
    }
}

define strict_index(a: Nat -> Real, base: Nat, n: Nat) -> Nat {
    match n {
        Nat.zero { base }
        Nat.suc(pred) { strict_after(a, strict_index(a, base, pred)) }
    }
}

theorem peak_index_strict_at(a: Nat -> Real, n: Nat) {
    (forall(m: Nat) { exists(p: Nat) { m < p and is_peak(a, p) } })
    implies peak_index(a, n) < peak_index(a, n.suc)
}

theorem peak_index_later_le_at(a: Nat -> Real, n: Nat) {
    (forall(m: Nat) { exists(p: Nat) { m < p and is_peak(a, p) } })
    implies a(peak_index(a, n.suc)) <= a(peak_index(a, n))
}

theorem strict_index_strict_at(a: Nat -> Real, m0: Nat, n: Nat) {
    (forall(p: Nat) { m0 < p implies not is_peak(a, p) })
    implies strict_index(a, m0.suc, n) < strict_index(a, m0.suc, n.suc)
}

theorem strict_index_incr_at(a: Nat -> Real, m0: Nat, n: Nat) {
    (forall(p: Nat) { m0 < p implies not is_peak(a, p) })
    implies a(strict_index(a, m0.suc, n)) < a(strict_index(a, m0.suc, n.suc))
}

theorem bolzano_weierstrass(a: Nat -> Real) {
    exists(lo: Real, hi: Real) {
        forall(n: Nat) { lo <= a(n) and a(n) <= hi }
    } implies
        exists(f: Nat -> Nat, l: Real) {
            is_monotone(f) and is_unbounded(f) and converges_to(subsequence(a, f), l)
        }
}

define convex_on(f: Real -> Real, a: Real, b: Real) -> Bool {
    forall(x: Real, y: Real, t: Real) {
        a <= x and x <= y and y <= b and Real.0 <= t and t <= Real.1
        implies f((Real.1 - t) * x + t * y) <= (Real.1 - t) * f(x) + t * f(y)
    }
}

theorem convex_on_apply(f: Real -> Real, a: Real, b: Real, x: Real, y: Real, t: Real) {
    convex_on(f, a, b) and a <= x and x <= y and y <= b and Real.0 <= t and t <= Real.1
    implies f((Real.1 - t) * x + t * y) <= (Real.1 - t) * f(x) + t * f(y)
}

theorem sub_sub_cancel(a: Real, b: Real, c: Real) {
    (a - b) - (a - c) = c - b
}

theorem sub_minus_sub(a: Real, b: Real) {
    a - (a - b) = b
}

theorem one_minus_t_bounds(t: Real) {
    Real.0 <= t and t <= Real.1 implies Real.0 <= Real.1 - t and Real.1 - t <= Real.1
}

theorem convex_weighted_inequality(f: Real -> Real, a: Real, b: Real, x: Real, y: Real, t: Real) {
    convex_on(f, a, b) and a <= x and x <= b and a <= y and y <= b and Real.0 <= t and t <= Real.1
    implies f(t * x + (Real.1 - t) * y) <= t * f(x) + (Real.1 - t) * f(y)
}

theorem convex_combination_between(x: Real, y: Real, z: Real, t: Real) {
    x < y and Real.0 < t and t < Real.1 and z = (Real.1 - t) * x + t * y
    implies x < z and z < y
}

define darboux_aux(f: Real -> Real, t: Real) -> (Real -> Real) {
    pointwise_add(f, pointwise_neg(affine_real(t, Real.0)))
}

theorem darboux_aux_value(f: Real -> Real, t: Real, x: Real) {
    darboux_aux(f, t, x) = f(x) - t * x
}

theorem add_sub_cancel_shift(a: Real, b: Real) {
    a + (b - a) = b
}

theorem sub_add_cancel_shift(a: Real, x: Real, y: Real) {
    (a + x) - (a + y) = x - y
}

theorem add_one_mul_sub(u: Real, h: Real) {
    (u + Real.1) * h - u * h = h
}

theorem jensen_weight_zero_of_partial_zero(w: Nat -> Real, n: Nat, i: Nat) {
    (forall(j: Nat) { Real.0 <= w(j) }) and partial(w, n) = Real.0 and i < n implies w(i) = Real.0
}

theorem convex_combination_in_closed_interval(a: Real, b: Real, u: Real, v: Real, t: Real) {
    a <= u and u <= b and a <= v and v <= b and Real.0 <= t and t <= Real.1
    implies a <= (Real.1 - t) * u + t * v and (Real.1 - t) * u + t * v <= b
}

theorem jensen_weights_split(w: Nat -> Real, n: Nat) {
    partial(w, n.suc) = Real.1 implies partial(w, n) = Real.1 - w(n)
}

define jensen_claim_at(f: Real -> Real, a: Real, b: Real, k: Nat, w0: Nat -> Real, x0: Nat -> Real) -> Bool {
    (forall(i: Nat) { Real.0 <= w0(i) }) and partial(w0, k) = Real.1 and
    jensen_points_in_interval(a, b, x0, k)
    implies (a <= weighted_point_sum(w0, x0, k) and weighted_point_sum(w0, x0, k) <= b) and
        f(weighted_point_sum(w0, x0, k)) <= weighted_value_sum(f, w0, x0, k)
}

define jensen_claim(f: Real -> Real, a: Real, b: Real, k: Nat) -> Bool {
    forall(w0: Nat -> Real, x0: Nat -> Real) {
        jensen_claim_at(f, a, b, k, w0, x0)
    }
}

theorem jensen_claim_apply(f: Real -> Real, a: Real, b: Real, k: Nat, w0: Nat -> Real, x0: Nat -> Real) {
    jensen_claim(f, a, b, k) implies jensen_claim_at(f, a, b, k, w0, x0)
}

theorem jensen_convex_inequality(f: Real -> Real, a: Real, b: Real, w: Nat -> Real, x: Nat -> Real, n: Nat) {
    convex_on(f, a, b) and (forall(i: Nat) { Real.0 <= w(i) }) and partial(w, n) = Real.1 and
    jensen_points_in_interval(a, b, x, n)
    implies f(weighted_point_sum(w, x, n)) <= weighted_value_sum(f, w, x, n)
}

define limit_at(f: Real -> Real, a: Real, l: Real) -> Bool {
    forall(q: Nat -> Real) {
        (forall(n: Nat) { q(n) != a }) and converges_to(q, a)
        implies converges_to(compose(f, q), l)
    }
}

define cauchy_combination(f: Real -> Real, g: Real -> Real, a: Real, b: Real, x: Real) -> Real {
    (f(b) - f(a)) * g(x) - (g(b) - g(a)) * f(x)
}

define cauchy_combination_derivative(f: Real -> Real, g: Real -> Real, df: Real -> Real,
    dg: Real -> Real, a: Real, b: Real, x: Real) -> Real {
    (f(b) - f(a)) * dg(x) - (g(b) - g(a)) * df(x)
}

theorem cauchy_combination_eq_pointwise(f: Real -> Real, g: Real -> Real, a: Real, b: Real) {
    cauchy_combination(f, g, a, b) = pointwise_add(
        pointwise_mul(constant[Real, Real](f(b) - f(a)), g),
        pointwise_mul(constant[Real, Real](-(g(b) - g(a))), f))
}

theorem cauchy_combination_continuous_on_closed(f: Real -> Real, g: Real -> Real,
    a: Real, b: Real) {
    continuous(f) and continuous(g)
    implies continuous_on_closed(cauchy_combination(f, g, a, b), a, b)
}

theorem neg_sub_distrib(x: Real, y: Real) {
    -(x - y) = -x + y
}

theorem sub_sub_distrib(x: Real, y: Real, z: Real) {
    x - (y - z) = x - y + z
}

theorem sub_self_zero(x: Real) {
    x - x = Real.0
}

theorem cauchy_combination_endpoints_equal(f: Real -> Real, g: Real -> Real,
    a: Real, b: Real) {
    cauchy_combination(f, g, a, b, a) = cauchy_combination(f, g, a, b, b)
}

theorem seq_pointwise_eq_converges_to(u: Nat -> Real, v: Nat -> Real, x: Real) {
    (forall(n: Nat) { u(n) = v(n) }) and converges_to(u, x)
    implies converges_to(v, x)
}

theorem limit_at_seq(f: Real -> Real, a: Real, l: Real, q: Nat -> Real) {
    limit_at(f, a, l) and (forall(n: Nat) { q(n) != a }) and converges_to(q, a)
    implies converges_to(compose(f, q), l)
}

theorem converges_to_add_seq(a: Nat -> Real, b: Nat -> Real, a_lim: Real, b_lim: Real) {
    converges_to(a, a_lim) and converges_to(b, b_lim)
    implies converges_to(add_seq(a, b), a_lim + b_lim)
}

theorem converges_to_prod_seq(a: Nat -> Real, b: Nat -> Real, a_lim: Real, b_lim: Real) {
    converges_to(a, a_lim) and converges_to(b, b_lim)
    implies converges_to(prod_seq(a, b), a_lim * b_lim)
}

theorem continuous_at_imp_limit_at(f: Real -> Real, a: Real) {
    continuous_at(f, a) implies limit_at(f, a, f(a))
}

theorem limit_at_add_fns(f: Real -> Real, g: Real -> Real, a: Real, l: Real, m: Real) {
    limit_at(f, a, l) and limit_at(g, a, m)
    implies limit_at(add_fns(f, g), a, l + m)
}

theorem limit_at_pointwise_mul(f: Real -> Real, g: Real -> Real, a: Real, l: Real, m: Real) {
    limit_at(f, a, l) and limit_at(g, a, m)
    implies limit_at(pointwise_mul[Real, Real](f, g), a, l * m)
}

theorem limit_at_compose_continuous(f: Real -> Real, g: Real -> Real, a: Real, b: Real) {
    limit_at(f, a, b) and continuous_at(g, b)
    implies limit_at(compose(g, f), a, g(b))
}

theorem limit_at_compose(f: Real -> Real, g: Real -> Real, a: Real, b: Real, m: Real) {
    limit_at(f, a, b) and limit_at(g, b, m) and
    (forall(x: Real) { x != a implies f(x) != b })
    implies limit_at(compose(g, f), a, m)
}

theorem limit_at_const(c: Real, a: Real) {
    limit_at(constant[Real, Real](c), a, c)
}

theorem limit_at_const_mul(f: Real -> Real, a: Real, l: Real, c: Real) {
    limit_at(f, a, l)
    implies limit_at(pointwise_mul[Real, Real](constant[Real, Real](c), f), a, c * l)
}

define lipschitz_with(f: Real -> Real, k: Real) -> Bool {
    Real.0 < k and forall(x: Real, y: Real) {
        (f(x) - f(y)).abs <= k * (x - y).abs
    }
}

define is_lipschitz(f: Real -> Real) -> Bool {
    exists(k: Real) {
        lipschitz_with(f, k)
    }
}

theorem lipschitz_with_pos_const(f: Real -> Real, k: Real) {
    lipschitz_with(f, k) implies Real.0 < k
}

theorem lipschitz_with_apply(f: Real -> Real, k: Real, x0: Real, y0: Real) {
    lipschitz_with(f, k) implies (f(x0) - f(y0)).abs <= k * (x0 - y0).abs
}

theorem lipschitz_imp_uniform(f: Real -> Real, k: Real) {
    lipschitz_with(f, k) implies uniform(f)
}

theorem lipschitz_imp_continuous(f: Real -> Real, k: Real) {
    lipschitz_with(f, k) implies continuous(f)
}

theorem three_pos {
    three > Real.0
}

define abs_product(a: Nat -> Real, b: Nat -> Real, i: Nat) -> Real {
    (a(i) * b(i)).abs
}

theorem gt_one_imp_pos(x: Real) {
    x > Real.1 implies x > Real.0
}

theorem abs_product_symm(a: Nat -> Real, b: Nat -> Real, n: Nat) {
    partial(abs_product(a, b), n) = partial(abs_product(b, a), n)
}

theorem sub_one_pos(x: Real) {
    x > Real.1 implies x - Real.1 > Real.0
}

theorem abs_eq_self_of_nonneg(x: Real) {
    x >= Real.0 implies x.abs = x
}

theorem abs_mul_nonneg_val(x: Real, y: Real) {
    y >= Real.0 implies (x * y).abs = x.abs * y
}

define recip_fn(f: Nat -> Real, i: Nat) -> Real {
    Real.1 / f(i)
}

theorem positive_on_recip(f: Nat -> Real, n: Nat) {
    positive_on(f, n) implies positive_on(recip_fn(f), n)
}

define power_series_term(a: Nat -> Real, x: Real, k: Nat) -> Real {
    a(k) * x.pow(k)
}

theorem pow_mul_distrib(x: Real, y: Real, n: Nat) {
    (x * y).pow(n) = x.pow(n) * y.pow(n)
}

theorem series_conv_imp_terms_bounded(a: Nat -> Real) {
    converges(partial(a)) implies is_bounded_seq(a)
}

theorem abs_pos_of_ne_zero(x: Real) {
    x != Real.0 implies x.abs > Real.0
}

theorem abs_pow_abs(x: Real, n: Nat) {
    x.pow(n).abs = x.abs.pow(n)
}

theorem power_series_abs_conv_inside_radius(a: Nat -> Real, x: Real, x0: Real) {
    converges(partial(power_series_term(a, x0))) and x0 != Real.0 and x.abs < x0.abs
    implies absolutely_converges(power_series_term(a, x))
}

define sbp_step(f: Nat -> Real, g: Nat -> Real, k: Nat) -> Real {
    partial(f, k.suc) * (g(k.suc) - g(k))
}

theorem mul_sub_cancel(a: Real, b: Real, c: Real) {
    a * b - a * (b - c) = a * c
}

theorem sub_add_rearrange(a: Real, b: Real, c: Real, d: Real) {
    a + b - (c + d) = (a - c) + (b - d)
}

theorem summation_by_parts(f: Nat -> Real, g: Nat -> Real, n: Nat) {
    partial(prod_seq(f, g), n) =
        partial(f, n) * g(n) - sum(map(n.range, sbp_step(f, g)))
}

theorem square_gap_imp_double_le(q: Real, p: Real, r: Real) {
    q + -p + (-p + r) >= Real.0 implies p + p <= q + r
}

theorem double_mul_le_square_sum(x: Real, y: Real) {
    x * y + x * y <= x * x + y * y
}

theorem double_mul_eq_square_sum_imp_eq(x: Real, y: Real) {
    x * y + x * y = x * x + y * y implies x = y
}

theorem square_le_square_of_nonneg(a: Real, b: Real) {
    a >= Real.0 and b >= Real.0 and a * a <= b * b implies a <= b
}

let taylor_two: Real = Real.1 + Real.1

theorem taylor_two_not_zero {
    taylor_two != Real.0
}

define taylor2_lin(f: Real -> Real, df: Real -> Real, a: Real, x: Real) -> Real {
    f(a) + df(a) * (x - a)
}

define taylor2_lin_remainder(f: Real -> Real, df: Real -> Real, a: Real, x: Real) -> Real {
    f(x) - taylor2_lin(f, df, a, x)
}

define taylor2_sq(a: Real, x: Real) -> Real {
    square_real(x - a)
}

define taylor2_delta(f: Real -> Real, df: Real -> Real, a: Real, b: Real) -> Real {
    f(b) - f(a) - df(a) * (b - a)
}

define taylor2_aux(f: Real -> Real, df: Real -> Real, a: Real, b: Real, x: Real) -> Real {
    square_real(b - a) * taylor2_lin_remainder(f, df, a, x) -
        taylor2_delta(f, df, a, b) * taylor2_sq(a, x)
}

define taylor2_aux_derivative(f: Real -> Real, df: Real -> Real, a: Real, b: Real, x: Real) -> Real {
    square_real(b - a) * (df(x) - df(a)) -
        taylor2_delta(f, df, a, b) * taylor_two * (x - a)
}

define taylor2_aux_second_derivative(f: Real -> Real, df: Real -> Real, ddf: Real -> Real, a: Real, b: Real, x: Real) -> Real {
    square_real(b - a) * ddf(x) -
        taylor2_delta(f, df, a, b) * taylor_two
}

theorem taylor2_aux_eq_pointwise(f: Real -> Real, df: Real -> Real, a: Real, b: Real) {
    taylor2_aux(f, df, a, b) = pointwise_add(
        pointwise_mul(constant[Real, Real](square_real(b - a)),
            pointwise_add(f, pointwise_neg(affine_real(df(a), f(a) - df(a) * a)))),
        pointwise_neg(pointwise_mul(constant[Real, Real](taylor2_delta(f, df, a, b)),
            compose(square_real, affine_real(Real.1, -a)))))
}

theorem taylor2_aux_derivative_eq_pointwise(f: Real -> Real, df: Real -> Real, a: Real, b: Real) {
    taylor2_aux_derivative(f, df, a, b) = pointwise_add(
        pointwise_mul(constant[Real, Real](square_real(b - a)),
            pointwise_add(df, pointwise_neg(constant[Real, Real](df(a))))),
        pointwise_neg(pointwise_mul(constant[Real, Real](taylor2_delta(f, df, a, b) * taylor_two),
            affine_real(Real.1, -a))))
}

theorem taylor2_aux_at_a_zero(f: Real -> Real, df: Real -> Real, a: Real, b: Real) {
    taylor2_aux(f, df, a, b, a) = Real.0
}

theorem taylor2_aux_at_b_zero(f: Real -> Real, df: Real -> Real, a: Real, b: Real) {
    taylor2_aux(f, df, a, b, b) = Real.0
}

theorem taylor2_aux_endpoints_equal(f: Real -> Real, df: Real -> Real, a: Real, b: Real) {
    taylor2_aux(f, df, a, b, a) = taylor2_aux(f, df, a, b, b)
}

theorem taylor2_aux_derivative_at_a_zero(f: Real -> Real, df: Real -> Real, a: Real, b: Real) {
    taylor2_aux_derivative(f, df, a, b, a) = Real.0
}

theorem taylor2_sub_add_cancel(a: Real, b: Real) {
    (a - b) + b = a
}

theorem taylor2_sub_sub_add(a: Real, b: Real, c: Real) {
    (a - b - c) + b = a - c
}

define newton_step(f: Real -> Real, fp: Real -> Real, x: Real) -> Real {
    x - f(x) / fp(x)
}

define newton_seq(f: Real -> Real, fp: Real -> Real, x0: Real, n: Nat) -> Real {
    match n {
        Nat.zero {
            x0
        }
        Nat.suc(m) {
            newton_step(f, fp, newton_seq(f, fp, x0, m))
        }
    }
}

theorem newton_seq_zero(f: Real -> Real, fp: Real -> Real, x0: Real) {
    newton_seq(f, fp, x0, Nat.0) = x0
}

theorem newton_seq_suc(f: Real -> Real, fp: Real -> Real, x0: Real, n: Nat) {
    newton_seq(f, fp, x0, n.suc) = newton_step(f, fp, newton_seq(f, fp, x0, n))
}

theorem newton_step_root_fixed_point(f: Real -> Real, fp: Real -> Real, xstar: Real) {
    f(xstar) = Real.0 and fp(xstar) != Real.0 implies
        newton_step(f, fp, xstar) = xstar
}

theorem newton_seq_root_constant(f: Real -> Real, fp: Real -> Real, xstar: Real) {
    f(xstar) = Real.0 and fp(xstar) != Real.0 implies
        forall(n: Nat) { newton_seq(f, fp, xstar, n) = xstar }
}

theorem newton_taylor_two_pos {
    taylor_two > Real.0
}

let taylor_three: Real = Real.1 + Real.1 + Real.1

let taylor_six: Real = taylor_two * taylor_three

theorem from_nat_two_real {
    from_nat[Real](Nat.2) = taylor_two
}

theorem from_nat_three_real {
    from_nat[Real](Nat.3) = taylor_three
}

theorem from_nat_six_real {
    from_nat[Real](Nat.6) = taylor_six
}

theorem taylor_three_not_zero {
    taylor_three != Real.0
}

theorem taylor_six_not_zero {
    taylor_six != Real.0
}

define taylor_chain1(f: Real -> Real, df: Real -> Real, k: Nat) -> Real -> Real {
    match k {
        Nat.zero { f }
        Nat.suc(m) { df }
