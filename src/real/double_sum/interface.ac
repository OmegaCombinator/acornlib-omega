theorem derived_set_subset_isolated_set_complement(s: Set[Real]) {
    derived_set(s).subset(isolated_set(s).c)
}

theorem isolated_set_disjoint_derived_set(s: Set[Real]) {
    isolated_set(s).is_disjoint(derived_set(s))
}

theorem derived_set_disjoint_isolated_set(s: Set[Real]) {
    derived_set(s).is_disjoint(isolated_set(s))
}

theorem isolated_set_intersection_derived_set_eq_empty(s: Set[Real]) {
    isolated_set(s).intersection(derived_set(s)) = Set[Real].empty_set
}

theorem derived_set_intersection_isolated_set_eq_empty(s: Set[Real]) {
    derived_set(s).intersection(isolated_set(s)) = Set[Real].empty_set
}

theorem empty_real_set_is_perfect {
    is_perfect_real_set(Set[Real].empty_set)
}

theorem closed_set_with_subset_derived_set_is_perfect(s: Set[Real]) {
    is_closed_set(s) and s.subset(derived_set(s)) implies is_perfect_real_set(s)
}

theorem member_not_in_derived_set_is_isolated_point(s: Set[Real], x: Real) {
    s.contains(x) and not derived_set(s).contains(x) implies is_isolated_point_of_set(s, x)
}

theorem member_not_in_derived_set_is_isolated_set_member(s: Set[Real], x: Real) {
    s.contains(x) and not derived_set(s).contains(x) implies isolated_set(s).contains(x)
}

theorem subset_derived_union_isolated_set(s: Set[Real]) {
    s.subset(derived_set(s).union(isolated_set(s)))
}

theorem closed_set_eq_derived_union_isolated_set(s: Set[Real]) {
    is_closed_set(s) implies s = derived_set(s).union(isolated_set(s))
}

theorem closed_set_with_empty_isolated_set_is_perfect(s: Set[Real]) {
    is_closed_set(s) and isolated_set(s).is_empty implies is_perfect_real_set(s)
}

define tri_row_sum(f: (Nat, Nat) -> Real, n: Nat, i: Nat) -> Real {
    partial(f(i), n - i)
}

define diagonal(f: (Nat, Nat) -> Real, n: Nat, i: Nat) -> Real {
    f(i, n - i)
}

define diagonal_sum(f: (Nat, Nat) -> Real, n: Nat) -> Real {
    partial(diagonal(f, n), n.suc)
}

define triangular_sum(f: (Nat, Nat) -> Real, n: Nat) -> Real {
    partial(tri_row_sum(f, n), n)
}

define triangular_sum_seq(f: (Nat, Nat) -> Real, n: Nat) -> Real {
    triangular_sum(f, n)
}

theorem triangular_sum_zero(f: (Nat, Nat) -> Real) {
    triangular_sum(f, Nat.0) = Real.0
}

theorem triangular_sum_nonneg(f: (Nat, Nat) -> Real, n: Nat) {
    nonneg_fn_2(f)
    implies
    triangular_sum(f, n) >= Real.0
}

theorem triangular_sum_step(f: (Nat, Nat) -> Real, n: Nat) {
    triangular_sum(f, n.suc) = triangular_sum(f, n) + diagonal_sum(f, n)
}

theorem triangular_sum_monotone(f: (Nat, Nat) -> Real, g: (Nat, Nat) -> Real, n: Nat) {
    lte_fn_2(f, g)
    implies
    triangular_sum(f, n) <= triangular_sum(g, n)
}

theorem triangular_sum_add(f: (Nat, Nat) -> Real, g: (Nat, Nat) -> Real, n: Nat) {
    triangular_sum(add_fn_2(f, g), n)
    =
    triangular_sum(f, n) + triangular_sum(g, n)
}

theorem triangular_sum_scale(c: Real, f: (Nat, Nat) -> Real, n: Nat) {
    triangular_sum(scalar_mul_fn_2(c, f), n)
    =
    c * triangular_sum(f, n)
}

theorem triangular_sum_sub(f: (Nat, Nat) -> Real, g: (Nat, Nat) -> Real, n: Nat) {
    triangular_sum(sub_fn_2(f, g), n)
    =
    triangular_sum(f, n) - triangular_sum(g, n)
}

theorem triangular_sum_upper_bound(f: (Nat, Nat) -> Real, bound: Real, n: Nat) {
    nonneg_fn_2(f) and is_upper_bound_fn_2(f, bound)
    implies
    triangular_sum(f, n) <= triangular_sum(const_fn_2(bound), n)
}

theorem triangular_sum_increasing(f: (Nat, Nat) -> Real, n: Nat) {
    nonneg_fn_2(f)
    implies
    triangular_sum(f, n) <= triangular_sum(f, n.suc)
}

theorem triangular_sum_is_increasing(f: (Nat, Nat) -> Real) {
    nonneg_fn_2(f)
    implies
    is_increasing(triangular_sum_seq(f))
}

theorem triangular_sum_is_monotone(f: (Nat, Nat) -> Real) {
    nonneg_fn_2(f)
    implies
    is_monotone(triangular_sum_seq(f))
}

theorem triangular_sum_const_step(c: Real, n: Nat) {
    triangular_sum(const_fn_2(c), n.suc) = triangular_sum(const_fn_2(c), n) + c * nat_to_real(n.suc)
}

theorem triangular_sum_const(c: Real, n: Nat) {
    triangular_sum(const_fn_2(c), n) = c * nat_to_real(n) * nat_to_real(n.suc) * Real.one_half
}

theorem triangular_sum_le_rectangular(f: (Nat, Nat) -> Real, n: Nat) {
    nonneg_fn_2(f)
    implies
    triangular_sum(f, n) <= rectangular_sum(f, n, n)
}

theorem diagonal_sum_flip(f: (Nat, Nat) -> Real, n: Nat) {
    diagonal_sum(flip(f), n) = diagonal_sum(f, n)
}

theorem triangular_sum_flip(f: (Nat, Nat) -> Real, n: Nat) {
    triangular_sum(flip(f), n) = triangular_sum(f, n)
}

theorem partial_split(g: Nat -> Real, n: Nat, k: Nat) {
    partial(g, n + k) = partial(g, n) + partial(shift_fn(g, n), k)
}

theorem triangular_sum_decomposition(f: (Nat, Nat) -> Real, m: Nat, n: Nat) {
    triangular_sum(f, m + n) =
        rectangular_sum(f, m, n) +
        triangular_sum(shift_cols(f, n), m) +
        triangular_sum(shift_rows(f, m), n)
}

theorem rectangular_sum_le_triangular(f: (Nat, Nat) -> Real, m: Nat, n: Nat) {
    nonneg_fn_2(f)
    implies
    rectangular_sum(f, m, n) <= triangular_sum(f, m + n)
}

theorem triangular_sum_ge_square_sum(f: (Nat, Nat) -> Real, n: Nat) {
    nonneg_fn_2(f)
    implies
    square_sum(f, n) <= triangular_sum(f, n + n)
}

theorem triangular_sum_le_square_sum(f: (Nat, Nat) -> Real, n: Nat) {
    nonneg_fn_2(f)
    implies
    triangular_sum(f, n) <= square_sum(f, n)
}

theorem triangular_sum_converges_to_double_sum(f: (Nat, Nat) -> Real) {
    nonneg_fn_2(f) and double_sum_converges(f)
    implies
    converges_to(triangular_sum(f), double_sum(f))
}

define abs_double_sum_converges(f: (Nat, Nat) -> Real) -> Bool {
    double_sum_converges(abs_fn_2(f))
}

theorem triangular_sum_decomposition_parts(f: (Nat, Nat) -> Real, n: Nat) {
    triangular_sum(f, n) = triangular_sum(pos_part_2(f), n) - triangular_sum(neg_part_2(f), n)
}

theorem triangular_sum_pos_part_le_abs(f: (Nat, Nat) -> Real, n: Nat) {
    triangular_sum(pos_part_2(f), n) <= triangular_sum(abs_fn_2(f), n)
}

theorem triangular_sum_neg_part_le_abs(f: (Nat, Nat) -> Real, n: Nat) {
    triangular_sum(neg_part_2(f), n) <= triangular_sum(abs_fn_2(f), n)
}

theorem abs_conv_pos_part_converges(f: (Nat, Nat) -> Real, s: Real) {
    double_image_is_supremum(rectangular_sum(abs_fn_2(f)), s)
    implies
    double_sum_converges(pos_part_2(f))
}

theorem abs_conv_neg_part_converges(f: (Nat, Nat) -> Real, s: Real) {
    double_image_is_supremum(rectangular_sum(abs_fn_2(f)), s)
    implies
    double_sum_converges(neg_part_2(f))
}

theorem triangular_sum_abs_converges_to_double_sum(f: (Nat, Nat) -> Real, s: Real, s_pos: Real, s_neg: Real) {
    double_image_is_supremum(rectangular_sum(abs_fn_2(f)), s) and
    double_image_is_supremum(rectangular_sum(pos_part_2(f)), s_pos) and
    double_image_is_supremum(rectangular_sum(neg_part_2(f)), s_neg)
    implies
    converges_to(triangular_sum(f), double_sum(f))
}

theorem triangular_sum_add_distrib(f: (Nat, Nat) -> Real, g: (Nat, Nat) -> Real, n: Nat) {
    triangular_sum(add_fn_2(f, g), n) = triangular_sum(f, n) + triangular_sum(g, n)
}

theorem triangular_sum_scale_left(c: Real, f: (Nat, Nat) -> Real, n: Nat) {
    triangular_sum(scalar_mul_fn_2(c, f), n) = c * triangular_sum(f, n)
}

theorem triangular_sum_le_of_lte_fn(f: (Nat, Nat) -> Real, g: (Nat, Nat) -> Real, n: Nat) {
    lte_fn_2(f, g) implies triangular_sum(f, n) <= triangular_sum(g, n)
}

theorem triangular_sum_step_nonneg(f: (Nat, Nat) -> Real, n: Nat) {
    nonneg_fn_2(f) implies triangular_sum(f, n) <= triangular_sum(f, n.suc)
}

theorem triangular_sum_seq_monotone(f: (Nat, Nat) -> Real) {
    nonneg_fn_2(f) implies is_monotone(triangular_sum_seq(f))
}

theorem triangular_sum_bound_by_square(f: (Nat, Nat) -> Real, n: Nat) {
    nonneg_fn_2(f) implies triangular_sum(f, n) <= square_sum(f, n)
}

theorem square_sum_bound_by_triangular_double(f: (Nat, Nat) -> Real, n: Nat) {
    nonneg_fn_2(f) implies square_sum(f, n) <= triangular_sum(f, n + n)
}

theorem triangular_sum_split_rectangles(f: (Nat, Nat) -> Real, m: Nat, n: Nat) {
    triangular_sum(f, m + n) =
        rectangular_sum(f, m, n) +
        triangular_sum(shift_cols(f, n), m) +
        triangular_sum(shift_rows(f, m), n)
}

define cauchy_coefficient(a: Nat -> Real, b: Nat -> Real, n: Nat) -> (Nat -> Real) {
    function(k: Nat) { a(k) * b(n - k) }
}

define cauchy_product(a: Nat -> Real, b: Nat -> Real, n: Nat) -> Real {
    sum(map(n.suc.range, cauchy_coefficient(a, b, n)))
}

define cauchy_seq(a: Nat -> Real, b: Nat -> Real) -> (Nat -> Real) {
    function(n: Nat) { cauchy_product(a, b, n) }
}

theorem cauchy_product_zero(a: Nat -> Real, b: Nat -> Real) {
    cauchy_product(a, b, Nat.0) = a(Nat.0) * b(Nat.0)
}

theorem sum_map_zero[T](items: List[T], f: T -> Real) {
    (forall(x: T) { f(x) = Real.0 })
    implies
    sum(map(items, f)) = Real.0
}

theorem cauchy_coefficient_zero_left(b: Nat -> Real, n: Nat, k: Nat) {
    cauchy_coefficient(constant[Nat, Real](Real.0), b, n)(k) = Real.0
}

theorem cauchy_coefficient_zero_left_fn(b: Nat -> Real, n: Nat) {
    cauchy_coefficient(constant[Nat, Real](Real.0), b, n) = constant[Nat, Real](Real.0)
}

theorem cauchy_coefficient_zero_right(a: Nat -> Real, n: Nat, k: Nat) {
    cauchy_coefficient(a, constant[Nat, Real](Real.0), n)(k) = Real.0
}

theorem cauchy_coefficient_zero_right_fn(a: Nat -> Real, n: Nat) {
    cauchy_coefficient(a, constant[Nat, Real](Real.0), n) = constant[Nat, Real](Real.0)
}

theorem cauchy_reverse_map_eq(a: Nat -> Real, b: Nat -> Real, n: Nat) {
    reverse(map(n.suc.range, cauchy_coefficient(a, b, n))) =
    map(n.suc.range, cauchy_coefficient(b, a, n))
}

theorem cauchy_product_comm(a: Nat -> Real, b: Nat -> Real, n: Nat) {
    cauchy_product(a, b, n) = cauchy_product(b, a, n)
}

theorem cauchy_product_zero_left(b: Nat -> Real, n: Nat) {
    cauchy_product(constant[Nat, Real](Real.0), b, n) = Real.0
}

theorem cauchy_product_zero_right(a: Nat -> Real, n: Nat) {
    cauchy_product(a, constant[Nat, Real](Real.0), n) = Real.0
}

theorem cauchy_coefficient_scalar_left(c: Real, a: Nat -> Real, b: Nat -> Real, n: Nat, k: Nat) {
    cauchy_coefficient(mul_fn(c, a), b, n)(k) = c * cauchy_coefficient(a, b, n)(k)
}

theorem cauchy_product_scalar_left(c: Real, a: Nat -> Real, b: Nat -> Real, n: Nat) {
    cauchy_product(mul_fn(c, a), b, n) = c * cauchy_product(a, b, n)
}

theorem cauchy_coefficient_scalar_right(c: Real, a: Nat -> Real, b: Nat -> Real, n: Nat, k: Nat) {
    cauchy_coefficient(a, mul_fn(c, b), n)(k) = c * cauchy_coefficient(a, b, n)(k)
}

theorem cauchy_product_scalar_right(c: Real, a: Nat -> Real, b: Nat -> Real, n: Nat) {
    cauchy_product(a, mul_fn(c, b), n) = c * cauchy_product(a, b, n)
}

theorem cauchy_coefficient_add_left(a: Nat -> Real, aa: Nat -> Real, b: Nat -> Real, n: Nat, k: Nat) {
    cauchy_coefficient(add_fn(a, aa), b, n)(k) = cauchy_coefficient(a, b, n)(k) + cauchy_coefficient(aa, b, n)(k)
}

theorem cauchy_product_add_left(a: Nat -> Real, aa: Nat -> Real, b: Nat -> Real, n: Nat) {
    cauchy_product(add_fn(a, aa), b, n) = cauchy_product(a, b, n) + cauchy_product(aa, b, n)
}

theorem cauchy_coefficient_add_right(a: Nat -> Real, b: Nat -> Real, bb: Nat -> Real, n: Nat, k: Nat) {
    cauchy_coefficient(a, add_fn(b, bb), n)(k) = cauchy_coefficient(a, b, n)(k) + cauchy_coefficient(a, bb, n)(k)
}

theorem cauchy_product_add_right(a: Nat -> Real, b: Nat -> Real, bb: Nat -> Real, n: Nat) {
    cauchy_product(a, add_fn(b, bb), n) = cauchy_product(a, b, n) + cauchy_product(a, bb, n)
}

theorem partial_cauchy_zero_left(b: Nat -> Real, n: Nat) {
    partial(cauchy_seq(constant[Nat, Real](Real.0), b), n) = Real.0
}

theorem partial_cauchy_zero_right(a: Nat -> Real, n: Nat) {
    partial(cauchy_seq(a, constant[Nat, Real](Real.0)), n) = Real.0
}

theorem partial_cauchy_add_left(a: Nat -> Real, aa: Nat -> Real, b: Nat -> Real, n: Nat) {
    partial(cauchy_seq(add_fn(a, aa), b), n) = partial(cauchy_seq(a, b), n) + partial(cauchy_seq(aa, b), n)
}

theorem partial_cauchy_add_right(a: Nat -> Real, b: Nat -> Real, bb: Nat -> Real, n: Nat) {
    partial(cauchy_seq(a, add_fn(b, bb)), n) = partial(cauchy_seq(a, b), n) + partial(cauchy_seq(a, bb), n)
}

theorem partial_cauchy_scalar_left(c: Real, a: Nat -> Real, b: Nat -> Real, n: Nat) {
    partial(cauchy_seq(mul_fn(c, a), b), n) = c * partial(cauchy_seq(a, b), n)
}

theorem partial_cauchy_scalar_right(c: Real, a: Nat -> Real, b: Nat -> Real, n: Nat) {
    partial(cauchy_seq(a, mul_fn(c, b)), n) = c * partial(cauchy_seq(a, b), n)
}

theorem cauchy_coefficient_eq_diagonal(a: Nat -> Real, b: Nat -> Real, n: Nat, k: Nat) {
    cauchy_coefficient(a, b, n)(k) = diagonal(prod_fn(a, b), n, k)
}

theorem cauchy_product_eq_diagonal(a: Nat -> Real, b: Nat -> Real, n: Nat) {
    cauchy_product(a, b, n) = diagonal_sum(prod_fn(a, b), n)
}

define cauchy_triangular(a: Nat -> Real, b: Nat -> Real, k: Nat) -> Real {
    triangular_sum(prod_fn(a, b), k.suc)
}

theorem cauchy_product_eq_triangular(a: Nat -> Real, b: Nat -> Real, k: Nat) {
    partial(cauchy_seq(a, b), k.suc) = cauchy_triangular(a, b, k)
}

theorem abs_prod_fn(a: Nat -> Real, b: Nat -> Real, m: Nat, n: Nat) {
    abs_fn_2(prod_fn(a, b), m, n) = abs_fn(a, m) * abs_fn(b, n)
}

theorem rectangular_abs_product(a: Nat -> Real, b: Nat -> Real, m: Nat, n: Nat) {
    rectangular_sum(abs_fn_2(prod_fn(a, b)), m, n) = partial(abs_fn(a), m) * partial(abs_fn(b), n)
}

theorem square_sum_abs_product(a: Nat -> Real, b: Nat -> Real, n: Nat) {
    square_sum(abs_fn_2(prod_fn(a, b)), n) = partial(abs_fn(a), n) * partial(abs_fn(b), n)
}

theorem rectangular_bounded_by_square_case1(f: (Nat, Nat) -> Real, m: Nat, n: Nat) {
    nonneg_fn_2(f) and m <= n
    implies
    rectangular_sum(f, m, n) <= square_sum(f, n)
}

theorem rectangular_bounded_by_square_case2(f: (Nat, Nat) -> Real, m: Nat, n: Nat) {
    nonneg_fn_2(f) and n <= m
    implies
    rectangular_sum(f, m, n) <= square_sum(f, m)
}

theorem product_abs_convergent(a: Nat -> Real, b: Nat -> Real) {
    absolutely_converges(a) and absolutely_converges(b)
    implies
    double_sum_converges(abs_fn_2(prod_fn(a, b)))
}

theorem rectangular_product(a: Nat -> Real, b: Nat -> Real, m: Nat, n: Nat) {
    rectangular_sum(prod_fn(a, b), m, n) = partial(a, m) * partial(b, n)
}

theorem square_sum_product(a: Nat -> Real, b: Nat -> Real, n: Nat) {
    square_sum(prod_fn(a, b), n) = partial(a, n) * partial(b, n)
}

theorem double_sum_converges_from_abs(f: (Nat, Nat) -> Real, s: Real) {
    double_image_is_supremum(rectangular_sum(abs_fn_2(f)), s)
    implies
    double_sum_converges(f)
}

theorem triangular_sum_converges_from_double_sum(f: (Nat, Nat) -> Real, s: Real) {
    double_image_is_supremum(rectangular_sum(abs_fn_2(f)), s)
    implies
    converges_to(triangular_sum(f), double_sum(f))
}

theorem cauchy_product_converges(a: Nat -> Real, b: Nat -> Real) {
    absolutely_converges(a) and absolutely_converges(b)
    implies
    converges_to(partial(cauchy_seq(a, b)), limit(partial(a)) * limit(partial(b)))
}

define div_fn(f: Nat -> Real, c: Real) -> (Nat -> Real) {
    function(k: Nat) { f(k) / c }
}

define exp_term(x: Real, n: Nat) -> Real {
    x.pow(n) / Real.from_rat(Rat.from_nat(n.factorial))
}

attributes Real {
    /// The exponential function x.exp = e^x.
    /// Defined as the limit of the partial sums of the Taylor series.
    define exp(self) -> Real {
        limit(partial(exp_term(self)))
    }
}

attributes Real {
    /// Euler's number e = exp(1).
    let e = (Real.1).exp
}

theorem factorial_pos(n: Nat) {
    Real.from_rat(Rat.from_nat(n.factorial)) > Real.0
}

theorem abs_inverse(b: Real) {
    b != Real.0 implies b.inverse.abs = b.abs.inverse
}

theorem abs_div(a: Real, b: Real) {
    b != Real.0 implies (a / b).abs = a.abs / b.abs
}

theorem factorial_suc_real(n: Nat) {
    Real.from_rat(Rat.from_nat(n.suc.factorial)) =
    Real.from_rat(Rat.from_nat(n.suc)) * Real.from_rat(Rat.from_nat(n.factorial))
}

theorem pow_suc(x: Real, n: Nat) {
    x.pow(n.suc) = x * x.pow(n)
}

theorem suc_pos(n: Nat) {
    Real.from_rat(Rat.from_nat(n.suc)) > Real.0
}

theorem exp_term_abs(x: Real, n: Nat) {
    exp_term(x, n).abs = x.abs.pow(n) / Real.from_rat(Rat.from_nat(n.factorial))
}

theorem exp_term_mul_recurrence(x: Real, n: Nat) {
    exp_term(x, n.suc) * Real.from_rat(Rat.from_nat(n.suc)) = x * exp_term(x, n)
}

theorem exp_term_mul_recurrence_abs(x: Real, n: Nat) {
    exp_term(x, n.suc).abs * Real.from_rat(Rat.from_nat(n.suc)) = x.abs * exp_term(x, n).abs
}

theorem exp_term_ratio(x: Real, n: Nat) {
    exp_term(x, n).abs != Real.0 implies
    exp_term(x, n.suc).abs / exp_term(x, n).abs = x.abs / Real.from_rat(Rat.from_nat(n.suc))
}

theorem zero_pow_pos(n: Nat) {
    n >= Nat.1 implies Real.0.pow(n) = Real.0
}

theorem exp_term_zero_vanishes(n: Nat) {
    n >= Nat.1 implies exp_term(Real.0, n) = Real.0
}

theorem exists_nat_gt(x: Real) {
    x.is_positive implies exists(n: Nat) {
        Real.from_rat(Rat.from_nat(n)) > x
    }
}

let two = Real.1 + Real.1

theorem two_positive {
    two.is_positive
}

theorem two_nonzero {
    two != Real.0
}

theorem inverse_pos(c: Real) {
    c.is_positive implies c.inverse.is_positive
}

theorem div_lt_div_pos(a: Real, b: Real, c: Real) {
    a < b and c > Real.0
    implies
    a / c < b / c
}

theorem exists_nat_half_bound(x: Real) {
    x.is_positive implies exists(n: Nat) {
        x < Real.from_rat(Rat.from_nat(n)) / two
    }
}

theorem div_div_same(a: Real, b: Real) {
    b != Real.0 implies (a / b) / b = a / (b * b)
}

theorem div_preserves_half_bound(x: Real, n: Nat) {
    x < Real.from_rat(Rat.from_nat(n)) / two
    and n >= Nat.1
    implies x / Real.from_rat(Rat.from_nat(n)) < Real.1 / two
}

define always_nonzero(f: Nat -> Real) -> Bool {
    forall(k: Nat) {
        f(k) != Real.0
    }
}

theorem exp_term_nonzero(x: Real, n: Nat) {
    x != Real.0 implies exp_term(x, n) != Real.0
}

theorem exp_term_always_nonzero(x: Real) {
    x != Real.0 implies always_nonzero(exp_term(x))
}

define has_ratio_bound(f: Nat -> Real, alpha: Real) -> Bool {
    forall(k: Nat) {
        f(k) != Real.0 implies (f(k.suc).abs / f(k).abs) < alpha
    }
}

define has_ratio_bound_eventually(f: Nat -> Real, alpha: Real) -> Bool {
    exists(big_n: Nat) {
        forall(k: Nat) {
            k >= big_n and f(k) != Real.0 implies (f(k.suc).abs / f(k).abs) < alpha
        }
    }
}

theorem ratio_bound_geometric_bound(f: Nat -> Real, alpha: Real, k: Nat) {
    has_ratio_bound(f, alpha) and Real.0 <= alpha and always_nonzero(f)
    implies
    f(k).abs <= f(Nat.0).abs * alpha.pow(k)
}

theorem ratio_bound_implies_abs_conv(f: Nat -> Real, alpha: Real) {
    has_ratio_bound(f, alpha) and alpha < Real.1 and Real.0 <= alpha and always_nonzero(f)
    implies
    absolutely_converges(f)
}

theorem eventual_ratio_bound_implies_abs_conv(f: Nat -> Real, alpha: Real) {
