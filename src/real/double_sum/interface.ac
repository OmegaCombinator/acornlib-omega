                    f(i, x).is_close(g(x), eps)
                }
            }
        }
    })
    implies uniform_converges(f, g)
}

theorem uniform_converges_apply(f: Nat -> Real -> Real, g: Real -> Real, eps: Real) {
    uniform_converges(f, g) and eps.is_positive
    implies
