theorem triangular_sum_converges_from_double_sum(f: (Nat, Nat) -> Real, s: Real) {
    double_image_is_supremum(rectangular_sum(abs_fn_2(f)), s)
    implies
    converges_to(triangular_sum(f), double_sum(f))
