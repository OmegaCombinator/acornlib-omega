}

theorem uniform_converges_integral_interchange(f: Nat -> Real -> Real, a: Real, b: Real, g: Real -> Real, lb: Real, ub: Real) {
    a <= b and
    uniform_converges_on(f, a, b, g) and
    is_integrable(g, a, b) and
    (forall(n: Nat) { is_integrable(f(n), a, b) }) and
    (forall(n: Nat, t: Real) { interval_contains(a, b, t) implies lb <= f(n, t) }) and
    (forall(n: Nat, t: Real) { interval_contains(a, b, t) implies f(n, t) <= ub }) and
    (forall(t: Real) { interval_contains(a, b, t) implies lb <= g(t) }) and
    (forall(t: Real) { interval_contains(a, b, t) implies g(t) <= ub })
    implies
    converges_to(integral_sequence(f, a, b), integral(g, a, b))
}

define uniform_pdf(x: Real) -> Real {
    if interval_contains(Real.0, Real.1, x) { Real.1 } else { Real.0 }
}

theorem uniform_pdf_one_on_unit(x: Real) {
    interval_contains(Real.0, Real.1, x) implies uniform_pdf(x) = Real.1
}

theorem uniform_pdf_zero_outside_unit(x: Real) {
    not interval_contains(Real.0, Real.1, x) implies uniform_pdf(x) = Real.0
}

theorem uniform_pdf_nonneg(x: Real) {
    Real.0 <= uniform_pdf(x)
}

theorem uniform_pdf_le_one(x: Real) {
    uniform_pdf(x) <= Real.1
}

theorem uniform_pdf_integrable_unit {
    is_integrable(uniform_pdf, Real.0, Real.1)
}

theorem uniform_pdf_integral_unit {
    integral(uniform_pdf, Real.0, Real.1) = Real.1
}

define uniform_mass_weighted(rv: Real -> Real, x: Real) -> Real {
    rv(x) * uniform_pdf(x)
}

define uniform_expectation(rv: Real -> Real) -> Real {
    integral(uniform_mass_weighted(rv), Real.0, Real.1)
}

define uniform_cdf_unit(x: Real) -> Real {
    integral(uniform_pdf, Real.0, x)
}

theorem uniform_cdf_unit_value(x: Real) {
    interval_contains(Real.0, Real.1, x) implies uniform_cdf_unit(x) = x
}

define even_prod(n: Nat) -> Real {
    finite_real_product(even_term, n)
}

define odd_prod(n: Nat) -> Real {
    finite_real_product(odd_term, n)
}

define odd_shifted_prod(n: Nat) -> Real {
    finite_real_product(odd_shifted_term, n)
}

theorem even_term_pos(k: Nat) {
    even_term(k) > Real.0
}

theorem odd_term_pos(k: Nat) {
    odd_term(k) > Real.0
}

theorem odd_shifted_term_pos(k: Nat) {
    odd_shifted_term(k) > Real.0
}

theorem wallis_odd_den_ne_zero(k: Nat) {
    from_nat[Real](Nat.2 * k + Nat.1) != Real.0
}

theorem wallis_shifted_den_ne_zero(k: Nat) {
    from_nat[Real](Nat.2 * k + Nat.3) != Real.0
}

theorem even_prod_suc(k: Nat) {
    even_prod(k.suc) = even_prod(k) * even_term(k)
}

theorem odd_prod_suc(k: Nat) {
    odd_prod(k.suc) = odd_prod(k) * odd_term(k)
}

theorem odd_shifted_prod_suc(k: Nat) {
    odd_shifted_prod(k.suc) = odd_shifted_prod(k) * odd_shifted_term(k)
}

theorem even_prod_zero {
    even_prod(Nat.0) = Real.1
}

theorem odd_prod_zero {
    odd_prod(Nat.0) = Real.1
}

theorem odd_shifted_prod_zero {
    odd_shifted_prod(Nat.0) = Real.1
}

theorem odd_term_positive_on(n: Nat) {
    positive_on(odd_term, n)
}

theorem odd_shifted_term_positive_on(n: Nat) {
    positive_on(odd_shifted_term, n)
}

theorem odd_prod_pos(n: Nat) {
    odd_prod(n) > Real.0
}

theorem odd_shifted_prod_pos(n: Nat) {
    odd_shifted_prod(n) > Real.0
}

theorem odd_prod_ne_zero(n: Nat) {
    odd_prod(n) != Real.0
}

theorem odd_shifted_prod_ne_zero(n: Nat) {
    odd_shifted_prod(n) != Real.0
}

define ps_term(a: Nat -> Real, x: Real, n: Nat) -> Real {
    a(n) * x.pow(n)
}

define ps_sum(a: Nat -> Real, x: Real) -> Real {
    limit(partial(ps_term(a, x)))
}

define ps_diff_term(a: Nat -> Real, x: Real, n: Nat) -> Real {
    ps_term(ps_diff_coeff(a), x, n)
}

theorem converges_to_pointwise_eq(q: Nat -> Real, r: Nat -> Real, a: Real) {
    (forall(n: Nat) { q(n) = r(n) }) implies (converges_to(q, a) implies converges_to(r, a))
}

theorem converges_pointwise_eq(q: Nat -> Real, r: Nat -> Real) {
    (forall(n: Nat) { q(n) = r(n) }) implies (converges(q) implies converges(r))
}

theorem limit_pointwise_eq(s: Nat -> Real, t: Nat -> Real) {
    (forall(n: Nat) { s(n) = t(n) }) and converges(s)
    implies
    limit(t) = limit(s)
}

define mercator_diff_term(x: Real, n: Nat) -> Real {
    alternating_sign[Real](n) * x.pow(n)
}

theorem mercator_diff_term_eq_alt_pow(x: Real, n: Nat) {
    mercator_diff_term(x, n) = (-x).pow(n)
}

define ps_conv_radii_contains(a: Nat -> Real, r: Real) -> Bool {
    Real.0 <= r and absolutely_converges(power_series_term(a, r))
}

define ps_conv_radii_set(a: Nat -> Real) -> Set[Real] {
    Set[Real].new(ps_conv_radii_contains(a))
}

theorem ps_conv_radii_set_contains_iff(a: Nat -> Real, r: Real) {
    ps_conv_radii_set(a).contains(r) = ps_conv_radii_contains(a, r)
}

define is_ps_radius(a: Nat -> Real, rho: Real) -> Bool {
    is_set_supremum(ps_conv_radii_set(a), rho)
}

theorem ps_term_at_zero_zero(a: Nat -> Real) {
    power_series_term(a, Real.0, Nat.0) = a(Nat.0)
}

theorem ps_term_at_zero_tail(a: Nat -> Real, n: Nat) {
    n >= Nat.1 implies power_series_term(a, Real.0, n) = Real.0
}

theorem ps_abs_partial_at_zero_suc(a: Nat -> Real, n: Nat) {
    partial(abs_fn(power_series_term(a, Real.0)), n.suc) = a(Nat.0).abs
}

theorem ps_conv_radii_contains_zero(a: Nat -> Real) {
    ps_conv_radii_set(a).contains(Real.0)
}
