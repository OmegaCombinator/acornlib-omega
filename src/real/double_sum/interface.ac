theorem ratio_bound_geometric_bound(f: Nat -> Real, alpha: Real, k: Nat) {
    has_ratio_bound(f, alpha) and Real.0 <= alpha and always_nonzero(f)
    implies
    f(k).abs <= f(Nat.0).abs * alpha.pow(k)
