    }
}

theorem not_positive_on_imp_zero_factor(f: Nat -> Real, n: Nat) {
    nonnegative_on(f, n) and not positive_on(f, n) implies exists(i: Nat) {
        i < n and f(i) = Real.0
    }
}

theorem finite_real_product_zero_of_factor(f: Nat -> Real, n: Nat, i: Nat) {
    i < n and f(i) = Real.0 implies finite_real_product(f, n) = Real.0
}

theorem am_gm_zero(f: Nat -> Real, n: Nat) {
    n != Nat.0 and nonnegative_on(f, n)
    and exists(i: Nat) { i < n and f(i) = Real.0 }
    implies exists(g: Real) {
        (finite_real_product(f, n)).rpow(Real.1 / from_nat[Real](n)) = Option.some(g)
        and g <= finite_real_mean(f, n)
    }
}

theorem am_gm(f: Nat -> Real, n: Nat) {
    n != Nat.0 and nonnegative_on(f, n) implies exists(g: Real) {
        (finite_real_product(f, n)).rpow(Real.1 / from_nat[Real](n)) = Option.some(g)
        and g <= finite_real_mean(f, n)
    }
}

theorem am_gm_eq_of_all_eq(f: Nat -> Real, n: Nat, c: Real) {
    n != Nat.0 and c >= Real.0 and (forall(i: Nat) { i < n implies f(i) = c })
    implies exists(g: Real) {
        (finite_real_product(f, n)).rpow(Real.1 / from_nat[Real](n)) = Option.some(g)
        and g = finite_real_mean(f, n)
    }
}

define l_fn(f: Nat -> Real, m: Real) -> (Nat -> Real) {
    sub_const_fn(log_value_fn(f), m.log.get_or_else(Real.0))
}

define r_fn(f: Nat -> Real, m: Real) -> (Nat -> Real) {
    sub_const_fn(div_const_fn(f, m), Real.1)
}

define d_fn(f: Nat -> Real, m: Real) -> (Nat -> Real) {
    add_fn(r_fn(f, m), neg_fn(l_fn(f, m)))
}

theorem am_gm_eq_imp_all_eq_pos(f: Nat -> Real, n: Nat) {
    n != Nat.0 and positive_on(f, n)
    and exists(g: Real) {
        (finite_real_product(f, n)).rpow(Real.1 / from_nat[Real](n)) = Option.some(g)
        and g = finite_real_mean(f, n)
    }
    implies forall(i: Nat) { i < n implies f(i) = finite_real_mean(f, n) }
}

theorem am_gm_eq_imp_all_eq(f: Nat -> Real, n: Nat) {
    n != Nat.0 and nonnegative_on(f, n)
    and exists(g: Real) {
        (finite_real_product(f, n)).rpow(Real.1 / from_nat[Real](n)) = Option.some(g)
        and g = finite_real_mean(f, n)
    }
    implies forall(i: Nat) { i < n implies f(i) = finite_real_mean(f, n) }
}

define tri_fn(a: Real, b: Real, c: Real) -> (Nat -> Real) {
    function(i: Nat) {
        if i = Nat.0 {
            a
        } else {
            if i = Nat.1 {
                b
            } else {
                if i = Nat.2 {
                    c
                } else {
                    Real.0
                }
            }
        }
    }
}

theorem tri_fn_zero(a: Real, b: Real, c: Real) {
    tri_fn(a, b, c)(Nat.0) = a
}

theorem tri_fn_one(a: Real, b: Real, c: Real) {
    tri_fn(a, b, c)(Nat.1) = b
}

theorem tri_fn_two(a: Real, b: Real, c: Real) {
    tri_fn(a, b, c)(Nat.2) = c
}

theorem am_gm_three(a: Real, b: Real, c: Real) {
    a >= Real.0 and b >= Real.0 and c >= Real.0 implies exists(g: Real) {
        (a * b * c).rpow(Real.1 / from_nat[Real](Nat.3)) = Option.some(g)
        and g <= (a + b + c) / from_nat[Real](Nat.3)
    }
}

theorem exp_gt_one_plus_x_strict(x: Real) {
    x != Real.0 implies x.exp > Real.1 + x
}

theorem log_strictly_increasing(x: Real, y: Real) {
    x > Real.0 and y > Real.0 and x < y implies x.log.get_or_else(Real.0) < y.log.get_or_else(Real.0)
}

theorem exp_eq_log(x: Real, y: Real) {
    x.exp = y implies y.log = Option.some(x)
}

theorem log_eq_exp(x: Real, y: Real) {
    y > Real.0 and y.log = Option.some(x) implies x.exp = y
}

theorem exp_eq_iff_log(x: Real, y: Real) {
    y > Real.0 implies (x.exp = y iff y.log = Option.some(x))
}

theorem exp_rpow_mul(x: Real, y: Real) {
    (x.exp).rpow(y) = Option.some((x * y).exp)
}

theorem log_one_plus_x_lt_x(x: Real) {
    x > Real.0 implies (Real.1 + x).log.get_or_else(Real.0) < x
}

theorem x_lt_exp(x: Real) {
    x < x.exp
}

theorem log_value_one {
    (Real.1).log.get_or_else(Real.0) = Real.0
}

theorem log_e {
    Real.e.log = Option.some(Real.1)
}

theorem log_value_e {
    (Real.e).log.get_or_else(Real.0) = Real.1
}

theorem log_value_exp(x: Real) {
    (x.exp).log.get_or_else(Real.0) = x
}

theorem exp_sub(x: Real, y: Real) {
    (x - y).exp = x.exp / y.exp
}

theorem exp_mul_exp_neg(x: Real) {
    x.exp * (-x).exp = Real.1
}

theorem exp_rpow_val(x: Real, r: Real, v: Real) {
    (x.exp).rpow(r) = Option.some(v) implies v = (x * r).exp
}

theorem log_value_mul(x: Real, y: Real) {
    x > Real.0 and y > Real.0 implies (x * y).log.get_or_else(Real.0) = x.log.get_or_else(Real.0) + y.log.get_or_else(Real.0)
}

theorem log_mul_val(x: Real, y: Real, lx: Real, ly: Real) {
    x > Real.0 and y > Real.0 and x.log = Option.some(lx) and y.log = Option.some(ly)
    implies (x * y).log = Option.some(lx + ly)
}

theorem log_value_div(x: Real, y: Real) {
    x > Real.0 and y > Real.0 implies (x / y).log.get_or_else(Real.0) = x.log.get_or_else(Real.0) - y.log.get_or_else(Real.0)
}

theorem log_value_recip(x: Real) {
    x > Real.0 implies (Real.1 / x).log.get_or_else(Real.0) = -x.log.get_or_else(Real.0)
}

theorem log_rpow_val(base: Real, r: Real, v: Real) {
    base > Real.0 and base.rpow(r) = Option.some(v)
    implies v.log = Option.some(r * base.log.get_or_else(Real.0))
}

theorem log_value_rpow(base: Real, r: Real, v: Real) {
    base > Real.0 and base.rpow(r) = Option.some(v)
    implies v.log.get_or_else(Real.0) = r * base.log.get_or_else(Real.0)
}

theorem log_nat_pow(x: Real, n: Nat) {
    x > Real.0 implies (x.pow(n)).log = Option.some(from_nat[Real](n) * x.log.get_or_else(Real.0))
}

theorem log_value_monotone(x: Real, y: Real) {
    x > Real.0 and y > Real.0 and x <= y implies x.log.get_or_else(Real.0) <= y.log.get_or_else(Real.0)
}

theorem log_le_imp_le(x: Real, y: Real) {
    x > Real.0 and y > Real.0 and x.log.get_or_else(Real.0) <= y.log.get_or_else(Real.0) implies x <= y
}

theorem log_ge_imp_ge(x: Real, y: Real) {
    x > Real.0 and y > Real.0 and x.log.get_or_else(Real.0) >= y.log.get_or_else(Real.0) implies x >= y
}

theorem log_lt_imp_lt(x: Real, y: Real) {
    x > Real.0 and y > Real.0 and x.log.get_or_else(Real.0) < y.log.get_or_else(Real.0) implies x < y
}

theorem log_injective(x: Real, y: Real) {
    x > Real.0 and y > Real.0 and x.log.get_or_else(Real.0) = y.log.get_or_else(Real.0) implies x = y
}

theorem log_injective_opt(x: Real, y: Real, lx: Real, ly: Real) {
    x > Real.0 and y > Real.0 and x.log = Option.some(lx) and y.log = Option.some(ly) and lx = ly
    implies x = y
}

theorem exp_double(x: Real) {
    (x + x).exp = x.exp * x.exp
}

theorem exp_pow_two(x: Real) {
    x.exp.pow(Nat.2) = (two * x).exp
}

theorem exp_two_e {
    two.exp = Real.e * Real.e
}

theorem e_pow_two {
    Real.e.pow(Nat.2) = two.exp
}

theorem exp_e_pow_nat(n: Nat) {
    Real.e.pow(n) = (from_nat[Real](n)).exp
}

theorem exp_sub_self(x: Real) {
    (x - x).exp = Real.1
}

theorem exp_recip(x: Real) {
    Real.1 / x.exp = (-x).exp
}

theorem exp_div_self(x: Real) {
    x.exp / x.exp = Real.1
}

theorem exp_pos_mul(x: Real, y: Real) {
    x.exp * y.exp > Real.0
}

theorem exp_le_iff_le(x: Real, y: Real) {
    x.exp <= y.exp iff x <= y
}

theorem exp_lt_iff_lt(x: Real, y: Real) {
    x.exp < y.exp iff x < y
}

theorem exp_eq_iff_eq(x: Real, y: Real) {
    x.exp = y.exp iff x = y
}

theorem exp_gt_one_iff(x: Real) {
    x.exp > Real.1 iff x > Real.0
}

theorem exp_ge_one_iff(x: Real) {
    x.exp >= Real.1 iff x >= Real.0
}

theorem exp_lt_one_iff(x: Real) {
    x.exp < Real.1 iff x < Real.0
}

theorem exp_le_one_iff(x: Real) {
    x.exp <= Real.1 iff x <= Real.0
}

theorem exp_ge_partial(x: Real, n: Nat) {
    x >= Real.0 implies partial(exp_term(x), n) <= x.exp
}

theorem exp_partial_four(x: Real) {
    partial(exp_term(x), Nat.4) = Real.1 + x + x.pow(Nat.2) / two + x.pow(Nat.3) / Real.from_rat(Rat.from_nat(Nat.3.factorial))
}
