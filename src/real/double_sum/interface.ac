theorem choose_factorial_real(n: Nat, k: Nat) {
    k <= n implies
    from_nat[Real](n.binom(k)) * Real.from_rat(Rat.from_nat(k.factorial)) * Real.from_rat(Rat.from_nat((n - k).factorial)) =
        Real.from_rat(Rat.from_nat(n.factorial))
