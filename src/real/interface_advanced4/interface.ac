        pointwise_div_real(
            pointwise_add(
                pointwise_mul(constant[Real, Real](a), affine_real(c, d)),
                pointwise_neg(pointwise_mul(affine_real(a, b), constant[Real, Real](c)))
            ),
            pointwise_mul(affine_real(c, d), affine_real(c, d))
        )
