                pointwise_mul(constant[Real, Real](a), square_real),
                pointwise_neg(pointwise_mul(affine_real(a, b), pointwise_add(identity_fn[Real], identity_fn[Real])))
            ),
            pointwise_mul(square_real, square_real)
        )
    )
}

theorem differentiable_everywhere_affine_over_square(a: Real, b: Real) {
    nonvanishing_everywhere(square_real) implies
        differentiable_everywhere(pointwise_div_real(affine_real(a, b), square_real))
}

theorem is_derivative_fn_imp_continuous(f: Real -> Real, df: Real -> Real) {
    is_derivative_fn(f, df) implies continuous(f)
}

theorem differentiable_everywhere_imp_continuous(f: Real -> Real) {
    differentiable_everywhere(f) implies continuous(f)
}

theorem continuous_reciprocal_of_differentiable_everywhere_nonvanishing(g: Real -> Real) {
    differentiable_everywhere(g) and nonvanishing_everywhere(g)
        implies continuous(pointwise_reciprocal_real(g))
}

theorem continuous_quotient_of_differentiable_everywhere_nonvanishing(f: Real -> Real, g: Real -> Real) {
    differentiable_everywhere(f) and differentiable_everywhere(g) and nonvanishing_everywhere(g)
        implies continuous(pointwise_div_real(f, g))
}

theorem continuous_reciprocal_affine_real(a: Real, b: Real) {
    nonvanishing_everywhere(affine_real(a, b)) implies
        continuous(pointwise_reciprocal_real(affine_real(a, b)))
}

theorem continuous_reciprocal_square_real {
    nonvanishing_everywhere(square_real) implies
        continuous(pointwise_reciprocal_real(square_real))
}

theorem continuous_affine_over_affine(a: Real, b: Real, c: Real, d: Real) {
    nonvanishing_everywhere(affine_real(c, d)) implies
        continuous(pointwise_div_real(affine_real(a, b), affine_real(c, d)))
}

theorem continuous_square_over_affine(a: Real, b: Real) {
    nonvanishing_everywhere(affine_real(a, b)) implies
        continuous(pointwise_div_real(square_real, affine_real(a, b)))
}

theorem continuous_affine_over_square(a: Real, b: Real) {
    nonvanishing_everywhere(square_real) implies
        continuous(pointwise_div_real(affine_real(a, b), square_real))
}

theorem continuous_at_reciprocal_real(x0: Real) {
    x0 != Real.0 implies continuous_at(reciprocal_real, x0)
}

theorem continuous_at_pointwise_reciprocal_real(g: Real -> Real, x0: Real) {
    continuous_at(g, x0) and g(x0) != Real.0 implies
        continuous_at(pointwise_reciprocal_real(g), x0)
}

theorem continuous_at_pointwise_div_real(f: Real -> Real, g: Real -> Real, x0: Real) {
    continuous_at(f, x0) and continuous_at(g, x0) and g(x0) != Real.0 implies
        continuous_at(pointwise_div_real(f, g), x0)
}

theorem derivative_compose_reciprocal_real(g: Real -> Real, x0: Real, dg: Real) {
    has_derivative_at(g, x0, dg) and g(x0) != Real.0 implies
        has_derivative_at(compose(reciprocal_real, g), x0,
            (-Real.1 / (g(x0) * g(x0))) * dg)
}

theorem differentiable_compose_reciprocal_real(g: Real -> Real, x0: Real) {
    differentiable_at(g, x0) and g(x0) != Real.0
        implies differentiable_at(compose(reciprocal_real, g), x0)
}

theorem derivative_pointwise_reciprocal_real_continuous_at(g: Real -> Real, x0: Real, dg: Real) {
    has_derivative_at(g, x0, dg) and g(x0) != Real.0
        implies continuous_at(pointwise_reciprocal_real(g), x0)
}

theorem differentiable_pointwise_reciprocal_real_continuous_at(g: Real -> Real, x0: Real) {
    differentiable_at(g, x0) and g(x0) != Real.0
        implies continuous_at(pointwise_reciprocal_real(g), x0)
}

theorem derivative_pointwise_div_continuous_at(
    f: Real -> Real, g: Real -> Real, x0: Real, df: Real, dg: Real
) {
    has_derivative_at(f, x0, df) and has_derivative_at(g, x0, dg) and g(x0) != Real.0
        implies continuous_at(pointwise_div_real(f, g), x0)
}

theorem differentiable_pointwise_div_continuous_at(f: Real -> Real, g: Real -> Real, x0: Real) {
    differentiable_at(f, x0) and differentiable_at(g, x0) and g(x0) != Real.0
        implies continuous_at(pointwise_div_real(f, g), x0)
}

define real_from_rat_fn(r: Rat) -> Real {
    Real.from_rat(r)
}

theorem real_from_rat_fn_add(p: Rat, q: Rat) {
    real_from_rat_fn(p + q) = real_from_rat_fn(p) + real_from_rat_fn(q)
}

theorem real_from_rat_fn_mul(p: Rat, q: Rat) {
    real_from_rat_fn(p * q) = real_from_rat_fn(p) * real_from_rat_fn(q)
}

theorem real_from_rat_fn_one {
    real_from_rat_fn(Rat.1) = Real.1
}

theorem real_from_rat_is_ring_hom {
    is_ring_hom(real_from_rat_fn)
}

theorem real_from_rat_ring_hom_some {
    exists(h: RingHom[Rat, Real]) {
        RingHom.new(real_from_rat_fn) = Option.some(h)
    }
}

let real_from_rat_ring_hom: RingHom[Rat, Real] satisfy {
    RingHom.new(real_from_rat_fn) = Option.some(real_from_rat_ring_hom)
}

theorem real_from_rat_ring_hom_hom {
    real_from_rat_ring_hom.hom = real_from_rat_fn
}

theorem real_from_rat_ring_hom_apply(p: Rat) {
    real_from_rat_ring_hom.hom(p) = Real.from_rat(p)
}

theorem real_from_rat_is_field_hom {
    is_field_hom(real_from_rat_fn)
}

theorem real_from_rat_field_hom_some {
    exists(h: FieldHom[Rat, Real]) {
        FieldHom.new(real_from_rat_fn) = Option.some(h)
    }
}

let real_from_rat_field_hom: FieldHom[Rat, Real] satisfy {
    FieldHom.new(real_from_rat_fn) = Option.some(real_from_rat_field_hom)
}

theorem real_from_rat_field_hom_hom {
    real_from_rat_field_hom.hom = real_from_rat_fn
}

theorem real_from_rat_field_hom_apply(p: Rat) {
    real_from_rat_field_hom.hom(p) = Real.from_rat(p)
}

theorem real_from_rat_field_hom_injective(p: Rat, q: Rat) {
    real_from_rat_field_hom.hom(p) = real_from_rat_field_hom.hom(q) implies p = q
}

theorem real_from_rat_field_hom_inverse(p: Rat) {
    p != Rat.0 implies
        real_from_rat_field_hom.hom(p.inverse) = real_from_rat_field_hom.hom(p).inverse
