    n: Nat, delta: Real, eps: Real) {
    uniform_condition(f, delta, eps) and cauchy_bound(a, n, delta)
        implies cauchy_bound(compose(f, a), n, eps)
}

theorem uniform_preserves_converges(f: Real -> Real, a: Nat -> Real) {
