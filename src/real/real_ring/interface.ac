define is_cauchy_series(a: Nat -> Real) -> Bool {
    forall(eps: Real) {
        eps.is_positive implies exists(n: Nat) {
            forall(k: Nat, m: Nat) {
                n <= k and k <= m implies sum(map(k.until(m), a)).abs < eps
            }
        }
    }
}

