define mul_seq(a: Real, b: Nat -> Real, n: Nat) -> Real {
    a * b(n)
}

theorem const_converges(a: Real) {
    converges(constant[Nat, Real](a))
}

theorem const_limit(a: Real) {
    limit(constant[Nat, Real](a)) = a
}

theorem const_converges_to(a: Real) {
