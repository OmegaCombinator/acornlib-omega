define rat_condition(f: Rat -> Real, delta: Rat, eps: Real) -> Bool {
    forall(r1: Rat, r2: Rat) {
        r1.is_close(r2, delta) implies f(r1).is_close(f(r2), eps)
    }
}

define rat_uniform(f: Rat -> Real) -> Bool {
    forall(eps: Real) {
        eps.is_positive implies exists(delta: Rat) {
            delta.is_positive and rat_condition(f, delta, eps)
        }
    }
}

theorem uniform_imp_seq(f: Rat -> Real, q: Nat -> Rat) {
    rat_uniform(f) and converges(lift_seq(q))
    implies
    converges(compose(f, q))
}

define uniform_condition(f: Real -> Real, delta: Real, eps: Real) -> Bool {
    forall(r1: Real, r2: Real) {
        r1.is_close(r2, delta) implies f(r1).is_close(f(r2), eps)
    }
}

define uniform(f: Real -> Real) -> Bool {
    forall(eps: Real) {
        eps.is_positive implies exists(delta: Real) {
            delta.is_positive and uniform_condition(f, delta, eps)
        }
    }
}

theorem uniform_witness(f: Real -> Real, eps: Real) {
    uniform(f) and eps.is_positive implies exists(delta: Real) {
        delta.is_positive and uniform_condition(f, delta, eps)
    }
}

theorem converges_imp_close_tail_bound(a: Nat -> Real, eps: Real) {
    converges(a) and eps.is_positive implies exists(n: Nat) {
        forall(i: Nat) {
            n <= i implies a(i).is_close(limit(a), eps)
        }
    }
}

theorem uniform_condition_exists(g: Real -> Real, eps: Real, delta: Real) {
    eps.is_positive and delta.is_positive and uniform_condition(g, delta, eps)
    implies
    exists(delta2: Real) {
        delta2.is_positive and uniform_condition(g, delta2, eps)
    }
}

theorem limit_compose_uniform(f: Real -> Real, a: Nat -> Real) {
    uniform(f) and converges(a)
    implies
    converges_to(compose(f, a), f(limit(a)))
}

theorem limit_compose_rat_uniform(f: Rat -> Real, a: Nat -> Rat, r: Rat) {
    rat_uniform(f)
    and converges_to(lift_seq(a), Real.from_rat(r))
    implies
    converges_to(compose(f, a), f(r))
}

define lift_uc(f: Rat -> Real, x: Real) -> Real {
    limit(compose(f, rat_seq(x)))
}

theorem lift_fixes_rats(f: Rat -> Real, r: Rat) {
    rat_uniform(f)
    implies
    lift_uc(f, Real.from_rat(r)) = f(r)
}

theorem lift_uniform_is_uniform(f: Rat -> Real) {
    rat_uniform(f)
    implies
    uniform(lift_uc(f))
}

theorem positive_real_has_close_rat(x: Real, delta: Real) {
    delta.is_positive implies exists(r: Rat) {
        Real.from_rat(r).is_close(x, delta)
    }
}

theorem uniform_ne_imp_rat_ne(f: Real -> Real, g: Real -> Real) {
    uniform(f) and uniform(g) and f != g implies
    exists(r: Rat) {
        f(Real.from_rat(r)) != g(Real.from_rat(r))
    }
}

define rat_increasing(f: Rat -> Real) -> Bool {
    forall(r1: Rat, r2: Rat) {
        r1 < r2 implies f(r1) < f(r2)
    }
}

define increasing(f: Real -> Real) -> Bool {
    forall(x: Real, y: Real) {
        x < y implies f(x) < f(y)
    }
}

theorem uni_cond_imp_rat_cond(f: Real -> Real, delta: Rat, eps: Real) {
    uniform_condition(f, Real.from_rat(delta), eps)
    implies
    rat_condition(compose(f, Real.from_rat), delta, eps)
}

theorem uniform_imp_rat_uniform(f: Real -> Real) {
    uniform(f)
    implies
    rat_uniform(compose(f, Real.from_rat))
}

theorem tighten_uc(f: Real -> Real, delta1: Real, delta2: Real, eps: Real) {
    delta1.is_positive and delta2.is_positive and
    uniform_condition(f, delta1, eps) and delta2 < delta1
    implies
    uniform_condition(f, delta2, eps)
}

theorem add_real_eps_between(a: Real, b: Real) {
    a < b implies
    exists(eps: Real) {
        eps.is_positive and a + eps < b
    }
}

theorem lift_inc_is_inc(f: Rat -> Real) {
    rat_uniform(f) and rat_increasing(f)
    implies
    increasing(lift_uc(f))
}

theorem constant_has_rat_uniform_witness(f: Rat -> Real, eps: Real) {
    is_constant(f) and eps.is_positive implies exists(delta: Rat) {
        delta.is_positive and rat_condition(f, delta, eps)
    }
}

theorem constant_is_rat_uniform(f: Rat -> Real) {
    is_constant(f)
    implies
    rat_uniform(f)
}

theorem constant_has_uniform_witness(f: Real -> Real, eps: Real) {
    is_constant(f) and eps.is_positive implies exists(delta: Real) {
        delta.is_positive and uniform_condition(f, delta, eps)
    }
}

theorem constant_is_uniform(f: Real -> Real) {
    is_constant(f)
    implies
    uniform(f)
}

theorem lift_constant_is_constant(f: Rat -> Real) {
    is_constant(f)
    implies
    is_constant(lift_uc(f))
}

theorem compose_uniform(f: Real -> Real, g: Real -> Real) {
    uniform(f) and uniform(g)
    implies
    uniform(compose(f, g))
}

theorem rat_mul_uniform(r: Rat) {
    rat_uniform(compose(Real.from_rat, r.mul))
}

theorem close_add(a: Real, b: Real, c: Real, eps: Real) {
    a.is_close(b, eps)
    implies
    (a + c).is_close(b + c, eps)
}

theorem add_real_uniform(x: Real) {
    uniform(x.add)
}

theorem neg_uniform {
    uniform(Real.neg)
}

define add_fns[T](f: T -> Real, g: T -> Real, t: T) -> Real {
    f(t) + g(t)
}

theorem add_fns_uniform(f: Real -> Real, g: Real -> Real) {
    uniform(f) and uniform(g)
    implies
    uniform(add_fns(f, g))
}

define continuous2_condition(f: (Real, Real) -> Real, x: Real, y: Real, delta: Real, eps: Real) -> Bool {
    forall(x1: Real, y1: Real) {
        x1.is_close(x, delta) and y1.is_close(y, delta) implies
        f(x1, y1).is_close(f(x, y), eps)
    }
}

define continuous2_at(f: (Real, Real) -> Real, x: Real, y: Real) -> Bool {
    forall(eps: Real) {
        eps.is_positive implies exists(delta: Real) {
            delta.is_positive and
            continuous2_condition(f, x, y, delta, eps)
        }
    }
}

define continuous2(f: (Real, Real) -> Real) -> Bool {
    forall(x: Real, y: Real) {
        continuous2_at(f, x, y)
    }
}

theorem add_continuous2 {
    continuous2(Real.add)
}

define continuous_condition(f: Real -> Real, x: Real, delta: Real, eps: Real) -> Bool {
    forall(x1: Real) {
        x1.is_close(x, delta) implies
        f(x1).is_close(f(x), eps)
    }
}

define continuous_at(f: Real -> Real, x: Real) -> Bool {
    forall(eps: Real) {
        eps.is_positive implies exists(delta: Real) {
            delta.is_positive and continuous_condition(f, x, delta, eps)
        }
    }
}

define continuous(f: Real -> Real) -> Bool {
    forall(x: Real) {
        continuous_at(f, x)
    }
}

theorem uniform_imp_continuous(f: Real -> Real) {
    uniform(f)
    implies
    continuous(f)
}

theorem forall_elim[T](p: T -> Bool, x: T) {
    (forall(y: T) { p(y) }) implies p(x)
}

define difference_quotient(f: Real -> Real, x0: Real, x: Real) -> Real {
    (f(x) - f(x0)) / (x - x0)
}

define has_derivative_at(f: Real -> Real, x0: Real, d: Real) -> Bool {
    forall(eps: Real) {
        eps.is_positive implies exists(delta: Real) {
            delta.is_positive and forall(x: Real) {
                x != x0 and x.is_close(x0, delta)
                implies difference_quotient(f, x0, x).is_close(d, eps)
            }
        }
    }
}

define differentiable_at(f: Real -> Real, x0: Real) -> Bool {
    exists(d: Real) {
        has_derivative_at(f, x0, d)
    }
}

theorem sub_ne_zero_of_ne(x: Real, x0: Real) {
    x != x0 implies x - x0 != Real.0
}

theorem exists_punctured_close_point(x0: Real, delta: Real) {
    delta.is_positive implies exists(x: Real) {
        x != x0 and x.is_close(x0, delta)
    }
}

theorem derivative_values_close_from_same_witness(
    q: Real, d1: Real, d2: Real, eps: Real
) {
    q.is_close(d1, eps) and q.is_close(d2, eps) implies d1.is_close(d2, eps + eps)
}

theorem has_derivative_at_delta(f: Real -> Real, x0: Real, d: Real, eps: Real) {
    has_derivative_at(f, x0, d) and eps.is_positive implies exists(delta: Real) {
        delta.is_positive and forall(x: Real) {
            x != x0 and x.is_close(x0, delta)
            implies difference_quotient(f, x0, x).is_close(d, eps)
        }
    }
}

theorem difference_quotient_constant_eq_zero(c: Real, x0: Real, x: Real) {
    x != x0 implies difference_quotient(constant[Real, Real](c), x0, x) = Real.0
}

theorem difference_quotient_identity_eq_one(x0: Real, x: Real) {
    x != x0 implies difference_quotient(identity_fn[Real], x0, x) = Real.1
}

theorem constant_has_derivative_at(c: Real, x0: Real) {
    has_derivative_at(constant[Real, Real](c), x0, Real.0)
}

theorem identity_has_derivative_at(x0: Real) {
    has_derivative_at(identity_fn[Real], x0, Real.1)
}

theorem has_derivative_at_unique(f: Real -> Real, x0: Real, d1: Real, d2: Real) {
    has_derivative_at(f, x0, d1) and has_derivative_at(f, x0, d2) implies d1 = d2
}

theorem constant_differentiable_at(c: Real, x0: Real) {
    differentiable_at(constant[Real, Real](c), x0)
}

theorem identity_differentiable_at(x0: Real) {
    differentiable_at(identity_fn[Real], x0)
}

theorem div_mul_cancel_denominator(a: Real, b: Real) {
    b != Real.0 implies (a / b) * b = a
}

theorem difference_quotient_mul_increment(f: Real -> Real, x0: Real, x: Real) {
    x != x0 implies difference_quotient(f, x0, x) * (x - x0) = f(x) - f(x0)
}

theorem derivative_difference_quotient_local_abs_bound(f: Real -> Real, x0: Real, d: Real) {
    has_derivative_at(f, x0, d) implies exists(delta: Real, bound: Real) {
        delta.is_positive and bound.is_positive and forall(x: Real) {
            x != x0 and x.is_close(x0, delta)
            implies difference_quotient(f, x0, x).abs <= bound
        }
    }
}

theorem bounded_difference_quotient_close(
    f: Real -> Real, x0: Real, x: Real, delta: Real, bound: Real, eps: Real
) {
    x != x0 and x.is_close(x0, delta) and delta.is_positive and bound.is_positive
    and bound * delta < eps
    and difference_quotient(f, x0, x).abs <= bound
    implies f(x).is_close(f(x0), eps)
}

theorem derivative_continuous_at(f: Real -> Real, x0: Real, d: Real) {
    has_derivative_at(f, x0, d) implies continuous_at(f, x0)
}

theorem differentiable_continuous_at(f: Real -> Real, x0: Real) {
    differentiable_at(f, x0) implies continuous_at(f, x0)
}

theorem close_eq_left(a: Real, b: Real, c: Real, eps: Real) {
    a = b and a.is_close(c, eps) implies b.is_close(c, eps)
}

theorem abs_add_one_pos(a: Real) {
    (a.abs + Real.1).is_positive
}

theorem abs_lte_abs_add_one(a: Real) {
    a.abs <= a.abs + Real.1
}

theorem sub_sub_telescope(a: Real, b: Real, c: Real) {
    a - b + (b - c) = a - c
}

theorem scalar_close_wide(c: Real, a: Real, b: Real, eps: Real) {
    a.is_close(b, eps) and eps.is_positive
    implies (c * a).is_close(c * b, (c.abs + Real.1) * eps)
}

theorem product_diff_split(fx: Real, gx: Real, fx0: Real, gx0: Real) {
    fx * gx - fx0 * gx0 = fx * (gx - gx0) + gx0 * (fx - fx0)
}

theorem scalar_div(c: Real, a: Real, b: Real) {
    (c * a) / b = c * (a / b)
}

theorem div_add_distrib(a: Real, b: Real, c: Real) {
    c != Real.0 implies (a + b) / c = a / c + b / c
}

theorem difference_quotient_pointwise_mul(f: Real -> Real, g: Real -> Real, x0: Real, x: Real) {
    x != x0 implies difference_quotient(pointwise_mul(f, g), x0, x) =
        f(x) * difference_quotient(g, x0, x) + g(x0) * difference_quotient(f, x0, x)
}

theorem product_split_difference_quotient_close(
    f: Real -> Real, g: Real -> Real, x0: Real, x: Real,
    df: Real, dg: Real,
    f_bound: Real, dg_bound: Real, g_bound: Real,
    eps_small: Real, eps: Real
) {
    x != x0 and
    f(x).is_close(f(x0), eps_small) and
    difference_quotient(g, x0, x).is_close(dg, eps_small) and
    difference_quotient(f, x0, x).is_close(df, eps_small) and
    f(x).abs <= f_bound and dg.abs <= dg_bound and
    f_bound.is_positive and dg_bound.is_positive and g_bound = g(x0).abs + Real.1 and
    eps_small.is_positive and
    (f_bound * eps_small + eps_small * dg_bound) + g_bound * eps_small < eps
    implies
    (f(x) * difference_quotient(g, x0, x) + g(x0) * difference_quotient(f, x0, x)).is_close(
        f(x0) * dg + g(x0) * df,
        eps
    )
}

theorem derivative_pointwise_mul(f: Real -> Real, g: Real -> Real, x0: Real, df: Real, dg: Real) {
    has_derivative_at(f, x0, df) and has_derivative_at(g, x0, dg)
    implies has_derivative_at(pointwise_mul(f, g), x0, f(x0) * dg + g(x0) * df)
}

theorem differentiable_pointwise_mul(f: Real -> Real, g: Real -> Real, x0: Real) {
    differentiable_at(f, x0) and differentiable_at(g, x0)
    implies differentiable_at(pointwise_mul(f, g), x0)
}

theorem derivative_pointwise_square(f: Real -> Real, x0: Real, d: Real) {
    has_derivative_at(f, x0, d)
    implies has_derivative_at(pointwise_mul(f, f), x0, f(x0) * d + f(x0) * d)
}

theorem differentiable_pointwise_square(f: Real -> Real, x0: Real) {
    differentiable_at(f, x0) implies differentiable_at(pointwise_mul(f, f), x0)
}

define chain_difference_factor(g: Real -> Real, y0: Real, dg: Real, y: Real) -> Real {
    if y = y0 {
        dg
    } else {
        difference_quotient(g, y0, y)
    }
}

theorem chain_difference_factor_at_base(g: Real -> Real, y0: Real, dg: Real) {
    chain_difference_factor(g, y0, dg, y0) = dg
}

theorem chain_difference_factor_off_base(g: Real -> Real, y0: Real, dg: Real, y: Real) {
    y != y0 implies chain_difference_factor(g, y0, dg, y) = difference_quotient(g, y0, y)
}

theorem difference_quotient_eq_zero_of_value_eq(f: Real -> Real, x0: Real, x: Real) {
    x != x0 and f(x) = f(x0) implies difference_quotient(f, x0, x) = Real.0
}

theorem derivative_close_apply(f: Real -> Real, x0: Real, d: Real, delta: Real, eps: Real, x: Real) {
    (forall(y: Real) {
        y != x0 and y.is_close(x0, delta)
        implies difference_quotient(f, x0, y).is_close(d, eps)
    }) and x != x0 and x.is_close(x0, delta)
    implies difference_quotient(f, x0, x).is_close(d, eps)
}

theorem difference_quotient_compose_nonzero_inner(
    f: Real -> Real, g: Real -> Real, x0: Real, x: Real
) {
    x != x0 and f(x) != f(x0) implies
    difference_quotient(g, f(x0), f(x)) * difference_quotient(f, x0, x) =
        difference_quotient(compose(g, f), x0, x)
}

theorem difference_quotient_compose_factor(
    f: Real -> Real, g: Real -> Real, x0: Real, x: Real, dg: Real
) {
    x != x0 implies
    difference_quotient(compose(g, f), x0, x) =
        chain_difference_factor(g, f(x0), dg, f(x)) * difference_quotient(f, x0, x)
}

theorem chain_difference_factor_close(
    f: Real -> Real, g: Real -> Real, x0: Real, dg: Real,
    delta_outer: Real, eps: Real, x: Real
) {
    has_derivative_at(g, f(x0), dg) and f(x).is_close(f(x0), delta_outer)
    and delta_outer.is_positive and eps.is_positive
    and forall(y: Real) {
        y != f(x0) and y.is_close(f(x0), delta_outer)
        implies difference_quotient(g, f(x0), y).is_close(dg, eps)
    }
    implies chain_difference_factor(g, f(x0), dg, f(x)).is_close(dg, eps)
}

theorem chain_product_close(
    f: Real -> Real, g: Real -> Real, x0: Real, x: Real,
    df: Real, dg: Real, eps_small: Real, eps: Real,
    factor_bound: Real, df_bound: Real
) {
    chain_difference_factor(g, f(x0), dg, f(x)).is_close(dg, eps_small) and
    difference_quotient(f, x0, x).is_close(df, eps_small) and
    chain_difference_factor(g, f(x0), dg, f(x)).abs <= factor_bound and
    df.abs <= df_bound and factor_bound.is_positive and df_bound.is_positive and
    eps_small.is_positive and
    factor_bound * eps_small + eps_small * df_bound < eps
    implies
    (chain_difference_factor(g, f(x0), dg, f(x)) * difference_quotient(f, x0, x)).is_close(dg * df, eps)
}

theorem derivative_compose(f: Real -> Real, g: Real -> Real, x0: Real, df: Real, dg: Real) {
    has_derivative_at(f, x0, df) and has_derivative_at(g, f(x0), dg)
    implies has_derivative_at(compose(g, f), x0, dg * df)
}

theorem differentiable_compose(f: Real -> Real, g: Real -> Real, x0: Real) {
    differentiable_at(f, x0) and differentiable_at(g, f(x0))
    implies differentiable_at(compose(g, f), x0)
}

theorem neg_div(a: Real, b: Real) {
    (-a) / b = -(a / b)
}

theorem sub_add_distrib(a: Real, b: Real, c: Real, d: Real) {
    (a + b) - (c + d) = (a - c) + (b - d)
}

theorem neg_sub_neg(a: Real, b: Real) {
    -a - -b = -(a - b)
}

theorem difference_quotient_pointwise_neg(f: Real -> Real, x0: Real, x: Real) {
    x != x0 implies
    difference_quotient(pointwise_neg(f), x0, x) = -difference_quotient(f, x0, x)
}

theorem difference_quotient_pointwise_add(f: Real -> Real, g: Real -> Real, x0: Real, x: Real) {
    x != x0 implies
    difference_quotient(pointwise_add(f, g), x0, x) =
        difference_quotient(f, x0, x) + difference_quotient(g, x0, x)
}

theorem derivative_pointwise_neg(f: Real -> Real, x0: Real, d: Real) {
    has_derivative_at(f, x0, d) implies has_derivative_at(pointwise_neg(f), x0, -d)
}

theorem derivative_pointwise_add(f: Real -> Real, g: Real -> Real, x0: Real, df: Real, dg: Real) {
    has_derivative_at(f, x0, df) and has_derivative_at(g, x0, dg)
    implies has_derivative_at(pointwise_add(f, g), x0, df + dg)
}

theorem differentiable_pointwise_neg(f: Real -> Real, x0: Real) {
    differentiable_at(f, x0) implies differentiable_at(pointwise_neg(f), x0)
}

theorem differentiable_pointwise_add(f: Real -> Real, g: Real -> Real, x0: Real) {
    differentiable_at(f, x0) and differentiable_at(g, x0)
    implies differentiable_at(pointwise_add(f, g), x0)
}

theorem derivative_pointwise_sub(f: Real -> Real, g: Real -> Real, x0: Real, df: Real, dg: Real) {
    has_derivative_at(f, x0, df) and has_derivative_at(g, x0, dg)
    implies has_derivative_at(pointwise_add(f, pointwise_neg(g)), x0, df + -dg)
}

theorem differentiable_pointwise_sub(f: Real -> Real, g: Real -> Real, x0: Real) {
    differentiable_at(f, x0) and differentiable_at(g, x0)
    implies differentiable_at(pointwise_add(f, pointwise_neg(g)), x0)
}

theorem scalar_mul_close(c: Real, a: Real, b: Real, eps2: Real, eps: Real) {
    eps.is_positive and a.is_close(b, eps2) and c.abs * eps2 < eps
    implies (c * a).is_close(c * b, eps)
}

theorem mul_div_left(c: Real, a: Real, b: Real) {
    (c * a) / b = c * (a / b)
}

theorem difference_quotient_pointwise_const_mul(c: Real, f: Real -> Real, x0: Real, x: Real) {
    x != x0 implies difference_quotient(pointwise_mul(constant[Real, Real](c), f), x0, x) =
        c * difference_quotient(f, x0, x)
}

theorem difference_quotient_pointwise_mul_const(c: Real, f: Real -> Real, x0: Real, x: Real) {
    x != x0 implies difference_quotient(pointwise_mul(f, constant[Real, Real](c)), x0, x) =
        difference_quotient(f, x0, x) * c
}

theorem derivative_pointwise_const_mul(c: Real, f: Real -> Real, x0: Real, d: Real) {
    has_derivative_at(f, x0, d)
    implies has_derivative_at(pointwise_mul(constant[Real, Real](c), f), x0, c * d)
}

theorem derivative_pointwise_mul_const(c: Real, f: Real -> Real, x0: Real, d: Real) {
    has_derivative_at(f, x0, d)
    implies has_derivative_at(pointwise_mul(f, constant[Real, Real](c)), x0, d * c)
}

theorem differentiable_pointwise_const_mul(c: Real, f: Real -> Real, x0: Real) {
    differentiable_at(f, x0) implies differentiable_at(pointwise_mul(constant[Real, Real](c), f), x0)
}

theorem differentiable_pointwise_mul_const(c: Real, f: Real -> Real, x0: Real) {
    differentiable_at(f, x0) implies differentiable_at(pointwise_mul(f, constant[Real, Real](c)), x0)
}

theorem derivative_pointwise_affine(c: Real, b: Real, f: Real -> Real, x0: Real, d: Real) {
    has_derivative_at(f, x0, d)
    implies has_derivative_at(
        pointwise_add(pointwise_mul(constant[Real, Real](c), f), constant[Real, Real](b)),
        x0,
        c * d
    )
}

theorem differentiable_pointwise_affine(c: Real, b: Real, f: Real -> Real, x0: Real) {
    differentiable_at(f, x0) implies differentiable_at(
        pointwise_add(pointwise_mul(constant[Real, Real](c), f), constant[Real, Real](b)),
        x0
    )
}

theorem derivative_pointwise_linear_combination(
    a: Real, b: Real, f: Real -> Real, g: Real -> Real, x0: Real, df: Real, dg: Real
) {
    has_derivative_at(f, x0, df) and has_derivative_at(g, x0, dg)
    implies has_derivative_at(
        pointwise_add(pointwise_mul(constant[Real, Real](a), f), pointwise_mul(constant[Real, Real](b), g)),
        x0,
        a * df + b * dg
    )
}

theorem differentiable_pointwise_linear_combination(
    a: Real, b: Real, f: Real -> Real, g: Real -> Real, x0: Real
) {
    differentiable_at(f, x0) and differentiable_at(g, x0)
    implies differentiable_at(
        pointwise_add(pointwise_mul(constant[Real, Real](a), f), pointwise_mul(constant[Real, Real](b), g)),
        x0
    )
}

theorem affine_identity_has_derivative_at(c: Real, b: Real, x0: Real) {
    has_derivative_at(
        pointwise_add(pointwise_mul(constant[Real, Real](c), identity_fn[Real]), constant[Real, Real](b)),
        x0,
        c
    )
}

theorem affine_identity_differentiable_at(c: Real, b: Real, x0: Real) {
    differentiable_at(
        pointwise_add(pointwise_mul(constant[Real, Real](c), identity_fn[Real]), constant[Real, Real](b)),
        x0
    )
}

define is_derivative_fn(f: Real -> Real, df: Real -> Real) -> Bool {
    forall(x: Real) {
        has_derivative_at(f, x, df(x))
    }
}

define differentiable_everywhere(f: Real -> Real) -> Bool {
    forall(x: Real) {
        differentiable_at(f, x)
    }
}

theorem differentiable_everywhere_at(f: Real -> Real, x: Real) {
    differentiable_everywhere(f) implies differentiable_at(f, x)
}

theorem is_derivative_fn_iff(f: Real -> Real, df: Real -> Real) {
    is_derivative_fn(f, df) = forall(x: Real) {
        has_derivative_at(f, x, df(x))
    }
}

theorem is_derivative_fn_at(f: Real -> Real, df: Real -> Real, x: Real) {
    is_derivative_fn(f, df) implies has_derivative_at(f, x, df(x))
}

theorem is_derivative_fn_imp_differentiable_everywhere(f: Real -> Real, df: Real -> Real) {
    is_derivative_fn(f, df) implies differentiable_everywhere(f)
}

theorem is_derivative_fn_imp_differentiable_at(f: Real -> Real, df: Real -> Real, x: Real) {
    is_derivative_fn(f, df) implies differentiable_at(f, x)
}

theorem derivative_fn_value_unique(
    f: Real -> Real, df: Real -> Real, x: Real, d: Real
) {
    is_derivative_fn(f, df) and has_derivative_at(f, x, d) implies df(x) = d
}

theorem derivative_fn_constant(c: Real) {
    is_derivative_fn(constant[Real, Real](c), constant[Real, Real](Real.0))
}

theorem derivative_fn_identity {
    is_derivative_fn(identity_fn[Real], constant[Real, Real](Real.1))
}

theorem differentiable_everywhere_constant(c: Real) {
    differentiable_everywhere(constant[Real, Real](c))
}

theorem differentiable_everywhere_identity {
    differentiable_everywhere(identity_fn[Real])
}

theorem derivative_fn_neg(f: Real -> Real, df: Real -> Real) {
    is_derivative_fn(f, df) implies is_derivative_fn(pointwise_neg(f), pointwise_neg(df))
}

theorem derivative_fn_add(f: Real -> Real, g: Real -> Real, df: Real -> Real, dg: Real -> Real) {
    is_derivative_fn(f, df) and is_derivative_fn(g, dg)
        implies is_derivative_fn(pointwise_add(f, g), pointwise_add(df, dg))
}

theorem derivative_fn_sub(f: Real -> Real, g: Real -> Real, df: Real -> Real, dg: Real -> Real) {
    is_derivative_fn(f, df) and is_derivative_fn(g, dg)
        implies is_derivative_fn(pointwise_add(f, pointwise_neg(g)), pointwise_add(df, pointwise_neg(dg)))
}

theorem derivative_fn_const_mul(c: Real, f: Real -> Real, df: Real -> Real) {
    is_derivative_fn(f, df)
        implies is_derivative_fn(pointwise_mul(constant[Real, Real](c), f), pointwise_mul(constant[Real, Real](c), df))
}

theorem derivative_fn_mul_const(c: Real, f: Real -> Real, df: Real -> Real) {
    is_derivative_fn(f, df)
        implies is_derivative_fn(pointwise_mul(f, constant[Real, Real](c)), pointwise_mul(df, constant[Real, Real](c)))
}

theorem derivative_fn_linear_combination(
    a: Real, b: Real, f: Real -> Real, g: Real -> Real, df: Real -> Real, dg: Real -> Real
) {
    is_derivative_fn(f, df) and is_derivative_fn(g, dg) implies is_derivative_fn(
        pointwise_add(pointwise_mul(constant[Real, Real](a), f), pointwise_mul(constant[Real, Real](b), g)),
        pointwise_add(pointwise_mul(constant[Real, Real](a), df), pointwise_mul(constant[Real, Real](b), dg))
    )
}

theorem derivative_fn_mul(f: Real -> Real, g: Real -> Real, df: Real -> Real, dg: Real -> Real) {
    is_derivative_fn(f, df) and is_derivative_fn(g, dg)
        implies is_derivative_fn(pointwise_mul(f, g), pointwise_add(pointwise_mul(f, dg), pointwise_mul(g, df)))
}

theorem derivative_fn_square(f: Real -> Real, df: Real -> Real) {
    is_derivative_fn(f, df)
        implies is_derivative_fn(pointwise_mul(f, f), pointwise_add(pointwise_mul(f, df), pointwise_mul(f, df)))
}

theorem derivative_fn_compose(
    f: Real -> Real, g: Real -> Real, df: Real -> Real, dg: Real -> Real
) {
    is_derivative_fn(f, df) and is_derivative_fn(g, dg)
        implies is_derivative_fn(compose(g, f), pointwise_mul(compose(dg, f), df))
}

theorem differentiable_everywhere_neg(f: Real -> Real) {
    differentiable_everywhere(f) implies differentiable_everywhere(pointwise_neg(f))
}

theorem differentiable_everywhere_add(f: Real -> Real, g: Real -> Real) {
    differentiable_everywhere(f) and differentiable_everywhere(g)
        implies differentiable_everywhere(pointwise_add(f, g))
}

theorem differentiable_everywhere_sub(f: Real -> Real, g: Real -> Real) {
    differentiable_everywhere(f) and differentiable_everywhere(g)
        implies differentiable_everywhere(pointwise_add(f, pointwise_neg(g)))
}

theorem differentiable_everywhere_mul(f: Real -> Real, g: Real -> Real) {
    differentiable_everywhere(f) and differentiable_everywhere(g)
        implies differentiable_everywhere(pointwise_mul(f, g))
}

theorem differentiable_everywhere_square(f: Real -> Real) {
    differentiable_everywhere(f) implies differentiable_everywhere(pointwise_mul(f, f))
}

theorem differentiable_everywhere_compose(f: Real -> Real, g: Real -> Real) {
    differentiable_everywhere(f) and differentiable_everywhere(g)
        implies differentiable_everywhere(compose(g, f))
}

theorem differentiable_everywhere_const_mul(c: Real, f: Real -> Real) {
    differentiable_everywhere(f)
        implies differentiable_everywhere(pointwise_mul(constant[Real, Real](c), f))
}

theorem differentiable_everywhere_mul_const(c: Real, f: Real -> Real) {
    differentiable_everywhere(f)
        implies differentiable_everywhere(pointwise_mul(f, constant[Real, Real](c)))
}

theorem differentiable_everywhere_linear_combination(
    a: Real, b: Real, f: Real -> Real, g: Real -> Real
) {
    differentiable_everywhere(f) and differentiable_everywhere(g) implies differentiable_everywhere(
        pointwise_add(pointwise_mul(constant[Real, Real](a), f), pointwise_mul(constant[Real, Real](b), g))
    )
}

theorem derivative_fn_affine_identity(c: Real, b: Real) {
    is_derivative_fn(
        pointwise_add(pointwise_mul(constant[Real, Real](c), identity_fn[Real]), constant[Real, Real](b)),
        constant[Real, Real](c)
    )
}

theorem differentiable_everywhere_affine_identity(c: Real, b: Real) {
    differentiable_everywhere(
        pointwise_add(pointwise_mul(constant[Real, Real](c), identity_fn[Real]), constant[Real, Real](b))
    )
}

theorem is_derivative_fn_imp_continuous_at(f: Real -> Real, df: Real -> Real, x: Real) {
    is_derivative_fn(f, df) implies continuous_at(f, x)
}

theorem differentiable_everywhere_imp_continuous_at(f: Real -> Real, x: Real) {
    differentiable_everywhere(f) implies continuous_at(f, x)
}

theorem continuous_at_intro(f: Real -> Real, x: Real) {
    forall(eps: Real) {
        eps.is_positive implies exists(delta: Real) {
            delta.is_positive and continuous_condition(f, x, delta, eps)
        }
    } implies continuous_at(f, x)
}

theorem continuous_intro(f: Real -> Real) {
    forall(x: Real) {
        continuous_at(f, x)
    } implies continuous(f)
}

theorem continuous_imp_continuous_at(f: Real -> Real, x: Real) {
    continuous(f) implies continuous_at(f, x)
}

theorem continuous_at_delta(f: Real -> Real, x: Real, eps: Real) {
    continuous_at(f, x) and eps.is_positive implies exists(delta: Real) {
        delta.is_positive and continuous_condition(f, x, delta, eps)
    }
}

theorem constant_function_is_uniform(c: Real) {
    uniform(constant[Real, Real](c))
}

theorem constant_function_is_continuous(c: Real) {
    continuous(constant[Real, Real](c))
}

theorem constant_function_is_continuous_at(c: Real, x: Real) {
    continuous_at(constant[Real, Real](c), x)
}

theorem continuous_condition_compose(
    f: Real -> Real, g: Real -> Real, x: Real, eta: Real, delta: Real, eps: Real
) {
    continuous_condition(f, g(x), eta, eps) and continuous_condition(g, x, delta, eta)
    implies continuous_condition(compose(f, g), x, delta, eps)
}

theorem continuous_at_compose(f: Real -> Real, g: Real -> Real, x: Real) {
    continuous_at(g, x) and continuous_at(f, g(x)) implies continuous_at(compose(f, g), x)
}

theorem continuous_compose(f: Real -> Real, g: Real -> Real) {
    continuous(f) and continuous(g) implies continuous(compose(f, g))
}

theorem continuous_condition_imp_continuous_at(f: Real -> Real, x: Real) {
    forall(eps: Real) {
        eps.is_positive implies exists(delta: Real) {
            delta.is_positive and continuous_condition(f, x, delta, eps)
        }
    }
    implies
    continuous_at(f, x)
}

theorem compose_continuous_at(f: Real -> Real, g: Real -> Real, x: Real) {
    continuous_at(g, x) and continuous_at(f, g(x))
    implies
    continuous_at(compose(f, g), x)
}

theorem compose_continuous(f: Real -> Real, g: Real -> Real) {
    continuous(f) and continuous(g)
    implies
    continuous(compose(f, g))
}

theorem add_fns_continuous_at(f: Real -> Real, g: Real -> Real, x: Real) {
    continuous_at(f, x) and continuous_at(g, x)
    implies
    continuous_at(add_fns(f, g), x)
}

theorem add_fns_continuous(f: Real -> Real, g: Real -> Real) {
    continuous(f) and continuous(g)
    implies
    continuous(add_fns(f, g))
}

define const_add_left(c: Real, f: Real -> Real, x: Real) -> Real {
    c + f(x)
}

define const_add_right(f: Real -> Real, c: Real, x: Real) -> Real {
    f(x) + c
}

theorem add_fns_constant_left_eq(c: Real, f: Real -> Real) {
    add_fns[Real](constant[Real, Real](c), f) = const_add_left(c, f)
}

theorem add_fns_constant_right_eq(f: Real -> Real, c: Real) {
    add_fns[Real](f, constant[Real, Real](c)) = const_add_right(f, c)
}

theorem continuous_at_const_add_left(c: Real, f: Real -> Real, x: Real) {
    continuous_at(f, x)
    implies continuous_at(const_add_left(c, f), x)
}

theorem continuous_const_add_left(c: Real, f: Real -> Real) {
    continuous(f) implies continuous(const_add_left(c, f))
}

theorem continuous_at_const_add_right(f: Real -> Real, c: Real, x: Real) {
    continuous_at(f, x)
    implies continuous_at(const_add_right(f, c), x)
}

theorem continuous_const_add_right(f: Real -> Real, c: Real) {
    continuous(f) implies continuous(const_add_right(f, c))
}

define const_mul_left(c: Real, f: Real -> Real, x: Real) -> Real {
    c * f(x)
}

define const_mul_right(f: Real -> Real, c: Real, x: Real) -> Real {
    f(x) * c
}

theorem continuous_at_const_mul_left(c: Real, f: Real -> Real, x: Real) {
    continuous_at(f, x)
    implies continuous_at(const_mul_left(c, f), x)
}

theorem continuous_const_mul_left(c: Real, f: Real -> Real) {
    continuous(f) implies continuous(const_mul_left(c, f))
}

theorem continuous_at_const_mul_right(f: Real -> Real, c: Real, x: Real) {
    continuous_at(f, x)
    implies continuous_at(const_mul_right(f, c), x)
}

theorem continuous_const_mul_right(f: Real -> Real, c: Real) {
    continuous(f) implies continuous(const_mul_right(f, c))
}

theorem pointwise_mul_constant_left_eq(c: Real, f: Real -> Real) {
    pointwise_mul[Real, Real](constant[Real, Real](c), f) = const_mul_left(c, f)
}

theorem pointwise_mul_constant_right_eq(f: Real -> Real, c: Real) {
    pointwise_mul[Real, Real](f, constant[Real, Real](c)) = const_mul_right(f, c)
}

define is_cauchy_seq_at(a: Nat -> Real, eps: Real) -> Bool {
    eps.is_positive implies exists(n: Nat) {
        forall(i: Nat, j: Nat) {
            n <= i and n <= j implies a(i).is_close(a(j), eps)
        }
    }
}

theorem is_cauchy_seq_at_intro(a: Nat -> Real, eps: Real) {
    (eps.is_positive implies exists(n: Nat) {
        forall(i: Nat, j: Nat) {
            n <= i and n <= j implies a(i).is_close(a(j), eps)
        }
    }) implies is_cauchy_seq_at(a, eps)
}

define is_cauchy_seq(a: Nat -> Real) -> Bool {
    forall(eps: Real) {
        is_cauchy_seq_at(a, eps)
    }
}

theorem is_cauchy_seq_intro(a: Nat -> Real) {
    (forall(eps: Real) { is_cauchy_seq_at(a, eps) }) implies is_cauchy_seq(a)
}

theorem cauchy_bound_all_indices(a: Nat -> Real, n: Nat, eps: Real) {
    cauchy_bound(a, n, eps) implies forall(i: Nat, j: Nat) {
        n <= i and n <= j implies a(i).is_close(a(j), eps)
    }
}

theorem cauchy_bound_indices(a: Nat -> Real, n: Nat, eps: Real, i: Nat, j: Nat) {
    cauchy_bound(a, n, eps) and n <= i and n <= j implies a(i).is_close(a(j), eps)
}

theorem cauchy_imp_converges(a: Nat -> Real) {
    is_cauchy_seq(a) implies converges(a)
}

theorem converges_imp_cauchy_bound(a: Nat -> Real, eps: Real) {
    converges(a) and eps.is_positive implies exists(n: Nat) {
        cauchy_bound(a, n, eps)
    }
}

theorem converges_imp_explicit_tail(a: Nat -> Real, eps: Real) {
    converges(a) and eps.is_positive implies exists(n: Nat) {
        forall(i: Nat, j: Nat) {
            n <= i and n <= j implies a(i).is_close(a(j), eps)
        }
    }
}

theorem converges_imp_cauchy_seq(a: Nat -> Real) {
    converges(a) implies is_cauchy_seq(a)
}

theorem converges_to_imp_cauchy(a: Nat -> Real, x: Real) {
    converges_to(a, x) implies is_cauchy_seq(a)
}

theorem cauchy_imp_converges_to_limit(a: Nat -> Real) {
    is_cauchy_seq(a) implies converges_to(a, limit(a))
}

theorem cauchy_imp_exists_limit(a: Nat -> Real) {
    is_cauchy_seq(a) implies exists(x: Real) {
        converges_to(a, x)
    }
}

theorem cauchy_iff_exists_limit_forward(a: Nat -> Real) {
    is_cauchy_seq(a) implies exists(x: Real) {
        converges_to(a, x)
    }
}

theorem cauchy_iff_exists_limit_backward(a: Nat -> Real) {
    (exists(x: Real) { converges_to(a, x) }) implies is_cauchy_seq(a)
}

theorem identity_function_is_uniform {
    uniform(identity_fn[Real])
}

theorem identity_function_is_continuous {
    continuous(identity_fn[Real])
}

theorem continuous_at_preserves_sequence_limit(f: Real -> Real, a: Nat -> Real, x: Real) {
    continuous_at(f, x) and converges_to(a, x) implies converges_to(compose(f, a), f(x))
}

theorem continuous_function_preserves_sequence_limit(f: Real -> Real, a: Nat -> Real, x: Real) {
    continuous(f) and converges_to(a, x) implies converges_to(compose(f, a), f(x))
}

theorem uniform_condition_maps_close(f: Real -> Real, x: Real, y: Real, delta: Real, eps: Real) {
    uniform_condition(f, delta, eps) and x.is_close(y, delta) implies f(x).is_close(f(y), eps)
}

theorem uniform_condition_preserves_cauchy_bound(f: Real -> Real, a: Nat -> Real,
    n: Nat, delta: Real, eps: Real) {
    uniform_condition(f, delta, eps) and cauchy_bound(a, n, delta)
        implies cauchy_bound(compose(f, a), n, eps)
}

theorem uniform_preserves_converges(f: Real -> Real, a: Nat -> Real) {
    uniform(f) and converges(a) implies converges(compose(f, a))
}

theorem uniform_preserves_cauchy_seq(f: Real -> Real, a: Nat -> Real) {
    uniform(f) and is_cauchy_seq(a) implies is_cauchy_seq(compose(f, a))
}

define affine_real(a: Real, b: Real, x: Real) -> Real {
    a * x + b
}

theorem affine_real_eq_const_add_const_mul(a: Real, b: Real) {
    affine_real(a, b) = const_add_right(const_mul_left(a, identity_fn[Real]), b)
}

theorem continuous_at_affine_real(a: Real, b: Real, x: Real) {
    continuous_at(affine_real(a, b), x)
}

theorem continuous_affine_real(a: Real, b: Real) {
