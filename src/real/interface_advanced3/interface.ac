theorem log_nonneg_of_ge_one(x: Real, y: Real) {
    x >= Real.1 and x.log = Option.some(y) implies y >= Real.0
}

theorem log_nonpos_of_pos_le_one(x: Real, y: Real) {
    x > Real.0 and x <= Real.1 and x.log = Option.some(y) implies y <= Real.0
