            a(n).abs < bound
        }
    }
}

theorem real_strict_upper_bound_pair(a: Real, b: Real) {
    exists(c: Real) {
        a < c and b < c
    }
}

theorem finite_seq_real_abs_bounded(a: Nat -> Real, n: Nat) {
    exists(bound: Real) {
        forall(i: Nat) {
            i <= n implies a(i).abs < bound
        }
    }
}

theorem converges_to_imp_bounded_seq(a: Nat -> Real, x: Real) {
    converges_to(a, x) implies is_bounded_seq(a)
}

theorem converges_imp_bounded_seq(a: Nat -> Real) {
    converges(a) implies is_bounded_seq(a)
}

theorem bounded_seq_positive_bound(a: Nat -> Real) {
    is_bounded_seq(a) implies exists(bound: Real) {
        bound.is_positive and forall(n: Nat) {
            a(n).abs < bound
        }
    }
}

theorem const_seq_bounded(c: Real) {
    is_bounded_seq(const_seq(c))
}

theorem convergent_seq_bounded(a: Nat -> Real) {
    converges(a) implies is_bounded_seq(a)
}

theorem converges_to_seq_bounded(a: Nat -> Real, x: Real) {
    converges_to(a, x) implies is_bounded_seq(a)
}

theorem bounded_neg_seq(a: Nat -> Real) {
    is_bounded_seq(a) implies is_bounded_seq(neg_seq(a))
}

theorem bounded_abs_seq(a: Nat -> Real) {
    is_bounded_seq(a) implies is_bounded_seq(abs_seq(a))
}

theorem bounded_of_abs_lte_abs(a: Nat -> Real, b: Nat -> Real) {
    seq_lte(abs_seq(a), abs_seq(b)) and is_bounded_seq(b) implies is_bounded_seq(a)
}

theorem bounded_mul_seq(c: Real, a: Nat -> Real) {
    is_bounded_seq(a) implies is_bounded_seq(mul_seq(c, a))
}

theorem bounded_add_seq(a: Nat -> Real, b: Nat -> Real) {
    is_bounded_seq(a) and is_bounded_seq(b) implies is_bounded_seq(add_seq(a, b))
}

theorem bounded_prod_seq(a: Nat -> Real, b: Nat -> Real) {
    is_bounded_seq(a) and is_bounded_seq(b) implies is_bounded_seq(prod_seq(a, b))
}

theorem vanishes_mul_seq(c: Real, a: Nat -> Real) {
    vanishes(a) implies vanishes(mul_seq(c, a))
}

theorem vanishes_add_seq(a: Nat -> Real, b: Nat -> Real) {
    vanishes(a) and vanishes(b) implies vanishes(add_seq(a, b))
}

theorem convergent_mul_vanishing_seq(a: Nat -> Real, b: Nat -> Real) {
    converges(a) and vanishes(b) implies vanishes(prod_seq(a, b))
}

theorem vanishing_mul_convergent_seq(a: Nat -> Real, b: Nat -> Real) {
    vanishes(a) and converges(b) implies vanishes(prod_seq(a, b))
}

theorem prod_seq_comm(a: Nat -> Real, b: Nat -> Real) {
    prod_seq(a, b) = prod_seq(b, a)
}

theorem tail_bounds_imp_converges_to(q: Nat -> Real, x: Real) {
    (forall(eps: Real) {
        eps.is_positive implies exists(n: Nat) {
            tail_bound(q, x, n, eps)
        }
    }) implies converges_to(q, x)
}

theorem converges_to_zero_imp_vanishes(q: Nat -> Real) {
    converges_to(q, Real.0) implies vanishes(q)
}

theorem bounded_mul_vanishing_seq_tail_bound(a: Nat -> Real, b: Nat -> Real) {
    is_bounded_seq(a) and vanishes(b) implies forall(eps: Real) {
        eps.is_positive implies exists(n: Nat) {
            tail_bound(prod_seq(a, b), Real.0, n, eps)
        }
    }
}

theorem bounded_mul_vanishing_seq(a: Nat -> Real, b: Nat -> Real) {
    is_bounded_seq(a) and vanishes(b) implies vanishes(prod_seq(a, b))
}

theorem vanishing_mul_bounded_seq(a: Nat -> Real, b: Nat -> Real) {
    vanishes(a) and is_bounded_seq(b) implies vanishes(prod_seq(a, b))
}

theorem bounded_sub_seq(a: Nat -> Real, b: Nat -> Real) {
    is_bounded_seq(a) and is_bounded_seq(b) implies is_bounded_seq(sub_seq(a, b))
}

theorem vanishes_sub_seq(a: Nat -> Real, b: Nat -> Real) {
    vanishes(a) and vanishes(b) implies vanishes(sub_seq(a, b))
}

theorem bounded_linear_combination_two(a: Nat -> Real, b: Nat -> Real, c: Real, d: Real) {
    is_bounded_seq(a) and is_bounded_seq(b) implies is_bounded_seq(add_seq(mul_seq(c, a), mul_seq(d, b)))
}

theorem vanishes_linear_combination_two(a: Nat -> Real, b: Nat -> Real, c: Real, d: Real) {
    vanishes(a) and vanishes(b) implies vanishes(add_seq(mul_seq(c, a), mul_seq(d, b)))
}

theorem bounded_scalar_add_seq(a: Nat -> Real, b: Nat -> Real, c: Real) {
    is_bounded_seq(a) and is_bounded_seq(b) implies is_bounded_seq(add_seq(mul_seq(c, a), b))
}

theorem vanishes_scalar_add_seq(a: Nat -> Real, b: Nat -> Real, c: Real) {
    vanishes(a) and vanishes(b) implies vanishes(add_seq(mul_seq(c, a), b))
}

theorem bounded_prod_linear_combinations_two(
    a: Nat -> Real,
    b: Nat -> Real,
    c: Nat -> Real,
    d: Nat -> Real,
    alpha: Real,
    beta: Real,
    gamma: Real,
    delta: Real
) {
    is_bounded_seq(a) and is_bounded_seq(b) and is_bounded_seq(c) and is_bounded_seq(d)
    implies is_bounded_seq(prod_seq(add_seq(mul_seq(alpha, a), mul_seq(beta, b)),
        add_seq(mul_seq(gamma, c), mul_seq(delta, d))))
}

theorem bounded_linear_combination_mul_vanishing(
    a: Nat -> Real,
    b: Nat -> Real,
    c: Nat -> Real,
    alpha: Real,
    beta: Real
) {
    is_bounded_seq(a) and is_bounded_seq(b) and vanishes(c)
    implies vanishes(prod_seq(add_seq(mul_seq(alpha, a), mul_seq(beta, b)), c))
}

theorem vanishing_mul_bounded_linear_combination(
    a: Nat -> Real,
    b: Nat -> Real,
    c: Nat -> Real,
    alpha: Real,
    beta: Real
) {
    vanishes(a) and is_bounded_seq(b) and is_bounded_seq(c)
    implies vanishes(prod_seq(a, add_seq(mul_seq(alpha, b), mul_seq(beta, c))))
}

theorem vanishing_linear_combination_mul_bounded_linear_combination(
    a: Nat -> Real,
    b: Nat -> Real,
    c: Nat -> Real,
    d: Nat -> Real,
    alpha: Real,
    beta: Real,
    gamma: Real,
    delta: Real
) {
    vanishes(a) and vanishes(b) and is_bounded_seq(c) and is_bounded_seq(d)
    implies vanishes(prod_seq(add_seq(mul_seq(alpha, a), mul_seq(beta, b)),
        add_seq(mul_seq(gamma, c), mul_seq(delta, d))))
}

define rat_condition(f: Rat -> Real, delta: Rat, eps: Real) -> Bool {
    forall(r1: Rat, r2: Rat) {
        r1.is_close(r2, delta) implies f(r1).is_close(f(r2), eps)
    }
}

define rat_uniform(f: Rat -> Real) -> Bool {
    forall(eps: Real) {
        eps.is_positive implies exists(delta: Rat) {
            delta.is_positive and rat_condition(f, delta, eps)
        }
    }
}

theorem uniform_imp_seq(f: Rat -> Real, q: Nat -> Rat) {
    rat_uniform(f) and converges(lift_seq(q))
    implies
    converges(compose(f, q))
}

define uniform_condition(f: Real -> Real, delta: Real, eps: Real) -> Bool {
    forall(r1: Real, r2: Real) {
        r1.is_close(r2, delta) implies f(r1).is_close(f(r2), eps)
    }
}

define uniform(f: Real -> Real) -> Bool {
    forall(eps: Real) {
        eps.is_positive implies exists(delta: Real) {
            delta.is_positive and uniform_condition(f, delta, eps)
        }
    }
}

theorem uniform_witness(f: Real -> Real, eps: Real) {
    uniform(f) and eps.is_positive implies exists(delta: Real) {
        delta.is_positive and uniform_condition(f, delta, eps)
    }
}

theorem converges_imp_close_tail_bound(a: Nat -> Real, eps: Real) {
    converges(a) and eps.is_positive implies exists(n: Nat) {
        forall(i: Nat) {
            n <= i implies a(i).is_close(limit(a), eps)
        }
    }
}

theorem uniform_condition_exists(g: Real -> Real, eps: Real, delta: Real) {
    eps.is_positive and delta.is_positive and uniform_condition(g, delta, eps)
    implies
    exists(delta2: Real) {
        delta2.is_positive and uniform_condition(g, delta2, eps)
    }
}

theorem limit_compose_uniform(f: Real -> Real, a: Nat -> Real) {
    uniform(f) and converges(a)
    implies
    converges_to(compose(f, a), f(limit(a)))
}

theorem limit_compose_rat_uniform(f: Rat -> Real, a: Nat -> Rat, r: Rat) {
    rat_uniform(f)
    and converges_to(lift_seq(a), Real.from_rat(r))
    implies
    converges_to(compose(f, a), f(r))
}

define lift_uc(f: Rat -> Real, x: Real) -> Real {
    limit(compose(f, rat_seq(x)))
}

theorem lift_fixes_rats(f: Rat -> Real, r: Rat) {
    rat_uniform(f)
    implies
    lift_uc(f, Real.from_rat(r)) = f(r)
}

theorem lift_uniform_is_uniform(f: Rat -> Real) {
    rat_uniform(f)
    implies
    uniform(lift_uc(f))
}

theorem positive_real_has_close_rat(x: Real, delta: Real) {
    delta.is_positive implies exists(r: Rat) {
        Real.from_rat(r).is_close(x, delta)
    }
}

theorem uniform_ne_imp_rat_ne(f: Real -> Real, g: Real -> Real) {
    uniform(f) and uniform(g) and f != g implies
    exists(r: Rat) {
        f(Real.from_rat(r)) != g(Real.from_rat(r))
    }
}

define rat_increasing(f: Rat -> Real) -> Bool {
    forall(r1: Rat, r2: Rat) {
        r1 < r2 implies f(r1) < f(r2)
    }
}

define increasing(f: Real -> Real) -> Bool {
    forall(x: Real, y: Real) {
        x < y implies f(x) < f(y)
    }
}

theorem uni_cond_imp_rat_cond(f: Real -> Real, delta: Rat, eps: Real) {
    uniform_condition(f, Real.from_rat(delta), eps)
    implies
    rat_condition(compose(f, Real.from_rat), delta, eps)
}

theorem uniform_imp_rat_uniform(f: Real -> Real) {
    uniform(f)
    implies
    rat_uniform(compose(f, Real.from_rat))
}

theorem tighten_uc(f: Real -> Real, delta1: Real, delta2: Real, eps: Real) {
    delta1.is_positive and delta2.is_positive and
    uniform_condition(f, delta1, eps) and delta2 < delta1
    implies
    uniform_condition(f, delta2, eps)
}

theorem add_real_eps_between(a: Real, b: Real) {
    a < b implies
    exists(eps: Real) {
        eps.is_positive and a + eps < b
    }
}

theorem lift_inc_is_inc(f: Rat -> Real) {
    rat_uniform(f) and rat_increasing(f)
    implies
    increasing(lift_uc(f))
}
