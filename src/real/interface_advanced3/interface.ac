define abs_fn_2(f: (Nat, Nat) -> Real, m: Nat, n: Nat) -> Real {
    f(m, n).abs
}

define pos_part_2(f: (Nat, Nat) -> Real, m: Nat, n: Nat) -> Real {
    f(m, n).max(Real.0)
}

define neg_part_2(f: (Nat, Nat) -> Real, m: Nat, n: Nat) -> Real {
