theorem pair_meet_new_left[A: MeetSemilattice, B: MeetSemilattice](a: A, b: B, q: Pair[A, B]) {
    pair_meet(Pair.new(a, b), q) = Pair.new(a.meet(q.first), b.meet(q.second))
