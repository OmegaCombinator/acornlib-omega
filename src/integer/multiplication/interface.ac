define image_pred[A, B](f: A -> B, p: A -> Bool, y: B) -> Bool {
    exists(x: A) { p(x) and f(x) = y }
}

define is_idempotent_map[A](f: A -> A) -> Bool {
    forall(a: A) {
        f(f(a)) = f(a)
