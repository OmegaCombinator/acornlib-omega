define is_extensive[A: PartialOrder](f: A -> A) -> Bool {
    forall(a: A) {
        a <= f(a)
    }
}

define is_reductive[A: PartialOrder](f: A -> A) -> Bool {
    forall(a: A) {
        f(a) <= a
