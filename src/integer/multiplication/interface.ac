define is_galois_insertion[A: PartialOrder, B: PartialOrder](
    lower: A -> B,
    upper: B -> A
) -> Bool {
    is_galois_connection(lower, upper) and forall(b: B) {
        lower(upper(b)) = b
    }
}

define is_galois_coinsertion[A: PartialOrder, B: PartialOrder](
    lower: A -> B,
