theorem pair_map_compose_fn[A, B, C, D, E, F](f: C -> E, g: A -> C, h: D -> F, i: B -> D) {
    pair_map(compose(f, g), compose(h, i)) = compose(pair_map(f, h), pair_map(g, i))
}

