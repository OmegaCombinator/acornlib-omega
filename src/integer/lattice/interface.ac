}

theorem add_left_map_apply[G: AddLeftOrderedGroup](c: G, x: G) {
    add_left_map(c, x) = c + x
}

theorem add_right_map_apply[G: AddOrderedGroup](c: G, x: G) {
    add_right_map(c, x) = x + c
