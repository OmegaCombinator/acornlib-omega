theorem reduce_zero_num_eq_zero(b: Int) {
    reduce(Int.0, b) = Rat.0
}

theorem reduce_positive_of_positive(a: Int, b: Int) {
    a.is_positive and b.is_positive implies reduce(a, b).is_positive
}

theorem reduce_nonnegative_of_nonnegative(a: Int, b: Int) {
    not a.is_negative and not b.is_negative implies not reduce(a, b).is_negative
}

theorem reduce_abs_num_denom(a: Int, b: Int) {
    reduce(a.abs, b.abs) = reduce(a, b).abs
}

theorem reduce_neg_neg(a: Int, b: Int) {
    reduce(-a, -b) = reduce(a, b)
}

theorem rat_positive_iff_zero_lt(q: Rat) {
    q.is_positive = (Rat.0 < q)
}

theorem rat_negative_iff_lt_zero(q: Rat) {
    q.is_negative = (q < Rat.0)
}

theorem rat_lt_irrefl(q: Rat) {
    not q < q
}

theorem rat_trichotomy_cases(a: Rat, b: Rat) {
    a < b or a = b or b < a
}

theorem rat_abs_nonnegative(q: Rat) {
    Rat.0 <= q.abs
}

theorem rat_lte_abs_self(q: Rat) {
    q <= q.abs
}

theorem rat_abs_neg(q: Rat) {
    (-q).abs = q.abs
}

theorem rat_abs_not_negative(q: Rat) {
    not q.abs.is_negative
}

theorem rat_cross_mul_lt_fraction(a: Rat, b: Rat, c: Rat, d: Rat) {
    b.is_positive and d.is_positive and a * d < c * b implies a / b < c / d
}

theorem rat_cross_mul_lte_fraction(a: Rat, b: Rat, c: Rat, d: Rat) {
    b.is_positive and d.is_positive and a * d <= c * b implies a / b <= c / d
}

theorem rat_lte_transitive(a: Rat, b: Rat, c: Rat) {
    a <= b and b <= c implies a <= c
}

theorem rat_lt_transitive(a: Rat, b: Rat, c: Rat) {
    a < b and b < c implies a < c
}

theorem rat_lte_lt_transitive(a: Rat, b: Rat, c: Rat) {
    a <= b and b < c implies a < c
}

theorem rat_lt_lte_transitive(a: Rat, b: Rat, c: Rat) {
    a < b and b <= c implies a < c
}

theorem reduce_zero_denominator(a: Int) {
    reduce(a, Int.0) = Rat.0
}

theorem rat_num_zero_imp_zero(q: Rat) {
    q.num = Int.0 implies q = Rat.0
}

theorem rat_zero_iff_num_zero(q: Rat) {
    (q = Rat.0) = (q.num = Int.0)
}

theorem rat_nonzero_iff_num_nonzero(q: Rat) {
    (q != Rat.0) = (q.num != Int.0)
}

theorem rat_zero_not_positive {
    not Rat.0.is_positive
}

theorem rat_zero_not_negative {
    not Rat.0.is_negative
}

theorem rat_positive_imp_nonzero(q: Rat) {
    q.is_positive implies q != Rat.0
}

theorem rat_negative_imp_nonzero(q: Rat) {
    q.is_negative implies q != Rat.0
}

theorem rat_negative_imp_not_positive(q: Rat) {
    q.is_negative implies not q.is_positive
}

theorem rat_nonzero_imp_positive_or_negative(q: Rat) {
    q != Rat.0 implies q.is_positive or q.is_negative
}

theorem rat_abs_zero {
    Rat.0.abs = Rat.0
}

theorem rat_abs_zero_iff_zero(q: Rat) {
    (q.abs = Rat.0) = (q = Rat.0)
}

theorem rat_abs_positive_self(q: Rat) {
    q.is_positive implies q.abs = q
}

theorem rat_abs_negative_neg(q: Rat) {
    q.is_negative implies q.abs = -q
}

theorem from_int_zero_iff(n: Int) {
    (Rat.from_int(n) = Rat.0) = (n = Int.0)
}

theorem from_int_nonzero_iff(n: Int) {
    (Rat.from_int(n) != Rat.0) = (n != Int.0)
}

theorem from_int_positive_iff(n: Int) {
    Rat.from_int(n).is_positive = n.is_positive
}

theorem from_int_negative_iff(n: Int) {
    Rat.from_int(n).is_negative = n.is_negative
}

