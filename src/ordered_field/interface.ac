theorem mul_right_scalar_map_gt_iff_lt_of_negative[F: OrderedField](c: F, x: F, y: F) {
    c < F.0 and c.inverse < F.0 implies (mul_right_scalar_map(c, x) > mul_right_scalar_map(c, y) = (x < y))
