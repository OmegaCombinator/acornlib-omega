theorem mul_left_scalar_map_ge_iff_le_of_negative[F: OrderedField](c: F, x: F, y: F) {
    c < F.0 and c.inverse < F.0 implies (mul_left_scalar_map(c, x) >= mul_left_scalar_map(c, y) = (x <= y))
