define is_outer_measure[K](m: Set[K] -> Real) -> Bool {
    (forall(s: Set[K]) { Real.0 <= m(s) })
        and m(Set[K].empty_set) = Real.0
        and (forall(a: Set[K], b: Set[K]) { a.subset(b) implies m(a) <= m(b) })
        and (forall(a: Set[K], b: Set[K]) { m(a.union(b)) <= m(a) + m(b) })
}

structure OuterMeasure[K] {
    /// The outer measure value of a set.
    measure: Set[K] -> Real
} constraint {
    is_outer_measure(measure)
}

theorem outer_measure_constraint[K](m: OuterMeasure[K]) {
    ((forall(s: Set[K]) { Real.0 <= m.measure(s) })
        and m.measure(Set[K].empty_set) = Real.0
        and (forall(u: Set[K], v: Set[K]) { u.subset(v) implies m.measure(u) <= m.measure(v) })
        and (forall(u: Set[K], v: Set[K]) { m.measure(u.union(v)) <= m.measure(u) + m.measure(v) }))
}

theorem outer_measure_nonneg[K](m: OuterMeasure[K], s: Set[K]) {
    Real.0 <= m.measure(s)
}

theorem outer_measure_empty[K](m: OuterMeasure[K]) {
    m.measure(Set[K].empty_set) = Real.0
}

theorem outer_measure_monotone[K](m: OuterMeasure[K], a: Set[K], b: Set[K]) {
    a.subset(b) implies m.measure(a) <= m.measure(b)
}

theorem outer_measure_subadditive[K](m: OuterMeasure[K], a: Set[K], b: Set[K]) {
    m.measure(a.union(b)) <= m.measure(a) + m.measure(b)
}

theorem subset_of_union_left[K](a: Set[K], b: Set[K]) {
    a.subset(a.union(b))
}

theorem outer_measure_monotone_union[K](m: OuterMeasure[K], a: Set[K], b: Set[K]) {
    m.measure(a) <= m.measure(a.union(b))
}

theorem difference_subset_left[K](a: Set[K], b: Set[K]) {
    a.difference(b).subset(a)
}

theorem outer_measure_monotone_difference[K](m: OuterMeasure[K], a: Set[K], b: Set[K]) {
    m.measure(a.difference(b)) <= m.measure(a)
}

define measure_seq[K](m: OuterMeasure[K], family: Nat -> Set[K], n: Nat) -> Real {
    m.measure(family(n))
}

define range_measure[K](m: OuterMeasure[K], family: Nat -> Set[K], n: Nat) -> Real {
    partial(measure_seq(m, family), n)
}

theorem range_measure_zero[K](m: OuterMeasure[K], family: Nat -> Set[K]) {
    range_measure(m, family, Nat.0) = Real.0
}

theorem range_measure_suc[K](m: OuterMeasure[K], family: Nat -> Set[K], k: Nat) {
    range_measure(m, family, k.suc) = range_measure(m, family, k) + measure_seq(m, family, k)
}

theorem range_indexed_union_suc[K](family: Nat -> Set[K], n: Nat) {
    range_indexed_union(n.suc, family) = range_indexed_union(n, family).union(family(n))
}

define finite_subadd_hyp[K](m: OuterMeasure[K], family: Nat -> Set[K], n: Nat) -> Bool {
    m.measure(range_indexed_union(n, family)) <= range_measure(m, family, n)
}

theorem finite_subadd_hyp_apply[K](m: OuterMeasure[K], family: Nat -> Set[K], k: Nat) {
    finite_subadd_hyp(m, family, k) implies
        m.measure(range_indexed_union(k, family)) <= range_measure(m, family, k)
}

theorem finite_subadd_hyp_intro[K](m: OuterMeasure[K], family: Nat -> Set[K], k: Nat) {
    (m.measure(range_indexed_union(k, family)) <= range_measure(m, family, k))
        implies finite_subadd_hyp(m, family, k)
}

theorem outer_measure_finite_subadditive_all[K](m: OuterMeasure[K],
        family: Nat -> Set[K]) {
    forall(n: Nat) { finite_subadd_hyp(m, family, n) }
}

theorem outer_measure_finite_subadditive[K](m: OuterMeasure[K],
        family: Nat -> Set[K], n: Nat) {
    m.measure(range_indexed_union(n, family)) <= range_measure(m, family, n)
}

define caratheodory_measurable[K](m: OuterMeasure[K], a: Set[K]) -> Bool {
    forall(e: Set[K]) {
        m.measure(e) = m.measure(e.intersection(a)) + m.measure(e.difference(a))
    }
}

theorem intersection_with_universal_self[K](e: Set[K]) {
    e.intersection(Set[K].universal_set) = e
}

theorem difference_universal_is_empty[K](e: Set[K]) {
    e.difference(Set[K].universal_set) = Set[K].empty_set
}

theorem difference_empty_is_self[K](e: Set[K]) {
    e.difference(Set[K].empty_set) = e
}

theorem caratheodory_measurable_universal[K](m: OuterMeasure[K]) {
    caratheodory_measurable(m, Set[K].universal_set)
}

theorem caratheodory_measurable_empty[K](m: OuterMeasure[K]) {
    caratheodory_measurable(m, Set[K].empty_set)
}

theorem intersection_compl_is_difference[K](e: Set[K], a: Set[K]) {
    e.intersection(a.c) = e.difference(a)
}

theorem difference_compl_is_intersection[K](e: Set[K], a: Set[K]) {
    e.difference(a.c) = e.intersection(a)
}

theorem caratheodory_measurable_compl[K](m: OuterMeasure[K], a: Set[K]) {
    caratheodory_measurable(m, a) implies caratheodory_measurable(m, a.c)
}

theorem difference_iterated_union[K](e: Set[K], a: Set[K], b: Set[K]) {
    (e.difference(b)).difference(a) = e.difference(a.union(b))
}

theorem intersection_union_intersect_left[K](e: Set[K], a: Set[K], b: Set[K]) {
    (e.intersection(a.union(b))).intersection(a) = e.intersection(a)
}

theorem intersection_union_difference_left[K](e: Set[K], a: Set[K], b: Set[K]) {
    (e.intersection(a.union(b))).difference(a) = (e.difference(a)).intersection(b)
}

theorem caratheodory_measurable_union[K](m: OuterMeasure[K], a: Set[K], b: Set[K]) {
    caratheodory_measurable(m, a) and caratheodory_measurable(m, b)
        implies caratheodory_measurable(m, a.union(b))
}

theorem union_compl_is_intersection_compl[K](a: Set[K], b: Set[K]) {
    (a.c.union(b.c)).c = a.intersection(b)
}

theorem caratheodory_measurable_intersection[K](m: OuterMeasure[K], a: Set[K], b: Set[K]) {
    caratheodory_measurable(m, a) and caratheodory_measurable(m, b)
        implies caratheodory_measurable(m, a.intersection(b))
}

theorem difference_eq_intersection_compl[K](a: Set[K], b: Set[K]) {
    a.difference(b) = a.intersection(b.c)
}

theorem caratheodory_measurable_difference[K](m: OuterMeasure[K], a: Set[K], b: Set[K]) {
    caratheodory_measurable(m, a) and caratheodory_measurable(m, b)
        implies caratheodory_measurable(m, a.difference(b))
}

define interval_length(a: Real, b: Real) -> Real {
    b - a
}

define is_proper_interval(a: Real, b: Real) -> Bool {
    a <= b
}

define interval_family(a: Nat -> Real, b: Nat -> Real) -> Nat -> Set[Real] {
    function(n: Nat) { closed_interval_set(a(n), b(n)) }
}

define interval_family_union(a: Nat -> Real, b: Nat -> Real) -> Set[Real] {
    indexed_union(interval_family(a, b))
}

define interval_cost_seq(a: Nat -> Real, b: Nat -> Real) -> Nat -> Real {
    function(n: Nat) {
        partial(function(k: Nat) { interval_length(a(k), b(k)) }, n)
    }
}

define is_interval_cover_cost(s: Set[Real], c: Real) -> Bool {
    exists(a: Nat -> Real, b: Nat -> Real) {
        (forall(n: Nat) { is_proper_interval(a(n), b(n)) })
            and s.subset(interval_family_union(a, b))
            and converges_to(interval_cost_seq(a, b), c)
    }
}

define lebesgue_cost_set(s: Set[Real]) -> Set[Real] {
    Set[Real].new(function(c: Real) { is_interval_cover_cost(s, c) })
}

theorem lebesgue_cost_set_contains_eq(s: Set[Real], c: Real) {
    lebesgue_cost_set(s).contains(c) = is_interval_cover_cost(s, c)
}

define lebesgue_cost_has_infimum(s: Set[Real]) -> Bool {
    exists(v: Real) {
        is_set_infimum(lebesgue_cost_set(s), v)
    }
}

define lebesgue_outer_measure(s: Set[Real]) -> Real {
    choose_or_default(function(v: Real) { is_set_infimum(lebesgue_cost_set(s), v) }, Real.0)
}

define delta_seq(x: Real, k: Nat) -> Real {
    if k = Nat.0 { x } else { Real.0 }
}

theorem partial_delta_seq(x: Real, n: Nat) {
    partial(delta_seq(x), n.suc) = x
}

theorem partial_delta_seq_later(x: Real, i: Nat) {
    Nat.1 <= i implies partial(delta_seq(x), i) = x
}

theorem partial_const_zero(n: Nat) {
    partial(function(k: Nat) { Real.0 }, n) = Real.0
}

theorem converges_to_of_pointwise_eq(a: Nat -> Real, b: Nat -> Real, c: Real) {
    (forall(n: Nat) { a(n) = b(n) }) and converges_to(a, c)
        implies converges_to(b, c)
}

theorem converges_to_nonneg_imp_limit_nonneg(q: Nat -> Real, c: Real) {
    converges_to(q, c) and (forall(n: Nat) { Real.0 <= q(n) })
        implies Real.0 <= c
}

theorem lte_imp_sub_nonneg(a: Real, b: Real) {
    a <= b implies Real.0 <= b - a
}

theorem lebesgue_cost_nonneg(s: Set[Real], c: Real) {
    lebesgue_cost_set(s).contains(c) implies Real.0 <= c
}

theorem neg_lte_swap(a: Real, b: Real) {
    a <= b implies -b <= -a
}

define neg_set_contains(s: Set[Real], x: Real) -> Bool {
    exists(a: Real) {
        s.contains(a) and x = -a
    }
}

define neg_set(s: Set[Real]) -> Set[Real] {
    Set[Real].new(neg_set_contains(s))
}

theorem neg_set_contains_eq(s: Set[Real], x: Real) {
    neg_set(s).contains(x) = neg_set_contains(s, x)
}

theorem neg_set_membership(s: Set[Real], a: Real) {
    s.contains(a) implies neg_set(s).contains(-a)
}

theorem neg_set_witness(s: Set[Real], x: Real) {
    neg_set(s).contains(x) implies exists(a: Real) { s.contains(a) and x = -a }
}

theorem neg_set_involutive(s: Set[Real]) {
    neg_set(neg_set(s)) = s
}

theorem neg_set_supremum_imp_infimum(s: Set[Real], sup_n: Real) {
    is_set_supremum(neg_set(s), sup_n) implies is_set_infimum(s, -sup_n)
}

theorem set_infimum_unique(s: Set[Real], v1: Real, v2: Real) {
    is_set_infimum(s, v1) and is_set_infimum(s, v2) implies v1 = v2
}

theorem infimum_exists_of_nonempty_bounded_below(s: Set[Real]) {
    is_nonempty(s) and exists(lb: Real) { is_set_lower_bound(s, lb) }
        implies exists(v: Real) { is_set_infimum(s, v) }
}

theorem lebesgue_outer_measure_is_infimum(s: Set[Real]) {
    lebesgue_cost_has_infimum(s) implies
        is_set_infimum(lebesgue_cost_set(s), lebesgue_outer_measure(s))
}

define zero_interval_lower(n: Nat) -> Real {
    Real.0
}

define zero_interval_upper(n: Nat) -> Real {
    Real.0
}

theorem eventual_eq_imp_converges_to(q: Nat -> Real, a: Real) {
    eventual_eq(q, a) implies converges_to(q, a)
}

theorem const_zero_converges_to_zero {
    converges_to(function(n: Nat) { Real.0 }, Real.0)
}

theorem empty_cover_cost_converges {
    converges_to(interval_cost_seq(zero_interval_lower, zero_interval_upper), Real.0)
}

theorem empty_cover_is_cost_zero {
    is_interval_cover_cost(Set[Real].empty_set, Real.0)
}

theorem empty_cost_set_infimum_zero {
    is_set_infimum(lebesgue_cost_set(Set[Real].empty_set), Real.0)
}

theorem lebesgue_outer_measure_empty {
    lebesgue_outer_measure(Set[Real].empty_set) = Real.0
}

define self_cover_lower(a: Real, b: Real, n: Nat) -> Real {
    if n = Nat.0 { a } else { Real.0 }
}

define self_cover_upper(a: Real, b: Real, n: Nat) -> Real {
    if n = Nat.0 { b } else { Real.0 }
}

theorem self_cover_interval_at_zero(a: Real, b: Real) {
    interval_family(self_cover_lower(a, b), self_cover_upper(a, b))(Nat.0) = closed_interval_set(a, b)
}

theorem self_cover_is_proper(a: Real, b: Real) {
    a <= b implies forall(n: Nat) {
        is_proper_interval(self_cover_lower(a, b, n), self_cover_upper(a, b, n))
    }
}

theorem self_cover_covers_interval(a: Real, b: Real) {
    closed_interval_set(a, b).subset(interval_family_union(self_cover_lower(a, b), self_cover_upper(a, b)))
}

theorem self_cover_lengths_delta(a: Real, b: Real) {
    forall(k: Nat) {
        interval_length(self_cover_lower(a, b, k), self_cover_upper(a, b, k)) = delta_seq(b - a, k)
    }
}

theorem self_cover_cost_converges(a: Real, b: Real) {
    converges_to(interval_cost_seq(self_cover_lower(a, b), self_cover_upper(a, b)), b - a)
}

theorem self_cover_is_interval_cover_cost(a: Real, b: Real) {
    a <= b implies lebesgue_cost_set(closed_interval_set(a, b)).contains(b - a)
}

theorem interval_cost_has_infimum(a: Real, b: Real) {
    a <= b implies lebesgue_cost_has_infimum(closed_interval_set(a, b))
}

theorem lebesgue_outer_measure_interval_upper(a: Real, b: Real) {
    a <= b implies lebesgue_outer_measure(closed_interval_set(a, b)) <= b - a
}

theorem lebesgue_outer_measure_point(a: Real) {
    lebesgue_outer_measure(closed_interval_set(a, a)) = Real.0
}

theorem lebesgue_cost_set_antitone(s: Set[Real], t: Set[Real]) {
    s.subset(t) implies lebesgue_cost_set(t).subset(lebesgue_cost_set(s))
}

theorem lebesgue_outer_measure_monotone(s: Set[Real], t: Set[Real]) {
    s.subset(t) and lebesgue_cost_has_infimum(s) and lebesgue_cost_has_infimum(t)
        implies lebesgue_outer_measure(s) <= lebesgue_outer_measure(t)
}

theorem lebesgue_outer_measure_nonneg(s: Set[Real]) {
    lebesgue_cost_has_infimum(s) implies Real.0 <= lebesgue_outer_measure(s)
}

define lebesgue_measurable(a: Set[Real]) -> Bool {
    forall(e: Set[Real]) {
        lebesgue_outer_measure(e) =
            lebesgue_outer_measure(e.intersection(a)) + lebesgue_outer_measure(e.difference(a))
    }
}

theorem lebesgue_measurable_empty {
    lebesgue_measurable(Set[Real].empty_set)
}

theorem lebesgue_measurable_universal {
    lebesgue_measurable(Set[Real].universal_set)
}

theorem lebesgue_measurable_compl(a: Set[Real]) {
    lebesgue_measurable(a) implies lebesgue_measurable(a.c)
}

theorem lebesgue_measurable_union(a: Set[Real], b: Set[Real]) {
    lebesgue_measurable(a) and lebesgue_measurable(b)
        implies lebesgue_measurable(a.union(b))
}

theorem lebesgue_measurable_intersection(a: Set[Real], b: Set[Real]) {
    lebesgue_measurable(a) and lebesgue_measurable(b)
        implies lebesgue_measurable(a.intersection(b))
}

theorem lebesgue_measurable_difference(a: Set[Real], b: Set[Real]) {
    lebesgue_measurable(a) and lebesgue_measurable(b)
        implies lebesgue_measurable(a.difference(b))
}

theorem lebesgue_measurable_has_empty {
    has_measurable_empty_constraint(lebesgue_measurable)
}

theorem lebesgue_measurable_closed_compl {
    closed_under_compl_constraint(lebesgue_measurable)
}

theorem union_intersection_absorb_left[K](a: Set[K], b: Set[K]) {
    (a.union(b)).intersection(a) = a
}

theorem union_difference_left[K](a: Set[K], b: Set[K]) {
    (a.union(b)).difference(a) = b.difference(a)
}

theorem disjoint_imp_not_both[K](a: Set[K], b: Set[K], x: K) {
    a.intersection(b) = Set[K].empty_set implies not (a.contains(x) and b.contains(x))
}

theorem difference_of_disjoint_pointwise[K](a: Set[K], b: Set[K], x: K) {
    a.intersection(b) = Set[K].empty_set implies (b.difference(a).contains(x) = b.contains(x))
}

theorem difference_of_disjoint_is_self[K](a: Set[K], b: Set[K]) {
    a.intersection(b) = Set[K].empty_set implies b.difference(a) = b
}

theorem measure_monotone[K](m: OuterMeasure[K], a: Set[K], b: Set[K]) {
    a.subset(b) implies m.measure(a) <= m.measure(b)
}

theorem measure_empty[K](m: OuterMeasure[K]) {
    m.measure(Set[K].empty_set) = Real.0
}

theorem measure_nonneg[K](m: OuterMeasure[K], s: Set[K]) {
    Real.0 <= m.measure(s)
}

theorem caratheodory_measurable_union_splits[K](m: OuterMeasure[K], a: Set[K], b: Set[K]) {
    caratheodory_measurable(m, a) implies
        m.measure(a.union(b)) = m.measure(a) + m.measure(b.difference(a))
}

theorem caratheodory_measurable_disjoint_add[K](m: OuterMeasure[K], a: Set[K], b: Set[K]) {
    caratheodory_measurable(m, a) and a.intersection(b) = Set[K].empty_set
        implies m.measure(a.union(b)) = m.measure(a) + m.measure(b)
}

theorem caratheodory_measurable_disjoint_add_right[K](m: OuterMeasure[K], a: Set[K], b: Set[K]) {
    caratheodory_measurable(m, b) and a.intersection(b) = Set[K].empty_set
        implies m.measure(a.union(b)) = m.measure(a) + m.measure(b)
}

theorem caratheodory_measurable_inclusion_exclusion[K](m: OuterMeasure[K], a: Set[K], b: Set[K]) {
    caratheodory_measurable(m, a) and caratheodory_measurable(m, b)
        implies m.measure(a.union(b)) = m.measure(a) + m.measure(b) - m.measure(a.intersection(b))
}

theorem lebesgue_measure_monotone(s: Set[Real], t: Set[Real]) {
    s.subset(t) and lebesgue_cost_has_infimum(s) and lebesgue_cost_has_infimum(t)
        implies lebesgue_outer_measure(s) <= lebesgue_outer_measure(t)
}

theorem lebesgue_measure_empty {
    lebesgue_outer_measure(Set[Real].empty_set) = Real.0
}

theorem lebesgue_measure_nonneg(s: Set[Real]) {
    lebesgue_cost_has_infimum(s) implies Real.0 <= lebesgue_outer_measure(s)
}

theorem lebesgue_measure_disjoint_add(a: Set[Real], b: Set[Real]) {
    lebesgue_measurable(a) and a.intersection(b) = Set[Real].empty_set
        implies lebesgue_outer_measure(a.union(b)) =
            lebesgue_outer_measure(a) + lebesgue_outer_measure(b)
}

theorem lebesgue_measure_inclusion_exclusion(a: Set[Real], b: Set[Real]) {
    lebesgue_measurable(a) and lebesgue_measurable(b)
        implies lebesgue_outer_measure(a.union(b)) =
            lebesgue_outer_measure(a) + lebesgue_outer_measure(b) -
                lebesgue_outer_measure(a.intersection(b))
}

theorem lebesgue_measure_interval_upper_bound(a: Real, b: Real) {
    a <= b implies lebesgue_outer_measure(closed_interval_set(a, b)) <= b - a
}

theorem lebesgue_measure_unit_interval_bounds {
    Real.0 <= lebesgue_outer_measure(closed_interval_set(Real.0, Real.1))
        and lebesgue_outer_measure(closed_interval_set(Real.0, Real.1)) <= Real.1
}

theorem lebesgue_measure_point_zero {
    lebesgue_outer_measure(closed_interval_set(Real.0, Real.0)) = Real.0
}

define pairwise_disjoint[K](family: Nat -> Set[K], n: Nat) -> Bool {
    forall(i: Nat, j: Nat) {
        i < n and j < n and i < j implies family(i).intersection(family(j)) = Set[K].empty_set
    }
}

define measurable_range[K](m: OuterMeasure[K], family: Nat -> Set[K], n: Nat) -> Bool {
    forall(i: Nat) { i < n implies caratheodory_measurable(m, family(i)) }
}

theorem range_indexed_union_disjoint_last_contains[K](family: Nat -> Set[K], k: Nat, x: K) {
    pairwise_disjoint(family, k.suc)
        implies not range_indexed_union(k, family).intersection(family(k)).contains(x)
}

theorem range_indexed_union_disjoint_from_last[K](family: Nat -> Set[K], k: Nat) {
    pairwise_disjoint(family, k.suc)
        implies range_indexed_union(k, family).intersection(family(k)) = Set[K].empty_set
}

theorem caratheodory_measurable_finite_disjoint_add_all[K](m: OuterMeasure[K],
        family: Nat -> Set[K]) {
    forall(n: Nat) {
        measurable_range(m, family, n) and pairwise_disjoint(family, n)
            implies m.measure(range_indexed_union(n, family)) = range_measure(m, family, n)
    }
}

theorem caratheodory_measurable_finite_disjoint_add[K](m: OuterMeasure[K],
        family: Nat -> Set[K], n: Nat) {
    measurable_range(m, family, n) and pairwise_disjoint(family, n)
        implies m.measure(range_indexed_union(n, family)) = range_measure(m, family, n)
}

typeclass M: MetricSpace {
    /// Every metric space must have a distance function
    distance: (M, M) -> Real

    /// Rule: the distance from a point to itself is zero
    self_distance_is_zero(x: M) {
        x.distance(x) = 0
    }

    /// Rule: distance zero means the points are equal
    dist_zero_imp_eq(x: M, y: M) {
        x.distance(y) = 0 implies x = y
    }

    /// Rule: distance must be symmetric
    symmetric(x: M, y: M) {
        x.distance(y) = y.distance(x)
    }

    /// Rule: distance must satisfy the triangle inequality
    triangle(x: M, y: M, z: M) {
        x.distance(z) <= x.distance(y) + y.distance(z)
    }
}

theorem distance_non_negative[M: MetricSpace](x: M, y: M) {
    not x.distance(y).is_negative
}

theorem distance_self[M: MetricSpace](x: M) {
    x.distance(x) = 0
}

theorem eq_imp_distance_zero[M: MetricSpace](x: M, y: M) {
    x = y implies x.distance(y) = 0
}

theorem distance_zero_iff_eq[M: MetricSpace](x: M, y: M) {
    (x.distance(y) = 0) = (x = y)
}

define in_open_ball[M: MetricSpace](x: M, r: Real, y: M) -> Bool {
    y.distance(x) < r
}

define open_ball[M: MetricSpace](x: M, r: Real) -> Set[M] {
    Set[M].new(in_open_ball(x, r))
}

define in_closed_ball[M: MetricSpace](x: M, r: Real, y: M) -> Bool {
    y.distance(x) <= r
}

define closed_ball[M: MetricSpace](x: M, r: Real) -> Set[M] {
    Set[M].new(in_closed_ball(x, r))
}

theorem open_ball_contains_iff[M: MetricSpace](x: M, r: Real, y: M) {
    open_ball(x, r).contains(y) = (y.distance(x) < r)
}

theorem closed_ball_contains_iff[M: MetricSpace](x: M, r: Real, y: M) {
    closed_ball(x, r).contains(y) = (y.distance(x) <= r)
}

theorem center_in_open_ball[M: MetricSpace](x: M, r: Real) {
    r.is_positive implies open_ball(x, r).contains(x)
}

theorem center_in_closed_ball[M: MetricSpace](x: M, r: Real) {
    not r.is_negative implies closed_ball(x, r).contains(x)
}

theorem open_ball_subset_closed_ball[M: MetricSpace](x: M, r: Real) {
    open_ball(x, r).subset(closed_ball(x, r))
}

theorem open_ball_subset_of_radius_le[M: MetricSpace](x: M, r1: Real, r2: Real) {
    r1 <= r2 implies open_ball(x, r1).subset(open_ball(x, r2))
}

theorem closed_ball_subset_of_radius_le[M: MetricSpace](x: M, r1: Real, r2: Real) {
    r1 <= r2 implies closed_ball(x, r1).subset(closed_ball(x, r2))
}

theorem open_ball_nonpositive_radius_empty[M: MetricSpace](x: M, r: Real, y: M) {
    not r.is_positive implies not open_ball(x, r).contains(y)
}

theorem open_ball_nonpositive_radius_is_empty[M: MetricSpace](x: M, r: Real) {
    not r.is_positive implies open_ball(x, r).is_empty
}

theorem closed_ball_negative_radius_empty[M: MetricSpace](x: M, r: Real, y: M) {
    r.is_negative implies not closed_ball(x, r).contains(y)
}

theorem closed_ball_negative_radius_is_empty[M: MetricSpace](x: M, r: Real) {
    r.is_negative implies closed_ball(x, r).is_empty
}

theorem in_open_ball_symmetric[M: MetricSpace](x: M, r: Real, y: M) {
    open_ball(x, r).contains(y) = open_ball(y, r).contains(x)
}

theorem in_closed_ball_symmetric[M: MetricSpace](x: M, r: Real, y: M) {
    closed_ball(x, r).contains(y) = closed_ball(y, r).contains(x)
}

define is_bounded[M: MetricSpace](s: Set[M]) -> Bool {
    exists(x: M, r: Real) {
        s.subset(closed_ball(x, r))
    }
}

theorem empty_set_is_bounded[M: MetricSpace](x: M) {
    is_bounded(Set[M].empty_set)
}

theorem subset_of_bounded_is_bounded[M: MetricSpace](s: Set[M], t: Set[M]) {
    s.subset(t) and is_bounded(t) implies is_bounded(s)
}

theorem singleton_is_bounded[M: MetricSpace](x: M) {
    is_bounded(Set[M].singleton(x))
}

theorem union_of_bounded_is_bounded[M: MetricSpace](s: Set[M], t: Set[M]) {
    is_bounded(s) and is_bounded(t) implies is_bounded(s.union(t))
}

theorem closed_ball_is_bounded[M: MetricSpace](x: M, r: Real) {
    is_bounded(closed_ball(x, r))
}

theorem open_ball_is_bounded[M: MetricSpace](x: M, r: Real) {
    is_bounded(open_ball(x, r))
}

define discrete[T](x: T, y: T) -> Real {
    if x = y {
        0
    } else {
        1
    }
}

theorem zero_lte_discrete[T](x: T, y: T) {
    0 <= discrete(x, y)
}

theorem discrete_self_distance_is_zero[T](x: T) {
    discrete(x, x) = 0
}

theorem discrete_dist_zero_imp_eq[T](x: T, y: T) {
    discrete(x, y) = 0 implies x = y
}

theorem discrete_eq_one_of_ne[T](x: T, y: T) {
    x != y implies discrete(x, y) = 1
}

theorem discrete_symmetric[T](x: T, y: T) {
    discrete(x, y) = discrete(y, x)
}

theorem discrete_triangle[T](x: T, y: T, z: T) {
    discrete(x, z) <= discrete(x, y) + discrete(y, z)
}

inductive Color {
    /// Red means nothing. It's just different from green and blue.
    red

    /// Green is not red or blue.
    green

    /// Blue is not red or green.
    blue
}

instance Color: MetricSpace {
    let distance: (Color, Color) -> Real = discrete
}
