) {
    is_galois_connection(lower, upper) and
    is_fixed_point(galois_closure(lower, upper), a1) and
    is_fixed_point(galois_closure(lower, upper), a2) implies
    (lower(a1) <= lower(a2) = (a1 <= a2))
