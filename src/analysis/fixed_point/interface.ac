define is_derivative_at(f: Real -> Real, df: Real -> Real, xstar: Real) -> Bool {
    forall(eps: Real) {
        eps.is_positive implies exists(delta: Real) {
            delta.is_positive and forall(h: Real) {
                h != Real.0 and h.abs < delta
                implies ((f(xstar + h) - f(xstar)) / h - df(xstar)).abs < eps
            }
        }
    }
}

define is_stable_fixed_point(f: Real -> Real, xstar: Real) -> Bool {
    is_fixed_point(f, xstar)
        and forall(eps: Real) {
            eps.is_positive implies exists(delta: Real) {
                delta.is_positive and forall(x0: Real) {
                    (x0 - xstar).abs < delta
                    implies forall(n: Nat) {
                        (iterate(f, n, x0) - xstar).abs < eps
                    }
                }
            }
        }
}

let two_pi = pi + pi

define sin_nt(n: Nat, x: Real) -> Real {
    (from_nat[Real](n) * x).sin
}

define cos_nt(n: Nat, x: Real) -> Real {
    (from_nat[Real](n) * x).cos
}

define fourier_cos_integrand(f: Real -> Real, n: Nat, x: Real) -> Real {
    f(x) * cos_nt(n, x)
}

define fourier_sin_integrand(f: Real -> Real, n: Nat, x: Real) -> Real {
    f(x) * sin_nt(n, x)
}

define fourier_cos_coeff(f: Real -> Real, n: Nat) -> Real {
    integral(fourier_cos_integrand(f, n), Real.0, two_pi) / pi
}

define fourier_sin_coeff(f: Real -> Real, n: Nat) -> Real {
