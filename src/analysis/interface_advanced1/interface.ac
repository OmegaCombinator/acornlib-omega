define is_local_equiv_data[A, B](source: Set[A], target: Set[B],
    to_fun: A -> B, inv_fun: B -> A) -> Bool {
    forall(x: A) {
        source.contains(x) implies target.contains(to_fun(x))
    } and forall(y: B) {
        target.contains(y) implies source.contains(inv_fun(y))
    } and forall(x: A) {
        source.contains(x) implies inv_fun(to_fun(x)) = x
    } and forall(y: B) {
        target.contains(y) implies to_fun(inv_fun(y)) = y
    }
}

theorem local_equiv_data_map_source[A, B](source: Set[A], target: Set[B],
    to_fun: A -> B, inv_fun: B -> A, x: A) {
    is_local_equiv_data(source, target, to_fun, inv_fun) and source.contains(x)
        implies target.contains(to_fun(x))
}

theorem local_equiv_data_map_target[A, B](source: Set[A], target: Set[B],
    to_fun: A -> B, inv_fun: B -> A, y: B) {
    is_local_equiv_data(source, target, to_fun, inv_fun) and target.contains(y)
        implies source.contains(inv_fun(y))
}

theorem local_equiv_data_left_inv[A, B](source: Set[A], target: Set[B],
    to_fun: A -> B, inv_fun: B -> A, x: A) {
    is_local_equiv_data(source, target, to_fun, inv_fun) and source.contains(x)
        implies inv_fun(to_fun(x)) = x
}

theorem local_equiv_data_right_inv[A, B](source: Set[A], target: Set[B],
    to_fun: A -> B, inv_fun: B -> A, y: B) {
    is_local_equiv_data(source, target, to_fun, inv_fun) and target.contains(y)
        implies to_fun(inv_fun(y)) = y
}

theorem local_equiv_data_swap[A, B](source: Set[A], target: Set[B],
    to_fun: A -> B, inv_fun: B -> A) {
    is_local_equiv_data(source, target, to_fun, inv_fun)
        implies is_local_equiv_data(target, source, inv_fun, to_fun)
}

structure LocalEquiv[A, B] {
    /// The set on which the forward map is defined.
    source: Set[A]

    /// The set on which the inverse map is defined.
    target: Set[B]

    /// The forward partial map.
    to_fun: A -> B

    /// The inverse partial map.
    inv_fun: B -> A
} constraint {
    is_local_equiv_data(source, target, to_fun, inv_fun)
}

theorem local_equiv_ext[A, B](e: LocalEquiv[A, B], e2: LocalEquiv[A, B]) {
    e.source = e2.source and e.target = e2.target and e.to_fun = e2.to_fun and
    e.inv_fun = e2.inv_fun implies e = e2
}

theorem local_equiv_map_source[A, B](e: LocalEquiv[A, B], x: A) {
    e.source.contains(x) implies e.target.contains(e.to_fun(x))
}

theorem local_equiv_map_target[A, B](e: LocalEquiv[A, B], y: B) {
    e.target.contains(y) implies e.source.contains(e.inv_fun(y))
}

theorem local_equiv_left_inv[A, B](e: LocalEquiv[A, B], x: A) {
    e.source.contains(x) implies e.inv_fun(e.to_fun(x)) = x
}

theorem local_equiv_right_inv[A, B](e: LocalEquiv[A, B], y: B) {
    e.target.contains(y) implies e.to_fun(e.inv_fun(y)) = y
}

theorem local_equiv_source_intersection_preimage_target[A, B](e: LocalEquiv[A, B]) {
    e.source.intersection(set_preimage(e.to_fun, e.target)) = e.source
}

theorem local_equiv_target_intersection_preimage_source[A, B](e: LocalEquiv[A, B]) {
    e.target.intersection(set_preimage(e.inv_fun, e.source)) = e.target
}

theorem local_equiv_data_id[A](s: Set[A]) {
    is_local_equiv_data(s, s, identity_fn[A], identity_fn[A])
}

theorem local_equiv_id_constructible[A](source: Set[A]) {
    exists(h: LocalEquiv[A, A]) {
        LocalEquiv[A, A].new(source, source, identity_fn[A], identity_fn[A]) = Option.some(h)
    }
}

theorem local_equiv_data_restr[A, B](source: Set[A], target: Set[B],
    to_fun: A -> B, inv_fun: B -> A, s: Set[A]) {
    is_local_equiv_data(source, target, to_fun, inv_fun)
        implies is_local_equiv_data(source.intersection(s),
            target.intersection(set_preimage(inv_fun, s)), to_fun, inv_fun)
}

theorem local_equiv_restr_constructible[A, B](e: LocalEquiv[A, B], s: Set[A]) {
    exists(h: LocalEquiv[A, B]) {
        LocalEquiv[A, B].new(e.source.intersection(s),
            e.target.intersection(set_preimage(e.inv_fun, s)), e.to_fun, e.inv_fun) = Option.some(h)
    }
}

theorem local_equiv_data_trans[A, B, C](
    s1: Set[A], t1: Set[B], f1: A -> B, g1: B -> A,
    s2: Set[B], t2: Set[C], f2: B -> C, g2: C -> B) {
    is_local_equiv_data(s1, t1, f1, g1) and is_local_equiv_data(s2, t2, f2, g2)
        implies is_local_equiv_data(s1.intersection(set_preimage(f1, s2)),
            t2.intersection(set_preimage(g2, t1)), compose(f2, f1), compose(g1, g2))
}

theorem local_equiv_trans_constructible[A, B, C](e: LocalEquiv[A, B], e2: LocalEquiv[B, C]) {
    exists(h: LocalEquiv[A, C]) {
        LocalEquiv[A, C].new(e.source.intersection(set_preimage(e.to_fun, e2.source)),
            e2.target.intersection(set_preimage(e2.inv_fun, e.target)),
            compose(e2.to_fun, e.to_fun), compose(e.inv_fun, e2.inv_fun)) = Option.some(h)
    }
}

theorem local_equiv_swap_constructible[A, B](e: LocalEquiv[A, B]) {
    exists(h: LocalEquiv[B, A]) {
        LocalEquiv[B, A].new(e.target, e.source, e.inv_fun, e.to_fun) = Option.some(h)
    }
}

let local_equiv_id[A](source: Set[A]) -> result: LocalEquiv[A, A] satisfy {
    LocalEquiv[A, A].new(source, source, identity_fn[A], identity_fn[A]) = Option.some(result)
}

theorem local_equiv_id_source[A](source: Set[A]) {
    local_equiv_id(source).source = source
}

theorem local_equiv_id_target[A](source: Set[A]) {
    local_equiv_id(source).target = source
}

theorem local_equiv_id_to_fun[A](source: Set[A]) {
    local_equiv_id(source).to_fun = identity_fn[A]
}

theorem local_equiv_id_inv_fun[A](source: Set[A]) {
    local_equiv_id(source).inv_fun = identity_fn[A]
}

theorem local_equiv_id_apply[A](source: Set[A], x: A) {
    source.contains(x) implies local_equiv_id(source).to_fun(x) = x
}

theorem local_equiv_id_inv_apply[A](source: Set[A], x: A) {
    source.contains(x) implies local_equiv_id(source).inv_fun(x) = x
}

let local_equiv_restr[A, B](e: LocalEquiv[A, B], s: Set[A]) -> result: LocalEquiv[A, B] satisfy {
    LocalEquiv[A, B].new(e.source.intersection(s),
        e.target.intersection(set_preimage(e.inv_fun, s)), e.to_fun, e.inv_fun) = Option.some(result)
}

theorem local_equiv_restr_source[A, B](e: LocalEquiv[A, B], s: Set[A]) {
    local_equiv_restr(e, s).source = e.source.intersection(s)
}

theorem local_equiv_restr_target[A, B](e: LocalEquiv[A, B], s: Set[A]) {
    local_equiv_restr(e, s).target = e.target.intersection(set_preimage(e.inv_fun, s))
}

theorem local_equiv_restr_to_fun[A, B](e: LocalEquiv[A, B], s: Set[A]) {
    local_equiv_restr(e, s).to_fun = e.to_fun
}

theorem local_equiv_restr_inv_fun[A, B](e: LocalEquiv[A, B], s: Set[A]) {
    local_equiv_restr(e, s).inv_fun = e.inv_fun
}

theorem local_equiv_restr_source_contains[A, B](e: LocalEquiv[A, B], s: Set[A], x: A) {
    e.source.contains(x) and s.contains(x) implies local_equiv_restr(e, s).source.contains(x)
}

theorem local_equiv_restr_target_contains[A, B](e: LocalEquiv[A, B], s: Set[A], y: B) {
    e.target.contains(y) and s.contains(e.inv_fun(y)) implies local_equiv_restr(e, s).target.contains(y)
}

theorem local_equiv_restr_map_source[A, B](e: LocalEquiv[A, B], s: Set[A], x: A) {
    e.source.contains(x) and s.contains(x) implies local_equiv_restr(e, s).target.contains(e.to_fun(x))
}

theorem local_equiv_restr_map_target[A, B](e: LocalEquiv[A, B], s: Set[A], y: B) {
    e.target.contains(y) and s.contains(e.inv_fun(y)) implies
        local_equiv_restr(e, s).source.contains(e.inv_fun(y))
}

theorem local_equiv_restr_restr[A, B](e: LocalEquiv[A, B], s: Set[A], t: Set[A]) {
    local_equiv_restr(local_equiv_restr(e, s), t) = local_equiv_restr(e, s.intersection(t))
}

let local_equiv_symm[A, B](e: LocalEquiv[A, B]) -> result: LocalEquiv[B, A] satisfy {
    LocalEquiv[B, A].new(e.target, e.source, e.inv_fun, e.to_fun) = Option.some(result)
}

theorem local_equiv_symm_source[A, B](e: LocalEquiv[A, B]) {
    local_equiv_symm(e).source = e.target
}

theorem local_equiv_symm_target[A, B](e: LocalEquiv[A, B]) {
    local_equiv_symm(e).target = e.source
}

theorem local_equiv_symm_to_fun[A, B](e: LocalEquiv[A, B]) {
    local_equiv_symm(e).to_fun = e.inv_fun
}

theorem local_equiv_symm_inv_fun[A, B](e: LocalEquiv[A, B]) {
    local_equiv_symm(e).inv_fun = e.to_fun
}

theorem local_equiv_symm_left_inv[A, B](e: LocalEquiv[A, B], y: B) {
    e.target.contains(y) implies
    local_equiv_symm(e).inv_fun(local_equiv_symm(e).to_fun(y)) = y
}

theorem local_equiv_symm_right_inv[A, B](e: LocalEquiv[A, B], x: A) {
    e.source.contains(x) implies
    local_equiv_symm(e).to_fun(local_equiv_symm(e).inv_fun(x)) = x
}

theorem local_equiv_symm_symm[A, B](e: LocalEquiv[A, B]) {
    local_equiv_symm(local_equiv_symm(e)) = e
}

let local_equiv_trans[A, B, C](e: LocalEquiv[A, B], e2: LocalEquiv[B, C]) -> result: LocalEquiv[A, C] satisfy {
    LocalEquiv[A, C].new(e.source.intersection(set_preimage(e.to_fun, e2.source)),
        e2.target.intersection(set_preimage(e2.inv_fun, e.target)),
        compose(e2.to_fun, e.to_fun), compose(e.inv_fun, e2.inv_fun)) = Option.some(result)
}

theorem local_equiv_trans_source[A, B, C](e: LocalEquiv[A, B], e2: LocalEquiv[B, C]) {
    local_equiv_trans(e, e2).source = e.source.intersection(set_preimage(e.to_fun, e2.source))
}

theorem local_equiv_trans_target[A, B, C](e: LocalEquiv[A, B], e2: LocalEquiv[B, C]) {
    local_equiv_trans(e, e2).target = e2.target.intersection(set_preimage(e2.inv_fun, e.target))
}

theorem local_equiv_trans_to_fun[A, B, C](e: LocalEquiv[A, B], e2: LocalEquiv[B, C]) {
    local_equiv_trans(e, e2).to_fun = compose(e2.to_fun, e.to_fun)
}

theorem local_equiv_trans_inv_fun[A, B, C](e: LocalEquiv[A, B], e2: LocalEquiv[B, C]) {
    local_equiv_trans(e, e2).inv_fun = compose(e.inv_fun, e2.inv_fun)
}

theorem local_equiv_trans_source_contains[A, B, C](e: LocalEquiv[A, B], e2: LocalEquiv[B, C], x: A) {
    e.source.contains(x) and e2.source.contains(e.to_fun(x)) implies local_equiv_trans(e, e2).source.contains(x)
}

theorem local_equiv_trans_target_contains[A, B, C](e: LocalEquiv[A, B], e2: LocalEquiv[B, C], z: C) {
    e2.target.contains(z) and e.target.contains(e2.inv_fun(z)) implies local_equiv_trans(e, e2).target.contains(z)
}

theorem local_equiv_trans_map_source[A, B, C](e: LocalEquiv[A, B], e2: LocalEquiv[B, C], x: A) {
    e.source.contains(x) and e2.source.contains(e.to_fun(x)) implies
        local_equiv_trans(e, e2).target.contains(e2.to_fun(e.to_fun(x)))
}

theorem local_equiv_trans_map_target[A, B, C](e: LocalEquiv[A, B], e2: LocalEquiv[B, C], z: C) {
    e2.target.contains(z) and e.target.contains(e2.inv_fun(z)) implies
        local_equiv_trans(e, e2).source.contains(e.inv_fun(e2.inv_fun(z)))
}

theorem local_equiv_trans_left_inv_apply[A, B, C](e: LocalEquiv[A, B], e2: LocalEquiv[B, C], x: A) {
    e.source.contains(x) and e2.source.contains(e.to_fun(x)) implies
        local_equiv_trans(e, e2).inv_fun(e2.to_fun(e.to_fun(x))) = x
}

theorem local_equiv_trans_right_inv_apply[A, B, C](e: LocalEquiv[A, B], e2: LocalEquiv[B, C], z: C) {
    e2.target.contains(z) and e.target.contains(e2.inv_fun(z)) implies
        local_equiv_trans(e, e2).to_fun(e.inv_fun(e2.inv_fun(z))) = z
}

theorem local_equiv_trans_assoc[A, B, C, D](
    e1: LocalEquiv[A, B], e2: LocalEquiv[B, C], e3: LocalEquiv[C, D]) {
    local_equiv_trans(local_equiv_trans(e1, e2), e3) =
        local_equiv_trans(e1, local_equiv_trans(e2, e3))
}

theorem local_equiv_trans_id_left[A, B](e: LocalEquiv[A, B]) {
    local_equiv_trans(e, local_equiv_id(e.target)) = e
}

theorem local_equiv_trans_id_right[A, B](e: LocalEquiv[A, B]) {
    local_equiv_trans(local_equiv_id(e.source), e) = e
}

theorem local_equiv_trans_symm_right_source[A, B](e: LocalEquiv[A, B]) {
    local_equiv_trans(e, local_equiv_symm(e)).source = e.source
}

theorem local_equiv_trans_symm_right_target[A, B](e: LocalEquiv[A, B]) {
    local_equiv_trans(e, local_equiv_symm(e)).target = e.source
}

theorem local_equiv_trans_symm_right_apply[A, B](e: LocalEquiv[A, B], x: A) {
    e.source.contains(x) implies local_equiv_trans(e, local_equiv_symm(e)).to_fun(x) = x
}

theorem local_equiv_trans_symm_right_inv_apply[A, B](e: LocalEquiv[A, B], x: A) {
    e.source.contains(x) implies local_equiv_trans(e, local_equiv_symm(e)).inv_fun(x) = x
}

theorem local_equiv_trans_symm_left_source[A, B](e: LocalEquiv[A, B]) {
    local_equiv_trans(local_equiv_symm(e), e).source = e.target
}

theorem local_equiv_trans_symm_left_target[A, B](e: LocalEquiv[A, B]) {
    local_equiv_trans(local_equiv_symm(e), e).target = e.target
}

theorem local_equiv_trans_symm_left_apply[A, B](e: LocalEquiv[A, B], y: B) {
    e.target.contains(y) implies local_equiv_trans(local_equiv_symm(e), e).to_fun(y) = y
}

theorem local_equiv_trans_symm_left_inv_apply[A, B](e: LocalEquiv[A, B], y: B) {
    e.target.contains(y) implies local_equiv_trans(local_equiv_symm(e), e).inv_fun(y) = y
}

structure Chart[M, E] {
    /// The underlying partial bijection from the chart domain into the model space.
    to_local_equiv: LocalEquiv[M, E]
}

attributes Chart[M, E] {
    /// The set on which the chart is defined.
    define source(self) -> Set[M] {
        self.to_local_equiv.source
    }

    /// The image of the chart inside the model space.
    define target(self) -> Set[E] {
        self.to_local_equiv.target
    }

    /// The forward coordinate map of the chart.
    define to_fun(self) -> (M -> E) {
        self.to_local_equiv.to_fun
    }

    /// The inverse coordinate map of the chart.
    define inv_fun(self) -> (E -> M) {
        self.to_local_equiv.inv_fun
    }
}

theorem chart_left_inv[M, E](c: Chart[M, E], x: M) {
    c.source.contains(x) implies c.inv_fun(c.to_fun(x)) = x
}

theorem chart_right_inv[M, E](c: Chart[M, E], y: E) {
    c.target.contains(y) implies c.to_fun(c.inv_fun(y)) = y
}

theorem chart_map_source[M, E](c: Chart[M, E], x: M) {
    c.source.contains(x) implies c.target.contains(c.to_fun(x))
}

theorem chart_map_target[M, E](c: Chart[M, E], y: E) {
    c.target.contains(y) implies c.source.contains(c.inv_fun(y))
}

theorem chart_to_fun_inj_on_source[M, E](c: Chart[M, E], x: M, y: M) {
    c.source.contains(x) and c.source.contains(y) and c.to_fun(x) = c.to_fun(y)
        implies x = y
}

theorem chart_inv_fun_inj_on_target[M, E](c: Chart[M, E], a: E, b: E) {
    c.target.contains(a) and c.target.contains(b) and c.inv_fun(a) = c.inv_fun(b)
        implies a = b
}

theorem chart_id_constructible[M](s: Set[M]) {
    exists(e: LocalEquiv[M, M]) {
        LocalEquiv[M, M].new(s, s, identity_fn[M], identity_fn[M]) = Option.some(e)
    }
}

theorem chart_restr_constructible[M, E](c: Chart[M, E], s: Set[M]) {
    exists(le: LocalEquiv[M, E]) {
        LocalEquiv[M, E].new(c.source.intersection(s),
            c.target.intersection(set_preimage(c.inv_fun, s)),
            c.to_fun, c.inv_fun) = Option.some(le)
    }
}

theorem chart_symm_constructible[M, E](c: Chart[M, E]) {
    exists(le: LocalEquiv[E, M]) {
        LocalEquiv[E, M].new(c.target, c.source, c.inv_fun, c.to_fun) = Option.some(le)
    }
}

theorem chart_transition_constructible[M, E](c1: Chart[M, E], c2: Chart[M, E]) {
    exists(e: LocalEquiv[E, E]) {
        LocalEquiv[E, E].new(
            c1.target.intersection(set_preimage(c1.inv_fun, c2.source)),
            c2.target.intersection(set_preimage(c2.inv_fun, c1.source)),
            compose(c2.to_fun, c1.inv_fun),
            compose(c1.to_fun, c2.inv_fun)) = Option.some(e)
    }
}

define chart_restr[M, E](c: Chart[M, E], s: Set[M]) -> Chart[M, E] {
    Chart[M, E].new(local_equiv_restr[M, E](c.to_local_equiv, s))
}

theorem chart_restr_to_local_equiv[M, E](c: Chart[M, E], s: Set[M]) {
    chart_restr[M, E](c, s).to_local_equiv = local_equiv_restr[M, E](c.to_local_equiv, s)
}

theorem chart_restr_source[M, E](c: Chart[M, E], s: Set[M]) {
    chart_restr[M, E](c, s).source = c.source.intersection(s)
}

theorem chart_restr_target[M, E](c: Chart[M, E], s: Set[M]) {
    chart_restr[M, E](c, s).target = c.target.intersection(set_preimage(c.inv_fun, s))
}

theorem chart_restr_to_fun[M, E](c: Chart[M, E], s: Set[M]) {
    chart_restr[M, E](c, s).to_fun = c.to_fun
}

theorem chart_restr_inv_fun[M, E](c: Chart[M, E], s: Set[M]) {
    chart_restr[M, E](c, s).inv_fun = c.inv_fun
}

theorem chart_restr_source_contains[M, E](c: Chart[M, E], s: Set[M], x: M) {
    c.source.contains(x) and s.contains(x) implies chart_restr[M, E](c, s).source.contains(x)
}

theorem chart_restr_target_contains[M, E](c: Chart[M, E], s: Set[M], y: E) {
    c.target.contains(y) and s.contains(c.inv_fun(y)) implies chart_restr[M, E](c, s).target.contains(y)
}

theorem chart_restr_map_source[M, E](c: Chart[M, E], s: Set[M], x: M) {
    c.source.contains(x) and s.contains(x) implies chart_restr[M, E](c, s).target.contains(c.to_fun(x))
}

theorem chart_restr_map_target[M, E](c: Chart[M, E], s: Set[M], y: E) {
    c.target.contains(y) and s.contains(c.inv_fun(y)) implies
        chart_restr[M, E](c, s).source.contains(c.inv_fun(y))
}

define chart_symm[M, E](c: Chart[M, E]) -> Chart[E, M] {
    Chart[E, M].new(local_equiv_symm[M, E](c.to_local_equiv))
}

theorem chart_symm_to_local_equiv[M, E](c: Chart[M, E]) {
    chart_symm[M, E](c).to_local_equiv = local_equiv_symm[M, E](c.to_local_equiv)
}

theorem chart_symm_source[M, E](c: Chart[M, E]) {
    chart_symm[M, E](c).source = c.target
}

theorem chart_symm_target[M, E](c: Chart[M, E]) {
    chart_symm[M, E](c).target = c.source
}

theorem chart_symm_to_fun[M, E](c: Chart[M, E]) {
    chart_symm[M, E](c).to_fun = c.inv_fun
}

theorem chart_symm_inv_fun[M, E](c: Chart[M, E]) {
    chart_symm[M, E](c).inv_fun = c.to_fun
}

theorem chart_symm_source_contains[M, E](c: Chart[M, E], y: E) {
    c.target.contains(y) implies chart_symm[M, E](c).source.contains(y)
}

theorem chart_symm_target_contains[M, E](c: Chart[M, E], x: M) {
    c.source.contains(x) implies chart_symm[M, E](c).target.contains(x)
}

theorem chart_symm_map_source[M, E](c: Chart[M, E], y: E) {
    c.target.contains(y) implies chart_symm[M, E](c).target.contains(c.inv_fun(y))
}

theorem chart_symm_map_target[M, E](c: Chart[M, E], x: M) {
    c.source.contains(x) implies chart_symm[M, E](c).source.contains(c.to_fun(x))
}

theorem chart_symm_left_inv_apply[M, E](c: Chart[M, E], y: E) {
    c.target.contains(y) implies chart_symm[M, E](c).inv_fun(chart_symm[M, E](c).to_fun(y)) = y
}

theorem chart_symm_right_inv_apply[M, E](c: Chart[M, E], x: M) {
    c.source.contains(x) implies chart_symm[M, E](c).to_fun(chart_symm[M, E](c).inv_fun(x)) = x
}

define chart_transition[M, E](c1: Chart[M, E], c2: Chart[M, E]) -> Chart[E, E] {
    Chart[E, E].new(local_equiv_trans[E, M, E](local_equiv_symm[M, E](c1.to_local_equiv), c2.to_local_equiv))
}

theorem chart_transition_to_local_equiv[M, E](c1: Chart[M, E], c2: Chart[M, E]) {
    chart_transition[M, E](c1, c2).to_local_equiv =
        local_equiv_trans[E, M, E](local_equiv_symm[M, E](c1.to_local_equiv), c2.to_local_equiv)
}

theorem chart_transition_source[M, E](c1: Chart[M, E], c2: Chart[M, E]) {
    chart_transition[M, E](c1, c2).source =
        c1.target.intersection(set_preimage(c1.inv_fun, c2.source))
}

theorem chart_transition_target[M, E](c1: Chart[M, E], c2: Chart[M, E]) {
    chart_transition[M, E](c1, c2).target =
        c2.target.intersection(set_preimage(c2.inv_fun, c1.source))
}

theorem chart_transition_to_fun[M, E](c1: Chart[M, E], c2: Chart[M, E]) {
    chart_transition[M, E](c1, c2).to_fun = compose[E, M, E](c2.to_fun, c1.inv_fun)
}

theorem chart_transition_inv_fun[M, E](c1: Chart[M, E], c2: Chart[M, E]) {
    chart_transition[M, E](c1, c2).inv_fun = compose[E, M, E](c1.to_fun, c2.inv_fun)
}

theorem chart_transition_source_contains[M, E](c1: Chart[M, E], c2: Chart[M, E], y: E) {
    c1.target.contains(y) and c2.source.contains(c1.inv_fun(y)) implies
        chart_transition[M, E](c1, c2).source.contains(y)
}

theorem chart_transition_target_contains[M, E](c1: Chart[M, E], c2: Chart[M, E], z: E) {
    c2.target.contains(z) and c1.source.contains(c2.inv_fun(z)) implies
        chart_transition[M, E](c1, c2).target.contains(z)
}

theorem chart_transition_map_source[M, E](c1: Chart[M, E], c2: Chart[M, E], y: E) {
    c1.target.contains(y) and c2.source.contains(c1.inv_fun(y)) implies
        chart_transition[M, E](c1, c2).target.contains(c2.to_fun(c1.inv_fun(y)))
}

theorem chart_transition_map_target[M, E](c1: Chart[M, E], c2: Chart[M, E], z: E) {
    c2.target.contains(z) and c1.source.contains(c2.inv_fun(z)) implies
        chart_transition[M, E](c1, c2).source.contains(c1.to_fun(c2.inv_fun(z)))
}

theorem chart_transition_left_inv_apply[M, E](c1: Chart[M, E], c2: Chart[M, E], y: E) {
    c1.target.contains(y) and c2.source.contains(c1.inv_fun(y)) implies
        chart_transition[M, E](c1, c2).inv_fun(c2.to_fun(c1.inv_fun(y))) = y
}

theorem chart_transition_right_inv_apply[M, E](c1: Chart[M, E], c2: Chart[M, E], z: E) {
    c2.target.contains(z) and c1.source.contains(c2.inv_fun(z)) implies
        chart_transition[M, E](c1, c2).to_fun(c1.to_fun(c2.inv_fun(z))) = z
}

define is_charted_space_data[M, E](atlas: Set[Chart[M, E]],
    chart_at: M -> Chart[M, E]) -> Bool {
    forall(x: M) {
        chart_at(x).source.contains(x)
    } and forall(x: M) {
        atlas.contains(chart_at(x))
    }
}

structure ChartedSpace[M, E] {
    /// The atlas of charts on the space.
    atlas: Set[Chart[M, E]]

    /// For each point, a chosen chart in the atlas whose source contains it.
    chart_at: M -> Chart[M, E]
} constraint {
    is_charted_space_data(atlas, chart_at)
}

theorem charted_space_mem_chart_source[M, E](c: ChartedSpace[M, E], x: M) {
    c.chart_at(x).source.contains(x)
}

theorem charted_space_chart_mem_atlas[M, E](c: ChartedSpace[M, E], x: M) {
    c.atlas.contains(c.chart_at(x))
}

theorem charted_space_atlas_covers[M, E](c: ChartedSpace[M, E], x: M) {
    exists(ch: Chart[M, E]) {
        c.atlas.contains(ch) and ch.source.contains(x)
    }
}

theorem charted_space_chart_at_map_source[M, E](c: ChartedSpace[M, E], x: M) {
    c.chart_at(x).target.contains(c.chart_at(x).to_fun(x))
}

theorem charted_space_chart_at_left_inv[M, E](c: ChartedSpace[M, E], x: M) {
    c.chart_at(x).inv_fun(c.chart_at(x).to_fun(x)) = x
}

theorem charted_space_chart_at_map_target[M, E](c: ChartedSpace[M, E], p: M, y: E) {
    c.chart_at(p).target.contains(y) implies c.chart_at(p).source.contains(c.chart_at(p).inv_fun(y))
}

theorem charted_space_chart_at_right_inv[M, E](c: ChartedSpace[M, E], p: M, y: E) {
    c.chart_at(p).target.contains(y) implies c.chart_at(p).to_fun(c.chart_at(p).inv_fun(y)) = y
}

theorem charted_space_atlas_covers_with_coordinate[M, E](c: ChartedSpace[M, E], x: M) {
    exists(ch: Chart[M, E]) {
        c.atlas.contains(ch) and ch.source.contains(x) and ch.target.contains(ch.to_fun(x)) and
            ch.inv_fun(ch.to_fun(x)) = x
    }
}

theorem charted_space_chart_at_to_fun_inj[M, E](c: ChartedSpace[M, E], p: M, x: M, y: M) {
    c.chart_at(p).source.contains(x) and c.chart_at(p).source.contains(y)
        and c.chart_at(p).to_fun(x) = c.chart_at(p).to_fun(y)
        implies x = y
}

theorem charted_space_chart_at_inv_fun_inj[M, E](c: ChartedSpace[M, E], p: M, a: E, b: E) {
    c.chart_at(p).target.contains(a) and c.chart_at(p).target.contains(b)
        and c.chart_at(p).inv_fun(a) = c.chart_at(p).inv_fun(b)
        implies a = b
}

theorem charted_space_of_global_chart_constructible[M, E](c: Chart[M, E]) {
    c.source = Set[M].universal_set implies exists(cs: ChartedSpace[M, E]) {
        ChartedSpace[M, E].new(Set[Chart[M, E]].singleton(c),
            constant[M, Chart[M, E]](c)) = Option.some(cs)
    }
}

define has_measurable_empty_constraint[K](is_meas: Set[K] -> Bool) -> Bool {
    is_meas(Set[K].empty_set)
}

define closed_under_compl_constraint[K](is_meas: Set[K] -> Bool) -> Bool {
    forall(s: Set[K]) {
        is_meas(s) implies is_meas(s.c)
    }
}

define closed_under_countable_union_constraint[K](is_meas: Set[K] -> Bool) -> Bool {
    forall(family: Nat -> Set[K]) {
        (forall(n: Nat) { is_meas(family(n)) })
            implies is_meas(indexed_union(family))
    }
}

structure SigmaAlgebra[K] {
    /// True if the set is measurable in this sigma-algebra.
    is_measurable: Set[K] -> Bool
} constraint {
    has_measurable_empty_constraint(is_measurable)
    and closed_under_compl_constraint(is_measurable)
    and closed_under_countable_union_constraint(is_measurable)
}

theorem sigma_algebra_measurable_empty[K](m: SigmaAlgebra[K]) {
    m.is_measurable(Set[K].empty_set)
}

theorem sigma_algebra_measurable_compl[K](m: SigmaAlgebra[K], s: Set[K]) {
    m.is_measurable(s) implies m.is_measurable(s.c)
}

theorem sigma_algebra_measurable_indexed_union[K](m: SigmaAlgebra[K],
        family: Nat -> Set[K]) {
    (forall(n: Nat) { m.is_measurable(family(n)) })
        implies m.is_measurable(indexed_union(family))
}

theorem sigma_algebra_measurable_universal[K](m: SigmaAlgebra[K]) {
    m.is_measurable(Set[K].universal_set)
}

theorem sigma_algebra_measurable_compl_iff[K](m: SigmaAlgebra[K], s: Set[K]) {
    m.is_measurable(s.c) = m.is_measurable(s)
}

theorem sigma_algebra_measurable_indexed_intersection[K](m: SigmaAlgebra[K],
        family: Nat -> Set[K]) {
    (forall(n: Nat) { m.is_measurable(family(n)) })
        implies m.is_measurable(indexed_intersection(family))
}

define discrete_measurable[K](s: Set[K]) -> Bool {
    true
}

theorem discrete_measurable_is_sigma_algebra[K] {
    has_measurable_empty_constraint(discrete_measurable[K])
        and closed_under_compl_constraint(discrete_measurable[K])
        and closed_under_countable_union_constraint(discrete_measurable[K])
}

let discrete_sigma_algebra[K]: SigmaAlgebra[K] satisfy {
    SigmaAlgebra.new(discrete_measurable[K]) = Option.some(discrete_sigma_algebra)
}

attributes SigmaAlgebra[K] {
    /// The discrete sigma-algebra on `K`, in which every set is measurable.
    let discrete: SigmaAlgebra[K] = discrete_sigma_algebra[K]
}

theorem discrete_sigma_algebra_is_measurable[K](s: Set[K]) {
    SigmaAlgebra[K].discrete.is_measurable(s)
}

theorem sigma_algebra_measurable_union[K](m: SigmaAlgebra[K],
        a: Set[K], b: Set[K]) {
    m.is_measurable(a) and m.is_measurable(b)
        implies m.is_measurable(a.union(b))
}

theorem sigma_algebra_measurable_intersection[K](m: SigmaAlgebra[K],
        a: Set[K], b: Set[K]) {
    m.is_measurable(a) and m.is_measurable(b)
        implies m.is_measurable(a.intersection(b))
}

theorem sigma_algebra_measurable_difference[K](m: SigmaAlgebra[K],
        a: Set[K], b: Set[K]) {
    m.is_measurable(a) and m.is_measurable(b)
        implies m.is_measurable(a.difference(b))
}

define trivial_measurable[K](s: Set[K]) -> Bool {
    s = Set[K].empty_set or s = Set[K].universal_set
}

theorem trivial_measurable_empty[K] {
    trivial_measurable[K](Set[K].empty_set)
}

theorem trivial_measurable_universal[K] {
    trivial_measurable[K](Set[K].universal_set)
}

theorem trivial_measurable_compl[K](s: Set[K]) {
    trivial_measurable[K](s) implies trivial_measurable[K](s.c)
}

theorem trivial_measurable_indexed_union_universal[K](family: Nat -> Set[K], n: Nat) {
    family(n) = Set[K].universal_set
        implies indexed_union(family) = Set[K].universal_set
}

theorem trivial_measurable_indexed_union[K](family: Nat -> Set[K]) {
    (forall(n: Nat) { trivial_measurable[K](family(n)) })
        implies trivial_measurable[K](indexed_union(family))
}

theorem trivial_measurable_is_sigma_algebra[K] {
    has_measurable_empty_constraint(trivial_measurable[K])
        and closed_under_compl_constraint(trivial_measurable[K])
        and closed_under_countable_union_constraint(trivial_measurable[K])
}

let trivial_sigma_algebra[K]: SigmaAlgebra[K] satisfy {
    SigmaAlgebra.new(trivial_measurable[K]) = Option.some(trivial_sigma_algebra)
}

attributes SigmaAlgebra[K] {
    /// The trivial sigma-algebra on `K`, in which only the empty and universal
    /// sets are measurable.
    let trivial: SigmaAlgebra[K] = trivial_sigma_algebra[K]
}

define sigma_algebra_le[K](m1: SigmaAlgebra[K], m2: SigmaAlgebra[K]) -> Bool {
    forall(s: Set[K]) {
        m1.is_measurable(s) implies m2.is_measurable(s)
    }
}

theorem sigma_algebra_le_refl[K](m: SigmaAlgebra[K]) {
    sigma_algebra_le(m, m)
}

theorem sigma_algebra_le_trans[K](m1: SigmaAlgebra[K], m2: SigmaAlgebra[K],
        m3: SigmaAlgebra[K]) {
    sigma_algebra_le(m1, m2) and sigma_algebra_le(m2, m3)
        implies sigma_algebra_le(m1, m3)
}

theorem trivial_sigma_algebra_le[K](m: SigmaAlgebra[K]) {
    sigma_algebra_le(SigmaAlgebra[K].trivial, m)
}

theorem sigma_algebra_le_discrete[K](m: SigmaAlgebra[K]) {
    sigma_algebra_le(m, SigmaAlgebra[K].discrete)
}

define sigma_algebra_equiv[K](m1: SigmaAlgebra[K], m2: SigmaAlgebra[K]) -> Bool {
    sigma_algebra_le(m1, m2) and sigma_algebra_le(m2, m1)
}

theorem sigma_algebra_equiv_refl[K](m: SigmaAlgebra[K]) {
    sigma_algebra_equiv(m, m)
}

theorem sigma_algebra_equiv_symm[K](m1: SigmaAlgebra[K], m2: SigmaAlgebra[K]) {
    sigma_algebra_equiv(m1, m2) implies sigma_algebra_equiv(m2, m1)
}

theorem sigma_algebra_equiv_trans[K](m1: SigmaAlgebra[K], m2: SigmaAlgebra[K],
        m3: SigmaAlgebra[K]) {
    sigma_algebra_equiv(m1, m2) and sigma_algebra_equiv(m2, m3)
        implies sigma_algebra_equiv(m1, m3)
}

theorem sigma_algebra_equiv_iff_same_measurable[K](m1: SigmaAlgebra[K],
        m2: SigmaAlgebra[K]) {
    sigma_algebra_equiv(m1, m2) iff
        forall(s: Set[K]) { m1.is_measurable(s) = m2.is_measurable(s) }
}

theorem trivial_sigma_algebra_is_measurable_empty[K] {
    SigmaAlgebra[K].trivial.is_measurable(Set[K].empty_set)
}

theorem trivial_sigma_algebra_is_measurable_universal[K] {
    SigmaAlgebra[K].trivial.is_measurable(Set[K].universal_set)
}

define is_measurable_fn[A, B](f: A -> B, mA: SigmaAlgebra[A],
        mB: SigmaAlgebra[B]) -> Bool {
    forall(t: Set[B]) {
        mB.is_measurable(t) implies mA.is_measurable(set_preimage(f, t))
    }
}

theorem is_measurable_fn_identity[A](m: SigmaAlgebra[A]) {
    is_measurable_fn(identity_fn[A], m, m)
}

theorem is_measurable_fn_compose[A, B, C](f: B -> C, g: A -> B,
        mA: SigmaAlgebra[A], mB: SigmaAlgebra[B], mC: SigmaAlgebra[C]) {
    is_measurable_fn(g, mA, mB) and is_measurable_fn(f, mB, mC)
        implies is_measurable_fn(compose(f, g), mA, mC)
}

theorem is_measurable_fn_preimage_measurable[A, B](f: A -> B,
        mA: SigmaAlgebra[A], mB: SigmaAlgebra[B], t: Set[B]) {
    is_measurable_fn(f, mA, mB) and mB.is_measurable(t)
        implies mA.is_measurable(set_preimage(f, t))
}

theorem is_measurable_fn_preimage_union[A, B](f: A -> B,
        mA: SigmaAlgebra[A], mB: SigmaAlgebra[B], s: Set[B], t: Set[B]) {
    is_measurable_fn(f, mA, mB) and mB.is_measurable(s) and mB.is_measurable(t)
        implies mA.is_measurable(set_preimage(f, s.union(t)))
}

theorem is_measurable_fn_preimage_intersection[A, B](f: A -> B,
        mA: SigmaAlgebra[A], mB: SigmaAlgebra[B], s: Set[B], t: Set[B]) {
    is_measurable_fn(f, mA, mB) and mB.is_measurable(s) and mB.is_measurable(t)
        implies mA.is_measurable(set_preimage(f, s.intersection(t)))
}

theorem is_measurable_fn_preimage_difference[A, B](f: A -> B,
        mA: SigmaAlgebra[A], mB: SigmaAlgebra[B], s: Set[B], t: Set[B]) {
    is_measurable_fn(f, mA, mB) and mB.is_measurable(s) and mB.is_measurable(t)
        implies mA.is_measurable(set_preimage(f, s.difference(t)))
}

theorem is_measurable_fn_preimage_indexed_union[A, B](f: A -> B,
        mA: SigmaAlgebra[A], mB: SigmaAlgebra[B], family: Nat -> Set[B]) {
    is_measurable_fn(f, mA, mB) and (forall(n: Nat) { mB.is_measurable(family(n)) })
        implies mA.is_measurable(set_preimage(f, indexed_union(family)))
}

theorem is_measurable_fn_preimage_indexed_intersection[A, B](f: A -> B,
        mA: SigmaAlgebra[A], mB: SigmaAlgebra[B], family: Nat -> Set[B]) {
    is_measurable_fn(f, mA, mB) and (forall(n: Nat) { mB.is_measurable(family(n)) })
        implies mA.is_measurable(set_preimage(f, indexed_intersection(family)))
}

theorem is_measurable_fn_into_trivial[A, B](f: A -> B, mA: SigmaAlgebra[A]) {
    is_measurable_fn(f, mA, SigmaAlgebra[B].trivial)
}

theorem is_measurable_fn_from_discrete[A, B](f: A -> B, mB: SigmaAlgebra[B]) {
    is_measurable_fn(f, SigmaAlgebra[A].discrete, mB)
}

theorem is_measurable_fn_mono_codomain[A, B](f: A -> B,
        mA: SigmaAlgebra[A], mB: SigmaAlgebra[B], mC: SigmaAlgebra[B]) {
    is_measurable_fn(f, mA, mB) and sigma_algebra_le(mC, mB)
        implies is_measurable_fn(f, mA, mC)
}

theorem sigma_algebra_eq_of_same_measurable[K](m1: SigmaAlgebra[K],
        m2: SigmaAlgebra[K]) {
    (forall(s: Set[K]) { m1.is_measurable(s) = m2.is_measurable(s) })
        implies m1 = m2
}

theorem sigma_algebra_eq_of_equiv[K](m1: SigmaAlgebra[K], m2: SigmaAlgebra[K]) {
    sigma_algebra_equiv(m1, m2) implies m1 = m2
}

theorem sigma_algebra_le_antisymm[K](m1: SigmaAlgebra[K], m2: SigmaAlgebra[K]) {
    sigma_algebra_le(m1, m2) and sigma_algebra_le(m2, m1)
        implies m1 = m2
}

theorem is_measurable_fn_pointwise_eq[A, B](f: A -> B, g: A -> B,
        mA: SigmaAlgebra[A], mB: SigmaAlgebra[B]) {
    is_measurable_fn(f, mA, mB) and (forall(x: A) { f(x) = g(x) })
        implies is_measurable_fn(g, mA, mB)
}

theorem is_measurable_fn_const[A, B](c: B,
        mA: SigmaAlgebra[A], mB: SigmaAlgebra[B]) {
    is_measurable_fn(function(x: A) { c }, mA, mB)
}

define is_preimage_measurable[A, B](f: A -> B, mB: SigmaAlgebra[B],
        s: Set[A]) -> Bool {
    exists(t: Set[B]) {
        mB.is_measurable(t) and s = set_preimage(f, t)
    }
}

theorem preimage_measurable_empty[A, B](f: A -> B, mB: SigmaAlgebra[B]) {
    has_measurable_empty_constraint(
        function(s: Set[A]) { is_preimage_measurable(f, mB, s) })
}

theorem preimage_measurable_compl[A, B](f: A -> B, mB: SigmaAlgebra[B]) {
    closed_under_compl_constraint(
        function(s: Set[A]) { is_preimage_measurable(f, mB, s) })
}

theorem preimage_measurable_indexed_union[A, B](f: A -> B,
        mB: SigmaAlgebra[B]) {
    closed_under_countable_union_constraint(
        function(s: Set[A]) { is_preimage_measurable(f, mB, s) })
}

theorem preimage_measurable_is_sigma_algebra[A, B](f: A -> B,
        mB: SigmaAlgebra[B]) {
    has_measurable_empty_constraint(
        function(s: Set[A]) { is_preimage_measurable(f, mB, s) })
        and closed_under_compl_constraint(
            function(s: Set[A]) { is_preimage_measurable(f, mB, s) })
        and closed_under_countable_union_constraint(
            function(s: Set[A]) { is_preimage_measurable(f, mB, s) })
}

let preimage_sigma_algebra[A, B](f: A -> B, mB: SigmaAlgebra[B]) -> result: SigmaAlgebra[A] satisfy {
    SigmaAlgebra.new(function(s: Set[A]) { is_preimage_measurable(f, mB, s) }) = Option.some(result)
}

theorem preimage_sigma_algebra_is_measurable_eq[A, B](f: A -> B,
        mB: SigmaAlgebra[B], s: Set[A]) {
    preimage_sigma_algebra(f, mB).is_measurable(s) =
        is_preimage_measurable(f, mB, s)
}

theorem preimage_sigma_algebra_is_measurable_preimage[A, B](f: A -> B,
        mB: SigmaAlgebra[B], t: Set[B]) {
    mB.is_measurable(t)
        implies preimage_sigma_algebra(f, mB).is_measurable(set_preimage(f, t))
}

theorem preimage_sigma_algebra_makes_fn_measurable[A, B](f: A -> B,
        mB: SigmaAlgebra[B]) {
    is_measurable_fn(f, preimage_sigma_algebra(f, mB), mB)
}

theorem preimage_sigma_algebra_is_coarsest[A, B](f: A -> B,
        mA: SigmaAlgebra[A], mB: SigmaAlgebra[B]) {
    is_measurable_fn(f, mA, mB)
        implies sigma_algebra_le(preimage_sigma_algebra(f, mB), mA)
}

theorem is_measurable_fn_mono_domain[A, B](f: A -> B,
        mA: SigmaAlgebra[A], mD: SigmaAlgebra[A], mB: SigmaAlgebra[B]) {
    is_measurable_fn(f, mA, mB) and sigma_algebra_le(mA, mD)
        implies is_measurable_fn(f, mD, mB)
}

define generated_measurable[K](g: Set[K] -> Bool, s: Set[K]) -> Bool {
    forall(m: SigmaAlgebra[K]) {
        (forall(t: Set[K]) { g(t) implies m.is_measurable(t) })
            implies m.is_measurable(s)
    }
}

theorem generated_measurable_apply[K](g: Set[K] -> Bool, s: Set[K],
        m: SigmaAlgebra[K]) {
    generated_measurable(g, s)
        and (forall(t: Set[K]) { g(t) implies m.is_measurable(t) })
        implies m.is_measurable(s)
}

theorem generated_measurable_empty[K](g: Set[K] -> Bool) {
    has_measurable_empty_constraint(
        function(s: Set[K]) { generated_measurable(g, s) })
}

theorem generated_measurable_compl[K](g: Set[K] -> Bool) {
    closed_under_compl_constraint(
        function(s: Set[K]) { generated_measurable(g, s) })
}

theorem generated_measurable_indexed_union[K](g: Set[K] -> Bool) {
    closed_under_countable_union_constraint(
        function(s: Set[K]) { generated_measurable(g, s) })
}

theorem generated_measurable_is_sigma_algebra[K](g: Set[K] -> Bool) {
    has_measurable_empty_constraint(
        function(s: Set[K]) { generated_measurable(g, s) })
        and closed_under_compl_constraint(
            function(s: Set[K]) { generated_measurable(g, s) })
        and closed_under_countable_union_constraint(
            function(s: Set[K]) { generated_measurable(g, s) })
}

define pullback_measurable[A, B](f: A -> B, mA: SigmaAlgebra[A], t: Set[B]) -> Bool {
    mA.is_measurable(set_preimage(f, t))
}

theorem pullback_measurable_empty[A, B](f: A -> B, mA: SigmaAlgebra[A]) {
    has_measurable_empty_constraint(
        function(t: Set[B]) { pullback_measurable(f, mA, t) })
}

theorem pullback_measurable_compl[A, B](f: A -> B, mA: SigmaAlgebra[A]) {
    closed_under_compl_constraint(
        function(t: Set[B]) { pullback_measurable(f, mA, t) })
}

theorem pullback_measurable_indexed_union[A, B](f: A -> B, mA: SigmaAlgebra[A]) {
    closed_under_countable_union_constraint(
        function(t: Set[B]) { pullback_measurable(f, mA, t) })
}

theorem pullback_measurable_is_sigma_algebra[A, B](f: A -> B,
        mA: SigmaAlgebra[A]) {
    has_measurable_empty_constraint(
        function(t: Set[B]) { pullback_measurable(f, mA, t) })
        and closed_under_compl_constraint(
            function(t: Set[B]) { pullback_measurable(f, mA, t) })
        and closed_under_countable_union_constraint(
            function(t: Set[B]) { pullback_measurable(f, mA, t) })
}

let pullback_sigma_algebra[A, B](f: A -> B, mA: SigmaAlgebra[A]) -> result: SigmaAlgebra[B] satisfy {
    SigmaAlgebra.new(function(t: Set[B]) { pullback_measurable(f, mA, t) }) = Option.some(result)
}

theorem pullback_sigma_algebra_is_measurable_eq[A, B](f: A -> B,
        mA: SigmaAlgebra[A], t: Set[B]) {
    pullback_sigma_algebra(f, mA).is_measurable(t) = pullback_measurable(f, mA, t)
}

theorem pullback_sigma_algebra_makes_fn_measurable[A, B](f: A -> B,
        mA: SigmaAlgebra[A]) {
    is_measurable_fn(f, mA, pullback_sigma_algebra(f, mA))
}

let generated_sigma_algebra[K](g: Set[K] -> Bool) -> result: SigmaAlgebra[K] satisfy {
    SigmaAlgebra.new(function(s: Set[K]) { generated_measurable(g, s) }) = Option.some(result)
}

theorem generated_sigma_algebra_is_measurable_eq[K](g: Set[K] -> Bool, s: Set[K]) {
    generated_sigma_algebra(g).is_measurable(s) = generated_measurable(g, s)
}

theorem generated_sigma_algebra_contains_generator[K](g: Set[K] -> Bool, s: Set[K]) {
    g(s) implies generated_sigma_algebra(g).is_measurable(s)
}

theorem generated_sigma_algebra_is_smallest[K](g: Set[K] -> Bool, m: SigmaAlgebra[K]) {
    (forall(t: Set[K]) { g(t) implies m.is_measurable(t) })
        implies sigma_algebra_le(generated_sigma_algebra(g), m)
}

theorem is_measurable_fn_into_generated[A, B](f: A -> B, mA: SigmaAlgebra[A],
        g: Set[B] -> Bool) {
    (forall(t: Set[B]) { g(t) implies mA.is_measurable(set_preimage(f, t)) })
        implies is_measurable_fn(f, mA, generated_sigma_algebra(g))
}

theorem generated_sigma_algebra_mono[K](g1: Set[K] -> Bool, g2: Set[K] -> Bool) {
    (forall(s: Set[K]) { g1(s) implies g2(s) })
        implies sigma_algebra_le(generated_sigma_algebra(g1),
            generated_sigma_algebra(g2))
}

theorem generated_sigma_algebra_le_iff[K](g: Set[K] -> Bool, m: SigmaAlgebra[K]) {
    sigma_algebra_le(generated_sigma_algebra(g), m) iff
        forall(t: Set[K]) { g(t) implies m.is_measurable(t) }
}

theorem is_measurable_fn_into_generated_iff[A, B](f: A -> B,
        mA: SigmaAlgebra[A], g: Set[B] -> Bool) {
    is_measurable_fn(f, mA, generated_sigma_algebra(g)) iff
        forall(t: Set[B]) { g(t) implies mA.is_measurable(set_preimage(f, t)) }
}

define preimage_generator[A, B](f: A -> B, g: Set[B] -> Bool) -> (Set[A] -> Bool) {
    function(s: Set[A]) {
        exists(t: Set[B]) { g(t) and s = set_preimage(f, t) }
    }
}

theorem preimage_sigma_algebra_generated_eq[A, B](f: A -> B, g: Set[B] -> Bool) {
    preimage_sigma_algebra(f, generated_sigma_algebra(g))
        = generated_sigma_algebra(preimage_generator(f, g))
}

theorem generated_sigma_algebra_eq_of_generated_by_self[K](m: SigmaAlgebra[K]) {
    sigma_algebra_le(m,
        generated_sigma_algebra(function(s: Set[K]) { m.is_measurable(s) }))
}

define indicator_fn[T](s: Set[T]) -> (T -> Bool) {
    function(x: T) { s.contains(x) }
}

define indicator_preimage_pos[T](s: Set[T], t: Set[Bool]) -> Set[T] {
    if t.contains(true) { s } else { Set[T].empty_set }
}

define indicator_preimage_neg[T](s: Set[T], t: Set[Bool]) -> Set[T] {
    if t.contains(false) { s.c } else { Set[T].empty_set }
}

theorem indicator_fn_preimage_eq[T](s: Set[T], t: Set[Bool]) {
    set_preimage(indicator_fn(s), t) =
        indicator_preimage_pos(s, t).union(indicator_preimage_neg(s, t))
}

theorem indicator_preimage_pos_is_measurable[T](s: Set[T], t: Set[Bool],
        mT: SigmaAlgebra[T]) {
    mT.is_measurable(s) implies mT.is_measurable(indicator_preimage_pos(s, t))
}

theorem indicator_preimage_neg_is_measurable[T](s: Set[T], t: Set[Bool],
        mT: SigmaAlgebra[T]) {
    mT.is_measurable(s) implies mT.is_measurable(indicator_preimage_neg(s, t))
}

theorem indicator_fn_is_measurable_fn[T](s: Set[T], mT: SigmaAlgebra[T]) {
    mT.is_measurable(s) implies
        is_measurable_fn(indicator_fn(s), mT, SigmaAlgebra[Bool].discrete)
}

theorem indicator_fn_preimage_true_eq[T](s: Set[T]) {
    set_preimage(indicator_fn(s),
        Set[Bool].new(function(b: Bool) { b })) = s
}

theorem set_measurable_of_indicator_fn_measurable[T](s: Set[T],
        mT: SigmaAlgebra[T]) {
    is_measurable_fn(indicator_fn(s), mT, SigmaAlgebra[Bool].discrete)
        implies mT.is_measurable(s)
}

theorem indicator_fn_is_measurable_iff[T](s: Set[T], mT: SigmaAlgebra[T]) {
    is_measurable_fn(indicator_fn(s), mT, SigmaAlgebra[Bool].discrete) iff
        mT.is_measurable(s)
}

define is_measurable_in_subspace[T](m: SigmaAlgebra[T], a: Set[T], u: Set[T]) -> Bool {
    exists(v: Set[T]) {
        m.is_measurable(v) and u = v.intersection(a)
    }
}

theorem subspace_measurable_empty[T](m: SigmaAlgebra[T], a: Set[T]) {
    is_measurable_in_subspace(m, a, Set[T].empty_set)
}

theorem subspace_measurable_self[T](m: SigmaAlgebra[T], a: Set[T]) {
    is_measurable_in_subspace(m, a, a)
}

theorem subspace_measurable_from_ambient[T](m: SigmaAlgebra[T], a: Set[T], v: Set[T]) {
    m.is_measurable(v) implies is_measurable_in_subspace(m, a, v.intersection(a))
}

theorem subspace_measurable_compl[T](m: SigmaAlgebra[T], a: Set[T], u: Set[T]) {
    is_measurable_in_subspace(m, a, u)
        implies is_measurable_in_subspace(m, a, a.difference(u))
}

theorem subspace_measurable_union[T](m: SigmaAlgebra[T], a: Set[T],
        u: Set[T], v: Set[T]) {
    is_measurable_in_subspace(m, a, u) and is_measurable_in_subspace(m, a, v)
        implies is_measurable_in_subspace(m, a, u.union(v))
}

theorem subspace_measurable_intersection[T](m: SigmaAlgebra[T], a: Set[T],
        u: Set[T], v: Set[T]) {
    is_measurable_in_subspace(m, a, u) and is_measurable_in_subspace(m, a, v)
        implies is_measurable_in_subspace(m, a, u.intersection(v))
}

theorem subspace_measurable_subset[T](m: SigmaAlgebra[T], a: Set[T], u: Set[T]) {
    is_measurable_in_subspace(m, a, u) implies u.subset(a)
}

theorem subspace_measurable_difference[T](m: SigmaAlgebra[T], a: Set[T],
        u: Set[T], v: Set[T]) {
    is_measurable_in_subspace(m, a, u) and is_measurable_in_subspace(m, a, v)
        implies is_measurable_in_subspace(m, a, u.difference(v))
}

theorem subspace_measurable_indexed_union[T](m: SigmaAlgebra[T], a: Set[T],
        family: Nat -> Set[T]) {
    (forall(n: Nat) { is_measurable_in_subspace(m, a, family(n)) })
        implies is_measurable_in_subspace(m, a, indexed_union(family))
}

theorem subspace_measurable_indexed_intersection[T](m: SigmaAlgebra[T],
        a: Set[T], family: Nat -> Set[T]) {
    (forall(n: Nat) { is_measurable_in_subspace(m, a, family(n)) })
        implies is_measurable_in_subspace(m, a, indexed_intersection(family))
}

define trace_measurable[T](m: SigmaAlgebra[T], a: Set[T], u: Set[T]) -> Bool {
    is_measurable_in_subspace(m, a, u.intersection(a))
}

theorem trace_measurable_empty[T](m: SigmaAlgebra[T], a: Set[T]) {
    trace_measurable(m, a, Set[T].empty_set)
}

theorem trace_measurable_compl[T](m: SigmaAlgebra[T], a: Set[T], u: Set[T]) {
    trace_measurable(m, a, u) implies trace_measurable(m, a, u.c)
}

theorem trace_measurable_indexed_union[T](m: SigmaAlgebra[T], a: Set[T],
        family: Nat -> Set[T]) {
    (forall(n: Nat) { trace_measurable(m, a, family(n)) })
        implies trace_measurable(m, a, indexed_union(family))
}

theorem trace_measurable_is_sigma_algebra[T](m: SigmaAlgebra[T], a: Set[T]) {
    has_measurable_empty_constraint(
        function(u: Set[T]) { trace_measurable(m, a, u) })
        and closed_under_compl_constraint(
            function(u: Set[T]) { trace_measurable(m, a, u) })
        and closed_under_countable_union_constraint(
            function(u: Set[T]) { trace_measurable(m, a, u) })
}

let trace_sigma_algebra[T](m: SigmaAlgebra[T], a: Set[T]) -> result: SigmaAlgebra[T] satisfy {
    SigmaAlgebra.new(function(u: Set[T]) { trace_measurable(m, a, u) }) = Option.some(result)
}

theorem trace_sigma_algebra_is_measurable_eq[T](m: SigmaAlgebra[T], a: Set[T],
        u: Set[T]) {
    trace_sigma_algebra(m, a).is_measurable(u) = trace_measurable(m, a, u)
}

theorem trace_sigma_algebra_measurable_iff_subspace[T](m: SigmaAlgebra[T],
        a: Set[T], u: Set[T]) {
    u.subset(a) implies
        (trace_sigma_algebra(m, a).is_measurable(u) iff
            is_measurable_in_subspace(m, a, u))
}

theorem trace_sigma_algebra_measurable_of_subspace[T](m: SigmaAlgebra[T], a: Set[T], u: Set[T]) {
    is_measurable_in_subspace(m, a, u) implies trace_sigma_algebra(m, a).is_measurable(u)
}

theorem subspace_indicator_fn_is_measurable[T](m: SigmaAlgebra[T], a: Set[T],
        u: Set[T]) {
    is_measurable_in_subspace(m, a, u) implies
        is_measurable_fn(indicator_fn(u),
            trace_sigma_algebra(m, a), SigmaAlgebra[Bool].discrete)
}

theorem subspace_set_measurable_of_indicator_fn_measurable[T](m: SigmaAlgebra[T],
        a: Set[T], u: Set[T]) {
    is_measurable_fn(indicator_fn(u),
        trace_sigma_algebra(m, a), SigmaAlgebra[Bool].discrete)
        implies trace_sigma_algebra(m, a).is_measurable(u)
}

theorem subspace_indicator_fn_is_measurable_iff[T](m: SigmaAlgebra[T], a: Set[T],
        u: Set[T]) {
    u.subset(a) implies
        (is_measurable_fn(indicator_fn(u),
            trace_sigma_algebra(m, a), SigmaAlgebra[Bool].discrete) iff
            is_measurable_in_subspace(m, a, u))
}

define big_union_contains[T](c: Set[T] -> Bool, x: T) -> Bool {
    exists(s: Set[T]) {
        c(s) and s.contains(x)
    }
}

define big_union[T](c: Set[T] -> Bool) -> Set[T] {
    Set[T].new(big_union_contains(c))
}

define big_intersection_contains[T](c: Set[T] -> Bool, x: T) -> Bool {
    forall(s: Set[T]) {
        c(s) implies s.contains(x)
    }
}

define big_intersection[T](c: Set[T] -> Bool) -> Set[T] {
    Set[T].new(big_intersection_contains(c))
}

theorem big_union_contains_eq[T](c: Set[T] -> Bool, x: T) {
    big_union(c).contains(x) = exists(s: Set[T]) {
        c(s) and s.contains(x)
    }
}

theorem big_union_contains_of_member[T](c: Set[T] -> Bool, s: Set[T], x: T) {
    c(s) and s.contains(x) implies big_union(c).contains(x)
}

theorem big_intersection_contains_eq[T](c: Set[T] -> Bool, x: T) {
    big_intersection(c).contains(x) = forall(s: Set[T]) {
        c(s) implies s.contains(x)
    }
}

typeclass T: TopologicalSpace {
    /// True if the given subset is open in the topology.
    is_open: Set[T] -> Bool

    /// Rule: the empty set is open.
    open_empty {
        T.is_open(Set[T].empty_set)
    }

    /// Rule: the whole space is open.
    open_universal {
        T.is_open(Set[T].universal_set)
    }

    /// Rule: the intersection of two open sets is open.
    open_inter(s: Set[T], t: Set[T]) {
        T.is_open(s) and T.is_open(t) implies T.is_open(s.intersection(t))
    }

    /// Rule: the union of any family of open sets is open.
    open_big_union(c: Set[T] -> Bool) {
        (forall(s: Set[T]) { c(s) implies T.is_open(s) })
            implies T.is_open(big_union(c))
    }
}

theorem open_universal[T: TopologicalSpace] {
    T.is_open(Set[T].universal_set)
}

theorem open_inter[T: TopologicalSpace](s: Set[T], t: Set[T]) {
    T.is_open(s) and T.is_open(t) implies T.is_open(s.intersection(t))
}

theorem open_big_union[T: TopologicalSpace](c: Set[T] -> Bool) {
    (forall(s: Set[T]) { c(s) implies T.is_open(s) })
        implies T.is_open(big_union(c))
}

theorem open_empty[T: TopologicalSpace] {
    T.is_open(Set[T].empty_set)
}

define is_closed[T: TopologicalSpace](s: Set[T]) -> Bool {
    T.is_open(s.c)
}

theorem closed_universal[T: TopologicalSpace] {
    is_closed(Set[T].universal_set)
}

theorem closed_empty[T: TopologicalSpace] {
    is_closed(Set[T].empty_set)
}

define pair_family[T](s: Set[T], t: Set[T], u: Set[T]) -> Bool {
    u = s or u = t
}

theorem big_union_pair[T](s: Set[T], t: Set[T]) {
    big_union(pair_family(s, t)) = s.union(t)
}

theorem big_union_of_empty_family[T](c: Set[T] -> Bool) {
    (forall(s: Set[T]) { c(s) implies s = Set[T].empty_set })
        implies big_union(c) = Set[T].empty_set
}

theorem big_union_with_universal_member[T](c: Set[T] -> Bool) {
    c(Set[T].universal_set) implies big_union(c) = Set[T].universal_set
}

theorem open_union_open[T: TopologicalSpace](s: Set[T], t: Set[T]) {
    T.is_open(s) and T.is_open(t) implies T.is_open(s.union(t))
}

theorem compl_intersection_eq_union_compl[T](s: Set[T], t: Set[T]) {
    s.intersection(t).c = s.c.union(t.c)
}

theorem compl_union_eq_intersection_compl[T](s: Set[T], t: Set[T]) {
    s.union(t).c = s.c.intersection(t.c)
}

theorem closed_inter[T: TopologicalSpace](s: Set[T], t: Set[T]) {
    is_closed(s) and is_closed(t) implies is_closed(s.intersection(t))
}

theorem closed_union_closed[T: TopologicalSpace](s: Set[T], t: Set[T]) {
    is_closed(s) and is_closed(t) implies is_closed(s.union(t))
}

define interior_contains[T: TopologicalSpace](s: Set[T], x: T) -> Bool {
    exists(u: Set[T]) {
        T.is_open(u) and u.subset(s) and u.contains(x)
    }
}

define interior[T: TopologicalSpace](s: Set[T]) -> Set[T] {
    Set[T].new(interior_contains(s))
}

theorem interior_contains_eq[T: TopologicalSpace](s: Set[T], x: T) {
    interior(s).contains(x) = exists(u: Set[T]) {
        T.is_open(u) and u.subset(s) and u.contains(x)
    }
}

theorem interior_subset[T: TopologicalSpace](s: Set[T]) {
    interior(s).subset(s)
}

define closure_contains[T: TopologicalSpace](s: Set[T], x: T) -> Bool {
    forall(c: Set[T]) {
        is_closed(c) and s.subset(c) implies c.contains(x)
    }
}

define closure[T: TopologicalSpace](s: Set[T]) -> Set[T] {
    Set[T].new(closure_contains(s))
}

theorem closure_contains_eq[T: TopologicalSpace](s: Set[T], x: T) {
    closure(s).contains(x) = forall(c: Set[T]) {
        is_closed(c) and s.subset(c) implies c.contains(x)
    }
}

theorem subset_closure[T: TopologicalSpace](s: Set[T]) {
    s.subset(closure(s))
}

define frontier[T: TopologicalSpace](s: Set[T]) -> Set[T] {
    closure(s).difference(interior(s))
}

define is_continuous[X: TopologicalSpace, Y: TopologicalSpace](f: X -> Y) -> Bool {
    forall(v: Set[Y]) {
        Y.is_open(v) implies X.is_open(set_preimage(f, v))
    }
}

theorem id_continuous[X: TopologicalSpace] {
    is_continuous(identity_fn[X])
}

define open_subsets_family[T: TopologicalSpace](s: Set[T], u: Set[T]) -> Bool {
    T.is_open(u) and u.subset(s)
}

theorem interior_eq_big_union_open_subsets[T: TopologicalSpace](s: Set[T]) {
    interior(s) = big_union(open_subsets_family(s))
}

theorem interior_open[T: TopologicalSpace](s: Set[T]) {
    T.is_open(interior(s))
}

theorem open_subset_imp_subset_interior[T: TopologicalSpace](s: Set[T], u: Set[T]) {
    T.is_open(u) and u.subset(s) implies u.subset(interior(s))
}

theorem open_eq_interior[T: TopologicalSpace](s: Set[T]) {
    T.is_open(s) implies s = interior(s)
}

theorem open_iff_eq_interior[T: TopologicalSpace](s: Set[T]) {
    T.is_open(s) = (s = interior(s))
}

define closed_supersets_family[T: TopologicalSpace](s: Set[T], u: Set[T]) -> Bool {
    is_closed(u) and s.subset(u)
}

theorem closure_eq_big_intersection_closed_supersets[T: TopologicalSpace](s: Set[T]) {
    closure(s) = big_intersection(closed_supersets_family(s))
}

theorem closure_contains_imp_member[T: TopologicalSpace](s: Set[T], c: Set[T], x: T) {
    closure(s).contains(x) and is_closed(c) and s.subset(c) implies c.contains(x)
}

theorem closure_subset_of_closed[T: TopologicalSpace](s: Set[T]) {
    is_closed(s) implies closure(s).subset(s)
}

theorem closed_eq_closure[T: TopologicalSpace](s: Set[T]) {
    is_closed(s) implies s = closure(s)
}

theorem interior_empty[T: TopologicalSpace] {
    interior(Set[T].empty_set) = Set[T].empty_set
}

theorem interior_universal[T: TopologicalSpace] {
    interior(Set[T].universal_set) = Set[T].universal_set
}

theorem closure_empty[T: TopologicalSpace] {
    closure(Set[T].empty_set) = Set[T].empty_set
}

theorem closure_universal[T: TopologicalSpace] {
    closure(Set[T].universal_set) = Set[T].universal_set
}

theorem interior_monotone[T: TopologicalSpace](s: Set[T], t: Set[T]) {
    s.subset(t) implies interior(s).subset(interior(t))
}

theorem closure_monotone[T: TopologicalSpace](s: Set[T], t: Set[T]) {
    s.subset(t) implies closure(s).subset(closure(t))
}

theorem interior_idempotent[T: TopologicalSpace](s: Set[T]) {
    interior(interior(s)) = interior(s)
}

theorem compl_closure_eq_interior_compl[T: TopologicalSpace](s: Set[T]) {
    closure(s).c = interior(s.c)
}

theorem closure_closed[T: TopologicalSpace](s: Set[T]) {
    is_closed(closure(s))
}

theorem closure_idempotent[T: TopologicalSpace](s: Set[T]) {
    closure(closure(s)) = closure(s)
}

theorem closure_eq_compl_interior_compl[T: TopologicalSpace](s: Set[T]) {
    closure(s) = interior(s.c).c
}

theorem interior_eq_compl_closure_compl[T: TopologicalSpace](s: Set[T]) {
    interior(s) = closure(s.c).c
}

theorem frontier_closed[T: TopologicalSpace](s: Set[T]) {
    is_closed(frontier(s))
}

theorem interior_inter[T: TopologicalSpace](s: Set[T], t: Set[T]) {
    interior(s.intersection(t)) = interior(s).intersection(interior(t))
}

theorem closure_union[T: TopologicalSpace](s: Set[T], t: Set[T]) {
    closure(s.union(t)) = closure(s).union(closure(t))
}

theorem closure_inter_subset[T: TopologicalSpace](s: Set[T], t: Set[T]) {
    closure(s.intersection(t)).subset(closure(s).intersection(closure(t)))
}

theorem interior_union_supset[T: TopologicalSpace](s: Set[T], t: Set[T]) {
    interior(s).union(interior(t)).subset(interior(s.union(t)))
}

theorem interior_subset_closure[T: TopologicalSpace](s: Set[T]) {
    interior(s).subset(closure(s))
}

theorem closed_superset_contains_closure[T: TopologicalSpace](s: Set[T], t: Set[T]) {
    is_closed[T](t) and s.subset(t) implies closure(s).subset(t)
}

theorem open_subset_contained_in_interior[T: TopologicalSpace](u: Set[T], s: Set[T]) {
    T.is_open(u) and u.subset(s) implies u.subset(interior(s))
}

theorem frontier_eq_closure_inter_closure_compl[T: TopologicalSpace](s: Set[T]) {
    frontier(s) = closure(s).intersection(closure(s.c))
}

theorem frontier_compl[T: TopologicalSpace](s: Set[T]) {
    frontier(s.c) = frontier(s)
}

theorem continuous_iff_preimage_open[X: TopologicalSpace, Y: TopologicalSpace](f: X -> Y) {
    is_continuous(f) = forall(v: Set[Y]) {
        Y.is_open(v) implies X.is_open(set_preimage(f, v))
    }
}

theorem continuous_compose[X: TopologicalSpace, Y: TopologicalSpace, Z: TopologicalSpace](
    f: X -> Y, g: Y -> Z) {
    is_continuous(f) and is_continuous(g) implies is_continuous(compose(g, f))
}

define intersects[T](s: Set[T], t: Set[T]) -> Bool {
    exists(x: T) {
        s.contains(x) and t.contains(x)
    }
}

define is_homeomorphism[X: TopologicalSpace, Y: TopologicalSpace](f: X -> Y, g: Y -> X) -> Bool {
    is_continuous(f) and is_continuous(g)
        and (forall(x: X) { g(f(x)) = x })
        and (forall(y: Y) { f(g(y)) = y })
}

theorem identity_is_homeomorphism[X: TopologicalSpace] {
    is_homeomorphism[X, X](identity_fn[X], identity_fn[X])
}

theorem is_homeomorphism_iff[X: TopologicalSpace, Y: TopologicalSpace](
    f: X -> Y, g: Y -> X) {
    is_homeomorphism[X, Y](f, g) = (is_continuous(f) and is_continuous(g)
        and (forall(x: X) { g(f(x)) = x })
        and (forall(y: Y) { f(g(y)) = y }))
}

theorem is_homeomorphism_continuous_fwd[X: TopologicalSpace, Y: TopologicalSpace](
    f: X -> Y, g: Y -> X) {
    is_homeomorphism[X, Y](f, g) implies is_continuous(f)
}

theorem is_homeomorphism_continuous_inv[X: TopologicalSpace, Y: TopologicalSpace](
    f: X -> Y, g: Y -> X) {
    is_homeomorphism[X, Y](f, g) implies is_continuous(g)
}

theorem is_homeomorphism_left_inv[X: TopologicalSpace, Y: TopologicalSpace](
    f: X -> Y, g: Y -> X, x: X) {
    is_homeomorphism[X, Y](f, g) implies g(f(x)) = x
}

theorem is_homeomorphism_right_inv[X: TopologicalSpace, Y: TopologicalSpace](
    f: X -> Y, g: Y -> X, y: Y) {
    is_homeomorphism[X, Y](f, g) implies f(g(y)) = y
}

theorem homeomorphism_compose_left_inv[X: TopologicalSpace, Y: TopologicalSpace, Z: TopologicalSpace](
    f1: X -> Y, g1: Y -> X, f2: Y -> Z, g2: Z -> Y, x: X) {
    is_homeomorphism[X, Y](f1, g1) and is_homeomorphism[Y, Z](f2, g2)
        implies compose(g1, g2, compose(f2, f1, x)) = x
}

theorem homeomorphism_compose_right_inv[X: TopologicalSpace, Y: TopologicalSpace, Z: TopologicalSpace](
    f1: X -> Y, g1: Y -> X, f2: Y -> Z, g2: Z -> Y, z: Z) {
    is_homeomorphism[X, Y](f1, g1) and is_homeomorphism[Y, Z](f2, g2)
        implies compose(f2, f1, compose(g1, g2, z)) = z
}

define is_homeomorphic[X: TopologicalSpace, Y: TopologicalSpace](
    witness_x: X, witness_y: Y) -> Bool {
    exists(f: X -> Y, g: Y -> X) {
        is_homeomorphism[X, Y](f, g)
    }
}

define is_t0_space[T](open: Set[T] -> Bool) -> Bool {
    forall(x: T, y: T) {
        x != y implies exists(u: Set[T]) {
            open(u) and ((u.contains(x) and not u.contains(y))
                or (u.contains(y) and not u.contains(x)))
        }
    }
}

define is_t1_space[T](open: Set[T] -> Bool) -> Bool {
    forall(x: T, y: T) {
        x != y implies exists(u: Set[T]) {
            open(u) and u.contains(x) and not u.contains(y)
        }
    }
}

define is_hausdorff[T](open: Set[T] -> Bool) -> Bool {
    forall(x: T, y: T) {
        x != y implies exists(u: Set[T], v: Set[T]) {
            open(u) and open(v) and u.contains(x) and v.contains(y) and u.is_disjoint(v)
        }
    }
}

theorem is_t0_space_iff[T](open: Set[T] -> Bool) {
    is_t0_space[T](open) = forall(x: T, y: T) {
        x != y implies exists(u: Set[T]) {
            open(u) and ((u.contains(x) and not u.contains(y))
                or (u.contains(y) and not u.contains(x)))
        }
    }
}

theorem is_t1_space_iff[T](open: Set[T] -> Bool) {
    is_t1_space[T](open) = forall(x: T, y: T) {
        x != y implies exists(u: Set[T]) {
            open(u) and u.contains(x) and not u.contains(y)
        }
    }
}

theorem is_hausdorff_iff[T](open: Set[T] -> Bool) {
    is_hausdorff[T](open) = forall(x: T, y: T) {
        x != y implies exists(u: Set[T], v: Set[T]) {
            open(u) and open(v) and u.contains(x) and v.contains(y) and u.is_disjoint(v)
        }
    }
}

theorem disjoint_not_both[K](u: Set[K], v: Set[K], y: K) {
    u.is_disjoint(v) implies not (u.contains(y) and v.contains(y))
}

theorem t1_space_inst[T](open: Set[T] -> Bool, x: T, y: T) {
    is_t1_space[T](open) and x != y implies exists(u: Set[T]) {
        open(u) and u.contains(x) and not u.contains(y)
    }
}

theorem hausdorff_inst[T](open: Set[T] -> Bool, x: T, y: T) {
    is_hausdorff[T](open) and x != y implies exists(u: Set[T], v: Set[T]) {
        open(u) and open(v) and u.contains(x) and v.contains(y) and u.is_disjoint(v)
    }
}

theorem t0_witness_of_t1_witness[T](open: Set[T] -> Bool, x: T, y: T, u: Set[T]) {
    open(u) and u.contains(x) and not u.contains(y) implies exists(w: Set[T]) {
        open(w) and ((w.contains(x) and not w.contains(y))
            or (w.contains(y) and not w.contains(x)))
    }
}

theorem t1_witness_of_hausdorff_witness[T](
    open: Set[T] -> Bool, x: T, y: T, u: Set[T], v: Set[T]
) {
    open(u) and u.contains(x) and v.contains(y) and u.is_disjoint(v)
        implies exists(w: Set[T]) {
            open(w) and w.contains(x) and not w.contains(y)
        }
}

theorem t1_imp_t0[T](open: Set[T] -> Bool) {
    is_t1_space[T](open) implies is_t0_space[T](open)
}

theorem hausdorff_imp_t1[T](open: Set[T] -> Bool) {
    is_hausdorff[T](open) implies is_t1_space[T](open)
}

theorem hausdorff_imp_t0[T](open: Set[T] -> Bool) {
    is_hausdorff[T](open) implies is_t0_space[T](open)
}

define is_clopen[T](open: Set[T] -> Bool, s: Set[T]) -> Bool {
    open(s) and open(s.c)
}

theorem is_clopen_iff[T](open: Set[T] -> Bool, s: Set[T]) {
    is_clopen[T](open, s) = (open(s) and open(s.c))
}

theorem clopen_empty[T: TopologicalSpace] {
    is_clopen[T](T.is_open, Set[T].empty_set)
}

theorem clopen_universal[T: TopologicalSpace] {
    is_clopen[T](T.is_open, Set[T].universal_set)
}

theorem is_clopen_intro[T](open: Set[T] -> Bool, s: Set[T]) {
    open(s) and open(s.c) implies is_clopen[T](open, s)
}

theorem is_clopen_imp_open[T](open: Set[T] -> Bool, s: Set[T]) {
    is_clopen[T](open, s) implies open(s) and open(s.c)
}

theorem is_clopen_compl[T: TopologicalSpace](s: Set[T]) {
    is_clopen[T](T.is_open, s) implies is_clopen[T](T.is_open, s.c)
}

theorem is_clopen_inter[T: TopologicalSpace](s: Set[T], t: Set[T]) {
    is_clopen[T](T.is_open, s) and is_clopen[T](T.is_open, t)
        implies is_clopen[T](T.is_open, s.intersection(t))
}

theorem is_clopen_union[T: TopologicalSpace](s: Set[T], t: Set[T]) {
    is_clopen[T](T.is_open, s) and is_clopen[T](T.is_open, t)
        implies is_clopen[T](T.is_open, s.union(t))
}

define is_disconnection[T](open: Set[T] -> Bool, u: Set[T], v: Set[T]) -> Bool {
    open(u) and open(v) and u != Set[T].empty_set and v != Set[T].empty_set
        and u.is_disjoint(v) and u.union(v) = Set[T].universal_set
}

theorem is_disconnection_iff[T](open: Set[T] -> Bool, u: Set[T], v: Set[T]) {
    is_disconnection[T](open, u, v) = (open(u) and open(v)
        and u != Set[T].empty_set and v != Set[T].empty_set
        and u.is_disjoint(v) and u.union(v) = Set[T].universal_set)
}

theorem is_disconnection_intro[T](open: Set[T] -> Bool, u: Set[T], v: Set[T]) {
    open(u) and open(v) and u != Set[T].empty_set and v != Set[T].empty_set
        and u.is_disjoint(v) and u.union(v) = Set[T].universal_set
        implies is_disconnection[T](open, u, v)
}

define is_connected[T](open: Set[T] -> Bool) -> Bool {
    not exists(u: Set[T], v: Set[T]) {
        is_disconnection[T](open, u, v)
    }
}

theorem is_connected_iff[T](open: Set[T] -> Bool) {
    is_connected[T](open) = not exists(u: Set[T], v: Set[T]) {
        is_disconnection[T](open, u, v)
    }
}

define is_connected_via_clopen[T](open: Set[T] -> Bool) -> Bool {
    forall(s: Set[T]) {
        is_clopen[T](open, s) implies (s = Set[T].empty_set or s = Set[T].universal_set)
    }
}

theorem is_connected_via_clopen_iff[T](open: Set[T] -> Bool) {
    is_connected_via_clopen[T](open) = forall(s: Set[T]) {
        is_clopen[T](open, s) implies (s = Set[T].empty_set or s = Set[T].universal_set)
    }
}

define list_union_of_sets[X](items: List[Set[X]]) -> Set[X] {
    match items {
        List.nil {
            Set[X].empty_set
        }
        List.cons(head, tail) {
            head.union(list_union_of_sets(tail))
        }
    }
}

theorem list_union_of_sets_nil[X] {
    list_union_of_sets[X](List.nil[Set[X]]) = Set[X].empty_set
}

theorem list_union_of_sets_cons[X](head: Set[X], tail: List[Set[X]]) {
    list_union_of_sets[X](List.cons(head, tail)) = head.union(list_union_of_sets[X](tail))
}

define list_inter_of_sets[X](items: List[Set[X]]) -> Set[X] {
    match items {
        List.nil {
            Set[X].universal_set
        }
        List.cons(head, tail) {
            head.intersection(list_inter_of_sets(tail))
        }
    }
}

theorem list_inter_of_sets_nil[X] {
    list_inter_of_sets[X](List.nil[Set[X]]) = Set[X].universal_set
}

theorem list_inter_of_sets_cons[X](head: Set[X], tail: List[Set[X]]) {
    list_inter_of_sets[X](List.cons(head, tail)) = head.intersection(list_inter_of_sets[X](tail))
}

define is_open_cover[T: TopologicalSpace](c: Set[T] -> Bool, s: Set[T]) -> Bool {
    (forall(u: Set[T]) { c(u) implies T.is_open(u) }) and s.subset(big_union(c))
}

define is_subfamily[X](c: Set[X] -> Bool, items: List[Set[X]]) -> Bool {
    match items {
        List.nil {
            true
        }
        List.cons(head, tail) {
            c(head) and is_subfamily(c, tail)
        }
    }
}

theorem is_subfamily_nil[X](c: Set[X] -> Bool) {
    is_subfamily[X](c, List.nil[Set[X]])
}

theorem is_subfamily_cons_mp[X](c: Set[X] -> Bool, head: Set[X], tail: List[Set[X]]) {
    is_subfamily[X](c, List.cons(head, tail)) implies (c(head) and is_subfamily[X](c, tail))
}

theorem is_subfamily_cons_mpr[X](c: Set[X] -> Bool, head: Set[X], tail: List[Set[X]]) {
    (c(head) and is_subfamily[X](c, tail)) implies is_subfamily[X](c, List.cons(head, tail))
}

theorem is_open_cover_iff[T: TopologicalSpace](c: Set[T] -> Bool, s: Set[T]) {
    is_open_cover[T](c, s) = ((forall(u: Set[T]) { c(u) implies T.is_open(u) }) and s.subset(big_union(c)))
}

define is_compact[T: TopologicalSpace](s: Set[T]) -> Bool {
    forall(c: Set[T] -> Bool) {
        is_open_cover[T](c, s) implies exists(items: List[Set[T]]) {
            is_subfamily[T](c, items) and s.subset(list_union_of_sets(items))
        }
    }
}

theorem is_compact_iff[T: TopologicalSpace](s: Set[T]) {
    is_compact[T](s) = forall(c: Set[T] -> Bool) {
        is_open_cover[T](c, s) implies exists(items: List[Set[T]]) {
            is_subfamily[T](c, items) and s.subset(list_union_of_sets[T](items))
        }
    }
}

theorem empty_set_is_compact[T: TopologicalSpace] {
    is_compact[T](Set[T].empty_set)
}

theorem singleton_subcover_witness[T: TopologicalSpace](c: Set[T] -> Bool, x: T) {
    big_union(c).contains(x) implies exists(items: List[Set[T]]) {
        is_subfamily[T](c, items) and Set[T].singleton(x).subset(list_union_of_sets[T](items))
    }
}

theorem singleton_cover_imp_big_union[T: TopologicalSpace](c: Set[T] -> Bool, x: T) {
    is_open_cover[T](c, Set[T].singleton(x)) implies big_union(c).contains(x)
}

theorem singleton_open_cover_imp_finite_subcover[T: TopologicalSpace](
    c: Set[T] -> Bool, x: T) {
    is_open_cover[T](c, Set[T].singleton(x)) implies exists(items: List[Set[T]]) {
        is_subfamily[T](c, items) and Set[T].singleton(x).subset(list_union_of_sets[T](items))
    }
}

theorem singleton_is_compact[T: TopologicalSpace](x: T) {
    is_compact[T](Set[T].singleton(x))
}

define is_dense[T: TopologicalSpace](s: Set[T]) -> Bool {
    closure(s) = Set[T].universal_set
}

theorem dense_intro[T: TopologicalSpace](s: Set[T]) {
    (forall(x: T) { closure(s).contains(x) }) implies is_dense[T](s)
}

theorem dense_closure_contains[T: TopologicalSpace](s: Set[T], x: T) {
    is_dense[T](s) implies closure(s).contains(x)
}

theorem universal_set_is_dense[T: TopologicalSpace] {
    is_dense[T](Set[T].universal_set)
}

theorem dense_of_subset[T: TopologicalSpace](s: Set[T], t: Set[T]) {
    s.subset(t) and is_dense[T](s) implies is_dense[T](t)
}

theorem dense_closure_eq_dense[T: TopologicalSpace](s: Set[T]) {
    is_dense[T](closure(s)) = is_dense[T](s)
}

theorem closure_of_dense_is_dense[T: TopologicalSpace](s: Set[T]) {
    is_dense[T](s) implies is_dense[T](closure(s))
}

theorem dense_union_left[T: TopologicalSpace](s: Set[T], t: Set[T]) {
    is_dense[T](s) implies is_dense[T](s.union(t))
}

theorem dense_union_right[T: TopologicalSpace](s: Set[T], t: Set[T]) {
    is_dense[T](t) implies is_dense[T](s.union(t))
}

define is_nowhere_dense_interior_empty[T: TopologicalSpace](s: Set[T]) -> Bool {
    interior(s) = Set[T].empty_set
}

define is_adherent_point[T: TopologicalSpace](x: T, s: Set[T]) -> Bool {
    closure(s).contains(x)
}

define basis_covers[T](b: Set[T] -> Bool) -> Bool {
    forall(x: T) {
        exists(u: Set[T]) {
            b(u) and u.contains(x)
        }
    }
}

define basis_filters[T](b: Set[T] -> Bool) -> Bool {
    forall(u: Set[T], v: Set[T], x: T) {
        b(u) and b(v) and u.contains(x) and v.contains(x) implies exists(w: Set[T]) {
            b(w) and w.contains(x) and w.subset(u.intersection(v))
        }
    }
}

define is_topological_basis[T](b: Set[T] -> Bool) -> Bool {
    basis_covers(b) and basis_filters(b)
}

define generated_open[T](b: Set[T] -> Bool, s: Set[T]) -> Bool {
    forall(x: T) {
        s.contains(x) implies exists(u: Set[T]) {
            b(u) and u.contains(x) and u.subset(s)
        }
    }
}

theorem generated_open_empty[T](b: Set[T] -> Bool) {
    generated_open(b, Set[T].empty_set)
}

theorem generated_open_universal[T](b: Set[T] -> Bool) {
    basis_covers(b) implies generated_open(b, Set[T].universal_set)
}

theorem basis_member_is_open[T](b: Set[T] -> Bool, u: Set[T]) {
    b(u) implies generated_open(b, u)
}

theorem generated_open_inter[T](b: Set[T] -> Bool, s: Set[T], t: Set[T]) {
    is_topological_basis(b) and generated_open(b, s) and generated_open(b, t)
        implies generated_open(b, s.intersection(t))
}

theorem generated_open_big_union[T](b: Set[T] -> Bool, c: Set[T] -> Bool) {
    (forall(s: Set[T]) { c(s) implies generated_open(b, s) })
        implies generated_open(b, big_union(c))
}

define basis_subset_family[T](b: Set[T] -> Bool, s: Set[T], u: Set[T]) -> Bool {
    b(u) and u.subset(s)
}

theorem generated_open_witness[T](b: Set[T] -> Bool, s: Set[T], x: T) {
    generated_open(b, s) and s.contains(x) implies exists(u: Set[T]) {
        b(u) and u.contains(x) and u.subset(s)
    }
}

theorem basis_subset_family_member[T](b: Set[T] -> Bool, s: Set[T], u: Set[T]) {
    b(u) and u.subset(s) implies basis_subset_family(b, s)(u)
}

theorem basis_subset_family_member_imp[T](b: Set[T] -> Bool, s: Set[T], u: Set[T]) {
    basis_subset_family(b, s)(u) implies b(u) and u.subset(s)
}

theorem big_union_basis_subset_of_witness[T](b: Set[T] -> Bool, s: Set[T], u: Set[T], x: T) {
    b(u) and u.subset(s) and u.contains(x)
        implies big_union(basis_subset_family(b, s)).contains(x)
}

theorem generated_open_subset_imp_big_union_basis_subset[T](b: Set[T] -> Bool, s: Set[T], x: T) {
    generated_open(b, s) and s.contains(x)
        implies big_union(basis_subset_family(b, s)).contains(x)
}

theorem big_union_basis_subset_subset[T](b: Set[T] -> Bool, s: Set[T], x: T) {
    big_union(basis_subset_family(b, s)).contains(x) implies s.contains(x)
}

theorem generated_open_basis_subset_pointwise[T](b: Set[T] -> Bool, s: Set[T], x: T) {
    generated_open(b, s) implies s.contains(x) = big_union(basis_subset_family(b, s)).contains(x)
}

theorem generated_open_eq_big_union_basis_subset[T](b: Set[T] -> Bool, s: Set[T]) {
    generated_open(b, s) implies s = big_union(basis_subset_family(b, s))
}

theorem big_union_basis_subfamily_generated_open[T](b: Set[T] -> Bool, c: Set[T] -> Bool) {
    (forall(u: Set[T]) { c(u) implies b(u) })
        implies generated_open(b, big_union(c))
}

theorem generated_open_iff_union_of_basis[T](b: Set[T] -> Bool, s: Set[T]) {
    generated_open(b, s) = exists(c: Set[T] -> Bool) {
        (forall(u: Set[T]) { c(u) implies b(u) }) and s = big_union(c)
    }
}

inductive TopoExample {
    /// First sample point.
    a

    /// Second sample point.
    b
}

define topo_example_open(s: Set[TopoExample]) -> Bool {
    true
}

instance TopoExample: TopologicalSpace {
    let is_open: Set[TopoExample] -> Bool = topo_example_open
}

define is_neighborhood[T: TopologicalSpace](n: Set[T], x: T) -> Bool {
    exists(u: Set[T]) {
        T.is_open(u) and u.contains(x) and u.subset(n)
    }
}

theorem neighborhood_contains_point[T: TopologicalSpace](n: Set[T], x: T) {
    is_neighborhood(n, x) implies n.contains(x)
}

theorem universal_is_neighborhood[T: TopologicalSpace](x: T) {
    is_neighborhood(Set[T].universal_set, x)
}

theorem open_is_neighborhood[T: TopologicalSpace](u: Set[T], x: T) {
    T.is_open(u) and u.contains(x) implies is_neighborhood(u, x)
}

theorem neighborhood_superset[T: TopologicalSpace](n: Set[T], m: Set[T], x: T) {
    is_neighborhood(n, x) and n.subset(m) implies is_neighborhood(m, x)
}

theorem neighborhood_inter[T: TopologicalSpace](n: Set[T], m: Set[T], x: T) {
    is_neighborhood(n, x) and is_neighborhood(m, x)
        implies is_neighborhood(n.intersection(m), x)
}

theorem interior_iff_neighborhood[T: TopologicalSpace](s: Set[T], x: T) {
    interior(s).contains(x) = is_neighborhood(s, x)
}

theorem open_iff_neighborhood_of_each_point[T: TopologicalSpace](s: Set[T]) {
    T.is_open(s) = forall(x: T) {
        s.contains(x) implies is_neighborhood(s, x)
    }
}

theorem closure_iff_every_neighborhood_meets[T: TopologicalSpace](s: Set[T], x: T) {
    closure(s).contains(x) = forall(n: Set[T]) {
        is_neighborhood(n, x) implies exists(y: T) {
            n.contains(y) and s.contains(y)
        }
    }
}

define is_limit_point[T: TopologicalSpace](x: T, s: Set[T]) -> Bool {
    forall(n: Set[T]) {
        is_neighborhood(n, x) implies exists(y: T) {
            n.contains(y) and s.contains(y) and y != x
        }
    }
}

define is_isolated_point[T: TopologicalSpace](x: T, s: Set[T]) -> Bool {
    s.contains(x) and exists(n: Set[T]) {
        is_neighborhood(n, x) and forall(y: T) {
            n.contains(y) and s.contains(y) implies y = x
        }
    }
}

define is_continuous_at[X: TopologicalSpace, Y: TopologicalSpace](f: X -> Y, x: X) -> Bool {
    forall(v: Set[Y]) {
        is_neighborhood(v, f(x)) implies is_neighborhood(set_preimage(f, v), x)
    }
}

theorem pointwise_continuous_preimage_neighborhood[X: TopologicalSpace, Y: TopologicalSpace](
    f: X -> Y, v: Set[Y], x: X) {
    (forall(y: X) { is_continuous_at[X, Y](f, y) })
        and Y.is_open(v) and set_preimage(f, v).contains(x)
        implies is_neighborhood(set_preimage(f, v), x)
}

theorem continuous_imp_continuous_at[X: TopologicalSpace, Y: TopologicalSpace](
    f: X -> Y, x: X) {
    is_continuous(f) implies is_continuous_at[X, Y](f, x)
}

theorem continuous_at_imp_continuous[X: TopologicalSpace, Y: TopologicalSpace](
    f: X -> Y) {
    (forall(x: X) { is_continuous_at[X, Y](f, x) }) implies is_continuous(f)
}

theorem continuous_iff_continuous_at[X: TopologicalSpace, Y: TopologicalSpace](
    f: X -> Y) {
    is_continuous(f) = forall(x: X) { is_continuous_at[X, Y](f, x) }
}

define has_compact_neighborhood[T: TopologicalSpace](x: T) -> Bool {
    exists(n: Set[T]) {
        is_neighborhood(n, x) and is_compact[T](n)
    }
}

theorem universal_compact_imp_has_compact_neighborhood[T: TopologicalSpace](x: T) {
    is_compact[T](Set[T].universal_set) implies has_compact_neighborhood[T](x)
}

define neighborhood_filter[T: TopologicalSpace](x: T, n: Set[T]) -> Bool {
    is_neighborhood(n, x)
}

theorem neighborhood_filter_iff[T: TopologicalSpace](x: T, n: Set[T]) {
    neighborhood_filter(x, n) = is_neighborhood(n, x)
}

theorem neighborhood_filter_universal[T: TopologicalSpace](x: T) {
    neighborhood_filter(x, Set[T].universal_set)
}

theorem neighborhood_filter_upward_closed[T: TopologicalSpace](x: T, n: Set[T], m: Set[T]) {
    neighborhood_filter(x, n) and n.subset(m) implies neighborhood_filter(x, m)
}

theorem neighborhood_filter_inter[T: TopologicalSpace](x: T, n: Set[T], m: Set[T]) {
    is_neighborhood(n, x) and is_neighborhood(m, x)
        implies neighborhood_filter(x, n.intersection(m))
}

theorem neighborhood_filter_contains_point[T: TopologicalSpace](x: T, n: Set[T]) {
    neighborhood_filter(x, n) implies n.contains(x)
}

theorem neighborhood_filter_excludes_empty[T: TopologicalSpace](x: T) {
    not neighborhood_filter(x, Set[T].empty_set)
}

theorem neighborhood_filter_open_member[T: TopologicalSpace](x: T, u: Set[T]) {
    T.is_open(u) and u.contains(x) implies neighborhood_filter(x, u)
}

theorem open_iff_in_neighborhood_filter_of_each_point[T: TopologicalSpace](s: Set[T]) {
    T.is_open(s) = forall(x: T) {
        s.contains(x) implies neighborhood_filter(x, s)
    }
}

theorem interior_iff_in_neighborhood_filter[T: TopologicalSpace](s: Set[T], x: T) {
    interior(s).contains(x) = neighborhood_filter(x, s)
}

theorem closure_iff_every_filter_member_meets[T: TopologicalSpace](s: Set[T], x: T) {
    closure(s).contains(x) = forall(n: Set[T]) {
        neighborhood_filter(x, n) implies exists(y: T) {
            n.contains(y) and s.contains(y)
        }
    }
}

theorem closure_iff_adherent[T: TopologicalSpace](s: Set[T], x: T) {
    closure(s).contains(x) = is_adherent_point[T](x, s)
}

theorem in_set_imp_adherent[T: TopologicalSpace](s: Set[T], x: T) {
    s.contains(x) implies is_adherent_point[T](x, s)
}

theorem limit_point_imp_every_neighborhood_meets[T: TopologicalSpace](s: Set[T], x: T) {
    is_limit_point[T](x, s) implies forall(n: Set[T]) {
        is_neighborhood(n, x) implies exists(y: T) {
            n.contains(y) and s.contains(y)
        }
    }
}

theorem limit_point_imp_adherent[T: TopologicalSpace](s: Set[T], x: T) {
    is_limit_point[T](x, s) implies is_adherent_point[T](x, s)
}

theorem adherent_not_in_set_imp_limit_point[T: TopologicalSpace](s: Set[T], x: T) {
    is_adherent_point[T](x, s) and not s.contains(x) implies is_limit_point[T](x, s)
}
