    is_homeomorphism[X, Y](f, g) and is_hausdorff[X](X.is_open)
        implies is_hausdorff[Y](Y.is_open)
}

theorem homeomorphism_reflects_hausdorff[X: TopologicalSpace, Y: TopologicalSpace](
