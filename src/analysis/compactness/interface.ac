define box[X, Y](u: Set[X], v: Set[Y]) -> Set[Pair[X, Y]] {
    Set[Pair[X, Y]].new(box_contains(u, v))
}

theorem box_intersection_eq[X, Y](u: Set[X], v: Set[Y], u2: Set[X], v2: Set[Y]) {
    box(u, v).intersection(box(u2, v2)) = box(u.intersection(u2), v.intersection(v2))
}

theorem box_inter[X, Y](
    u1: Set[X], v1: Set[Y], u2: Set[X], v2: Set[Y]) {
    box(u1, v1).intersection(box(u2, v2)) = box(u1.intersection(u2), v1.intersection(v2))
}

theorem fan_out_preimage_box[Z, X, Y](
    f: Z -> X, g: Z -> Y, u: Set[X], v: Set[Y]) {
    set_preimage(fan_out[Z, X, Y](f, g), box(u, v))
        = set_preimage(f, u).intersection(set_preimage(g, v))
}

theorem fan_out_preimage_box_open[Z: TopologicalSpace, X: TopologicalSpace, Y: TopologicalSpace](
    f: Z -> X, g: Z -> Y, u: Set[X], v: Set[Y]) {
    is_continuous(f) and is_continuous(g) and X.is_open(u) and Y.is_open(v)
        implies Z.is_open(set_preimage(fan_out[Z, X, Y](f, g), box(u, v)))
}

theorem pair_map_preimage_box[X, Y, Z, W](
    f: X -> Z, g: Y -> W, u: Set[Z], v: Set[W]) {
    set_preimage(pair_map[X, Y, Z, W](f, g), box(u, v))
        = box(set_preimage(f, u), set_preimage(g, v))
}

define is_box[X: TopologicalSpace, Y: TopologicalSpace](b: Set[Pair[X, Y]]) -> Bool {
    exists(u: Set[X], v: Set[Y]) {
        X.is_open(u) and Y.is_open(v) and b = box(u, v)
    }
}

theorem is_box_covers[X: TopologicalSpace, Y: TopologicalSpace] {
    basis_covers(is_box[X, Y])
}

theorem is_box_filters[X: TopologicalSpace, Y: TopologicalSpace] {
    basis_filters(is_box[X, Y])
}

theorem is_box_is_topological_basis[X: TopologicalSpace, Y: TopologicalSpace] {
    is_topological_basis(is_box[X, Y])
}

theorem box_is_box[X: TopologicalSpace, Y: TopologicalSpace](u: Set[X], v: Set[Y]) {
    X.is_open(u) and Y.is_open(v) implies is_box[X, Y](box(u, v))
}

theorem box_generated_open[X: TopologicalSpace, Y: TopologicalSpace](
    u: Set[X], v: Set[Y]) {
    X.is_open(u) and Y.is_open(v) implies generated_open(is_box[X, Y], box(u, v))
}

define is_open_in_product[X: TopologicalSpace, Y: TopologicalSpace](
    s: Set[Pair[X, Y]]) -> Bool {
    generated_open(is_box[X, Y], s)
}

instance Pair[X: TopologicalSpace, Y: TopologicalSpace]: TopologicalSpace {
    let is_open: Set[Pair[X, Y]] -> Bool = is_open_in_product[X, Y]
}

define pair_distance[M: MetricSpace, N: MetricSpace](p: Pair[M, N], q: Pair[M, N]) -> Real {
    (p.first.distance(q.first)).max(p.second.distance(q.second))
}

theorem first_distance_le_pair_distance[M: MetricSpace, N: MetricSpace](p: Pair[M, N], q: Pair[M, N]) {
    p.first.distance(q.first) <= pair_distance(p, q)
}

theorem second_distance_le_pair_distance[M: MetricSpace, N: MetricSpace](p: Pair[M, N], q: Pair[M, N]) {
    p.second.distance(q.second) <= pair_distance(p, q)
}

theorem pair_distance_lt_iff_components_lt[M: MetricSpace, N: MetricSpace](p: Pair[M, N], q: Pair[M, N], r: Real) {
    pair_distance(p, q) < r = (p.first.distance(q.first) < r and p.second.distance(q.second) < r)
}

theorem pair_distance_le_iff_components_le[M: MetricSpace, N: MetricSpace](p: Pair[M, N], q: Pair[M, N], r: Real) {
    pair_distance(p, q) <= r = (p.first.distance(q.first) <= r and p.second.distance(q.second) <= r)
}

theorem pair_distance_lt_imp_first_distance_lt[M: MetricSpace, N: MetricSpace](p: Pair[M, N], q: Pair[M, N], r: Real) {
    pair_distance(p, q) < r implies p.first.distance(q.first) < r
}

theorem pair_distance_lt_imp_second_distance_lt[M: MetricSpace, N: MetricSpace](p: Pair[M, N], q: Pair[M, N], r: Real) {
    pair_distance(p, q) < r implies p.second.distance(q.second) < r
}

theorem pair_distance_lt_of_components_lt[M: MetricSpace, N: MetricSpace](p: Pair[M, N], q: Pair[M, N], r: Real) {
    p.first.distance(q.first) < r and p.second.distance(q.second) < r implies pair_distance(p, q) < r
}

theorem pair_distance_le_imp_first_distance_le[M: MetricSpace, N: MetricSpace](p: Pair[M, N], q: Pair[M, N], r: Real) {
    pair_distance(p, q) <= r implies p.first.distance(q.first) <= r
}

theorem pair_distance_le_imp_second_distance_le[M: MetricSpace, N: MetricSpace](p: Pair[M, N], q: Pair[M, N], r: Real) {
    pair_distance(p, q) <= r implies p.second.distance(q.second) <= r
}

theorem pair_distance_le_of_components_le[M: MetricSpace, N: MetricSpace](p: Pair[M, N], q: Pair[M, N], r: Real) {
    p.first.distance(q.first) <= r and p.second.distance(q.second) <= r implies pair_distance(p, q) <= r
}

theorem pair_distance_self[M: MetricSpace, N: MetricSpace](p: Pair[M, N]) {
    pair_distance(p, p) = 0
}

theorem pair_distance_symmetric[M: MetricSpace, N: MetricSpace](p: Pair[M, N], q: Pair[M, N]) {
    pair_distance(p, q) = pair_distance(q, p)
}

theorem pair_distance_swap[M: MetricSpace, N: MetricSpace](p: Pair[M, N], q: Pair[M, N]) {
    pair_distance(p.swap, q.swap) = pair_distance(p, q)
}

theorem pair_distance_pair_map_le_of_component_bounds[M: MetricSpace, N: MetricSpace, P: MetricSpace, Q: MetricSpace](
    f: M -> P,
    g: N -> Q,
    p: Pair[M, N],
    q: Pair[M, N],
    r: Real
) {
    f(p.first).distance(f(q.first)) <= r and g(p.second).distance(g(q.second)) <= r implies
        pair_distance(pair_map(f, g, p), pair_map(f, g, q)) <= r
}

theorem pair_distance_pair_map_le_of_components_nonexpansive[M: MetricSpace, N: MetricSpace, P: MetricSpace, Q: MetricSpace](
    f: M -> P,
    g: N -> Q,
    p: Pair[M, N],
    q: Pair[M, N]
) {
    pair_map_components_nonexpansive(f, g) implies
        pair_distance(pair_map(f, g, p), pair_map(f, g, q)) <= pair_distance(p, q)
}

theorem pair_distance_zero_imp_eq[M: MetricSpace, N: MetricSpace](p: Pair[M, N], q: Pair[M, N]) {
    pair_distance(p, q) = 0 implies p = q
}

theorem pair_distance_triangle[M: MetricSpace, N: MetricSpace](p: Pair[M, N], q: Pair[M, N], r: Pair[M, N]) {
    pair_distance(p, r) <= pair_distance(p, q) + pair_distance(q, r)
}

define covers_nat(system: List[Pair[Nat, Nat]]) -> (Nat -> Bool) {
    match system {
        List.nil {
            none_pred
        }
        List.cons(head, tail) {
            or_pred(in_residue_class(head.first, head.second), covers_nat(tail))
        }
    }
}

define system_density_real(system: List[Pair[Nat, Nat]]) -> Real {
    match system {
        List.nil {
            Real.0
        }
        List.cons(head, tail) {
            Real.1 / from_nat[Real](head.first) + system_density_real(tail)
        }
    }
}

define system_reduced(system: List[Pair[Nat, Nat]]) -> Bool {
    forall(cl: Pair[Nat, Nat]) {
        system.contains(cl) implies cl.second < cl.first
    }
}

theorem covers_nat_cons(head: Pair[Nat, Nat], tail: List[Pair[Nat, Nat]]) {
    covers_nat(List.cons(head, tail))
        = or_pred(in_residue_class(head.first, head.second), covers_nat(tail))
}

theorem covers_nat_nil {
    covers_nat(List.nil[Pair[Nat, Nat]]) = none_pred
}

theorem system_density_real_cons(head: Pair[Nat, Nat], tail: List[Pair[Nat, Nat]]) {
    system_density_real(List.cons(head, tail))
        = Real.1 / from_nat[Real](head.first) + system_density_real(tail)
}

theorem system_density_real_nil {
    system_density_real(List.nil[Pair[Nat, Nat]]) = Real.0
}

theorem system_reduced_head(head: Pair[Nat, Nat], tail: List[Pair[Nat, Nat]]) {
    system_reduced(List.cons(head, tail)) implies head.second < head.first
}

theorem system_reduced_tail(head: Pair[Nat, Nat], tail: List[Pair[Nat, Nat]]) {
    system_reduced(List.cons(head, tail)) implies system_reduced(tail)
}

theorem upper_density_covers_nat_le(system: List[Pair[Nat, Nat]]) {
    system_reduced(system)
        implies upper_density(covers_nat(system)) <= system_density_real(system)
}

define head_disjoint_nat(head: Pair[Nat, Nat], rest: List[Pair[Nat, Nat]]) -> Bool {
    disjoint_pred(in_residue_class(head.first, head.second), covers_nat(rest))
}

theorem disjoint_cons_bound(head: Pair[Nat, Nat], tail: List[Pair[Nat, Nat]]) {
    head.second < head.first and head_disjoint_nat(head, tail)
        and system_density_real(tail) <= lower_density(covers_nat(tail))
        implies system_density_real(List.cons(head, tail))
            <= lower_density(covers_nat(List.cons(head, tail)))
}

define is_suffix_of(part: List[Pair[Nat, Nat]], whole: List[Pair[Nat, Nat]]) -> Bool {
    exists(front: List[Pair[Nat, Nat]]) {
        front + part = whole
    }
}

theorem is_suffix_of_refl(whole: List[Pair[Nat, Nat]]) {
    is_suffix_of(whole, whole)
}

theorem is_suffix_of_cons(part: List[Pair[Nat, Nat]], head: Pair[Nat, Nat],
    tail: List[Pair[Nat, Nat]]) {
    is_suffix_of(part, tail) implies is_suffix_of(part, List.cons(head, tail))
}

define system_disjoint_nat(system: List[Pair[Nat, Nat]]) -> Bool {
    forall(head: Pair[Nat, Nat], tail: List[Pair[Nat, Nat]]) {
        is_suffix_of(List.cons(head, tail), system) implies head_disjoint_nat(head, tail)
    }
}

theorem system_disjoint_nat_head(head: Pair[Nat, Nat], tail: List[Pair[Nat, Nat]]) {
    system_disjoint_nat(List.cons(head, tail)) implies head_disjoint_nat(head, tail)
}

theorem system_disjoint_nat_tail(head: Pair[Nat, Nat], tail: List[Pair[Nat, Nat]]) {
    system_disjoint_nat(List.cons(head, tail)) implies system_disjoint_nat(tail)
}

theorem system_density_real_le_lower_density(system: List[Pair[Nat, Nat]]) {
    system_reduced(system) and system_disjoint_nat(system)
        implies system_density_real(system) <= lower_density(covers_nat(system))
}

theorem disjoint_system_density_le_one(system: List[Pair[Nat, Nat]]) {
    system_reduced(system) and system_disjoint_nat(system)
        implies system_density_real(system) <= Real.1
}

define box_contains[X, Y](u: Set[X], v: Set[Y], p: Pair[X, Y]) -> Bool {
    u.contains(p.first) and v.contains(p.second)
}

theorem box_contains_eq[X, Y](u: Set[X], v: Set[Y], p: Pair[X, Y]) {
    box(u, v).contains(p) = (u.contains(p.first) and v.contains(p.second))
}

theorem universal_pair_is_box[X: TopologicalSpace, Y: TopologicalSpace] {
    is_box[X, Y](Set[Pair[X, Y]].universal_set)
}

theorem box_inter_is_box[X: TopologicalSpace, Y: TopologicalSpace](
    b1: Set[Pair[X, Y]], b2: Set[Pair[X, Y]]) {
    is_box[X, Y](b1) and is_box[X, Y](b2) implies is_box[X, Y](b1.intersection(b2))
}

theorem box_inter_is_box_with_point[X: TopologicalSpace, Y: TopologicalSpace](
    b1: Set[Pair[X, Y]], b2: Set[Pair[X, Y]], p: Pair[X, Y]) {
    is_box[X, Y](b1) and is_box[X, Y](b2) and b1.contains(p) and b2.contains(p)
        implies is_box[X, Y](b1.intersection(b2)) and b1.intersection(b2).contains(p)
}

theorem is_box_filters_at[X: TopologicalSpace, Y: TopologicalSpace](
    b1: Set[Pair[X, Y]], b2: Set[Pair[X, Y]], p: Pair[X, Y]) {
    is_box[X, Y](b1) and is_box[X, Y](b2) and b1.contains(p) and b2.contains(p)
        implies exists(w: Set[Pair[X, Y]]) {
            is_box[X, Y](w) and w.contains(p) and w.subset(b1.intersection(b2))
        }
}

theorem is_open_in_product_iff[X: TopologicalSpace, Y: TopologicalSpace](
    s: Set[Pair[X, Y]]) {
    is_open_in_product[X, Y](s) = generated_open(is_box[X, Y], s)
}

theorem is_open_in_product_imp_generated_open[X: TopologicalSpace, Y: TopologicalSpace](
    s: Set[Pair[X, Y]]) {
    is_open_in_product[X, Y](s) implies generated_open(is_box[X, Y], s)
}

theorem generated_open_imp_is_open_in_product[X: TopologicalSpace, Y: TopologicalSpace](
    s: Set[Pair[X, Y]]) {
    generated_open(is_box[X, Y], s) implies is_open_in_product[X, Y](s)
}

theorem product_open_empty[X: TopologicalSpace, Y: TopologicalSpace] {
    is_open_in_product[X, Y](Set[Pair[X, Y]].empty_set)
}

theorem product_open_universal[X: TopologicalSpace, Y: TopologicalSpace] {
    is_open_in_product[X, Y](Set[Pair[X, Y]].universal_set)
}

theorem box_empty_left[X, Y](v: Set[Y]) {
    box(Set[X].empty_set, v) = Set[Pair[X, Y]].empty_set
}

theorem box_empty_right[X, Y](u: Set[X]) {
    box(u, Set[Y].empty_set) = Set[Pair[X, Y]].empty_set
}

theorem box_is_open_in_product[X: TopologicalSpace, Y: TopologicalSpace](
    u: Set[X], v: Set[Y]) {
    X.is_open(u) and Y.is_open(v) implies is_open_in_product[X, Y](box(u, v))
}

theorem product_open_inter[X: TopologicalSpace, Y: TopologicalSpace](
    s: Set[Pair[X, Y]], t: Set[Pair[X, Y]]) {
    is_open_in_product[X, Y](s) and is_open_in_product[X, Y](t)
        implies is_open_in_product[X, Y](s.intersection(t))
}

theorem product_open_big_union[X: TopologicalSpace, Y: TopologicalSpace](
    c: Set[Pair[X, Y]] -> Bool) {
    (forall(s: Set[Pair[X, Y]]) { c(s) implies is_open_in_product[X, Y](s) })
        implies is_open_in_product[X, Y](big_union(c))
}

theorem pair_is_open_eq[X: TopologicalSpace, Y: TopologicalSpace](
    s: Set[Pair[X, Y]]) {
    Pair[X, Y].is_open(s) = is_open_in_product[X, Y](s)
}

theorem box_open[X: TopologicalSpace, Y: TopologicalSpace](u: Set[X], v: Set[Y]) {
    X.is_open(u) and Y.is_open(v) implies Pair[X, Y].is_open(box(u, v))
}

define pair_fst[X, Y](p: Pair[X, Y]) -> X {
    p.first
}

define pair_snd[X, Y](p: Pair[X, Y]) -> Y {
    p.second
}

theorem pair_fst_preimage_eq[X, Y](u: Set[X]) {
    set_preimage(pair_fst[X, Y], u) = box(u, Set[Y].universal_set)
}

theorem pair_snd_preimage_eq[X, Y](v: Set[Y]) {
    set_preimage(pair_snd[X, Y], v) = box(Set[X].universal_set, v)
}

theorem box_eq_inter_preimages[X, Y](u: Set[X], v: Set[Y]) {
    box(u, v) = set_preimage(pair_fst[X, Y], u).intersection(set_preimage(pair_snd[X, Y], v))
}

theorem pair_fst_continuous[X: TopologicalSpace, Y: TopologicalSpace] {
    is_continuous(pair_fst[X, Y])
}

theorem pair_snd_continuous[X: TopologicalSpace, Y: TopologicalSpace] {
    is_continuous(pair_snd[X, Y])
}

theorem pair_fst_compose_fan_out[Z, X, Y](f: Z -> X, g: Z -> Y) {
    compose(pair_fst[X, Y], fan_out[Z, X, Y](f, g)) = f
}

theorem pair_snd_compose_fan_out[Z, X, Y](f: Z -> X, g: Z -> Y) {
    compose(pair_snd[X, Y], fan_out[Z, X, Y](f, g)) = g
}

theorem pair_map_preimage_box_open[X: TopologicalSpace, Y: TopologicalSpace, Z: TopologicalSpace, W: TopologicalSpace](
    f: X -> Z, g: Y -> W, u: Set[Z], v: Set[W]) {
    is_continuous(f) and is_continuous(g) and Z.is_open(u) and W.is_open(v)
        implies Pair[X, Y].is_open(set_preimage(pair_map[X, Y, Z, W](f, g), box(u, v)))
}

theorem pair_map_preimage_product_open_neighborhood[X: TopologicalSpace, Y: TopologicalSpace, Z: TopologicalSpace, W: TopologicalSpace](
    f: X -> Z, g: Y -> W, s: Set[Pair[Z, W]], p: Pair[X, Y]
) {
    is_continuous(f) and is_continuous(g)
    and Pair[Z, W].is_open(s)
    and set_preimage(pair_map[X, Y, Z, W](f, g), s).contains(p)
    implies is_neighborhood(set_preimage(pair_map[X, Y, Z, W](f, g), s), p)
}

theorem pair_map_preimage_product_open[X: TopologicalSpace, Y: TopologicalSpace, Z: TopologicalSpace, W: TopologicalSpace](
    f: X -> Z, g: Y -> W, s: Set[Pair[Z, W]]
) {
    is_continuous(f) and is_continuous(g) and Pair[Z, W].is_open(s)
        implies Pair[X, Y].is_open(set_preimage(pair_map[X, Y, Z, W](f, g), s))
}

define is_open_in_sum[X: TopologicalSpace, Y: TopologicalSpace](w: Set[Sum[X, Y]]) -> Bool {
    X.is_open(sum_left_preimage(w)) and Y.is_open(sum_right_preimage(w))
}

instance Sum[X: TopologicalSpace, Y: TopologicalSpace]: TopologicalSpace {
    let is_open: Set[Sum[X, Y]] -> Bool = is_open_in_sum[X, Y]
}

define sum_left_preimage_contains[T, U](w: Set[Sum[T, U]], x: T) -> Bool {
    w.contains(Sum.inl[T, U](x))
}

define sum_left_preimage[T, U](w: Set[Sum[T, U]]) -> Set[T] {
    Set[T].new(sum_left_preimage_contains(w))
}

define sum_right_preimage_contains[T, U](w: Set[Sum[T, U]], y: U) -> Bool {
    w.contains(Sum.inr[T, U](y))
}

define sum_right_preimage[T, U](w: Set[Sum[T, U]]) -> Set[U] {
    Set[U].new(sum_right_preimage_contains(w))
}

theorem sum_left_preimage_contains_eq[T, U](w: Set[Sum[T, U]], x: T) {
    sum_left_preimage(w).contains(x) = w.contains(Sum.inl[T, U](x))
}

theorem sum_right_preimage_contains_eq[T, U](w: Set[Sum[T, U]], y: U) {
    sum_right_preimage(w).contains(y) = w.contains(Sum.inr[T, U](y))
}

theorem sum_left_preimage_empty[T, U] {
    sum_left_preimage[T, U](Set[Sum[T, U]].empty_set) = Set[T].empty_set
}

theorem sum_right_preimage_empty[T, U] {
    sum_right_preimage[T, U](Set[Sum[T, U]].empty_set) = Set[U].empty_set
}

theorem sum_left_preimage_universal[T, U] {
    sum_left_preimage[T, U](Set[Sum[T, U]].universal_set) = Set[T].universal_set
}

theorem sum_right_preimage_universal[T, U] {
    sum_right_preimage[T, U](Set[Sum[T, U]].universal_set) = Set[U].universal_set
}

theorem sum_left_preimage_inter[T, U](w1: Set[Sum[T, U]], w2: Set[Sum[T, U]]) {
    sum_left_preimage(w1.intersection(w2))
        = sum_left_preimage(w1).intersection(sum_left_preimage(w2))
}

theorem sum_right_preimage_inter[T, U](w1: Set[Sum[T, U]], w2: Set[Sum[T, U]]) {
    sum_right_preimage(w1.intersection(w2))
        = sum_right_preimage(w1).intersection(sum_right_preimage(w2))
}

define sum_left_preimage_family_contains[T, U](c: Set[Sum[T, U]] -> Bool, t: Set[T]) -> Bool {
    exists(s: Set[Sum[T, U]]) {
        c(s) and t = sum_left_preimage(s)
    }
}

define sum_left_preimage_family[T, U](c: Set[Sum[T, U]] -> Bool) -> (Set[T] -> Bool) {
    sum_left_preimage_family_contains(c)
}

define sum_right_preimage_family_contains[T, U](c: Set[Sum[T, U]] -> Bool, t: Set[U]) -> Bool {
    exists(s: Set[Sum[T, U]]) {
        c(s) and t = sum_right_preimage(s)
    }
}

define sum_right_preimage_family[T, U](c: Set[Sum[T, U]] -> Bool) -> (Set[U] -> Bool) {
    sum_right_preimage_family_contains(c)
}

theorem sum_left_preimage_family_eq[T, U](c: Set[Sum[T, U]] -> Bool, t: Set[T]) {
    sum_left_preimage_family(c)(t) = exists(s: Set[Sum[T, U]]) {
        c(s) and t = sum_left_preimage(s)
    }
}

theorem sum_right_preimage_family_eq[T, U](c: Set[Sum[T, U]] -> Bool, t: Set[U]) {
    sum_right_preimage_family(c)(t) = exists(s: Set[Sum[T, U]]) {
        c(s) and t = sum_right_preimage(s)
    }
}

theorem sum_left_preimage_big_union[T, U](c: Set[Sum[T, U]] -> Bool) {
    sum_left_preimage(big_union(c)) = big_union(sum_left_preimage_family(c))
}

theorem sum_right_preimage_big_union[T, U](c: Set[Sum[T, U]] -> Bool) {
    sum_right_preimage(big_union(c)) = big_union(sum_right_preimage_family(c))
}

theorem sum_open_empty[X: TopologicalSpace, Y: TopologicalSpace] {
    is_open_in_sum[X, Y](Set[Sum[X, Y]].empty_set)
}

theorem sum_open_universal[X: TopologicalSpace, Y: TopologicalSpace] {
    is_open_in_sum[X, Y](Set[Sum[X, Y]].universal_set)
}

theorem sum_open_inter_left[X: TopologicalSpace, Y: TopologicalSpace](
    w1: Set[Sum[X, Y]], w2: Set[Sum[X, Y]]) {
    X.is_open(sum_left_preimage(w1)) and X.is_open(sum_left_preimage(w2))
        implies X.is_open(sum_left_preimage(w1.intersection(w2)))
}

theorem sum_open_inter_right[X: TopologicalSpace, Y: TopologicalSpace](
    w1: Set[Sum[X, Y]], w2: Set[Sum[X, Y]]) {
    Y.is_open(sum_right_preimage(w1)) and Y.is_open(sum_right_preimage(w2))
        implies Y.is_open(sum_right_preimage(w1.intersection(w2)))
}

theorem is_open_in_sum_iff[X: TopologicalSpace, Y: TopologicalSpace](w: Set[Sum[X, Y]]) {
    is_open_in_sum[X, Y](w) = (X.is_open(sum_left_preimage(w)) and Y.is_open(sum_right_preimage(w)))
}

theorem is_open_in_sum_intro[X: TopologicalSpace, Y: TopologicalSpace](w: Set[Sum[X, Y]]) {
    X.is_open(sum_left_preimage(w)) and Y.is_open(sum_right_preimage(w))
        implies is_open_in_sum[X, Y](w)
}

theorem is_open_in_sum_left[X: TopologicalSpace, Y: TopologicalSpace](w: Set[Sum[X, Y]]) {
    is_open_in_sum[X, Y](w) implies X.is_open(sum_left_preimage(w))
}

theorem is_open_in_sum_right[X: TopologicalSpace, Y: TopologicalSpace](w: Set[Sum[X, Y]]) {
    is_open_in_sum[X, Y](w) implies Y.is_open(sum_right_preimage(w))
}

theorem is_open_in_sum_both[X: TopologicalSpace, Y: TopologicalSpace](w: Set[Sum[X, Y]]) {
    is_open_in_sum[X, Y](w) implies
        X.is_open(sum_left_preimage(w)) and Y.is_open(sum_right_preimage(w))
}

theorem sum_open_inter[X: TopologicalSpace, Y: TopologicalSpace](
    w1: Set[Sum[X, Y]], w2: Set[Sum[X, Y]]) {
    is_open_in_sum[X, Y](w1) and is_open_in_sum[X, Y](w2)
        implies is_open_in_sum[X, Y](w1.intersection(w2))
}

theorem sum_open_big_union_left[X: TopologicalSpace, Y: TopologicalSpace](
    c: Set[Sum[X, Y]] -> Bool) {
    (forall(s: Set[Sum[X, Y]]) { c(s) implies is_open_in_sum[X, Y](s) })
        implies X.is_open(sum_left_preimage(big_union(c)))
}

theorem sum_open_big_union_right[X: TopologicalSpace, Y: TopologicalSpace](
    c: Set[Sum[X, Y]] -> Bool) {
    (forall(s: Set[Sum[X, Y]]) { c(s) implies is_open_in_sum[X, Y](s) })
        implies Y.is_open(sum_right_preimage(big_union(c)))
}

theorem sum_open_big_union[X: TopologicalSpace, Y: TopologicalSpace](
    c: Set[Sum[X, Y]] -> Bool) {
    (forall(s: Set[Sum[X, Y]]) { c(s) implies is_open_in_sum[X, Y](s) })
        implies is_open_in_sum[X, Y](big_union(c))
}

theorem sum_is_open_eq[X: TopologicalSpace, Y: TopologicalSpace](w: Set[Sum[X, Y]]) {
    Sum[X, Y].is_open(w) = is_open_in_sum[X, Y](w)
}

theorem sum_inl_preimage_eq[X, Y](w: Set[Sum[X, Y]]) {
    set_preimage(sum_inl[X, Y], w) = sum_left_preimage(w)
}

theorem sum_inr_preimage_eq[X, Y](w: Set[Sum[X, Y]]) {
    set_preimage(sum_inr[X, Y], w) = sum_right_preimage(w)
}
