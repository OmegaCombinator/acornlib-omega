    x: Real
) {
    seq_eventually_in_real_set(s, a) and seq_eventually_equal_real(a, b) and is_subsequence_index(f) and
    converges_to(subsequence(b, f), x)
    implies closure(s).contains(x)
}

theorem closed_set_contains_eventually_equal_subsequence_limit(
    s: Set[Real],
    a: Nat -> Real,
    b: Nat -> Real,
    f: Nat -> Nat,
    x: Real
) {
    is_closed_set(s) and seq_eventually_in_real_set(s, a) and seq_eventually_equal_real(a, b) and
    is_subsequence_index(f) and converges_to(subsequence(b, f), x)
    implies s.contains(x)
}

instance Subspace[T: TopologicalSpace, a: Set[T]]: TopologicalSpace {
    let is_open: Set[Subspace[T, a]] -> Bool = subspace_open(a)
}

define subspace_open[T: TopologicalSpace](a: Set[T], u: Set[Subspace[T, a]]) -> Bool {
    exists(v: Set[T]) {
        has_subspace_witness(a, u, v)
    }
}

theorem subspace_open_empty_helper[T: TopologicalSpace](a: Set[T]) {
    subspace_open(a, Set[Subspace[T, a]].empty_set)
}

theorem subspace_open_universal_helper[T: TopologicalSpace](a: Set[T]) {
    subspace_open(a, Set[Subspace[T, a]].universal_set)
}

theorem subspace_open_inter_helper[T: TopologicalSpace](
    a: Set[T], u: Set[Subspace[T, a]], w: Set[Subspace[T, a]]
) {
    subspace_open(a, u) and subspace_open(a, w) implies subspace_open(a, u.intersection(w))
}

theorem subspace_open_big_union_helper[T: TopologicalSpace](
    a: Set[T], fam: Set[Subspace[T, a]] -> Bool
) {
    (forall(s: Set[Subspace[T, a]]) {
        fam(s) implies subspace_open(a, s)
    }) implies subspace_open(a, big_union(fam))
}

theorem subspace_carrier_set_contains[T: TopologicalSpace](
    a: Set[T], u: Set[T], p: Subspace[T, a]
) {
    subspace_carrier_set(a, u).contains(p) = u.contains(p.value)
}

theorem subspace_carrier_set_open_from_ambient[T: TopologicalSpace](a: Set[T], v: Set[T]) {
    T.is_open(v) implies Subspace[T, a].is_open(subspace_carrier_set(a, v))
}

theorem subspace_carrier_set_open_of_open_in_subspace[T: TopologicalSpace](a: Set[T], u: Set[T]) {
    is_open_in_subspace[T](a, u) implies Subspace[T, a].is_open(subspace_carrier_set(a, u))
}

theorem subspace_open_in_subspace_of_carrier_witness[T: TopologicalSpace](a: Set[T], u: Set[T], v: Set[T]) {
    T.is_open(v) and
        (forall(p: Subspace[T, a]) { subspace_carrier_set(a, u).contains(p) = v.contains(p.value) })
        implies is_open_in_subspace[T](a, u.intersection(a))
}

theorem subspace_open_in_subspace_of_carrier_open[T: TopologicalSpace](a: Set[T], u: Set[T]) {
    Subspace[T, a].is_open(subspace_carrier_set(a, u))
        implies is_open_in_subspace[T](a, u.intersection(a))
}

theorem subspace_carrier_open_iff[T: TopologicalSpace](a: Set[T], u: Set[T]) {
    Subspace[T, a].is_open(subspace_carrier_set(a, u)) =
        is_open_in_subspace[T](a, u.intersection(a))
}

theorem subspace_carrier_set_closed_from_ambient[T: TopologicalSpace](a: Set[T], c: Set[T]) {
    is_closed[T](c) implies is_closed[Subspace[T, a]](subspace_carrier_set(a, c))
}

theorem subspace_carrier_set_closed_of_closed_in_subspace[T: TopologicalSpace](a: Set[T], u: Set[T]) {
    is_closed_in_subspace[T](a, u) implies is_closed[Subspace[T, a]](subspace_carrier_set(a, u))
}

theorem subspace_closed_in_subspace_of_carrier_closed[T: TopologicalSpace](a: Set[T], u: Set[T]) {
    is_closed[Subspace[T, a]](subspace_carrier_set(a, u))
        implies is_closed_in_subspace[T](a, u.intersection(a))
}

theorem subspace_carrier_closed_iff[T: TopologicalSpace](a: Set[T], u: Set[T]) {
    is_closed[Subspace[T, a]](subspace_carrier_set(a, u)) =
        is_closed_in_subspace[T](a, u.intersection(a))
}

define discrete_four_open(s: Set[DiscreteFour]) -> Bool {
    true
}

instance DiscreteFour: TopologicalSpace {
    let is_open: Set[DiscreteFour] -> Bool = discrete_four_open
}

theorem discrete_four_every_set_open(s: Set[DiscreteFour]) {
    DiscreteFour.is_open(s)
}

theorem discrete_four_every_set_closed(s: Set[DiscreteFour]) {
    is_closed(s)
}

define indiscrete_two_open(s: Set[IndiscreteTwo]) -> Bool {
    s = Set[IndiscreteTwo].empty_set or s = Set[IndiscreteTwo].universal_set
}

instance IndiscreteTwo: TopologicalSpace {
    let is_open: Set[IndiscreteTwo] -> Bool = indiscrete_two_open
}

theorem indiscrete_two_inter(s: Set[IndiscreteTwo], t: Set[IndiscreteTwo]) {
    indiscrete_two_open(s) and indiscrete_two_open(t) implies indiscrete_two_open(s.intersection(t))
}

theorem indiscrete_two_big_union(c: Set[IndiscreteTwo] -> Bool) {
    (forall(s: Set[IndiscreteTwo]) { c(s) implies indiscrete_two_open(s) })
        implies indiscrete_two_open(big_union(c))
}

theorem indiscrete_two_open_iff(s: Set[IndiscreteTwo]) {
    IndiscreteTwo.is_open(s) = (s = Set[IndiscreteTwo].empty_set or s = Set[IndiscreteTwo].universal_set)
}

define topo_example_open(s: Set[TopoExample]) -> Bool {
    true
}

instance TopoExample: TopologicalSpace {
    let is_open: Set[TopoExample] -> Bool = topo_example_open
}

theorem pair_is_open_eq[X: TopologicalSpace, Y: TopologicalSpace](
    s: Set[Pair[X, Y]]) {
    Pair[X, Y].is_open(s) = is_open_in_product[X, Y](s)
}

theorem pair_map_preimage_product_open_neighborhood[X: TopologicalSpace, Y: TopologicalSpace, Z: TopologicalSpace, W: TopologicalSpace](
    f: X -> Z, g: Y -> W, s: Set[Pair[Z, W]], p: Pair[X, Y]
) {
    is_continuous(f) and is_continuous(g)
    and Pair[Z, W].is_open(s)
    and set_preimage(pair_map[X, Y, Z, W](f, g), s).contains(p)
    implies is_neighborhood(set_preimage(pair_map[X, Y, Z, W](f, g), s), p)
}

theorem pair_map_preimage_product_open[X: TopologicalSpace, Y: TopologicalSpace, Z: TopologicalSpace, W: TopologicalSpace](
    f: X -> Z, g: Y -> W, s: Set[Pair[Z, W]]
) {
    is_continuous(f) and is_continuous(g) and Pair[Z, W].is_open(s)
        implies Pair[X, Y].is_open(set_preimage(pair_map[X, Y, Z, W](f, g), s))
}

theorem real_complement_of_closed_is_open(s: Set[Real]) {
    is_closed[Real](s) implies Real.is_open(s.c)
}

theorem real_big_union_of_open_is_open(c: Set[Real] -> Bool) {
    (forall(s: Set[Real]) { c(s) implies Real.is_open(s) })
        implies Real.is_open(big_union(c))
}

theorem sum_is_open_eq[X: TopologicalSpace, Y: TopologicalSpace](w: Set[Sum[X, Y]]) {
    Sum[X, Y].is_open(w) = is_open_in_sum[X, Y](w)
}
