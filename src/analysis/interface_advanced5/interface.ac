theorem eventually_seq_eq_of_eventual_index_eq(a: Nat -> Real, b: Nat -> Real, n0: Nat) {
    (forall(n: Nat) { n0 <= n implies a(n) = b(n) }) implies eventually_seq_eq(a, b)
