theorem big_o_seq_of_eventual_index_abs_lte(a: Nat -> Real, b: Nat -> Real, c: Real, n0: Nat) {
    c.is_positive and (forall(n: Nat) { n0 <= n implies a(n).abs <= c * b(n).abs })
