theorem lonely_runner_one {
    exists(t: Real) {
        forall(i: Nat) {
            Nat.1 <= i and i < Nat.1 implies
                Real.1 / from_nat[Real](Nat.2) <= circular_distance(from_nat[Real](Nat.0) * t)
        }
    }
}

