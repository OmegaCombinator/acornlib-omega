theorem homeomorphism_image_compact_iff[X: TopologicalSpace, Y: TopologicalSpace](
    f: X -> Y, g: Y -> X, s: Set[X]) {
    is_homeomorphism[X, Y](f, g) implies
        (is_compact[X](s) = is_compact[Y](set_image(s, f)))
