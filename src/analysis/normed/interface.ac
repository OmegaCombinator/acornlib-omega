theorem subsequence_eventual_ub_limit_lte(a: Nat -> Real, f: Nat -> Nat, ub: Real) {
    converges(a) and eventual_ub(a, ub) and is_subsequence_index(f)
    implies limit(subsequence(a, f)) <= ub
