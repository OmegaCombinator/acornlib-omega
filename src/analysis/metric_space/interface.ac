let diameter[M: MetricSpace](s: Set[M]) -> d: Real satisfy {
    if has_diameter(s) {
        is_diameter(s, d)
    } else {
        d = 0
    }
}

theorem diameter_is_diameter[M: MetricSpace](s: Set[M]) {
    has_diameter(s) implies is_diameter(s, diameter(s))
}

theorem diameter_default[M: MetricSpace](s: Set[M]) {
    not has_diameter(s) implies diameter(s) = 0
}

theorem distance_le_diameter_fn[M: MetricSpace](s: Set[M], x: M, y: M) {
    has_diameter(s) and s.contains(x) and s.contains(y) implies x.distance(y) <= diameter(s)
}

theorem diameter_non_negative_fn[M: MetricSpace](s: Set[M]) {
    not diameter(s).is_negative
}

theorem diameter_empty[M: MetricSpace] {
    diameter(Set[M].empty_set) = 0
}

theorem is_diameter_singleton[M: MetricSpace](x: M) {
    is_diameter(Set[M].singleton(x), 0)
}

theorem diameter_singleton[M: MetricSpace](x: M) {
    diameter(Set[M].singleton(x)) = 0
}

theorem distance_set_subset_of_subset[M: MetricSpace](s: Set[M], t: Set[M]) {
    s.subset(t) implies distance_set(s).subset(distance_set(t))
}

theorem diameter_le_of_subset[M: MetricSpace](s: Set[M], t: Set[M]) {
    s.subset(t) and has_diameter(s) and has_diameter(t)
    implies diameter(s) <= diameter(t)
}

theorem intersection_of_closed_metric_is_closed[M: MetricSpace](s: Set[M], t: Set[M]) {
    is_closed_metric(s) and is_closed_metric(t) implies is_closed_metric(s.intersection(t))
}

theorem union_of_closed_metric_is_closed[M: MetricSpace](s: Set[M], t: Set[M]) {
    is_closed_metric(s) and is_closed_metric(t) implies is_closed_metric(s.union(t))
}

theorem closed_ball_is_closed_metric[M: MetricSpace](x: M, r: Real) {
    is_closed_metric(closed_ball(x, r))
}

theorem real_abs_zero {
    Real.0.abs = Real.0
}

theorem real_distance_self(x: Real) {
    real_distance(x, x) = 0
}

theorem real_distance_zero_imp_eq(x: Real, y: Real) {
    real_distance(x, y) = 0 implies x = y
}

theorem real_distance_symm(x: Real, y: Real) {
    real_distance(x, y) = real_distance(y, x)
}

theorem real_distance_triangle(x: Real, y: Real, z: Real) {
    real_distance(x, z) <= real_distance(x, y) + real_distance(y, z)
}

theorem real_metric_tail_bound_imp_tail_bound(q: Nat -> Real, a: Real, n: Nat, eps: Real) {
    metric_tail_bound(q, a, n, eps) implies tail_bound(q, a, n, eps)
}

theorem real_tendsto_metric_imp_converges_to(q: Nat -> Real, a: Real) {
    tendsto_metric(q, a) implies converges_to(q, a)
}

theorem real_converges_to_imp_tendsto_metric(q: Nat -> Real, a: Real) {
    converges_to(q, a) implies tendsto_metric(q, a)
}

theorem real_cauchy_metric_bound_imp_close_bound(q: Nat -> Real, n: Nat, eps: Real) {
    cauchy_metric_bound(q, n, eps) implies forall(i: Nat, j: Nat) {
        n <= i and n <= j implies q(i).is_close(q(j), eps)
    }
}

theorem real_is_cauchy_seq_imp_is_cauchy_metric(q: Nat -> Real) {
    is_cauchy_seq(q) implies is_cauchy_metric(q)
}

theorem real_is_cauchy_metric_imp_is_cauchy_seq(q: Nat -> Real) {
    is_cauchy_metric(q) implies is_cauchy_seq(q)
}

theorem real_is_cauchy_metric_iff_is_cauchy_seq(q: Nat -> Real) {
    is_cauchy_metric(q) = is_cauchy_seq(q)
}

theorem real_tendsto_metric_iff_converges_to(q: Nat -> Real, a: Real) {
    tendsto_metric(q, a) = converges_to(q, a)
}

theorem real_cauchy_metric_imp_tendsto(q: Nat -> Real) {
    is_cauchy_metric(q) implies exists(a: Real) {
        tendsto_metric(q, a)
    }
}

define is_sequence_lift[M, N](f: M -> N, p: Nat -> M, q: Nat -> N) -> Bool {
    compose(f, p) = q
}

theorem sequence_lift_of_apply[M, N](f: M -> N, p: Nat -> M, q: Nat -> N) {
    (forall(n: Nat) { f(p(n)) = q(n) }) implies is_sequence_lift(f, p, q)
}

theorem sequence_lift_apply[M, N](f: M -> N, p: Nat -> M, q: Nat -> N, n: Nat) {
    is_sequence_lift(f, p, q) implies f(p(n)) = q(n)
}

theorem surjective_has_right_inverse[M, N](f: M -> N) {
    is_surjective_fn(f) implies exists(g: N -> M) {
        is_right_inverse_fn(f, g)
    }
}

theorem right_inverse_sequence_lift[M, N](f: M -> N, g: N -> M, q: Nat -> N) {
    is_right_inverse_fn(f, g) implies is_sequence_lift(f, compose(g, q), q)
}

theorem surjective_sequence_lift[M, N](f: M -> N, q: Nat -> N) {
    is_surjective_fn(f) implies exists(p: Nat -> M) {
        is_sequence_lift(f, p, q)
    }
}

theorem right_inverse_of_isometry_is_isometry[M: MetricSpace, N: MetricSpace](
    f: M -> N, g: N -> M
) {
    is_isometry(f) and is_right_inverse_fn(f, g) implies is_isometry(g)
}

theorem right_inverse_preserves_cauchy_metric[M: MetricSpace, N: MetricSpace](
    f: M -> N, g: N -> M, q: Nat -> N
) {
    is_isometry(f) and is_right_inverse_fn(f, g) and is_cauchy_metric(q)
        implies is_cauchy_metric(compose(g, q))
}

theorem right_inverse_compose_sequence[M, N](f: M -> N, g: N -> M, q: Nat -> N) {
    is_right_inverse_fn(f, g) implies compose(f, compose(g, q)) = q
}

theorem sequence_lift_descends_tendsto_metric[M: MetricSpace, N: MetricSpace](
    f: M -> N, p: Nat -> M, q: Nat -> N, b: N
) {
    is_sequence_lift(f, p, q) and tendsto_metric(compose(f, p), b) implies tendsto_metric(q, b)
}

theorem surjective_isometry_cauchy_metric_imp_tendsto[M: CompleteMetricSpace, N: MetricSpace](
    f: M -> N, q: Nat -> N
) {
    is_isometry(f) and is_surjective_fn(f) and is_cauchy_metric(q) implies exists(b: N) {
        tendsto_metric(q, b)
    }
}

theorem upper_bound_apply(s: Set[Real], u: Real, z: Real) {
    is_set_upper_bound(s, u) and s.contains(z) implies z <= u
}

theorem upper_bound_weaken(s: Set[Real], u: Real, b: Real) {
    is_set_upper_bound(s, u) and u <= b implies is_set_upper_bound(s, b)
}

theorem supremum_le_of_upper_bound(s: Set[Real], sup_s: Real, b: Real) {
    is_set_supremum(s, sup_s) and is_set_upper_bound(s, b) implies sup_s <= b
}

theorem diameter_le_of_upper_bound[M: MetricSpace](s: Set[M], b: Real) {
    has_diameter(s) and is_set_upper_bound(distance_set(s), b)
    implies diameter(s) <= b
}

theorem diameter_le[M: MetricSpace](s: Set[M], b: Real) {
    has_diameter(s) implies (
        diameter(s) <= b iff is_set_upper_bound(distance_set(s), b)
    )
}

theorem diameter_le_of_subset_closed_ball[M: MetricSpace](s: Set[M], c: M, r: Real) {
    has_diameter(s) and s.subset(closed_ball(c, r)) implies diameter(s) <= r + r
}

theorem has_diameter_of_bounded_contains[M: MetricSpace](s: Set[M], x: M) {
    is_bounded(s) and s.contains(x) implies has_diameter(s)
}

theorem closed_ball_diameter_le[M: MetricSpace](c: M, r: Real) {
    not r.is_negative implies diameter(closed_ball(c, r)) <= r + r
}

theorem open_ball_diameter_le[M: MetricSpace](c: M, r: Real) {
    r.is_positive implies diameter(open_ball(c, r)) <= r + r
}

theorem distance_le_of_diameter_le[M: MetricSpace](s: Set[M], b: Real, x: M, y: M) {
    has_diameter(s) and s.contains(x) and s.contains(y) and diameter(s) <= b implies
    x.distance(y) <= b
}

theorem diameter_le_of_subset_with_bound[M: MetricSpace](s: Set[M], t: Set[M], b: Real) {
    s.subset(t) and has_diameter(s) and has_diameter(t) and diameter(t) <= b implies
    diameter(s) <= b
}

