define is_sequentially_compact[M: MetricSpace](s: Set[M]) -> Bool {
    forall(q: Nat -> M) {
        (forall(n: Nat) { s.contains(q(n)) }) implies exists(f: Nat -> Nat, a: M) {
            is_monotone(f) and is_unbounded(f) and s.contains(a) and tendsto_metric(compose(q, f), a)
        }
    }
}

theorem is_sequentially_compact_iff[M: MetricSpace](s: Set[M]) {
    is_sequentially_compact(s) = forall(q: Nat -> M) {
        (forall(n: Nat) { s.contains(q(n)) }) implies exists(f: Nat -> Nat, a: M) {
            is_monotone(f) and is_unbounded(f) and s.contains(a) and tendsto_metric(compose(q, f), a)
        }
    }
}

theorem sequentially_compact_subsequence[M: MetricSpace](s: Set[M], p: Nat -> M) {
    is_sequentially_compact(s) and (forall(n: Nat) { s.contains(p(n)) }) implies exists(f: Nat -> Nat, b: M) {
        is_monotone(f) and is_unbounded(f) and s.contains(b) and tendsto_metric(compose(p, f), b)
    }
}

theorem cauchy_metric_convergent_subsequence_imp_convergent[M: MetricSpace](
    q: Nat -> M, f: Nat -> Nat, a: M) {
    is_cauchy_metric(q) and is_monotone(f) and is_unbounded(f) and tendsto_metric(compose(q, f), a) implies tendsto_metric(q, a)
}

theorem sequentially_compact_imp_complete[M: MetricSpace] {
    is_sequentially_compact[M](Set[M].universal_set) implies forall(q: Nat -> M) {
        is_cauchy_metric(q) implies exists(a: M) { tendsto_metric(q, a) }
    }
}

theorem sequentially_compact_contains_limits[M: MetricSpace](s: Set[M], q: Nat -> M, a: M) {
    is_sequentially_compact(s) and (forall(n: Nat) { s.contains(q(n)) }) and tendsto_metric(q, a) implies s.contains(a)
}

theorem closed_interval_is_sequentially_compact(lo: Real, hi: Real) {
    is_sequentially_compact[Real](closed_interval_set(lo, hi))
}

theorem closed_interval_seq_compact_iff_compact(lo: Real, hi: Real) {
    is_sequentially_compact[Real](closed_interval_set(lo, hi)) = is_compact[Real](closed_interval_set(lo, hi))
}

theorem sequentially_compact_image[M: MetricTopologicalSpace, N: MetricTopologicalSpace](
    s: Set[M], f: M -> N) {
    is_sequentially_compact(s) and is_continuous(f) implies is_sequentially_compact(set_image(s, f))
}

theorem sequentially_compact_imp_bounded[M: MetricSpace](s: Set[M]) {
    is_sequentially_compact(s) implies is_bounded(s)
}

theorem continuous_seq_compact_bounded_above[M: MetricTopologicalSpace](s: Set[M], f: M -> Real) {
    is_sequentially_compact(s) and is_continuous(f) implies exists(b: Real) {
        forall(y: M) { s.contains(y) implies f(y) <= b }
    }
}

theorem continuous_seq_compact_bounded_below[M: MetricTopologicalSpace](s: Set[M], f: M -> Real) {
    is_sequentially_compact(s) and is_continuous(f) implies exists(b: Real) {
        forall(y: M) { s.contains(y) implies b <= f(y) }
    }
}

theorem from_nat_real_nonnegative(n: Nat) {
    Real.0 <= from_nat[Real](n)
}

theorem from_nat_real_lte(m: Nat, n: Nat) {
    m <= n implies from_nat[Real](m) <= from_nat[Real](n)
}

theorem div_le_div_pos(a: Real, b: Real, c: Real) {
    a <= b and Real.0 < c implies a / c <= b / c
}

define range_size(n: Nat) -> Real {
    from_nat[Real](n.suc)
}

theorem range_size_positive(n: Nat) {
    Real.0 < range_size(n)
}

define density_seq(p: Nat -> Bool, n: Nat) -> Real {
    from_nat[Real](count_upto(p, n.suc)) / range_size(n)
}

define has_natural_density(p: Nat -> Bool, d: Real) -> Bool {
    converges_to(density_seq(p), d)
}

theorem has_natural_density_apply(p: Nat -> Bool, d: Real) {
    has_natural_density(p, d) implies converges_to(density_seq(p), d)
}

theorem has_natural_density_intro(p: Nat -> Bool, d: Real) {
    converges_to(density_seq(p), d) implies has_natural_density(p, d)
}

theorem natural_density_unique(p: Nat -> Bool, d: Real, e: Real) {
    has_natural_density(p, d) and has_natural_density(p, e) implies d = e
}

theorem density_seq_all(n: Nat) {
    density_seq(all_pred, n) = Real.1
}

theorem density_seq_none(n: Nat) {
    density_seq(none_pred, n) = Real.0
}

theorem density_seq_le_one(p: Nat -> Bool, n: Nat) {
    density_seq(p, n) <= Real.1
}

theorem density_seq_nonnegative(p: Nat -> Bool, n: Nat) {
    Real.0 <= density_seq(p, n)
}

theorem density_seq_mono(p: Nat -> Bool, r: Nat -> Bool, n: Nat) {
    (forall(i: Nat) { p(i) implies r(i) }) implies density_seq(p, n) <= density_seq(r, n)
}

define eventually_all(p: Nat -> Bool) -> Bool {
    exists(n: Nat) {
        forall(m: Nat) {
            n <= m implies p(m)
        }
    }
}

theorem eventually_all_intro(p: Nat -> Bool, n: Nat) {
    (forall(m: Nat) { n <= m implies p(m) }) implies eventually_all(p)
}

theorem eventually_all_witness(p: Nat -> Bool) {
    eventually_all(p) implies exists(n: Nat) {
        forall(m: Nat) {
            n <= m implies p(m)
        }
    }
}

theorem eventually_all_of_all(p: Nat -> Bool) {
    (forall(m: Nat) { p(m) }) implies eventually_all(p)
}

theorem eventually_all_mono(p: Nat -> Bool, r: Nat -> Bool) {
    eventually_all(p) and (forall(i: Nat) { p(i) implies r(i) }) implies eventually_all(r)
}

define and_pred(p: Nat -> Bool, r: Nat -> Bool, i: Nat) -> Bool {
    p(i) and r(i)
}

theorem eventually_all_and(p: Nat -> Bool, r: Nat -> Bool) {
    eventually_all(p) and eventually_all(r)
        implies eventually_all(and_pred(p, r))
}

define tail_value(a: Nat -> Real, n: Nat, x: Real) -> Bool {
    exists(k: Nat) {
        n <= k and a(k) = x
    }
}

define tail_set(a: Nat -> Real, n: Nat) -> Set[Real] {
    Set[Real].new(tail_value(a, n))
}

theorem tail_set_contains_eq(a: Nat -> Real, n: Nat, x: Real) {
    tail_set(a, n).contains(x) = tail_value(a, n, x)
}

theorem tail_set_contains(a: Nat -> Real, n: Nat, k: Nat) {
    n <= k implies tail_set(a, n).contains(a(k))
}

theorem tail_set_witness(a: Nat -> Real, n: Nat, x: Real) {
    tail_set(a, n).contains(x) implies exists(k: Nat) { n <= k and a(k) = x }
}

theorem tail_set_nonempty(a: Nat -> Real, n: Nat) {
    is_nonempty(tail_set(a, n))
}

theorem tail_set_upper_bound(a: Nat -> Real, b: Real, n: Nat) {
    is_upper_bound(a, b) implies is_set_upper_bound(tail_set(a, n), b)
}

define is_bounded_above(a: Nat -> Real) -> Bool {
    exists(b: Real) {
        is_upper_bound(a, b)
    }
}

theorem is_bounded_above_intro(a: Nat -> Real, b: Real) {
    is_upper_bound(a, b) implies is_bounded_above(a)
