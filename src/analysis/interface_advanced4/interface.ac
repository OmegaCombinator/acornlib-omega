theorem floor_scale_bounds(b: Int, y: Real) {
    b.is_positive implies b * floor(y) <= floor(Real.from_int(b) * y)
        and floor(Real.from_int(b) * y) < b * floor(y) + b
}

define real_digit(b: Int, x: Real, k: Nat) -> Int {
