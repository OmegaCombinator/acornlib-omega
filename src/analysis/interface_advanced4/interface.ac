theorem lte_of_lte_add_eps(x: Real, y: Real) {
    (forall(eps: Real) { eps.is_positive implies x <= y + eps }) implies x <= y
}

theorem limsup_le_limit(a: Nat -> Real, l: Real) {
    is_bounded_above(a) and is_bounded_below(a) and converges_to(a, l)
        implies limsup(a) <= l
}

theorem limit_le_limsup(a: Nat -> Real, l: Real) {
    is_bounded_above(a) and is_bounded_below(a) and converges_to(a, l)
        implies l <= limsup(a)
}

theorem limsup_eq_limit(a: Nat -> Real, l: Real) {
    is_bounded_above(a) and is_bounded_below(a) and converges_to(a, l)
        implies limsup(a) = l
}

theorem tail_sup_mono(a: Nat -> Real, b: Nat -> Real, n: Nat) {
    is_bounded_above(a) and is_bounded_above(b)
        and (forall(k: Nat) { a(k) <= b(k) })
        implies tail_sup(a, n) <= tail_sup(b, n)
}

theorem tail_inf_mono(a: Nat -> Real, b: Nat -> Real, n: Nat) {
    is_bounded_below(a) and is_bounded_below(b)
        and (forall(k: Nat) { a(k) <= b(k) })
        implies tail_inf(a, n) <= tail_inf(b, n)
}

theorem limsup_mono(a: Nat -> Real, b: Nat -> Real) {
    is_bounded_above(a) and is_bounded_below(a) and is_bounded_above(b)
        and is_bounded_below(b) and (forall(k: Nat) { a(k) <= b(k) })
        implies limsup(a) <= limsup(b)
}

theorem upper_density_mono(p: Nat -> Bool, r: Nat -> Bool) {
    (forall(i: Nat) { p(i) implies r(i) })
        implies upper_density(p) <= upper_density(r)
}

theorem liminf_mono(a: Nat -> Real, b: Nat -> Real) {
    is_bounded_above(a) and is_bounded_below(a) and is_bounded_above(b)
        and is_bounded_below(b) and (forall(k: Nat) { a(k) <= b(k) })
        implies liminf(a) <= liminf(b)
}

theorem lower_density_mono(p: Nat -> Bool, r: Nat -> Bool) {
    (forall(i: Nat) { p(i) implies r(i) })
        implies lower_density(p) <= lower_density(r)
}

theorem add_seq_bounded_above(a: Nat -> Real, b: Nat -> Real) {
    is_bounded_above(a) and is_bounded_above(b) implies is_bounded_above(add_seq(a, b))
}

theorem add_seq_bounded_below(a: Nat -> Real, b: Nat -> Real) {
    is_bounded_below(a) and is_bounded_below(b) implies is_bounded_below(add_seq(a, b))
}

theorem tail_sup_add(a: Nat -> Real, b: Nat -> Real, n: Nat) {
    is_bounded_above(a) and is_bounded_above(b)
        implies tail_sup(add_seq(a, b), n) <= tail_sup(a, n) + tail_sup(b, n)
}

theorem limsup_add(a: Nat -> Real, b: Nat -> Real) {
    is_bounded_above(a) and is_bounded_below(a) and is_bounded_above(b)
        and is_bounded_below(b)
        implies limsup(add_seq(a, b)) <= limsup(a) + limsup(b)
}

theorem nat_lte_trans(a: Nat, b: Nat, c: Nat) {
    a <= b and b <= c implies a <= c
}

define or_pred(p: Nat -> Bool, r: Nat -> Bool) -> (Nat -> Bool) {
    function(i: Nat) {
        p(i) or r(i)
    }
}

theorem or_pred_apply(p: Nat -> Bool, r: Nat -> Bool, i: Nat) {
    or_pred(p, r)(i) = (p(i) or r(i))
}

theorem count_upto_or_le(p: Nat -> Bool, r: Nat -> Bool, n: Nat) {
    count_upto(or_pred(p, r), n) <= count_upto(p, n) + count_upto(r, n)
}

theorem density_seq_or_le(p: Nat -> Bool, r: Nat -> Bool, n: Nat) {
    density_seq(or_pred(p, r), n) <= density_seq(p, n) + density_seq(r, n)
}

theorem upper_density_subadditive(p: Nat -> Bool, r: Nat -> Bool) {
    upper_density(or_pred(p, r)) <= upper_density(p) + upper_density(r)
}

theorem lte_of_mul_lte_pos(x: Real, y: Real, c: Real) {
    x * c <= y * c and c > Real.0 implies x <= y
}

theorem density_seq_times_range(p: Nat -> Bool, n: Nat) {
    density_seq(p, n) * range_size(n) = from_nat[Real](count_upto(p, n.suc))
}

theorem residue_density_seq_upper(m: Nat, a: Nat, eps: Real, n: Nat) {
    a < m and eps > Real.0 and from_nat[Real](m) <= eps * range_size(n)
        implies from_nat[Real](m) * density_seq(in_residue_class(m, a), n)
            <= Real.1 + eps
}

theorem residue_density_seq_lower(m: Nat, a: Nat, eps: Real, n: Nat) {
    a < m and eps > Real.0 and from_nat[Real](m) <= eps * range_size(n)
        implies Real.1 - eps
            <= from_nat[Real](m) * density_seq(in_residue_class(m, a), n)
}

theorem from_nat_modulus_pos(m: Nat) {
    Nat.1 <= m implies from_nat[Real](m) > Real.0
}

theorem residue_range_long_enough(m: Nat, eps: Real, big_m: Nat, n: Nat) {
    eps > Real.0 and from_nat[Real](m) < eps * from_nat[Real](big_m) and big_m <= n
        implies from_nat[Real](m) <= eps * range_size(n)
}

theorem residue_upper_density_le_one(m: Nat, a: Nat) {
    a < m implies from_nat[Real](m) * upper_density(in_residue_class(m, a)) <= Real.1
}

theorem residue_lower_density_ge_one(m: Nat, a: Nat) {
    a < m implies Real.1 <= from_nat[Real](m) * lower_density(in_residue_class(m, a))
}

theorem residue_class_density(m: Nat, a: Nat) {
    a < m implies from_nat[Real](m) * lower_density(in_residue_class(m, a)) = Real.1
        and from_nat[Real](m) * upper_density(in_residue_class(m, a)) = Real.1
}

theorem upper_density_none {
    upper_density(none_pred) <= Real.0
}

theorem upper_density_residue_class(m: Nat, a: Nat) {
    a < m implies upper_density(in_residue_class(m, a)) = Real.1 / from_nat[Real](m)
}

define covers_nat(system: List[Pair[Nat, Nat]]) -> (Nat -> Bool) {
    match system {
        List.nil {
            none_pred
        }
        List.cons(head, tail) {
            or_pred(in_residue_class(head.first, head.second), covers_nat(tail))
        }
    }
}

define system_density_real(system: List[Pair[Nat, Nat]]) -> Real {
    match system {
        List.nil {
            Real.0
        }
        List.cons(head, tail) {
            Real.1 / from_nat[Real](head.first) + system_density_real(tail)
        }
    }
}

define system_reduced(system: List[Pair[Nat, Nat]]) -> Bool {
    forall(cl: Pair[Nat, Nat]) {
        system.contains(cl) implies cl.second < cl.first
    }
}

theorem covers_nat_cons(head: Pair[Nat, Nat], tail: List[Pair[Nat, Nat]]) {
    covers_nat(List.cons(head, tail))
        = or_pred(in_residue_class(head.first, head.second), covers_nat(tail))
}

theorem covers_nat_nil {
    covers_nat(List.nil[Pair[Nat, Nat]]) = none_pred
}

theorem system_density_real_cons(head: Pair[Nat, Nat], tail: List[Pair[Nat, Nat]]) {
    system_density_real(List.cons(head, tail))
        = Real.1 / from_nat[Real](head.first) + system_density_real(tail)
}

theorem system_density_real_nil {
    system_density_real(List.nil[Pair[Nat, Nat]]) = Real.0
}

theorem system_reduced_head(head: Pair[Nat, Nat], tail: List[Pair[Nat, Nat]]) {
    system_reduced(List.cons(head, tail)) implies head.second < head.first
}

theorem system_reduced_tail(head: Pair[Nat, Nat], tail: List[Pair[Nat, Nat]]) {
    system_reduced(List.cons(head, tail)) implies system_reduced(tail)
}

theorem upper_density_covers_nat_le(system: List[Pair[Nat, Nat]]) {
    system_reduced(system)
        implies upper_density(covers_nat(system)) <= system_density_real(system)
}

theorem limit_le_liminf(a: Nat -> Real, l: Real) {
    is_bounded_above(a) and is_bounded_below(a) and converges_to(a, l)
        implies l <= liminf(a)
}

theorem liminf_le_limit(a: Nat -> Real, l: Real) {
    is_bounded_above(a) and is_bounded_below(a) and converges_to(a, l)
        implies liminf(a) <= l
}

theorem liminf_eq_limit(a: Nat -> Real, l: Real) {
    is_bounded_above(a) and is_bounded_below(a) and converges_to(a, l)
        implies liminf(a) = l
}

theorem upper_density_of_natural_density(p: Nat -> Bool, d: Real) {
    has_natural_density(p, d) implies upper_density(p) = d
}

theorem lower_density_of_natural_density(p: Nat -> Bool, d: Real) {
    has_natural_density(p, d) implies lower_density(p) = d
}

theorem densities_agree_of_natural_density(p: Nat -> Bool, d: Real) {
    has_natural_density(p, d)
        implies lower_density(p) = d and upper_density(p) = d
}

define not_pred(p: Nat -> Bool) -> (Nat -> Bool) {
    function(i: Nat) {
        not p(i)
    }
}

theorem not_pred_apply(p: Nat -> Bool, i: Nat) {
    not_pred(p)(i) = not p(i)
}

theorem count_upto_complement_np(p: Nat -> Bool, n: Nat) {
    count_upto(not_pred(p), n) + count_upto(p, n) = n
}

theorem density_seq_complement(p: Nat -> Bool, n: Nat) {
    density_seq(not_pred(p), n) = Real.1 - density_seq(p, n)
}

theorem one_sub_is_close(x: Real, y: Real, eps: Real) {
    x.is_close(y, eps) implies (Real.1 - x).is_close(Real.1 - y, eps)
}

theorem density_seq_complement_is_close(p: Nat -> Bool, d: Real, eps: Real, i: Nat) {
    density_seq(p, i).is_close(d, eps)
        implies density_seq(not_pred(p), i).is_close(Real.1 - d, eps)
}

theorem one_minus_flip(x: Real, y: Real) {
    Real.1 - x <= y implies Real.1 - y <= x
}

define one_minus_seq(a: Nat -> Real) -> (Nat -> Real) {
    function(n: Nat) {
        Real.1 - a(n)
    }
}

theorem one_minus_bounded_above(a: Nat -> Real) {
    is_bounded_below(a) implies is_bounded_above(one_minus_seq(a))
}

theorem one_minus_bounded_below(a: Nat -> Real) {
    is_bounded_above(a) implies is_bounded_below(one_minus_seq(a))
}

theorem tail_sup_one_minus(a: Nat -> Real, n: Nat) {
    is_bounded_above(a) and is_bounded_below(a)
        implies tail_sup(one_minus_seq(a), n) = Real.1 - tail_inf(a, n)
}

theorem neg_tail_sup_one_minus(a: Nat -> Real, n: Nat) {
    is_bounded_above(a) and is_bounded_below(a)
        implies neg_tail_sup(one_minus_seq(a))(n)
            = add_seq(neg_tail_sup(neg_seq(a)), constant[Nat, Real](-Real.1))(n)
}

theorem limsup_one_minus(a: Nat -> Real) {
    is_bounded_above(a) and is_bounded_below(a)
        implies limsup(one_minus_seq(a)) = Real.1 - liminf(a)
}

theorem density_seq_complement_eq(p: Nat -> Bool) {
    density_seq(not_pred(p)) = one_minus_seq(density_seq(p))
}

theorem upper_density_complement(p: Nat -> Bool) {
    upper_density(not_pred(p)) = Real.1 - lower_density(p)
}

theorem one_minus_one_minus(x: Real) {
    Real.1 - (Real.1 - x) = x
}

theorem add_one_minus(x: Real) {
    x + (Real.1 - x) = Real.1
}

theorem one_minus_seq_involution(a: Nat -> Real) {
    one_minus_seq(one_minus_seq(a)) = a
}

theorem liminf_one_minus(a: Nat -> Real) {
    is_bounded_above(a) and is_bounded_below(a)
        implies liminf(one_minus_seq(a)) = Real.1 - limsup(a)
}

theorem not_pred_involution(p: Nat -> Bool) {
    not_pred(not_pred(p)) = p
}

theorem lower_density_complement(p: Nat -> Bool) {
    lower_density(not_pred(p)) = Real.1 - upper_density(p)
}

theorem upper_density_add_lower_density_complement(p: Nat -> Bool) {
    upper_density(p) + lower_density(not_pred(p)) = Real.1
}

theorem upper_density_one_iff_complement_lower_zero(p: Nat -> Bool) {
    (upper_density(p) = Real.1) = (lower_density(not_pred(p)) = Real.0)
}

theorem lower_density_one_iff_complement_upper_zero(p: Nat -> Bool) {
    (lower_density(p) = Real.1) = (upper_density(not_pred(p)) = Real.0)
}

theorem tail_inf_add(a: Nat -> Real, b: Nat -> Real, n: Nat) {
    is_bounded_below(a) and is_bounded_below(b)
        implies tail_inf(a, n) + tail_inf(b, n) <= tail_inf(add_seq(a, b), n)
}

theorem liminf_add(a: Nat -> Real, b: Nat -> Real) {
    is_bounded_above(a) and is_bounded_below(a) and is_bounded_above(b)
        and is_bounded_below(b)
        implies liminf(a) + liminf(b) <= liminf(add_seq(a, b))
}

define disjoint_pred(p: Nat -> Bool, r: Nat -> Bool) -> Bool {
    forall(i: Nat) {
        not (p(i) and r(i))
    }
}

theorem disjoint_pred_apply(p: Nat -> Bool, r: Nat -> Bool, i: Nat) {
    disjoint_pred(p, r) implies not (p(i) and r(i))
}

theorem count_upto_or_disjoint(p: Nat -> Bool, r: Nat -> Bool, n: Nat) {
    disjoint_pred(p, r)
        implies count_upto(or_pred(p, r), n) = count_upto(p, n) + count_upto(r, n)
}

theorem density_seq_or_disjoint(p: Nat -> Bool, r: Nat -> Bool, n: Nat) {
    disjoint_pred(p, r)
        implies density_seq(or_pred(p, r), n) = density_seq(p, n) + density_seq(r, n)
}

theorem lower_density_superadditive(p: Nat -> Bool, r: Nat -> Bool) {
    disjoint_pred(p, r)
        implies lower_density(p) + lower_density(r) <= lower_density(or_pred(p, r))
}

theorem count_upto_of_holds_from(p: Nat -> Bool, big_n: Nat, n: Nat) {
    (forall(m: Nat) { big_n <= m implies p(m) })
        implies n <= count_upto(p, n) + big_n
}

theorem density_seq_ge_of_holds_from(
    p: Nat -> Bool, big_n: Nat, eps: Real, k: Nat
) {
    (forall(m: Nat) { big_n <= m implies p(m) }) and eps > Real.0
        and from_nat[Real](big_n) <= eps * range_size(k)
        implies Real.1 - eps <= density_seq(p, k)
}

theorem lower_density_of_eventually_all(p: Nat -> Bool) {
    eventually_all(p) implies lower_density(p) = Real.1
}

theorem upper_density_of_eventually_all(p: Nat -> Bool) {
    eventually_all(p) implies upper_density(p) = Real.1
}

theorem densities_of_all(p: Nat -> Bool) {
    (forall(m: Nat) { p(m) })
        implies lower_density(p) = Real.1 and upper_density(p) = Real.1
}

theorem densities_of_and(p: Nat -> Bool, r: Nat -> Bool) {
    eventually_all(p) and eventually_all(r)
        implies lower_density(and_pred(p, r)) = Real.1
            and upper_density(and_pred(p, r)) = Real.1
}

theorem lower_density_residue_class(m: Nat, a: Nat) {
    a < m implies lower_density(in_residue_class(m, a)) = Real.1 / from_nat[Real](m)
}

define head_disjoint_nat(head: Pair[Nat, Nat], rest: List[Pair[Nat, Nat]]) -> Bool {
    disjoint_pred(in_residue_class(head.first, head.second), covers_nat(rest))
}

theorem disjoint_cons_bound(head: Pair[Nat, Nat], tail: List[Pair[Nat, Nat]]) {
    head.second < head.first and head_disjoint_nat(head, tail)
        and system_density_real(tail) <= lower_density(covers_nat(tail))
        implies system_density_real(List.cons(head, tail))
            <= lower_density(covers_nat(List.cons(head, tail)))
}

define is_suffix_of(part: List[Pair[Nat, Nat]], whole: List[Pair[Nat, Nat]]) -> Bool {
    exists(front: List[Pair[Nat, Nat]]) {
        front + part = whole
    }
}

theorem is_suffix_of_refl(whole: List[Pair[Nat, Nat]]) {
    is_suffix_of(whole, whole)
}

theorem is_suffix_of_cons(part: List[Pair[Nat, Nat]], head: Pair[Nat, Nat],
    tail: List[Pair[Nat, Nat]]) {
    is_suffix_of(part, tail) implies is_suffix_of(part, List.cons(head, tail))
}

define system_disjoint_nat(system: List[Pair[Nat, Nat]]) -> Bool {
    forall(head: Pair[Nat, Nat], tail: List[Pair[Nat, Nat]]) {
        is_suffix_of(List.cons(head, tail), system) implies head_disjoint_nat(head, tail)
    }
}

theorem system_disjoint_nat_head(head: Pair[Nat, Nat], tail: List[Pair[Nat, Nat]]) {
    system_disjoint_nat(List.cons(head, tail)) implies head_disjoint_nat(head, tail)
}

theorem system_disjoint_nat_tail(head: Pair[Nat, Nat], tail: List[Pair[Nat, Nat]]) {
    system_disjoint_nat(List.cons(head, tail)) implies system_disjoint_nat(tail)
}

theorem system_density_real_le_lower_density(system: List[Pair[Nat, Nat]]) {
    system_reduced(system) and system_disjoint_nat(system)
        implies system_density_real(system) <= lower_density(covers_nat(system))
}

theorem disjoint_system_density_le_one(system: List[Pair[Nat, Nat]]) {
    system_reduced(system) and system_disjoint_nat(system)
        implies system_density_real(system) <= Real.1
}

typeclass G: NormedAddCommGroup extends AddCommGroup {
    /// The norm of a group element.
    norm: G -> Real

    /// Rule: only the zero element has norm zero.
    norm_eq_zero_imp_zero(x: G) {
        x.norm = 0 implies x = G.0
    }

    /// Rule: the zero element has norm zero.
    norm_zero {
        G.0.norm = 0
    }

    /// Rule: the norm is invariant under negation.
    norm_neg(x: G) {
        (-x).norm = x.norm
    }

    /// Rule: the norm satisfies the triangle inequality.
    norm_triangle(x: G, y: G) {
        (x + y).norm <= x.norm + y.norm
    }
}

theorem norm_non_negative[G: NormedAddCommGroup](x: G) {
    0 <= x.norm
}

theorem norm_eq_zero_iff[G: NormedAddCommGroup](x: G) {
    (x.norm = 0) = (x = G.0)
}

theorem norm_sub_norm_le[G: NormedAddCommGroup](x: G, y: G) {
    x.norm - y.norm <= (x - y).norm
}

theorem norm_sub_symm[G: NormedAddCommGroup](x: G, y: G) {
    (x - y).norm = (y - x).norm
}

define norm_distance[G: NormedAddCommGroup](x: G, y: G) -> Real {
    (x - y).norm
}

theorem norm_distance_self[G: NormedAddCommGroup](x: G) {
    norm_distance(x, x) = 0
}

theorem norm_distance_symm[G: NormedAddCommGroup](x: G, y: G) {
    norm_distance(x, y) = norm_distance(y, x)
}

theorem norm_distance_triangle[G: NormedAddCommGroup](x: G, y: G, z: G) {
    norm_distance(x, z) <= norm_distance(x, y) + norm_distance(y, z)
}

theorem norm_distance_non_negative[G: NormedAddCommGroup](x: G, y: G) {
    0 <= norm_distance(x, y)
}

theorem norm_sub_eq_zero_iff[G: NormedAddCommGroup](x: G, y: G) {
    ((x - y).norm = 0) = (x = y)
}
