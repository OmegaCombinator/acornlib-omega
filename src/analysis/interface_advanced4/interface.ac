theorem is_nonnegative_seq_intro(a: Nat -> Real) {
    (forall(n: Nat) { Real.0 <= a(n) }) implies is_nonnegative_seq(a)
}

theorem seq_lte_intro(a: Nat -> Real, b: Nat -> Real) {
    (forall(n: Nat) { a(n) <= b(n) }) implies seq_lte(a, b)
}

theorem scaled_geom_converges(c: Real, r: Real) {
    r.abs < Real.1 implies converges(mul_seq(c, partial(r.pow)))
}

theorem partial_mul_seq(c: Real, a: Nat -> Real, n: Nat) {
    partial(mul_seq(c, a), n) = mul_seq(c, partial(a), n)
}

theorem geometric_comparison_test(a: Nat -> Real, c: Real, r: Real) {
    is_nonnegative_seq(a) and r.abs < Real.1
        and (forall(n: Nat) { a(n) <= c * r.pow(n) })
        implies converges(partial(a))
}

theorem contraction_constant_nonneg[M: MetricSpace](f: M -> M, c: Real) {
    is_contraction(f, c) implies Real.0 <= c
}

theorem contraction_constant_lt_one[M: MetricSpace](f: M -> M, c: Real) {
    is_contraction(f, c) implies c < Real.1
}

theorem contraction_distance[M: MetricSpace](f: M -> M, c: Real, x: M, y: M) {
    is_contraction(f, c) implies f(x).distance(f(y)) <= c * x.distance(y)
}

define orbit_seq[M: MetricSpace](f: M -> M, x0: M, n: Nat) -> M {
    iterate(f, n, x0)
}

theorem orbit_seq_zero[M: MetricSpace](f: M -> M, x0: M) {
    orbit_seq(f, x0, Nat.0) = x0
}

theorem orbit_seq_suc[M: MetricSpace](f: M -> M, x0: M, n: Nat) {
    orbit_seq(f, x0, n.suc) = f(orbit_seq(f, x0, n))
}

define orbit_partial[M: MetricSpace](f: M -> M, c: Real, x0: M, n: Nat) -> Real {
    partial(mul_seq(f(x0).distance(x0), c.pow), n)
}

theorem contraction_iterate_distance[M: MetricSpace](f: M -> M, c: Real, n: Nat, x: M, y: M) {
    is_contraction(f, c)
    implies iterate(f, n, x).distance(iterate(f, n, y)) <= c.pow(n) * x.distance(y)
}

theorem orbit_consecutive_bound[M: MetricSpace](f: M -> M, c: Real, x0: M, n: Nat) {
    is_contraction(f, c)
    implies orbit_seq(f, x0, n.suc).distance(orbit_seq(f, x0, n)) <=
        mul_seq(f(x0).distance(x0), c.pow, n)
}

theorem orbit_polygon_base[M: MetricSpace](f: M -> M, c: Real, x0: M, k: Nat) {
    is_contraction(f, c) implies
    orbit_seq(f, x0, k).distance(orbit_seq(f, x0, k + Nat.0)) <=
        orbit_partial(f, c, x0, k + Nat.0) - orbit_partial(f, c, x0, k)
}

theorem orbit_polygon_bound[M: MetricSpace](f: M -> M, c: Real, x0: M, m: Nat, n: Nat) {
    is_contraction(f, c) and m <= n implies
    orbit_seq(f, x0, m).distance(orbit_seq(f, x0, n)) <=
        orbit_partial(f, c, x0, n) - orbit_partial(f, c, x0, m)
}

theorem orbit_pair_bound[M: MetricSpace](f: M -> M, c: Real, x0: M, eps: Real, n: Nat, i: Nat, j: Nat) {
    is_contraction(f, c)
    and (forall(a: Nat, b: Nat) {
        n <= a and n <= b implies
            partial(mul_seq(f(x0).distance(x0), c.pow), a).is_close(partial(mul_seq(f(x0).distance(x0), c.pow), b), eps)
    })
    and n <= i and n <= j
    implies orbit_seq(f, x0, i).distance(orbit_seq(f, x0, j)) < eps
}

theorem orbit_cauchy_metric[M: MetricSpace](f: M -> M, c: Real, x0: M) {
    is_contraction(f, c) implies is_cauchy_metric(orbit_seq(f, x0))
}

theorem lt_all_positive_eps_imp_lte_zero(x: Real) {
    (forall(eps: Real) { eps.is_positive implies x < eps })
    implies x <= Real.0
}

theorem banach_contraction_orbit_converges[M: CompleteMetricSpace](f: M -> M, c: Real, x0: M) {
    is_contraction(f, c) implies exists(a: M) {
        is_fixed_point(f, a) and tendsto_metric(orbit_seq(f, x0), a)
    }
}

theorem banach_contraction_fixed_point_exists[M: CompleteMetricSpace](f: M -> M, c: Real, x0: M) {
    is_contraction(f, c) implies exists(a: M) {
        is_fixed_point(f, a)
    }
}

theorem banach_contraction_fixed_point_unique[M: MetricSpace](f: M -> M, c: Real, x: M, y: M) {
    is_contraction(f, c) and is_fixed_point(f, x) and is_fixed_point(f, y) implies x = y
}

theorem banach_contraction_fixed_point[M: CompleteMetricSpace](f: M -> M, c: Real, x0: M) {
    is_contraction(f, c) implies exists(a: M) {
        is_fixed_point(f, a) and forall(y: M) {
            is_fixed_point(f, y) implies y = a
        }
    }
}

theorem real_banach_fixed_point(f: Real -> Real, c: Real, x0: Real) {
    Real.0 <= c
    and c < Real.1
    and (forall(x: Real, y: Real) {
        (f(x) - f(y)).abs <= c * (x - y).abs
    })
    implies exists(a: Real) {
        f(a) = a
    }
}

theorem closed_ball_is_closed_metric[M: MetricSpace](x: M, r: Real) {
    is_closed_metric(closed_ball(x, r))
}

define is_sequence_lift[M, N](f: M -> N, p: Nat -> M, q: Nat -> N) -> Bool {
    compose(f, p) = q
}

theorem sequence_lift_of_apply[M, N](f: M -> N, p: Nat -> M, q: Nat -> N) {
    (forall(n: Nat) { f(p(n)) = q(n) }) implies is_sequence_lift(f, p, q)
}

theorem sequence_lift_apply[M, N](f: M -> N, p: Nat -> M, q: Nat -> N, n: Nat) {
    is_sequence_lift(f, p, q) implies f(p(n)) = q(n)
}

theorem surjective_has_right_inverse[M, N](f: M -> N) {
    is_surjective_fn(f) implies exists(g: N -> M) {
        is_right_inverse_fn(f, g)
    }
}

theorem right_inverse_sequence_lift[M, N](f: M -> N, g: N -> M, q: Nat -> N) {
    is_right_inverse_fn(f, g) implies is_sequence_lift(f, compose(g, q), q)
}

theorem surjective_sequence_lift[M, N](f: M -> N, q: Nat -> N) {
    is_surjective_fn(f) implies exists(p: Nat -> M) {
        is_sequence_lift(f, p, q)
    }
}

theorem right_inverse_of_isometry_is_isometry[M: MetricSpace, N: MetricSpace](
    f: M -> N, g: N -> M
) {
    is_isometry(f) and is_right_inverse_fn(f, g) implies is_isometry(g)
}

theorem right_inverse_preserves_cauchy_metric[M: MetricSpace, N: MetricSpace](
    f: M -> N, g: N -> M, q: Nat -> N
) {
    is_isometry(f) and is_right_inverse_fn(f, g) and is_cauchy_metric(q)
        implies is_cauchy_metric(compose(g, q))
}

theorem right_inverse_compose_sequence[M, N](f: M -> N, g: N -> M, q: Nat -> N) {
    is_right_inverse_fn(f, g) implies compose(f, compose(g, q)) = q
}

theorem sequence_lift_descends_tendsto_metric[M: MetricSpace, N: MetricSpace](
    f: M -> N, p: Nat -> M, q: Nat -> N, b: N
) {
    is_sequence_lift(f, p, q) and tendsto_metric(compose(f, p), b) implies tendsto_metric(q, b)
}

theorem surjective_isometry_cauchy_metric_imp_tendsto[M: CompleteMetricSpace, N: MetricSpace](
    f: M -> N, q: Nat -> N
) {
    is_isometry(f) and is_surjective_fn(f) and is_cauchy_metric(q) implies exists(b: N) {
        tendsto_metric(q, b)
    }
}

theorem upper_bound_apply(s: Set[Real], u: Real, z: Real) {
    is_set_upper_bound(s, u) and s.contains(z) implies z <= u
}

theorem upper_bound_weaken(s: Set[Real], u: Real, b: Real) {
    is_set_upper_bound(s, u) and u <= b implies is_set_upper_bound(s, b)
}

theorem supremum_le_of_upper_bound(s: Set[Real], sup_s: Real, b: Real) {
    is_set_supremum(s, sup_s) and is_set_upper_bound(s, b) implies sup_s <= b
}

theorem diameter_le_of_upper_bound[M: MetricSpace](s: Set[M], b: Real) {
    has_diameter(s) and is_set_upper_bound(distance_set(s), b)
    implies diameter(s) <= b
}

theorem diameter_le[M: MetricSpace](s: Set[M], b: Real) {
    has_diameter(s) implies (
        diameter(s) <= b iff is_set_upper_bound(distance_set(s), b)
    )
}

theorem diameter_le_of_subset_closed_ball[M: MetricSpace](s: Set[M], c: M, r: Real) {
    has_diameter(s) and s.subset(closed_ball(c, r)) implies diameter(s) <= r + r
}

theorem has_diameter_of_bounded_contains[M: MetricSpace](s: Set[M], x: M) {
    is_bounded(s) and s.contains(x) implies has_diameter(s)
}

theorem closed_ball_diameter_le[M: MetricSpace](c: M, r: Real) {
    not r.is_negative implies diameter(closed_ball(c, r)) <= r + r
}

theorem open_ball_diameter_le[M: MetricSpace](c: M, r: Real) {
    r.is_positive implies diameter(open_ball(c, r)) <= r + r
}

theorem distance_le_of_diameter_le[M: MetricSpace](s: Set[M], b: Real, x: M, y: M) {
    has_diameter(s) and s.contains(x) and s.contains(y) and diameter(s) <= b implies
    x.distance(y) <= b
}

theorem diameter_le_of_subset_with_bound[M: MetricSpace](s: Set[M], t: Set[M], b: Real) {
    s.subset(t) and has_diameter(s) and has_diameter(t) and diameter(t) <= b implies
    diameter(s) <= b
}

theorem continuous_open_preimage[X: TopologicalSpace, Y: TopologicalSpace](
    f: X -> Y, v: Set[Y]) {
    is_continuous(f) and Y.is_open(v) implies X.is_open(set_preimage(f, v))
}

theorem continuous_closed_preimage[X: TopologicalSpace, Y: TopologicalSpace](
    f: X -> Y, c: Set[Y]) {
    is_continuous(f) and is_closed[Y](c) implies is_closed[X](set_preimage(f, c))
}

typeclass M: MetricTopologicalSpace extends MetricSpace, TopologicalSpace {
    /// Compatibility axiom: topological openness agrees with metric openness.
    topological_open_eq_metric_open(s: Set[M]) {
        M.is_open(s) = is_open_metric(s)
    }
}

theorem topological_open_eq_metric_open[M: MetricTopologicalSpace](s: Set[M]) {
    M.is_open(s) = is_open_metric(s)
}

theorem metric_open_is_topological_open[M: MetricTopologicalSpace](s: Set[M]) {
    is_open_metric(s) implies M.is_open(s)
}

theorem topological_open_is_metric_open[M: MetricTopologicalSpace](s: Set[M]) {
    M.is_open(s) implies is_open_metric(s)
}

theorem metric_closed_eq_topological_closed[M: MetricTopologicalSpace](s: Set[M]) {
    is_closed_metric(s) = is_closed(s)
}

theorem metric_closed_is_topological_closed[M: MetricTopologicalSpace](s: Set[M]) {
    is_closed_metric(s) implies is_closed(s)
}

theorem topological_closed_is_metric_closed[M: MetricTopologicalSpace](s: Set[M]) {
    is_closed(s) implies is_closed_metric(s)
}

theorem open_ball_is_topological_open[M: MetricTopologicalSpace](x: M, r: Real) {
    M.is_open(open_ball(x, r))
}

theorem continuous_preimage_metric_open[M: TopologicalSpace, N: MetricTopologicalSpace](f: M -> N, v: Set[N]) {
    is_continuous(f) and is_open_metric(v) implies M.is_open(set_preimage(f, v))
}

theorem continuous_preimage_metric_open_is_metric_open[M: MetricTopologicalSpace, N: MetricTopologicalSpace](f: M -> N, v: Set[N]) {
    is_continuous(f) and is_open_metric(v) implies is_open_metric(set_preimage(f, v))
}

theorem sub_lt_of_lt_add(a: Real, b: Real, c: Real) {
    a < b + c implies a - c < b
}

theorem distance_difference_upper[M: MetricSpace](x: M, y: M, x2: M, y2: M) {
    x2.distance(y2) <= x.distance(y) + (x2.distance(x) + y2.distance(y))
}

theorem distance_difference_lower[M: MetricSpace](x: M, y: M, x2: M, y2: M) {
    x.distance(y) <= x2.distance(y2) + (x2.distance(x) + y2.distance(y))
}

theorem distance_jointly_continuous_delta[M: MetricSpace](x: M, y: M, eps: Real, delta: Real) {
    delta.is_positive and delta + delta < eps implies
        forall(x2: M, y2: M) {
            (x2.distance(x) < delta and y2.distance(y) < delta) implies (x2.distance(y2)).is_close(x.distance(y), eps)
        }
}

theorem metric_distance_jointly_continuous[M: MetricSpace] {
    forall(x: M, y: M, eps: Real) {
        eps.is_positive implies exists(delta: Real) {
            delta.is_positive and forall(x2: M, y2: M) {
                (x2.distance(x) < delta and y2.distance(y) < delta) implies (x2.distance(y2)).is_close(x.distance(y), eps)
            }
        }
    }
}

theorem metric_distance_first_continuous[M: MetricSpace] {
    forall(y: M, x: M, eps: Real) {
        eps.is_positive implies exists(delta: Real) {
            delta.is_positive and forall(x2: M) {
                (x2.distance(x) < delta) implies (x2.distance(y)).is_close(x.distance(y), eps)
            }
        }
    }
}

define is_sequentially_continuous[M: MetricSpace, N: MetricSpace](f: M -> N) -> Bool {
    forall(q: Nat -> M, a: M) {
        tendsto_metric(q, a) implies tendsto_metric(compose(f, q), f(a))
    }
}

theorem is_sequentially_continuous_iff[M: MetricSpace, N: MetricSpace](f: M -> N) {
    is_sequentially_continuous(f) = forall(q: Nat -> M, a: M) {
        tendsto_metric(q, a) implies tendsto_metric(compose(f, q), f(a))
    }
}

theorem lipschitz_with_is_sequentially_continuous[M: MetricSpace, N: MetricSpace](
    k: Real, f: M -> N) {
    is_lipschitz_with(k, f) implies is_sequentially_continuous(f)
}

theorem continuous_imp_sequentially_continuous[M: MetricTopologicalSpace, N: MetricTopologicalSpace](
    f: M -> N) {
    is_continuous(f) implies is_sequentially_continuous(f)
}

theorem isometry_reflects_metric_tail_bound[M: MetricSpace, N: MetricSpace](
    f: M -> N, q: Nat -> M, a: M, n: Nat, eps: Real
) {
    is_isometry(f) and metric_tail_bound(compose(f, q), f(a), n, eps)
        implies metric_tail_bound(q, a, n, eps)
}

theorem isometry_reflects_tendsto_metric[M: MetricSpace, N: MetricSpace](
    f: M -> N, q: Nat -> M, a: M
) {
    is_isometry(f) and tendsto_metric(compose(f, q), f(a)) implies tendsto_metric(q, a)
}

theorem isometry_reflects_cauchy_metric_bound[M: MetricSpace, N: MetricSpace](
    f: M -> N, q: Nat -> M, n: Nat, eps: Real
) {
    is_isometry(f) and cauchy_metric_bound(compose(f, q), n, eps)
        implies cauchy_metric_bound(q, n, eps)
}

theorem isometry_reflects_cauchy_metric[M: MetricSpace, N: MetricSpace](
    f: M -> N, q: Nat -> M
) {
    is_isometry(f) and is_cauchy_metric(compose(f, q)) implies is_cauchy_metric(q)
}

theorem lipschitz_with_preimage_metric_open[M: MetricSpace, N: MetricSpace](
    k: Real, f: M -> N, v: Set[N]
) {
    is_lipschitz_with(k, f) and is_open_metric(v) implies is_open_metric(set_preimage(f, v))
}

theorem lipschitz_preimage_metric_open[M: MetricSpace, N: MetricSpace](
    f: M -> N, v: Set[N]
) {
    is_lipschitz(f) and is_open_metric(v) implies is_open_metric(set_preimage(f, v))
}

theorem lipschitz_with_is_continuous[M: MetricTopologicalSpace, N: MetricTopologicalSpace](
    k: Real, f: M -> N
) {
    is_lipschitz_with(k, f) implies is_continuous(f)
}

theorem lipschitz_is_continuous[M: MetricTopologicalSpace, N: MetricTopologicalSpace](
    f: M -> N
) {
    is_lipschitz(f) implies is_continuous(f)
}

theorem isometry_is_continuous[M: MetricTopologicalSpace, N: MetricTopologicalSpace](
    f: M -> N
) {
    is_isometry(f) implies is_continuous(f)
}

theorem list_union_of_sets_append[T](left: List[Set[T]], right: List[Set[T]]) {
    list_union_of_sets[T](left + right) =
        list_union_of_sets[T](left).union(list_union_of_sets[T](right))
}

theorem is_subfamily_append[T](c: Set[T] -> Bool, left: List[Set[T]], right: List[Set[T]]) {
    is_subfamily[T](c, left) and is_subfamily[T](c, right)
        implies is_subfamily[T](c, left + right)
}

theorem union_subcover_append[T](s: Set[T], t: Set[T], left: List[Set[T]], right: List[Set[T]]) {
    s.subset(list_union_of_sets[T](left)) and t.subset(list_union_of_sets[T](right))
        implies s.union(t).subset(list_union_of_sets[T](left + right))
}

theorem compact_open_cover_has_finite_subcover[T: TopologicalSpace](c: Set[T] -> Bool, s: Set[T]) {
    is_compact[T](s) and is_open_cover[T](c, s) implies exists(items: List[Set[T]]) {
        is_subfamily[T](c, items) and s.subset(list_union_of_sets[T](items))
    }
}

theorem compact_union[T: TopologicalSpace](s: Set[T], t: Set[T]) {
    is_compact[T](s) and is_compact[T](t) implies is_compact[T](s.union(t))
}

theorem compact_insert[T: TopologicalSpace](s: Set[T], x: T) {
    is_compact[T](s) implies is_compact[T](s.insert(x))
}

theorem subfamily_member_imp_family[T](c: Set[T] -> Bool, items: List[Set[T]], member: Set[T]) {
    is_subfamily[T](c, items) and items.contains(member) implies c(member)
}

theorem list_union_contains_witness[T](items: List[Set[T]], x: T) {
    list_union_of_sets[T](items).contains(x) implies exists(member: Set[T]) {
        items.contains(member) and member.contains(x)
    }
}

theorem list_inter_of_sets_open[T: TopologicalSpace](items: List[Set[T]]) {
    (forall(u: Set[T]) { items.contains(u) implies T.is_open(u) })
        implies T.is_open(list_inter_of_sets[T](items))
}

theorem list_inter_of_sets_contains[T](items: List[Set[T]], x: T) {
    (forall(u: Set[T]) { items.contains(u) implies u.contains(x) })
        implies list_inter_of_sets[T](items).contains(x)
}

theorem list_inter_of_sets_contains_member[T](items: List[Set[T]], u: Set[T], z: T) {
    items.contains(u) and list_inter_of_sets[T](items).contains(z) implies u.contains(z)
}

define hausdorff_cover_family[T: TopologicalSpace](s: Set[T], x: T, v: Set[T]) -> Bool {
    exists(u: Set[T], y: T) {
        s.contains(y) and T.is_open(u) and T.is_open(v) and u.contains(x) and v.contains(y)
            and u.is_disjoint(v)
    }
}

theorem hausdorff_cover_family_iff[T: TopologicalSpace](s: Set[T], x: T, v: Set[T]) {
    hausdorff_cover_family(s, x, v) = exists(u: Set[T], y: T) {
        s.contains(y) and T.is_open(u) and T.is_open(v) and u.contains(x) and v.contains(y)
            and u.is_disjoint(v)
    }
}

let hausdorff_u_choice[T: TopologicalSpace](s: Set[T], x: T, v: Set[T]) -> result: Set[T] satisfy {
    hausdorff_cover_family(s, x, v) implies (T.is_open(result) and result.contains(x)
        and result.is_disjoint(v))
}

theorem hausdorff_u_choice_spec[T: TopologicalSpace](s: Set[T], x: T, v: Set[T]) {
    hausdorff_cover_family(s, x, v) implies (T.is_open(hausdorff_u_choice(s, x, v))
        and hausdorff_u_choice(s, x, v).contains(x)
        and hausdorff_u_choice(s, x, v).is_disjoint(v))
}

define hausdorff_u_list[T: TopologicalSpace](s: Set[T], x: T, items: List[Set[T]]) -> List[Set[T]] {
    match items {
        List.nil {
            List.nil[Set[T]]
        }
        List.cons(head, tail) {
            List.cons(hausdorff_u_choice(s, x, head), hausdorff_u_list(s, x, tail))
        }
    }
}

theorem hausdorff_u_list_nil[T: TopologicalSpace](s: Set[T], x: T) {
    hausdorff_u_list(s, x, List.nil[Set[T]]) = List.nil[Set[T]]
}

theorem hausdorff_u_list_cons[T: TopologicalSpace](s: Set[T], x: T, head: Set[T], tail: List[Set[T]]) {
    hausdorff_u_list(s, x, List.cons(head, tail)) =
        List.cons(hausdorff_u_choice(s, x, head), hausdorff_u_list(s, x, tail))
}

theorem hausdorff_u_list_contains_of_items_contains[T: TopologicalSpace](
    s: Set[T], x: T, items: List[Set[T]], v: Set[T]) {
    items.contains(v) implies hausdorff_u_list(s, x, items).contains(hausdorff_u_choice(s, x, v))
}

theorem hausdorff_u_list_all_open[T: TopologicalSpace](s: Set[T], x: T, items: List[Set[T]]) {
    is_subfamily[T](hausdorff_cover_family(s, x), items) implies
        (forall(u: Set[T]) { hausdorff_u_list(s, x, items).contains(u) implies T.is_open(u) })
}

theorem hausdorff_u_list_all_contains_x[T: TopologicalSpace](s: Set[T], x: T, items: List[Set[T]]) {
    is_subfamily[T](hausdorff_cover_family(s, x), items) implies
        (forall(u: Set[T]) { hausdorff_u_list(s, x, items).contains(u) implies u.contains(x) })
}

theorem compact_imp_closed_in_hausdorff[T: TopologicalSpace](s: Set[T]) {
    is_compact[T](s) and is_hausdorff[T](T.is_open) implies is_closed[T](s)
}

theorem compact_union_list[T: TopologicalSpace](items: List[Set[T]]) {
    (forall(k: Set[T]) { items.contains(k) implies is_compact[T](k) })
        implies is_compact[T](list_union_of_sets[T](items))
}

theorem metric_hausdorff_separating_balls[M: MetricSpace](x: M, y: M) {
    x != y implies exists(u: Set[M], v: Set[M]) {
        is_open_metric(u) and is_open_metric(v) and u.contains(x) and v.contains(y)
            and u.is_disjoint(v)
    }
}

theorem metric_topology_hausdorff[M: MetricSpace] {
    is_hausdorff[M](is_open_metric)
}

theorem metric_space_point_exists[M: MetricSpace] {
    exists(x: M) {
        true
    }
}

theorem metric_topological_separating_opens[M: MetricTopologicalSpace](x: M, y: M) {
    x != y implies exists(u: Set[M], v: Set[M]) {
        M.is_open(u) and M.is_open(v) and u.contains(x) and v.contains(y)
            and u.is_disjoint(v)
    }
}

theorem metric_topological_hausdorff[M: MetricTopologicalSpace] {
    is_hausdorff[M](M.is_open)
}

theorem compact_imp_closed_metric[M: MetricTopologicalSpace](s: Set[M]) {
    is_compact[M](s) implies is_closed_metric(s)
}

define unit_ball_cover_family[M: MetricSpace](s: Set[M], v: Set[M]) -> Bool {
    exists(y: M) {
        s.contains(y) and v = open_ball(y, Real.1)
    }
}

theorem unit_ball_cover_family_iff[M: MetricSpace](s: Set[M], v: Set[M]) {
    unit_ball_cover_family(s, v) = exists(y: M) {
        s.contains(y) and v = open_ball(y, Real.1)
    }
}

theorem bounded_union_list[M: MetricSpace](items: List[Set[M]]) {
    (forall(k: Set[M]) { items.contains(k) implies is_bounded(k) })
        implies is_bounded(list_union_of_sets[M](items))
}

theorem subfamily_member_imp_family_unit_ball[M: MetricSpace](
    s: Set[M], items: List[Set[M]], k: Set[M]) {
    is_subfamily[M](unit_ball_cover_family(s), items) and items.contains(k)
        implies unit_ball_cover_family(s, k)
}

theorem subfamily_member_is_unit_ball[M: MetricTopologicalSpace](
    s: Set[M], items: List[Set[M]], k: Set[M]) {
    is_subfamily[M](unit_ball_cover_family(s), items) and items.contains(k) implies is_bounded(k)
}

theorem compact_imp_bounded_metric[M: MetricTopologicalSpace](s: Set[M]) {
    is_compact[M](s) implies is_bounded(s)
}

theorem nat_zero_lte(n: Nat) {
    Nat.0 <= n
}

theorem real_lte_upper_bound_pair(a: Real, b: Real) {
    exists(c: Real) {
        a <= c and b <= c
    }
}

theorem sub_sub_cancel(a: Real, b: Real, c: Real) {
    (a - b) - (a - c) = c - b
}

theorem sub_minus_sub(a: Real, b: Real) {
    a - (a - b) = b
}

theorem add_sub_cancel(a: Real, b: Real) {
    a + (b - a) = b
}

define sequence_range_contains[M](q: Nat -> M, x: M) -> Bool {
    exists(n: Nat) { q(n) = x }
}

define sequence_range[M](q: Nat -> M) -> Set[M] {
    Set[M].new(sequence_range_contains(q))
}

theorem sequence_range_contains_eq[M](q: Nat -> M, x: M) {
    sequence_range(q).contains(x) = sequence_range_contains(q, x)
}

theorem sequence_range_contains_iff[M](q: Nat -> M, x: M) {
    sequence_range_contains(q, x) = exists(n: Nat) { q(n) = x }
}

theorem metric_subsequence_tendsto[M: MetricSpace](q: Nat -> M, f: Nat -> Nat, a: M) {
    is_monotone(f) and is_unbounded(f) and tendsto_metric(q, a)
    implies tendsto_metric(compose(q, f), a)
}

theorem cauchy_metric_seq_is_bounded[M: MetricSpace](q: Nat -> M) {
    is_cauchy_metric(q) implies is_bounded(sequence_range(q))
}

theorem tendsto_metric_seq_is_bounded[M: MetricSpace](q: Nat -> M, a: M) {
    tendsto_metric(q, a) implies is_bounded(sequence_range(q))
}

theorem tendsto_metric_in_closed_set[M: MetricSpace](s: Set[M], q: Nat -> M, a: M) {
    is_closed_metric(s) and (forall(n: Nat) { s.contains(q(n)) }) and tendsto_metric(q, a)
    implies s.contains(a)
}

theorem tendsto_metric_in_closed_interval(q: Nat -> Real, l: Real, lo: Real, hi: Real) {
    (forall(n: Nat) { closed_interval_set(lo, hi).contains(q(n)) })
    and tendsto_metric(q, l)
    implies closed_interval_set(lo, hi).contains(l)
}

theorem closed_set_in_complete_space_has_limit_in_set[M: CompleteMetricSpace](s: Set[M], q: Nat -> M) {
    is_closed_metric(s) and (forall(n: Nat) { s.contains(q(n)) }) and is_cauchy_metric(q)
    implies exists(a: M) { s.contains(a) and tendsto_metric(q, a) }
}

theorem real_is_open_imp_is_open_metric(s: Set[Real]) {
    Real.is_open(s) implies is_open_metric(s)
}

theorem is_open_metric_imp_real_is_open(s: Set[Real]) {
    is_open_metric(s) implies Real.is_open(s)
}

theorem real_is_open_eq_is_open_metric(s: Set[Real]) {
    Real.is_open(s) = is_open_metric(s)
}

instance Real: MetricTopologicalSpace

/// Closed intervals of the real line are metric-closed.
theorem closed_interval_is_closed_metric(lo: Real, hi: Real) {
    is_closed_metric(closed_interval_set(lo, hi))
}

theorem closed_interval_cauchy_metric_has_limit_in_interval(q: Nat -> Real, lo: Real, hi: Real) {
    (forall(n: Nat) { closed_interval_set(lo, hi).contains(q(n)) }) and is_cauchy_metric(q)
    implies exists(a: Real) { closed_interval_set(lo, hi).contains(a) and tendsto_metric(q, a) }
}

theorem real_lt_some_nat(x: Real) {
    exists(n: Nat) {
        x < from_nat[Real](n)
    }
}

theorem lt_nat_multiple(x: Real, eps: Real) {
    eps > Real.0 implies exists(n: Nat) {
        x < eps * from_nat[Real](n)
    }
}

define is_sequentially_compact[M: MetricSpace](s: Set[M]) -> Bool {
    forall(q: Nat -> M) {
        (forall(n: Nat) { s.contains(q(n)) }) implies exists(f: Nat -> Nat, a: M) {
            is_monotone(f) and is_unbounded(f) and s.contains(a) and tendsto_metric(compose(q, f), a)
        }
    }
}

theorem is_sequentially_compact_iff[M: MetricSpace](s: Set[M]) {
    is_sequentially_compact(s) = forall(q: Nat -> M) {
        (forall(n: Nat) { s.contains(q(n)) }) implies exists(f: Nat -> Nat, a: M) {
            is_monotone(f) and is_unbounded(f) and s.contains(a) and tendsto_metric(compose(q, f), a)
        }
    }
}

theorem sequentially_compact_subsequence[M: MetricSpace](s: Set[M], p: Nat -> M) {
    is_sequentially_compact(s) and (forall(n: Nat) { s.contains(p(n)) }) implies exists(f: Nat -> Nat, b: M) {
        is_monotone(f) and is_unbounded(f) and s.contains(b) and tendsto_metric(compose(p, f), b)
    }
}

theorem cauchy_metric_convergent_subsequence_imp_convergent[M: MetricSpace](
    q: Nat -> M, f: Nat -> Nat, a: M) {
    is_cauchy_metric(q) and is_monotone(f) and is_unbounded(f) and tendsto_metric(compose(q, f), a) implies tendsto_metric(q, a)
}

theorem sequentially_compact_imp_complete[M: MetricSpace] {
    is_sequentially_compact[M](Set[M].universal_set) implies forall(q: Nat -> M) {
        is_cauchy_metric(q) implies exists(a: M) { tendsto_metric(q, a) }
    }
}

theorem sequentially_compact_contains_limits[M: MetricSpace](s: Set[M], q: Nat -> M, a: M) {
    is_sequentially_compact(s) and (forall(n: Nat) { s.contains(q(n)) }) and tendsto_metric(q, a) implies s.contains(a)
}

theorem closed_interval_is_sequentially_compact(lo: Real, hi: Real) {
    is_sequentially_compact[Real](closed_interval_set(lo, hi))
}

theorem closed_interval_seq_compact_iff_compact(lo: Real, hi: Real) {
    is_sequentially_compact[Real](closed_interval_set(lo, hi)) = is_compact[Real](closed_interval_set(lo, hi))
}

theorem sequentially_compact_image[M: MetricTopologicalSpace, N: MetricTopologicalSpace](
    s: Set[M], f: M -> N) {
    is_sequentially_compact(s) and is_continuous(f) implies is_sequentially_compact(set_image(s, f))
}

theorem sequentially_compact_imp_bounded[M: MetricSpace](s: Set[M]) {
    is_sequentially_compact(s) implies is_bounded(s)
}

theorem continuous_seq_compact_bounded_above[M: MetricTopologicalSpace](s: Set[M], f: M -> Real) {
    is_sequentially_compact(s) and is_continuous(f) implies exists(b: Real) {
        forall(y: M) { s.contains(y) implies f(y) <= b }
    }
}

theorem continuous_seq_compact_bounded_below[M: MetricTopologicalSpace](s: Set[M], f: M -> Real) {
    is_sequentially_compact(s) and is_continuous(f) implies exists(b: Real) {
        forall(y: M) { s.contains(y) implies b <= f(y) }
    }
}

theorem from_nat_real_nonnegative(n: Nat) {
    Real.0 <= from_nat[Real](n)
}

theorem from_nat_real_lte(m: Nat, n: Nat) {
    m <= n implies from_nat[Real](m) <= from_nat[Real](n)
}

theorem div_le_div_pos(a: Real, b: Real, c: Real) {
    a <= b and Real.0 < c implies a / c <= b / c
}

define range_size(n: Nat) -> Real {
    from_nat[Real](n.suc)
}

theorem range_size_positive(n: Nat) {
    Real.0 < range_size(n)
}

define density_seq(p: Nat -> Bool, n: Nat) -> Real {
    from_nat[Real](count_upto(p, n.suc)) / range_size(n)
}

define has_natural_density(p: Nat -> Bool, d: Real) -> Bool {
    converges_to(density_seq(p), d)
}

theorem has_natural_density_apply(p: Nat -> Bool, d: Real) {
    has_natural_density(p, d) implies converges_to(density_seq(p), d)
}

theorem has_natural_density_intro(p: Nat -> Bool, d: Real) {
    converges_to(density_seq(p), d) implies has_natural_density(p, d)
}

theorem natural_density_unique(p: Nat -> Bool, d: Real, e: Real) {
    has_natural_density(p, d) and has_natural_density(p, e) implies d = e
}

theorem density_seq_all(n: Nat) {
    density_seq(all_pred, n) = Real.1
}

theorem density_seq_none(n: Nat) {
    density_seq(none_pred, n) = Real.0
}

theorem density_seq_le_one(p: Nat -> Bool, n: Nat) {
    density_seq(p, n) <= Real.1
}

theorem density_seq_nonnegative(p: Nat -> Bool, n: Nat) {
    Real.0 <= density_seq(p, n)
}

theorem density_seq_mono(p: Nat -> Bool, r: Nat -> Bool, n: Nat) {
    (forall(i: Nat) { p(i) implies r(i) }) implies density_seq(p, n) <= density_seq(r, n)
}

define eventually_all(p: Nat -> Bool) -> Bool {
    exists(n: Nat) {
        forall(m: Nat) {
            n <= m implies p(m)
        }
    }
}

theorem eventually_all_intro(p: Nat -> Bool, n: Nat) {
    (forall(m: Nat) { n <= m implies p(m) }) implies eventually_all(p)
}

theorem eventually_all_witness(p: Nat -> Bool) {
    eventually_all(p) implies exists(n: Nat) {
        forall(m: Nat) {
            n <= m implies p(m)
        }
    }
}

theorem eventually_all_of_all(p: Nat -> Bool) {
    (forall(m: Nat) { p(m) }) implies eventually_all(p)
}

theorem eventually_all_mono(p: Nat -> Bool, r: Nat -> Bool) {
    eventually_all(p) and (forall(i: Nat) { p(i) implies r(i) }) implies eventually_all(r)
}

define and_pred(p: Nat -> Bool, r: Nat -> Bool, i: Nat) -> Bool {
    p(i) and r(i)
}

theorem eventually_all_and(p: Nat -> Bool, r: Nat -> Bool) {
    eventually_all(p) and eventually_all(r)
        implies eventually_all(and_pred(p, r))
}

define tail_value(a: Nat -> Real, n: Nat, x: Real) -> Bool {
    exists(k: Nat) {
        n <= k and a(k) = x
    }
}

define tail_set(a: Nat -> Real, n: Nat) -> Set[Real] {
    Set[Real].new(tail_value(a, n))
}

theorem tail_set_contains_eq(a: Nat -> Real, n: Nat, x: Real) {
    tail_set(a, n).contains(x) = tail_value(a, n, x)
}

theorem tail_set_contains(a: Nat -> Real, n: Nat, k: Nat) {
    n <= k implies tail_set(a, n).contains(a(k))
}

theorem tail_set_witness(a: Nat -> Real, n: Nat, x: Real) {
    tail_set(a, n).contains(x) implies exists(k: Nat) { n <= k and a(k) = x }
}

theorem tail_set_nonempty(a: Nat -> Real, n: Nat) {
    is_nonempty(tail_set(a, n))
}

theorem tail_set_upper_bound(a: Nat -> Real, b: Real, n: Nat) {
    is_upper_bound(a, b) implies is_set_upper_bound(tail_set(a, n), b)
}

define is_bounded_above(a: Nat -> Real) -> Bool {
    exists(b: Real) {
        is_upper_bound(a, b)
    }
}

theorem is_bounded_above_intro(a: Nat -> Real, b: Real) {
    is_upper_bound(a, b) implies is_bounded_above(a)
}

theorem is_bounded_above_witness(a: Nat -> Real) {
    is_bounded_above(a) implies exists(b: Real) { is_upper_bound(a, b) }
}

let tail_sup(a: Nat -> Real, n: Nat) -> result: Real satisfy {
    is_bounded_above(a) implies is_set_supremum(tail_set(a, n), result)
}

theorem tail_sup_is_supremum(a: Nat -> Real, n: Nat) {
    is_bounded_above(a) implies is_set_supremum(tail_set(a, n), tail_sup(a, n))
}

theorem tail_sup_bounds_terms(a: Nat -> Real, n: Nat, k: Nat) {
    is_bounded_above(a) and n <= k implies a(k) <= tail_sup(a, n)
}

theorem tail_sup_is_least(a: Nat -> Real, n: Nat, b: Real) {
    is_bounded_above(a) and (forall(k: Nat) { n <= k implies a(k) <= b })
        implies tail_sup(a, n) <= b
}

theorem tail_set_subset(a: Nat -> Real, m: Nat, n: Nat) {
    m <= n implies tail_set(a, n).subset(tail_set(a, m))
}

theorem tail_sup_antitone(a: Nat -> Real, m: Nat, n: Nat) {
    is_bounded_above(a) and m <= n implies tail_sup(a, n) <= tail_sup(a, m)
}

theorem neg_reverses_lte(x: Real, y: Real) {
    x <= y implies -y <= -x
}

define is_bounded_below(a: Nat -> Real) -> Bool {
    exists(b: Real) {
        is_lower_bound(a, b)
    }
}

theorem is_bounded_below_intro(a: Nat -> Real, b: Real) {
    is_lower_bound(a, b) implies is_bounded_below(a)
}

theorem is_bounded_below_witness(a: Nat -> Real) {
    is_bounded_below(a) implies exists(b: Real) { is_lower_bound(a, b) }
}

theorem tail_sup_above_lower_bound(a: Nat -> Real, b: Real, n: Nat) {
    is_bounded_above(a) and is_lower_bound(a, b) implies b <= tail_sup(a, n)
}

define neg_tail_sup(a: Nat -> Real) -> (Nat -> Real) {
    function(n: Nat) {
        -tail_sup(a, n)
    }
}

theorem neg_tail_sup_increasing(a: Nat -> Real) {
    is_bounded_above(a) implies is_increasing(neg_tail_sup(a))
}

theorem neg_tail_sup_bounded(a: Nat -> Real, b: Real) {
    is_bounded_above(a) and is_lower_bound(a, b)
        implies is_upper_bound(neg_tail_sup(a), -b)
}

theorem neg_tail_sup_converges(a: Nat -> Real) {
    is_bounded_above(a) and is_bounded_below(a) implies converges(neg_tail_sup(a))
}

define limsup(a: Nat -> Real) -> Real {
    -limit(neg_tail_sup(a))
}

theorem limsup_le_tail_sup(a: Nat -> Real, n: Nat) {
    is_bounded_above(a) and is_bounded_below(a) implies limsup(a) <= tail_sup(a, n)
}

define neg_seq(a: Nat -> Real) -> (Nat -> Real) {
    function(n: Nat) {
        -a(n)
    }
}

theorem neg_seq_bounded_above(a: Nat -> Real) {
    is_bounded_below(a) implies is_bounded_above(neg_seq(a))
}

theorem neg_seq_bounded_below(a: Nat -> Real) {
    is_bounded_above(a) implies is_bounded_below(neg_seq(a))
}

define tail_inf(a: Nat -> Real, n: Nat) -> Real {
    -tail_sup(neg_seq(a), n)
}

theorem tail_inf_bounds_terms(a: Nat -> Real, n: Nat, k: Nat) {
    is_bounded_below(a) and n <= k implies tail_inf(a, n) <= a(k)
}

theorem tail_inf_is_greatest(a: Nat -> Real, n: Nat, b: Real) {
    is_bounded_below(a) and (forall(k: Nat) { n <= k implies b <= a(k) })
        implies b <= tail_inf(a, n)
}

define liminf(a: Nat -> Real) -> Real {
    -limsup(neg_seq(a))
}

theorem liminf_ge_tail_inf(a: Nat -> Real, n: Nat) {
    is_bounded_above(a) and is_bounded_below(a) implies tail_inf(a, n) <= liminf(a)
}

theorem tail_inf_le_tail_sup(a: Nat -> Real, m: Nat, n: Nat) {
    is_bounded_above(a) and is_bounded_below(a) implies tail_inf(a, m) <= tail_sup(a, n)
}

theorem liminf_eq_limit_tail_inf(a: Nat -> Real) {
    liminf(a) = limit(neg_tail_sup(neg_seq(a)))
}

theorem neg_tail_sup_neg_seq_eq_tail_inf(a: Nat -> Real, k: Nat) {
    neg_tail_sup(neg_seq(a))(k) = tail_inf(a, k)
}

theorem liminf_le_tail_sup(a: Nat -> Real, n: Nat) {
    is_bounded_above(a) and is_bounded_below(a) implies liminf(a) <= tail_sup(a, n)
}

theorem liminf_le_limsup(a: Nat -> Real) {
    is_bounded_above(a) and is_bounded_below(a) implies liminf(a) <= limsup(a)
}

theorem density_seq_bounded_above(p: Nat -> Bool) {
    is_bounded_above(density_seq(p))
}

theorem density_seq_bounded_below(p: Nat -> Bool) {
    is_bounded_below(density_seq(p))
}

define upper_density(p: Nat -> Bool) -> Real {
    limsup(density_seq(p))
}

define lower_density(p: Nat -> Bool) -> Real {
    liminf(density_seq(p))
}

theorem upper_density_le_one(p: Nat -> Bool) {
    upper_density(p) <= Real.1
}

theorem lower_density_nonneg(p: Nat -> Bool) {
    Real.0 <= lower_density(p)
}

theorem lower_density_le_upper_density(p: Nat -> Bool) {
    lower_density(p) <= upper_density(p)
}

theorem densities_in_unit_interval(p: Nat -> Bool) {
    Real.0 <= lower_density(p) and lower_density(p) <= upper_density(p)
        and upper_density(p) <= Real.1
}

theorem lte_of_lte_add_eps(x: Real, y: Real) {
    (forall(eps: Real) { eps.is_positive implies x <= y + eps }) implies x <= y
}

theorem limsup_le_limit(a: Nat -> Real, l: Real) {
    is_bounded_above(a) and is_bounded_below(a) and converges_to(a, l)
        implies limsup(a) <= l
}

theorem limit_le_limsup(a: Nat -> Real, l: Real) {
    is_bounded_above(a) and is_bounded_below(a) and converges_to(a, l)
        implies l <= limsup(a)
}

theorem limsup_eq_limit(a: Nat -> Real, l: Real) {
    is_bounded_above(a) and is_bounded_below(a) and converges_to(a, l)
        implies limsup(a) = l
}

theorem tail_sup_mono(a: Nat -> Real, b: Nat -> Real, n: Nat) {
    is_bounded_above(a) and is_bounded_above(b)
        and (forall(k: Nat) { a(k) <= b(k) })
        implies tail_sup(a, n) <= tail_sup(b, n)
}

theorem tail_inf_mono(a: Nat -> Real, b: Nat -> Real, n: Nat) {
    is_bounded_below(a) and is_bounded_below(b)
        and (forall(k: Nat) { a(k) <= b(k) })
        implies tail_inf(a, n) <= tail_inf(b, n)
}

theorem limsup_mono(a: Nat -> Real, b: Nat -> Real) {
    is_bounded_above(a) and is_bounded_below(a) and is_bounded_above(b)
        and is_bounded_below(b) and (forall(k: Nat) { a(k) <= b(k) })
        implies limsup(a) <= limsup(b)
}

theorem upper_density_mono(p: Nat -> Bool, r: Nat -> Bool) {
    (forall(i: Nat) { p(i) implies r(i) })
        implies upper_density(p) <= upper_density(r)
}

theorem liminf_mono(a: Nat -> Real, b: Nat -> Real) {
    is_bounded_above(a) and is_bounded_below(a) and is_bounded_above(b)
        and is_bounded_below(b) and (forall(k: Nat) { a(k) <= b(k) })
        implies liminf(a) <= liminf(b)
}

theorem lower_density_mono(p: Nat -> Bool, r: Nat -> Bool) {
    (forall(i: Nat) { p(i) implies r(i) })
        implies lower_density(p) <= lower_density(r)
}

theorem add_seq_bounded_above(a: Nat -> Real, b: Nat -> Real) {
    is_bounded_above(a) and is_bounded_above(b) implies is_bounded_above(add_seq(a, b))
}

theorem add_seq_bounded_below(a: Nat -> Real, b: Nat -> Real) {
    is_bounded_below(a) and is_bounded_below(b) implies is_bounded_below(add_seq(a, b))
}

theorem tail_sup_add(a: Nat -> Real, b: Nat -> Real, n: Nat) {
    is_bounded_above(a) and is_bounded_above(b)
        implies tail_sup(add_seq(a, b), n) <= tail_sup(a, n) + tail_sup(b, n)
}

theorem limsup_add(a: Nat -> Real, b: Nat -> Real) {
    is_bounded_above(a) and is_bounded_below(a) and is_bounded_above(b)
        and is_bounded_below(b)
        implies limsup(add_seq(a, b)) <= limsup(a) + limsup(b)
}

theorem nat_lte_trans(a: Nat, b: Nat, c: Nat) {
    a <= b and b <= c implies a <= c
}

define or_pred(p: Nat -> Bool, r: Nat -> Bool) -> (Nat -> Bool) {
    function(i: Nat) {
        p(i) or r(i)
    }
}

theorem or_pred_apply(p: Nat -> Bool, r: Nat -> Bool, i: Nat) {
    or_pred(p, r)(i) = (p(i) or r(i))
}

theorem count_upto_or_le(p: Nat -> Bool, r: Nat -> Bool, n: Nat) {
    count_upto(or_pred(p, r), n) <= count_upto(p, n) + count_upto(r, n)
}

theorem density_seq_or_le(p: Nat -> Bool, r: Nat -> Bool, n: Nat) {
    density_seq(or_pred(p, r), n) <= density_seq(p, n) + density_seq(r, n)
}

theorem upper_density_subadditive(p: Nat -> Bool, r: Nat -> Bool) {
    upper_density(or_pred(p, r)) <= upper_density(p) + upper_density(r)
}

theorem lte_of_mul_lte_pos(x: Real, y: Real, c: Real) {
    x * c <= y * c and c > Real.0 implies x <= y
}

theorem density_seq_times_range(p: Nat -> Bool, n: Nat) {
    density_seq(p, n) * range_size(n) = from_nat[Real](count_upto(p, n.suc))
}

theorem residue_density_seq_upper(m: Nat, a: Nat, eps: Real, n: Nat) {
    a < m and eps > Real.0 and from_nat[Real](m) <= eps * range_size(n)
        implies from_nat[Real](m) * density_seq(in_residue_class(m, a), n)
            <= Real.1 + eps
}

theorem residue_density_seq_lower(m: Nat, a: Nat, eps: Real, n: Nat) {
    a < m and eps > Real.0 and from_nat[Real](m) <= eps * range_size(n)
        implies Real.1 - eps
            <= from_nat[Real](m) * density_seq(in_residue_class(m, a), n)
}

theorem from_nat_modulus_pos(m: Nat) {
    Nat.1 <= m implies from_nat[Real](m) > Real.0
}

theorem residue_range_long_enough(m: Nat, eps: Real, big_m: Nat, n: Nat) {
    eps > Real.0 and from_nat[Real](m) < eps * from_nat[Real](big_m) and big_m <= n
        implies from_nat[Real](m) <= eps * range_size(n)
}

theorem residue_upper_density_le_one(m: Nat, a: Nat) {
    a < m implies from_nat[Real](m) * upper_density(in_residue_class(m, a)) <= Real.1
}

theorem residue_lower_density_ge_one(m: Nat, a: Nat) {
    a < m implies Real.1 <= from_nat[Real](m) * lower_density(in_residue_class(m, a))
}

theorem residue_class_density(m: Nat, a: Nat) {
    a < m implies from_nat[Real](m) * lower_density(in_residue_class(m, a)) = Real.1
        and from_nat[Real](m) * upper_density(in_residue_class(m, a)) = Real.1
}

theorem upper_density_none {
    upper_density(none_pred) <= Real.0
}

theorem upper_density_residue_class(m: Nat, a: Nat) {
    a < m implies upper_density(in_residue_class(m, a)) = Real.1 / from_nat[Real](m)
}

define covers_nat(system: List[Pair[Nat, Nat]]) -> (Nat -> Bool) {
    match system {
        List.nil {
            none_pred
        }
        List.cons(head, tail) {
            or_pred(in_residue_class(head.first, head.second), covers_nat(tail))
        }
    }
}

define system_density_real(system: List[Pair[Nat, Nat]]) -> Real {
    match system {
        List.nil {
            Real.0
        }
        List.cons(head, tail) {
            Real.1 / from_nat[Real](head.first) + system_density_real(tail)
        }
    }
}

define system_reduced(system: List[Pair[Nat, Nat]]) -> Bool {
    forall(cl: Pair[Nat, Nat]) {
        system.contains(cl) implies cl.second < cl.first
    }
}

theorem covers_nat_cons(head: Pair[Nat, Nat], tail: List[Pair[Nat, Nat]]) {
    covers_nat(List.cons(head, tail))
        = or_pred(in_residue_class(head.first, head.second), covers_nat(tail))
}

theorem covers_nat_nil {
    covers_nat(List.nil[Pair[Nat, Nat]]) = none_pred
}

theorem system_density_real_cons(head: Pair[Nat, Nat], tail: List[Pair[Nat, Nat]]) {
    system_density_real(List.cons(head, tail))
        = Real.1 / from_nat[Real](head.first) + system_density_real(tail)
}

theorem system_density_real_nil {
    system_density_real(List.nil[Pair[Nat, Nat]]) = Real.0
}

theorem system_reduced_head(head: Pair[Nat, Nat], tail: List[Pair[Nat, Nat]]) {
    system_reduced(List.cons(head, tail)) implies head.second < head.first
}

theorem system_reduced_tail(head: Pair[Nat, Nat], tail: List[Pair[Nat, Nat]]) {
    system_reduced(List.cons(head, tail)) implies system_reduced(tail)
}

theorem upper_density_covers_nat_le(system: List[Pair[Nat, Nat]]) {
    system_reduced(system)
        implies upper_density(covers_nat(system)) <= system_density_real(system)
}

theorem limit_le_liminf(a: Nat -> Real, l: Real) {
    is_bounded_above(a) and is_bounded_below(a) and converges_to(a, l)
        implies l <= liminf(a)
}

theorem liminf_le_limit(a: Nat -> Real, l: Real) {
    is_bounded_above(a) and is_bounded_below(a) and converges_to(a, l)
        implies liminf(a) <= l
}

theorem liminf_eq_limit(a: Nat -> Real, l: Real) {
    is_bounded_above(a) and is_bounded_below(a) and converges_to(a, l)
        implies liminf(a) = l
}

theorem upper_density_of_natural_density(p: Nat -> Bool, d: Real) {
    has_natural_density(p, d) implies upper_density(p) = d
}

theorem lower_density_of_natural_density(p: Nat -> Bool, d: Real) {
    has_natural_density(p, d) implies lower_density(p) = d
}

theorem densities_agree_of_natural_density(p: Nat -> Bool, d: Real) {
    has_natural_density(p, d)
        implies lower_density(p) = d and upper_density(p) = d
}

define not_pred(p: Nat -> Bool) -> (Nat -> Bool) {
    function(i: Nat) {
        not p(i)
    }
}

theorem not_pred_apply(p: Nat -> Bool, i: Nat) {
    not_pred(p)(i) = not p(i)
}

theorem count_upto_complement_np(p: Nat -> Bool, n: Nat) {
    count_upto(not_pred(p), n) + count_upto(p, n) = n
}

theorem density_seq_complement(p: Nat -> Bool, n: Nat) {
    density_seq(not_pred(p), n) = Real.1 - density_seq(p, n)
}

theorem one_sub_is_close(x: Real, y: Real, eps: Real) {
    x.is_close(y, eps) implies (Real.1 - x).is_close(Real.1 - y, eps)
}

theorem density_seq_complement_is_close(p: Nat -> Bool, d: Real, eps: Real, i: Nat) {
    density_seq(p, i).is_close(d, eps)
        implies density_seq(not_pred(p), i).is_close(Real.1 - d, eps)
}

theorem one_minus_flip(x: Real, y: Real) {
    Real.1 - x <= y implies Real.1 - y <= x
}

define one_minus_seq(a: Nat -> Real) -> (Nat -> Real) {
    function(n: Nat) {
        Real.1 - a(n)
    }
}

theorem one_minus_bounded_above(a: Nat -> Real) {
    is_bounded_below(a) implies is_bounded_above(one_minus_seq(a))
}

theorem one_minus_bounded_below(a: Nat -> Real) {
    is_bounded_above(a) implies is_bounded_below(one_minus_seq(a))
}

theorem tail_sup_one_minus(a: Nat -> Real, n: Nat) {
    is_bounded_above(a) and is_bounded_below(a)
        implies tail_sup(one_minus_seq(a), n) = Real.1 - tail_inf(a, n)
}

theorem neg_tail_sup_one_minus(a: Nat -> Real, n: Nat) {
    is_bounded_above(a) and is_bounded_below(a)
        implies neg_tail_sup(one_minus_seq(a))(n)
            = add_seq(neg_tail_sup(neg_seq(a)), constant[Nat, Real](-Real.1))(n)
}

theorem limsup_one_minus(a: Nat -> Real) {
    is_bounded_above(a) and is_bounded_below(a)
        implies limsup(one_minus_seq(a)) = Real.1 - liminf(a)
}

theorem density_seq_complement_eq(p: Nat -> Bool) {
    density_seq(not_pred(p)) = one_minus_seq(density_seq(p))
}

theorem upper_density_complement(p: Nat -> Bool) {
    upper_density(not_pred(p)) = Real.1 - lower_density(p)
}

theorem one_minus_one_minus(x: Real) {
    Real.1 - (Real.1 - x) = x
}

theorem add_one_minus(x: Real) {
    x + (Real.1 - x) = Real.1
}

theorem one_minus_seq_involution(a: Nat -> Real) {
    one_minus_seq(one_minus_seq(a)) = a
}

theorem liminf_one_minus(a: Nat -> Real) {
    is_bounded_above(a) and is_bounded_below(a)
        implies liminf(one_minus_seq(a)) = Real.1 - limsup(a)
}

theorem not_pred_involution(p: Nat -> Bool) {
    not_pred(not_pred(p)) = p
}

theorem lower_density_complement(p: Nat -> Bool) {
    lower_density(not_pred(p)) = Real.1 - upper_density(p)
}

theorem upper_density_add_lower_density_complement(p: Nat -> Bool) {
    upper_density(p) + lower_density(not_pred(p)) = Real.1
}

theorem upper_density_one_iff_complement_lower_zero(p: Nat -> Bool) {
    (upper_density(p) = Real.1) = (lower_density(not_pred(p)) = Real.0)
}

theorem lower_density_one_iff_complement_upper_zero(p: Nat -> Bool) {
    (lower_density(p) = Real.1) = (upper_density(not_pred(p)) = Real.0)
}

theorem tail_inf_add(a: Nat -> Real, b: Nat -> Real, n: Nat) {
    is_bounded_below(a) and is_bounded_below(b)
        implies tail_inf(a, n) + tail_inf(b, n) <= tail_inf(add_seq(a, b), n)
}

theorem liminf_add(a: Nat -> Real, b: Nat -> Real) {
    is_bounded_above(a) and is_bounded_below(a) and is_bounded_above(b)
        and is_bounded_below(b)
        implies liminf(a) + liminf(b) <= liminf(add_seq(a, b))
}

define disjoint_pred(p: Nat -> Bool, r: Nat -> Bool) -> Bool {
    forall(i: Nat) {
        not (p(i) and r(i))
    }
}

theorem disjoint_pred_apply(p: Nat -> Bool, r: Nat -> Bool, i: Nat) {
    disjoint_pred(p, r) implies not (p(i) and r(i))
}

theorem count_upto_or_disjoint(p: Nat -> Bool, r: Nat -> Bool, n: Nat) {
    disjoint_pred(p, r)
        implies count_upto(or_pred(p, r), n) = count_upto(p, n) + count_upto(r, n)
}

theorem density_seq_or_disjoint(p: Nat -> Bool, r: Nat -> Bool, n: Nat) {
    disjoint_pred(p, r)
        implies density_seq(or_pred(p, r), n) = density_seq(p, n) + density_seq(r, n)
}

theorem lower_density_superadditive(p: Nat -> Bool, r: Nat -> Bool) {
    disjoint_pred(p, r)
        implies lower_density(p) + lower_density(r) <= lower_density(or_pred(p, r))
}

theorem count_upto_of_holds_from(p: Nat -> Bool, big_n: Nat, n: Nat) {
    (forall(m: Nat) { big_n <= m implies p(m) })
        implies n <= count_upto(p, n) + big_n
}

theorem density_seq_ge_of_holds_from(
    p: Nat -> Bool, big_n: Nat, eps: Real, k: Nat
) {
    (forall(m: Nat) { big_n <= m implies p(m) }) and eps > Real.0
        and from_nat[Real](big_n) <= eps * range_size(k)
        implies Real.1 - eps <= density_seq(p, k)
}

theorem lower_density_of_eventually_all(p: Nat -> Bool) {
    eventually_all(p) implies lower_density(p) = Real.1
}

theorem upper_density_of_eventually_all(p: Nat -> Bool) {
    eventually_all(p) implies upper_density(p) = Real.1
}

theorem densities_of_all(p: Nat -> Bool) {
    (forall(m: Nat) { p(m) })
        implies lower_density(p) = Real.1 and upper_density(p) = Real.1
}

theorem densities_of_and(p: Nat -> Bool, r: Nat -> Bool) {
    eventually_all(p) and eventually_all(r)
        implies lower_density(and_pred(p, r)) = Real.1
            and upper_density(and_pred(p, r)) = Real.1
}

theorem lower_density_residue_class(m: Nat, a: Nat) {
    a < m implies lower_density(in_residue_class(m, a)) = Real.1 / from_nat[Real](m)
}

define head_disjoint_nat(head: Pair[Nat, Nat], rest: List[Pair[Nat, Nat]]) -> Bool {
    disjoint_pred(in_residue_class(head.first, head.second), covers_nat(rest))
}

theorem disjoint_cons_bound(head: Pair[Nat, Nat], tail: List[Pair[Nat, Nat]]) {
    head.second < head.first and head_disjoint_nat(head, tail)
        and system_density_real(tail) <= lower_density(covers_nat(tail))
        implies system_density_real(List.cons(head, tail))
            <= lower_density(covers_nat(List.cons(head, tail)))
}

define is_suffix_of(part: List[Pair[Nat, Nat]], whole: List[Pair[Nat, Nat]]) -> Bool {
    exists(front: List[Pair[Nat, Nat]]) {
        front + part = whole
    }
}

theorem is_suffix_of_refl(whole: List[Pair[Nat, Nat]]) {
    is_suffix_of(whole, whole)
}

theorem is_suffix_of_cons(part: List[Pair[Nat, Nat]], head: Pair[Nat, Nat],
    tail: List[Pair[Nat, Nat]]) {
    is_suffix_of(part, tail) implies is_suffix_of(part, List.cons(head, tail))
}

define system_disjoint_nat(system: List[Pair[Nat, Nat]]) -> Bool {
    forall(head: Pair[Nat, Nat], tail: List[Pair[Nat, Nat]]) {
        is_suffix_of(List.cons(head, tail), system) implies head_disjoint_nat(head, tail)
    }
}

theorem system_disjoint_nat_head(head: Pair[Nat, Nat], tail: List[Pair[Nat, Nat]]) {
    system_disjoint_nat(List.cons(head, tail)) implies head_disjoint_nat(head, tail)
}

theorem system_disjoint_nat_tail(head: Pair[Nat, Nat], tail: List[Pair[Nat, Nat]]) {
    system_disjoint_nat(List.cons(head, tail)) implies system_disjoint_nat(tail)
}

theorem system_density_real_le_lower_density(system: List[Pair[Nat, Nat]]) {
    system_reduced(system) and system_disjoint_nat(system)
        implies system_density_real(system) <= lower_density(covers_nat(system))
}

theorem disjoint_system_density_le_one(system: List[Pair[Nat, Nat]]) {
    system_reduced(system) and system_disjoint_nat(system)
        implies system_density_real(system) <= Real.1
}

typeclass G: NormedAddCommGroup extends AddCommGroup {
    /// The norm of a group element.
    norm: G -> Real

    /// Rule: only the zero element has norm zero.
    norm_eq_zero_imp_zero(x: G) {
        x.norm = 0 implies x = G.0
    }

    /// Rule: the zero element has norm zero.
    norm_zero {
        G.0.norm = 0
    }

    /// Rule: the norm is invariant under negation.
    norm_neg(x: G) {
        (-x).norm = x.norm
    }

    /// Rule: the norm satisfies the triangle inequality.
    norm_triangle(x: G, y: G) {
        (x + y).norm <= x.norm + y.norm
    }
}

theorem norm_non_negative[G: NormedAddCommGroup](x: G) {
    0 <= x.norm
}

theorem norm_eq_zero_iff[G: NormedAddCommGroup](x: G) {
    (x.norm = 0) = (x = G.0)
}

theorem norm_sub_norm_le[G: NormedAddCommGroup](x: G, y: G) {
    x.norm - y.norm <= (x - y).norm
}

theorem norm_sub_symm[G: NormedAddCommGroup](x: G, y: G) {
    (x - y).norm = (y - x).norm
}

define norm_distance[G: NormedAddCommGroup](x: G, y: G) -> Real {
    (x - y).norm
}

theorem norm_distance_self[G: NormedAddCommGroup](x: G) {
    norm_distance(x, x) = 0
}

theorem norm_distance_symm[G: NormedAddCommGroup](x: G, y: G) {
    norm_distance(x, y) = norm_distance(y, x)
}

theorem norm_distance_triangle[G: NormedAddCommGroup](x: G, y: G, z: G) {
    norm_distance(x, z) <= norm_distance(x, y) + norm_distance(y, z)
}

theorem norm_distance_non_negative[G: NormedAddCommGroup](x: G, y: G) {
    0 <= norm_distance(x, y)
}

theorem norm_sub_eq_zero_iff[G: NormedAddCommGroup](x: G, y: G) {
    ((x - y).norm = 0) = (x = y)
}

theorem norm_distance_eq_zero_iff[G: NormedAddCommGroup](x: G, y: G) {
    (norm_distance(x, y) = 0) = (x = y)
}

theorem norm_add_le_of_le[G: NormedAddCommGroup](x: G, y: G, a: Real, b: Real) {
    x.norm <= a and y.norm <= b implies (x + y).norm <= a + b
}

theorem norm_sub_norm_le_swap[G: NormedAddCommGroup](x: G, y: G) {
    y.norm - x.norm <= (x - y).norm
}

theorem norm_distance_left_eq[G: NormedAddCommGroup](x: G, y: G) {
    norm_distance(x, y) = (x - y).norm
}

theorem norm_sub_non_negative[G: NormedAddCommGroup](x: G, y: G) {
    0 <= (x - y).norm
}

theorem norm_distance_zero[G: NormedAddCommGroup](x: G) {
    norm_distance(x, G.0) = x.norm
}

theorem norm_distance_from_zero[G: NormedAddCommGroup](x: G) {
    norm_distance(G.0, x) = x.norm
}

theorem norm_sub_le_add[G: NormedAddCommGroup](x: G, y: G) {
    (x - y).norm <= x.norm + y.norm
}

theorem norm_distance_zero_imp_eq[G: NormedAddCommGroup](x: G, y: G) {
    norm_distance(x, y) = 0 implies x = y
}

define in_norm_open_ball[G: NormedAddCommGroup](x: G, r: Real, y: G) -> Bool {
    norm_distance(y, x) < r
}

define norm_open_ball[G: NormedAddCommGroup](x: G, r: Real) -> Set[G] {
    Set[G].new(in_norm_open_ball(x, r))
}

define in_norm_closed_ball[G: NormedAddCommGroup](x: G, r: Real, y: G) -> Bool {
    norm_distance(y, x) <= r
}

define norm_closed_ball[G: NormedAddCommGroup](x: G, r: Real) -> Set[G] {
    Set[G].new(in_norm_closed_ball(x, r))
}

theorem norm_open_ball_contains_iff[G: NormedAddCommGroup](x: G, r: Real, y: G) {
    norm_open_ball(x, r).contains(y) = (norm_distance(y, x) < r)
}

theorem norm_closed_ball_contains_iff[G: NormedAddCommGroup](x: G, r: Real, y: G) {
    norm_closed_ball(x, r).contains(y) = (norm_distance(y, x) <= r)
}

theorem in_norm_open_ball_iff_distance[G: NormedAddCommGroup](x: G, r: Real, y: G) {
    in_norm_open_ball(x, r, y) = (norm_distance(y, x) < r)
}

theorem in_norm_closed_ball_iff_distance[G: NormedAddCommGroup](x: G, r: Real, y: G) {
    in_norm_closed_ball(x, r, y) = (norm_distance(y, x) <= r)
}

theorem center_in_norm_open_ball[G: NormedAddCommGroup](x: G, r: Real) {
    r.is_positive implies norm_open_ball(x, r).contains(x)
}

theorem center_in_norm_closed_ball[G: NormedAddCommGroup](x: G, r: Real) {
    not r.is_negative implies norm_closed_ball(x, r).contains(x)
}

theorem norm_open_ball_subset_closed_ball[G: NormedAddCommGroup](x: G, r: Real) {
    norm_open_ball(x, r).subset(norm_closed_ball(x, r))
}

theorem norm_open_ball_nonpositive_radius_empty[G: NormedAddCommGroup](x: G, r: Real, y: G) {
    not r.is_positive implies not norm_open_ball(x, r).contains(y)
}

theorem norm_closed_ball_negative_radius_empty[G: NormedAddCommGroup](x: G, r: Real, y: G) {
    r.is_negative implies not norm_closed_ball(x, r).contains(y)
}

theorem norm_open_ball_contains_symmetric[G: NormedAddCommGroup](x: G, r: Real, y: G) {
    norm_open_ball(x, r).contains(y) = norm_open_ball(y, r).contains(x)
}

theorem norm_closed_ball_contains_symmetric[G: NormedAddCommGroup](x: G, r: Real, y: G) {
    norm_closed_ball(x, r).contains(y) = norm_closed_ball(y, r).contains(x)
}

define norm_is_bounded[G: NormedAddCommGroup](s: Set[G]) -> Bool {
    exists(x: G, r: Real) {
        s.subset(norm_closed_ball(x, r))
    }
}

theorem norm_closed_ball_is_bounded[G: NormedAddCommGroup](x: G, r: Real) {
    norm_is_bounded(norm_closed_ball(x, r))
}

theorem subset_of_norm_bounded_is_norm_bounded[G: NormedAddCommGroup](s: Set[G], t: Set[G]) {
    s.subset(t) and norm_is_bounded(t) implies norm_is_bounded(s)
}

theorem norm_singleton_is_bounded[G: NormedAddCommGroup](x: G) {
    norm_is_bounded(Set[G].singleton(x))
}

theorem norm_open_ball_is_bounded[G: NormedAddCommGroup](x: G, r: Real) {
    norm_is_bounded(norm_open_ball(x, r))
}

theorem norm_distance_add_right[G: NormedAddCommGroup](x: G, y: G, z: G) {
    norm_distance(x + z, y + z) = norm_distance(x, y)
}

theorem norm_open_ball_contains_add_right_iff[G: NormedAddCommGroup](x: G, r: Real, y: G, z: G) {
    norm_open_ball(x + z, r).contains(y + z) = norm_open_ball(x, r).contains(y)
}

theorem norm_closed_ball_contains_add_right_iff[G: NormedAddCommGroup](x: G, r: Real, y: G, z: G) {
    norm_closed_ball(x + z, r).contains(y + z) = norm_closed_ball(x, r).contains(y)
}

define norm_translate[G: NormedAddCommGroup](z: G, x: G) -> G {
    x + z
}

define norm_translate_set[G: NormedAddCommGroup](s: Set[G], z: G) -> Set[G] {
    set_image(s, norm_translate(z))
}

theorem norm_translate_set_contains_translate[G: NormedAddCommGroup](s: Set[G], z: G, x: G) {
    s.contains(x) implies norm_translate_set(s, z).contains(x + z)
}

theorem norm_translate_open_ball_subset[G: NormedAddCommGroup](x: G, r: Real, z: G) {
    norm_translate_set(norm_open_ball(x, r), z).subset(norm_open_ball(x + z, r))
}

theorem norm_translate_closed_ball_subset[G: NormedAddCommGroup](x: G, r: Real, z: G) {
    norm_translate_set(norm_closed_ball(x, r), z).subset(norm_closed_ball(x + z, r))
}

typeclass K: NormedField extends Field, NormedAddCommGroup {
    /// Rule: the norm is multiplicative on the field.
    norm_mul(a: K, b: K) {
        (a * b).norm = a.norm * b.norm
    }
}

theorem norm_one[K: NormedField] {
    K.1.norm = 1
}

theorem norm_pos_of_ne_zero[K: NormedField](a: K) {
    a != K.0 implies a.norm.is_positive
}

theorem norm_inverse[K: NormedField](a: K) {
    a.norm.inverse = a.inverse.norm
}

theorem norm_inverse_div[K: NormedField](a: K) {
    a != K.0 implies a.inverse.norm = 1 / a.norm
}

theorem norm_mul_inverse[K: NormedField](a: K, b: K) {
    (a * b.inverse).norm = a.norm * b.inverse.norm
}

theorem norm_inverse_non_negative[K: NormedField](a: K) {
    0 <= a.inverse.norm
}

theorem norm_inverse_pos[K: NormedField](a: K) {
    a != K.0 implies a.inverse.norm.is_positive
}

theorem norm_mul_non_negative[K: NormedField](a: K, b: K) {
    0 <= a.norm * b.norm
}

theorem norm_mul_pos_of_ne_zero[K: NormedField](a: K, b: K) {
    a != K.0 and b != K.0 implies (a * b).norm.is_positive
}

theorem norm_mul_inverse_div[K: NormedField](a: K, b: K) {
    b != K.0 implies (a * b.inverse).norm = a.norm / b.norm
}

define norm_smul_constraint[K: NormedField, V: NormedAddCommGroup](smul: K -> V -> V) -> Bool {
    forall(r: K, v: V) {
        smul(r, v).norm = r.norm * v.norm
    }
}

structure NormedSpace[K: NormedField, V: NormedAddCommGroup] {
    /// The underlying `K`-module structure.
    module: Module[K, V]
} constraint {
    norm_smul_constraint(module.smul)
}

theorem normed_space_norm_smul[K: NormedField, V: NormedAddCommGroup](
    ns: NormedSpace[K, V], r: K, v: V) {
    ns.module.smul(r, v).norm = r.norm * v.norm
}

theorem normed_space_smul_zero_scalar[K: NormedField, V: NormedAddCommGroup](
    ns: NormedSpace[K, V], v: V) {
    ns.module.smul(K.0, v) = V.0
}

theorem normed_space_smul_zero_vector[K: NormedField, V: NormedAddCommGroup](
    ns: NormedSpace[K, V], r: K) {
    ns.module.smul(r, V.0) = V.0
}

theorem normed_space_norm_smul_neg_scalar[K: NormedField, V: NormedAddCommGroup](
    ns: NormedSpace[K, V], r: K, v: V) {
    ns.module.smul(-r, v).norm = ns.module.smul(r, v).norm
}

theorem normed_space_norm_smul_neg_vector[K: NormedField, V: NormedAddCommGroup](
    ns: NormedSpace[K, V], r: K, v: V) {
    ns.module.smul(r, -v).norm = ns.module.smul(r, v).norm
}

theorem normed_space_norm_smul_unit[K: NormedField, V: NormedAddCommGroup](
    ns: NormedSpace[K, V], r: K, v: V) {
    r.norm = 1 implies ns.module.smul(r, v).norm = v.norm
}

theorem normed_space_smul_one[K: NormedField, V: NormedAddCommGroup](
    ns: NormedSpace[K, V], v: V) {
    ns.module.smul(K.1, v) = v
}

theorem normed_space_norm_smul_non_negative[K: NormedField, V: NormedAddCommGroup](
    ns: NormedSpace[K, V], r: K, v: V) {
    0 <= ns.module.smul(r, v).norm
}

theorem normed_space_norm_smul_add[K: NormedField, V: NormedAddCommGroup](
    ns: NormedSpace[K, V], r: K, u: V, v: V) {
    ns.module.smul(r, u + v).norm <= r.norm * u.norm + r.norm * v.norm
}

theorem normed_space_norm_distance_smul[K: NormedField, V: NormedAddCommGroup](
    ns: NormedSpace[K, V], r: K, u: V, v: V) {
    norm_distance(ns.module.smul(r, u), ns.module.smul(r, v)) = r.norm * norm_distance(u, v)
}

define normed_space_smul_map[K: NormedField, V: NormedAddCommGroup](
    ns: NormedSpace[K, V], r: K, v: V) -> V {
    ns.module.smul(r, v)
}

define normed_space_smul_set[K: NormedField, V: NormedAddCommGroup](
    ns: NormedSpace[K, V], r: K, s: Set[V]) -> Set[V] {
    set_image(s, normed_space_smul_map(ns, r))
}

theorem normed_space_smul_set_contains_smul[K: NormedField, V: NormedAddCommGroup](
    ns: NormedSpace[K, V], r: K, s: Set[V], v: V) {
    s.contains(v) implies normed_space_smul_set(ns, r, s).contains(ns.module.smul(r, v))
}

theorem normed_space_smul_set_contains_iff_of_ne_zero[K: NormedField, V: NormedAddCommGroup](
    ns: NormedSpace[K, V], r: K, s: Set[V], y: V
) {
    r != K.0 implies
        normed_space_smul_set(ns, r, s).contains(y) = s.contains(ns.module.smul(r.inverse, y))
}

theorem normed_space_smul_open_ball_subset[K: NormedField, V: NormedAddCommGroup](
    ns: NormedSpace[K, V], r: K, x: V, eps: Real) {
    r.norm.is_positive implies
        normed_space_smul_set(ns, r, norm_open_ball(x, eps)).subset(
            norm_open_ball(ns.module.smul(r, x), r.norm * eps))
}

theorem normed_space_smul_closed_ball_subset[K: NormedField, V: NormedAddCommGroup](
    ns: NormedSpace[K, V], r: K, x: V, eps: Real) {
    normed_space_smul_set(ns, r, norm_closed_ball(x, eps)).subset(
        norm_closed_ball(ns.module.smul(r, x), r.norm * eps))
}

define parametrises_solutions[P, X](cond: X -> Bool, sol: P -> X) -> Bool {
    forall(t: P) {
        cond(sol(t))
    }
}

theorem parametrises_solutions_apply[P, X](cond: X -> Bool, sol: P -> X, t: P) {
    parametrises_solutions(cond, sol) implies cond(sol(t))
}

theorem parametrises_solutions_intro[P, X](cond: X -> Bool, sol: P -> X) {
    (forall(t: P) { cond(sol(t)) }) implies parametrises_solutions(cond, sol)
}

theorem parametrises_solutions_compose[P, Q, X](
    cond: X -> Bool, sol: P -> X, reindex: Q -> P
) {
    parametrises_solutions(cond, sol)
        implies parametrises_solutions(cond, compose(sol, reindex))
}

define solution_set[X](cond: X -> Bool) -> Set[X] {
    Set[X].new(cond)
}

theorem solution_set_contains_eq[X](cond: X -> Bool, x: X) {
    solution_set(cond).contains(x) = cond(x)
}

theorem parametrised_value_in_solution_set[P, X](
    cond: X -> Bool, sol: P -> X, t: P
) {
    parametrises_solutions(cond, sol) implies solution_set(cond).contains(sol(t))
}

theorem injective_parametrisation_distinct[P, X](
    cond: X -> Bool, sol: P -> X, s: P, t: P
) {
    is_injective_fn(sol) and s != t implies sol(s) != sol(t)
}

define embeds_solutions[P, X](cond: X -> Bool, sol: P -> X) -> Bool {
    parametrises_solutions(cond, sol) and is_injective_fn(sol)
}

theorem embeds_solutions_parametrises[P, X](cond: X -> Bool, sol: P -> X) {
    embeds_solutions(cond, sol) implies parametrises_solutions(cond, sol)
}

theorem embeds_solutions_injective[P, X](cond: X -> Bool, sol: P -> X) {
    embeds_solutions(cond, sol) implies is_injective_fn(sol)
}

theorem embeds_solutions_intro[P, X](cond: X -> Bool, sol: P -> X) {
    parametrises_solutions(cond, sol) and is_injective_fn(sol)
        implies embeds_solutions(cond, sol)
}

theorem parametrises_solutions_weaken[P, X](
    cond: X -> Bool, weaker: X -> Bool, sol: P -> X
) {
    parametrises_solutions(cond, sol) and (forall(x: X) { cond(x) implies weaker(x) })
        implies parametrises_solutions(weaker, sol)
}

theorem embeds_solutions_weaken[P, X](
    cond: X -> Bool, weaker: X -> Bool, sol: P -> X
) {
    embeds_solutions(cond, sol) and (forall(x: X) { cond(x) implies weaker(x) })
        implies embeds_solutions(weaker, sol)
}

theorem embeds_solutions_compose[P, Q, X](
    cond: X -> Bool, sol: P -> X, reindex: Q -> P
) {
    embeds_solutions(cond, sol) and is_injective_fn(reindex)
        implies embeds_solutions(cond, compose(sol, reindex))
}

theorem embeds_solutions_infinite[X](cond: X -> Bool, sol: Nat -> X) {
    embeds_solutions(cond, sol) implies solution_set(cond).is_infinite
}

theorem infinitely_many_solutions[X](cond: X -> Bool, sol: Nat -> X) {
    (forall(t: Nat) { cond(sol(t)) }) and is_injective_fn(sol)
        implies solution_set(cond).is_infinite
}

theorem box_is_box[X: TopologicalSpace, Y: TopologicalSpace](u: Set[X], v: Set[Y]) {
    X.is_open(u) and Y.is_open(v) implies is_box[X, Y](box(u, v))
}

theorem box_generated_open[X: TopologicalSpace, Y: TopologicalSpace](
    u: Set[X], v: Set[Y]) {
    X.is_open(u) and Y.is_open(v) implies generated_open(is_box[X, Y], box(u, v))
}

theorem box_is_open_in_product[X: TopologicalSpace, Y: TopologicalSpace](
    u: Set[X], v: Set[Y]) {
    X.is_open(u) and Y.is_open(v) implies is_open_in_product[X, Y](box(u, v))
}

theorem product_open_inter[X: TopologicalSpace, Y: TopologicalSpace](
    s: Set[Pair[X, Y]], t: Set[Pair[X, Y]]) {
    is_open_in_product[X, Y](s) and is_open_in_product[X, Y](t)
        implies is_open_in_product[X, Y](s.intersection(t))
}

theorem product_open_big_union[X: TopologicalSpace, Y: TopologicalSpace](
    c: Set[Pair[X, Y]] -> Bool) {
    (forall(s: Set[Pair[X, Y]]) { c(s) implies is_open_in_product[X, Y](s) })
        implies is_open_in_product[X, Y](big_union(c))
}

instance Pair[X: TopologicalSpace, Y: TopologicalSpace]: TopologicalSpace {
    let is_open: Set[Pair[X, Y]] -> Bool = is_open_in_product[X, Y]
}

theorem pair_is_open_eq[X: TopologicalSpace, Y: TopologicalSpace](
    s: Set[Pair[X, Y]]) {
    Pair[X, Y].is_open(s) = is_open_in_product[X, Y](s)
}

theorem box_open[X: TopologicalSpace, Y: TopologicalSpace](u: Set[X], v: Set[Y]) {
    X.is_open(u) and Y.is_open(v) implies Pair[X, Y].is_open(box(u, v))
}

define pair_fst[X, Y](p: Pair[X, Y]) -> X {
    p.first
}

define pair_snd[X, Y](p: Pair[X, Y]) -> Y {
    p.second
}

theorem pair_fst_preimage_eq[X, Y](u: Set[X]) {
    set_preimage(pair_fst[X, Y], u) = box(u, Set[Y].universal_set)
}

theorem pair_snd_preimage_eq[X, Y](v: Set[Y]) {
    set_preimage(pair_snd[X, Y], v) = box(Set[X].universal_set, v)
}

theorem box_eq_inter_preimages[X, Y](u: Set[X], v: Set[Y]) {
    box(u, v) = set_preimage(pair_fst[X, Y], u).intersection(set_preimage(pair_snd[X, Y], v))
}

theorem pair_fst_continuous[X: TopologicalSpace, Y: TopologicalSpace] {
    is_continuous(pair_fst[X, Y])
}

theorem pair_snd_continuous[X: TopologicalSpace, Y: TopologicalSpace] {
    is_continuous(pair_snd[X, Y])
}

theorem pair_fst_compose_fan_out[Z, X, Y](f: Z -> X, g: Z -> Y) {
    compose(pair_fst[X, Y], fan_out[Z, X, Y](f, g)) = f
}

theorem pair_snd_compose_fan_out[Z, X, Y](f: Z -> X, g: Z -> Y) {
    compose(pair_snd[X, Y], fan_out[Z, X, Y](f, g)) = g
}

theorem fan_out_preimage_box[Z, X, Y](
    f: Z -> X, g: Z -> Y, u: Set[X], v: Set[Y]) {
    set_preimage(fan_out[Z, X, Y](f, g), box(u, v))
        = set_preimage(f, u).intersection(set_preimage(g, v))
}

theorem fan_out_preimage_box_open[Z: TopologicalSpace, X: TopologicalSpace, Y: TopologicalSpace](
    f: Z -> X, g: Z -> Y, u: Set[X], v: Set[Y]) {
    is_continuous(f) and is_continuous(g) and X.is_open(u) and Y.is_open(v)
        implies Z.is_open(set_preimage(fan_out[Z, X, Y](f, g), box(u, v)))
}

theorem pair_map_preimage_box[X, Y, Z, W](
    f: X -> Z, g: Y -> W, u: Set[Z], v: Set[W]) {
    set_preimage(pair_map[X, Y, Z, W](f, g), box(u, v))
        = box(set_preimage(f, u), set_preimage(g, v))
}

theorem pair_map_preimage_box_open[X: TopologicalSpace, Y: TopologicalSpace, Z: TopologicalSpace, W: TopologicalSpace](
    f: X -> Z, g: Y -> W, u: Set[Z], v: Set[W]) {
    is_continuous(f) and is_continuous(g) and Z.is_open(u) and W.is_open(v)
        implies Pair[X, Y].is_open(set_preimage(pair_map[X, Y, Z, W](f, g), box(u, v)))
}

theorem pair_map_preimage_product_open_neighborhood[X: TopologicalSpace, Y: TopologicalSpace, Z: TopologicalSpace, W: TopologicalSpace](
    f: X -> Z, g: Y -> W, s: Set[Pair[Z, W]], p: Pair[X, Y]
) {
    is_continuous(f) and is_continuous(g)
    and Pair[Z, W].is_open(s)
    and set_preimage(pair_map[X, Y, Z, W](f, g), s).contains(p)
    implies is_neighborhood(set_preimage(pair_map[X, Y, Z, W](f, g), s), p)
}

theorem pair_map_preimage_product_open[X: TopologicalSpace, Y: TopologicalSpace, Z: TopologicalSpace, W: TopologicalSpace](
    f: X -> Z, g: Y -> W, s: Set[Pair[Z, W]]
) {
    is_continuous(f) and is_continuous(g) and Pair[Z, W].is_open(s)
        implies Pair[X, Y].is_open(set_preimage(pair_map[X, Y, Z, W](f, g), s))
}

theorem pair_map_continuous[X: TopologicalSpace, Y: TopologicalSpace, Z: TopologicalSpace, W: TopologicalSpace](
    f: X -> Z, g: Y -> W
) {
    is_continuous(f) and is_continuous(g)
        implies is_continuous(pair_map[X, Y, Z, W](f, g))
}

theorem real_from_int_lte(m: Int, n: Int) {
    m <= n implies Real.from_int(m) <= Real.from_int(n)
}

theorem real_from_int_mul(m: Int, n: Int) {
    Real.from_int(m) * Real.from_int(n) = Real.from_int(m * n)
}

theorem int_lt_imp_add_one_lte(a: Int, b: Int) {
    a < b implies a + Int.1 <= b
}

theorem floor_is_greatest(x: Real, n: Int) {
    Real.from_int(n) <= x implies n <= floor(x)
}

theorem floor_scale_bounds(b: Int, y: Real) {
    b.is_positive implies b * floor(y) <= floor(Real.from_int(b) * y)
        and floor(Real.from_int(b) * y) < b * floor(y) + b
}

define real_digit(b: Int, x: Real, k: Nat) -> Int {
    floor(Real.from_int(b).pow(k.suc) * x) - b * floor(Real.from_int(b).pow(k) * x)
}

theorem real_scaled_suc(b: Int, x: Real, k: Nat) {
    Real.from_int(b).pow(k.suc) * x = Real.from_int(b) * (Real.from_int(b).pow(k) * x)
}

theorem real_digit_bounds(b: Int, x: Real, k: Nat) {
    b.is_positive implies Int.0 <= real_digit(b, x, k) and real_digit(b, x, k) < b
}

define frac(x: Real) -> Real {
    x - Real.from_int(floor(x))
}

define circular_distance(x: Real) -> Real {
    frac(x).min(Real.1 - frac(x))
}

theorem floor_zero_of_unit_interval(x: Real) {
    Real.0 <= x and x < Real.1 implies floor(x) = Int.0
}

theorem frac_of_unit_interval(x: Real) {
    Real.0 <= x and x < Real.1 implies frac(x) = x
}

theorem circular_distance_of_unit_interval(x: Real) {
    Real.0 <= x and x < Real.1 implies circular_distance(x) = x.min(Real.1 - x)
}

theorem cd_bound(x: Real, b: Real) {
    Real.0 <= x and x < Real.1 and b <= x and b <= Real.1 - x
    implies b <= circular_distance(x)
}

theorem from_nat_real_positive(n: Nat) {
    Nat.0 < n implies Real.0 < from_nat[Real](n)
}

theorem from_nat_real_lt(m: Nat, n: Nat) {
    m < n implies from_nat[Real](m) < from_nat[Real](n)
}

theorem from_nat_div_self(n: Nat) {
    Nat.0 < n implies from_nat[Real](n) / from_nat[Real](n) = Real.1
}

theorem from_nat_frac_lt_one(k: Nat, n: Nat) {
    k < n implies from_nat[Real](k) / from_nat[Real](n) < Real.1
}

theorem same_denom_lte(a: Nat, b: Nat, d: Nat) {
    Nat.0 < d and a <= b
    implies from_nat[Real](a) / from_nat[Real](d) <= from_nat[Real](b) / from_nat[Real](d)
}

theorem sub_div(a: Real, b: Real, c: Real) {
    c != Real.0 implies a / c - b / c = (a - b) / c
}
