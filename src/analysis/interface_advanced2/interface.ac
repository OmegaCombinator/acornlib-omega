theorem closure_iff_in_set_or_limit_point[T: TopologicalSpace](s: Set[T], x: T) {
    closure(s).contains(x) = (s.contains(x) or is_limit_point[T](x, s))
}

theorem dense_iff_compl_interior_empty[T: TopologicalSpace](s: Set[T]) {
    is_dense[T](s) = (interior(s.c) = Set[T].empty_set)
}

theorem dense_iff_every_nonempty_open_meets[T: TopologicalSpace](s: Set[T]) {
    is_dense[T](s) = forall(u: Set[T], x: T) {
        T.is_open(u) and u.contains(x) implies exists(y: T) {
            u.contains(y) and s.contains(y)
        }
    }
}

define is_open_in_subspace[T: TopologicalSpace](a: Set[T], u: Set[T]) -> Bool {
    exists(v: Set[T]) {
        T.is_open(v) and u = v.intersection(a)
    }
}

theorem subspace_open_empty[T: TopologicalSpace](a: Set[T]) {
    is_open_in_subspace[T](a, Set[T].empty_set)
}

theorem subspace_open_self[T: TopologicalSpace](a: Set[T]) {
    is_open_in_subspace[T](a, a)
}

theorem subspace_inter_distrib[T](v: Set[T], w: Set[T], a: Set[T]) {
    v.intersection(a).intersection(w.intersection(a)) = v.intersection(w).intersection(a)
}

theorem subspace_union_distrib[T](v: Set[T], w: Set[T], a: Set[T]) {
    v.intersection(a).union(w.intersection(a)) = v.union(w).intersection(a)
}

theorem subspace_inter_ambient_distrib[T](v: Set[T], w: Set[T], a: Set[T]) {
    v.intersection(a).intersection(w) = v.intersection(w).intersection(a)
}

theorem subspace_relative_complement_trace[T](a: Set[T], v: Set[T]) {
    a.difference(v.intersection(a)) = v.c.intersection(a)
}

theorem subspace_open_inter[T: TopologicalSpace](a: Set[T], u: Set[T], w: Set[T]) {
    is_open_in_subspace[T](a, u) and is_open_in_subspace[T](a, w)
        implies is_open_in_subspace[T](a, u.intersection(w))
}

theorem subspace_open_from_ambient[T: TopologicalSpace](a: Set[T], v: Set[T]) {
    T.is_open(v) implies is_open_in_subspace[T](a, v.intersection(a))
}

theorem subspace_open_union[T: TopologicalSpace](a: Set[T], u: Set[T], w: Set[T]) {
    is_open_in_subspace[T](a, u) and is_open_in_subspace[T](a, w)
        implies is_open_in_subspace[T](a, u.union(w))
}

theorem subspace_open_subset_carrier[T: TopologicalSpace](a: Set[T], u: Set[T]) {
    is_open_in_subspace[T](a, u) implies u.subset(a)
}

theorem subspace_open_inter_ambient[T: TopologicalSpace](a: Set[T], u: Set[T], v: Set[T]) {
    is_open_in_subspace[T](a, u) and T.is_open(v)
        implies is_open_in_subspace[T](a, u.intersection(v))
}

theorem subspace_open_union_ambient[T: TopologicalSpace](a: Set[T], u: Set[T], v: Set[T]) {
    is_open_in_subspace[T](a, u) and T.is_open(v)
        implies is_open_in_subspace[T](a, u.union(v.intersection(a)))
}

define is_closed_in_subspace[T: TopologicalSpace](a: Set[T], u: Set[T]) -> Bool {
    exists(c: Set[T]) {
        is_closed[T](c) and u = c.intersection(a)
    }
}

theorem subspace_closed_empty[T: TopologicalSpace](a: Set[T]) {
    is_closed_in_subspace[T](a, Set[T].empty_set)
}

theorem subspace_closed_self[T: TopologicalSpace](a: Set[T]) {
    is_closed_in_subspace[T](a, a)
}

theorem subspace_closed_inter[T: TopologicalSpace](a: Set[T], u: Set[T], w: Set[T]) {
    is_closed_in_subspace[T](a, u) and is_closed_in_subspace[T](a, w)
        implies is_closed_in_subspace[T](a, u.intersection(w))
}

theorem subspace_closed_from_ambient[T: TopologicalSpace](a: Set[T], c: Set[T]) {
    is_closed[T](c) implies is_closed_in_subspace[T](a, c.intersection(a))
}

theorem subspace_closed_union[T: TopologicalSpace](a: Set[T], u: Set[T], w: Set[T]) {
    is_closed_in_subspace[T](a, u) and is_closed_in_subspace[T](a, w)
        implies is_closed_in_subspace[T](a, u.union(w))
}

theorem subspace_closed_subset_carrier[T: TopologicalSpace](a: Set[T], u: Set[T]) {
    is_closed_in_subspace[T](a, u) implies u.subset(a)
}

theorem subspace_closed_inter_ambient[T: TopologicalSpace](a: Set[T], u: Set[T], c: Set[T]) {
    is_closed_in_subspace[T](a, u) and is_closed[T](c)
        implies is_closed_in_subspace[T](a, u.intersection(c))
}

theorem subspace_closed_union_ambient[T: TopologicalSpace](a: Set[T], u: Set[T], c: Set[T]) {
    is_closed_in_subspace[T](a, u) and is_closed[T](c)
        implies is_closed_in_subspace[T](a, u.union(c.intersection(a)))
}

theorem subspace_open_relative_complement_closed[T: TopologicalSpace](a: Set[T], u: Set[T]) {
    is_open_in_subspace[T](a, u) implies is_closed_in_subspace[T](a, a.difference(u))
}

theorem subspace_closed_relative_complement_open[T: TopologicalSpace](a: Set[T], u: Set[T]) {
    is_closed_in_subspace[T](a, u) implies is_open_in_subspace[T](a, a.difference(u))
}

structure Subspace[T: TopologicalSpace, a: Set[T]] {
    /// The underlying ambient point.
    value: T
} constraint {
    a.contains(value)
}

define has_subspace_witness[T: TopologicalSpace](
    a: Set[T], u: Set[Subspace[T, a]], v: Set[T]
) -> Bool {
    T.is_open(v) and forall(p: Subspace[T, a]) {
        u.contains(p) = v.contains(p.value)
    }
}

define subspace_open[T: TopologicalSpace](a: Set[T], u: Set[Subspace[T, a]]) -> Bool {
    exists(v: Set[T]) {
        has_subspace_witness(a, u, v)
    }
}

theorem subspace_open_empty_helper[T: TopologicalSpace](a: Set[T]) {
    subspace_open(a, Set[Subspace[T, a]].empty_set)
}

theorem subspace_open_universal_helper[T: TopologicalSpace](a: Set[T]) {
    subspace_open(a, Set[Subspace[T, a]].universal_set)
}

theorem subspace_open_inter_helper[T: TopologicalSpace](
    a: Set[T], u: Set[Subspace[T, a]], w: Set[Subspace[T, a]]
) {
    subspace_open(a, u) and subspace_open(a, w) implies subspace_open(a, u.intersection(w))
}

define subspace_witness_family[T: TopologicalSpace](
    a: Set[T], fam: Set[Subspace[T, a]] -> Bool, v: Set[T]
) -> Bool {
    T.is_open(v) and exists(s: Set[Subspace[T, a]]) {
        fam(s) and forall(p: Subspace[T, a]) {
            s.contains(p) = v.contains(p.value)
        }
    }
}

theorem subspace_open_big_union_helper[T: TopologicalSpace](
    a: Set[T], fam: Set[Subspace[T, a]] -> Bool
) {
    (forall(s: Set[Subspace[T, a]]) {
        fam(s) implies subspace_open(a, s)
    }) implies subspace_open(a, big_union(fam))
}

instance Subspace[T: TopologicalSpace, a: Set[T]]: TopologicalSpace {
    let is_open: Set[Subspace[T, a]] -> Bool = subspace_open(a)
}

define box_contains[X, Y](u: Set[X], v: Set[Y], p: Pair[X, Y]) -> Bool {
    u.contains(p.first) and v.contains(p.second)
}

define box[X, Y](u: Set[X], v: Set[Y]) -> Set[Pair[X, Y]] {
    Set[Pair[X, Y]].new(box_contains(u, v))
}

theorem box_contains_eq[X, Y](u: Set[X], v: Set[Y], p: Pair[X, Y]) {
    box(u, v).contains(p) = (u.contains(p.first) and v.contains(p.second))
}

define is_box[X: TopologicalSpace, Y: TopologicalSpace](b: Set[Pair[X, Y]]) -> Bool {
    exists(u: Set[X], v: Set[Y]) {
        X.is_open(u) and Y.is_open(v) and b = box(u, v)
    }
}

theorem universal_pair_is_box[X: TopologicalSpace, Y: TopologicalSpace] {
    is_box[X, Y](Set[Pair[X, Y]].universal_set)
}

theorem box_intersection_eq[X, Y](u: Set[X], v: Set[Y], u2: Set[X], v2: Set[Y]) {
    box(u, v).intersection(box(u2, v2)) = box(u.intersection(u2), v.intersection(v2))
}

theorem box_inter_is_box[X: TopologicalSpace, Y: TopologicalSpace](
    b1: Set[Pair[X, Y]], b2: Set[Pair[X, Y]]) {
    is_box[X, Y](b1) and is_box[X, Y](b2) implies is_box[X, Y](b1.intersection(b2))
}

theorem is_box_covers[X: TopologicalSpace, Y: TopologicalSpace] {
    basis_covers(is_box[X, Y])
}

theorem box_inter_is_box_with_point[X: TopologicalSpace, Y: TopologicalSpace](
    b1: Set[Pair[X, Y]], b2: Set[Pair[X, Y]], p: Pair[X, Y]) {
    is_box[X, Y](b1) and is_box[X, Y](b2) and b1.contains(p) and b2.contains(p)
        implies is_box[X, Y](b1.intersection(b2)) and b1.intersection(b2).contains(p)
}

theorem is_box_filters_at[X: TopologicalSpace, Y: TopologicalSpace](
    b1: Set[Pair[X, Y]], b2: Set[Pair[X, Y]], p: Pair[X, Y]) {
    is_box[X, Y](b1) and is_box[X, Y](b2) and b1.contains(p) and b2.contains(p)
        implies exists(w: Set[Pair[X, Y]]) {
            is_box[X, Y](w) and w.contains(p) and w.subset(b1.intersection(b2))
        }
}

theorem is_box_filters[X: TopologicalSpace, Y: TopologicalSpace] {
    basis_filters(is_box[X, Y])
}

theorem is_box_is_topological_basis[X: TopologicalSpace, Y: TopologicalSpace] {
    is_topological_basis(is_box[X, Y])
}

define is_open_in_product[X: TopologicalSpace, Y: TopologicalSpace](
    s: Set[Pair[X, Y]]) -> Bool {
    generated_open(is_box[X, Y], s)
}

theorem is_open_in_product_iff[X: TopologicalSpace, Y: TopologicalSpace](
    s: Set[Pair[X, Y]]) {
    is_open_in_product[X, Y](s) = generated_open(is_box[X, Y], s)
}

theorem is_open_in_product_imp_generated_open[X: TopologicalSpace, Y: TopologicalSpace](
    s: Set[Pair[X, Y]]) {
    is_open_in_product[X, Y](s) implies generated_open(is_box[X, Y], s)
}

theorem generated_open_imp_is_open_in_product[X: TopologicalSpace, Y: TopologicalSpace](
    s: Set[Pair[X, Y]]) {
    generated_open(is_box[X, Y], s) implies is_open_in_product[X, Y](s)
}

theorem product_open_empty[X: TopologicalSpace, Y: TopologicalSpace] {
    is_open_in_product[X, Y](Set[Pair[X, Y]].empty_set)
}

theorem product_open_universal[X: TopologicalSpace, Y: TopologicalSpace] {
    is_open_in_product[X, Y](Set[Pair[X, Y]].universal_set)
}

define sum_left_preimage_contains[T, U](w: Set[Sum[T, U]], x: T) -> Bool {
    w.contains(Sum.inl[T, U](x))
}

define sum_left_preimage[T, U](w: Set[Sum[T, U]]) -> Set[T] {
    Set[T].new(sum_left_preimage_contains(w))
}

define sum_right_preimage_contains[T, U](w: Set[Sum[T, U]], y: U) -> Bool {
    w.contains(Sum.inr[T, U](y))
}

define sum_right_preimage[T, U](w: Set[Sum[T, U]]) -> Set[U] {
    Set[U].new(sum_right_preimage_contains(w))
}

theorem sum_left_preimage_contains_eq[T, U](w: Set[Sum[T, U]], x: T) {
    sum_left_preimage(w).contains(x) = w.contains(Sum.inl[T, U](x))
}

theorem sum_right_preimage_contains_eq[T, U](w: Set[Sum[T, U]], y: U) {
    sum_right_preimage(w).contains(y) = w.contains(Sum.inr[T, U](y))
}

theorem sum_left_preimage_empty[T, U] {
    sum_left_preimage[T, U](Set[Sum[T, U]].empty_set) = Set[T].empty_set
}

theorem sum_right_preimage_empty[T, U] {
    sum_right_preimage[T, U](Set[Sum[T, U]].empty_set) = Set[U].empty_set
}

theorem sum_left_preimage_universal[T, U] {
    sum_left_preimage[T, U](Set[Sum[T, U]].universal_set) = Set[T].universal_set
}

theorem sum_right_preimage_universal[T, U] {
    sum_right_preimage[T, U](Set[Sum[T, U]].universal_set) = Set[U].universal_set
}

theorem sum_left_preimage_inter[T, U](w1: Set[Sum[T, U]], w2: Set[Sum[T, U]]) {
    sum_left_preimage(w1.intersection(w2))
        = sum_left_preimage(w1).intersection(sum_left_preimage(w2))
}

theorem sum_right_preimage_inter[T, U](w1: Set[Sum[T, U]], w2: Set[Sum[T, U]]) {
    sum_right_preimage(w1.intersection(w2))
        = sum_right_preimage(w1).intersection(sum_right_preimage(w2))
}

define sum_left_preimage_family_contains[T, U](c: Set[Sum[T, U]] -> Bool, t: Set[T]) -> Bool {
    exists(s: Set[Sum[T, U]]) {
        c(s) and t = sum_left_preimage(s)
    }
}

define sum_left_preimage_family[T, U](c: Set[Sum[T, U]] -> Bool) -> (Set[T] -> Bool) {
    sum_left_preimage_family_contains(c)
}

define sum_right_preimage_family_contains[T, U](c: Set[Sum[T, U]] -> Bool, t: Set[U]) -> Bool {
    exists(s: Set[Sum[T, U]]) {
        c(s) and t = sum_right_preimage(s)
    }
}

define sum_right_preimage_family[T, U](c: Set[Sum[T, U]] -> Bool) -> (Set[U] -> Bool) {
    sum_right_preimage_family_contains(c)
}

theorem sum_left_preimage_family_eq[T, U](c: Set[Sum[T, U]] -> Bool, t: Set[T]) {
    sum_left_preimage_family(c)(t) = exists(s: Set[Sum[T, U]]) {
        c(s) and t = sum_left_preimage(s)
    }
}

theorem sum_right_preimage_family_eq[T, U](c: Set[Sum[T, U]] -> Bool, t: Set[U]) {
    sum_right_preimage_family(c)(t) = exists(s: Set[Sum[T, U]]) {
        c(s) and t = sum_right_preimage(s)
    }
}

theorem sum_left_preimage_big_union[T, U](c: Set[Sum[T, U]] -> Bool) {
    sum_left_preimage(big_union(c)) = big_union(sum_left_preimage_family(c))
}

theorem sum_right_preimage_big_union[T, U](c: Set[Sum[T, U]] -> Bool) {
    sum_right_preimage(big_union(c)) = big_union(sum_right_preimage_family(c))
}

define is_open_in_sum[X: TopologicalSpace, Y: TopologicalSpace](w: Set[Sum[X, Y]]) -> Bool {
    X.is_open(sum_left_preimage(w)) and Y.is_open(sum_right_preimage(w))
}

theorem sum_open_empty[X: TopologicalSpace, Y: TopologicalSpace] {
    is_open_in_sum[X, Y](Set[Sum[X, Y]].empty_set)
}

theorem sum_open_universal[X: TopologicalSpace, Y: TopologicalSpace] {
    is_open_in_sum[X, Y](Set[Sum[X, Y]].universal_set)
}

theorem sum_open_inter_left[X: TopologicalSpace, Y: TopologicalSpace](
    w1: Set[Sum[X, Y]], w2: Set[Sum[X, Y]]) {
    X.is_open(sum_left_preimage(w1)) and X.is_open(sum_left_preimage(w2))
        implies X.is_open(sum_left_preimage(w1.intersection(w2)))
}

theorem sum_open_inter_right[X: TopologicalSpace, Y: TopologicalSpace](
    w1: Set[Sum[X, Y]], w2: Set[Sum[X, Y]]) {
    Y.is_open(sum_right_preimage(w1)) and Y.is_open(sum_right_preimage(w2))
        implies Y.is_open(sum_right_preimage(w1.intersection(w2)))
}

theorem is_open_in_sum_iff[X: TopologicalSpace, Y: TopologicalSpace](w: Set[Sum[X, Y]]) {
    is_open_in_sum[X, Y](w) = (X.is_open(sum_left_preimage(w)) and Y.is_open(sum_right_preimage(w)))
}

theorem is_open_in_sum_intro[X: TopologicalSpace, Y: TopologicalSpace](w: Set[Sum[X, Y]]) {
    X.is_open(sum_left_preimage(w)) and Y.is_open(sum_right_preimage(w))
        implies is_open_in_sum[X, Y](w)
}

theorem is_open_in_sum_left[X: TopologicalSpace, Y: TopologicalSpace](w: Set[Sum[X, Y]]) {
    is_open_in_sum[X, Y](w) implies X.is_open(sum_left_preimage(w))
}

theorem is_open_in_sum_right[X: TopologicalSpace, Y: TopologicalSpace](w: Set[Sum[X, Y]]) {
    is_open_in_sum[X, Y](w) implies Y.is_open(sum_right_preimage(w))
}

theorem is_open_in_sum_both[X: TopologicalSpace, Y: TopologicalSpace](w: Set[Sum[X, Y]]) {
    is_open_in_sum[X, Y](w) implies
        X.is_open(sum_left_preimage(w)) and Y.is_open(sum_right_preimage(w))
}

theorem sum_open_inter[X: TopologicalSpace, Y: TopologicalSpace](
    w1: Set[Sum[X, Y]], w2: Set[Sum[X, Y]]) {
    is_open_in_sum[X, Y](w1) and is_open_in_sum[X, Y](w2)
        implies is_open_in_sum[X, Y](w1.intersection(w2))
}

theorem sum_open_big_union_left[X: TopologicalSpace, Y: TopologicalSpace](
    c: Set[Sum[X, Y]] -> Bool) {
    (forall(s: Set[Sum[X, Y]]) { c(s) implies is_open_in_sum[X, Y](s) })
        implies X.is_open(sum_left_preimage(big_union(c)))
}

theorem sum_open_big_union_right[X: TopologicalSpace, Y: TopologicalSpace](
    c: Set[Sum[X, Y]] -> Bool) {
    (forall(s: Set[Sum[X, Y]]) { c(s) implies is_open_in_sum[X, Y](s) })
        implies Y.is_open(sum_right_preimage(big_union(c)))
}

theorem sum_open_big_union[X: TopologicalSpace, Y: TopologicalSpace](
    c: Set[Sum[X, Y]] -> Bool) {
    (forall(s: Set[Sum[X, Y]]) { c(s) implies is_open_in_sum[X, Y](s) })
        implies is_open_in_sum[X, Y](big_union(c))
}

define is_quotient_open[T: TopologicalSpace](r: (T, T) -> Bool, s: Set[T]) -> Bool {
    T.is_open(s) and is_saturated_under(s, r)
}

theorem quotient_open_empty[T: TopologicalSpace](r: (T, T) -> Bool) {
    is_quotient_open[T](r, Set[T].empty_set)
}

theorem quotient_open_universal[T: TopologicalSpace](r: (T, T) -> Bool) {
    is_quotient_open[T](r, Set[T].universal_set)
}

theorem quotient_open_inter[T: TopologicalSpace](r: (T, T) -> Bool, s: Set[T], t: Set[T]) {
    is_quotient_open[T](r, s) and is_quotient_open[T](r, t)
        implies is_quotient_open[T](r, s.intersection(t))
}

theorem quotient_open_big_union[T: TopologicalSpace](r: (T, T) -> Bool, c: Set[T] -> Bool) {
    (forall(s: Set[T]) { c(s) implies is_quotient_open[T](r, s) })
        implies is_quotient_open[T](r, big_union(c))
}

inductive DiscreteFour {
    /// First point.
    d0

    /// Second point.
    d1

    /// Third point.
    d2

    /// Fourth point.
    d3
}

define discrete_four_open(s: Set[DiscreteFour]) -> Bool {
    true
}

instance DiscreteFour: TopologicalSpace {
    let is_open: Set[DiscreteFour] -> Bool = discrete_four_open
}

theorem discrete_four_every_set_open(s: Set[DiscreteFour]) {
    DiscreteFour.is_open(s)
}

theorem discrete_four_every_set_closed(s: Set[DiscreteFour]) {
    is_closed(s)
}

inductive IndiscreteTwo {
    /// First point.
    i0

    /// Second point.
    i1
}

define indiscrete_two_open(s: Set[IndiscreteTwo]) -> Bool {
    s = Set[IndiscreteTwo].empty_set or s = Set[IndiscreteTwo].universal_set
}

theorem indiscrete_two_inter(s: Set[IndiscreteTwo], t: Set[IndiscreteTwo]) {
    indiscrete_two_open(s) and indiscrete_two_open(t) implies indiscrete_two_open(s.intersection(t))
}

theorem indiscrete_two_big_union(c: Set[IndiscreteTwo] -> Bool) {
    (forall(s: Set[IndiscreteTwo]) { c(s) implies indiscrete_two_open(s) })
        implies indiscrete_two_open(big_union(c))
}

instance IndiscreteTwo: TopologicalSpace {
    let is_open: Set[IndiscreteTwo] -> Bool = indiscrete_two_open
}

theorem indiscrete_two_open_iff(s: Set[IndiscreteTwo]) {
    IndiscreteTwo.is_open(s) = (s = Set[IndiscreteTwo].empty_set or s = Set[IndiscreteTwo].universal_set)
}

let borel_sigma_algebra[T: TopologicalSpace]: SigmaAlgebra[T] satisfy {
    generated_sigma_algebra(function(s: Set[T]) { T.is_open(s) }) = borel_sigma_algebra
}

theorem borel_sigma_algebra_eq_generated_open[T: TopologicalSpace] {
    borel_sigma_algebra[T] =
        generated_sigma_algebra(function(s: Set[T]) { T.is_open(s) })
}

theorem borel_sigma_algebra_open_is_measurable[T: TopologicalSpace](s: Set[T]) {
    T.is_open(s) implies borel_sigma_algebra[T].is_measurable(s)
}

theorem borel_sigma_algebra_closed_is_measurable[T: TopologicalSpace](s: Set[T]) {
    is_closed(s) implies borel_sigma_algebra[T].is_measurable(s)
}

theorem borel_sigma_algebra_eq_generated_closed[T: TopologicalSpace] {
    borel_sigma_algebra[T] =
        generated_sigma_algebra(function(s: Set[T]) { is_closed(s) })
}

theorem continuous_is_borel_measurable[X: TopologicalSpace, Y: TopologicalSpace](f: X -> Y) {
    is_continuous(f) implies
        is_measurable_fn(f, borel_sigma_algebra[X], borel_sigma_algebra[Y])
}

theorem borel_sigma_algebra_indexed_union_open_is_measurable[T: TopologicalSpace](
        family: Nat -> Set[T]) {
    (forall(n: Nat) { T.is_open(family(n)) })
        implies borel_sigma_algebra[T].is_measurable(indexed_union(family))
}

theorem borel_sigma_algebra_indexed_intersection_closed_is_measurable[T: TopologicalSpace](
        family: Nat -> Set[T]) {
    (forall(n: Nat) { is_closed(family(n)) })
        implies borel_sigma_algebra[T].is_measurable(indexed_intersection(family))
}

theorem borel_sigma_algebra_const_is_measurable[X: TopologicalSpace, Y: TopologicalSpace](c: Y) {
    is_measurable_fn(function(x: X) { c }, borel_sigma_algebra[X], borel_sigma_algebra[Y])
}

theorem borel_sigma_algebra_identity_is_measurable[T: TopologicalSpace] {
    is_measurable_fn(identity_fn[T], borel_sigma_algebra[T], borel_sigma_algebra[T])
}

theorem borel_sigma_algebra_indicator_fn_is_measurable[T: TopologicalSpace](
        s: Set[T]) {
    borel_sigma_algebra[T].is_measurable(s) implies
        is_measurable_fn(indicator_fn(s),
            borel_sigma_algebra[T], SigmaAlgebra[Bool].discrete)
}

theorem borel_sigma_algebra_indicator_fn_open[T: TopologicalSpace](s: Set[T]) {
    T.is_open(s) implies
        is_measurable_fn(indicator_fn(s),
            borel_sigma_algebra[T], SigmaAlgebra[Bool].discrete)
}

theorem borel_sigma_algebra_indicator_fn_closed[T: TopologicalSpace](s: Set[T]) {
    is_closed(s) implies
        is_measurable_fn(indicator_fn(s),
            borel_sigma_algebra[T], SigmaAlgebra[Bool].discrete)
}

theorem borel_set_measurable_of_indicator_fn_measurable[T: TopologicalSpace](
        s: Set[T]) {
    is_measurable_fn(indicator_fn(s),
        borel_sigma_algebra[T], SigmaAlgebra[Bool].discrete)
        implies borel_sigma_algebra[T].is_measurable(s)
}

theorem borel_sigma_algebra_indicator_fn_iff[T: TopologicalSpace](s: Set[T]) {
    is_measurable_fn(indicator_fn(s),
        borel_sigma_algebra[T], SigmaAlgebra[Bool].discrete) iff
        borel_sigma_algebra[T].is_measurable(s)
}

theorem preimage_sigma_algebra_borel_eq[X: TopologicalSpace, Y: TopologicalSpace](
        f: X -> Y) {
    preimage_sigma_algebra(f, borel_sigma_algebra[Y]) =
        generated_sigma_algebra(
            preimage_generator(f, function(s: Set[Y]) { Y.is_open(s) }))
}

theorem borel_sigma_algebra_open_in_subspace_is_measurable[T: TopologicalSpace](
        a: Set[T], u: Set[T]) {
    is_open_in_subspace[T](a, u) implies
        is_measurable_in_subspace(borel_sigma_algebra[T], a, u)
}

theorem borel_sigma_algebra_closed_in_subspace_is_measurable[T: TopologicalSpace](
        a: Set[T], u: Set[T]) {
    is_closed_in_subspace[T](a, u) implies
        is_measurable_in_subspace(borel_sigma_algebra[T], a, u)
}

theorem borel_subspace_indicator_fn_open[T: TopologicalSpace](a: Set[T], u: Set[T]) {
    is_open_in_subspace[T](a, u) implies
        is_measurable_fn(indicator_fn(u),
            trace_sigma_algebra(borel_sigma_algebra[T], a),
            SigmaAlgebra[Bool].discrete)
}

theorem borel_subspace_indicator_fn_closed[T: TopologicalSpace](a: Set[T], u: Set[T]) {
    is_closed_in_subspace[T](a, u) implies
        is_measurable_fn(indicator_fn(u),
            trace_sigma_algebra(borel_sigma_algebra[T], a),
            SigmaAlgebra[Bool].discrete)
}

theorem borel_sigma_algebra_compose_is_measurable[X: TopologicalSpace, Y: TopologicalSpace, Z: TopologicalSpace](
        f: Y -> Z, g: X -> Y) {
    is_measurable_fn(g, borel_sigma_algebra[X], borel_sigma_algebra[Y])
        and is_measurable_fn(f, borel_sigma_algebra[Y], borel_sigma_algebra[Z])
        implies is_measurable_fn(compose(f, g), borel_sigma_algebra[X], borel_sigma_algebra[Z])
}

theorem borel_measurable_preimage_measurable[X: TopologicalSpace, Y: TopologicalSpace](
        f: X -> Y, t: Set[Y]) {
    is_measurable_fn(f, borel_sigma_algebra[X], borel_sigma_algebra[Y])
        and borel_sigma_algebra[Y].is_measurable(t)
        implies borel_sigma_algebra[X].is_measurable(set_preimage(f, t))
}

theorem continuous_preimage_borel_measurable[X: TopologicalSpace, Y: TopologicalSpace](
        f: X -> Y, t: Set[Y]) {
    is_continuous(f) and borel_sigma_algebra[Y].is_measurable(t)
        implies borel_sigma_algebra[X].is_measurable(set_preimage(f, t))
}

theorem trace_borel_open_in_subspace_is_measurable[T: TopologicalSpace](
        a: Set[T], u: Set[T]) {
    is_open_in_subspace[T](a, u) implies
        trace_sigma_algebra(borel_sigma_algebra[T], a).is_measurable(u)
}

theorem trace_borel_closed_in_subspace_is_measurable[T: TopologicalSpace](
        a: Set[T], u: Set[T]) {
    is_closed_in_subspace[T](a, u) implies
        trace_sigma_algebra(borel_sigma_algebra[T], a).is_measurable(u)
}

define real_is_interior_point(s: Set[Real], x: Real) -> Bool {
    s.contains(x) and exists(eps: Real) {
        eps.is_positive and forall(y: Real) {
            y.is_close(x, eps) implies s.contains(y)
        }
    }
}

define real_is_open(s: Set[Real]) -> Bool {
    forall(x: Real) {
        s.contains(x) implies real_is_interior_point(s, x)
    }
}

theorem real_is_interior_point_intro(s: Set[Real], x: Real, eps: Real) {
    s.contains(x) and eps.is_positive and forall(y: Real) {
        y.is_close(x, eps) implies s.contains(y)
    } implies real_is_interior_point(s, x)
}

theorem real_open_is_interior_point(s: Set[Real], x: Real) {
    real_is_open(s) and s.contains(x) implies real_is_interior_point(s, x)
}

theorem real_open_empty {
    real_is_open(Set[Real].empty_set)
}

theorem real_open_universal {
    real_is_open(Set[Real].universal_set)
}

theorem real_smaller_ball_subset_left(s: Set[Real], x: Real, eps: Real, eps1: Real) {
    eps <= eps1 and forall(y: Real) {
        y.is_close(x, eps1) implies s.contains(y)
    } implies forall(y: Real) {
        y.is_close(x, eps) implies s.contains(y)
    }
}

theorem real_is_interior_point_intersection(s: Set[Real], t: Set[Real], x: Real) {
    real_is_interior_point(s, x) and real_is_interior_point(t, x) implies
    real_is_interior_point(s.intersection(t), x)
}

theorem real_open_inter(s: Set[Real], t: Set[Real]) {
    real_is_open(s) and real_is_open(t) implies real_is_open(s.intersection(t))
}

theorem real_open_big_union(c: Set[Real] -> Bool) {
    (forall(s: Set[Real]) { c(s) implies real_is_open(s) })
        implies real_is_open(big_union(c))
}

instance Real: TopologicalSpace {
    let is_open: Set[Real] -> Bool = real_is_open
}

define is_borel_measurable_fn(f: Real -> Real) -> Bool {
    is_measurable_fn(f, borel_sigma_algebra[Real], borel_sigma_algebra[Real])
}

theorem borel_measurable_fn_compose(f: Real -> Real, g: Real -> Real) {
    is_borel_measurable_fn(g) and is_borel_measurable_fn(f)
        implies is_borel_measurable_fn(compose(f, g))
}

theorem borel_measurable_fn_const(c: Real) {
    is_borel_measurable_fn(function(x: Real) { c })
}

theorem borel_measurable_fn_identity {
    is_borel_measurable_fn(identity_fn[Real])
}

theorem continuous_real_open_preimage(f: Real -> Real) {
    continuous(f) implies forall(v: Set[Real]) {
        real_is_open(v) implies real_is_open(set_preimage(f, v))
    }
}

theorem continuous_imp_borel_measurable(f: Real -> Real) {
    continuous(f) implies is_borel_measurable_fn(f)
}

define above_point(lower: Real, x: Real) -> Bool {
    lower < x
}

define below_point(upper: Real, x: Real) -> Bool {
    x < upper
}

define at_or_above_point(lower: Real, x: Real) -> Bool {
    lower <= x
}

define at_or_below_point(upper: Real, x: Real) -> Bool {
    x <= upper
}

define open_upper_ray_set(lower: Real) -> Set[Real] {
    Set[Real].new(above_point(lower))
}

define open_lower_ray_set(upper: Real) -> Set[Real] {
    Set[Real].new(below_point(upper))
}

define closed_upper_ray_set(lower: Real) -> Set[Real] {
    Set[Real].new(at_or_above_point(lower))
}

define closed_lower_ray_set(upper: Real) -> Set[Real] {
    Set[Real].new(at_or_below_point(upper))
}

theorem open_upper_ray_set_contains_eq(lower: Real, x: Real) {
    open_upper_ray_set(lower).contains(x) = (lower < x)
}

theorem open_lower_ray_set_contains_eq(upper: Real, x: Real) {
    open_lower_ray_set(upper).contains(x) = (x < upper)
}

theorem closed_upper_ray_set_contains_eq(lower: Real, x: Real) {
    closed_upper_ray_set(lower).contains(x) = (lower <= x)
}

theorem closed_lower_ray_set_contains_eq(upper: Real, x: Real) {
    closed_lower_ray_set(upper).contains(x) = (x <= upper)
}

theorem positive_half_lt_bound(eps: Real, bound: Real) {
    eps.is_positive and eps + eps < bound implies eps < bound
}

theorem sub_lt_self_of_pos(a: Real, b: Real) {
    b.is_positive implies a - b < a
}

theorem real_open_upper_ray_set(lower: Real) {
    real_is_open(open_upper_ray_set(lower))
}

theorem real_open_lower_ray_set(upper: Real) {
    real_is_open(open_lower_ray_set(upper))
}

theorem closed_upper_ray_set_eq_complement_open_lower_ray_set(lower: Real) {
    closed_upper_ray_set(lower) = open_lower_ray_set(lower).c
}

theorem closed_lower_ray_set_eq_complement_open_upper_ray_set(upper: Real) {
    closed_lower_ray_set(upper) = open_upper_ray_set(upper).c
}

theorem open_interval_set_eq_ray_intersection(lower: Real, upper: Real) {
    open_interval_set(lower, upper) = open_upper_ray_set(lower).intersection(open_lower_ray_set(upper))
}

theorem closed_interval_set_eq_ray_intersection(lower: Real, upper: Real) {
    closed_interval_set(lower, upper) = closed_upper_ray_set(lower).intersection(closed_lower_ray_set(upper))
}

theorem real_complement_of_open_is_closed(s: Set[Real]) {
    Real.is_open(s) implies is_closed[Real](s.c)
}

theorem real_complement_of_closed_is_open(s: Set[Real]) {
    is_closed[Real](s) implies Real.is_open(s.c)
}

theorem real_union_of_open_is_open(s: Set[Real], t: Set[Real]) {
    Real.is_open(s) and Real.is_open(t) implies Real.is_open(s.union(t))
}

theorem real_intersection_of_closed_is_closed(s: Set[Real], t: Set[Real]) {
    is_closed[Real](s) and is_closed[Real](t) implies is_closed[Real](s.intersection(t))
}

theorem real_big_union_of_open_is_open(c: Set[Real] -> Bool) {
    (forall(s: Set[Real]) { c(s) implies Real.is_open(s) })
        implies Real.is_open(big_union(c))
}

theorem real_closed_upper_ray_set(lower: Real) {
    is_closed[Real](closed_upper_ray_set(lower))
}

theorem real_closed_lower_ray_set(upper: Real) {
    is_closed[Real](closed_lower_ray_set(upper))
}

theorem open_interval_set_is_open(lower: Real, upper: Real) {
    Real.is_open(open_interval_set(lower, upper))
}

theorem closed_interval_set_is_closed(lower: Real, upper: Real) {
    is_closed[Real](closed_interval_set(lower, upper))
}

theorem nonempty_from_neq_empty(s: Set[Real]) {
    s != Set[Real].empty_set implies exists(x: Real) { s.contains(x) }
}

theorem supremum_approximation(s: Set[Real], c: Real, eps: Real) {
    is_set_supremum(s, c) and eps.is_positive implies exists(z: Real) {
        s.contains(z) and c - eps < z
    }
}

theorem no_disconnection_with_order(u: Set[Real], v: Set[Real], x: Real, y: Real) {
    not (real_is_open(u) and real_is_open(v) and u.is_disjoint(v)
        and u.union(v) = Set[Real].universal_set and u.contains(x) and v.contains(y) and x < y)
}

theorem real_line_is_connected {
    is_connected[Real](real_is_open)
}

theorem singleton_interval_subset(lower: Real, u: Set[Real]) {
    u.contains(lower) implies closed_interval_set(lower, lower).subset(u)
}

theorem reversed_interval_set_is_empty(lower: Real, upper: Real) {
    not lower <= upper implies closed_interval_set(lower, upper) = Set[Real].empty_set
}

theorem interval_subset_union_intervals(a: Real, x: Real, y: Real) {
    closed_interval_set(a, y).subset(closed_interval_set(a, x).union(closed_interval_set(x, y)))
}

theorem union_subset_of_union(a: Set[Real], b: Set[Real], u: Set[Real], v: Set[Real]) {
    a.subset(u) and b.subset(v) implies a.union(b).subset(u.union(v))
}

define finitely_coverable(c: Set[Real] -> Bool, a: Real, x: Real) -> Bool {
    exists(items: List[Set[Real]]) {
        is_subfamily[Real](c, items) and closed_interval_set(a, x).subset(list_union_of_sets[Real](items))
    }
}

define prefix_member(c: Set[Real] -> Bool, lower: Real, upper: Real, x: Real) -> Bool {
    lower <= x and x <= upper and finitely_coverable(c, lower, x)
}

define prefix_set(c: Set[Real] -> Bool, lower: Real, upper: Real) -> Set[Real] {
    Set[Real].new(prefix_member(c, lower, upper))
}

theorem prefix_set_contains_eq(c: Set[Real] -> Bool, lower: Real, upper: Real, x: Real) {
    prefix_set(c, lower, upper).contains(x) =
        (lower <= x and x <= upper and finitely_coverable(c, lower, x))
}

theorem extend_finite_subcover(c: Set[Real] -> Bool, a: Real, x: Real, y: Real,
    u: Set[Real], items: List[Set[Real]]) {
    finitely_coverable(c, a, x) and c(u) and a <= x and x <= y
        and closed_interval_set(x, y).subset(u)
    implies finitely_coverable(c, a, y)
}

theorem interval_after_ball_subset(m: Real, eps: Real, s: Real, u: Set[Real]) {
    m - eps < s and s <= m and eps.is_positive
        and (forall(w: Real) { w.is_close(m, eps) implies u.contains(w) })
    implies closed_interval_set(s, m).subset(u)
}

theorem interval_before_ball_subset(m: Real, eps: Real, y: Real, u: Set[Real]) {
    y < m + eps and m <= y and eps.is_positive
        and (forall(w: Real) { w.is_close(m, eps) implies u.contains(w) })
    implies closed_interval_set(m, y).subset(u)
}

theorem heine_borel_closed_interval(lower: Real, upper: Real) {
    is_compact[Real](closed_interval_set(lower, upper))
}

define continuous_on_closed(f: Real -> Real, lower: Real, upper: Real) -> Bool {
    forall(x: Real) {
        closed_interval_set(lower, upper).contains(x) implies continuous_at(f, x)
    }
}

define uniform_on_condition(f: Real -> Real, lower: Real, upper: Real, delta: Real, eps: Real) -> Bool {
    forall(x: Real, y: Real) {
        closed_interval_set(lower, upper).contains(x) and
        closed_interval_set(lower, upper).contains(y) and
        x.is_close(y, delta)
        implies f(x).is_close(f(y), eps)
    }
}

define uniform_on(f: Real -> Real, lower: Real, upper: Real) -> Bool {
    forall(eps: Real) {
        eps.is_positive implies exists(delta: Real) {
            delta.is_positive and uniform_on_condition(f, lower, upper, delta, eps)
        }
    }
}

define is_unbounded(f: Nat -> Nat) -> Bool {
    forall(bound: Nat) {
        exists(n: Nat) {
            bound < f(n)
        }
    }
}

theorem intermediate_value_on_closed_interval(f: Real -> Real, a: Real, b: Real, t: Real) {
    continuous(f) and a <= b and f(a) <= t and t <= f(b)
    implies exists(c: Real) { a <= c and c <= b and f(c) = t }
}

theorem heine_borel_closed_interval_is_compact(a: Real, b: Real) {
    is_compact[Real](closed_interval_set(a, b))
}

define iterate[T](f: T -> T, n: Nat, x: T) -> T {
    match n {
        Nat.zero {
            x
        }
        Nat.suc(pred) {
            f(iterate(f, pred, x))
        }
    }
}

theorem iterate_zero[T](f: T -> T, x: T) {
    iterate(f, Nat.0, x) = x
}

theorem iterate_one[T](f: T -> T, x: T) {
    iterate(f, Nat.1, x) = f(x)
}

theorem iterate_suc[T](f: T -> T, n: Nat, x: T) {
    iterate(f, n.suc, x) = f(iterate(f, n, x))
}

theorem iterate_suc_inner[T](f: T -> T, n: Nat, x: T) {
    iterate(f, n.suc, x) = iterate(f, n, f(x))
}

theorem iterate_add[T](f: T -> T, m: Nat, n: Nat, x: T) {
    iterate(f, m + n, x) = iterate(f, m, iterate(f, n, x))
}

define orbit_contains[T](f: T -> T, x: T, y: T) -> Bool {
    exists(n: Nat) {
        y = iterate(f, n, x)
    }
}

define orbit[T](f: T -> T, x: T) -> Set[T] {
    Set[T].new(orbit_contains(f, x))
}

theorem orbit_contains_self[T](f: T -> T, x: T) {
    orbit(f, x).contains(x)
}

theorem orbit_contains_iterate[T](f: T -> T, x: T, n: Nat) {
    orbit(f, x).contains(iterate(f, n, x))
}

define is_invariant[T](f: T -> T, s: Set[T]) -> Bool {
    forall(x: T) {
        s.contains(x) implies s.contains(f(x))
    }
}

theorem invariant_step_iterate[T](f: T -> T, s: Set[T], x: T, n: Nat) {
    (forall(z: T) { s.contains(z) implies s.contains(f(z)) })
        and s.contains(x)
        implies s.contains(iterate(f, n, x))
}

theorem is_invariant_iterate[T](f: T -> T, s: Set[T], x: T, n: Nat) {
    is_invariant(f, s) and s.contains(x) implies s.contains(iterate(f, n, x))
}

theorem orbit_is_invariant[T](f: T -> T, x: T) {
    is_invariant(f, orbit(f, x))
}

define is_fixed_point[T](f: T -> T, x: T) -> Bool {
    f(x) = x
}

theorem iterate_at_fixed[T](f: T -> T, x: T, n: Nat) {
    f(x) = x implies iterate(f, n, x) = x
}

theorem iterate_fixed_point[T](f: T -> T, x: T, n: Nat) {
    is_fixed_point(f, x) implies iterate(f, n, x) = x
}

theorem is_fixed_point_step[T](f: T -> T, x: T) {
    is_fixed_point(f, x) implies is_fixed_point(f, f(x))
}

define fixed_point_set[T](f: T -> T) -> Set[T] {
    Set[T].new(is_fixed_point(f))
}

theorem fixed_point_set_invariant[T](f: T -> T) {
    is_invariant(f, fixed_point_set(f))
}

define is_periodic_point[T](f: T -> T, x: T, n: Nat) -> Bool {
    n != Nat.0 and iterate(f, n, x) = x
}

define is_periodic[T](f: T -> T, x: T) -> Bool {
    exists(n: Nat) {
        is_periodic_point(f, x, n)
    }
}

theorem is_fixed_point_periodic_one[T](f: T -> T, x: T) {
    is_fixed_point(f, x) implies is_periodic_point(f, x, Nat.1)
}

theorem is_fixed_point_is_periodic[T](f: T -> T, x: T) {
    is_fixed_point(f, x) implies is_periodic(f, x)
}

theorem iterate_periodic_multiple[T](f: T -> T, x: T, n: Nat, k: Nat) {
    is_periodic_point(f, x, n) implies iterate(f, k * n, x) = x
}

theorem periodic_orbit_returns[T](f: T -> T, x: T, n: Nat) {
    is_periodic_point(f, x, n) implies orbit(f, x).contains(iterate(f, n, x))
}

define is_prime_period[T](f: T -> T, x: T, n: Nat) -> Bool {
    is_periodic_point(f, x, n)
        and forall(m: Nat) {
            m < n and m != Nat.0 implies iterate(f, m, x) != x
        }
}

theorem is_periodic_point_step[T](f: T -> T, x: T, n: Nat) {
    is_periodic_point(f, x, n) implies is_periodic_point(f, f(x), n)
}

theorem is_periodic_step[T](f: T -> T, x: T) {
    is_periodic(f, x) implies is_periodic(f, f(x))
}

define periodic_point_set[T](f: T -> T) -> Set[T] {
    Set[T].new(is_periodic(f))
}

theorem periodic_point_set_contains_step[T](f: T -> T, x: T) {
    periodic_point_set(f).contains(x) implies periodic_point_set(f).contains(f(x))
}

theorem periodic_point_set_invariant[T](f: T -> T) {
    is_invariant(f, periodic_point_set(f))
}

define has_period_dividing[T](f: T -> T, x: T, n: Nat) -> Bool {
    n != Nat.0 and iterate(f, n, x) = x
}

theorem has_period_dividing_iff_periodic_point[T](f: T -> T, x: T, n: Nat) {
    has_period_dividing(f, x, n) = is_periodic_point(f, x, n)
}

theorem prime_period_has_period_dividing[T](f: T -> T, x: T, n: Nat) {
    is_prime_period(f, x, n) implies has_period_dividing(f, x, n)
}

define prime_period_set[T](f: T -> T, n: Nat) -> Set[T] {
    Set[T].new(function(x: T) { is_prime_period(f, x, n) })
}

define period_dividing_set[T](f: T -> T, n: Nat) -> Set[T] {
    Set[T].new(function(x: T) { has_period_dividing(f, x, n) })
}

theorem prime_period_set_subset_period_dividing_set[T](f: T -> T, n: Nat) {
    prime_period_set(f, n).subset(period_dividing_set(f, n))
}

theorem period_dividing_set_subset_periodic[T](f: T -> T, n: Nat) {
    period_dividing_set(f, n).subset(periodic_point_set(f))
}

theorem fixed_point_is_prime_period_one[T](f: T -> T, x: T) {
    is_fixed_point(f, x) implies is_prime_period(f, x, Nat.1)
}

theorem prime_period_one_iff_fixed_point[T](f: T -> T, x: T) {
    is_prime_period(f, x, Nat.1) = is_fixed_point(f, x)
}

theorem is_periodic_point_iterate[T](f: T -> T, x: T, n: Nat, k: Nat) {
    is_periodic_point(f, x, n) implies is_periodic_point(f, iterate(f, k, x), n)
}

theorem is_periodic_iterate[T](f: T -> T, x: T, k: Nat) {
    is_periodic(f, x) implies is_periodic(f, iterate(f, k, x))
}

theorem orbit_subset_invariant[T](f: T -> T, s: Set[T], x: T) {
    is_invariant(f, s) and s.contains(x) implies orbit(f, x).subset(s)
}

theorem orbit_subset_self[T](f: T -> T, x: T) {
    orbit(f, x).subset(orbit(f, x))
}

define backward_orbit_contains[T](f: T -> T, k: T -> T, x: T, y: T) -> Bool {
    exists(n: Nat) {
        y = iterate(k, n, x)
    }
}

define backward_orbit[T](f: T -> T, k: T -> T, x: T) -> Set[T] {
    Set[T].new(backward_orbit_contains(f, k, x))
}

theorem backward_orbit_contains_self[T](f: T -> T, k: T -> T, x: T) {
