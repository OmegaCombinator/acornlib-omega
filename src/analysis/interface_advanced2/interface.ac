theorem trace_borel_open_in_subspace_is_measurable[T: TopologicalSpace](
        a: Set[T], u: Set[T]) {
    is_open_in_subspace[T](a, u) implies
        trace_sigma_algebra(borel_sigma_algebra[T], a).is_measurable(u)
}

theorem trace_borel_closed_in_subspace_is_measurable[T: TopologicalSpace](
        a: Set[T], u: Set[T]) {
    is_closed_in_subspace[T](a, u) implies
        trace_sigma_algebra(borel_sigma_algebra[T], a).is_measurable(u)
}

define real_is_interior_point(s: Set[Real], x: Real) -> Bool {
    s.contains(x) and exists(eps: Real) {
        eps.is_positive and forall(y: Real) {
            y.is_close(x, eps) implies s.contains(y)
        }
    }
}

define real_is_open(s: Set[Real]) -> Bool {
    forall(x: Real) {
        s.contains(x) implies real_is_interior_point(s, x)
    }
}

theorem real_is_interior_point_intro(s: Set[Real], x: Real, eps: Real) {
    s.contains(x) and eps.is_positive and forall(y: Real) {
        y.is_close(x, eps) implies s.contains(y)
    } implies real_is_interior_point(s, x)
}

theorem real_open_is_interior_point(s: Set[Real], x: Real) {
    real_is_open(s) and s.contains(x) implies real_is_interior_point(s, x)
}

theorem real_open_empty {
    real_is_open(Set[Real].empty_set)
}

theorem real_open_universal {
    real_is_open(Set[Real].universal_set)
}

theorem real_smaller_ball_subset_left(s: Set[Real], x: Real, eps: Real, eps1: Real) {
    eps <= eps1 and forall(y: Real) {
        y.is_close(x, eps1) implies s.contains(y)
    } implies forall(y: Real) {
        y.is_close(x, eps) implies s.contains(y)
    }
}

theorem real_is_interior_point_intersection(s: Set[Real], t: Set[Real], x: Real) {
    real_is_interior_point(s, x) and real_is_interior_point(t, x) implies
    real_is_interior_point(s.intersection(t), x)
}

theorem real_open_inter(s: Set[Real], t: Set[Real]) {
    real_is_open(s) and real_is_open(t) implies real_is_open(s.intersection(t))
}

theorem real_open_big_union(c: Set[Real] -> Bool) {
    (forall(s: Set[Real]) { c(s) implies real_is_open(s) })
        implies real_is_open(big_union(c))
}

instance Real: TopologicalSpace {
    let is_open: Set[Real] -> Bool = real_is_open
}

define is_borel_measurable_fn(f: Real -> Real) -> Bool {
    is_measurable_fn(f, borel_sigma_algebra[Real], borel_sigma_algebra[Real])
}

theorem borel_measurable_fn_compose(f: Real -> Real, g: Real -> Real) {
    is_borel_measurable_fn(g) and is_borel_measurable_fn(f)
        implies is_borel_measurable_fn(compose(f, g))
}

theorem borel_measurable_fn_const(c: Real) {
    is_borel_measurable_fn(function(x: Real) { c })
}

theorem borel_measurable_fn_identity {
    is_borel_measurable_fn(identity_fn[Real])
}

theorem continuous_real_open_preimage(f: Real -> Real) {
    continuous(f) implies forall(v: Set[Real]) {
        real_is_open(v) implies real_is_open(set_preimage(f, v))
    }
}

theorem continuous_imp_borel_measurable(f: Real -> Real) {
    continuous(f) implies is_borel_measurable_fn(f)
}

define above_point(lower: Real, x: Real) -> Bool {
    lower < x
}

define below_point(upper: Real, x: Real) -> Bool {
    x < upper
}

define at_or_above_point(lower: Real, x: Real) -> Bool {
    lower <= x
}

define at_or_below_point(upper: Real, x: Real) -> Bool {
    x <= upper
}

define open_upper_ray_set(lower: Real) -> Set[Real] {
    Set[Real].new(above_point(lower))
}

define open_lower_ray_set(upper: Real) -> Set[Real] {
    Set[Real].new(below_point(upper))
}

define closed_upper_ray_set(lower: Real) -> Set[Real] {
    Set[Real].new(at_or_above_point(lower))
}

define closed_lower_ray_set(upper: Real) -> Set[Real] {
    Set[Real].new(at_or_below_point(upper))
}

theorem open_upper_ray_set_contains_eq(lower: Real, x: Real) {
    open_upper_ray_set(lower).contains(x) = (lower < x)
}

theorem open_lower_ray_set_contains_eq(upper: Real, x: Real) {
    open_lower_ray_set(upper).contains(x) = (x < upper)
}

theorem closed_upper_ray_set_contains_eq(lower: Real, x: Real) {
    closed_upper_ray_set(lower).contains(x) = (lower <= x)
}

theorem closed_lower_ray_set_contains_eq(upper: Real, x: Real) {
    closed_lower_ray_set(upper).contains(x) = (x <= upper)
}

theorem positive_half_lt_bound(eps: Real, bound: Real) {
    eps.is_positive and eps + eps < bound implies eps < bound
}

theorem sub_lt_self_of_pos(a: Real, b: Real) {
    b.is_positive implies a - b < a
}

theorem real_open_upper_ray_set(lower: Real) {
    real_is_open(open_upper_ray_set(lower))
}

theorem real_open_lower_ray_set(upper: Real) {
    real_is_open(open_lower_ray_set(upper))
}

theorem closed_upper_ray_set_eq_complement_open_lower_ray_set(lower: Real) {
    closed_upper_ray_set(lower) = open_lower_ray_set(lower).c
}

theorem closed_lower_ray_set_eq_complement_open_upper_ray_set(upper: Real) {
    closed_lower_ray_set(upper) = open_upper_ray_set(upper).c
}

theorem open_interval_set_eq_ray_intersection(lower: Real, upper: Real) {
    open_interval_set(lower, upper) = open_upper_ray_set(lower).intersection(open_lower_ray_set(upper))
}

theorem closed_interval_set_eq_ray_intersection(lower: Real, upper: Real) {
    closed_interval_set(lower, upper) = closed_upper_ray_set(lower).intersection(closed_lower_ray_set(upper))
}

theorem real_complement_of_open_is_closed(s: Set[Real]) {
    Real.is_open(s) implies is_closed[Real](s.c)
}

theorem real_complement_of_closed_is_open(s: Set[Real]) {
    is_closed[Real](s) implies Real.is_open(s.c)
}

theorem real_union_of_open_is_open(s: Set[Real], t: Set[Real]) {
    Real.is_open(s) and Real.is_open(t) implies Real.is_open(s.union(t))
}

theorem real_intersection_of_closed_is_closed(s: Set[Real], t: Set[Real]) {
    is_closed[Real](s) and is_closed[Real](t) implies is_closed[Real](s.intersection(t))
}

theorem real_big_union_of_open_is_open(c: Set[Real] -> Bool) {
    (forall(s: Set[Real]) { c(s) implies Real.is_open(s) })
        implies Real.is_open(big_union(c))
}

theorem real_closed_upper_ray_set(lower: Real) {
    is_closed[Real](closed_upper_ray_set(lower))
}

theorem real_closed_lower_ray_set(upper: Real) {
    is_closed[Real](closed_lower_ray_set(upper))
}

theorem open_interval_set_is_open(lower: Real, upper: Real) {
    Real.is_open(open_interval_set(lower, upper))
}

theorem closed_interval_set_is_closed(lower: Real, upper: Real) {
    is_closed[Real](closed_interval_set(lower, upper))
}

theorem nonempty_from_neq_empty(s: Set[Real]) {
    s != Set[Real].empty_set implies exists(x: Real) { s.contains(x) }
}

theorem supremum_approximation(s: Set[Real], c: Real, eps: Real) {
    is_set_supremum(s, c) and eps.is_positive implies exists(z: Real) {
        s.contains(z) and c - eps < z
    }
}

theorem no_disconnection_with_order(u: Set[Real], v: Set[Real], x: Real, y: Real) {
    not (real_is_open(u) and real_is_open(v) and u.is_disjoint(v)
        and u.union(v) = Set[Real].universal_set and u.contains(x) and v.contains(y) and x < y)
}

theorem real_line_is_connected {
    is_connected[Real](real_is_open)
}

theorem singleton_interval_subset(lower: Real, u: Set[Real]) {
    u.contains(lower) implies closed_interval_set(lower, lower).subset(u)
}

theorem reversed_interval_set_is_empty(lower: Real, upper: Real) {
    not lower <= upper implies closed_interval_set(lower, upper) = Set[Real].empty_set
}

theorem interval_subset_union_intervals(a: Real, x: Real, y: Real) {
    closed_interval_set(a, y).subset(closed_interval_set(a, x).union(closed_interval_set(x, y)))
}

theorem union_subset_of_union(a: Set[Real], b: Set[Real], u: Set[Real], v: Set[Real]) {
    a.subset(u) and b.subset(v) implies a.union(b).subset(u.union(v))
}

define finitely_coverable(c: Set[Real] -> Bool, a: Real, x: Real) -> Bool {
    exists(items: List[Set[Real]]) {
        is_subfamily[Real](c, items) and closed_interval_set(a, x).subset(list_union_of_sets[Real](items))
    }
}

define prefix_member(c: Set[Real] -> Bool, lower: Real, upper: Real, x: Real) -> Bool {
    lower <= x and x <= upper and finitely_coverable(c, lower, x)
}

define prefix_set(c: Set[Real] -> Bool, lower: Real, upper: Real) -> Set[Real] {
    Set[Real].new(prefix_member(c, lower, upper))
}

theorem prefix_set_contains_eq(c: Set[Real] -> Bool, lower: Real, upper: Real, x: Real) {
    prefix_set(c, lower, upper).contains(x) =
        (lower <= x and x <= upper and finitely_coverable(c, lower, x))
}

theorem extend_finite_subcover(c: Set[Real] -> Bool, a: Real, x: Real, y: Real,
    u: Set[Real], items: List[Set[Real]]) {
    finitely_coverable(c, a, x) and c(u) and a <= x and x <= y
        and closed_interval_set(x, y).subset(u)
    implies finitely_coverable(c, a, y)
}

theorem interval_after_ball_subset(m: Real, eps: Real, s: Real, u: Set[Real]) {
    m - eps < s and s <= m and eps.is_positive
        and (forall(w: Real) { w.is_close(m, eps) implies u.contains(w) })
    implies closed_interval_set(s, m).subset(u)
}

theorem interval_before_ball_subset(m: Real, eps: Real, y: Real, u: Set[Real]) {
    y < m + eps and m <= y and eps.is_positive
        and (forall(w: Real) { w.is_close(m, eps) implies u.contains(w) })
    implies closed_interval_set(m, y).subset(u)
}

theorem heine_borel_closed_interval(lower: Real, upper: Real) {
    is_compact[Real](closed_interval_set(lower, upper))
}

define continuous_on_closed(f: Real -> Real, lower: Real, upper: Real) -> Bool {
    forall(x: Real) {
        closed_interval_set(lower, upper).contains(x) implies continuous_at(f, x)
    }
}

define uniform_on_condition(f: Real -> Real, lower: Real, upper: Real, delta: Real, eps: Real) -> Bool {
    forall(x: Real, y: Real) {
        closed_interval_set(lower, upper).contains(x) and
        closed_interval_set(lower, upper).contains(y) and
        x.is_close(y, delta)
        implies f(x).is_close(f(y), eps)
    }
}

define uniform_on(f: Real -> Real, lower: Real, upper: Real) -> Bool {
    forall(eps: Real) {
        eps.is_positive implies exists(delta: Real) {
            delta.is_positive and uniform_on_condition(f, lower, upper, delta, eps)
        }
    }
}

define is_unbounded(f: Nat -> Nat) -> Bool {
    forall(bound: Nat) {
        exists(n: Nat) {
            bound < f(n)
        }
    }
}

theorem intermediate_value_on_closed_interval(f: Real -> Real, a: Real, b: Real, t: Real) {
    continuous(f) and a <= b and f(a) <= t and t <= f(b)
    implies exists(c: Real) { a <= c and c <= b and f(c) = t }
}

theorem heine_borel_closed_interval_is_compact(a: Real, b: Real) {
    is_compact[Real](closed_interval_set(a, b))
}

define iterate[T](f: T -> T, n: Nat, x: T) -> T {
    match n {
        Nat.zero {
            x
        }
        Nat.suc(pred) {
            f(iterate(f, pred, x))
        }
    }
}

theorem iterate_zero[T](f: T -> T, x: T) {
    iterate(f, Nat.0, x) = x
}

theorem iterate_one[T](f: T -> T, x: T) {
    iterate(f, Nat.1, x) = f(x)
}

theorem iterate_suc[T](f: T -> T, n: Nat, x: T) {
    iterate(f, n.suc, x) = f(iterate(f, n, x))
}

theorem iterate_suc_inner[T](f: T -> T, n: Nat, x: T) {
    iterate(f, n.suc, x) = iterate(f, n, f(x))
}

theorem iterate_add[T](f: T -> T, m: Nat, n: Nat, x: T) {
    iterate(f, m + n, x) = iterate(f, m, iterate(f, n, x))
}

define orbit_contains[T](f: T -> T, x: T, y: T) -> Bool {
    exists(n: Nat) {
        y = iterate(f, n, x)
    }
}

define orbit[T](f: T -> T, x: T) -> Set[T] {
    Set[T].new(orbit_contains(f, x))
}

theorem orbit_contains_self[T](f: T -> T, x: T) {
    orbit(f, x).contains(x)
}

theorem orbit_contains_iterate[T](f: T -> T, x: T, n: Nat) {
    orbit(f, x).contains(iterate(f, n, x))
}

define is_invariant[T](f: T -> T, s: Set[T]) -> Bool {
    forall(x: T) {
        s.contains(x) implies s.contains(f(x))
    }
}

theorem invariant_step_iterate[T](f: T -> T, s: Set[T], x: T, n: Nat) {
    (forall(z: T) { s.contains(z) implies s.contains(f(z)) })
        and s.contains(x)
        implies s.contains(iterate(f, n, x))
}

theorem is_invariant_iterate[T](f: T -> T, s: Set[T], x: T, n: Nat) {
    is_invariant(f, s) and s.contains(x) implies s.contains(iterate(f, n, x))
}

theorem orbit_is_invariant[T](f: T -> T, x: T) {
    is_invariant(f, orbit(f, x))
}

define is_fixed_point[T](f: T -> T, x: T) -> Bool {
    f(x) = x
}

theorem iterate_at_fixed[T](f: T -> T, x: T, n: Nat) {
    f(x) = x implies iterate(f, n, x) = x
}

theorem iterate_fixed_point[T](f: T -> T, x: T, n: Nat) {
    is_fixed_point(f, x) implies iterate(f, n, x) = x
}

theorem is_fixed_point_step[T](f: T -> T, x: T) {
    is_fixed_point(f, x) implies is_fixed_point(f, f(x))
}

define fixed_point_set[T](f: T -> T) -> Set[T] {
    Set[T].new(is_fixed_point(f))
}

theorem fixed_point_set_invariant[T](f: T -> T) {
    is_invariant(f, fixed_point_set(f))
}

define is_periodic_point[T](f: T -> T, x: T, n: Nat) -> Bool {
    n != Nat.0 and iterate(f, n, x) = x
}

define is_periodic[T](f: T -> T, x: T) -> Bool {
    exists(n: Nat) {
        is_periodic_point(f, x, n)
    }
}

theorem is_fixed_point_periodic_one[T](f: T -> T, x: T) {
    is_fixed_point(f, x) implies is_periodic_point(f, x, Nat.1)
}

theorem is_fixed_point_is_periodic[T](f: T -> T, x: T) {
    is_fixed_point(f, x) implies is_periodic(f, x)
}

theorem iterate_periodic_multiple[T](f: T -> T, x: T, n: Nat, k: Nat) {
    is_periodic_point(f, x, n) implies iterate(f, k * n, x) = x
}

theorem periodic_orbit_returns[T](f: T -> T, x: T, n: Nat) {
    is_periodic_point(f, x, n) implies orbit(f, x).contains(iterate(f, n, x))
}

define is_prime_period[T](f: T -> T, x: T, n: Nat) -> Bool {
    is_periodic_point(f, x, n)
        and forall(m: Nat) {
            m < n and m != Nat.0 implies iterate(f, m, x) != x
        }
}

theorem is_periodic_point_step[T](f: T -> T, x: T, n: Nat) {
    is_periodic_point(f, x, n) implies is_periodic_point(f, f(x), n)
}

theorem is_periodic_step[T](f: T -> T, x: T) {
    is_periodic(f, x) implies is_periodic(f, f(x))
}

define periodic_point_set[T](f: T -> T) -> Set[T] {
    Set[T].new(is_periodic(f))
}

theorem periodic_point_set_contains_step[T](f: T -> T, x: T) {
    periodic_point_set(f).contains(x) implies periodic_point_set(f).contains(f(x))
}

theorem periodic_point_set_invariant[T](f: T -> T) {
    is_invariant(f, periodic_point_set(f))
}

define has_period_dividing[T](f: T -> T, x: T, n: Nat) -> Bool {
    n != Nat.0 and iterate(f, n, x) = x
}

theorem has_period_dividing_iff_periodic_point[T](f: T -> T, x: T, n: Nat) {
    has_period_dividing(f, x, n) = is_periodic_point(f, x, n)
}

theorem prime_period_has_period_dividing[T](f: T -> T, x: T, n: Nat) {
    is_prime_period(f, x, n) implies has_period_dividing(f, x, n)
}

define prime_period_set[T](f: T -> T, n: Nat) -> Set[T] {
    Set[T].new(function(x: T) { is_prime_period(f, x, n) })
}

define period_dividing_set[T](f: T -> T, n: Nat) -> Set[T] {
    Set[T].new(function(x: T) { has_period_dividing(f, x, n) })
}

theorem prime_period_set_subset_period_dividing_set[T](f: T -> T, n: Nat) {
    prime_period_set(f, n).subset(period_dividing_set(f, n))
}

theorem period_dividing_set_subset_periodic[T](f: T -> T, n: Nat) {
    period_dividing_set(f, n).subset(periodic_point_set(f))
}

theorem fixed_point_is_prime_period_one[T](f: T -> T, x: T) {
    is_fixed_point(f, x) implies is_prime_period(f, x, Nat.1)
}

theorem prime_period_one_iff_fixed_point[T](f: T -> T, x: T) {
    is_prime_period(f, x, Nat.1) = is_fixed_point(f, x)
}

theorem is_periodic_point_iterate[T](f: T -> T, x: T, n: Nat, k: Nat) {
    is_periodic_point(f, x, n) implies is_periodic_point(f, iterate(f, k, x), n)
}

theorem is_periodic_iterate[T](f: T -> T, x: T, k: Nat) {
    is_periodic(f, x) implies is_periodic(f, iterate(f, k, x))
}

theorem orbit_subset_invariant[T](f: T -> T, s: Set[T], x: T) {
    is_invariant(f, s) and s.contains(x) implies orbit(f, x).subset(s)
}

theorem orbit_subset_self[T](f: T -> T, x: T) {
    orbit(f, x).subset(orbit(f, x))
}

define backward_orbit_contains[T](f: T -> T, k: T -> T, x: T, y: T) -> Bool {
    exists(n: Nat) {
        y = iterate(k, n, x)
    }
}

define backward_orbit[T](f: T -> T, k: T -> T, x: T) -> Set[T] {
    Set[T].new(backward_orbit_contains(f, k, x))
}

theorem backward_orbit_contains_self[T](f: T -> T, k: T -> T, x: T) {
    backward_orbit(f, k, x).contains(x)
}

theorem backward_orbit_contains_iterate[T](f: T -> T, k: T -> T, x: T, n: Nat) {
    backward_orbit(f, k, x).contains(iterate(k, n, x))
}

define full_orbit_contains[T](f: T -> T, k: T -> T, x: T, y: T) -> Bool {
    orbit_contains(f, x, y) or backward_orbit_contains(f, k, x, y)
}

define full_orbit[T](f: T -> T, k: T -> T, x: T) -> Set[T] {
    Set[T].new(full_orbit_contains(f, k, x))
}

theorem full_orbit_contains_forward[T](f: T -> T, k: T -> T, x: T, y: T) {
    orbit(f, x).contains(y) implies full_orbit(f, k, x).contains(y)
}

theorem full_orbit_contains_backward[T](f: T -> T, k: T -> T, x: T, y: T) {
    backward_orbit(f, k, x).contains(y) implies full_orbit(f, k, x).contains(y)
}

theorem full_orbit_contains_self[T](f: T -> T, k: T -> T, x: T) {
    full_orbit(f, k, x).contains(x)
}

theorem full_orbit_contains_iterate[T](f: T -> T, k: T -> T, x: T, n: Nat) {
    full_orbit(f, k, x).contains(iterate(f, n, x))
}

theorem full_orbit_contains_backward_iterate[T](f: T -> T, k: T -> T, x: T, n: Nat) {
    full_orbit(f, k, x).contains(iterate(k, n, x))
}

define is_semiconjugacy[T, U](h: T -> U, f: T -> T, g: U -> U) -> Bool {
    forall(x: T) {
        h(f(x)) = g(h(x))
    }
}

define is_conjugacy[T, U](h: T -> U, k: U -> T, f: T -> T, g: U -> U) -> Bool {
    is_semiconjugacy(h, f, g)
        and forall(x: T) { k(h(x)) = x }
        and forall(y: U) { h(k(y)) = y }
}

theorem iterate_semiconjugacy[T, U](h: T -> U, f: T -> T, g: U -> U, x: T, n: Nat) {
    is_semiconjugacy(h, f, g) implies h(iterate(f, n, x)) = iterate(g, n, h(x))
}

theorem orbit_semiconjugacy[T, U](h: T -> U, f: T -> T, g: U -> U, x: T, y: T) {
    is_semiconjugacy(h, f, g) and orbit(f, x).contains(y)
        implies orbit(g, h(x)).contains(h(y))
}

theorem fixed_point_semiconjugacy[T, U](h: T -> U, f: T -> T, g: U -> U, x: T) {
    is_semiconjugacy(h, f, g) and is_fixed_point(f, x)
        implies is_fixed_point(g, h(x))
}

theorem periodic_point_semiconjugacy[T, U](h: T -> U, f: T -> T, g: U -> U, x: T, n: Nat) {
    is_semiconjugacy(h, f, g) and is_periodic_point(f, x, n)
        implies is_periodic_point(g, h(x), n)
}

theorem periodic_semiconjugacy[T, U](h: T -> U, f: T -> T, g: U -> U, x: T) {
    is_semiconjugacy(h, f, g) and is_periodic(f, x)
        implies is_periodic(g, h(x))
}

theorem conjugacy_is_semiconjugacy[T, U](h: T -> U, k: U -> T, f: T -> T, g: U -> U) {
    is_conjugacy(h, k, f, g) implies is_semiconjugacy(h, f, g)
}

theorem conjugacy_injective[T, U](h: T -> U, k: U -> T, f: T -> T, g: U -> U) {
    is_conjugacy(h, k, f, g) implies is_injective_fn(h)
}

theorem conjugacy_surjective[T, U](h: T -> U, k: U -> T, f: T -> T, g: U -> U) {
    is_conjugacy(h, k, f, g) implies is_surjective_fn(h)
}

theorem conjugacy_bijection[T, U](h: T -> U, k: U -> T, f: T -> T, g: U -> U) {
