theorem conjugacy_compose[T, U, V](h: T -> U, k: U -> T, j: U -> V, l: V -> U,
        f: T -> T, g: U -> U, e: V -> V) {
    is_conjugacy(h, k, f, g) and is_conjugacy(j, l, g, e) implies
        is_conjugacy(compose(j, h), compose(k, l), f, e)
}

define iterate_fixed_point_set[T](f: T -> T, n: Nat) -> Set[T] {
