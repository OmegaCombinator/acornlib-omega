}

theorem conjugacy_inverse_injective[T, U](h: T -> U, k: U -> T, f: T -> T, g: U -> U) {
    is_conjugacy(h, k, f, g) implies is_injective_fn(k)
}

theorem conjugacy_inverse_surjective[T, U](h: T -> U, k: U -> T, f: T -> T, g: U -> U) {
