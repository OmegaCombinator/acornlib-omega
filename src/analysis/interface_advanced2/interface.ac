theorem fixed_by_of_fixed_point[T](f: T -> T, x: T) {
    is_fixed_point(f, x) implies is_fixed_by(f, x)
}

theorem fixed_point_set_contains_eq_fixed_by[T](f: T -> T, x: T) {
