theorem prime_period_minimal_from_forall[T](f: T -> T, x: T, n: Nat, m: Nat) {
    (forall(q: Nat) { q < n and q != Nat.0 implies iterate(f, q, x) != x })
        and m < n and m != Nat.0 implies iterate(f, m, x) != x
