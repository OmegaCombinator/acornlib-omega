define is_upper_bound_on[Domain, Value: PartialOrder](
    domain: Set[Domain], f: Domain -> Value, bound: Value
) -> Bool {
    forall(point: Domain) {
        domain.contains(point) implies f(point) <= bound
    }
}

define is_lower_bound_on[Domain, Value: PartialOrder](
    domain: Set[Domain], f: Domain -> Value, bound: Value
) -> Bool {
    forall(point: Domain) {
        domain.contains(point) implies bound <= f(point)
    }
}

define is_bounded_above_on[Domain, Value: PartialOrder](
    domain: Set[Domain], f: Domain -> Value
) -> Bool {
    exists(bound: Value) {
        is_upper_bound_on(domain, f, bound)
    }
}

define is_bounded_below_on[Domain, Value: PartialOrder](
    domain: Set[Domain], f: Domain -> Value
) -> Bool {
    exists(bound: Value) {
        is_lower_bound_on(domain, f, bound)
    }
}

define is_bounded_on[Domain, Value: PartialOrder](
    domain: Set[Domain], f: Domain -> Value
) -> Bool {
    is_bounded_above_on(domain, f) and is_bounded_below_on(domain, f)
}

theorem upper_bound_on_apply[Domain, Value: PartialOrder](
    domain: Set[Domain], f: Domain -> Value, bound: Value, point: Domain
) {
    is_upper_bound_on(domain, f, bound) and domain.contains(point) implies f(point) <= bound
}

theorem lower_bound_on_apply[Domain, Value: PartialOrder](
    domain: Set[Domain], f: Domain -> Value, bound: Value, point: Domain
) {
    is_lower_bound_on(domain, f, bound) and domain.contains(point) implies bound <= f(point)
}

define attains_maximum_at[Domain, Value: PartialOrder](
    domain: Set[Domain], f: Domain -> Value, point: Domain
) -> Bool {
    domain.contains(point) and is_upper_bound_on(domain, f, f(point))
}

define attains_minimum_at[Domain, Value: PartialOrder](
    domain: Set[Domain], f: Domain -> Value, point: Domain
) -> Bool {
    domain.contains(point) and is_lower_bound_on(domain, f, f(point))
}

define attains_maximum_on[Domain, Value: PartialOrder](
    domain: Set[Domain], f: Domain -> Value
) -> Bool {
    exists(point: Domain) {
        attains_maximum_at(domain, f, point)
    }
}

define attains_minimum_on[Domain, Value: PartialOrder](
    domain: Set[Domain], f: Domain -> Value
) -> Bool {
    exists(point: Domain) {
        attains_minimum_at(domain, f, point)
    }
}

theorem maximum_value_is_upper_bound_on[Domain, Value: PartialOrder](
    domain: Set[Domain], f: Domain -> Value, point: Domain
) {
    attains_maximum_at(domain, f, point) implies is_upper_bound_on(domain, f, f(point))
}

theorem minimum_value_is_lower_bound_on[Domain, Value: PartialOrder](
    domain: Set[Domain], f: Domain -> Value, point: Domain
) {
    attains_minimum_at(domain, f, point) implies is_lower_bound_on(domain, f, f(point))
}

theorem attains_maximum_imp_bounded_above[Domain, Value: PartialOrder](
    domain: Set[Domain], f: Domain -> Value
) {
    attains_maximum_on(domain, f) implies is_bounded_above_on(domain, f)
}

theorem attains_minimum_imp_bounded_below[Domain, Value: PartialOrder](
    domain: Set[Domain], f: Domain -> Value
) {
    attains_minimum_on(domain, f) implies is_bounded_below_on(domain, f)
}

theorem upper_bound_on_subset[Domain, Value: PartialOrder](
    subset: Set[Domain], superset: Set[Domain], f: Domain -> Value, bound: Value
) {
    subset.subset(superset) and is_upper_bound_on(superset, f, bound)
    implies is_upper_bound_on(subset, f, bound)
}

theorem lower_bound_on_subset[Domain, Value: PartialOrder](
    subset: Set[Domain], superset: Set[Domain], f: Domain -> Value, bound: Value
) {
    subset.subset(superset) and is_lower_bound_on(superset, f, bound)
    implies is_lower_bound_on(subset, f, bound)
}

define option_set_contains[T](s: Set[T], contains_none: Bool, opt: Option[T]) -> Bool {
    match opt {
        Option.none {
            contains_none
        }
        Option.some(value) {
            s.contains(value)
        }
    }
}

define option_set[T](s: Set[T], contains_none: Bool) -> Set[Option[T]] {
    Set[Option[T]].new(option_set_contains(s, contains_none))
}

define option_some_set[T](s: Set[T]) -> Set[Option[T]] {
    option_set(s, false)
}

define option_with_none_set[T](s: Set[T]) -> Set[Option[T]] {
    option_set(s, true)
}

theorem option_set_contains_some[T](s: Set[T], contains_none: Bool, value: T) {
    option_set(s, contains_none).contains(Option.some(value)) = s.contains(value)
}

theorem option_set_contains_none[T](s: Set[T], contains_none: Bool) {
    option_set(s, contains_none).contains(Option.none[T]) = contains_none
}

theorem option_set_contains_some_of_contains[T](s: Set[T], contains_none: Bool, value: T) {
    s.contains(value) implies option_set(s, contains_none).contains(Option.some(value))
}

theorem option_set_contains_imp_contains_some[T](s: Set[T], contains_none: Bool, value: T) {
    option_set(s, contains_none).contains(Option.some(value)) implies s.contains(value)
}

theorem option_set_contains_none_iff[T](s: Set[T], contains_none: Bool) {
    option_set(s, contains_none).contains(Option.none[T]) = contains_none
}

theorem option_some_set_contains_some[T](s: Set[T], value: T) {
    option_some_set(s).contains(Option.some(value)) = s.contains(value)
}

theorem option_some_set_not_contains_none[T](s: Set[T]) {
    not option_some_set(s).contains(Option.none[T])
}

theorem option_with_none_set_contains_some[T](s: Set[T], value: T) {
    option_with_none_set(s).contains(Option.some(value)) = s.contains(value)
}

theorem option_with_none_set_contains_none[T](s: Set[T]) {
    option_with_none_set(s).contains(Option.none[T])
}

theorem option_map_preserves_option_set[T, U](source: Set[T], target: Set[U],
    contains_none: Bool, f: T -> U, opt: Option[T]) {
    option_set(source, contains_none).contains(opt) and
    forall(x: T) {
        source.contains(x) implies target.contains(f(x))
    } implies option_set(target, contains_none).contains(option_map(opt, f))
}

define pair_set_contains[T, U](left: Set[T], right: Set[U], p: Pair[T, U]) -> Bool {
    left.contains(p.first) and right.contains(p.second)
}

define pair_set[T, U](left: Set[T], right: Set[U]) -> Set[Pair[T, U]] {
    Set[Pair[T, U]].new(pair_set_contains(left, right))
}

theorem pair_set_contains_eq[T, U](left: Set[T], right: Set[U], p: Pair[T, U]) {
    pair_set(left, right).contains(p) =
    (left.contains(p.first) and right.contains(p.second))
}

theorem pair_set_contains_of_components[T, U](left: Set[T], right: Set[U], x: T, y: U) {
    left.contains(x) and right.contains(y) implies
    pair_set(left, right).contains(Pair.new(x, y))
}

theorem pair_set_contains_imp_left[T, U](left: Set[T], right: Set[U], p: Pair[T, U]) {
    pair_set(left, right).contains(p) implies left.contains(p.first)
}

theorem pair_set_contains_imp_right[T, U](left: Set[T], right: Set[U], p: Pair[T, U]) {
    pair_set(left, right).contains(p) implies right.contains(p.second)
}

theorem pair_map_preserves_pair_set[T, U, V, W](left: Set[T], right: Set[U],
    left_target: Set[V], right_target: Set[W], f: T -> V, g: U -> W, p: Pair[T, U]) {
    pair_set(left, right).contains(p) and
    (forall(x: T) { left.contains(x) implies left_target.contains(f(x)) }) and
    (forall(y: U) { right.contains(y) implies right_target.contains(g(y)) })
    implies pair_set(left_target, right_target).contains(pair_map(f, g, p))
}

define constant_false[K](x: K) -> Bool {
    false
}

define negate_fun[K](f: K -> Bool, x: K) -> Bool {
    not f(x)
}

define singleton_fun[K](a: K, x: K) -> Bool {
    a = x
}

define functional_insert[K](f: K -> Bool, item: K, x: K) -> Bool {
    if x = item {
        true
    } else {
        f(x)
    }
}

define functional_remove[K](f: K -> Bool, item: K, x: K) -> Bool {
    if x = item {
        false
    } else {
        f(x)
    }
}

attributes Set[K] {
    let empty_set = Set[K].new(constant_false[K])
    /// The universal set containing all elements of type K.
    let universal_set = Set[K].new(negate_fun(constant_false[K]))
    /// Creates a set containing exactly one element.
    let singleton: K -> Set[K] = function(a: K) {
        Set[K].new(singleton_fun(a))
    }

    /// True if the set has no elements.
    define is_empty(self) -> Bool {
        forall(x: K) {
            not self.contains(x)
        }
    }

    /// The complement of this set.
    define c(self) -> Set[K] {
        Set[K].new(negate_fun(self.contains))
    }

    /// True if the set contains exactly one element.
    define is_singleton(self) -> Bool {
        exists(a: K) {
            self = Set[K].singleton(a)
        }
    }

    /// Removes an element from the set. If the item isn't present, this is a no-op.
    define remove(self, item: K) -> Set[K] {
        Set[K].new(functional_remove(self.contains, item))
    }

    /// Adds an element to the set. If the item is already present, this is a no-op.
    define insert(self, item: K) -> Set[K] {
        Set[K].new(functional_insert(self.contains, item))
    }

    /// True if the two sets have no elements in common.
    define is_disjoint(self, other: Set[K]) -> Bool {
        forall(x: K) {
            not (self.contains(x) and other.contains(x))
        }
    }

}

define finite_constraint[K](contains: K -> Bool) -> Bool {
    exists(superset: List[K]) {
        forall(x: K) {
            contains(x) implies superset.contains(x)
        }
    }
}

attributes Set[K] {
    /// True if the set contains only finitely many elements.
    define is_finite(self) -> Bool {
        finite_constraint(self.contains)
    }

    /// True if the set contains infinitely many elements.
    define is_infinite(self) -> Bool {
        not self.is_finite
    }

    /// True if the cardinality is at most n.
    define cardinality_at_most(self, n: Nat) -> Bool {
        exists (superset: List[K]) {
            superset.contains_set(self) and superset.length <= n
        }
    }

    /// True if the cardinality equals n.
    define cardinality_is(self, n: Nat) -> Bool {
        exists (containing_list: List[K]) {
            containing_list.contains_set(self) and containing_list.filter(self.contains).unique.length = n
        }
    }
}

theorem constant_false_satisfies_finite_constraint[K] {
    finite_constraint(constant_false[K])
}

theorem list_contains_satisfies_finite_constraint[K](ts: List[K]) {
    finite_constraint(ts.contains)
}

theorem functional_insert_satisfies_finite_constraint[K](f: K -> Bool, item: K) {
    finite_constraint(f) implies finite_constraint(functional_insert(f, item))
}

theorem functional_remove_satisfies_finite_constraint[K](f: K -> Bool, item: K) {
    finite_constraint(f) implies finite_constraint(functional_remove(f, item))
}

theorem neg_of_neg_is_self[K](f: K -> Bool) {
    negate_fun(negate_fun(f)) = f
}

theorem empty_set_contains_eq[K](x: K) {
    (Set[K].empty_set).contains(x) = false
}

theorem empty_set_is_empty[K] {
    (Set[K].empty_set).is_empty
}

theorem singleton_set_is_singleton[K](a: K) {
    (Set[K].singleton(a)).is_singleton
}

theorem set_ext[K](a: Set[K], b: Set[K]) {
    (forall(x: K) { a.contains(x) = b.contains(x) }) implies a = b
}

attributes Set[K] {
    /// Set extensionality from pointwise equality of membership.
    let ext = set_ext[K]

    /// self ⊇ s
    define superset(self, s: Set[K]) -> Bool {
        s.subset(self)
    }
}

theorem set_eq_contains[K](a: Set[K], b: Set[K]) {
    a = b implies a.contains = b.contains
}

theorem set_eq_contains_at[K](a: Set[K], b: Set[K], x: K) {
    a = b implies a.contains(x) = b.contains(x)
}

theorem set_eq_transport_predicate[K](p: Set[K] -> Bool, a: Set[K], b: Set[K]) {
    a = b and p(a) implies p(b)
}

theorem set_eq_transport_predicate_rev[K](p: Set[K] -> Bool, a: Set[K], b: Set[K]) {
    a = b and p(b) implies p(a)
}

theorem set_eq_of_contains_eq[K](a: Set[K], b: Set[K]) {
    a.contains = b.contains implies a = b
}

theorem set_eq_of_contains_at_eq[K](a: Set[K], b: Set[K]) {
    (forall(x: K) { a.contains(x) = b.contains(x) }) implies a = b
}

theorem set_eq_empty_of_is_empty[K](s: Set[K]) {
    s.is_empty implies s = Set[K].empty_set
}

define relation_support_fun[T](r: (T, T) -> Bool, x: T) -> Bool {
    exists(y: T) {
        r(x, y)
    }
}

define relation_support[T](r: (T, T) -> Bool) -> Set[T] {
    Set[T].new(relation_support_fun(r))
}

define equivalence_class_fun[T](r: (T, T) -> Bool, a: T, x: T) -> Bool {
    r(a, x)
}

define equivalence_class[T](r: (T, T) -> Bool, a: T) -> Set[T] {
    Set[T].new(equivalence_class_fun(r, a))
}

define is_saturated_under[T](s: Set[T], r: (T, T) -> Bool) -> Bool {
    forall(x: T, y: T) {
        s.contains(x) and r(x, y) implies s.contains(y)
    }
}

theorem relation_support_contains_eq[T](r: (T, T) -> Bool, x: T) {
    relation_support(r).contains(x) = relation_support_fun(r, x)
}

theorem relation_support_contains_witness[T](r: (T, T) -> Bool, x: T) {
    relation_support(r).contains(x) implies exists(y: T) {
        r(x, y)
    }
}

theorem relation_support_contains_of_related_left[T](r: (T, T) -> Bool, x: T, y: T) {
    r(x, y) implies relation_support(r).contains(x)
}

theorem relation_support_contains_of_related_right[T](r: (T, T) -> Bool, x: T, y: T) {
    is_symmetric(r) and r(x, y) implies relation_support(r).contains(y)
}

theorem equivalence_class_contains_eq[T](r: (T, T) -> Bool, a: T, x: T) {
    equivalence_class(r, a).contains(x) = r(a, x)
}

theorem equivalence_class_contains_of_related[T](r: (T, T) -> Bool, a: T, b: T) {
    r(a, b) implies equivalence_class(r, a).contains(b)
}

theorem equivalence_class_membership_eq_of_equiv[T](r: (T, T) -> Bool, a: T, b: T, x: T) {
    is_equivalence(r) and r(a, b) implies
    equivalence_class(r, a).contains(x) = equivalence_class(r, b).contains(x)
}

theorem equivalence_class_respects_equivalence[T](r: (T, T) -> Bool) {
    is_equivalence(r) implies respects_equivalence(equivalence_class(r), r, eq_relation[Set[T]])
}

theorem equivalence_class_eq_of_equiv[T](r: (T, T) -> Bool, a: T, b: T) {
    is_equivalence(r) and r(a, b) implies equivalence_class(r, a) = equivalence_class(r, b)
}

theorem equivalence_of_equivalence_class_eq[T](r: (T, T) -> Bool, a: T, b: T) {
    is_equivalence(r) and equivalence_class(r, a) = equivalence_class(r, b) implies r(a, b)
