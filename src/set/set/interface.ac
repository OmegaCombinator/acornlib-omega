theorem seq_union_contains_witness[T](seq: Nat -> Set[T], x: T) {
    seq_union(seq).contains(x) implies exists(i: Nat) {
        seq(i).contains(x)
    }
}

theorem seq_intersection_contains_eq[T](seq: Nat -> Set[T], x: T) {
