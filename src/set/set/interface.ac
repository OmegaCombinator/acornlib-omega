theorem decreasing_empty_intersection_eventually_bounded(s: Nat -> Set[Nat], tail_n: Nat) {
    is_decreasing(s) and seq_intersection(s).is_empty
    implies
    exists(big_n: Nat) {
        set_lower_bound(s(big_n), tail_n)
    }
}

