theorem decreasing_seq_eventual_lower_bound(s: Nat -> Set[Nat], big_n: Nat,
    bound: Nat) {
    is_decreasing(s) and set_lower_bound(s(big_n), bound) implies forall(i: Nat) {
        big_n <= i implies set_lower_bound(s(i), bound)
    }
