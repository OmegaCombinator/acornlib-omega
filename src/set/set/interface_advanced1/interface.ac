inductive TwoType {
    /// The first value.
    first
    /// The second value.
    second
}

define fun_of_two[K](a: Set[K], b: Set[K], x: TwoType) -> Set[K] {
    match x {
        TwoType.first {
            a
        }
        TwoType.second {
            b
        }
    }
}

define family_union_of_two[K](a: Set[K], b: Set[K]) -> Set[K] {
