}

define and_family[K, I] (f: I -> Set[K], x: K) -> Bool {
    forall(i: I) {
        f(i).contains(x)
    }
}

define union_family[K, I](f: I -> Set[K]) -> Set[K] {
    Set[K].new(or_family(f))
