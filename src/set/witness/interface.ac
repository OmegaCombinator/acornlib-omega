}

theorem contains_set_intro[K](l: List[K], s: Set[K]) {
    (forall(x: K) { s.contains(x) implies l.contains(x) }) implies l.contains_set(s)
}

define list_set[K](items: List[K]) -> Set[K] {
    items.as_set
}

theorem list_set_contains_eq[K](items: List[K], x: K) {
    list_set(items).contains(x) = items.contains(x)
}

theorem list_set_is_finite[K](items: List[K]) {
    list_set(items).is_finite
}

theorem list_set_cardinality_at_most_length[K](items: List[K]) {
    list_set(items).cardinality_at_most(items.length)
}

theorem list_set_filter_contains_eq[K](items: List[K], f: K -> Bool, x: K) {
    list_set(items.filter(f)).contains(x) = (list_set(items).contains(x) and f(x))
}

theorem list_set_filter_subset_list_set[K](items: List[K], f: K -> Bool) {
    list_set(items.filter(f)).subset(list_set(items))
}

theorem list_set_filter_subset_predicate[K](items: List[K], f: K -> Bool) {
    list_set(items.filter(f)).subset(Set[K].new(f))
}

theorem list_set_filter_eq_intersection[K](items: List[K], f: K -> Bool) {
    list_set(items.filter(f)) = list_set(items).intersection(Set[K].new(f))
}

theorem list_set_filter_extracts_subset[K](items: List[K], s: Set[K]) {
    s.subset(list_set(items)) implies list_set(items.filter(s.contains)) = s
}

theorem list_set_subset_has_list[K](items: List[K], s: Set[K]) {
    s.subset(list_set(items)) implies exists(subitems: List[K]) {
        list_set(subitems) = s
    }
}

theorem unique_list_set_cardinality_is_length[K](items: List[K]) {
    items.is_unique implies list_set(items).cardinality_is(items.length)
}

theorem empty_set_cardinality_is_zero[T] {
    Set[T].empty_set.cardinality_is(Nat.0)
}

theorem finite_set_not_infinite[T](s: Set[T]) {
    s.is_finite implies not s.is_infinite
}

theorem infinite_set_not_finite[T](s: Set[T]) {
    s.is_infinite implies not s.is_finite
}

theorem is_infinite_iff_not_finite[T](s: Set[T]) {
    s.is_infinite = not s.is_finite
}

theorem singleton_set_is_finite[T](a: T) {
    (Set[T].singleton(a)).is_finite
}

theorem singleton_set_cardinality_is_one[T](a: T) {
    (Set[T].singleton(a)).cardinality_is(Nat.1)
}

theorem insert_is_finite_of_finite[T](s: Set[T], item: T) {
    s.is_finite implies s.insert(item).is_finite
}

theorem remove_is_finite_of_finite[T](s: Set[T], item: T) {
    s.is_finite implies s.remove(item).is_finite
}

theorem union_is_finite_of_finite[K](a: Set[K], b: Set[K]) {
    a.is_finite and b.is_finite implies (a.union(b)).is_finite
}

theorem intersection_is_finite_of_finite[K](a: Set[K], b: Set[K]) {
    a.is_finite and b.is_finite implies (a.intersection(b)).is_finite
}

theorem difference_is_finite_of_finite[K](a: Set[K], b: Set[K]) {
    a.is_finite implies (a.difference(b)).is_finite
}

theorem subset_is_finite_of_finite[K](a: Set[K], b: Set[K]) {
    a.subset(b) and b.is_finite implies a.is_finite
}

theorem range_indexed_intersection_is_finite_of_member_finite[K](n: Nat,
    family: Nat -> Set[K], i: Nat) {
    i < n and family(i).is_finite implies range_indexed_intersection(n, family).is_finite
}

theorem superset_is_infinite_of_infinite[K](a: Set[K], b: Set[K]) {
    a.subset(b) and a.is_infinite implies b.is_infinite
}

theorem subset_not_infinite_of_finite[K](a: Set[K], b: Set[K]) {
    a.subset(b) and b.is_finite implies not a.is_infinite
}

theorem set_image_is_finite_of_finite[T, U](s: Set[T], f: T -> U) {
    s.is_finite implies set_image(s, f).is_finite
}

theorem set_image_cardinality_at_most[T, U](s: Set[T], f: T -> U, n: Nat) {
    s.cardinality_at_most(n) implies set_image(s, f).cardinality_at_most(n)
}

theorem injective_image_list_has_preimage_witnesses[T, U](s: Set[T], f: T -> U, image_items: List[U]) {
    is_injective_fn(f) and image_items.contains_set(set_image(s, f)) implies exists(witnesses: List[T]) {
        witnesses.contains_set(s)
    }
}

theorem finite_of_injective_image_contained_in_list[T, U](s: Set[T], f: T -> U, image_items: List[U]) {
    is_injective_fn(f) and image_items.contains_set(set_image(s, f)) implies s.is_finite
}

theorem set_image_preimage_list_set_contained[T, U](f: T -> U, image_items: List[U]) {
    image_items.contains_set(set_image(set_preimage(f, list_set(image_items)), f))
}

theorem injective_preimage_list_set_is_finite[T, U](f: T -> U, image_items: List[U]) {
    is_injective_fn(f) implies set_preimage(f, list_set(image_items)).is_finite
}

theorem cardinality_at_most_implies_is_finite[K](s: Set[K], n: Nat) {
    s.cardinality_at_most(n) implies s.is_finite
}

theorem finite_implies_exists_cardinality_at_most[K](s: Set[K]) {
    s.is_finite implies exists(n: Nat) {
        s.cardinality_at_most(n)
    }
}

theorem cardinality_always_exists[K](s: Set[K]) {
    s.is_finite implies exists(n: Nat) {
        s.cardinality_is(n)
    }
}

theorem union_is_at_most_length[K](a: Set[K], b: Set[K], n1: Nat, n2: Nat) {
    a.cardinality_at_most(n1) and b.cardinality_at_most(n2) implies a.union(b).cardinality_at_most(n1 + n2)
}

theorem subset_cardinality_at_most[K](a: Set[K], b: Set[K], n: Nat) {
    a.subset(b) and b.cardinality_at_most(n) implies a.cardinality_at_most(n)
}

theorem disjoint_union_is_length[K](a: Set[K], b: Set[K], n1: Nat, n2: Nat) {
    a.cardinality_is(n1) and b.cardinality_is(n2) and a.is_disjoint(b)
    implies
    a.union(b).cardinality_is(n1 + n2)
}

theorem insert_eq_union_singleton[K](s: Set[K], item: K) {
    s.insert(item) = s.union(Set[K].singleton(item))
}

theorem remove_eq_difference_singleton[K](s: Set[K], item: K) {
    s.remove(item) = s.difference(Set[K].singleton(item))
}

theorem insert_cardinality_is_suc_of_not_contains[K](s: Set[K], item: K, n: Nat) {
    s.cardinality_is(n) and not s.contains(item) implies s.insert(item).cardinality_is(n + Nat.1)
}

theorem remove_insert_cardinality_is_suc_of_contains[K](s: Set[K], item: K, n: Nat) {
    s.remove(item).cardinality_is(n) and s.contains(item) implies s.cardinality_is(n + Nat.1)
}

theorem cardinality_is_well_defined[K](s: Set[K], n1: Nat, n2: Nat) {
    s.cardinality_is(n1) and s.cardinality_is(n2) implies n1 = n2
}

theorem cardinality_is_smallest_cardinality[K](s: Set[K], n: Nat) {
    s.cardinality_is(n) implies s.cardinality_at_most(n)
}

theorem cardinality_is_implies_is_finite[K](s: Set[K], n: Nat) {
    s.cardinality_is(n) implies s.is_finite
}

theorem remove_cardinality_is_of_not_contains[K](s: Set[K], item: K, n: Nat) {
    s.cardinality_is(n) and not s.contains(item) implies s.remove(item).cardinality_is(n)
}

theorem remove_cardinality_is_pred_of_contains[K](s: Set[K], item: K, n: Nat) {
    s.cardinality_is(n + Nat.1) and s.contains(item) implies s.remove(item).cardinality_is(n)
}

theorem intersection_cardinality_is_of_subset_left[K](s: Set[K], t: Set[K], n: Nat) {
    s.subset(t) and s.cardinality_is(n) implies s.intersection(t).cardinality_is(n)
}

theorem intersection_cardinality_is_of_subset_right[K](s: Set[K], t: Set[K], n: Nat) {
    t.subset(s) and t.cardinality_is(n) implies s.intersection(t).cardinality_is(n)
}

theorem difference_cardinality_is_of_disjoint[K](s: Set[K], t: Set[K], n: Nat) {
    s.cardinality_is(n) and s.is_disjoint(t) implies s.difference(t).cardinality_is(n)
}

theorem difference_cardinality_is_zero_of_subset[K](s: Set[K], t: Set[K]) {
    s.subset(t) implies s.difference(t).cardinality_is(Nat.0)
}

theorem empty_set_is_finite[T] {
    Set[T].empty_set.is_finite
}

theorem union_cardinality_with_difference[K](s: Set[K], t: Set[K], n_s: Nat, n_diff: Nat) {
    s.cardinality_is(n_s) and t.difference(s).cardinality_is(n_diff) implies s.union(t).cardinality_is(n_s + n_diff)
}

theorem intersection_is_disjoint_difference[K](s: Set[K], t: Set[K]) {
    s.intersection(t).is_disjoint(s.difference(t))
}

theorem intersection_union_difference_is_self[K](s: Set[K], t: Set[K]) {
    s.intersection(t).union(s.difference(t)) = s
}

theorem intersection_difference_cardinality_adds[K](s: Set[K], t: Set[K], n_inter: Nat, n_diff: Nat) {
    s.intersection(t).cardinality_is(n_inter) and s.difference(t).cardinality_is(n_diff)
    implies s.cardinality_is(n_inter + n_diff)
}

theorem difference_cardinality_is_sub_intersection[K](s: Set[K], t: Set[K], n_s: Nat, n_inter: Nat) {
    s.cardinality_is(n_s) and s.intersection(t).cardinality_is(n_inter)
    implies s.difference(t).cardinality_is(n_s - n_inter)
}

theorem intersection_cardinality_is_sub_difference[K](s: Set[K], t: Set[K], n_s: Nat, n_diff: Nat) {
    s.cardinality_is(n_s) and s.difference(t).cardinality_is(n_diff)
    implies s.intersection(t).cardinality_is(n_s - n_diff)
}

theorem inclusion_exclusion[K](s: Set[K], t: Set[K], n_s: Nat, n_t: Nat, n_inter: Nat) {
    s.cardinality_is(n_s) and t.cardinality_is(n_t) and s.intersection(t).cardinality_is(n_inter)
    implies s.union(t).cardinality_is(n_s + n_t - n_inter)
}

theorem set_has_exact_containing_list[K](s: Set[K]) {
    s.is_finite implies exists(containing_list: List[K]) {
        forall(x: K) {
            s.contains(x) = containing_list.contains(x)
        } and containing_list.is_unique
    }
}

theorem finite_set_has_list_set[K](s: Set[K]) {
    s.is_finite implies exists(items: List[K]) {
        list_set(items) = s
    }
}

theorem finite_set_has_unique_list_set[K](s: Set[K]) {
    s.is_finite implies exists(items: List[K]) {
        list_set(items) = s and items.is_unique
    }
}

theorem set_cardinality_has_exact_unique_list[K](s: Set[K], n: Nat) {
    s.cardinality_is(n) implies exists(items: List[K]) {
        list_set(items) = s and items.is_unique and items.length = n
    }
}

theorem set_image_cardinality_is_of_injective[T, U](s: Set[T], f: T -> U, n: Nat) {
    is_injective_fn(f) and s.cardinality_is(n) implies set_image(s, f).cardinality_is(n)
}

theorem relation_power_pushforward_subset_step[A, B](f: A -> B, r: (A, A) -> Bool, n: Nat) {
    relation_subset(
        relation_pushforward(f, relation_power(r, n)),
        relation_power(relation_pushforward(f, r), n)
    )
    implies
    relation_subset(
        relation_pushforward(f, relation_power(r, n.suc)),
        relation_power(relation_pushforward(f, r), n.suc)
    )
}

theorem relation_power_pushforward_subset[A, B](f: A -> B, r: (A, A) -> Bool, n: Nat) {
    relation_subset(
        relation_pushforward(f, relation_power(r, n)),
        relation_power(relation_pushforward(f, r), n)
    )
}

theorem relation_power_positive_pushforward_reverse_base[A, B](f: A -> B, r: (A, A) -> Bool) {
    relation_subset(
        relation_power(relation_pushforward(f, r), Nat.zero.suc),
        relation_pushforward(f, relation_power(r, Nat.zero.suc))
    )
}

theorem relation_power_positive_pushforward_reverse_step_of_injective_at[A, B](
    f: A -> B,
    r: (A, A) -> Bool,
    n: Nat,
    u: B,
    v: B
) {
    is_injective_fn(f) and
    relation_subset(
        relation_power(relation_pushforward(f, r), n.suc),
        relation_pushforward(f, relation_power(r, n.suc))
    ) and
    relation_power(relation_pushforward(f, r), n.suc.suc, u, v)
    implies
    relation_pushforward(f, relation_power(r, n.suc.suc), u, v)
}

theorem relation_power_positive_pushforward_reverse_of_injective[A, B](f: A -> B, r: (A, A) -> Bool, n: Nat) {
    is_injective_fn(f) implies
    relation_subset(
        relation_power(relation_pushforward(f, r), n.suc),
        relation_pushforward(f, relation_power(r, n.suc))
    )
}

theorem relation_power_positive_pushforward_of_injective_at[A, B](
    f: A -> B,
    r: (A, A) -> Bool,
    n: Nat,
    u: B,
    v: B
) {
    is_injective_fn(f) implies
    relation_pushforward(f, relation_power(r, n.suc), u, v) =
    relation_power(relation_pushforward(f, r), n.suc, u, v)
}

theorem relation_refl_trans_closure_pushforward_subset[A, B](f: A -> B, r: (A, A) -> Bool) {
    relation_subset(
        relation_pushforward(f, relation_refl_trans_closure(r)),
        relation_refl_trans_closure(relation_pushforward(f, r))
    )
}

theorem relation_trans_closure_pushforward_subset[A, B](f: A -> B, r: (A, A) -> Bool) {
    relation_subset(
        relation_pushforward(f, relation_trans_closure(r)),
        relation_trans_closure(relation_pushforward(f, r))
    )
}

theorem relation_trans_closure_pushforward_of_injective_at[A, B](f: A -> B, r: (A, A) -> Bool, u: B, v: B) {
    is_injective_fn(f) implies
    relation_pushforward(f, relation_trans_closure(r), u, v) = relation_trans_closure(relation_pushforward(f, r), u, v)
}

theorem relation_refl_trans_closure_pushforward_of_bijection_at[A, B](f: A -> B, r: (A, A) -> Bool, u: B, v: B) {
    is_bijection_fn(f) implies
    relation_pushforward(f, relation_refl_trans_closure(r), u, v) =
    relation_refl_trans_closure(relation_pushforward(f, r), u, v)
}

theorem relation_pushforward_support_image_subset[A, B](f: A -> B, r: (A, A) -> Bool) {
    set_image(relation_support(r), f).subset(relation_support(relation_pushforward(f, r)))
}

theorem relation_pushforward_support_image_reverse[A, B](f: A -> B, r: (A, A) -> Bool) {
    relation_support(relation_pushforward(f, r)).subset(set_image(relation_support(r), f))
}

theorem relation_pushforward_support_image_eq[A, B](f: A -> B, r: (A, A) -> Bool) {
    set_image(relation_support(r), f) = relation_support(relation_pushforward(f, r))
}

theorem relation_pullback_support_subset_preimage[A, B](f: A -> B, r: (B, B) -> Bool) {
    relation_support(relation_pullback(f, r)).subset(set_preimage(f, relation_support(r)))
}

theorem relation_pullback_support_preimage_reverse_of_surjective[A, B](f: A -> B, r: (B, B) -> Bool) {
    is_surjective_fn(f) implies
    set_preimage(f, relation_support(r)).subset(relation_support(relation_pullback(f, r)))
}

theorem set_image_equivalence_class_pushforward_subset[A, B](f: A -> B, r: (A, A) -> Bool, a: A) {
    set_image(equivalence_class(r, a), f).subset(equivalence_class(relation_pushforward(f, r), f(a)))
}

theorem relation_pullback_equivalence_class_eq_preimage[A, B](f: A -> B, r: (B, B) -> Bool, a: A) {
    equivalence_class(relation_pullback(f, r), a) = set_preimage(f, equivalence_class(r, f(a)))
}

define symm_diff_contains[K](s: Set[K], t: Set[K], x: K) -> Bool {
    (s.contains(x) and not t.contains(x)) or (t.contains(x) and not s.contains(x))
}

define symm_diff[K](s: Set[K], t: Set[K]) -> Set[K] {
    Set[K].new(symm_diff_contains(s, t))
}

theorem mem_symm_diff[K](s: Set[K], t: Set[K], x: K) {
    symm_diff(s, t).contains(x) iff
        (s.contains(x) and not t.contains(x)) or (t.contains(x) and not s.contains(x))
}

theorem symm_diff_contains_eq[K](s: Set[K], t: Set[K], x: K) {
    symm_diff(s, t).contains(x) =
        ((s.contains(x) and not t.contains(x)) or (t.contains(x) and not s.contains(x)))
}

theorem symm_diff_def[K](s: Set[K], t: Set[K]) {
    symm_diff(s, t) = s.difference(t).union(t.difference(s))
}

define set_bihimp_contains[K](s: Set[K], t: Set[K], x: K) -> Bool {
    s.contains(x) = t.contains(x)
}

define set_bihimp[K](s: Set[K], t: Set[K]) -> Set[K] {
    Set[K].new(set_bihimp_contains(s, t))
}

theorem mem_bihimp_iff[K](s: Set[K], t: Set[K], x: K) {
    set_bihimp(s, t).contains(x) iff (s.contains(x) iff t.contains(x))
}

theorem symm_diff_subset_union[K](s: Set[K], t: Set[K]) {
    symm_diff(s, t).subset(s.union(t))
}

theorem symm_diff_eq_empty_contains_eq[K](s: Set[K], t: Set[K], x: K) {
    symm_diff(s, t) = Set[K].empty_set implies s.contains(x) = t.contains(x)
}

theorem eq_of_symm_diff_eq_empty[K](s: Set[K], t: Set[K]) {
    symm_diff(s, t) = Set[K].empty_set implies s = t
}

theorem not_symm_diff_contains_of_eq[K](s: Set[K], t: Set[K], x: K) {
    s = t implies not symm_diff(s, t).contains(x)
}

theorem symm_diff_eq_empty_of_eq[K](s: Set[K], t: Set[K]) {
    s = t implies symm_diff(s, t) = Set[K].empty_set
}

theorem symm_diff_eq_empty[K](s: Set[K], t: Set[K]) {
    symm_diff(s, t) = Set[K].empty_set iff s = t
}

define set_nonempty[K](s: Set[K]) -> Bool {
    s != Set[K].empty_set
}

theorem set_nonempty_iff_ne_empty[K](s: Set[K]) {
    set_nonempty(s) iff s != Set[K].empty_set
}

theorem symm_diff_nonempty[K](s: Set[K], t: Set[K]) {
    set_nonempty(symm_diff(s, t)) iff s != t
}

define sum_set_contains[T, U](left: Set[T], right: Set[U], s: Sum[T, U]) -> Bool {
    match s {
        Sum.inl(x) {
            left.contains(x)
        }
        Sum.inr(y) {
            right.contains(y)
        }
    }
}

define sum_set[T, U](left: Set[T], right: Set[U]) -> Set[Sum[T, U]] {
    Set[Sum[T, U]].new(sum_set_contains(left, right))
}

theorem sum_set_contains_inl[T, U](left: Set[T], right: Set[U], x: T) {
    sum_set(left, right).contains(Sum.inl[T, U](x)) = left.contains(x)
}

theorem sum_set_contains_inr[T, U](left: Set[T], right: Set[U], y: U) {
    sum_set(left, right).contains(Sum.inr[T, U](y)) = right.contains(y)
}

theorem sum_set_contains_left_of_component[T, U](left: Set[T], right: Set[U], x: T) {
    left.contains(x) implies sum_set(left, right).contains(Sum.inl[T, U](x))
}

theorem sum_set_contains_right_of_component[T, U](left: Set[T], right: Set[U], y: U) {
    right.contains(y) implies sum_set(left, right).contains(Sum.inr[T, U](y))
}

theorem sum_set_contains_inl_imp_left[T, U](left: Set[T], right: Set[U], x: T) {
    sum_set(left, right).contains(Sum.inl[T, U](x)) implies left.contains(x)
}

theorem sum_set_contains_inr_imp_right[T, U](left: Set[T], right: Set[U], y: U) {
    sum_set(left, right).contains(Sum.inr[T, U](y)) implies right.contains(y)
}

theorem sum_map_preserves_sum_set[T, U, V, W](left: Set[T], right: Set[U],
    left_target: Set[V], right_target: Set[W], f: T -> V, g: U -> W, s: Sum[T, U]) {
    sum_set(left, right).contains(s) and
    (forall(x: T) { left.contains(x) implies left_target.contains(f(x)) }) and
    (forall(y: U) { right.contains(y) implies right_target.contains(g(y)) })
    implies sum_set(left_target, right_target).contains(sum_map(s, f, g))
}

theorem sum_set_subset_left[T, U](left: Set[T], right: Set[U], left2: Set[T], right2: Set[U]) {
    sum_set(left, right).subset(sum_set(left2, right2)) implies left.subset(left2)
}

theorem sum_set_subset_right[T, U](left: Set[T], right: Set[U], left2: Set[T], right2: Set[U]) {
    sum_set(left, right).subset(sum_set(left2, right2)) implies right.subset(right2)
}

theorem sum_set_subset_of_components[T, U](left: Set[T], right: Set[U], left2: Set[T], right2: Set[U]) {
    left.subset(left2) and right.subset(right2) implies sum_set(left, right).subset(sum_set(left2, right2))
}

theorem sum_set_subset_iff[T, U](left: Set[T], right: Set[U], left2: Set[T], right2: Set[U]) {
    sum_set(left, right).subset(sum_set(left2, right2)) = (left.subset(left2) and right.subset(right2))
}

theorem sum_set_eq_iff[T, U](left: Set[T], right: Set[U], left2: Set[T], right2: Set[U]) {
    (sum_set(left, right) = sum_set(left2, right2)) = (left = left2 and right = right2)
}

theorem sum_set_image_sum_map[T, U, V, W](left: Set[T], right: Set[U], f: T -> V, g: U -> W) {
    set_image(sum_set(left, right), function(s: Sum[T, U]) { sum_map(s, f, g) }) =
        sum_set(set_image(left, f), set_image(right, g))
}

theorem sum_set_image_swap[T, U](left: Set[T], right: Set[U]) {
    set_image(sum_set(left, right), sum_swap[T, U]) = sum_set(right, left)
}

define exists_unique[T](p: T -> Bool) -> Bool {
    exists(x: T) {
        p(x) and forall(y: T) {
            p(y) implies y = x
        }
    }
}

theorem exists_unique_exists[T](p: T -> Bool) {
    exists_unique(p) implies exists(x: T) {
        p(x)
    }
}

theorem exists_unique_eq[T](p: T -> Bool, x: T, y: T) {
    exists_unique(p) and p(x) and p(y) implies x = y
}

theorem exists_unique_intro[T](p: T -> Bool, x: T) {
    p(x) and forall(y: T) {
        p(y) implies y = x
    } implies exists_unique(p)
}

theorem exists_unique_of_exists_and_pairwise[T](p: T -> Bool) {
    exists(x: T) {
        p(x)
    } and forall(x: T, y: T) {
        p(x) and p(y) implies x = y
    } implies exists_unique(p)
}

theorem exists_unique_congr[T](p: T -> Bool, q: T -> Bool) {
    (forall(x: T) { p(x) = q(x) }) implies
    (exists_unique(p) = exists_unique(q))
}

let choose_of_exists[T: Inhabited](p: T -> Bool) -> result: T satisfy {
    exists(x: T) {
        p(x)
    } implies p(result)
}

let choose_or_default[T](p: T -> Bool, default: T) -> result: T satisfy {
    (exists(x: T) {
        p(x)
    } implies p(result)) and
    (not exists(x: T) {
        p(x)
    } implies result = default)
}

theorem choose_of_exists_spec[T: Inhabited](p: T -> Bool) {
    exists(x: T) {
        p(x)
    } implies p(choose_of_exists(p))
}

let choose_witness[T: Inhabited](p: T -> Bool) -> result: T satisfy {
    exists(x: T) {
        p(x)
    } implies p(result)
}

theorem choose_witness_spec[T: Inhabited](p: T -> Bool) {
    exists(x: T) {
        p(x)
    } implies p(choose_witness(p))
}

theorem choose_witness_unique_spec[T: Inhabited](p: T -> Bool) {
    exists_unique(p) implies p(choose_witness(p))
}

theorem choose_witness_unique_eq[T: Inhabited](p: T -> Bool, x: T) {
    exists_unique(p) and p(x) implies choose_witness(p) = x
}

theorem choose_witness_unique_congr[T: Inhabited](p: T -> Bool, q: T -> Bool) {
    exists_unique(p) and forall(x: T) {
        p(x) = q(x)
    } implies choose_witness(p) = choose_witness(q)
}

theorem choose_or_default_spec[T](p: T -> Bool, default: T) {
    exists(x: T) {
        p(x)
    } implies p(choose_or_default(p, default))
}

theorem choose_or_default_eq_default[T](p: T -> Bool, default: T) {
    not exists(x: T) {
        p(x)
    } implies choose_or_default(p, default) = default
}

define list_witness_predicate[T](items: List[T], p: T -> Bool, x: T) -> Bool {
    items.contains(x) and p(x)
}

theorem list_witness_contains[T](items: List[T], p: T -> Bool, x: T) {
    list_witness_predicate(items, p, x) implies items.contains(x)
}

theorem list_witness_property[T](items: List[T], p: T -> Bool, x: T) {
    list_witness_predicate(items, p, x) implies p(x)
}

theorem list_witness_intro[T](items: List[T], p: T -> Bool, x: T) {
    items.contains(x) and p(x) implies list_witness_predicate(items, p, x)
}

theorem list_witness_exists_of_witness[T](items: List[T], p: T -> Bool, x: T) {
    list_witness_predicate(items, p, x) implies exists(y: T) {
        list_witness_predicate(items, p, y)
    }
}

let choose_from_list_or_default[T](items: List[T], p: T -> Bool, default: T) -> result: T satisfy {
    (exists(x: T) {
        list_witness_predicate(items, p, x)
    } implies list_witness_predicate(items, p, result)) and
    (not exists(x: T) {
        list_witness_predicate(items, p, x)
    } implies result = default)
}

theorem choose_from_list_or_default_spec[T](items: List[T], p: T -> Bool, default: T) {
    exists(x: T) {
        list_witness_predicate(items, p, x)
    } implies list_witness_predicate(items, p, choose_from_list_or_default(items, p, default))
}

theorem choose_from_list_or_default_contains[T](items: List[T], p: T -> Bool, default: T) {
    exists(x: T) {
        list_witness_predicate(items, p, x)
    } implies items.contains(choose_from_list_or_default(items, p, default))
}

theorem choose_from_list_or_default_property[T](items: List[T], p: T -> Bool, default: T) {
    exists(x: T) {
        list_witness_predicate(items, p, x)
    } implies p(choose_from_list_or_default(items, p, default))
}

theorem choose_from_list_or_default_eq_default[T](items: List[T], p: T -> Bool, default: T) {
    not exists(x: T) {
        list_witness_predicate(items, p, x)
    } implies choose_from_list_or_default(items, p, default) = default
}

theorem choose_from_list_or_default_unique_eq[T](items: List[T], p: T -> Bool, default: T, x: T) {
    exists_unique(list_witness_predicate(items, p)) and list_witness_predicate(items, p, x)
    implies choose_from_list_or_default(items, p, default) = x
}

theorem choose_from_list_or_default_unique_default_eq[T](items: List[T], p: T -> Bool, a: T, b: T) {
    exists_unique(list_witness_predicate(items, p)) implies
    choose_from_list_or_default(items, p, a) = choose_from_list_or_default(items, p, b)
}

