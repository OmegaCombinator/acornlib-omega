}

theorem choose_or_default_spec_of_predicate_eq[T](p: T -> Bool, q: T -> Bool, default: T) {
    p = q and exists(x: T) {
        p(x)
    } implies q(choose_or_default(p, default))
}

theorem choose_or_default_unique_eq_of_predicate_eq[T](p: T -> Bool, q: T -> Bool, default: T, x: T) {
