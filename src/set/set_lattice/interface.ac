}

theorem union_with_empty_is_self[K](s: Set[K]) {
    s.union(Set[K].empty_set) = s
}

theorem union_with_universal_is_universal[K](s: Set[K]) {
    s.union(Set[K].universal_set) = Set[K].universal_set
