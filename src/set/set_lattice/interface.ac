theorem set_subset_inf_iff[K](c: Set[K], a: Set[K], b: Set[K]) {
    c.subset(set_inf(a, b)) = (c.subset(a) and c.subset(b))
}

theorem set_subset_sup_left[K](a: Set[K], b: Set[K]) {
