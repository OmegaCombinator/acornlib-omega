theorem relation_pushforward_support_image_subset[A, B](f: A -> B, r: (A, A) -> Bool) {
    set_image(relation_support(r), f).subset(relation_support(relation_pushforward(f, r)))
}

theorem relation_pushforward_support_image_reverse[A, B](f: A -> B, r: (A, A) -> Bool) {
    relation_support(relation_pushforward(f, r)).subset(set_image(relation_support(r), f))
}

theorem relation_pushforward_support_image_eq[A, B](f: A -> B, r: (A, A) -> Bool) {
    set_image(relation_support(r), f) = relation_support(relation_pushforward(f, r))
}

theorem relation_pullback_support_subset_preimage[A, B](f: A -> B, r: (B, B) -> Bool) {
    relation_support(relation_pullback(f, r)).subset(set_preimage(f, relation_support(r)))
}

theorem relation_pullback_support_preimage_reverse_of_surjective[A, B](f: A -> B, r: (B, B) -> Bool) {
    is_surjective_fn(f) implies
    set_preimage(f, relation_support(r)).subset(relation_support(relation_pullback(f, r)))
}

theorem set_image_equivalence_class_pushforward_subset[A, B](f: A -> B, r: (A, A) -> Bool, a: A) {
    set_image(equivalence_class(r, a), f).subset(equivalence_class(relation_pushforward(f, r), f(a)))
}

theorem relation_pullback_equivalence_class_eq_preimage[A, B](f: A -> B, r: (B, B) -> Bool, a: A) {
    equivalence_class(relation_pullback(f, r), a) = set_preimage(f, equivalence_class(r, f(a)))
}

define relation_image_contains[A, B](r: (A, B) -> Bool, s: Set[A], y: B) -> Bool {
    exists(x: A) {
        s.contains(x) and r(x, y)
    }
}

define relation_image[A, B](r: (A, B) -> Bool, s: Set[A]) -> Set[B] {
    Set[B].new(relation_image_contains(r, s))
}

theorem relation_image_contains_eq[A, B](r: (A, B) -> Bool, s: Set[A], y: B) {
    relation_image(r, s).contains(y) = relation_image_contains(r, s, y)
}

theorem relation_image_intro[A, B](r: (A, B) -> Bool, s: Set[A], x: A, y: B) {
    s.contains(x) and r(x, y) implies relation_image(r, s).contains(y)
}

theorem relation_image_has_witness[A, B](r: (A, B) -> Bool, s: Set[A], y: B) {
    relation_image(r, s).contains(y) implies exists(x: A) {
        s.contains(x) and r(x, y)
    }
}

define relation_preimage_contains[A, B](r: (A, B) -> Bool, t: Set[B], x: A) -> Bool {
    exists(y: B) {
        t.contains(y) and r(x, y)
    }
}

define relation_preimage[A, B](r: (A, B) -> Bool, t: Set[B]) -> Set[A] {
    Set[A].new(relation_preimage_contains(r, t))
}

theorem relation_preimage_contains_eq[A, B](r: (A, B) -> Bool, t: Set[B], x: A) {
    relation_preimage(r, t).contains(x) = relation_preimage_contains(r, t, x)
}

theorem relation_preimage_intro[A, B](r: (A, B) -> Bool, t: Set[B], x: A, y: B) {
    t.contains(y) and r(x, y) implies relation_preimage(r, t).contains(x)
}

theorem relation_preimage_has_witness[A, B](r: (A, B) -> Bool, t: Set[B], x: A) {
    relation_preimage(r, t).contains(x) implies exists(y: B) {
        t.contains(y) and r(x, y)
    }
}

define relation_domain[A, B](r: (A, B) -> Bool) -> Set[A] {
    relation_image(relation_converse(r), Set[B].universal_set)
}

define relation_range[A, B](r: (A, B) -> Bool) -> Set[B] {
    relation_image(r, Set[A].universal_set)
}

define relation_restrict_source[A, B](r: (A, B) -> Bool, s: Set[A], x: A, y: B) -> Bool {
    s.contains(x) and r(x, y)
}

define relation_corestrict_target[A, B](r: (A, B) -> Bool, t: Set[B], x: A, y: B) -> Bool {
    r(x, y) and t.contains(y)
}

theorem relation_image_monotone_set[A, B](r: (A, B) -> Bool, s: Set[A], t: Set[A]) {
    s.subset(t) implies relation_image(r, s).subset(relation_image(r, t))
}

theorem relation_preimage_monotone_set[A, B](r: (A, B) -> Bool, s: Set[B], t: Set[B]) {
    s.subset(t) implies relation_preimage(r, s).subset(relation_preimage(r, t))
}

theorem relation_image_monotone_relation[A, B](r: (A, B) -> Bool, s: (A, B) -> Bool, a: Set[A]) {
    relation_subset(r, s) implies relation_image(r, a).subset(relation_image(s, a))
}

theorem relation_preimage_monotone_relation[A, B](r: (A, B) -> Bool, s: (A, B) -> Bool, a: Set[B]) {
    relation_subset(r, s) implies relation_preimage(r, a).subset(relation_preimage(s, a))
}

theorem relation_preimage_eq_image_converse[A, B](r: (A, B) -> Bool, t: Set[B]) {
    relation_preimage(r, t) = relation_image(relation_converse(r), t)
}

theorem relation_image_eq_preimage_converse[A, B](r: (A, B) -> Bool, s: Set[A]) {
    relation_image(r, s) = relation_preimage(relation_converse(r), s)
}

theorem relation_domain_contains_eq[A, B](r: (A, B) -> Bool, x: A) {
    relation_domain(r).contains(x) = exists(y: B) {
        r(x, y)
    }
}

theorem relation_range_contains_eq[A, B](r: (A, B) -> Bool, y: B) {
    relation_range(r).contains(y) = exists(x: A) {
        r(x, y)
    }
}

theorem relation_preimage_universal_eq_domain[A, B](r: (A, B) -> Bool) {
    relation_preimage(r, Set[B].universal_set) = relation_domain(r)
}

theorem relation_image_empty[A, B](r: (A, B) -> Bool) {
    relation_image(r, Set[A].empty_set) = Set[B].empty_set
}

theorem relation_preimage_empty[A, B](r: (A, B) -> Bool) {
    relation_preimage(r, Set[B].empty_set) = Set[A].empty_set
}

theorem relation_image_subset_range[A, B](r: (A, B) -> Bool, s: Set[A]) {
    relation_image(r, s).subset(relation_range(r))
}

theorem relation_preimage_subset_domain[A, B](r: (A, B) -> Bool, t: Set[B]) {
    relation_preimage(r, t).subset(relation_domain(r))
}

theorem relation_image_eq_relation[A](s: Set[A]) {
    relation_image(eq_relation[A], s) = s
}

theorem relation_preimage_eq_relation[A](s: Set[A]) {
    relation_preimage(eq_relation[A], s) = s
}

theorem relation_image_compose[A, B, C](r: (A, B) -> Bool, s: (B, C) -> Bool, a: Set[A]) {
    relation_image(relation_compose(r, s), a) = relation_image(s, relation_image(r, a))
}

theorem relation_preimage_compose[A, B, C](r: (A, B) -> Bool, s: (B, C) -> Bool, c: Set[C]) {
    relation_preimage(relation_compose(r, s), c) = relation_preimage(r, relation_preimage(s, c))
}

theorem relation_restrict_source_subset[A, B](r: (A, B) -> Bool, s: Set[A]) {
    relation_subset(relation_restrict_source(r, s), r)
}

theorem relation_corestrict_target_subset[A, B](r: (A, B) -> Bool, t: Set[B]) {
    relation_subset(relation_corestrict_target(r, t), r)
}

theorem relation_image_restrict_source[A, B](r: (A, B) -> Bool, s: Set[A], t: Set[A]) {
    relation_image(relation_restrict_source(r, s), t) = relation_image(r, s.intersection(t))
}

theorem relation_preimage_corestrict_target[A, B](r: (A, B) -> Bool, s: Set[B], t: Set[B]) {
    relation_preimage(relation_corestrict_target(r, s), t) = relation_preimage(r, s.intersection(t))
}

theorem relation_image_corestrict_target_subset[A, B](r: (A, B) -> Bool, s: Set[A], t: Set[B]) {
    relation_image(relation_corestrict_target(r, t), s).subset(t)
}

theorem relation_preimage_restrict_source_subset[A, B](r: (A, B) -> Bool, s: Set[A], t: Set[B]) {
    relation_preimage(relation_restrict_source(r, s), t).subset(s)
}

theorem difference_empty_right[K](s: Set[K]) {
    s.difference(Set[K].empty_set) = s
}

theorem empty_difference_left[K](s: Set[K]) {
    Set[K].empty_set.difference(s) = Set[K].empty_set
}

theorem difference_universal_right[K](s: Set[K]) {
    s.difference(Set[K].universal_set) = Set[K].empty_set
}

theorem universal_difference_eq_complement[K](s: Set[K]) {
    Set[K].universal_set.difference(s) = s.c
}

theorem difference_complement_right_eq_intersection[K](s: Set[K], t: Set[K]) {
    s.difference(t.c) = s.intersection(t)
}

theorem difference_of_subset_eq_empty[K](s: Set[K], t: Set[K]) {
    s.subset(t) implies s.difference(t) = Set[K].empty_set
}

theorem set_preimage_image_of_bijection[T, U](s: Set[T], f: T -> U) {
    is_bijection_fn(f) implies set_preimage(f, set_image(s, f)) = s
}

theorem set_image_preimage_of_bijection[T, U](s: Set[U], f: T -> U) {
    is_bijection_fn(f) implies set_image(set_preimage(f, s), f) = s
}

theorem subset_iff_set_image_subset_of_bijection[T, U](a: Set[T], b: Set[T], f: T -> U) {
    is_bijection_fn(f) implies (a.subset(b) = set_image(a, f).subset(set_image(b, f)))
}

theorem subset_iff_set_preimage_subset_of_bijection[T, U](a: Set[U], b: Set[U], f: T -> U) {
    is_bijection_fn(f) implies (a.subset(b) = set_preimage(f, a).subset(set_preimage(f, b)))
}

theorem set_preimage_subset_iff_subset_set_image_of_bijection[T, U](a: Set[T], b: Set[U], f: T -> U) {
    is_bijection_fn(f) implies (set_preimage(f, b).subset(a) = b.subset(set_image(a, f)))
}

theorem set_image_eq_iff_eq_preimage_of_bijection[T, U](a: Set[T], b: Set[U], f: T -> U) {
    is_bijection_fn(f) implies ((set_image(a, f) = b) = (a = set_preimage(f, b)))
}

theorem set_image_eq_iff_eq_of_bijection[T, U](a: Set[T], b: Set[T], f: T -> U) {
    is_bijection_fn(f) implies ((set_image(a, f) = set_image(b, f)) = (a = b))
}

theorem set_preimage_eq_iff_eq_of_bijection[T, U](a: Set[U], b: Set[U], f: T -> U) {
    is_bijection_fn(f) implies ((set_preimage(f, a) = set_preimage(f, b)) = (a = b))
}

theorem set_image_intersection_of_bijection[T, U](a: Set[T], b: Set[T], f: T -> U) {
    is_bijection_fn(f) implies
    set_image(a.intersection(b), f) = set_image(a, f).intersection(set_image(b, f))
}

theorem set_image_difference_of_bijection[T, U](a: Set[T], b: Set[T], f: T -> U) {
    is_bijection_fn(f) implies
    set_image(a.difference(b), f) = set_image(a, f).difference(set_image(b, f))
}

theorem set_preimage_image_complement_of_bijection[T, U](s: Set[T], f: T -> U) {
    is_bijection_fn(f) implies set_preimage(f, set_image(s, f).c) = s.c
}

theorem set_image_preimage_complement_of_bijection[T, U](s: Set[U], f: T -> U) {
    is_bijection_fn(f) implies set_image(set_preimage(f, s).c, f) = s.c
}

theorem set_preimage_difference[T, U](f: T -> U, a: Set[U], b: Set[U]) {
    set_preimage(f, a.difference(b)) = set_preimage(f, a).difference(set_preimage(f, b))
}

theorem set_image_disjoint_imp_disjoint[T, U](a: Set[T], b: Set[T], f: T -> U) {
    set_image(a, f).is_disjoint(set_image(b, f)) implies a.is_disjoint(b)
}

theorem set_image_disjoint_of_injective[T, U](a: Set[T], b: Set[T], f: T -> U) {
    is_injective_fn(f) and a.is_disjoint(b) implies
        set_image(a, f).is_disjoint(set_image(b, f))
}

theorem set_image_disjoint_iff_of_injective[T, U](a: Set[T], b: Set[T], f: T -> U) {
    is_injective_fn(f) implies
        (set_image(a, f).is_disjoint(set_image(b, f)) = a.is_disjoint(b))
}

theorem set_image_disjoint_iff_of_bijection[T, U](a: Set[T], b: Set[T], f: T -> U) {
    is_bijection_fn(f) implies
        (set_image(a, f).is_disjoint(set_image(b, f)) = a.is_disjoint(b))
}

define maps_into[T](g: Nat -> T, s: Set[T]) -> Bool {
    forall(i: Nat) {
        s.contains(g(i))
    }
}

theorem maps_into_apply[T](g: Nat -> T, s: Set[T], i: Nat) {
    maps_into(g, s) implies s.contains(g(i))
}

theorem maps_into_intro[T](g: Nat -> T, s: Set[T]) {
    (forall(i: Nat) { s.contains(g(i)) }) implies maps_into(g, s)
}

theorem set_infinite_of_injection[T](g: Nat -> T, s: Set[T]) {
    is_injective_fn(g) and maps_into(g, s) implies s.is_infinite
}

define set_inf[K](a: Set[K], b: Set[K]) -> Set[K] {
    a.intersection(b)
}

define set_sup[K](a: Set[K], b: Set[K]) -> Set[K] {
    a.union(b)
}

theorem set_inf_contains_eq[K](a: Set[K], b: Set[K], x: K) {
    set_inf(a, b).contains(x) = (a.contains(x) and b.contains(x))
}

theorem set_sup_contains_eq[K](a: Set[K], b: Set[K], x: K) {
    set_sup(a, b).contains(x) = (a.contains(x) or b.contains(x))
}

theorem set_inf_subset_left[K](a: Set[K], b: Set[K]) {
    set_inf(a, b).subset(a)
}

theorem set_inf_subset_right[K](a: Set[K], b: Set[K]) {
    set_inf(a, b).subset(b)
}

theorem set_subset_inf_of_subset_left_right[K](c: Set[K], a: Set[K], b: Set[K]) {
    c.subset(a) and c.subset(b) implies c.subset(set_inf(a, b))
}

theorem set_subset_inf_iff[K](c: Set[K], a: Set[K], b: Set[K]) {
    c.subset(set_inf(a, b)) = (c.subset(a) and c.subset(b))
}

theorem set_subset_sup_left[K](a: Set[K], b: Set[K]) {
    a.subset(set_sup(a, b))
}

theorem set_subset_sup_right[K](a: Set[K], b: Set[K]) {
    b.subset(set_sup(a, b))
}

theorem set_sup_subset_of_subset_left_right[K](a: Set[K], b: Set[K], c: Set[K]) {
    a.subset(c) and b.subset(c) implies set_sup(a, b).subset(c)
}

theorem set_sup_subset_iff[K](a: Set[K], b: Set[K], c: Set[K]) {
    set_sup(a, b).subset(c) = (a.subset(c) and b.subset(c))
}

theorem set_inf_monotone[K](a: Set[K], b: Set[K], c: Set[K], d: Set[K]) {
    a.subset(c) and b.subset(d) implies set_inf(a, b).subset(set_inf(c, d))
}

theorem set_sup_monotone[K](a: Set[K], b: Set[K], c: Set[K], d: Set[K]) {
    a.subset(c) and b.subset(d) implies set_sup(a, b).subset(set_sup(c, d))
}

theorem set_inf_comm[K](a: Set[K], b: Set[K]) {
    set_inf(a, b) = set_inf(b, a)
}

theorem set_sup_comm[K](a: Set[K], b: Set[K]) {
    set_sup(a, b) = set_sup(b, a)
}

theorem set_inf_assoc[K](a: Set[K], b: Set[K], c: Set[K]) {
    set_inf(a, set_inf(b, c)) = set_inf(set_inf(a, b), c)
}

theorem set_sup_assoc[K](a: Set[K], b: Set[K], c: Set[K]) {
    set_sup(a, set_sup(b, c)) = set_sup(set_sup(a, b), c)
}

theorem set_inf_idem[K](s: Set[K]) {
    set_inf(s, s) = s
}

theorem set_sup_idem[K](s: Set[K]) {
    set_sup(s, s) = s
}

theorem set_inf_universal_right[K](s: Set[K]) {
    set_inf(s, Set[K].universal_set) = s
}

theorem set_inf_universal_left[K](s: Set[K]) {
    set_inf(Set[K].universal_set, s) = s
}

theorem set_sup_empty_right[K](s: Set[K]) {
    set_sup(s, Set[K].empty_set) = s
}

theorem set_sup_empty_left[K](s: Set[K]) {
    set_sup(Set[K].empty_set, s) = s
}

theorem set_inf_empty_right[K](s: Set[K]) {
    set_inf(s, Set[K].empty_set) = Set[K].empty_set
}

theorem set_inf_empty_left[K](s: Set[K]) {
    set_inf(Set[K].empty_set, s) = Set[K].empty_set
}

theorem set_sup_universal_right[K](s: Set[K]) {
    set_sup(s, Set[K].universal_set) = Set[K].universal_set
}

theorem set_sup_universal_left[K](s: Set[K]) {
    set_sup(Set[K].universal_set, s) = Set[K].universal_set
}

theorem set_inf_sup_absorb[K](a: Set[K], b: Set[K]) {
    set_inf(a, set_sup(a, b)) = a
}

theorem set_sup_inf_absorb[K](a: Set[K], b: Set[K]) {
    set_sup(a, set_inf(a, b)) = a
}

theorem set_inf_sup_distrib_left[K](a: Set[K], b: Set[K], c: Set[K]) {
    set_inf(a, set_sup(b, c)) = set_sup(set_inf(a, b), set_inf(a, c))
}

theorem set_sup_inf_distrib_left[K](a: Set[K], b: Set[K], c: Set[K]) {
    set_sup(a, set_inf(b, c)) = set_inf(set_sup(a, b), set_sup(a, c))
}

theorem set_image_sup[T, U](a: Set[T], b: Set[T], f: T -> U) {
    set_image(set_sup(a, b), f) = set_sup(set_image(a, f), set_image(b, f))
}

theorem set_image_inf_subset[T, U](a: Set[T], b: Set[T], f: T -> U) {
    set_image(set_inf(a, b), f).subset(set_inf(set_image(a, f), set_image(b, f)))
}

theorem set_image_inf_reverse_of_injective[T, U](a: Set[T], b: Set[T], f: T -> U) {
    is_injective_fn(f) implies
