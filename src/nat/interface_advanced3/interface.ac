theorem read_add_read(a: Nat, b: Nat, c: Nat, d: Nat) {
    a.read(b) + c.read(d) = (a + c).read(b + d)
}

theorem read_mul_single(a: Nat, b: Nat, d: Nat) {
    a.read(b) * d = (a * d).read(b * d)
}

theorem read_read_carry(a: Nat, q: Nat, e: Nat) {
    a.read(10 * q + e) = (a + q).read(e)
}

