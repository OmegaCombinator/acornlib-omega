}

theorem carry_in_fuel_comm(p: Nat, a: Nat, b: Nat, c: Nat, fuel: Nat) {
    carry_in_fuel(p, a, b, c, fuel) = carry_in_fuel(p, b, a, c, fuel)
}

theorem carry_in_fuel_zero_right(p: Nat, a: Nat, fuel: Nat) {
