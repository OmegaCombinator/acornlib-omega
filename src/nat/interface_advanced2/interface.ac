}

define carry_in_fuel(p: Nat, a: Nat, b: Nat, c: Nat, fuel: Nat) -> Nat {
    match fuel {
        Nat.zero {
            c
        }
        Nat.suc(k) {
            carry_in_fuel(p, a.div(p), b.div(p), carry_out(p, a, b, c), k)
        }
    }
}

theorem carry_in_fuel_zero(p: Nat, a: Nat, b: Nat, c: Nat) {
