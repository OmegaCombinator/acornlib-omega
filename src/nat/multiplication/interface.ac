instance Nat: Add {
    define add(self, other: Nat) -> Nat {
        match other {
            Nat.zero {
                self
            }
            Nat.suc(pred) {
                Add.add[Nat](self, pred).suc
            }
        }
    }
}

instance Nat: Mul {
    define mul(self, b: Nat) -> Nat {
        match b {
            Nat.zero {
                0
            }
            Nat.suc(pred) {
                Mul.mul[Nat](self, pred) + self
            }
        }
    }
}

instance Nat: LTE {
