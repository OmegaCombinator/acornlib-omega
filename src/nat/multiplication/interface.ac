define count_multiples(d: Nat, n: Nat) -> Nat {
    match n {
        Nat.zero {
            Nat.0
        }
        Nat.suc(k) {
            if d.divides(n) {
                count_multiples(d, k) + Nat.1
            } else {
                count_multiples(d, k)
            }
        }
    }
}

