/// Public interface for the package.

from nat import Nat
from set import Set, set_image
from algebra import Pair
from sum_type import Sum
from rational import nat_pair_zigzag
from function import is_bijection_fn
from set import pair_set, sum_set
from list import List
from set import finite_constraint, list_set, list_indexed_union,
    range_indexed_union
from integer import Int
from rational import int_zigzag, Rat, rat_zigzag

define is_countable[T](s: Set[T]) -> Bool {
    s = Set[T].empty_set or exists(f: Nat -> T) {
        forall(x: T) {
            s.contains(x) implies exists(n: Nat) { f(n) = x }
        }
    }
}

theorem empty_set_is_countable[T] {
    is_countable[T](Set[T].empty_set)
}

theorem countable_has_sequence_of_nonempty[T](s: Set[T]) {
    is_countable[T](s) and s != Set[T].empty_set implies exists(f: Nat -> T) {
        forall(x: T) {
            s.contains(x) implies exists(n: Nat) { f(n) = x }
        }
    }
}

theorem subset_of_sequence_covered_is_countable[T](s: Set[T], t: Set[T], f: Nat -> T) {
    s.subset(t) and forall(x: T) {
        t.contains(x) implies exists(n: Nat) { f(n) = x }
    } implies is_countable[T](s)
}

theorem image_of_sequence_covered_is_countable[T, U](s: Set[T], h: T -> U, f: Nat -> T) {
    (forall(x: T) {
        s.contains(x) implies exists(n: Nat) { f(n) = x }
    }) implies is_countable[U](set_image(s, h))
}

theorem subset_of_empty_is_countable[T](s: Set[T]) {
    s.subset(Set[T].empty_set) implies is_countable[T](s)
}

theorem subset_of_nonempty_countable_is_countable[T](s: Set[T], t: Set[T]) {
    s.subset(t) and is_countable[T](t) and t != Set[T].empty_set implies is_countable[T](s)
}

theorem subset_of_countable_is_countable[T](s: Set[T], t: Set[T]) {
    s.subset(t) and is_countable[T](t) implies is_countable[T](s)
}

theorem image_of_countable_is_countable[T, U](s: Set[T], h: T -> U) {
    is_countable[T](s) implies is_countable[U](set_image(s, h))
}

define sequence_tail[T](f: Nat -> T, n: Nat) -> T {
    f(n.suc)
}

define countable_even_index(n: Nat) -> Nat {
    match n {
        Nat.zero {
            Nat.0
        }
        Nat.suc(pred) {
            countable_even_index(pred).suc.suc
        }
    }
}

define countable_odd_index(n: Nat) -> Nat {
    countable_even_index(n).suc
}

define interleave_sequences[T](f: Nat -> T, g: Nat -> T, n: Nat) -> T {
    match n {
        Nat.zero {
            f(Nat.0)
        }
        Nat.suc(pred) {
            interleave_sequences(g, sequence_tail(f), pred)
        }
    }
}

theorem interleave_sequences_suc_suc[T](f: Nat -> T, g: Nat -> T, n: Nat) {
    interleave_sequences(f, g, n.suc.suc) =
        interleave_sequences(sequence_tail(f), sequence_tail(g), n)
}

theorem interleave_sequences_left_index[T](f: Nat -> T, g: Nat -> T, n: Nat) {
    interleave_sequences(f, g, countable_even_index(n)) = f(n)
}

theorem interleave_sequences_right_index[T](f: Nat -> T, g: Nat -> T, n: Nat) {
    interleave_sequences(f, g, countable_odd_index(n)) = g(n)
}

theorem union_of_countable_is_countable[T](s: Set[T], t: Set[T]) {
    is_countable[T](s) and is_countable[T](t) implies is_countable[T](s.union(t))
}

theorem nat_universal_is_countable {
    is_countable[Nat](Set[Nat].universal_set)
}

theorem countable_transfer_along_bijection[T, U](s: Set[T], f: T -> U) {
    is_countable[T](s) and is_bijection_fn(f) implies is_countable[U](set_image(s, f))
}

theorem countable_type_transfer_along_bijection[T, U](f: T -> U) {
    is_countable[T](Set[T].universal_set) and is_bijection_fn(f) implies
        is_countable[U](Set[U].universal_set)
}

theorem sequence_covered_set_is_countable[T](s: Set[T], f: Nat -> T) {
    (forall(x: T) {
        s.contains(x) implies exists(n: Nat) { f(n) = x }
    }) implies is_countable[T](s)
}

define pair_enum[T, U](f: Nat -> T, g: Nat -> U, n: Nat) -> Pair[T, U] {
    Pair.new(f(nat_pair_zigzag(n).first), g(nat_pair_zigzag(n).second))
}

theorem pair_set_of_countable_is_countable[T, U](s: Set[T], t: Set[U]) {
    is_countable[T](s) and is_countable[U](t) implies is_countable[Pair[T, U]](pair_set(s, t))
}

theorem countable_type_product[T, U] {
    is_countable[T](Set[T].universal_set) and is_countable[U](Set[U].universal_set) implies
        is_countable[Pair[T, U]](Set[Pair[T, U]].universal_set)
}

define sum_left_enum[T, U](f: Nat -> T, n: Nat) -> Sum[T, U] {
    Sum.inl[T, U](f(n))
}

define sum_right_enum[T, U](g: Nat -> U, n: Nat) -> Sum[T, U] {
    Sum.inr[T, U](g(n))
}

theorem sum_set_of_countable_is_countable[T, U](s: Set[T], t: Set[U]) {
    is_countable[T](s) and is_countable[U](t) implies is_countable[Sum[T, U]](sum_set(s, t))
}

theorem countable_type_sum[T, U] {
    is_countable[T](Set[T].universal_set) and is_countable[U](Set[U].universal_set) implies
        is_countable[Sum[T, U]](Set[Sum[T, U]].universal_set)
}

define list_code_enum[T](enum: Nat -> T, n: Nat, code: Nat) -> List[T] {
    match n {
        Nat.zero {
            List.nil[T]
        }
        Nat.suc(pred) {
            List.cons(enum(nat_pair_zigzag(code).first),
                list_code_enum(enum, pred, nat_pair_zigzag(code).second))
        }
    }
}

define list_enum[T](enum: Nat -> T, n: Nat) -> List[T] {
    list_code_enum(enum, nat_pair_zigzag(n).first, nat_pair_zigzag(n).second)
}

theorem list_code_enum_covers[T](enum: Nat -> T, l: List[T]) {
    (forall(x: T) { exists(i: Nat) { enum(i) = x } }) implies
        exists(code: Nat) { list_code_enum(enum, l.length, code) = l }
}

theorem list_enum_covers[T](enum: Nat -> T, l: List[T]) {
    (forall(x: T) { exists(i: Nat) { enum(i) = x } }) implies
        exists(n: Nat) { list_enum(enum, n) = l }
}

theorem lists_of_empty_type_are_nil[T] {
    Set[T].universal_set = Set[T].empty_set implies
        forall(l: List[T]) { l = List.nil[T] }
}

define nil_sequence[T](n: Nat) -> List[T] {
    List.nil[T]
}

theorem finite_sequences_of_countable_are_countable[T] {
    is_countable[T](Set[T].universal_set) implies
        is_countable[List[T]](Set[List[T]].universal_set)
}

theorem singleton_set_is_countable[T](x: T) {
    is_countable[T](Set[T].singleton(x))
}

theorem insert_countable_is_countable[T](s: Set[T], item: T) {
    is_countable[T](s) implies is_countable[T](s.insert(item))
}

theorem list_set_cons_eq_union_singleton[T](head: T, tail: List[T]) {
    list_set(List.cons(head, tail)) = Set[T].singleton(head).union(list_set(tail))
}

theorem list_set_cons_eq_singleton_union[T](head: T, tail: List[T]) {
    list_set[T](List.cons(head, tail)) = Set[T].singleton(head).union(list_set[T](tail))
}

theorem list_set_is_countable[T](items: List[T]) {
    is_countable[T](list_set(items))
}

theorem list_indexed_union_of_countable_is_countable[K, I](items: List[I], family: I -> Set[K]) {
    (forall(i: I) { items.contains(i) implies is_countable[K](family(i)) }) implies
    is_countable[K](list_indexed_union(items, family))
}

theorem range_indexed_union_of_countable_is_countable[K](n: Nat, family: Nat -> Set[K]) {
    (forall(i: Nat) { i < n implies is_countable[K](family(i)) }) implies
    is_countable[K](range_indexed_union(n, family))
}

theorem finite_set_is_countable[T](s: Set[T]) {
    s.is_finite implies is_countable[T](s)
}

theorem finite_set_image_is_countable[T, U](s: Set[T], h: T -> U) {
    s.is_finite implies is_countable[U](set_image(s, h))
}

theorem finite_set_has_countable_list_indexed_union[K, I](indices: Set[I], family: I -> Set[K]) {
    indices.is_finite and
    (forall(i: I) { indices.contains(i) implies is_countable[K](family(i)) }) implies
    exists(items: List[I]) {
        list_set(items) = indices and is_countable[K](list_indexed_union(items, family))
    }
}

theorem finite_constraint_set_is_countable[T](contains: T -> Bool) {
    finite_constraint[T](contains) implies is_countable[T](Set[T].new(contains))
}

define list_union_sets[T](items: List[Set[T]]) -> Set[T] {
    match items {
        List.nil {
            Set[T].empty_set
        }
        List.cons(head, tail) {
            head.union(list_union_sets(tail))
        }
    }
}

define list_sets_countable[T](items: List[Set[T]]) -> Bool {
    match items {
        List.nil {
            true
        }
        List.cons(head, tail) {
            is_countable[T](head) and list_sets_countable[T](tail)
        }
    }
}

theorem list_union_sets_nil[T] {
    list_union_sets[T](List.nil[Set[T]]) = Set[T].empty_set
}

theorem list_union_sets_cons[T](head: Set[T], tail: List[Set[T]]) {
    list_union_sets[T](List.cons(head, tail)) = head.union(list_union_sets[T](tail))
}

theorem list_union_sets_nil_contains_eq[T](x: T) {
    list_union_sets[T](List.nil[Set[T]]).contains(x) = false
}

theorem list_union_sets_cons_contains_eq[T](head: Set[T], tail: List[Set[T]], x: T) {
    list_union_sets[T](List.cons(head, tail)).contains(x) =
        (head.contains(x) or list_union_sets[T](tail).contains(x))
}

theorem list_sets_countable_nil[T] {
    list_sets_countable[T](List.nil[Set[T]])
}

theorem list_sets_countable_cons_imp[T](head: Set[T], tail: List[Set[T]]) {
    list_sets_countable[T](List.cons(head, tail)) implies
        is_countable[T](head) and list_sets_countable[T](tail)
}

theorem list_sets_countable_cons_intro[T](head: Set[T], tail: List[Set[T]]) {
    is_countable[T](head) and list_sets_countable[T](tail) implies
        list_sets_countable[T](List.cons(head, tail))
}

define list_sets_all_countable[T](items: List[Set[T]]) -> Bool {
    forall(s: Set[T]) {
        items.contains(s) implies is_countable[T](s)
    }
}

theorem list_sets_all_countable_nil[T] {
    list_sets_all_countable[T](List.nil[Set[T]])
}

theorem list_sets_all_countable_cons_head[T](head: Set[T], tail: List[Set[T]]) {
    list_sets_all_countable[T](List.cons(head, tail)) implies is_countable[T](head)
}

theorem list_sets_all_countable_cons_tail[T](head: Set[T], tail: List[Set[T]]) {
    list_sets_all_countable[T](List.cons(head, tail)) implies list_sets_all_countable[T](tail)
}

theorem list_sets_countable_cons_of_all_countable[T](head: Set[T], tail: List[Set[T]]) {
    list_sets_all_countable[T](List.cons(head, tail)) and
        list_sets_countable[T](tail) implies list_sets_countable[T](List.cons(head, tail))
}

theorem list_sets_all_countable_implies_list_sets_countable[T](items: List[Set[T]]) {
    list_sets_all_countable[T](items) implies list_sets_countable[T](items)
}

theorem list_sets_countable_of_forall_contains[T](items: List[Set[T]]) {
    (forall(s: Set[T]) { items.contains(s) implies is_countable[T](s) }) implies
        list_sets_countable[T](items)
}

theorem list_union_sets_nil_is_countable[T] {
    is_countable[T](list_union_sets[T](List.nil[Set[T]]))
}

theorem list_union_sets_cons_is_countable[T](head: Set[T], tail: List[Set[T]]) {
    is_countable[T](head) and is_countable[T](list_union_sets[T](tail)) implies
        is_countable[T](list_union_sets[T](List.cons(head, tail)))
}

theorem list_union_sets_is_countable[T](items: List[Set[T]]) {
    list_sets_countable[T](items) implies is_countable[T](list_union_sets[T](items))
}

theorem list_union_sets_of_forall_contains_is_countable[T](items: List[Set[T]]) {
    (forall(s: Set[T]) { items.contains(s) implies is_countable[T](s) }) implies
        is_countable[T](list_union_sets[T](items))
}

theorem list_union_sets_contains_of_member_contains[T](items: List[Set[T]], member: Set[T], x: T) {
    items.contains(member) and member.contains(x) implies list_union_sets[T](items).contains(x)
}

theorem int_universal_set_is_countable {
    is_countable[Int](Set[Int].universal_set)
}

theorem int_subset_is_countable(s: Set[Int]) {
    is_countable[Int](s)
}

theorem int_range_zigzag_is_universal {
    set_image(Set[Nat].universal_set, int_zigzag) = Set[Int].universal_set
}

theorem int_countable_has_sequence(s: Set[Int]) {
    s != Set[Int].empty_set implies exists(f: Nat -> Int) {
        forall(x: Int) { s.contains(x) implies exists(n: Nat) { f(n) = x } }
    }
}

theorem rat_universal_set_is_countable {
    is_countable[Rat](Set[Rat].universal_set)
}

theorem rat_subset_is_countable(s: Set[Rat]) {
    is_countable[Rat](s)
}

theorem rat_range_zigzag_is_universal {
    set_image(Set[Nat].universal_set, rat_zigzag) = Set[Rat].universal_set
}

theorem rat_from_nat_image_is_countable {
    is_countable[Rat](set_image(Set[Nat].universal_set, Rat.from_nat))
}

theorem rat_countable_has_sequence(s: Set[Rat]) {
    s != Set[Rat].empty_set implies exists(f: Nat -> Rat) {
        forall(x: Rat) { s.contains(x) implies exists(n: Nat) { f(n) = x } }
    }
}

