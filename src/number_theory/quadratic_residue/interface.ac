theorem gauss_mul_zero_left(a: GaussInt) {
    GaussInt.0 * a = GaussInt.0
}

theorem gauss_conj_add(a: GaussInt, b: GaussInt) {
    (a + b).conj = a.conj + b.conj
}

theorem gauss_conj_mul(a: GaussInt, b: GaussInt) {
    (a * b).conj = a.conj * b.conj
