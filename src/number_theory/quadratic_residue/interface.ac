theorem one_mod_three {
    Nat.1.mod(Nat.3) = Nat.1
}

theorem two_mod_three {
    Nat.2.mod(Nat.3) = Nat.2
}

theorem square_mod_three_case(a: Nat) {
    (a * a).mod(Nat.3) = Nat.0 or (a * a).mod(Nat.3) = Nat.1
}

theorem mod_three_sum_pair_zero_imp_u_zero(u: Nat, v: Nat) {
    (u + v).mod(Nat.3) = Nat.0 and (u = Nat.0 or u = Nat.1) and (v = Nat.0 or v = Nat.1)
        implies u = Nat.0
}

theorem mod_three_sum_pair_zero_imp_v_zero(u: Nat, v: Nat) {
    (u + v).mod(Nat.3) = Nat.0 and (u = Nat.0 or u = Nat.1) and (v = Nat.0 or v = Nat.1)
        implies v = Nat.0
}

theorem three_divides_sum_two_squares(x: Nat, y: Nat) {
    Nat.3.divides(x * x + y * y) implies Nat.3.divides(x) and Nat.3.divides(y)
}

theorem sq_sum_three_sq_descent(x: Nat, y: Nat, z: Nat) {
    z != Nat.0 and x * x + y * y = Nat.3 * (z * z) implies
        exists(a: Nat, b: Nat, c: Nat) {
            c < z and Nat.3 * c = z and a * a + b * b = Nat.3 * (c * c)
        }
}

theorem sq_sum_three_sq_zero(z: Nat) {
    forall(x: Nat, y: Nat) { x * x + y * y = Nat.3 * (z * z) implies z = Nat.0 }
}

theorem no_nontrivial_sq_sum_three_sq(x: Nat, y: Nat, z: Nat) {
    x * x + y * y = Nat.3 * (z * z) implies x = Nat.0 and y = Nat.0 and z = Nat.0
}

theorem sqrt_two_irrational(p: Nat, q: Nat) {
    p * p = Nat.2 * (q * q) implies q = Nat.0
}

theorem sqrt_three_irrational(p: Nat, q: Nat) {
    p * p = Nat.3 * (q * q) implies q = Nat.0
}

theorem one_mod_four {
    Nat.1.mod(Nat.4) = Nat.1
}

theorem three_mod_four {
    Nat.3.mod(Nat.4) = Nat.3
}

theorem congr_three_mod_four_imp_half_decomp(p: Nat) {
    p.congr_mod(Nat.3, Nat.4) implies
        exists(q: Nat) { p = Nat.2 * (Nat.2 * q + Nat.1) + Nat.1 }
}

theorem congr_three_mod_four_imp_not_congr_one_mod_four(p: Nat) {
    p.congr_mod(Nat.3, Nat.4) implies not p.congr_mod(Nat.1, Nat.4)
}

theorem two_squares_descent_inverse_step(p: Nat, x: Nat, y: Nat, b: Nat) {
    p.is_prime and p.divides(x * x + y * y) and (y * b).congr_mod(Nat.1, p)
        implies ((x * b) * (x * b)).congr_mod(p - Nat.1, p)
}

theorem two_squares_descent_imp_divides_y(p: Nat, x: Nat, y: Nat) {
    p.is_prime and p.congr_mod(Nat.3, Nat.4) and p.divides(x * x + y * y)
        implies p.divides(y)
}

theorem two_squares_descent(p: Nat, x: Nat, y: Nat) {
    p.is_prime and p.congr_mod(Nat.3, Nat.4) and p.divides(x * x + y * y)
        implies p.divides(x) and p.divides(y)
}

define square_suc_mod(p: Nat, x: Nat) -> Nat {
    (x.suc * x.suc).mod(p)
}

define is_unit_qr_at(p: Nat, a: Nat) -> Bool {
    is_unit_quadratic_residue_mod(a, p)
}

define is_unit_nonqr_at(p: Nat, a: Nat) -> Bool {
    is_unit_quadratic_nonresidue_mod(a, p)
}

define legendre_at(p: Nat, a: Nat) -> Int {
    legendre_symbol(a, p)
}

define positive_residues(p: Nat) -> List[Nat] {
    map((p - Nat.1).range, Nat.suc)
}

define half_square_residues(p: Nat, h: Nat) -> List[Nat] {
    map(h.range, square_suc_mod(p))
}

define unit_qr_positive_list(p: Nat) -> List[Nat] {
    positive_residues(p).filter(is_unit_qr_at(p))
}

define unit_nonqr_positive_list(p: Nat) -> List[Nat] {
    positive_residues(p).filter(is_unit_nonqr_at(p))
}

define legendre_symbol_sum_positive(p: Nat) -> Int {
    sum(map(positive_residues(p), legendre_at(p)))
}

define int_one_summand(a: Nat) -> Int {
    Int.1
}

define int_neg_one_summand(a: Nat) -> Int {
    -Int.1
}

theorem int_sum_const_one(l: List[Nat]) {
    sum(map(l, int_one_summand)) = Int.from_nat(l.length)
}

theorem int_sum_const_neg_one(l: List[Nat]) {
    sum(map(l, int_neg_one_summand)) = -(Int.from_nat(l.length))
}

theorem nat_sq_diff(a: Nat, b: Nat) {
    b <= a implies (a - b) * (a + b) = a * a - b * b
}

theorem sub_le_self(a: Nat, b: Nat) {
    a - b <= a
}

theorem congr_le_imp_divides_diff(a: Nat, b: Nat, n: Nat) {
    n != Nat.0 and b <= a and a.congr_mod(b, n) implies n.divides(a - b)
}

theorem divides_diff_imp_congr(a: Nat, b: Nat, n: Nat) {
    n != Nat.0 and b <= a and n.divides(a - b) implies a.congr_mod(b, n)
}

theorem divides_below_imp_zero(d: Nat, p: Nat) {
    p != Nat.0 and d < p and p.divides(d) implies d = Nat.0
}

theorem square_half_injective(p: Nat, h: Nat, x: Nat, y: Nat) {
    p.is_prime and p = Nat.2 * h + Nat.1 and Nat.0 < x and x <= h and Nat.0 < y and y <= h
        and (x * x).mod(p) = (y * y).mod(p)
        implies x = y
}

theorem map_range_injective_is_unique(n: Nat, f: Nat -> Nat) {
    (forall(x: Nat, y: Nat) { x < n and y < n and f(x) = f(y) implies x = y })
        implies map(n.range, f).is_unique
}

theorem half_square_residues_unique(p: Nat, h: Nat) {
    p.is_prime and p = Nat.2 * h + Nat.1 implies half_square_residues(p, h).is_unique
}

theorem half_square_residues_member_unit_qr(p: Nat, h: Nat, v: Nat) {
    p.is_prime and p = Nat.2 * h + Nat.1 and half_square_residues(p, h).contains(v)
        implies is_unit_quadratic_residue_mod(v, p)
}

theorem half_square_residues_member_below_prime(p: Nat, h: Nat, v: Nat) {
    p.is_prime and p = Nat.2 * h + Nat.1 and half_square_residues(p, h).contains(v)
        implies Nat.0 < v and v < p
}

theorem square_residues_cover_unit_qr(p: Nat, h: Nat, a: Nat) {
    p.is_prime and p = Nat.2 * h + Nat.1 and Nat.0 < a and a < p
        and is_unit_quadratic_residue_mod(a, p)
        implies exists(i: Nat) { i < h and square_suc_mod(p, i) = a }
}

theorem positive_residues_unique(p: Nat) {
    positive_residues(p).is_unique
}

theorem positive_residues_contains_iff(p: Nat, a: Nat) {
    positive_residues(p).contains(a) = (Nat.0 < a and a < p)
}

theorem unit_qr_positive_membership_iff_half_square(p: Nat, h: Nat, v: Nat) {
    p.is_prime and p = Nat.2 * h + Nat.1 implies (unit_qr_positive_list(p).contains(v) = half_square_residues(p, h).contains(v))
}

theorem unit_qr_positive_permutation_half_squares(p: Nat, h: Nat) {
    p.is_prime and p = Nat.2 * h + Nat.1
        implies is_permutation(unit_qr_positive_list(p), half_square_residues(p, h))
}

theorem unit_quadratic_residue_count(p: Nat, h: Nat) {
    p.is_prime and p = Nat.2 * h + Nat.1 implies unit_qr_positive_list(p).length = h
}

theorem unit_nonqr_iff_not_unit_qr_coprime(p: Nat, x: Nat) {
    x.coprime(p) implies is_unit_quadratic_nonresidue_mod(x, p) = not is_unit_quadratic_residue_mod(x, p)
}

theorem unit_nonqr_complement_on_positive(p: Nat, x: Nat) {
    p.is_prime and positive_residues(p).contains(x) implies is_unit_quadratic_nonresidue_mod(x, p) = not is_unit_quadratic_residue_mod(x, p)
}

theorem sum_map_split_unit_qr_nonqr(p: Nat, f: Nat -> Int) {
    p.is_prime implies
    sum(map(positive_residues(p), f)) =
        sum(map(unit_qr_positive_list(p), f)) +
            sum(map(unit_nonqr_positive_list(p), f))
}

theorem unit_qr_nonqr_length_pair(p: Nat, h: Nat) {
    p.is_prime and p = Nat.2 * h + Nat.1 implies unit_qr_positive_list(p).length + unit_nonqr_positive_list(p).length =
            positive_residues(p).length
}

theorem unit_quadratic_residue_count_half(p: Nat, h: Nat) {
    p.is_prime and p = Nat.2 * h + Nat.1 implies
        unit_qr_positive_list(p).length = (p - Nat.1).div(Nat.2)
}

theorem unit_quadratic_nonresidue_count(p: Nat, h: Nat) {
    p.is_prime and p = Nat.2 * h + Nat.1 implies unit_nonqr_positive_list(p).length = h
}

theorem legendre_symbol_one_of_unit_qr(p: Nat, a: Nat) {
    p.is_prime and is_unit_quadratic_residue_mod(a, p)
        implies legendre_symbol(a, p) = Int.1
}

theorem legendre_symbol_neg_one_of_unit_nonqr(p: Nat, a: Nat) {
    p.is_prime and is_unit_quadratic_nonresidue_mod(a, p)
        implies legendre_symbol(a, p) = -Int.1
}

theorem legendre_symbol_sum_positive_zero(p: Nat, h: Nat) {
    p.is_prime and p = Nat.2 * h + Nat.1 implies legendre_symbol_sum_positive(p) = Int.0
}

theorem legendre_symbol_neg_one_by_half_parity(p: Nat, h: Nat) {
    p.is_prime and p = Nat.2 * h + Nat.1 implies legendre_symbol(p - Nat.1, p) =
            if Nat.2.divides(h) { Int.1 } else { -Int.1 }
}

theorem legendre_symbol_two_by_mod_eight(p: Nat, h: Nat) {
    p.is_prime and p = Nat.2 * h + Nat.1 and
        (exists(g: Nat) { is_order_double_unit_generator_mod(g, p, h) })
    implies legendre_symbol(Nat.2, p) =
        if p.congr_mod(Nat.1, Nat.8) or p.congr_mod(Nat.7, Nat.8) {
            Int.1
        } else {
            -Int.1
        }
}

theorem quadratic_residue_product_is_residue(a: Nat, b: Nat, p: Nat) {
    is_quadratic_residue_mod(a, p) and is_quadratic_residue_mod(b, p)
        implies is_quadratic_residue_mod(a * b, p)
}

theorem unit_quadratic_residue_product_is_residue(a: Nat, b: Nat, p: Nat) {
    is_unit_quadratic_residue_mod(a, p) and is_unit_quadratic_residue_mod(b, p)
        implies is_unit_quadratic_residue_mod(a * b, p)
}

theorem legendre_one_imp_half_power_congr_one(p: Nat, h: Nat, a: Nat) {
    p.is_prime and p = Nat.2 * h + Nat.1 and legendre_symbol(a, p) = Int.1
        implies a.pow(h).congr_mod(Nat.1, p)
}

theorem legendre_one_iff_half_power_congr_one(p: Nat, h: Nat, a: Nat) {
    p.is_prime and p = Nat.2 * h + Nat.1 and
        (exists(g: Nat) { is_order_double_unit_generator_mod(g, p, h) }) and a.coprime(p)
        implies ((legendre_symbol(a, p) = Int.1) = a.pow(h).congr_mod(Nat.1, p))
}

theorem prime_square_root_one_cases(p: Nat, z: Nat) {
    p.is_prime and z.pow(Nat.2).congr_mod(Nat.1, p)
        implies z.congr_mod(Nat.1, p) or z.congr_mod(p - Nat.1, p)
}

theorem legendre_neg_one_imp_half_power_congr_pred(p: Nat, h: Nat, a: Nat) {
    p.is_prime and p = Nat.2 * h + Nat.1 and
        (exists(g: Nat) { is_order_double_unit_generator_mod(g, p, h) }) and a.coprime(p)
        and legendre_symbol(a, p) = -Int.1
        implies a.pow(h).congr_mod(p - Nat.1, p)
}

theorem neg_one_quadratic_residue_iff_half_even(p: Nat, h: Nat) {
    p.is_prime and p = Nat.2 * h + Nat.1 implies
        (is_quadratic_residue_mod(p - Nat.1, p) = Nat.2.divides(h))
}

theorem neg_one_quadratic_residue_iff_congr_one_mod_four(p: Nat, h: Nat) {
    p.is_prime and p = Nat.2 * h + Nat.1 implies
        (is_quadratic_residue_mod(p - Nat.1, p) = p.congr_mod(Nat.1, Nat.4))
}

theorem legendre_symbol_neg_one_iff_congr_one_mod_four(p: Nat, h: Nat) {
    p.is_prime and p = Nat.2 * h + Nat.1 implies
        legendre_symbol(p - Nat.1, p) =
            if p.congr_mod(Nat.1, Nat.4) { Int.1 } else { -Int.1 }
}

theorem two_quadratic_residue_iff_congr_one_or_seven_mod_eight(p: Nat, h: Nat) {
    p.is_prime and p = Nat.2 * h + Nat.1 and
        (exists(g: Nat) { is_order_double_unit_generator_mod(g, p, h) })
    implies (is_quadratic_residue_mod(Nat.2, p) =
        (p.congr_mod(Nat.1, Nat.8) or p.congr_mod(Nat.7, Nat.8)))
}

theorem legendre_symbol_two_iff_congr_one_or_seven_mod_eight(p: Nat, h: Nat) {
    p.is_prime and p = Nat.2 * h + Nat.1 and
        (exists(g: Nat) { is_order_double_unit_generator_mod(g, p, h) })
    implies legendre_symbol(Nat.2, p) =
        if p.congr_mod(Nat.1, Nat.8) or p.congr_mod(Nat.7, Nat.8) {
            Int.1
        } else {
            -Int.1
        }
}

theorem number_of_quadratic_residues(p: Nat, h: Nat) {
    p.is_prime and p = Nat.2 * h + Nat.1 implies
        unit_qr_positive_list(p).length = (p - Nat.1).div(Nat.2)
}

theorem number_of_quadratic_nonresidues(p: Nat, h: Nat) {
    p.is_prime and p = Nat.2 * h + Nat.1 implies
        unit_nonqr_positive_list(p).length = h
}

theorem product_of_quadratic_residues_is_residue(a: Nat, b: Nat, p: Nat) {
    is_quadratic_residue_mod(a, p) and is_quadratic_residue_mod(b, p)
        implies is_quadratic_residue_mod(a * b, p)
}

theorem quadratic_residue_mul_nonresidue(p: Nat, a: Nat, b: Nat) {
    p.is_prime and a.coprime(p) and is_quadratic_residue_mod(a, p) and
        is_quadratic_nonresidue_mod(b, p)
        implies is_quadratic_nonresidue_mod(a * b, p)
}

theorem prime_sqrt_neg_one_congr(p: Nat) {
    p.is_prime and p.mod(Nat.4) = Nat.1 implies
        exists(x: Nat) { x.pow(Nat.2).congr_mod(p - Nat.1, p) }
}

theorem prime_divides_sq_plus_one(p: Nat) {
    p.is_prime and p.mod(Nat.4) = Nat.1 implies exists(x: Nat) {
        p.divides(x * x + Nat.1)
    }
}

theorem not_lte_imp_gt(a: Nat, b: Nat) {
    not (a <= b) implies b < a
}

define isqrt_fuel(p: Nat, fuel: Nat) -> Nat {
    match fuel {
        Nat.zero {
            Nat.0
        }
        Nat.suc(f) {
            if f.suc * f.suc <= p {
                f.suc
            } else {
                isqrt_fuel(p, f)
            }
        }
    }
}

define isqrt(p: Nat) -> Nat {
    isqrt_fuel(p, p)
}

theorem isqrt_fuel_lte_fuel(p: Nat, fuel: Nat) {
    isqrt_fuel(p, fuel) <= fuel
}

theorem isqrt_fuel_sq_le(p: Nat, fuel: Nat) {
    isqrt_fuel(p, fuel) * isqrt_fuel(p, fuel) <= p
}

theorem isqrt_fuel_above(p: Nat, fuel: Nat, j: Nat) {
    isqrt_fuel(p, fuel) < j and j <= fuel implies p < j * j
}

theorem isqrt_lte_self(p: Nat) {
    isqrt(p) <= p
}

theorem isqrt_sq_le(p: Nat) {
    isqrt(p) * isqrt(p) <= p
}

theorem isqrt_sq_lt_prime(p: Nat) {
    p.is_prime implies isqrt(p) * isqrt(p) < p
}

theorem isqrt_suc_sq_gt(p: Nat) {
    p.is_prime implies p < (isqrt(p) + Nat.1) * (isqrt(p) + Nat.1)
}

theorem lte_sq(a: Nat, b: Nat) {
    a <= b implies a * a <= b * b
}

theorem congr_mod_add_cancel_left(x: Nat, u: Nat, v: Nat, n: Nat) {
    (x + u).congr_mod(x + v, n) implies u.congr_mod(v, n)
}

theorem congr_mod_sq_of_sum_zero(u: Nat, v: Nat, n: Nat) {
    (u + v).congr_mod(Nat.0, n) implies (u * u).congr_mod(v * v, n)
}

define thue_residue(p: Nat, m: Nat, x: Nat, i: Nat) -> Nat {
    (i.div(m + Nat.1) + (i.mod(m + Nat.1)) * x).mod(p)
}

define thue_residue_fn(p: Nat, m: Nat, x: Nat) -> (Nat -> Nat) {
    function(i: Nat) { thue_residue(p, m, x, i) }
}

theorem div_lt_square_le(m: Nat, i: Nat) {
    i < (m + Nat.1) * (m + Nat.1) implies i.div(m + Nat.1) <= m
}

theorem mod_lt_square_le(m: Nat, i: Nat) {
    i < (m + Nat.1) * (m + Nat.1) implies i.mod(m + Nat.1) <= m
}

theorem thue_collision(p: Nat, m: Nat, x: Nat) {
    p != Nat.0 and m * m < p and p < (m + Nat.1) * (m + Nat.1) implies
        exists(i: Nat, j: Nat) {
            i < (m + Nat.1) * (m + Nat.1) and j < (m + Nat.1) * (m + Nat.1) and
            i != j and thue_residue(p, m, x, i) = thue_residue(p, m, x, j)
        }
}

theorem sum_of_squares_eq_p(p: Nat, c: Nat, d: Nat) {
    p != Nat.0 and p.divides(c * c + d * d) and c * c + d * d != Nat.0 and
        c * c + d * d < Nat.2 * p implies c * c + d * d = p
}

theorem thue_sq_congr(a: Nat, b: Nat, x: Nat, a2: Nat, b2: Nat, p: Nat) {
    (a + b * x).congr_mod(a2 + b2 * x, p) implies
        exists(c: Nat, d: Nat) {
            (a = a2 + c or a2 = a + c) and (b = b2 + d or b2 = b + d) and
            (c * c).congr_mod((d * d) * (x * x), p)
        }
}

theorem thue_sum_of_squares(p: Nat, m: Nat, x: Nat) {
    p != Nat.0 and m * m < p and p < (m + Nat.1) * (m + Nat.1) and
        x.pow(Nat.2).congr_mod(p - Nat.1, p) implies
        exists(a: Nat, b: Nat) { a * a + b * b = p }
}

theorem prime_sum_of_two_squares(p: Nat) {
    p.is_prime and p.mod(Nat.4) = Nat.1 implies exists(a: Nat, b: Nat) {
        a * a + b * b = p
    }
}

theorem two_is_sum_of_two_squares {
    exists(a: Nat, b: Nat) { a * a + b * b = Nat.2 }
}

theorem two_mod_four {
    Nat.2.mod(Nat.4) = Nat.2
}

theorem square_mod_four_case(a: Nat) {
    (a * a).mod(Nat.4) = Nat.0 or (a * a).mod(Nat.4) = Nat.1
}

theorem sum_two_squares_mod_four_case(a: Nat, b: Nat) {
    (a * a + b * b).mod(Nat.4) = Nat.0 or
        (a * a + b * b).mod(Nat.4) = Nat.1 or
        (a * a + b * b).mod(Nat.4) = Nat.2
}

theorem mul_four_add_two(q: Nat) {
    q * Nat.4 + Nat.2 = Nat.2 * (Nat.2 * q + Nat.1)
}

theorem prime_two_divides_imp_eq_two(p: Nat) {
    p.is_prime and Nat.2.divides(p) implies p = Nat.2
}

theorem prime_sum_two_squares_converse(p: Nat) {
    p.is_prime and p != Nat.2 and exists(a: Nat, b: Nat) { a * a + b * b = p }
        implies p.mod(Nat.4) = Nat.1
}

theorem int_sub_sum(x: Int, y: Int, z: Int) {
    x - (y + z) = x - y - z
}

theorem int_sub_chain_swap(x: Int, p: Int, q: Int, r: Int) {
    x - p - q - r = x - q - r - p
}

theorem int_add_sub_reorder(x: Int, y: Int, z: Int, w: Int) {
    x - w + y + z = x + y + z - w
}

theorem int_sub_sub_reorder(x: Int, y: Int, z: Int, w: Int) {
    x - y + z - w = x + z - y - w
}

theorem int_add_sub_assoc_right(x: Int, y: Int, z: Int, w: Int) {
    x + y + (z - w) = x + y + z - w
}

theorem gauss_add_comm(a: GaussInt, b: GaussInt) {
