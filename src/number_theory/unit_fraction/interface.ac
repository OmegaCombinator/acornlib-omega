    p.is_prime and g.coprime(p) and multiplicative_order_mod(g, p) = p - Nat.1
        and a.coprime(p) and e < p - Nat.1 and f < p - Nat.1
        and g.pow(e).congr_mod(a, p) and g.pow(f).congr_mod(a, p)
        implies e = f
}

