theorem rat_positive_of_real_positive(r: Rat) {
    Real.0 < Real.from_rat(r) implies r.is_positive
}

theorem real_abs_of_nonneg(a: Real) {
    Real.0 <= a implies a.abs = a
}

theorem lte_double_imp_lte(m: Nat, n: Nat) {
    Nat.2 * n <= Nat.2 * m implies n <= m
}

theorem continued_fraction_gap_bound_le_recip_suc(coefficients: Nat -> Nat, k: Nat) {
    positive_continued_fraction_sequence_tail(coefficients) implies continued_fraction_gap_bound(coefficients, Nat.2 * k) <= iop(k)
}

theorem continued_fraction_real_gap_even_le_recip_suc(
    coefficients: Nat -> Nat, k: Nat
) {
    positive_continued_fraction_sequence_tail(coefficients) implies continued_fraction_real_gap_bound(coefficients, Nat.2 * k) <= Real.from_rat(iop(k))
}

theorem real_lte_trans(a: Real, b: Real, c: Real) {
    a <= b and b <= c implies a <= c
}

theorem real_lt_of_lte_of_lt(a: Real, b: Real, c: Real) {
    a <= b and b < c implies a < c
}

theorem real_sub_add_cancel(a: Real, b: Real, c: Real) {
    (a - b) + (b - c) = a - c
}

theorem continued_fraction_convergents_tail_bound_for_eps(
    coefficients: Nat -> Nat, eps: Real
) {
    positive_continued_fraction_sequence_tail(coefficients) and eps.is_positive implies exists(n: Nat) {
            forall(m: Nat) {
                n <= m implies (continued_fraction_real_convergent_value(coefficients, m) - continued_fraction_real_limit(coefficients)).abs < eps
            }
        }
}

define is_pell_solution(d: Int, x: Int, y: Int) -> Bool {
    x * x - d * (y * y) = Int.1
}

define pell_norm(d: Int, x: Int, y: Int) -> Int {
    x * x - d * (y * y)
}

theorem pell_trivial_solution(d: Int) {
    is_pell_solution(d, Int.1, Int.0)
}

theorem pell_two_square_identity {
    Int.3 * Int.3 - Int.2 * (Int.2 * Int.2) = Int.1
}

theorem pell_two_smallest {
    is_pell_solution(Int.2, Int.3, Int.2)
}

define pell_next_x(d: Int, x: Int, y: Int) -> Int {
    x * x + d * (y * y)
}

define pell_next_y(d: Int, x: Int, y: Int) -> Int {
    Int.2 * x * y
}

theorem pell_rearrange_flatten(a: Int, b: Int, c: Int, d: Int) {
    (a + b) - c - d = a + b - c - d
}

theorem pell_rearrange_regroup(a: Int, b: Int, c: Int, d: Int) {
    a - b - c + d = (a + d) - b - c
}

theorem pell_rearrange_sub_sum(a: Int, b: Int, c: Int) {
    a - (b + c) = a - b - c
}

theorem pell_rearrange_cancel(a: Int, b: Int, c: Int) {
    (a + b + c + c) - (c + c + c + c) = a + b - c - c
}

theorem pell_rearrange_sub_sub(a: Int, b: Int, c: Int, d: Int) {
    (a - b) - (c - d) = a - b - c + d
}

theorem pell_cross_term_eq(d: Int, x: Int, y: Int) {
    d * (x * y) * (x * y) = (x * x) * (d * (y * y))
}

theorem pell_square_identity(d: Int, x: Int, y: Int) {
    (x * x + d * (y * y)) * (x * x + d * (y * y)) -
        d * ((Int.2 * x * y) * (Int.2 * x * y)) =
    (x * x - d * (y * y)) * (x * x - d * (y * y))
}

theorem pell_solution_square(d: Int, x: Int, y: Int) {
    is_pell_solution(d, x, y) implies
        is_pell_solution(d, pell_next_x(d, x, y), pell_next_y(d, x, y))
}

define sqrt_two_continued_fraction_coefficients(n: Nat) -> Nat {
    if n = Nat.0 { Nat.1 } else { Nat.2 }
}

theorem sqrt_two_convergent_numerator_zero {
    continued_fraction_convergent_numerator(
        sqrt_two_continued_fraction_coefficients, Nat.0) = Nat.1
}

theorem sqrt_two_convergent_denominator_zero {
    continued_fraction_convergent_denominator(
        sqrt_two_continued_fraction_coefficients, Nat.0) = Nat.1
}

theorem sqrt_two_convergent_numerator_one {
    continued_fraction_convergent_numerator(
        sqrt_two_continued_fraction_coefficients, Nat.1) = Nat.3
}

theorem sqrt_two_convergent_denominator_one {
    continued_fraction_convergent_denominator(
        sqrt_two_continued_fraction_coefficients, Nat.1) = Nat.2
}

theorem sqrt_two_adjacent_cross_product {
    Int.from_nat(Nat.3) * Int.from_nat(Nat.1) -
        Int.from_nat(Nat.1) * Int.from_nat(Nat.2) = Int.1
}

theorem pell_two_fundamental_solution_from_convergents {
    is_pell_solution(Int.2,
        Int.from_nat(continued_fraction_convergent_numerator(
            sqrt_two_continued_fraction_coefficients, Nat.1)),
        Int.from_nat(continued_fraction_convergent_denominator(
            sqrt_two_continued_fraction_coefficients, Nat.1)))
}

define is_pythagorean_triple(a: Nat, b: Nat, c: Nat) -> Bool {
    a * a + b * b = c * c
}

define is_primitive_pythagorean_triple(a: Nat, b: Nat, c: Nat) -> Bool {
    is_pythagorean_triple(a, b, c) and a.coprime(b)
}

define pythag_odd_leg(k: Nat) -> Nat {
    Nat.2 * k + Nat.1
}

define pythag_even_leg(k: Nat) -> Nat {
    Nat.2 * k * (k + Nat.1)
}

define pythag_hypotenuse(k: Nat) -> Nat {
    Nat.2 * k * k + Nat.2 * k + Nat.1
}

theorem nat_sq_suc(x: Nat) {
    (x + Nat.1) * (x + Nat.1) = x * x + Nat.2 * x + Nat.1
}

theorem nat_sq_double(x: Nat) {
    (Nat.2 * x) * (Nat.2 * x) = Nat.4 * (x * x)
}

theorem pythag_hyp_eq_even_add_one(k: Nat) {
    pythag_hypotenuse(k) = pythag_even_leg(k) + Nat.1
}

theorem pythag_odd_sq(k: Nat) {
    pythag_odd_leg(k) * pythag_odd_leg(k) = Nat.2 * pythag_even_leg(k) + Nat.1
}

theorem pythag_family_solution(k: Nat) {
    is_pythagorean_triple(pythag_odd_leg(k), pythag_even_leg(k), pythag_hypotenuse(k))
}

theorem pythag_odd_coprime_two(k: Nat) {
    pythag_odd_leg(k).coprime(Nat.2)
}

theorem pythag_odd_coprime_k(k: Nat) {
    pythag_odd_leg(k).coprime(k)
}

theorem pythag_odd_coprime_suc_k(k: Nat) {
    pythag_odd_leg(k).coprime(k + Nat.1)
}

theorem pythag_family_primitive(k: Nat) {
    is_primitive_pythagorean_triple(pythag_odd_leg(k), pythag_even_leg(k), pythag_hypotenuse(k))
}

theorem pythag_family_legs_grow(k: Nat) {
    pythag_odd_leg(k) < pythag_odd_leg(k.suc)
}

theorem pythag_hyp_ge_twice_param(k: Nat) {
    Nat.2 * k <= pythag_hypotenuse(k)
}

theorem pythag_twice_suc_gt(n: Nat) {
    n < Nat.2 * (n + Nat.1)
}

theorem pythagorean_infinitely_many_primitive(n: Nat) {
    exists(x: Nat, y: Nat, z: Nat) {
        n < z and is_primitive_pythagorean_triple(x, y, z)
    }
}

theorem two_divides_square_imp_two_divides(x: Nat) {
    Nat.2.divides(x * x) implies Nat.2.divides(x)
}

theorem sq_eq_two_sq_descent(x: Nat, y: Nat) {
    x != Nat.0 and x * x = Nat.2 * (y * y) implies
        exists(a: Nat, b: Nat) {
            a < x and Nat.2 * a = x and a * a = Nat.2 * (b * b)
        }
}

theorem sq_eq_two_sq_zero(x: Nat) {
    forall(y: Nat) { x * x = Nat.2 * (y * y) implies x = Nat.0 }
}

theorem no_nontrivial_sq_eq_two_sq(x: Nat, y: Nat) {
    x * x = Nat.2 * (y * y) implies x = Nat.0 and y = Nat.0
}

theorem abs_from_nat_two {
    abs(Int.2) = Nat.2
}

theorem no_nontrivial_int_sq_eq_two_sq(x: Int, y: Int) {
    x * x = Int.2 * (y * y) implies x = Int.0 and y = Int.0
}

define pell_two_nat_next_x(a: Nat, b: Nat) -> Nat {
    a * a + Nat.2 * (b * b)
}

define pell_two_nat_next_y(a: Nat, b: Nat) -> Nat {
    Nat.2 * a * b
}

theorem pell_two_nat_step_solution(a: Nat, b: Nat) {
    is_pell_solution(Int.2, Int.from_nat(a), Int.from_nat(b)) implies
        is_pell_solution(Int.2,
            Int.from_nat(pell_two_nat_next_x(a, b)),
            Int.from_nat(pell_two_nat_next_y(a, b)))
}

theorem pell_two_nat_step_pos(a: Nat, b: Nat) {
    Nat.1 <= a and Nat.1 <= b implies
        Nat.1 <= pell_two_nat_next_x(a, b) and Nat.1 <= pell_two_nat_next_y(a, b)
}

theorem pell_two_nat_step_grows(a: Nat, b: Nat) {
    Nat.1 <= a and Nat.1 <= b implies b + Nat.1 <= pell_two_nat_next_y(a, b)
}

define pell_two_unbounded_pred(m: Nat) -> Bool {
    exists(a: Nat, b: Nat) {
        is_pell_solution(Int.2, Int.from_nat(a), Int.from_nat(b)) and
        Nat.1 <= a and Nat.1 <= b and m <= b
    }
}

theorem pell_two_unbounded_base {
    pell_two_unbounded_pred(Nat.0)
}

theorem pell_two_unbounded_step(m: Nat) {
    pell_two_unbounded_pred(m) implies pell_two_unbounded_pred(m.suc)
}

theorem pell_two_solutions_unbounded(n: Nat) {
    exists(a: Nat, b: Nat) {
        is_pell_solution(Int.2, Int.from_nat(a), Int.from_nat(b)) and n <= b
    }
}

theorem diophantine_approximation_estimate(
    coefficients: Nat -> Nat, n: Nat
) {
    positive_continued_fraction_sequence_tail(coefficients) implies (continued_fraction_real_limit(coefficients) - continued_fraction_real_convergent_value(coefficients, n)).abs < Real.from_rat(Rat.1 / Rat.from_nat(
            continued_fraction_convergent_denominator(coefficients, n) *
            continued_fraction_convergent_denominator(coefficients, n)))
}

theorem diophantine_good_approximations_unbounded(
    coefficients: Nat -> Nat, n: Nat
) {
    positive_continued_fraction_sequence_tail(coefficients) implies
        exists(p: Nat, q: Nat) {
            n < q and
            (continued_fraction_real_limit(coefficients) -
                Real.from_rat(Rat.from_nat(p) / Rat.from_nat(q))).abs <
                Real.from_rat(Rat.1 / Rat.from_nat(q * q))
        }
}

define dirichlet_index_pred(coefficients: Nat -> Nat, bound: Nat) -> Bool {
    exists(n: Nat) {
        continued_fraction_convergent_denominator(coefficients, n) <= bound and
        bound < continued_fraction_convergent_denominator(coefficients, n.suc)
    }
}

theorem dirichlet_convergent_index(coefficients: Nat -> Nat, bound: Nat) {
    positive_continued_fraction_sequence_tail(coefficients) and Nat.1 <= bound implies
    exists(n: Nat) {
        continued_fraction_convergent_denominator(coefficients, n) <= bound and
        bound < continued_fraction_convergent_denominator(coefficients, n.suc)
    }
}

theorem diophantine_limit_gap_approx(coefficients: Nat -> Nat, n: Nat) {
    positive_continued_fraction_sequence_tail(coefficients) implies
    (continued_fraction_real_limit(coefficients) - continued_fraction_real_convergent_value(coefficients, n)).abs < continued_fraction_real_gap_bound(coefficients, n)
}

define dirichlet_good_approximation(alpha: Real, p: Nat, q: Nat, bound: Nat) -> Bool {
    Nat.1 <= q and q <= bound and
    (from_nat[Real](q) * alpha - from_nat[Real](p)).abs <
        Real.from_rat(Rat.1 / Rat.from_nat(bound))
}

theorem diophantine_dirichlet(coefficients: Nat -> Nat, bound: Nat) {
    positive_continued_fraction_sequence_tail(coefficients) and Nat.1 <= bound implies
    exists(p: Nat, q: Nat) {
        dirichlet_good_approximation(continued_fraction_real_limit(coefficients), p, q, bound)
    }
}

theorem approximation_deep_infinitely_many_good_approximations(
    coefficients: Nat -> Nat, n: Nat
) {
    positive_continued_fraction_sequence_tail(coefficients) implies
        exists(p: Nat, q: Nat) {
            n < q and
            (continued_fraction_real_limit(coefficients) -
                Real.from_rat(Rat.from_nat(p) / Rat.from_nat(q))).abs <
                Real.from_rat(Rat.1 / Rat.from_nat(q * q))
        }
}

theorem approximation_deep_reflects_lt(p: Rat, q: Rat) {
    Real.from_rat(p) < Real.from_rat(q) implies p < q
}

theorem approximation_deep_rat_from_nat_sub_abs(m: Nat, n: Nat) {
    (Rat.from_nat(m) - Rat.from_nat(n)).abs = Rat.from_nat(abs(sub_nat(m, n)))
}

theorem approximation_deep_nat_one_lte_imp_rat_positive(n: Nat) {
    Nat.1 <= n implies Rat.from_nat(n).is_positive
}

theorem approximation_deep_rational_denominator_bound(
    a: Nat, b: Nat, p: Nat, q: Nat, c: Nat
) {
    Nat.1 <= b and Nat.1 <= q and Nat.1 < c and q.coprime(p) and
        (Real.from_rat(Rat.from_nat(a) / Rat.from_nat(b)) -
            Real.from_rat(Rat.from_nat(p) / Rat.from_nat(q))).abs <
            Real.from_rat(Rat.1 / Rat.from_nat(c * q * q))
        implies from_nat[Real](q) <= from_nat[Real](b)
}

theorem approximation_deep_good_approximations_imp_irrational(
    alpha: Real, c: Nat
) {
    Nat.1 < c implies (
        (forall(bound: Nat) {
            exists(p: Nat, q: Nat) {
                Nat.1 <= q and bound < q and q.coprime(p) and
                (alpha - Real.from_rat(Rat.from_nat(p) / Rat.from_nat(q))).abs <
                    Real.from_rat(Rat.1 / Rat.from_nat(c * q * q))
            }
        }) implies
        not exists(a: Nat, b: Nat) {
            Nat.1 <= b and alpha = Real.from_rat(Rat.from_nat(a) / Rat.from_nat(b))
        }
    )
}

theorem approximation_deep_sqrt_two_irrational(p: Nat, q: Nat) {
    p * p = Nat.2 * (q * q) implies q = Nat.0
}

theorem approximation_deep_sqrt_two_no_positive_rational(p: Nat, q: Nat) {
    Nat.0 < q implies p * p != Nat.2 * (q * q)
}

theorem three_divides_square_imp_three_divides(x: Nat) {
    Nat.3.divides(x * x) implies Nat.3.divides(x)
}

theorem nat_sq_triple(x: Nat) {
    (Nat.3 * x) * (Nat.3 * x) = Nat.9 * (x * x)
}

theorem sq_eq_three_sq_descent(x: Nat, y: Nat) {
    x != Nat.0 and x * x = Nat.3 * (y * y) implies
        exists(a: Nat, b: Nat) {
            a < x and Nat.3 * a = x and a * a = Nat.3 * (b * b)
        }
}

theorem sq_eq_three_sq_zero(x: Nat) {
    forall(y: Nat) { x * x = Nat.3 * (y * y) implies x = Nat.0 }
}

theorem no_nontrivial_sq_eq_three_sq(x: Nat, y: Nat) {
    x * x = Nat.3 * (y * y) implies x = Nat.0 and y = Nat.0
}

theorem approximation_deep_sqrt_three_irrational(p: Nat, q: Nat) {
    p * p = Nat.3 * (q * q) implies q = Nat.0
}

theorem approximation_deep_sqrt_three_no_positive_rational(p: Nat, q: Nat) {
    Nat.0 < q implies p * p != Nat.3 * (q * q)
}

theorem approximation_theorems_dirichlet_estimate(
    coefficients: Nat -> Nat, n: Nat
) {
    positive_continued_fraction_sequence_tail(coefficients) implies (continued_fraction_real_limit(coefficients) - continued_fraction_real_convergent_value(coefficients, n)).abs < Real.from_rat(Rat.1 / Rat.from_nat(
            continued_fraction_convergent_denominator(coefficients, n) *
            continued_fraction_convergent_denominator(coefficients, n)))
}

theorem approximation_theorems_dirichlet_infinitely_many(
    coefficients: Nat -> Nat, n: Nat
) {
    positive_continued_fraction_sequence_tail(coefficients) implies
        exists(p: Nat, q: Nat) {
            n < q and
            (continued_fraction_real_limit(coefficients) -
                Real.from_rat(Rat.from_nat(p) / Rat.from_nat(q))).abs <
                Real.from_rat(Rat.1 / Rat.from_nat(q * q))
        }
}

theorem approximation_theorems_dirichlet_box(
    coefficients: Nat -> Nat, bound: Nat
) {
    positive_continued_fraction_sequence_tail(coefficients) and Nat.1 <= bound implies
    exists(p: Nat, q: Nat) {
        dirichlet_good_approximation(continued_fraction_real_limit(coefficients), p, q, bound)
    }
}

theorem sum_cons_nat(head: Nat, tail: List[Nat]) {
    sum(List.cons(head, tail)) = head + sum(tail)
}

theorem divisor_pair_product_divides(n: Nat, d: Nat, e: Nat) {
    d.divides(n) and e.divides(divisor_quotient(n, d)) implies (d * e).divides(n)
}

theorem divisor_quotient_pair_reassoc(n: Nat, d: Nat, e: Nat) {
    Nat.0 < n and d.divides(n) and e.divides(divisor_quotient(n, d)) implies
        divisor_quotient(n, d * e) = divisor_quotient(divisor_quotient(n, d), e)
}

theorem divisor_pair_product_in_divisor_list(n: Nat, d: Nat, e: Nat) {
    Nat.0 < n and divisor_list(n).contains(d) and
        divisor_list(divisor_quotient(n, d)).contains(e)
        implies divisor_list(n).contains(d * e)
}

define right_divisor_pair_block(n: Nat, d: Nat) -> List[Pair[Nat, Nat]] {
    map(divisor_list(divisor_quotient(n, d)), function(e: Nat) {
        Pair.new(d, e)
    })
}

define right_divisor_pair_list_from(n: Nat, outer: List[Nat]) -> List[Pair[Nat, Nat]] {
    match outer {
        List.nil {
            List.nil[Pair[Nat, Nat]]
        }
        List.cons(d, tail) {
            right_divisor_pair_block(n, d) + right_divisor_pair_list_from(n, tail)
        }
    }
}

define right_divisor_pair_list(n: Nat) -> List[Pair[Nat, Nat]] {
    right_divisor_pair_list_from(n, divisor_list(n))
}

define divisor_pair_assoc_term(f: Nat -> Nat, g: Nat -> Nat, h: Nat -> Nat, n: Nat) ->
        (Pair[Nat, Nat] -> Nat) {
    function(p: Pair[Nat, Nat]) {
        f(p.first) * g(p.second) * h(divisor_quotient(n, p.first * p.second))
    }
}

theorem right_divisor_pair_block_contains(n: Nat, d: Nat, e: Nat) {
    divisor_list(divisor_quotient(n, d)).contains(e)
        implies right_divisor_pair_block(n, d).contains(Pair.new(d, e))
}

theorem right_divisor_pair_block_contains_implies(n: Nat, d: Nat, p: Pair[Nat, Nat]) {
    right_divisor_pair_block(n, d).contains(p) implies
        p.first = d and divisor_list(divisor_quotient(n, d)).contains(p.second)
}

theorem right_divisor_pair_block_contains_iff(n: Nat, d: Nat, p: Pair[Nat, Nat]) {
    right_divisor_pair_block(n, d).contains(p) =
        (p.first = d and divisor_list(divisor_quotient(n, d)).contains(p.second))
}

theorem right_divisor_pair_list_from_contains_head(n: Nat, head: Nat, tail: List[Nat],
        e: Nat) {
    divisor_list(divisor_quotient(n, head)).contains(e) implies
        right_divisor_pair_list_from(n, List.cons(head, tail)).contains(Pair.new(head, e))
}

theorem right_divisor_pair_list_from_contains_tail(n: Nat, head: Nat, tail: List[Nat],
        p: Pair[Nat, Nat]) {
    right_divisor_pair_list_from(n, tail).contains(p) implies
        right_divisor_pair_list_from(n, List.cons(head, tail)).contains(p)
}

theorem right_divisor_pair_list_from_head_contains_implies(n: Nat, head: Nat,
        tail: List[Nat], p: Pair[Nat, Nat]) {
    right_divisor_pair_block(n, head).contains(p) implies
        List.cons(head, tail).contains(p.first) and
            divisor_list(divisor_quotient(n, p.first)).contains(p.second)
}

theorem right_divisor_pair_list_from_divisors_up_to_contains(n: Nat, k: Nat,
        d: Nat, e: Nat) {
    divisors_up_to(n, k).contains(d) and
        divisor_list(divisor_quotient(n, d)).contains(e) implies
        right_divisor_pair_list_from(n, divisors_up_to(n, k)).contains(Pair.new(d, e))
}

theorem right_divisor_pair_list_contains(n: Nat, d: Nat, e: Nat) {
    divisor_list(n).contains(d) and divisor_list(divisor_quotient(n, d)).contains(e)
        implies right_divisor_pair_list(n).contains(Pair.new(d, e))
}

theorem right_divisor_pair_list_from_divisors_up_to_contains_implies(n: Nat, k: Nat,
        p: Pair[Nat, Nat]) {
    right_divisor_pair_list_from(n, divisors_up_to(n, k)).contains(p) implies
        divisors_up_to(n, k).contains(p.first) and
            divisor_list(divisor_quotient(n, p.first)).contains(p.second)
}

theorem right_divisor_pair_list_contains_implies(n: Nat, p: Pair[Nat, Nat]) {
    right_divisor_pair_list(n).contains(p) implies
        divisor_list(n).contains(p.first) and
            divisor_list(divisor_quotient(n, p.first)).contains(p.second)
}

theorem right_divisor_pair_list_contains_iff(n: Nat, d: Nat, e: Nat) {
    right_divisor_pair_list(n).contains(Pair.new(d, e)) =
        (divisor_list(n).contains(d) and divisor_list(divisor_quotient(n, d)).contains(e))
}

define right_divisor_pair_block_from(n: Nat, d: Nat, inner: List[Nat]) -> List[Pair[Nat, Nat]] {
    map(inner, function(e: Nat) {
        Pair.new(d, e)
    })
}

define right_nested_inner_term(f: Nat -> Nat, g: Nat -> Nat, h: Nat -> Nat, n: Nat,
        d: Nat) -> (Nat -> Nat) {
    function(e: Nat) {
        f(d) * dirichlet_term(g, h, divisor_quotient(n, d))(e)
    }
}

theorem right_divisor_pair_block_eq_from(n: Nat, d: Nat) {
    right_divisor_pair_block(n, d) =
        right_divisor_pair_block_from(n, d, divisor_list(divisor_quotient(n, d)))
}

theorem right_nested_inner_term_eq_pair_assoc_term(f: Nat -> Nat, g: Nat -> Nat,
        h: Nat -> Nat, n: Nat, d: Nat, e: Nat) {
    Nat.0 < n and d.divides(n) and e.divides(divisor_quotient(n, d)) implies
        right_nested_inner_term(f, g, h, n, d)(e) =
            divisor_pair_assoc_term(f, g, h, n)(Pair.new(d, e))
}

theorem right_nested_inner_head_term_eq_pair_assoc_term(f: Nat -> Nat, g: Nat -> Nat,
        h: Nat -> Nat, n: Nat, d: Nat, e: Nat) {
    Nat.0 < n and d.divides(n) and e.divides(divisor_quotient(n, d)) implies
        f(d) * dirichlet_term(g, h, divisor_quotient(n, d))(e) =
            divisor_pair_assoc_term(f, g, h, n)(Pair.new(d, e))
}

theorem right_nested_inner_sum_divisors_up_to_eq_pair_block_from_sum(f: Nat -> Nat,
        g: Nat -> Nat, h: Nat -> Nat, n: Nat, d: Nat, k: Nat) {
    Nat.0 < n and d.divides(n) implies
        f(d) * sum(map(divisors_up_to(divisor_quotient(n, d), k),
            dirichlet_term(g, h, divisor_quotient(n, d)))) =
            sum(map(right_divisor_pair_block_from(n, d,
                    divisors_up_to(divisor_quotient(n, d), k)),
                divisor_pair_assoc_term(f, g, h, n)))
}

theorem right_nested_inner_sum_eq_pair_block_from_sum(f: Nat -> Nat, g: Nat -> Nat,
        h: Nat -> Nat, n: Nat, d: Nat) {
    Nat.0 < n and d.divides(n) implies
        f(d) * sum(map(divisor_list(divisor_quotient(n, d)),
            dirichlet_term(g, h, divisor_quotient(n, d)))) =
            sum(map(right_divisor_pair_block_from(n, d, divisor_list(divisor_quotient(n, d))),
                divisor_pair_assoc_term(f, g, h, n)))
}

theorem right_nested_outer_term_eq_pair_block_sum(f: Nat -> Nat, g: Nat -> Nat,
        h: Nat -> Nat, n: Nat, d: Nat) {
    Nat.0 < n and divisor_list(n).contains(d) implies
        dirichlet_term(f, dirichlet_convolve(g, h), n)(d) =
            sum(map(right_divisor_pair_block(n, d), divisor_pair_assoc_term(f, g, h, n)))
}

theorem right_nested_outer_sum_divisors_up_to_eq_pair_list_from_sum(f: Nat -> Nat,
        g: Nat -> Nat, h: Nat -> Nat, n: Nat, k: Nat) {
    Nat.0 < n implies
        sum(map(divisors_up_to(n, k), dirichlet_term(f, dirichlet_convolve(g, h), n))) =
            sum(map(right_divisor_pair_list_from(n, divisors_up_to(n, k)),
                divisor_pair_assoc_term(f, g, h, n)))
}

theorem right_nested_convolve_eq_right_pair_list_sum(f: Nat -> Nat, g: Nat -> Nat,
        h: Nat -> Nat, n: Nat) {
    Nat.0 < n implies
        dirichlet_convolve(f, dirichlet_convolve(g, h))(n) =
            sum(map(right_divisor_pair_list(n), divisor_pair_assoc_term(f, g, h, n)))
}

define left_divisor_pair_of(r: Nat) -> (Nat -> Pair[Nat, Nat]) {
    function(d: Nat) {
        Pair.new(d, divisor_quotient(r, d))
    }
}

define left_divisor_pair_block(n: Nat, r: Nat) -> List[Pair[Nat, Nat]] {
    map(divisor_list(r), left_divisor_pair_of(r))
}

define left_divisor_pair_list_from(n: Nat, outer: List[Nat]) -> List[Pair[Nat, Nat]] {
    match outer {
        List.nil {
            List.nil[Pair[Nat, Nat]]
        }
        List.cons(r, tail) {
            left_divisor_pair_block(n, r) + left_divisor_pair_list_from(n, tail)
        }
    }
}

define left_divisor_pair_list(n: Nat) -> List[Pair[Nat, Nat]] {
    left_divisor_pair_list_from(n, divisor_list(n))
}

theorem left_divisor_pair_block_contains(n: Nat, r: Nat, d: Nat) {
    divisor_list(r).contains(d) implies
        left_divisor_pair_block(n, r).contains(Pair.new(d, divisor_quotient(r, d)))
}

theorem left_divisor_pair_block_contains_implies(n: Nat, r: Nat, p: Pair[Nat, Nat]) {
    left_divisor_pair_block(n, r).contains(p) implies
        divisor_list(r).contains(p.first) and p.second = divisor_quotient(r, p.first)
}

theorem left_divisor_pair_block_contains_implies_first(n: Nat, r: Nat, p: Pair[Nat, Nat]) {
    left_divisor_pair_block(n, r).contains(p) implies divisor_list(r).contains(p.first)
}

theorem left_divisor_pair_block_contains_implies_second(n: Nat, r: Nat, p: Pair[Nat, Nat]) {
    left_divisor_pair_block(n, r).contains(p) implies p.second = divisor_quotient(r, p.first)
}

theorem left_divisor_pair_block_contains_iff(n: Nat, r: Nat, d: Nat, e: Nat) {
    left_divisor_pair_block(n, r).contains(Pair.new(d, e)) =
        (divisor_list(r).contains(d) and e = divisor_quotient(r, d))
}

theorem left_divisor_pair_block_contains_implies_product(n: Nat, r: Nat, p: Pair[Nat, Nat]) {
    left_divisor_pair_block(n, r).contains(p) implies p.first * p.second = r
}

theorem left_divisor_pair_block_contains_implies_inner_product(n: Nat, r: Nat,
        p: Pair[Nat, Nat]) {
    left_divisor_pair_block(n, r).contains(p) implies
        divisor_list(p.first * p.second).contains(p.first)
}

theorem left_divisor_pair_block_contains_implies_second_product(n: Nat, r: Nat,
        p: Pair[Nat, Nat]) {
    left_divisor_pair_block(n, r).contains(p) implies
        p.second = divisor_quotient(p.first * p.second, p.first)
}

theorem left_divisor_pair_list_from_contains_head(n: Nat, head: Nat, tail: List[Nat],
        d: Nat) {
    divisor_list(head).contains(d) implies
        left_divisor_pair_list_from(n, List.cons(head, tail)).contains(
            Pair.new(d, divisor_quotient(head, d)))
}

theorem left_divisor_pair_list_from_contains_tail(n: Nat, head: Nat, tail: List[Nat],
        p: Pair[Nat, Nat]) {
    left_divisor_pair_list_from(n, tail).contains(p) implies
        left_divisor_pair_list_from(n, List.cons(head, tail)).contains(p)
}

theorem left_divisor_pair_list_from_head_contains_implies_product(n: Nat, head: Nat,
        tail: List[Nat], p: Pair[Nat, Nat]) {
    left_divisor_pair_block(n, head).contains(p) implies
        List.cons(head, tail).contains(p.first * p.second)
}

theorem left_divisor_pair_list_from_head_contains_implies_first_product(n: Nat,
        head: Nat, tail: List[Nat], p: Pair[Nat, Nat]) {
    left_divisor_pair_block(n, head).contains(p) implies
        divisor_list(p.first * p.second).contains(p.first)
}

theorem left_divisor_pair_list_from_head_contains_implies_second_product(n: Nat,
        head: Nat, tail: List[Nat], p: Pair[Nat, Nat]) {
    left_divisor_pair_block(n, head).contains(p) implies
        p.second = divisor_quotient(p.first * p.second, p.first)
}

theorem left_divisor_pair_list_from_divisors_up_to_contains(n: Nat, k: Nat,
        r: Nat, d: Nat) {
    divisors_up_to(n, k).contains(r) and divisor_list(r).contains(d) implies
        left_divisor_pair_list_from(n, divisors_up_to(n, k)).contains(
            Pair.new(d, divisor_quotient(r, d)))
}

theorem left_divisor_pair_list_contains(n: Nat, r: Nat, d: Nat) {
    divisor_list(n).contains(r) and divisor_list(r).contains(d) implies
        left_divisor_pair_list(n).contains(Pair.new(d, divisor_quotient(r, d)))
}

theorem left_divisor_pair_list_from_divisors_up_to_contains_implies(n: Nat, k: Nat,
        p: Pair[Nat, Nat]) {
    left_divisor_pair_list_from(n, divisors_up_to(n, k)).contains(p) implies
        divisors_up_to(n, k).contains(p.first * p.second) and
            divisor_list(p.first * p.second).contains(p.first) and
            p.second = divisor_quotient(p.first * p.second, p.first)
}

theorem left_divisor_pair_list_contains_implies(n: Nat, p: Pair[Nat, Nat]) {
    left_divisor_pair_list(n).contains(p) implies
        divisor_list(n).contains(p.first * p.second) and
            divisor_list(p.first * p.second).contains(p.first) and
            p.second = divisor_quotient(p.first * p.second, p.first)
}

theorem left_pair_membership_implies_right_membership(n: Nat, p: Pair[Nat, Nat]) {
    left_divisor_pair_list(n).contains(p) implies right_divisor_pair_list(n).contains(p)
}

theorem right_pair_membership_implies_left_membership(n: Nat, p: Pair[Nat, Nat]) {
    right_divisor_pair_list(n).contains(p) implies left_divisor_pair_list(n).contains(p)
}

theorem right_left_pair_lists_same_contains(n: Nat, p: Pair[Nat, Nat]) {
    right_divisor_pair_list(n).contains(p) = left_divisor_pair_list(n).contains(p)
}

define left_divisor_pair_block_from(n: Nat, r: Nat, inner: List[Nat]) -> List[Pair[Nat, Nat]] {
    map(inner, left_divisor_pair_of(r))
}

theorem left_divisor_pair_block_eq_from(n: Nat, r: Nat) {
    left_divisor_pair_block(n, r) = left_divisor_pair_block_from(n, r, divisor_list(r))
}

theorem left_divisor_pair_block_from_cons(n: Nat, r: Nat, head: Nat, tail: List[Nat]) {
    left_divisor_pair_block_from(n, r, List.cons(head, tail)) =
        List.cons(Pair.new(head, divisor_quotient(r, head)),
            left_divisor_pair_block_from(n, r, tail))
}

theorem left_nested_inner_head_term_eq_pair_assoc_term(f: Nat -> Nat, g: Nat -> Nat,
        h: Nat -> Nat, n: Nat, r: Nat, d: Nat) {
    Nat.0 < n and r.divides(n) and d.divides(r) implies
        dirichlet_term(f, g, r)(d) * h(divisor_quotient(n, r)) =
            divisor_pair_assoc_term(f, g, h, n)(Pair.new(d, divisor_quotient(r, d)))
}

theorem left_nested_inner_sum_divisors_up_to_eq_pair_block_from_sum(f: Nat -> Nat,
        g: Nat -> Nat, h: Nat -> Nat, n: Nat, r: Nat, k: Nat) {
    Nat.0 < n and r.divides(n) implies
        sum(map(divisors_up_to(r, k), dirichlet_term(f, g, r))) * h(divisor_quotient(n, r)) =
            sum(map(left_divisor_pair_block_from(n, r, divisors_up_to(r, k)),
                divisor_pair_assoc_term(f, g, h, n)))
}

theorem left_nested_inner_sum_eq_pair_block_from_sum(f: Nat -> Nat, g: Nat -> Nat,
        h: Nat -> Nat, n: Nat, r: Nat) {
    Nat.0 < n and r.divides(n) implies
        sum(map(divisor_list(r), dirichlet_term(f, g, r))) * h(divisor_quotient(n, r)) =
            sum(map(left_divisor_pair_block_from(n, r, divisor_list(r)),
                divisor_pair_assoc_term(f, g, h, n)))
}

theorem left_nested_outer_term_eq_pair_block_sum(f: Nat -> Nat, g: Nat -> Nat,
        h: Nat -> Nat, n: Nat, r: Nat) {
    Nat.0 < n and divisor_list(n).contains(r) implies
        dirichlet_term(dirichlet_convolve(f, g), h, n)(r) =
            sum(map(left_divisor_pair_block(n, r), divisor_pair_assoc_term(f, g, h, n)))
}

theorem left_nested_outer_sum_divisors_up_to_eq_pair_list_from_sum(f: Nat -> Nat,
        g: Nat -> Nat, h: Nat -> Nat, n: Nat, k: Nat) {
    Nat.0 < n implies
        sum(map(divisors_up_to(n, k), dirichlet_term(dirichlet_convolve(f, g), h, n))) =
            sum(map(left_divisor_pair_list_from(n, divisors_up_to(n, k)),
                divisor_pair_assoc_term(f, g, h, n)))
}

theorem left_nested_convolve_eq_left_pair_list_sum(f: Nat -> Nat, g: Nat -> Nat,
        h: Nat -> Nat, n: Nat) {
    Nat.0 < n implies
        dirichlet_convolve(dirichlet_convolve(f, g), h)(n) =
            sum(map(left_divisor_pair_list(n), divisor_pair_assoc_term(f, g, h, n)))
}

theorem right_divisor_pair_block_unique(n: Nat, d: Nat) {
    right_divisor_pair_block(n, d).is_unique
}

theorem right_divisor_pair_list_from_divisors_up_to_unique(n: Nat, k: Nat) {
    right_divisor_pair_list_from(n, divisors_up_to(n, k)).is_unique
}

theorem right_divisor_pair_list_unique(n: Nat) {
    right_divisor_pair_list(n).is_unique
}

theorem left_divisor_pair_block_unique(n: Nat, r: Nat) {
    left_divisor_pair_block(n, r).is_unique
}

theorem left_divisor_pair_list_from_divisors_up_to_unique(n: Nat, k: Nat) {
    left_divisor_pair_list_from(n, divisors_up_to(n, k)).is_unique
}

theorem left_divisor_pair_list_unique(n: Nat) {
    left_divisor_pair_list(n).is_unique
}

theorem right_left_pair_lists_unique(n: Nat) {
    right_divisor_pair_list(n).is_unique and left_divisor_pair_list(n).is_unique
}

theorem right_left_pair_list_assoc_term_sums_eq(f: Nat -> Nat, g: Nat -> Nat,
        h: Nat -> Nat, n: Nat) {
    sum(map(right_divisor_pair_list(n), divisor_pair_assoc_term(f, g, h, n))) =
        sum(map(left_divisor_pair_list(n), divisor_pair_assoc_term(f, g, h, n)))
}

theorem dirichlet_convolve_assoc_positive(f: Nat -> Nat, g: Nat -> Nat,
        h: Nat -> Nat, n: Nat) {
    Nat.0 < n implies
        dirichlet_convolve(f, dirichlet_convolve(g, h))(n) =
            dirichlet_convolve(dirichlet_convolve(f, g), h)(n)
}

theorem dirichlet_convolve_assoc(f: Nat -> Nat, g: Nat -> Nat, h: Nat -> Nat) {
    dirichlet_convolve(f, dirichlet_convolve(g, h)) =
        dirichlet_convolve(dirichlet_convolve(f, g), h)
}

theorem dirichlet_unit_right_identity(f: Nat -> Nat, n: Nat) {
    Nat.0 < n implies dirichlet_convolve(f, nat_dirichlet_unit_fn)(n) = f(n)
}

theorem dirichlet_unit_left_identity(f: Nat -> Nat, n: Nat) {
    Nat.0 < n implies dirichlet_convolve(nat_dirichlet_unit_fn, f)(n) = f(n)
}

define int_one_arithmetic_fn(n: Nat) -> Int {
    Int.1
}

define int_dirichlet_unit_fn(n: Nat) -> Int {
    if n = Nat.1 { Int.1 } else { Int.0 }
}

theorem int_dirichlet_unit_fn_at_one {
    int_dirichlet_unit_fn(Nat.1) = Int.1
}

theorem int_dirichlet_unit_fn_off_one(n: Nat) {
    n != Nat.1 implies int_dirichlet_unit_fn(n) = Int.0
}

theorem int_dirichlet_unit_fn_eq_mobius_divisor_sum(n: Nat) {
    int_dirichlet_unit_fn(n) = sum(map(divisor_list(n), nat_mobius))
}

theorem cofactor_image_mobius_sum_eq_divisor_sum(n: Nat) {
    Nat.0 < n implies
        sum(map(cofactor_image_list(n), nat_mobius)) =
        sum(map(divisor_list(n), nat_mobius))
}

theorem mobius_cofactor_compose(n: Nat) {
    compose(nat_mobius, nat_divisor_quotient_fn(n)) =
        function(d: Nat) { nat_mobius(divisor_quotient(n, d)) }
}

theorem mobius_convolve_one(n: Nat) {
    sum(map(divisor_list(n), function(d: Nat) {
        nat_mobius(d) * int_one_arithmetic_fn(divisor_quotient(n, d))
    })) = int_dirichlet_unit_fn(n)
}

theorem one_convolve_mobius(n: Nat) {
    sum(map(divisor_list(n), function(d: Nat) {
        int_one_arithmetic_fn(d) * nat_mobius(divisor_quotient(n, d))
    })) = int_dirichlet_unit_fn(n)
}

define pair_swap(p: Pair[Nat, Nat]) -> Pair[Nat, Nat] {
    Pair.new(p.second, p.first)
}

theorem pair_swap_new(x: Nat, y: Nat) {
    pair_swap(Pair.new(x, y)) = Pair.new(y, x)
}

theorem pair_swap_involution(p: Pair[Nat, Nat]) {
    pair_swap(pair_swap(p)) = p
}

theorem pair_swap_injective {
    is_injective_fn(pair_swap)
}

theorem right_pair_list_swap_forward(n: Nat, p: Pair[Nat, Nat]) {
    Nat.0 < n and right_divisor_pair_list(n).contains(p) implies
        right_divisor_pair_list(n).contains(pair_swap(p))
}

theorem right_pair_list_swap_contains(n: Nat, p: Pair[Nat, Nat]) {
    Nat.0 < n implies
        right_divisor_pair_list(n).contains(p) =
        right_divisor_pair_list(n).contains(pair_swap(p))
}

define int_pair_term(a: Nat -> Int, b: Nat -> Int) -> (Pair[Nat, Nat] -> Int) {
    function(p: Pair[Nat, Nat]) { a(p.first) * b(p.second) }
}

theorem int_right_block_expand(a: Nat -> Int, b: Nat -> Int, n: Nat, d: Nat) {
    Nat.0 < n and d.divides(n) implies
        a(d) * sum(map(divisor_list(divisor_quotient(n, d)), b)) =
        sum(map(right_divisor_pair_block(n, d), int_pair_term(a, b)))
}

theorem int_right_expand(a: Nat -> Int, b: Nat -> Int, n: Nat) {
    Nat.0 < n implies
        sum(map(divisor_list(n), function(d: Nat) {
            a(d) * sum(map(divisor_list(divisor_quotient(n, d)), b))
        })) =
        sum(map(right_divisor_pair_list(n), int_pair_term(a, b)))
}

define int_pair_term_swapped(a: Nat -> Int, b: Nat -> Int) -> (Pair[Nat, Nat] -> Int) {
    function(p: Pair[Nat, Nat]) { b(p.second) * a(p.first) }
}

define swapped_right_pair_list(n: Nat) -> List[Pair[Nat, Nat]] {
    map(right_divisor_pair_list(n), pair_swap)
}

theorem swapped_right_pair_list_same_contains(n: Nat, x: Pair[Nat, Nat]) {
    Nat.0 < n implies
        swapped_right_pair_list(n).contains(x) = right_divisor_pair_list(n).contains(x)
}

theorem swapped_right_pair_list_unique(n: Nat) {
    swapped_right_pair_list(n).is_unique
}

theorem swapped_list_reindex_sum(a: Nat -> Int, b: Nat -> Int, n: Nat) {
    sum(map(swapped_right_pair_list(n), int_pair_term_swapped(a, b))) =
        sum(map(right_divisor_pair_list(n), int_pair_term(b, a)))
}

theorem int_divisor_sum_interchange(a: Nat -> Int, b: Nat -> Int, n: Nat) {
    Nat.0 < n implies
        sum(map(divisor_list(n), function(d: Nat) {
            a(d) * sum(map(divisor_list(divisor_quotient(n, d)), b))
        })) =
        sum(map(divisor_list(n), function(e: Nat) {
            b(e) * sum(map(divisor_list(divisor_quotient(n, e)), a))
        }))
}

define int_self_indicator(n: Nat) -> (Nat -> Int) {
    function(e: Nat) { if divisor_quotient(n, e) = Nat.1 { Int.1 } else { Int.0 } }
}

define int_weighted_self_indicator(f: Nat -> Int, n: Nat) -> (Nat -> Int) {
    function(e: Nat) { f(e) * int_self_indicator(n)(e) }
}

theorem int_weighted_indicator_below(f: Nat -> Int, n: Nat, k: Nat) {
    Nat.0 < n and k < n implies
        sum(map(divisors_up_to(n, k), int_weighted_self_indicator(f, n))) = Int.0
}

theorem int_weighted_indicator_full(f: Nat -> Int, n: Nat) {
    Nat.0 < n implies
        sum(map(divisor_list(n), int_weighted_self_indicator(f, n))) = f(n)
}

theorem mobius_extracts_self(f: Nat -> Int, n: Nat) {
    Nat.0 < n implies
        sum(map(divisor_list(n), function(e: Nat) {
            f(e) * sum(map(divisor_list(divisor_quotient(n, e)), nat_mobius))
        })) = f(n)
}

theorem mobius_inversion_composition(f: Nat -> Int, n: Nat) {
    Nat.0 < n implies
        sum(map(divisor_list(n), function(d: Nat) {
            nat_mobius(d) * sum(map(divisor_list(divisor_quotient(n, d)), f))
        })) = f(n)
}

define int_divisor_sum_fn(f: Nat -> Int) -> (Nat -> Int) {
    function(n: Nat) { sum(map(divisor_list(n), f)) }
}

theorem mobius_inversion(f: Nat -> Int, g: Nat -> Int, n: Nat) {
    Nat.0 < n and (forall(m: Nat) { g(m) = sum(map(divisor_list(m), f)) }) implies
        sum(map(divisor_list(n), function(d: Nat) {
            nat_mobius(d) * g(divisor_quotient(n, d))
        })) = f(n)
}

theorem mobius_inversion_divisor_sum(f: Nat -> Int, g: Nat -> Int, n: Nat) {
    Nat.0 < n and (forall(m: Nat) { g(m) = int_divisor_sum_fn(f)(m) }) implies
        sum(map(divisor_list(n), function(d: Nat) {
            nat_mobius(d) * g(divisor_quotient(n, d))
        })) = f(n)
}

theorem nat_sigma_multiplicative_law {
    is_multiplicative_nat_fn(nat_sigma)
}

theorem nat_tau_multiplicative_law {
    is_multiplicative_nat_fn(nat_tau)
}

theorem nat_totient_multiplicative {
    is_multiplicative_nat_fn(nat_totient)
}

theorem nat_sigma_mul_coprime_law(m: Nat, n: Nat) {
    m.coprime(n) implies nat_sigma(m * n) = nat_sigma(m) * nat_sigma(n)
}

theorem nat_tau_mul_coprime_law(m: Nat, n: Nat) {
    m.coprime(n) implies nat_tau(m * n) = nat_tau(m) * nat_tau(n)
}

theorem nat_dirichlet_convolve_multiplicative(f: Nat -> Nat, g: Nat -> Nat) {
    is_multiplicative_nat_fn(f) and is_multiplicative_nat_fn(g)
        implies is_multiplicative_nat_fn(dirichlet_convolve(f, g))
}

define int_dirichlet_convolve(f: Nat -> Int, g: Nat -> Int) -> (Nat -> Int) {
    function(n: Nat) {
        sum(map(divisor_list(n), function(d: Nat) {
            f(d) * g(divisor_quotient(n, d))
        }))
    }
}

theorem int_dirichlet_convolve_apply(f: Nat -> Int, g: Nat -> Int, n: Nat) {
    int_dirichlet_convolve(f, g)(n) =
        sum(map(divisor_list(n), function(d: Nat) {
            f(d) * g(divisor_quotient(n, d))
        }))
}

theorem int_one_convolve_mobius(n: Nat) {
    int_dirichlet_convolve(int_one_arithmetic_fn, nat_mobius)(n) =
        int_dirichlet_unit_fn(n)
}

theorem int_one_convolve_mobius_fn {
    int_dirichlet_convolve(int_one_arithmetic_fn, nat_mobius) =
        int_dirichlet_unit_fn
}

theorem int_mobius_convolve_one(n: Nat) {
    int_dirichlet_convolve(nat_mobius, int_one_arithmetic_fn)(n) =
        int_dirichlet_unit_fn(n)
}

theorem int_mobius_convolve_one_fn {
    int_dirichlet_convolve(nat_mobius, int_one_arithmetic_fn) =
        int_dirichlet_unit_fn
}

theorem exp_gte_one(a: Nat, b: Nat) {
    a != Nat.0 implies Nat.1 <= a.pow(b)
}

theorem exp_gt_one(a: Nat, b: Nat) {
    Nat.1 < a and b != Nat.0 implies Nat.1 < a.pow(b)
}

theorem lte_imp_exp_lte(a: Nat, b: Nat, c: Nat) {
    a != Nat.0 and b <= c implies a.pow(b) <= a.pow(c)
}

theorem lt_imp_exp_lt(a: Nat, b: Nat, c: Nat) {
    Nat.1 < a and b < c implies a.pow(b) < a.pow(c)
}

theorem exp_lte_imp_lte(a: Nat, b: Nat, c: Nat) {
    Nat.1 < a and a.pow(b) <= a.pow(c) implies b <= c
}

theorem exp_lt_imp_lt(a: Nat, b: Nat, c: Nat) {
    Nat.1 < a and a.pow(b) < a.pow(c) implies b < c
}

theorem nat_tau_is_multiplicative {
    is_multiplicative_nat_fn(nat_tau)
}

theorem nat_tau_mul_coprime(m: Nat, n: Nat) {
    m.coprime(n) implies nat_tau(m * n) = nat_tau(m) * nat_tau(n)
}

theorem prime_power_divisor_base_forall(p: Nat) {
    forall(d: Nat) {
        d.divides(p.pow(Nat.0)) implies exists(i: Nat) { d = p.pow(i) and i <= Nat.0 }
    }
}

theorem prime_power_divisor_step_forall(p: Nat, k: Nat) {
    p.is_prime and (forall(d: Nat) {
        d.divides(p.pow(k)) implies exists(i: Nat) { d = p.pow(i) and i <= k }
    }) implies forall(d: Nat) {
        d.divides(p.pow(k.suc)) implies exists(i: Nat) { d = p.pow(i) and i <= k.suc }
    }
}

theorem prime_power_divisor(p: Nat, k: Nat) {
    p.is_prime implies forall(d: Nat) {
        d.divides(p.pow(k)) implies exists(i: Nat) { d = p.pow(i) and i <= k }
    }
}

theorem prime_power_divides(p: Nat, i: Nat, k: Nat) {
    i <= k implies p.pow(i).divides(p.pow(k))
}

theorem prime_power_pos(p: Nat, i: Nat) {
    p != Nat.0 implies Nat.0 < p.pow(i)
}

theorem prime_power_le(p: Nat, i: Nat, k: Nat) {
    p != Nat.0 and i <= k implies p.pow(i) <= p.pow(k)
}

define prime_power_fn(p: Nat) -> (Nat -> Nat) {
    function(i: Nat) { p.pow(i) }
}

define prime_power_range(p: Nat, k: Nat) -> List[Nat] {
    map(k.suc.range, prime_power_fn(p))
}

theorem prime_power_range_length(p: Nat, k: Nat) {
    prime_power_range(p, k).length = k + Nat.1
}

theorem prime_power_range_unique(p: Nat, k: Nat) {
    p.is_prime implies prime_power_range(p, k).is_unique
}

theorem prime_power_range_contains(p: Nat, k: Nat, i: Nat) {
    i <= k implies prime_power_range(p, k).contains(p.pow(i))
}

theorem prime_power_in_divisor_list(p: Nat, k: Nat, i: Nat) {
    p.is_prime and i <= k implies divisor_list(p.pow(k)).contains(p.pow(i))
}

theorem prime_power_divisor_in_range(p: Nat, k: Nat, d: Nat) {
    p.is_prime and divisor_list(p.pow(k)).contains(d)
        implies exists(i: Nat) { d = p.pow(i) and i <= k }
}

theorem divisor_list_contained_in_prime_power_range(p: Nat, k: Nat) {
    p.is_prime implies forall(x: Nat) {
        divisor_list(p.pow(k)).contains(x) implies prime_power_range(p, k).contains(x)
    }
}

theorem prime_power_range_contained_in_divisor_list(p: Nat, k: Nat) {
    p.is_prime implies forall(x: Nat) {
        prime_power_range(p, k).contains(x) implies divisor_list(p.pow(k)).contains(x)
    }
}

theorem nat_tau_prime_pow(p: Nat, k: Nat) {
    p.is_prime implies nat_tau(p.pow(k)) = k + Nat.1
}

theorem positive_divisor_lte_self(n: Nat, d: Nat) {
    Nat.0 < d and d.divides(n) and n != Nat.0 implies d <= n
}

theorem nat_tau_le_nat_add_one(n: Nat) {
    nat_tau(n) <= n + Nat.1
}

theorem nat_tau_le_two_mul(n: Nat) {
    nat_tau(n) <= Nat.2 * n
}

theorem length_zero_imp_nil[T](list: List[T]) {
    list.length = Nat.0 implies list = List.nil[T]
}

theorem length_one_cons[T](list: List[T]) {
    list.length = Nat.1 implies exists(a: T) { list = List.cons(a, List.nil[T]) }
}

theorem length_two_cons[T](list: List[T]) {
    list.length = Nat.2 implies exists(a: T, b: T) {
        list = List.cons(a, List.cons(b, List.nil[T]))
    }
}

theorem two_elem_contains_imp_eq[T](x: T, y: T, a: T) {
    List.cons(x, List.cons(y, List.nil[T])).contains(a) implies (a = x or a = y)
}

theorem nat_tau_two_imp_prime(n: Nat) {
    nat_tau(n) = Nat.2 implies n.is_prime
}

theorem nat_tau_two_iff_prime(n: Nat) {
    (nat_tau(n) = Nat.2) = n.is_prime
}

theorem dirichlet_convolve_one_right_eq_divisor_sum(f: Nat -> Nat, n: Nat) {
    dirichlet_convolve(f, nat_one_arithmetic_fn)(n) = divisor_sum_fn(f)(n)
}

theorem nat_sigma_eq_dirichlet_convolve_id_one(n: Nat) {
    nat_sigma(n) = dirichlet_convolve(nat_identity_arithmetic_fn, nat_one_arithmetic_fn)(n)
}

theorem nat_tau_eq_dirichlet_convolve_one_one(n: Nat) {
    nat_tau(n) = dirichlet_convolve(nat_one_arithmetic_fn, nat_one_arithmetic_fn)(n)
}

theorem nat_sigma_eq_dirichlet_convolve_id_one_fn {
    nat_sigma = dirichlet_convolve(nat_identity_arithmetic_fn, nat_one_arithmetic_fn)
}

theorem nat_tau_eq_dirichlet_convolve_one_one_fn {
    nat_tau = dirichlet_convolve(nat_one_arithmetic_fn, nat_one_arithmetic_fn)
}

theorem nat_sigma_convolve_one_eq_id_convolve_tau_fn {
    dirichlet_convolve(nat_sigma, nat_one_arithmetic_fn) =
        dirichlet_convolve(nat_identity_arithmetic_fn, nat_tau)
}

theorem nat_sigma_divisor_sum_eq_id_convolve_tau(n: Nat) {
    divisor_sum_fn(nat_sigma)(n) =
        dirichlet_convolve(nat_identity_arithmetic_fn, nat_tau)(n)
}

theorem nat_sigma_divisor_sum_eq_id_convolve_tau_sum(n: Nat) {
    divisor_sum_fn(nat_sigma)(n) =
        sum(map(divisor_list(n),
            dirichlet_term(nat_identity_arithmetic_fn, nat_tau, n)))
