theorem nat_mobius_divisor_sum_unit_form(n: Nat) {
    sum(map(divisor_list(n), nat_mobius)) = Int.from_nat(nat_dirichlet_unit_fn(n))
}

theorem nat_totient_divisor_sum_identity(n: Nat) {
    divisor_sum_fn(nat_totient)(n) = n
}

theorem nat_totient_divisor_sum_cofactor(n: Nat) {
    Nat.0 < n implies
        divisor_sum_fn(function(d: Nat) { nat_totient(divisor_quotient(n, d)) })(n) = n
}

define bell(n: Nat) -> Nat {
    partial(stirling(n), n.suc)
}

theorem bell_zero {
    bell(Nat.0) = Nat.1
}

theorem bell_one {
    bell(Nat.1) = Nat.1
}

theorem bell_two {
    bell(Nat.2) = Nat.2
}

theorem bell_three {
    bell(Nat.3) = Nat.5
}

define bell_moment_term(n: Nat, k: Nat) -> Nat {
    k.suc * stirling(n, k)
}

define bell_shift_term(n: Nat, k: Nat) -> Nat {
    k.suc * stirling(n, k.suc)
}

define bell_weight_fn(n: Nat, k: Nat) -> Nat {
    k * stirling(n, k)
}

theorem bell_moment_split(n: Nat) {
    partial(bell_moment_term(n), n.suc) =
        bell(n) + partial(bell_shift_term(n), n.suc)
}

theorem bell_moment_recurrence(n: Nat) {
    bell(n.suc) = partial(bell_moment_term(n), n.suc)
}

define stirling_binom_term(n: Nat, j: Nat, k: Nat) -> Nat {
    n.binom(k) * stirling(k, j)
}

define bernoulli_summand_of_option(m: Nat, k: Nat, entry: Option[Rat]) -> Rat {
    match entry {
        Option.none {
            Rat.0
        }
        Option.some(b) {
            Rat.from_nat(m.suc.suc.binom(k)) * b
        }
    }
}

define bernoulli_summand(m: Nat, prev: List[Rat], k: Nat) -> Rat {
    bernoulli_summand_of_option(m, k, prev.get_idx(k))
}

define bernoulli_next(m: Nat, prev: List[Rat]) -> Rat {
    -Rat.1 / Rat.from_nat(m.suc.suc) * partial(bernoulli_summand(m, prev), m.suc)
}

define bernoulli_values(n: Nat) -> List[Rat] {
    match n {
        Nat.zero {
            List.singleton(Rat.1)
        }
        Nat.suc(m) {
            let prev = bernoulli_values(m)
            prev + List.singleton(bernoulli_next(m, prev))
        }
    }
}

define bernoulli(n: Nat) -> Rat {
    match n {
        Nat.zero {
            Rat.1
        }
        Nat.suc(m) {
            bernoulli_next(m, bernoulli_values(m))
        }
    }
}

define bernoulli_recurrence_term(n: Nat, k: Nat) -> Rat {
    Rat.from_nat(n.suc.binom(k)) * bernoulli(k)
}

theorem bernoulli_neg_from_int(n: Int) {
    -Rat.from_int(n) = Rat.from_int(-n)
}

theorem bernoulli_div_from_int(r: Rat, n: Int) {
    r / Rat.from_int(n) = reduce(r.num, r.denom * n)
}

theorem bernoulli_int_over_reduce(a: Int, b: Int) {
    Rat.from_int(a) * reduce(Int.1, b) = reduce(a, b)
}

theorem bernoulli_zero {
    bernoulli(Nat.0) = Rat.1
}

theorem bernoulli_one {
    bernoulli(Nat.1) = -Rat.1 / Rat.2
