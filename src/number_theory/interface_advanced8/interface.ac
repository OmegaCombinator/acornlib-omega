define squarefree_count(n: Nat) -> Nat {
    match n {
        Nat.zero {
            Nat.0
        }
        Nat.suc(k) {
            if is_squarefree(k.suc) {
                squarefree_count(k) + Nat.1
            } else {
                squarefree_count(k)
            }
        }
    }
}

theorem squarefree_count_zero {
