typeclass X: XCoord extends Group {
    /// Reduces a group element to a scalar in `[0, n)`, where `n` is the
    /// group order.
    x_coord: X -> Nat
}

structure Quat {
    /// The first complex coordinate.
    first: Complex
    /// The second complex coordinate.
    second: Complex
}

structure GaussInt {
    /// The real part of the Gaussian integer.
    re: Int
    /// The imaginary part of the Gaussian integer.
    im: Int
}

instance GaussInt: Zero {
    let 0: GaussInt = GaussInt.new(Int.0, Int.0)
}

instance GaussInt: One {
    let 1: GaussInt = GaussInt.new(Int.1, Int.0)
}

instance GaussInt: Add {
    define add(self, other: GaussInt) -> GaussInt {
        GaussInt.new(self.re + other.re, self.im + other.im)
    }
}

instance GaussInt: Neg {
    define neg(self) -> GaussInt {
        GaussInt.new(-self.re, -self.im)
    }
}

instance GaussInt: Mul {
    define mul(self, other: GaussInt) -> GaussInt {
        GaussInt.new(
            self.re * other.re - self.im * other.im,
            self.re * other.im + self.im * other.re
        )
    }
}

attributes Nat {
    /// True if this number is congruent to b modulo n. Defined as the equality
    /// of the two values' remainders when divided by n. This avoids the
    /// truncating subtraction on Nat that the divisibility-based form would
    /// require.
    define congr_mod(self, b: Nat, n: Nat) -> Bool {
        self.mod(n) = b.mod(n)
    }
}

attributes GaussInt {
    /// The imaginary unit i = 0 + 1i, satisfying i² = -1.
    let i: GaussInt = GaussInt.new(Int.0, Int.1)

    /// The complex conjugate, which negates the imaginary part.
    define conj(self) -> GaussInt {
        GaussInt.new(self.re, -self.im)
    }

    /// The norm N(a + bi) = a² + b², an integer (always nonnegative in
    /// practice).  The norm is multiplicative and controls divisibility.
    define norm(self) -> Int {
        self.re * self.re + self.im * self.im
    }

    /// The norm expressed as a natural number, N(a + bi) = |a|² + |b|².
    define norm_nat(self) -> Nat {
        abs(self.re) * abs(self.re) + abs(self.im) * abs(self.im)
    }

    /// True when the Gaussian integer divides another: z | w when w = z·k
    /// for some Gaussian integer k.
    define divides(self, other: GaussInt) -> Bool {
        exists(k: GaussInt) { self * k = other }
    }

    /// True when the Gaussian integer is a unit, i.e. has a multiplicative
    /// inverse.  The units of the Gaussian integers are ±1 and ±i.
    define is_unit(self) -> Bool {
        exists(k: GaussInt) { self * k = GaussInt.1 }
    }
}

theorem nat_bezout(a: Nat, b: Nat) {
    exists(x: Int, y: Int) {
        x * Int.from_nat(a) + y * Int.from_nat(b) = Int.from_nat(a.gcd(b))
    }
}

define collatz(n: Nat) -> Nat {
    if nat_odd(n) {
        3 * n + 1
    } else {
        n.div(2)
    }
}

theorem collatz_odd_eq(n: Nat) {
    nat_odd(n) implies collatz(n) = 3 * n + 1
}

theorem collatz_even_eq(n: Nat) {
    not nat_odd(n) implies collatz(n) = n.div(2)
}

theorem collatz_one_odd {
    nat_odd(Nat.1) = true
}

theorem collatz_two_even {
    nat_odd(Nat.2) = false
}

theorem collatz_three_odd {
    nat_odd(Nat.3) = true
}

theorem collatz_four_even {
    nat_odd(Nat.4) = false
}

theorem collatz_five_odd {
    nat_odd(Nat.5) = true
}

theorem collatz_even_double(k: Nat) {
    nat_odd(Nat.2 * k) = false
}

theorem collatz_eight_even {
    nat_odd(Nat.8) = false
}

theorem collatz_ten_even {
    nat_odd(Nat.10) = false
}

theorem collatz_sixteen_even {
    nat_odd(Nat.16) = false
}

