}

theorem continued_fraction_triple_denominator(cf: ContinuedFraction, head: Nat,
    next: Nat, third: Nat) {
    cf.coefficients = List.cons(head, List.cons(next, List.cons(third, List.nil[Nat])))
        implies cf.denominator = next * third + Nat.1
}

