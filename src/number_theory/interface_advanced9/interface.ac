define up_arrow(a: Nat, n: Nat, b: Nat) -> Nat {
    match n {
        Nat.zero {
            a.pow(b)
        }
        Nat.suc(k) {
            iter_nat(function(x: Nat) { up_arrow(a, k, x) }, b, Nat.1)
        }
    }
}

