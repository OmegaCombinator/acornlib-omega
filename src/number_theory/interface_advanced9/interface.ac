    n != Nat.0 implies
        happy_fuel(p, n, k.suc) = n.mod(p) * n.mod(p) + happy_fuel(p, n.div(p), k)
}

theorem happy_sum_step(p: Nat, n: Nat) {
    n != Nat.0 implies
        happy_sum(p, n) =
            n.mod(p) * n.mod(p) + happy_fuel(p, n.div(p), n - Nat.1)
}

