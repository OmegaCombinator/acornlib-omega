define count_nonzero_residues(k: Nat) -> Nat {
    match k {
        Nat.zero {
            Nat.0
        }
        Nat.suc(j) {
            match j {
                Nat.zero {
                    Nat.0
                }
                Nat.suc(jj) {
                    count_nonzero_residues(j) + Nat.1
                }
            }
        }
    }
}

