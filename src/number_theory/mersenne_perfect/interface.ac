}

theorem sub_sub_rearrange[R: CommRing](x: R, y: R, p: R, q: R) {
    (x - y) - (p - q) = (x - p) - (y - q)
}

theorem sub_add_rearrange[R: CommRing](x: R, y: R, p: R, q: R) {
