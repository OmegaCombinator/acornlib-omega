theorem continuous_coeff_eval_function(c: Nat -> Real, n: Nat) {
    continuous(coeff_eval_fn(c, n))
}

define polynomial_eval_function[R: Semiring](p: Polynomial[R]) -> (R -> R) {
    function(x: R) { polynomial_eval(p, x) }
