theorem system_density_cons_ge_tail(
    head: Pair[Nat, Nat], tail: List[Pair[Nat, Nat]]
) {
    system_density(tail) <= system_density(List.cons(head, tail))
}

theorem system_density_nonnegative(system: List[Pair[Nat, Nat]]) {
    Rat.0 <= system_density(system)
}

theorem system_density_ge_one_of_modulus_one(tail: List[Pair[Nat, Nat]], r: Nat) {
    Rat.1 <= system_density(List.cons(Pair.new(Nat.1, r), tail))
}

define classes_disjoint(cl1: Pair[Nat, Nat], cl2: Pair[Nat, Nat]) -> Bool {
    forall(x: Int) {
        not (congruence_class_contains(cl1, x) and congruence_class_contains(cl2, x))
    }
}

theorem classes_disjoint_apply(cl1: Pair[Nat, Nat], cl2: Pair[Nat, Nat], x: Int) {
    classes_disjoint(cl1, cl2)
        implies not (congruence_class_contains(cl1, x) and congruence_class_contains(cl2, x))
}

theorem classes_disjoint_intro(cl1: Pair[Nat, Nat], cl2: Pair[Nat, Nat]) {
    (forall(x: Int) {
        not (congruence_class_contains(cl1, x) and congruence_class_contains(cl2, x))
    }) implies classes_disjoint(cl1, cl2)
}

theorem classes_disjoint_symm(cl1: Pair[Nat, Nat], cl2: Pair[Nat, Nat]) {
    classes_disjoint(cl1, cl2) implies classes_disjoint(cl2, cl1)
}

define head_disjoint_from(head: Pair[Nat, Nat], rest: List[Pair[Nat, Nat]]) -> Bool {
    forall(x: Int) {
        not (congruence_class_contains(head, x) and covers_int(rest, x))
    }
}

theorem head_disjoint_from_apply(
    head: Pair[Nat, Nat], rest: List[Pair[Nat, Nat]], x: Int
) {
    head_disjoint_from(head, rest)
        implies not (congruence_class_contains(head, x) and covers_int(rest, x))
}

theorem head_disjoint_from_intro(head: Pair[Nat, Nat], rest: List[Pair[Nat, Nat]]) {
    (forall(x: Int) {
        not (congruence_class_contains(head, x) and covers_int(rest, x))
    }) implies head_disjoint_from(head, rest)
}

define disjoint_system(system: List[Pair[Nat, Nat]]) -> Bool {
    match system {
        List.nil {
            true
        }
        List.cons(head, tail) {
            head_disjoint_from(head, tail) and disjoint_system(tail)
        }
    }
}

theorem disjoint_system_cons_head_part(
    head: Pair[Nat, Nat], tail: List[Pair[Nat, Nat]]
) {
    disjoint_system(List.cons(head, tail)) implies head_disjoint_from(head, tail)
}

theorem disjoint_system_cons_tail_part(
    head: Pair[Nat, Nat], tail: List[Pair[Nat, Nat]]
) {
    disjoint_system(List.cons(head, tail)) implies disjoint_system(tail)
}

theorem disjoint_system_nil {
    disjoint_system(List.nil[Pair[Nat, Nat]])
}

theorem disjoint_system_tail(head: Pair[Nat, Nat], tail: List[Pair[Nat, Nat]]) {
    disjoint_system(List.cons(head, tail)) implies disjoint_system(tail)
}

theorem disjoint_system_head(head: Pair[Nat, Nat], tail: List[Pair[Nat, Nat]], x: Int) {
    disjoint_system(List.cons(head, tail))
        implies not (congruence_class_contains(head, x) and covers_int(tail, x))
}

theorem disjoint_system_cons_intro(head: Pair[Nat, Nat], tail: List[Pair[Nat, Nat]]) {
    head_disjoint_from(head, tail) and disjoint_system(tail)
        implies disjoint_system(List.cons(head, tail))
}

theorem congruence_class_contains_eq(cl: Pair[Nat, Nat], x: Int) {
    congruence_class_contains(cl, x) = int_mod_rel(cl.first, x, Int.from_nat(cl.second))
}

theorem class_modulus_divides_difference(cl: Pair[Nat, Nat], x: Int) {
    congruence_class_contains(cl, x)
        implies Int.from_nat(cl.first).divides(x - Int.from_nat(cl.second))
}

theorem meeting_classes_moduli_divide(
    cl1: Pair[Nat, Nat], cl2: Pair[Nat, Nat], x: Int
) {
    congruence_class_contains(cl1, x) and congruence_class_contains(cl2, x)
        implies Int.from_nat(cl1.first).divides(x - Int.from_nat(cl1.second))
            and Int.from_nat(cl2.first).divides(x - Int.from_nat(cl2.second))
}

theorem same_modulus_classes_disjoint(cl1: Pair[Nat, Nat], cl2: Pair[Nat, Nat]) {
    cl1.first = cl2.first
        and not int_mod_rel(cl1.first, Int.from_nat(cl1.second), Int.from_nat(cl2.second))
        implies classes_disjoint(cl1, cl2)
}

theorem disjoint_system_unique_cover(
    head: Pair[Nat, Nat], tail: List[Pair[Nat, Nat]], x: Int
) {
    disjoint_system(List.cons(head, tail)) and congruence_class_contains(head, x)
        implies not covers_int(tail, x)
}

theorem disjoint_system_tail_excludes_head(
    head: Pair[Nat, Nat], tail: List[Pair[Nat, Nat]], x: Int
) {
    disjoint_system(List.cons(head, tail)) and covers_int(tail, x)
        implies not congruence_class_contains(head, x)
}

define all_moduli_divide(system: List[Pair[Nat, Nat]], m: Nat) -> Bool {
    match system {
        List.nil {
            true
        }
        List.cons(head, tail) {
            head.first.divides(m) and all_moduli_divide(tail, m)
        }
    }
}

theorem all_moduli_divide_head(
    head: Pair[Nat, Nat], tail: List[Pair[Nat, Nat]], m: Nat
) {
    all_moduli_divide(List.cons(head, tail), m) implies head.first.divides(m)
}

theorem all_moduli_divide_tail(
    head: Pair[Nat, Nat], tail: List[Pair[Nat, Nat]], m: Nat
) {
    all_moduli_divide(List.cons(head, tail), m) implies all_moduli_divide(tail, m)
}

theorem all_moduli_divide_cons_intro(
    head: Pair[Nat, Nat], tail: List[Pair[Nat, Nat]], m: Nat
) {
    head.first.divides(m) and all_moduli_divide(tail, m)
        implies all_moduli_divide(List.cons(head, tail), m)
}

theorem all_moduli_divide_nil(m: Nat) {
    all_moduli_divide(List.nil[Pair[Nat, Nat]], m)
}

theorem class_periodic(cl: Pair[Nat, Nat], m: Nat, x: Int, y: Int) {
    cl.first.divides(m) and int_mod_rel(m, x, y) and congruence_class_contains(cl, y)
        implies congruence_class_contains(cl, x)
}

theorem system_periodic(
    system: List[Pair[Nat, Nat]], m: Nat, x: Int, y: Int
) {
    all_moduli_divide(system, m) and int_mod_rel(m, x, y) and covers_int(system, y)
        implies covers_int(system, x)
}

define all_moduli_gt_one(system: List[Pair[Nat, Nat]]) -> Bool {
    match system {
        List.nil {
            true
        }
        List.cons(head, tail) {
            Nat.1 < head.first and all_moduli_gt_one(tail)
        }
    }
}

theorem all_moduli_gt_one_head(head: Pair[Nat, Nat], tail: List[Pair[Nat, Nat]]) {
    all_moduli_gt_one(List.cons(head, tail)) implies Nat.1 < head.first
}

theorem all_moduli_gt_one_tail(head: Pair[Nat, Nat], tail: List[Pair[Nat, Nat]]) {
    all_moduli_gt_one(List.cons(head, tail)) implies all_moduli_gt_one(tail)
}

theorem all_moduli_gt_one_cons_intro(head: Pair[Nat, Nat], tail: List[Pair[Nat, Nat]]) {
    Nat.1 < head.first and all_moduli_gt_one(tail)
        implies all_moduli_gt_one(List.cons(head, tail))
}

define all_moduli_odd(system: List[Pair[Nat, Nat]]) -> Bool {
    match system {
        List.nil {
            true
        }
        List.cons(head, tail) {
            not Nat.2.divides(head.first) and all_moduli_odd(tail)
        }
    }
}

theorem all_moduli_odd_head(head: Pair[Nat, Nat], tail: List[Pair[Nat, Nat]]) {
    all_moduli_odd(List.cons(head, tail)) implies not Nat.2.divides(head.first)
}

theorem all_moduli_odd_tail(head: Pair[Nat, Nat], tail: List[Pair[Nat, Nat]]) {
    all_moduli_odd(List.cons(head, tail)) implies all_moduli_odd(tail)
}

define has_modulus(system: List[Pair[Nat, Nat]], m: Nat) -> Bool {
    match system {
        List.nil {
            false
        }
        List.cons(head, tail) {
            head.first = m or has_modulus(tail, m)
        }
    }
}

theorem has_modulus_nil(m: Nat) {
    not has_modulus(List.nil[Pair[Nat, Nat]], m)
}

theorem has_modulus_cons_head(head: Pair[Nat, Nat], tail: List[Pair[Nat, Nat]]) {
    has_modulus(List.cons(head, tail), head.first)
}

theorem has_modulus_cons_tail(head: Pair[Nat, Nat], tail: List[Pair[Nat, Nat]], m: Nat) {
    has_modulus(tail, m) implies has_modulus(List.cons(head, tail), m)
}

theorem has_modulus_cons_imp(head: Pair[Nat, Nat], tail: List[Pair[Nat, Nat]], m: Nat) {
    has_modulus(List.cons(head, tail), m) implies head.first = m or has_modulus(tail, m)
}

define distinct_moduli(system: List[Pair[Nat, Nat]]) -> Bool {
    match system {
        List.nil {
            true
        }
        List.cons(head, tail) {
            not has_modulus(tail, head.first) and distinct_moduli(tail)
        }
    }
}

theorem distinct_moduli_head(head: Pair[Nat, Nat], tail: List[Pair[Nat, Nat]]) {
    distinct_moduli(List.cons(head, tail)) implies not has_modulus(tail, head.first)
}

theorem distinct_moduli_tail(head: Pair[Nat, Nat], tail: List[Pair[Nat, Nat]]) {
    distinct_moduli(List.cons(head, tail)) implies distinct_moduli(tail)
}

theorem distinct_moduli_cons_intro(head: Pair[Nat, Nat], tail: List[Pair[Nat, Nat]]) {
    not has_modulus(tail, head.first) and distinct_moduli(tail)
        implies distinct_moduli(List.cons(head, tail))
}

theorem meeting_classes_gcd_divides_residue_gap(
    cl1: Pair[Nat, Nat], cl2: Pair[Nat, Nat], x: Int
) {
    congruence_class_contains(cl1, x) and congruence_class_contains(cl2, x)
        implies Int.from_nat(cl1.first).gcd(Int.from_nat(cl2.first)).divides(
            Int.from_nat(cl1.second) - Int.from_nat(cl2.second))
}

theorem classes_disjoint_of_gcd_not_divides(cl1: Pair[Nat, Nat], cl2: Pair[Nat, Nat]) {
    not Int.from_nat(cl1.first).gcd(Int.from_nat(cl2.first)).divides(
        Int.from_nat(cl1.second) - Int.from_nat(cl2.second))
        implies classes_disjoint(cl1, cl2)
}

define system_lcm(system: List[Pair[Nat, Nat]]) -> Nat {
    match system {
        List.nil {
            Nat.1
        }
        List.cons(head, tail) {
            head.first.lcm(system_lcm(tail))
        }
    }
}

theorem system_lcm_nil {
    system_lcm(List.nil[Pair[Nat, Nat]]) = Nat.1
}

theorem system_lcm_cons(head: Pair[Nat, Nat], tail: List[Pair[Nat, Nat]]) {
    system_lcm(List.cons(head, tail)) = head.first.lcm(system_lcm(tail))
}

theorem all_moduli_divide_of_divides(
    system: List[Pair[Nat, Nat]], k: Nat, m: Nat
) {
    all_moduli_divide(system, k) and k.divides(m) implies all_moduli_divide(system, m)
}

theorem all_moduli_divide_system_lcm(system: List[Pair[Nat, Nat]]) {
    all_moduli_divide(system, system_lcm(system))
}

theorem congruence_class_contains_of_divides(cl: Pair[Nat, Nat], x: Int) {
    Int.from_nat(cl.first).divides(x - Int.from_nat(cl.second))
        implies congruence_class_contains(cl, x)
}

theorem int_gcd_from_nat(a: Nat, b: Nat) {
    Int.from_nat(a).gcd(Int.from_nat(b)) = Int.from_nat(a.gcd(b))
}

theorem classes_meet_of_gcd_divides(cl1: Pair[Nat, Nat], cl2: Pair[Nat, Nat]) {
    Int.from_nat(cl1.first).gcd(Int.from_nat(cl2.first)).divides(
        Int.from_nat(cl1.second) - Int.from_nat(cl2.second))
        implies exists(x: Int) {
            congruence_class_contains(cl1, x) and congruence_class_contains(cl2, x)
        }
}

theorem gcd_not_divides_of_classes_disjoint(cl1: Pair[Nat, Nat], cl2: Pair[Nat, Nat]) {
    classes_disjoint(cl1, cl2)
        implies not Int.from_nat(cl1.first).gcd(Int.from_nat(cl2.first)).divides(
            Int.from_nat(cl1.second) - Int.from_nat(cl2.second))
}

theorem classes_disjoint_iff_gcd_not_divides(cl1: Pair[Nat, Nat], cl2: Pair[Nat, Nat]) {
    classes_disjoint(cl1, cl2)
        = not Int.from_nat(cl1.first).gcd(Int.from_nat(cl2.first)).divides(
            Int.from_nat(cl1.second) - Int.from_nat(cl2.second))
}

define full_residue_system(m: Nat, k: Nat) -> List[Pair[Nat, Nat]] {
    match k {
        Nat.zero {
            List.nil[Pair[Nat, Nat]]
        }
        Nat.suc(pred) {
            List.cons(Pair.new(m, pred), full_residue_system(m, pred))
        }
    }
}

theorem full_residue_system_zero(m: Nat) {
    full_residue_system(m, Nat.0) = List.nil[Pair[Nat, Nat]]
}

theorem full_residue_system_suc(m: Nat, k: Nat) {
    full_residue_system(m, k.suc)
        = List.cons(Pair.new(m, k), full_residue_system(m, k))
}

theorem full_residue_system_density(m: Nat, k: Nat) {
    system_density(full_residue_system(m, k)) = Rat.from_nat(k) * modulus_weight(m)
}

theorem full_residue_system_density_one(m: Nat) {
    Nat.0 < m implies system_density(full_residue_system(m, m)) = Rat.1
}

define rsa_encrypt(m: Nat, e: Nat, n: Nat) -> Nat {
    m.pow(e).mod(n)
}

define rsa_decrypt(c: Nat, d: Nat, n: Nat) -> Nat {
    c.pow(d).mod(n)
}

define is_rsa_key(p: Nat, q: Nat, e: Nat, d: Nat) -> Bool {
    p.is_prime and q.is_prime and p != q and
    (e * d).mod((p - Nat.1) * (q - Nat.1)) = Nat.1
}

theorem is_rsa_key_unfold(p: Nat, q: Nat, e: Nat, d: Nat) {
    is_rsa_key(p, q, e, d) =
        (p.is_prime and q.is_prime and p != q
            and (e * d).mod((p - Nat.1) * (q - Nat.1)) = Nat.1)
}

theorem rsa_quotient_form(p: Nat, q: Nat, e: Nat, d: Nat) {
    (e * d).mod((p - Nat.1) * (q - Nat.1)) = Nat.1
        implies exists(k: Nat) { k * ((p - Nat.1) * (q - Nat.1)) + Nat.1 = e * d }
}

theorem rsa_assoc_for_p(k: Nat, p: Nat, q: Nat) {
    k * ((p - Nat.1) * (q - Nat.1)) = k * (q - Nat.1) * (p - Nat.1)
}

theorem rsa_assoc_for_q(k: Nat, p: Nat, q: Nat) {
    k * ((p - Nat.1) * (q - Nat.1)) = k * (p - Nat.1) * (q - Nat.1)
}

theorem rsa_pow_mod_p(p: Nat, q: Nat, e: Nat, d: Nat, m: Nat, k: Nat) {
    p.is_prime and k * ((p - Nat.1) * (q - Nat.1)) + Nat.1 = e * d
        implies m.pow(e * d).congr_mod(m, p)
}

theorem rsa_pow_mod_q(p: Nat, q: Nat, e: Nat, d: Nat, m: Nat, k: Nat) {
    q.is_prime and k * ((p - Nat.1) * (q - Nat.1)) + Nat.1 = e * d
        implies m.pow(e * d).congr_mod(m, q)
}

theorem rsa_pow_mod_pq(p: Nat, q: Nat, e: Nat, d: Nat, m: Nat) {
    is_rsa_key(p, q, e, d) implies m.pow(e * d).congr_mod(m, p * q)
}

theorem rsa_collapse(m: Nat, e: Nat, d: Nat, n: Nat) {
    ((m.pow(e).mod(n)).pow(d)).mod(n) = m.pow(e * d).mod(n)
}

theorem rsa_correctness(p: Nat, q: Nat, e: Nat, d: Nat, m: Nat) {
    is_rsa_key(p, q, e, d) and m < p * q implies
        rsa_decrypt(rsa_encrypt(m, e, p * q), d, p * q) = m
}

theorem rsa_encrypt_mod_input(m: Nat, e: Nat, n: Nat) {
    rsa_encrypt(m.mod(n), e, n) = rsa_encrypt(m, e, n)
}

theorem rsa_decrypt_mod_input(c: Nat, d: Nat, n: Nat) {
    rsa_decrypt(c.mod(n), d, n) = rsa_decrypt(c, d, n)
}

theorem rsa_encrypt_respects_congr_mod(m1: Nat, m2: Nat, e: Nat, n: Nat) {
    m1.congr_mod(m2, n) implies rsa_encrypt(m1, e, n) = rsa_encrypt(m2, e, n)
}

theorem rsa_decrypt_respects_congr_mod(c1: Nat, c2: Nat, d: Nat, n: Nat) {
    c1.congr_mod(c2, n) implies rsa_decrypt(c1, d, n) = rsa_decrypt(c2, d, n)
}

theorem rsa_encrypt_output_lt(m: Nat, e: Nat, n: Nat) {
    n != Nat.0 implies rsa_encrypt(m, e, n) < n
}

theorem rsa_decrypt_output_lt(c: Nat, d: Nat, n: Nat) {
    n != Nat.0 implies rsa_decrypt(c, d, n) < n
}

theorem rsa_encrypt_mod_self(m: Nat, e: Nat, n: Nat) {
    rsa_encrypt(m, e, n).mod(n) = rsa_encrypt(m, e, n)
}

theorem rsa_decrypt_mod_self(c: Nat, d: Nat, n: Nat) {
    rsa_decrypt(c, d, n).mod(n) = rsa_decrypt(c, d, n)
}

theorem rsa_encrypt_zero_modulus(m: Nat, e: Nat) {
    rsa_encrypt(m, e, Nat.0) = m.pow(e)
}

theorem rsa_decrypt_zero_modulus(c: Nat, d: Nat) {
    rsa_decrypt(c, d, Nat.0) = c.pow(d)
}

theorem rsa_key_symmetric(p: Nat, q: Nat, e: Nat, d: Nat) {
    is_rsa_key(p, q, e, d) implies is_rsa_key(p, q, d, e)
}

theorem rsa_decrypt_encrypt_mod(p: Nat, q: Nat, e: Nat, d: Nat, m: Nat) {
    is_rsa_key(p, q, e, d) implies
        rsa_decrypt(rsa_encrypt(m, e, p * q), d, p * q) = m.mod(p * q)
}

theorem rsa_encrypt_decrypt_bounded(p: Nat, q: Nat, e: Nat, d: Nat, m: Nat) {
    is_rsa_key(p, q, e, d) and m < p * q implies
        rsa_encrypt(rsa_decrypt(m, d, p * q), e, p * q) = m
}

theorem rsa_encrypt_decrypt_mod(p: Nat, q: Nat, e: Nat, d: Nat, m: Nat) {
    is_rsa_key(p, q, e, d) implies
        rsa_encrypt(rsa_decrypt(m, d, p * q), e, p * q) = m.mod(p * q)
}

theorem rsa_roundtrip_mod_pair(p: Nat, q: Nat, e: Nat, d: Nat, m: Nat) {
    is_rsa_key(p, q, e, d) implies
        rsa_decrypt(rsa_encrypt(m, e, p * q), d, p * q) = m.mod(p * q) and
        rsa_encrypt(rsa_decrypt(m, d, p * q), e, p * q) = m.mod(p * q)
}

theorem rsa_key_symmetric_iff(p: Nat, q: Nat, e: Nat, d: Nat) {
    is_rsa_key(p, q, e, d) = is_rsa_key(p, q, d, e)
}

theorem rsa_roundtrip_bounded_pair(p: Nat, q: Nat, e: Nat, d: Nat, m: Nat) {
    is_rsa_key(p, q, e, d) and m < p * q implies
        rsa_decrypt(rsa_encrypt(m, e, p * q), d, p * q) = m and
        rsa_encrypt(rsa_decrypt(m, d, p * q), e, p * q) = m
}

theorem rsa_roundtrip_mod_pair_symmetric(p: Nat, q: Nat, e: Nat, d: Nat, m: Nat) {
    is_rsa_key(p, q, e, d) implies
        rsa_decrypt(rsa_encrypt(m, d, p * q), e, p * q) = m.mod(p * q) and
        rsa_encrypt(rsa_decrypt(m, e, p * q), d, p * q) = m.mod(p * q)
}

theorem rsa_decrypt_encrypt_eq_of_congr_mod(p: Nat, q: Nat, e: Nat, d: Nat, m: Nat, r: Nat) {
    is_rsa_key(p, q, e, d) and m.congr_mod(r, p * q) implies
        rsa_decrypt(rsa_encrypt(m, e, p * q), d, p * q) = r.mod(p * q)
}

theorem rsa_encrypt_decrypt_eq_of_congr_mod(p: Nat, q: Nat, e: Nat, d: Nat, m: Nat, r: Nat) {
    is_rsa_key(p, q, e, d) and m.congr_mod(r, p * q) implies
        rsa_encrypt(rsa_decrypt(m, d, p * q), e, p * q) = r.mod(p * q)
}

theorem rsa_roundtrip_mod_pair_of_congr_mod(p: Nat, q: Nat, e: Nat, d: Nat, m: Nat, r: Nat) {
    is_rsa_key(p, q, e, d) and m.congr_mod(r, p * q) implies
        rsa_decrypt(rsa_encrypt(m, e, p * q), d, p * q) = r.mod(p * q) and
        rsa_encrypt(rsa_decrypt(m, d, p * q), e, p * q) = r.mod(p * q)
}

theorem rsa_decrypt_encrypt_congr_mod_of_congr_mod(p: Nat, q: Nat, e: Nat, d: Nat, m: Nat, r: Nat) {
    is_rsa_key(p, q, e, d) and m.congr_mod(r, p * q) implies
        rsa_decrypt(rsa_encrypt(m, e, p * q), d, p * q).congr_mod(r, p * q)
}

theorem rsa_encrypt_decrypt_congr_mod_of_congr_mod(p: Nat, q: Nat, e: Nat, d: Nat, m: Nat, r: Nat) {
    is_rsa_key(p, q, e, d) and m.congr_mod(r, p * q) implies
        rsa_encrypt(rsa_decrypt(m, d, p * q), e, p * q).congr_mod(r, p * q)
}

theorem sub_one_add_one(p: Nat) {
    Nat.1 <= p implies (p - Nat.1) + Nat.1 = p
}

theorem pow_sub_mul(p: Nat, i: Nat, k: Nat) {
    i <= k implies p.pow(i) * p.pow(k - i) = p.pow(k)
}

theorem nat_pow_injective(p: Nat) {
    p.is_prime implies is_injective_fn[Nat, Nat](p.pow)
}

theorem pow_range_list_unique(p: Nat, k: Nat) {
    p.is_prime implies map((k + Nat.1).range, p.pow).is_unique
}

theorem prime_pow_divisor_eq_pow(p: Nat, k: Nat, d: Nat) {
    p.is_prime and d.divides(p.pow(k)) and d != Nat.0
        implies exists(i: Nat) { i <= k and d = p.pow(i) }
}

theorem divisor_list_prime_pow_contains(p: Nat, k: Nat, x: Nat) {
    p.is_prime and divisor_list(p.pow(k)).contains(x)
        implies map((k + Nat.1).range, p.pow).contains(x)
}

theorem divisor_list_prime_pow_contains_of(p: Nat, k: Nat, x: Nat) {
    p.is_prime and map((k + Nat.1).range, p.pow).contains(x)
        implies divisor_list(p.pow(k)).contains(x)
