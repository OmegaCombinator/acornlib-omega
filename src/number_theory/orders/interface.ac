theorem quadratic_residue_square_mul_congr(x: Nat, a: Nat, c: Nat, n: Nat) {
    is_quadratic_residue_mod(a, n) and (x.pow(Nat.2) * a).congr_mod(c, n)
        implies is_quadratic_residue_mod(c, n)
