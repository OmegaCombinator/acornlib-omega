theorem unit_fraction_ceiling_step_raw_num_descends(q: Rat, n: Nat) {
    q.is_positive and q < Rat.1 and unit_fraction_ceiling_step(q, n) and
        unit_fraction_bounded_step(q, n)
        implies unit_fraction_raw_num_descends(q, n)
