define totient_product_factor(n: Nat, p: Nat) -> Nat {
    p.pow(count_prime_factor(p, n) - Nat.1) * (p - Nat.1)
}

theorem totient_prime_power_deep(p: Nat, k: Nat) {
    Nat.1 <= k and p.is_prime implies (p.pow(k)).totient = p.pow(k) - p.pow(k - Nat.1)
}

theorem totient_prime_power_product_form(p: Nat, k: Nat) {
    Nat.1 <= k and p.is_prime implies (p.pow(k)).totient = p.pow(k - Nat.1) * (p - Nat.1)
}

theorem totient_mul_coprime_deep(m: Nat, n: Nat) {
    m.coprime(n) implies nat_totient(m * n) = nat_totient(m) * nat_totient(n)
}

theorem not_lt_imp_lte(a: Nat, b: Nat) {
    not (a < b) implies b <= a
}

theorem add_lt_cancel_left(a: Nat, b: Nat, c: Nat) {
    a + b < a + c implies b < c
}

theorem coprime_divisor_one(n: Nat, d: Nat) {
    d.divides(n) and d.coprime(n) implies d = Nat.1
}

define residue_lower_half(n: Nat, a: Nat) -> Bool {
    a + a < n
}

define residue_upper_half(n: Nat, a: Nat) -> Bool {
    n < a + a
}

define lower_half_residues(n: Nat) -> List[Nat] {
    coprime_residues(n).filter(residue_lower_half(n))
}

define upper_half_residues(n: Nat) -> List[Nat] {
    coprime_residues(n).filter(residue_upper_half(n))
}

theorem residue_nonzero(n: Nat, x: Nat) {
    Nat.2 < n and coprime_residues(n).contains(x) implies x != Nat.0
}

theorem residue_not_half(n: Nat, x: Nat) {
    Nat.2 < n and coprime_residues(n).contains(x) implies x + x != n
}

theorem residue_lower_or_upper(n: Nat, x: Nat) {
    Nat.2 < n and coprime_residues(n).contains(x)
        implies residue_lower_half(n, x) or residue_upper_half(n, x)
}

theorem residue_not_lower_imp_upper(n: Nat, x: Nat) {
    Nat.2 < n and coprime_residues(n).contains(x) and not residue_lower_half(n, x)
        implies residue_upper_half(n, x)
}

theorem residue_upper_imp_not_lower(n: Nat, x: Nat) {
    Nat.2 < n and coprime_residues(n).contains(x) and residue_upper_half(n, x)
        implies not residue_lower_half(n, x)
}

theorem coprime_not_half(n: Nat, j: Nat) {
    Nat.2 < n and j.coprime(n) implies j + j != n
}

define count_lower_half(n: Nat, k: Nat) -> Nat {
    match k {
        Nat.zero {
            Nat.0
        }
        Nat.suc(j) {
            if j.coprime(n) and residue_lower_half(n, j) {
                count_lower_half(n, j) + Nat.1
            } else {
                count_lower_half(n, j)
            }
        }
    }
}

define count_upper_half(n: Nat, k: Nat) -> Nat {
    match k {
        Nat.zero {
            Nat.0
        }
        Nat.suc(j) {
            if j.coprime(n) and residue_upper_half(n, j) {
                count_upper_half(n, j) + Nat.1
            } else {
                count_upper_half(n, j)
            }
        }
    }
}

theorem count_lower_half_suc_yes(n: Nat, j: Nat) {
    j.coprime(n) and residue_lower_half(n, j)
        implies count_lower_half(n, j.suc) = count_lower_half(n, j) + Nat.1
}

theorem count_lower_half_suc_no(n: Nat, j: Nat) {
    not (j.coprime(n) and residue_lower_half(n, j))
        implies count_lower_half(n, j.suc) = count_lower_half(n, j)
}

theorem count_upper_half_suc_yes(n: Nat, j: Nat) {
    j.coprime(n) and residue_upper_half(n, j)
        implies count_upper_half(n, j.suc) = count_upper_half(n, j) + Nat.1
}

theorem count_upper_half_suc_no(n: Nat, j: Nat) {
    not (j.coprime(n) and residue_upper_half(n, j))
        implies count_upper_half(n, j.suc) = count_upper_half(n, j)
}

define coprime_half_partition_pred(n: Nat) -> (Nat -> Bool) {
    function(k: Nat) {
        count_coprime_to(n, k) = count_lower_half(n, k) + count_upper_half(n, k)
    }
}

theorem coprime_half_partition_step(n: Nat, j: Nat) {
    Nat.2 < n and coprime_half_partition_pred(n)(j)
        implies coprime_half_partition_pred(n)(j.suc)
}

theorem coprime_half_partition_run(n: Nat, k: Nat) {
    Nat.2 < n implies coprime_half_partition_pred(n)(k)
}

theorem count_coprime_partition(n: Nat, k: Nat) {
    Nat.2 < n implies
        count_coprime_to(n, k) = count_lower_half(n, k) + count_upper_half(n, k)
}

define lower_half_count_pred(n: Nat) -> (Nat -> Bool) {
    function(k: Nat) {
        coprime_residues_below(n, k).filter(residue_lower_half(n)).length = count_lower_half(n, k)
    }
}

theorem lower_half_count_step(n: Nat, j: Nat) {
    Nat.2 < n and lower_half_count_pred(n)(j)
        implies lower_half_count_pred(n)(j.suc)
}

theorem lower_half_count_run(n: Nat, k: Nat) {
    Nat.2 < n implies lower_half_count_pred(n)(k)
}

theorem lower_half_residues_length_eq_count(n: Nat) {
    Nat.2 < n implies lower_half_residues(n).length = count_lower_half(n, n)
}

define upper_half_count_pred(n: Nat) -> (Nat -> Bool) {
    function(k: Nat) {
        coprime_residues_below(n, k).filter(residue_upper_half(n)).length = count_upper_half(n, k)
    }
}

theorem upper_half_count_step(n: Nat, j: Nat) {
    Nat.2 < n and upper_half_count_pred(n)(j)
        implies upper_half_count_pred(n)(j.suc)
}

theorem upper_half_count_run(n: Nat, k: Nat) {
    Nat.2 < n implies upper_half_count_pred(n)(k)
}

theorem upper_half_residues_length_eq_count(n: Nat) {
    Nat.2 < n implies upper_half_residues(n).length = count_upper_half(n, n)
}

theorem lower_reflect_mem_upper(n: Nat, y: Nat) {
    Nat.2 < n and lower_half_residues(n).contains(y)
        implies upper_half_residues(n).contains(reflect_residue(n, y))
}

theorem upper_reflect_mem_lower(n: Nat, y: Nat) {
    Nat.2 < n and upper_half_residues(n).contains(y)
        implies lower_half_residues(n).contains(reflect_residue(n, y))
}

theorem reflect_pairs_halves(n: Nat) {
    Nat.2 < n implies
        is_permutation(map(lower_half_residues(n), reflect_residue(n)), upper_half_residues(n))
}

theorem upper_half_length_eq_lower_half(n: Nat) {
    Nat.2 < n implies upper_half_residues(n).length = lower_half_residues(n).length
}

theorem totient_even_double(n: Nat) {
    Nat.2 < n implies n.totient = Nat.2 * lower_half_residues(n).length
}

theorem totient_even(n: Nat) {
    Nat.2 < n implies is_even(n.totient)
}

theorem totient_power_of_two_half(k: Nat) {
    Nat.1 <= k implies (Nat.2.pow(k)).totient * Nat.2 = Nat.2.pow(k)
}

theorem totient_two {
    nat_totient(Nat.2) = Nat.1
}

theorem totient_four {
    nat_totient(Nat.4) = Nat.2
}

theorem totient_eight {
    nat_totient(Nat.8) = Nat.4
}

theorem totient_euler_theorem(n: Nat, a: Nat) {
    n != Nat.0 and a.coprime(n) implies a.pow(n.totient).congr_mod(Nat.1, n)
}

theorem totient_euler_theorem_prime(p: Nat, a: Nat) {
    p.is_prime and a.coprime(p) implies a.pow(p - Nat.1).congr_mod(Nat.1, p)
}

theorem totient_even_for_n_gt_two(n: Nat) {
    Nat.2 < n implies is_even(n.totient)
}

theorem totient_even_double_form(n: Nat) {
    Nat.2 < n implies n.totient = Nat.2 * lower_half_residues(n).length
}

theorem totient_product_formula_prime_power(p: Nat, k: Nat) {
    Nat.1 <= k and p.is_prime
        implies (p.pow(k)).totient = p.pow(k - Nat.1) * (p - Nat.1)
}

theorem totient_product_formula_two_primes(p: Nat, q: Nat) {
    p.is_prime and q.is_prime and p != q
        implies (p * q).totient = (p - Nat.1) * (q - Nat.1)
}

theorem totient_counts_coprime_up_to(n: Nat) {
    count_gcd_eq_le(n, Nat.1, n) = n.totient
}

theorem totient_coprime_range_filter_length(n: Nat) {
    n.range.filter(function(x: Nat) { x.coprime(n) }).length = n.totient
}

theorem totient_prime_power_formula(p: Nat, k: Nat) {
    Nat.1 <= k and p.is_prime
        implies (p.pow(k)).totient = p.pow(k) - p.pow(k - Nat.1)
}

define unit_fraction(n: Nat) -> Rat {
    Rat.from_nat(n).inverse
}

define real_unit_fraction(n: Nat) -> Real {
    Real.1 / from_nat[Real](n)
}

define unit_fraction_sum(denominators: List[Nat]) -> Rat {
    sum(map(denominators, unit_fraction))
}

define real_unit_fraction_sum(denominators: List[Nat]) -> Real {
    sum(map(denominators, real_unit_fraction))
}

define positive_denominator_list(denominators: List[Nat]) -> Bool {
    match denominators {
        List.nil {
            true
        }
        List.cons(head, tail) {
            Nat.0 < head and positive_denominator_list(tail)
        }
    }
}

define denominator_list_lower_bound(bound: Nat, denominators: List[Nat]) -> Bool {
    is_lower_bound(denominators, bound)
}

define denominator_list_upper_bound(bound: Nat, denominators: List[Nat]) -> Bool {
    is_upper_bound(denominators, bound)
}

define egyptian_denominator_list(denominators: List[Nat]) -> Bool {
    denominators.is_unique and positive_denominator_list(denominators)
}

define is_egyptian_fraction(q: Rat) -> Bool {
    exists(denominators: List[Nat]) {
        egyptian_denominator_list(denominators) and q = unit_fraction_sum(denominators)
    }
}

define is_egyptian_fraction_with_lower_bound(q: Rat, bound: Nat) -> Bool {
    exists(denominators: List[Nat]) {
        egyptian_denominator_list(denominators) and
        denominator_list_lower_bound(bound, denominators) and
        q = unit_fraction_sum(denominators)
    }
}

define is_lower_bounded_egyptian_fraction(q: Rat, bound: Nat) -> Bool {
    exists(denominators: List[Nat]) {
        egyptian_denominator_list(denominators) and
        denominator_list_lower_bound(bound, denominators) and
        q = unit_fraction_sum(denominators)
    }
}

define unit_fraction_greedy_step(q: Rat, n: Nat) -> Bool {
    Nat.0 < n and unit_fraction(n) < q and q - unit_fraction(n) < q
}

define unit_fraction_bounded_step(q: Rat, n: Nat) -> Bool {
    Nat.0 < n and unit_fraction(n) <= q and
        (q - unit_fraction(n)).is_positive and q - unit_fraction(n) < q
}

define unit_fraction_bounded_denominator(q: Rat, n: Nat) -> Bool {
    Nat.0 < n and unit_fraction(n) <= q
}

define unit_fraction_bounded_denominator_for(q: Rat) -> (Nat -> Bool) {
    function(n: Nat) {
        unit_fraction_bounded_denominator(q, n)
    }
}

define unit_fraction_ceiling_step(q: Rat, n: Nat) -> Bool {
    is_min(unit_fraction_bounded_denominator_for(q), n)
}

define unit_fraction_remainder_raw_num(q: Rat, n: Nat) -> Int {
    q.num * Int.from_nat(n) - q.denom
}

define unit_fraction_remainder_raw_denom(q: Rat, n: Nat) -> Int {
    q.denom * Int.from_nat(n)
}

define unit_fraction_num_measure(q: Rat) -> Nat {
    abs(q.num)
}

define unit_fraction_remainder_raw_num_measure(q: Rat, n: Nat) -> Nat {
    abs(unit_fraction_remainder_raw_num(q, n))
}

define unit_fraction_raw_num_descends(q: Rat, n: Nat) -> Bool {
    unit_fraction_remainder_raw_num(q, n).is_positive and
        unit_fraction_remainder_raw_num(q, n) < q.num
}

theorem unit_fraction_positive(n: Nat) {
    Nat.0 < n implies unit_fraction(n).is_positive
}

theorem unit_fraction_ne_zero(n: Nat) {
    Nat.0 < n implies unit_fraction(n) != Rat.0
}

theorem unit_fraction_eq_one_div(n: Nat) {
    Nat.0 < n implies unit_fraction(n) = Rat.1 / Rat.from_nat(n)
}

theorem unit_fraction_eq_reduce(n: Nat) {
    Nat.0 < n implies unit_fraction(n) = reduce(Int.1, Int.from_nat(n))
}

theorem unit_fraction_one {
    unit_fraction(Nat.1) = Rat.1
}

theorem unit_fraction_zero {
    unit_fraction(Nat.0) = Rat.0
}

theorem unit_fraction_mul_denominator(n: Nat) {
    Nat.0 < n implies unit_fraction(n) * Rat.from_nat(n) = Rat.1
}

theorem unit_fraction_to_real(n: Nat) {
    Nat.0 < n implies Real.from_rat(unit_fraction(n)) = real_unit_fraction(n)
}

theorem unit_fraction_lte_of_lte(m: Nat, n: Nat) {
    Nat.0 < m and m <= n implies unit_fraction(n) <= unit_fraction(m)
}

theorem unit_fraction_pred_lte_double(n: Nat) {
    Nat.1 < n implies unit_fraction(n - Nat.1) <= unit_fraction(n) + unit_fraction(n)
}

theorem unit_fraction_greedy_step_exists(q: Rat) {
    q.is_positive and q < Rat.1 implies exists(n: Nat) {
        unit_fraction_greedy_step(q, n)
    }
}

theorem unit_fraction_bounded_step_exists(q: Rat) {
    q.is_positive and q < Rat.1 implies exists(n: Nat) {
        unit_fraction_bounded_step(q, n)
    }
}

theorem unit_fraction_bounded_step_denominator_positive(q: Rat, n: Nat) {
    unit_fraction_bounded_step(q, n) implies Nat.0 < n
}

theorem unit_fraction_remainder_raw_denom_positive(q: Rat, n: Nat) {
    Nat.0 < n implies unit_fraction_remainder_raw_denom(q, n).is_positive
}

theorem unit_fraction_bounded_denominator_positive(q: Rat, n: Nat) {
    unit_fraction_bounded_denominator(q, n) implies Nat.0 < n
}

theorem unit_fraction_bounded_denominator_lte(q: Rat, n: Nat) {
    unit_fraction_bounded_denominator(q, n) implies unit_fraction(n) <= q
}

theorem unit_fraction_bounded_denominator_raw_num_nonnegative(q: Rat, n: Nat) {
    unit_fraction_bounded_denominator(q, n) implies
        Int.0 <= unit_fraction_remainder_raw_num(q, n)
