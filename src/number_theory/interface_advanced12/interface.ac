theorem unit_fraction_ceiling_step_next_denominator_lower_bound(q: Rat, n: Nat,
    m: Nat) {
    q < Rat.1 and unit_fraction_ceiling_step(q, n) and
        unit_fraction_ceiling_step(q - unit_fraction(n), m)
        implies n.suc <= m
