theorem bf_pure_reassemble(a: Real, b: Real, c: Real, d: Real) {
    a * c * a * c + b * d * b * d + a * d * a * d + b * c * b * c =
        a * a * c * c + a * a * d * d + b * b * c * c + b * b * d * d
