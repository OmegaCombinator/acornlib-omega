define stirling(n: Nat, k: Nat) -> Nat {
    match n {
        Nat.zero {
            match k {
                Nat.zero {
                    Nat.1
                }
                Nat.suc(_) {
                    Nat.0
                }
            }
        }
        Nat.suc(m) {
            match k {
                Nat.zero {
                    Nat.0
                }
                Nat.suc(j) {
                    stirling(m, j) + k * stirling(m, k)
                }
            }
        }
    }
}

theorem stirling_zero_zero {
