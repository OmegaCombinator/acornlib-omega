    polynomial_support_bounded_by(p, n.suc) and b != Int.0 and is_coprime(a, b) and
    polynomial_eval(rationalise(p), Rat.from_int(a) / Rat.from_int(b)) = Rat.0
    implies b.divides(p.coeff(n))
