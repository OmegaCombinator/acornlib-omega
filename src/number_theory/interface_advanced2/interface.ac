theorem order_divides_half_imp_euler_condition(p: Nat, h: Nat, a: Nat) {
    p.is_prime and p = Nat.2 * h + Nat.1 and a.coprime(p)
        and multiplicative_order_mod(a, p).divides(h)
        implies a.pow(h).congr_mod(Nat.1, p)
