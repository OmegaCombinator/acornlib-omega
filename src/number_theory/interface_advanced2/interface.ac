            coprime_residues_below(n, k).contains(x) implies x.coprime(n)
        }
    }
}

theorem cr_all_coprime_pred_apply(n: Nat, k: Nat, x: Nat) {
    cr_all_coprime_pred(n)(k) and coprime_residues_below(n, k).contains(x)
        implies x.coprime(n)
