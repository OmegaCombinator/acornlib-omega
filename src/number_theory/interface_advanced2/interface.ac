theorem cr_all_coprime_step(n: Nat, k: Nat) {
    cr_all_coprime_pred(n)(k) implies cr_all_coprime_pred(n)(k.suc)
}

theorem coprime_residues_below_all_coprime(n: Nat, k: Nat, x: Nat) {
