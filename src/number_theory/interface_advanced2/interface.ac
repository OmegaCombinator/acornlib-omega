theorem cancel_one_chain_left(c: Nat, n: Nat, x: Nat, y: Nat) {
    c.congr_mod(Nat.1, n) and (c * x).congr_mod(c * y, n)
        implies x.congr_mod(c * y, n)
}

theorem cancel_one_chain_right(c: Nat, n: Nat, x: Nat, y: Nat) {
    c.congr_mod(Nat.1, n) and x.congr_mod(c * y, n)
        implies x.congr_mod(y, n)
}

theorem cancel_one_chain(c: Nat, n: Nat, x: Nat, y: Nat) {
    c.congr_mod(Nat.1, n) and (c * x).congr_mod(c * y, n)
        implies x.congr_mod(y, n)
}

theorem cancel_with_inverse_setup(a: Nat, b: Nat, n: Nat, x: Nat, y: Nat) {
    (a * x).congr_mod(a * y, n)
        implies ((b * a) * x).congr_mod((b * a) * y, n)
}

theorem cancel_with_inverse(a: Nat, b: Nat, n: Nat, x: Nat, y: Nat) {
    (b * a).congr_mod(Nat.1, n) and (a * x).congr_mod(a * y, n)
        implies x.congr_mod(y, n)
}

theorem cancel_coprime(a: Nat, n: Nat, x: Nat, y: Nat) {
    a.coprime(n) and (a * x).congr_mod(a * y, n)
        implies x.congr_mod(y, n)
}

theorem inverse_imp_product_coprime(a: Nat, b: Nat, n: Nat) {
    (a * b).congr_mod(Nat.1, n) implies (a * b).coprime(n)
}

theorem product_coprime_imp_right(a: Nat, b: Nat, n: Nat) {
    (a * b).coprime(n) implies b.coprime(n)
}

theorem inverse_imp_coprime(a: Nat, b: Nat, n: Nat) {
    (a * b).congr_mod(Nat.1, n) implies b.coprime(n)
}

theorem mod_inv_coprime(a: Nat, n: Nat) {
    a.coprime(n) implies (mod_inv(a, n)).coprime(n)
}

theorem coprime_mul_right_pair(a: Nat, b: Nat, n: Nat) {
    a.coprime(n) and b.coprime(n) implies (a * b).coprime(n)
}

theorem mod_inv_mul_product_congr_one(a: Nat, b: Nat, n: Nat) {
    a.coprime(n) and b.coprime(n) implies
        (a * b * (mod_inv(b, n) * mod_inv(a, n))).congr_mod(Nat.1, n)
}

theorem mod_inv_mul_congr(a: Nat, b: Nat, n: Nat) {
    a.coprime(n) and b.coprime(n) implies
        mod_inv(a * b, n).congr_mod(mod_inv(b, n) * mod_inv(a, n), n)
}

theorem mod_inv_one_congr(n: Nat) {
    mod_inv(Nat.1, n).congr_mod(Nat.1, n)
}

theorem mod_inv_congr(a: Nat, b: Nat, n: Nat) {
    a.congr_mod(b, n) and a.coprime(n) and b.coprime(n) implies
        mod_inv(a, n).congr_mod(mod_inv(b, n), n)
}

theorem mod_inv_involutive_congr(a: Nat, n: Nat) {
    a.coprime(n) implies mod_inv(mod_inv(a, n), n).congr_mod(a, n)
}

theorem prime_does_not_divide_below(p: Nat, m: Nat) {
    p.is_prime and Nat.0 < m and m < p implies not p.divides(m)
}

theorem prime_not_divides_factorial_step(p: Nat, k: Nat) {
    p.is_prime and not p.divides(k.factorial) and not p.divides(k.suc)
        implies not p.divides(k.suc.factorial)
}

define p_no_div_fact_pred(p: Nat) -> (Nat -> Bool) {
    function(x: Nat) {
        x < p implies not p.divides(x.factorial)
    }
}

theorem prime_no_div_fact_zero(p: Nat) {
    p.is_prime implies p_no_div_fact_pred(p)(Nat.0)
}

theorem prime_no_div_fact_step(p: Nat, k: Nat) {
    p.is_prime and p_no_div_fact_pred(p)(k) implies p_no_div_fact_pred(p)(k.suc)
}

theorem prime_does_not_divide_factorial(p: Nat, m: Nat) {
    p.is_prime and m < p implies not p.divides(m.factorial)
}

theorem prime_divides_mul(p: Nat, a: Nat, b: Nat) {
    p.is_prime and p.divides(a * b) implies p.divides(a) or p.divides(b)
}

theorem prime_divides_self_factorial(p: Nat) {
    p.is_prime implies p.divides(p.factorial)
}

theorem prime_divides_binom(p: Nat, k: Nat) {
    p.is_prime and Nat.0 < k and k < p implies p.divides(p.binom(k))
}

define divides_partial_pred(d: Nat, f: Nat -> Nat) -> (Nat -> Bool) {
    function(m: Nat) {
        (forall(k: Nat) { k < m implies d.divides(f(k)) })
            implies d.divides(partial[Nat](f, m))
    }
}

theorem divides_partial_nat_zero(d: Nat, f: Nat -> Nat) {
    divides_partial_pred(d, f)(Nat.0)
}

theorem divides_partial_nat_step(d: Nat, f: Nat -> Nat, m: Nat) {
    divides_partial_pred(d, f)(m)
        implies divides_partial_pred(d, f)(m.suc)
}

theorem sub_one_pred(p: Nat, pp: Nat) {
    pp.suc = p implies p - Nat.1 = pp
}

theorem suc_sub_two_pred(p: Nat, pp: Nat) {
    pp.suc = p implies p.suc - Nat.2 = pp
}

theorem suc_sub_two_eq_sub_one(p: Nat) {
    Nat.1 < p implies p.suc - Nat.2 = p - Nat.1
}

theorem suc_sub_one_eq(p: Nat) {
    p.suc - Nat.1 = p
}

theorem suc_geq_two(p: Nat) {
    Nat.1 < p implies p.suc >= Nat.2
}

theorem divides_partial_nat(d: Nat, f: Nat -> Nat, n: Nat) {
    (forall(k: Nat) { k < n implies d.divides(f(k)) })
        implies d.divides(partial[Nat](f, n))
}

theorem prime_divides_binomial_term_middle(p: Nat, a: Nat, b: Nat, k: Nat) {
    p.is_prime and Nat.0 < k and k < p
        implies p.divides(binomial_term(a, b, p, k))
}

theorem binomial_term_left_boundary(a: Nat, b: Nat, p: Nat) {
    binomial_term(a, b, p, Nat.0) = b.pow(p)
}

theorem binomial_term_right_boundary(a: Nat, b: Nat, p: Nat) {
    binomial_term(a, b, p, p) = a.pow(p)
}

theorem shifted_binom_term_div(p: Nat, a: Nat, b: Nat, k: Nat) {
    p.is_prime and k < p - Nat.1
        implies p.divides(compose(binomial_term(a, b, p), Nat.suc)(k))
}

theorem prime_divides_binomial_middle(p: Nat, a: Nat, b: Nat) {
    p.is_prime implies
        p.divides(partial[Nat](compose(binomial_term(a, b, p), Nat.suc), p - Nat.1))
}

theorem binomial_pow_split(a: Nat, b: Nat, p: Nat) {
    Nat.1 < p implies
        (a + b).pow(p) =
            b.pow(p) + partial[Nat](compose(binomial_term(a, b, p), Nat.suc), p - Nat.1) + a.pow(p)
}

theorem divides_imp_congr_zero(d: Nat, x: Nat) {
    d.divides(x) implies x.congr_mod(Nat.0, d)
}

theorem freshmans_dream(p: Nat, a: Nat, b: Nat) {
    p.is_prime implies (a + b).pow(p).congr_mod(a.pow(p) + b.pow(p), p)
}

define fermat_pred(p: Nat) -> (Nat -> Bool) {
    function(a: Nat) {
        a.pow(p).congr_mod(a, p)
    }
}

theorem fermat_base(p: Nat) {
    p.is_prime implies fermat_pred(p)(Nat.0)
}

theorem fermat_step(p: Nat, a: Nat) {
    p.is_prime and fermat_pred(p)(a) implies fermat_pred(p)(a.suc)
}

theorem fermat_pred_unfold(p: Nat, a: Nat) {
    fermat_pred(p)(a) = a.pow(p).congr_mod(a, p)
}

theorem fermats_little_run(p: Nat, a: Nat) {
    p.is_prime implies fermat_pred(p)(a)
}

theorem fermats_little_congr(p: Nat, a: Nat) {
    p.is_prime implies a.pow(p).congr_mod(a, p)
}

theorem fermats_little(p: Nat, a: Nat) {
    p.is_prime implies a.pow(p).mod(p) = a.mod(p)
}

theorem mul_pow_pred_eq_pow(m: Nat, p: Nat) {
    p.is_prime implies m * m.pow(p - Nat.1) = m.pow(p)
}

define rsa_pow_pred(m: Nat, p: Nat) -> (Nat -> Bool) {
    function(k: Nat) {
        m.pow(k * (p - Nat.1) + Nat.1).congr_mod(m, p)
    }
}

theorem rsa_pow_base(m: Nat, p: Nat) {
    rsa_pow_pred(m, p)(Nat.0)
}

theorem rsa_pow_step(m: Nat, p: Nat, k: Nat) {
    p.is_prime and rsa_pow_pred(m, p)(k) implies rsa_pow_pred(m, p)(k.suc)
}

theorem rsa_pow_run(p: Nat, m: Nat, k: Nat) {
    p.is_prime implies rsa_pow_pred(m, p)(k)
}

theorem rsa_pow_congr(p: Nat, m: Nat, k: Nat) {
    p.is_prime implies m.pow(k * (p - Nat.1) + Nat.1).congr_mod(m, p)
}

theorem fermat_euler_split(p: Nat, m: Nat) {
    p.is_prime
        implies (m * m.pow(p - Nat.1)).congr_mod(m * Nat.1, p)
}

theorem fermat_euler(p: Nat, m: Nat) {
    p.is_prime and m.coprime(p)
        implies m.pow(p - Nat.1).congr_mod(Nat.1, p)
}

theorem crt_witness_mod_m(m: Nat, a: Int, b: Int, x: Int) {
    Int.from_nat(m).divides(a + (b - a) * x * Int.from_nat(m) - a)
}

theorem crt_witness_mod_n(m: Nat, n: Nat, a: Int, b: Int, x: Int, y: Int) {
    x * Int.from_nat(m) + y * Int.from_nat(n) = Int.1
        implies Int.from_nat(n).divides(a + (b - a) * x * Int.from_nat(m) - b)
}

theorem int_crt_two_moduli(m: Nat, n: Nat, a: Int, b: Int) {
    m.coprime(n) implies exists(c: Int) {
        int_mod_rel(m, c, a) and int_mod_rel(n, c, b)
    }
}

theorem nat_coprime_combine(m: Nat, n: Nat, k: Nat) {
    m.coprime(n) and m.divides(k) and n.divides(k) implies (m * n).divides(k)
}

theorem int_mod_rel_combine_coprime(m: Nat, n: Nat, x: Int, y: Int) {
    m.coprime(n) and int_mod_rel(m, x, y) and int_mod_rel(n, x, y)
        implies int_mod_rel(m * n, x, y)
}

theorem int_crt_unique(m: Nat, n: Nat, c1: Int, c2: Int, a: Int, b: Int) {
    m.coprime(n)
        and int_mod_rel(m, c1, a) and int_mod_rel(n, c1, b)
        and int_mod_rel(m, c2, a) and int_mod_rel(n, c2, b)
        implies int_mod_rel(m * n, c1, c2)
}

theorem int_mod_rel_descend(m: Nat, k: Nat, x: Int, y: Int) {
    m.divides(k) and int_mod_rel(k, x, y) implies int_mod_rel(m, x, y)
}

theorem nat_crt_two_moduli(m: Nat, n: Nat, a: Nat, b: Nat) {
    m.coprime(n) and m != Nat.0 and n != Nat.0 implies
        exists(c: Nat) { c.congr_mod(a, m) and c.congr_mod(b, n) }
}

theorem nat_crt_three_moduli(m: Nat, n: Nat, p: Nat, a: Nat, b: Nat, c: Nat) {
    m.coprime(n) and m.coprime(p) and n.coprime(p)
        and m != Nat.0 and n != Nat.0 and p != Nat.0
        implies exists(x: Nat) {
            x.congr_mod(a, m) and x.congr_mod(b, n) and x.congr_mod(c, p)
        }
}

theorem nat_congr_combine_coprime(m: Nat, n: Nat, a: Nat, b: Nat) {
    m.coprime(n) and a.congr_mod(b, m) and a.congr_mod(b, n)
        implies a.congr_mod(b, m * n)
}

define count_coprime_to(n: Nat, k: Nat) -> Nat {
    match k {
        Nat.zero {
            Nat.0
        }
        Nat.suc(j) {
            if j.coprime(n) {
                count_coprime_to(n, j) + Nat.1
            } else {
                count_coprime_to(n, j)
            }
        }
    }
}

attributes Nat {
    /// Euler's totient: the number of natural numbers in `[0, n)` that are
    /// coprime to `n`. Reduces to `n - 1` for prime `n` and to
    /// `(p - 1) * (q - 1)` for distinct primes `p`, `q`.
    define totient(self) -> Nat {
        count_coprime_to(self, self)
    }
}

let nat_totient: Nat -> Nat = function(n: Nat) { n.totient }

theorem count_coprime_to_suc_yes(n: Nat, k: Nat) {
    k.coprime(n)
        implies count_coprime_to(n, k.suc) = count_coprime_to(n, k) + Nat.1
}

theorem count_coprime_to_suc_no(n: Nat, k: Nat) {
    not k.coprime(n)
        implies count_coprime_to(n, k.suc) = count_coprime_to(n, k)
}

theorem nat_totient_zero {
    nat_totient(Nat.0) = Nat.0
}

theorem nat_totient_one {
    nat_totient(Nat.1) = Nat.1
}

define totient_prime_pred(p: Nat) -> (Nat -> Bool) {
    function(k: Nat) {
        Nat.1 <= k and k <= p implies count_coprime_to(p, k) = k - Nat.1
    }
}

theorem totient_prime_base(p: Nat) {
    p.is_prime implies totient_prime_pred(p)(Nat.1)
}

theorem coprime_below_prime(p: Nat, k: Nat) {
    p.is_prime and Nat.1 <= k and k < p implies k.coprime(p)
}

theorem totient_prime_step(p: Nat, k: Nat) {
    p.is_prime and totient_prime_pred(p)(k) implies totient_prime_pred(p)(k.suc)
}

theorem totient_prime_run(p: Nat, n: Nat) {
    p.is_prime implies totient_prime_pred(p)(n)
}

theorem totient_prime(p: Nat) {
    p.is_prime implies p.totient = p - Nat.1
}

theorem totient_sub_one_pred(n: Nat, pred: Nat) {
    pred.suc = n implies n - Nat.1 = pred
}

define count_multiples(d: Nat, k: Nat) -> Nat {
    match k {
        Nat.zero {
            Nat.0
        }
        Nat.suc(j) {
            if d.divides(j) {
                count_multiples(d, j) + Nat.1
            } else {
                count_multiples(d, j)
            }
        }
    }
}

theorem count_multiples_suc_yes(d: Nat, k: Nat) {
    d.divides(k) implies count_multiples(d, k.suc) = count_multiples(d, k) + Nat.1
}

theorem count_multiples_suc_no(d: Nat, k: Nat) {
    not d.divides(k) implies count_multiples(d, k.suc) = count_multiples(d, k)
}

theorem count_multiples_block_no_div(d: Nat, k: Nat, j: Nat) {
    d != Nat.0 and d.divides(k) and Nat.0 < j and j < d
        implies not d.divides(k + j)
}

define block_aligned_pred(d: Nat, k: Nat) -> (Nat -> Bool) {
    function(j: Nat) {
        j <= d and Nat.0 < j
            implies count_multiples(d, k + j) = count_multiples(d, k) + Nat.1
    }
}

theorem block_aligned_step(d: Nat, k: Nat, j: Nat) {
    d != Nat.0 and d.divides(k) and block_aligned_pred(d, k)(j)
        implies block_aligned_pred(d, k)(j.suc)
}

theorem count_multiples_block_aligned(d: Nat, k: Nat) {
    d != Nat.0 and d.divides(k)
        implies count_multiples(d, k + d) = count_multiples(d, k) + Nat.1
}

define count_multiples_div_pred(d: Nat) -> (Nat -> Bool) {
    function(q: Nat) {
        d != Nat.0 implies count_multiples(d, d * q) = q
    }
}

theorem count_multiples_div(d: Nat, q: Nat) {
    d != Nat.0 implies count_multiples(d, d * q) = q
}

define count_not_coprime_to(n: Nat, k: Nat) -> Nat {
    match k {
        Nat.zero {
            Nat.0
        }
        Nat.suc(j) {
            if j.coprime(n) {
                count_not_coprime_to(n, j)
            } else {
                count_not_coprime_to(n, j) + Nat.1
            }
        }
    }
}

define coprime_partition_pred(n: Nat) -> (Nat -> Bool) {
    function(k: Nat) {
        count_coprime_to(n, k) + count_not_coprime_to(n, k) = k
    }
}

theorem coprime_partition(n: Nat, k: Nat) {
    count_coprime_to(n, k) + count_not_coprime_to(n, k) = k
}

theorem not_coprime_imp_divides_prime(p: Nat, k: Nat) {
    p.is_prime and not k.coprime(p) implies p.divides(k)
}

theorem divides_prime_imp_not_coprime(p: Nat, k: Nat) {
    p.is_prime and p.divides(k) implies not k.coprime(p)
}

theorem not_coprime_iff_divides_prime(p: Nat, k: Nat) {
    p.is_prime implies (not k.coprime(p) = p.divides(k))
}

theorem divides_mul_imp_each(m: Nat, n: Nat, k: Nat) {
    (m * n).divides(k) implies m.divides(k) and n.divides(k)
}

theorem not_coprime_pq_imp_div(p: Nat, q: Nat, k: Nat) {
    p.is_prime and q.is_prime and p != q and not k.coprime(p * q)
        implies p.divides(k) or q.divides(k)
}

theorem div_imp_not_coprime_pq(p: Nat, q: Nat, k: Nat) {
    p.is_prime and q.is_prime and p != q and (p.divides(k) or q.divides(k))
        implies not k.coprime(p * q)
}

theorem count_not_coprime_suc_yes(n: Nat, k: Nat) {
    not k.coprime(n)
        implies count_not_coprime_to(n, k.suc) = count_not_coprime_to(n, k) + Nat.1
}

theorem count_not_coprime_suc_no(n: Nat, k: Nat) {
    k.coprime(n)
        implies count_not_coprime_to(n, k.suc) = count_not_coprime_to(n, k)
}

define ie_pq_pred(p: Nat, q: Nat) -> (Nat -> Bool) {
    function(k: Nat) {
        count_not_coprime_to(p * q, k) + count_multiples(p * q, k) =
            count_multiples(p, k) + count_multiples(q, k)
    }
}

theorem ie_pq_step_both(p: Nat, q: Nat, k: Nat) {
    p.is_prime and q.is_prime and p != q and ie_pq_pred(p, q)(k)
        and p.divides(k) and q.divides(k)
        implies ie_pq_pred(p, q)(k.suc)
}

theorem ie_pq_step_left(p: Nat, q: Nat, k: Nat) {
    p.is_prime and q.is_prime and p != q and ie_pq_pred(p, q)(k)
        and p.divides(k) and not q.divides(k)
        implies ie_pq_pred(p, q)(k.suc)
}

theorem ie_pq_step_right(p: Nat, q: Nat, k: Nat) {
    p.is_prime and q.is_prime and p != q and ie_pq_pred(p, q)(k)
        and not p.divides(k) and q.divides(k)
        implies ie_pq_pred(p, q)(k.suc)
}

theorem ie_pq_step_neither(p: Nat, q: Nat, k: Nat) {
    p.is_prime and q.is_prime and p != q and ie_pq_pred(p, q)(k)
        and not p.divides(k) and not q.divides(k)
        implies ie_pq_pred(p, q)(k.suc)
}

theorem ie_pq_step_p_div(p: Nat, q: Nat, k: Nat) {
    p.is_prime and q.is_prime and p != q and ie_pq_pred(p, q)(k)
        and p.divides(k)
        implies ie_pq_pred(p, q)(k.suc)
}

theorem ie_pq_step_not_p_div(p: Nat, q: Nat, k: Nat) {
    p.is_prime and q.is_prime and p != q and ie_pq_pred(p, q)(k)
        and not p.divides(k)
        implies ie_pq_pred(p, q)(k.suc)
}

theorem ie_pq_step(p: Nat, q: Nat, k: Nat) {
    p.is_prime and q.is_prime and p != q and ie_pq_pred(p, q)(k)
        implies ie_pq_pred(p, q)(k.suc)
}

theorem ie_pq_run(p: Nat, q: Nat, k: Nat) {
    p.is_prime and q.is_prime and p != q implies ie_pq_pred(p, q)(k)
}

theorem count_not_coprime_pq_at_pq(p: Nat, q: Nat) {
    p.is_prime and q.is_prime and p != q
        implies count_not_coprime_to(p * q, p * q) = p + q - Nat.1
}

theorem totient_pq(p: Nat, q: Nat) {
    p.is_prime and q.is_prime and p != q
        implies (p * q).totient = (p - Nat.1) * (q - Nat.1)
}

theorem rsa_pow_congr_pq(p: Nat, q: Nat, m: Nat) {
    p.is_prime and q.is_prime and p != q
        implies m.pow((p - Nat.1) * (q - Nat.1) + Nat.1).congr_mod(m, p * q)
}

theorem rsa_pow_split_one(m: Nat, p: Nat, q: Nat) {
    m.pow((p - Nat.1) * (q - Nat.1) + Nat.1) =
        m * m.pow((p - Nat.1) * (q - Nat.1))
}

theorem rsa_pow_one_rhs(m: Nat, n: Nat, e: Nat) {
    (m * m.pow(e)).congr_mod(m, n)
        implies (m * m.pow(e)).congr_mod(m * Nat.1, n)
}

theorem euler_pq(p: Nat, q: Nat, m: Nat) {
    p.is_prime and q.is_prime and p != q and m.coprime(p * q)
        implies m.pow((p * q).totient).congr_mod(Nat.1, p * q)
}

theorem not_coprime_pp_imp_divides(p: Nat, k: Nat) {
    p.is_prime and not k.coprime(p * p) implies p.divides(k)
}

theorem divides_imp_not_coprime_pp(p: Nat, k: Nat) {
    p.is_prime and p.divides(k) implies not k.coprime(p * p)
}

define pp_count_pred(p: Nat) -> (Nat -> Bool) {
    function(k: Nat) {
        count_not_coprime_to(p * p, k) = count_multiples(p, k)
    }
}

theorem pp_count_step(p: Nat, k: Nat) {
    p.is_prime and pp_count_pred(p)(k)
        implies pp_count_pred(p)(k.suc)
}

theorem pp_count_run(p: Nat, k: Nat) {
    p.is_prime implies pp_count_pred(p)(k)
}

theorem pp_count_eq(p: Nat, k: Nat) {
    p.is_prime
        implies count_not_coprime_to(p * p, k) = count_multiples(p, k)
}

theorem totient_pp(p: Nat) {
    p.is_prime implies (p * p).totient = p * p - p
}

