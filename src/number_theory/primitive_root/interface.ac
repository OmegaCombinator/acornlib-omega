define doubling_signed_representative(h: Nat, x: Nat) -> Nat {
    if Nat.2 * x <= h {
        Nat.2 * x
    } else {
        Nat.2 * h + Nat.1 - Nat.2 * x
    }
}

define doubling_signed_index(h: Nat) -> (Nat -> Nat) {
    function(i: Nat) {
        doubling_signed_representative(h, i.suc) - Nat.1
