define pow_list(p: Nat, k: Nat) -> List[Nat] {
    match k {
        Nat.zero {
            List.cons(Nat.1, List.nil[Nat])
        }
        Nat.suc(j) {
            List.cons(p.pow(k), pow_list(p, j))
        }
    }
}

theorem nat_pow_gte_one(a: Nat, n: Nat) {
