theorem unit_product_quadratic_residue_iff_discrete_log_sum_even(
    p: Nat, h: Nat, g: Nat, a: Nat, b: Nat
) {
    p.is_prime and p = Nat.2 * h + Nat.1
        and is_order_double_unit_generator_mod(g, p, h)
        and a.coprime(p) and b.coprime(p)
        implies (is_unit_quadratic_residue_mod(a * b, p) = Nat.2.divides(
            (discrete_log_mod_with_order(g, p, Nat.2 * h, a) +
                discrete_log_mod_with_order(g, p, Nat.2 * h, b)).mod(Nat.2 * h)))
}

define reflect_residue(n: Nat, a: Nat) -> Nat {
    n - a
}

theorem reflect_residue_involution(n: Nat, a: Nat) {
    a <= n implies reflect_residue(n, reflect_residue(n, a)) = a
}

theorem divides_reflect_residue(n: Nat, a: Nat, d: Nat) {
    d.divides(n) and d.divides(a) implies d.divides(reflect_residue(n, a))
}

theorem divides_of_divides_reflect(n: Nat, a: Nat, d: Nat) {
    a <= n and d.divides(n) and d.divides(reflect_residue(n, a)) implies d.divides(a)
}

theorem reflect_residue_coprime(n: Nat, a: Nat) {
    a <= n and a.coprime(n) implies reflect_residue(n, a).coprime(n)
}

theorem reflect_residue_in_range(n: Nat, a: Nat) {
    Nat.0 < a and a < n implies Nat.0 < reflect_residue(n, a) and reflect_residue(n, a) < n
}

theorem reflect_residue_fixed_point(n: Nat, a: Nat) {
    a <= n and reflect_residue(n, a) = a implies a + a = n
}

theorem reflect_residue_moves(n: Nat, a: Nat) {
    a <= n and a + a != n implies reflect_residue(n, a) != a
}

theorem reflect_residue_le(n: Nat, a: Nat) {
    a <= n implies reflect_residue(n, a) <= n
}

theorem reflect_permutes_coprime_residues(n: Nat) {
    Nat.1 < n implies
        is_permutation(coprime_residues(n), map(coprime_residues(n), reflect_residue(n)))
}

theorem reflect_residue_adds_to_modulus(n: Nat, a: Nat) {
    a <= n implies a + reflect_residue(n, a) = n
}



define count_gcd_eq(n: Nat, d: Nat, k: Nat) -> Nat {
    match k {
        Nat.zero {
            Nat.0
        }
        Nat.suc(j) {
            if j.gcd(n) = d {
                count_gcd_eq(n, d, j) + Nat.1
            } else {
                count_gcd_eq(n, d, j)
            }
        }
    }
}

theorem count_gcd_eq_suc_yes(n: Nat, d: Nat, k: Nat) {
    k.gcd(n) = d implies count_gcd_eq(n, d, k.suc) = count_gcd_eq(n, d, k) + Nat.1
}

theorem count_gcd_eq_suc_no(n: Nat, d: Nat, k: Nat) {
    not (k.gcd(n) = d) implies count_gcd_eq(n, d, k.suc) = count_gcd_eq(n, d, k)
}

define count_gcd_eq_le(n: Nat, d: Nat, k: Nat) -> Nat {
    match k {
        Nat.zero {
            Nat.0
        }
        Nat.suc(j) {
            if k.gcd(n) = d {
                count_gcd_eq_le(n, d, j) + Nat.1
            } else {
                count_gcd_eq_le(n, d, j)
            }
        }
    }
}

theorem count_gcd_eq_le_suc_yes(n: Nat, d: Nat, k: Nat) {
    k.suc.gcd(n) = d implies count_gcd_eq_le(n, d, k.suc) = count_gcd_eq_le(n, d, k) + Nat.1
}

theorem count_gcd_eq_le_suc_no(n: Nat, d: Nat, k: Nat) {
    not (k.suc.gcd(n) = d) implies count_gcd_eq_le(n, d, k.suc) = count_gcd_eq_le(n, d, k)
}

theorem gcd_self_local(a: Nat) {
    a.gcd(a) = a
}

theorem totient_prime_power(p: Nat, k: Nat) {
    Nat.1 <= k and p.is_prime implies (p.pow(k)).totient = p.pow(k) - p.pow(k - Nat.1)
}

define nat_indicator_eq(a: Nat, b: Nat) -> Nat {
    if a = b { Nat.1 } else { Nat.0 }
}

theorem nat_indicator_eq_yes(a: Nat) {
    nat_indicator_eq(a, a) = Nat.1
}

theorem nat_indicator_eq_symm(a: Nat, b: Nat) {
    nat_indicator_eq(a, b) = nat_indicator_eq(b, a)
}

theorem gcd_eq_imp_divides(x: Nat, n: Nat, d: Nat) {
    x.gcd(n) = d implies d.divides(x)
}

theorem gcd_mul_coprime_iff(n: Nat, d: Nat, y: Nat) {
    d != Nat.0 and d.divides(n)
        implies (y.coprime(divisor_quotient(n, d)) = ((d * y).gcd(n) = d))
}

theorem gcd_eq_block_mid_no(n: Nat, d: Nat, k: Nat, j: Nat) {
    d != Nat.0 and Nat.0 < j and j < d
        implies not ((d * k + j).gcd(n) = d)
}

define gcd_eq_block_pred(n: Nat, d: Nat, k: Nat, q: Nat) -> (Nat -> Bool) {
    function(j: Nat) {
        k.coprime(q) and j <= d and Nat.0 < j
            implies count_gcd_eq(n, d, d * k + j) = count_gcd_eq(n, d, d * k) + Nat.1
    }
}

theorem gcd_eq_block_step(n: Nat, d: Nat, k: Nat, q: Nat, j: Nat) {
    d != Nat.0 and d.divides(n) and divisor_quotient(n, d) = q
        and gcd_eq_block_pred(n, d, k, q)(j)
        implies gcd_eq_block_pred(n, d, k, q)(j.suc)
}

theorem gcd_eq_block(n: Nat, d: Nat, k: Nat, q: Nat) {
    d != Nat.0 and d.divides(n) and divisor_quotient(n, d) = q and k.coprime(q)
        implies count_gcd_eq(n, d, d * k + d) = count_gcd_eq(n, d, d * k) + Nat.1
}

define gcd_eq_block_no_pred(n: Nat, d: Nat, k: Nat, q: Nat) -> (Nat -> Bool) {
    function(j: Nat) {
        j <= d and Nat.0 < j
            implies count_gcd_eq(n, d, d * k + j) = count_gcd_eq(n, d, d * k)
    }
}

theorem gcd_eq_block_no_step(n: Nat, d: Nat, k: Nat, q: Nat, j: Nat) {
    d != Nat.0 and d.divides(n) and divisor_quotient(n, d) = q
        and not k.coprime(q) and gcd_eq_block_no_pred(n, d, k, q)(j)
        implies gcd_eq_block_no_pred(n, d, k, q)(j.suc)
}

theorem gcd_eq_block_no(n: Nat, d: Nat, k: Nat, q: Nat) {
    d != Nat.0 and d.divides(n) and divisor_quotient(n, d) = q and not k.coprime(q)
        implies count_gcd_eq(n, d, d * k + d) = count_gcd_eq(n, d, d * k)
}

define gcd_eq_quotient_pred(n: Nat, d: Nat) -> (Nat -> Bool) {
    function(k: Nat) {
        d * k <= n implies count_gcd_eq(n, d, d * k) = count_coprime_to(divisor_quotient(n, d), k)
    }
}

theorem gcd_eq_quotient_step(n: Nat, d: Nat, k: Nat) {
    d != Nat.0 and d.divides(n) and gcd_eq_quotient_pred(n, d)(k)
        implies gcd_eq_quotient_pred(n, d)(k.suc)
}

theorem gcd_eq_quotient_count(n: Nat, d: Nat, k: Nat) {
    d != Nat.0 and d.divides(n) implies gcd_eq_quotient_pred(n, d)(k)
}

theorem count_gcd_eq_totient_quotient(n: Nat, d: Nat) {
    Nat.0 < n and d.divides(n)
        implies count_gcd_eq(n, d, n) = (divisor_quotient(n, d)).totient
}

theorem count_gcd_eq_le_beyond(n: Nat, d: Nat, k: Nat) {
    k < d implies count_gcd_eq_le(n, d, k) = Nat.0
}

theorem count_gcd_eq_le_suc_step(n: Nat, d: Nat, k: Nat) {
    count_gcd_eq_le(n, d, k.suc) =
        count_gcd_eq_le(n, d, k) + nat_indicator_eq(k.suc.gcd(n), d)
}

define ind_eq_fn(g: Nat) -> (Nat -> Nat) {
    function(x: Nat) { nat_indicator_eq(x, g) }
}

theorem count_gcd_eq_suc_step(n: Nat, d: Nat, k: Nat) {
    count_gcd_eq(n, d, k.suc) = count_gcd_eq(n, d, k) + nat_indicator_eq(k.gcd(n), d)
}

theorem sum_nat_indicator_eq_count(l: List[Nat], g: Nat) {
    sum(map(l, ind_eq_fn(g))) = l.count(g)
}

theorem gcd_self_divisor(k: Nat, n: Nat) {
    k.divides(n) implies k.gcd(n) = k
}

theorem divisors_up_to_not_contains_gt(n: Nat, k: Nat, x: Nat) {
    k < x implies not divisors_up_to(n, k).contains(x)
}

theorem count_gcd_eq_le_self_divisor(n: Nat, k: Nat) {
    k.suc.divides(n) implies count_gcd_eq_le(n, k.suc, k.suc) = Nat.1
}

theorem gcd_count_shift(n: Nat, d: Nat, k: Nat) {
    count_gcd_eq_le(n, d, k) + nat_indicator_eq(n, d) =
        count_gcd_eq(n, d, k) + nat_indicator_eq(k.gcd(n), d)
}

theorem count_gcd_eq_le_eq_to(n: Nat, d: Nat) {
    count_gcd_eq_le(n, d, n) = count_gcd_eq(n, d, n)
}

define count_le_fn(n: Nat, k: Nat) -> (Nat -> Nat) {
    function(d: Nat) { count_gcd_eq_le(n, d, k) }
}

define gcd_le_ind_fn(n: Nat, k: Nat) -> (Nat -> Nat) {
    function(d: Nat) { nat_indicator_eq(k.suc.gcd(n), d) }
}

theorem partition_tail_suc_sum(n: Nat, k: Nat, l: List[Nat]) {
    sum(map(l, count_le_fn(n, k.suc))) =
        sum(map(l, count_le_fn(n, k))) + l.count(k.suc.gcd(n))
}

define gcd_partition_pred(n: Nat) -> (Nat -> Bool) {
    function(k: Nat) {
        sum(map(divisors_up_to(n, k), count_le_fn(n, k))) = k
    }
}

theorem lt_suc_imp_lte(a: Nat, b: Nat) {
    a < b.suc implies a <= b
}

theorem gcd_partition_step(n: Nat, k: Nat) {
    Nat.0 < n and gcd_partition_pred(n)(k) implies gcd_partition_pred(n)(k.suc)
}

theorem gcd_partition_run(n: Nat, k: Nat) {
    Nat.0 < n implies gcd_partition_pred(n)(k)
}

theorem gcd_partition(n: Nat) {
    Nat.0 < n implies
        sum(map(divisor_list(n), count_le_fn(n, n))) = n
}

define divisor_quotient_fn(n: Nat) -> (Nat -> Nat) {
    function(d: Nat) { divisor_quotient(n, d) }
}

theorem divisor_quotient_map_permutation(n: Nat) {
    Nat.0 < n implies
        is_permutation(map(divisor_list(n), divisor_quotient_fn(n)), divisor_list(n))
}

theorem divisor_quotient_reindex(f: Nat -> Nat, n: Nat) {
    Nat.0 < n implies
        sum(map(divisor_list(n), function(d: Nat) { f(divisor_quotient(n, d)) })) =
        sum(map(divisor_list(n), f))
}

theorem totient_divisor_sum_identity(n: Nat) {
    divisor_sum_fn(nat_totient)(n) = n
}

theorem nat_sigma_divisor_sum_identity(n: Nat) {
    nat_sigma(n) = divisor_sum_fn(nat_identity_arithmetic_fn)(n)
}

theorem nat_sigma_divisor_sum_cofactor(n: Nat) {
    Nat.0 < n implies
        divisor_sum_fn(function(d: Nat) { nat_sigma(divisor_quotient(n, d)) })(n) =
            divisor_sum_fn(nat_sigma)(n)
}

theorem nat_sigma_divisor_sum_id_convolve_tau_term(n: Nat) {
    divisor_sum_fn(nat_sigma)(n) =
        sum(map(divisor_list(n), function(d: Nat) {
            d * nat_tau(divisor_quotient(n, d))
        }))
}

theorem nat_mobius_divisor_sum_unit_form(n: Nat) {
    sum(map(divisor_list(n), nat_mobius)) = Int.from_nat(nat_dirichlet_unit_fn(n))
}

theorem nat_totient_divisor_sum_identity(n: Nat) {
    divisor_sum_fn(nat_totient)(n) = n
}

theorem nat_totient_divisor_sum_cofactor(n: Nat) {
    Nat.0 < n implies
        divisor_sum_fn(function(d: Nat) { nat_totient(divisor_quotient(n, d)) })(n) = n
}

define unit_fraction(n: Nat) -> Rat {
    Rat.from_nat(n).inverse
}

define real_unit_fraction(n: Nat) -> Real {
    Real.1 / from_nat[Real](n)
}

define unit_fraction_sum(denominators: List[Nat]) -> Rat {
    sum(map(denominators, unit_fraction))
}

define real_unit_fraction_sum(denominators: List[Nat]) -> Real {
    sum(map(denominators, real_unit_fraction))
}

define positive_denominator_list(denominators: List[Nat]) -> Bool {
    match denominators {
        List.nil {
            true
        }
        List.cons(head, tail) {
            Nat.0 < head and positive_denominator_list(tail)
        }
    }
}

define denominator_list_lower_bound(bound: Nat, denominators: List[Nat]) -> Bool {
    list_lower_bound(denominators, bound)
}

define denominator_list_upper_bound(bound: Nat, denominators: List[Nat]) -> Bool {
    list_upper_bound(denominators, bound)
}

define egyptian_denominator_list(denominators: List[Nat]) -> Bool {
    denominators.is_unique and positive_denominator_list(denominators)
}

define is_egyptian_fraction(q: Rat) -> Bool {
    exists(denominators: List[Nat]) {
        egyptian_denominator_list(denominators) and q = unit_fraction_sum(denominators)
    }
}

define is_egyptian_fraction_with_lower_bound(q: Rat, bound: Nat) -> Bool {
    exists(denominators: List[Nat]) {
        egyptian_denominator_list(denominators) and
        denominator_list_lower_bound(bound, denominators) and
        q = unit_fraction_sum(denominators)
    }
}

define is_lower_bounded_egyptian_fraction(q: Rat, bound: Nat) -> Bool {
    exists(denominators: List[Nat]) {
        egyptian_denominator_list(denominators) and
        denominator_list_lower_bound(bound, denominators) and
        q = unit_fraction_sum(denominators)
    }
}

define unit_fraction_greedy_step(q: Rat, n: Nat) -> Bool {
    Nat.0 < n and unit_fraction(n) < q and q - unit_fraction(n) < q
}

define unit_fraction_bounded_step(q: Rat, n: Nat) -> Bool {
    Nat.0 < n and unit_fraction(n) <= q and
        (q - unit_fraction(n)).is_positive and q - unit_fraction(n) < q
}

define unit_fraction_bounded_denominator(q: Rat, n: Nat) -> Bool {
    Nat.0 < n and unit_fraction(n) <= q
}

define unit_fraction_bounded_denominator_for(q: Rat) -> (Nat -> Bool) {
    function(n: Nat) {
        unit_fraction_bounded_denominator(q, n)
    }
}

define unit_fraction_ceiling_step(q: Rat, n: Nat) -> Bool {
    is_min(unit_fraction_bounded_denominator_for(q), n)
}

define unit_fraction_remainder_raw_num(q: Rat, n: Nat) -> Int {
    q.num * Int.from_nat(n) - q.denom
}

define unit_fraction_remainder_raw_denom(q: Rat, n: Nat) -> Int {
    q.denom * Int.from_nat(n)
}

define unit_fraction_num_measure(q: Rat) -> Nat {
    abs(q.num)
}

define unit_fraction_remainder_raw_num_measure(q: Rat, n: Nat) -> Nat {
    abs(unit_fraction_remainder_raw_num(q, n))
}

define unit_fraction_raw_num_descends(q: Rat, n: Nat) -> Bool {
    unit_fraction_remainder_raw_num(q, n).is_positive and
        unit_fraction_remainder_raw_num(q, n) < q.num
}

theorem unit_fraction_positive(n: Nat) {
    Nat.0 < n implies unit_fraction(n).is_positive
}

theorem unit_fraction_ne_zero(n: Nat) {
    Nat.0 < n implies unit_fraction(n) != Rat.0
}

theorem unit_fraction_eq_one_div(n: Nat) {
    Nat.0 < n implies unit_fraction(n) = Rat.1 / Rat.from_nat(n)
}

theorem unit_fraction_eq_reduce(n: Nat) {
    Nat.0 < n implies unit_fraction(n) = reduce(Int.1, Int.from_nat(n))
}

theorem unit_fraction_one {
    unit_fraction(Nat.1) = Rat.1
}

theorem unit_fraction_zero {
    unit_fraction(Nat.0) = Rat.0
}

theorem unit_fraction_mul_denominator(n: Nat) {
    Nat.0 < n implies unit_fraction(n) * Rat.from_nat(n) = Rat.1
}

theorem unit_fraction_to_real(n: Nat) {
    Nat.0 < n implies Real.from_rat(unit_fraction(n)) = real_unit_fraction(n)
}

theorem unit_fraction_lte_of_lte(m: Nat, n: Nat) {
    Nat.0 < m and m <= n implies unit_fraction(n) <= unit_fraction(m)
}

theorem unit_fraction_pred_lte_double(n: Nat) {
    Nat.1 < n implies unit_fraction(n - Nat.1) <= unit_fraction(n) + unit_fraction(n)
}

theorem unit_fraction_greedy_step_exists(q: Rat) {
    q.is_positive and q < Rat.1 implies exists(n: Nat) {
        unit_fraction_greedy_step(q, n)
    }
}

theorem unit_fraction_bounded_step_exists(q: Rat) {
    q.is_positive and q < Rat.1 implies exists(n: Nat) {
        unit_fraction_bounded_step(q, n)
    }
}

theorem unit_fraction_bounded_step_denominator_positive(q: Rat, n: Nat) {
    unit_fraction_bounded_step(q, n) implies Nat.0 < n
}

theorem unit_fraction_remainder_raw_denom_positive(q: Rat, n: Nat) {
    Nat.0 < n implies unit_fraction_remainder_raw_denom(q, n).is_positive
}

theorem unit_fraction_bounded_denominator_positive(q: Rat, n: Nat) {
    unit_fraction_bounded_denominator(q, n) implies Nat.0 < n
}

theorem unit_fraction_bounded_denominator_lte(q: Rat, n: Nat) {
    unit_fraction_bounded_denominator(q, n) implies unit_fraction(n) <= q
}

theorem unit_fraction_bounded_denominator_raw_num_nonnegative(q: Rat, n: Nat) {
    unit_fraction_bounded_denominator(q, n) implies
        Int.0 <= unit_fraction_remainder_raw_num(q, n)
}

theorem unit_fraction_remainder_eq_raw(q: Rat, n: Nat) {
    Nat.0 < n implies
        q - unit_fraction(n) =
            reduce(unit_fraction_remainder_raw_num(q, n),
                unit_fraction_remainder_raw_denom(q, n))
}

theorem unit_fraction_bounded_denominator_exists(q: Rat) {
    q.is_positive implies exists(n: Nat) {
        unit_fraction_bounded_denominator(q, n)
    }
}

theorem unit_fraction_ceiling_step_exists(q: Rat) {
    q.is_positive implies exists(n: Nat) {
        unit_fraction_ceiling_step(q, n)
    }
}

theorem unit_fraction_ceiling_step_bounded_denominator(q: Rat, n: Nat) {
    unit_fraction_ceiling_step(q, n) implies
        unit_fraction_bounded_denominator(q, n)
}

theorem unit_fraction_ceiling_step_denominator_positive(q: Rat, n: Nat) {
    unit_fraction_ceiling_step(q, n) implies Nat.0 < n
}

theorem unit_fraction_ceiling_step_lte(q: Rat, n: Nat) {
    unit_fraction_ceiling_step(q, n) implies unit_fraction(n) <= q
}

theorem unit_fraction_ceiling_step_minimal(q: Rat, n: Nat, m: Nat) {
    unit_fraction_ceiling_step(q, n) and unit_fraction_bounded_denominator(q, m)
        implies n <= m
}

theorem unit_fraction_ceiling_step_terminal_or_bounded(q: Rat, n: Nat) {
    unit_fraction_ceiling_step(q, n) implies
        q = unit_fraction(n) or unit_fraction_bounded_step(q, n)
}

theorem unit_fraction_ceiling_step_pred_lt(q: Rat, n: Nat) {
    unit_fraction_ceiling_step(q, n) and Nat.1 < n
        implies q < unit_fraction(n - Nat.1)
}

theorem unit_fraction_ceiling_step_gt_one_of_lt_one(q: Rat, n: Nat) {
    q < Rat.1 and unit_fraction_ceiling_step(q, n) implies Nat.1 < n
}

theorem unit_fraction_ceiling_step_raw_num_lt_num(q: Rat, n: Nat) {
    q < Rat.1 and unit_fraction_ceiling_step(q, n)
        implies unit_fraction_remainder_raw_num(q, n) < q.num
}

theorem unit_fraction_ceiling_step_positive_remainder_num_lt_num(q: Rat, n: Nat) {
    q < Rat.1 and unit_fraction_ceiling_step(q, n) and
        (q - unit_fraction(n)).is_positive
        implies (q - unit_fraction(n)).num < q.num
}

theorem unit_fraction_ceiling_step_remainder_num_lt_num(q: Rat, n: Nat) {
    q < Rat.1 and unit_fraction_ceiling_step(q, n) and q != unit_fraction(n)
        implies (q - unit_fraction(n)).num < q.num
}

theorem unit_fraction_ceiling_step_remainder_positive(q: Rat, n: Nat) {
    unit_fraction_ceiling_step(q, n) and q != unit_fraction(n)
        implies (q - unit_fraction(n)).is_positive
}

theorem unit_fraction_ceiling_step_remainder_lt_self(q: Rat, n: Nat) {
    unit_fraction_ceiling_step(q, n) and q != unit_fraction(n)
        implies q - unit_fraction(n) < q
}

theorem unit_fraction_ceiling_step_remainder_lt_one(q: Rat, n: Nat) {
    q < Rat.1 and unit_fraction_ceiling_step(q, n) and q != unit_fraction(n)
        implies q - unit_fraction(n) < Rat.1
}

theorem unit_fraction_ceiling_step_remainder_lt_unit(q: Rat, n: Nat) {
    q < Rat.1 and unit_fraction_ceiling_step(q, n)
        implies q - unit_fraction(n) < unit_fraction(n)
}

theorem unit_fraction_ceiling_step_next_denominator_gt(q: Rat, n: Nat, m: Nat) {
    q < Rat.1 and unit_fraction_ceiling_step(q, n) and
        unit_fraction_ceiling_step(q - unit_fraction(n), m)
        implies n < m
}

theorem unit_fraction_ceiling_step_next_denominator_lower_bound(q: Rat, n: Nat,
    m: Nat) {
    q < Rat.1 and unit_fraction_ceiling_step(q, n) and
        unit_fraction_ceiling_step(q - unit_fraction(n), m)
        implies n.suc <= m
}

theorem unit_fraction_remainder_zero_of_raw_num_zero(q: Rat, n: Nat) {
    Nat.0 < n and unit_fraction_remainder_raw_num(q, n) = Int.0 implies
        q - unit_fraction(n) = Rat.0
}

theorem unit_fraction_bounded_step_raw_num_positive(q: Rat, n: Nat) {
    unit_fraction_bounded_step(q, n) implies
        unit_fraction_remainder_raw_num(q, n).is_positive
}

theorem unit_fraction_ceiling_step_raw_num_descends(q: Rat, n: Nat) {
    q.is_positive and q < Rat.1 and unit_fraction_ceiling_step(q, n) and
        unit_fraction_bounded_step(q, n)
        implies unit_fraction_raw_num_descends(q, n)
