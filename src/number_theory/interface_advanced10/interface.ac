}

theorem irrationality_deep_six_square_double_square(q: Nat) {
    Nat.6 * ((Nat.2 * q * q) * (Nat.2 * q * q)) = Nat.24 * q * q * q * q
}

theorem irrationality_deep_sqrt_two_add_sqrt_three_irrational(p: Nat, q: Nat) {
