theorem primitive_root_powers_distinct_mod(p: Nat, g: Nat, i: Nat, j: Nat) {
    p.is_prime and g.coprime(p) and multiplicative_order_mod(g, p) = p - Nat.1
        and i < p - Nat.1 and j < p - Nat.1 and g.pow(i).congr_mod(g.pow(j), p)
        implies i = j
}

