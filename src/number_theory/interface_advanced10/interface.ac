theorem nat_alternating_sign_odd_neg_one(k: Nat) {
    not (Nat.2.divides(k)) implies alternating_sign[Int](k) = -Int.1
}

theorem nat_alternating_sign_even_one(k: Nat) {
    Nat.2.divides(k) implies alternating_sign[Int](k) = Int.1
