define happy_iter(p: Nat, n: Nat, k: Nat) -> Nat {
    match k {
        Nat.zero {
            n
        }
        Nat.suc(m) {
            happy_iter(p, happy_sum(p, n), m)
        }
    }
}

define is_happy(p: Nat, n: Nat) -> Bool {
    exists(k: Nat) {
        happy_iter(p, n, k) = Nat.1
    }
}

