theorem euler_criterion_quadratic_residue_forward(p: Nat, h: Nat, a: Nat) {
    p.is_prime and p = Nat.2 * h + Nat.1 and is_quadratic_residue_mod(a, p)
        and not a.congr_mod(Nat.0, p)
        implies a.pow(h).congr_mod(Nat.1, p)
