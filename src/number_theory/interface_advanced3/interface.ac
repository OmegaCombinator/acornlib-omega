theorem prime_nonfixed_inv_not_one_or_pred(p: Nat, x: Nat) {
    p.is_prime and coprime_residues(p).contains(x) and x != Nat.1 and x != p - Nat.1
        implies inv_mod_fn(p)(x) != Nat.1 and inv_mod_fn(p)(x) != p - Nat.1
