theorem wilson_remove_pair_inv_closed(p: Nat, head: Nat, tail: List[Nat]) {
    p.is_prime and wilson_pairable_list(p, List.cons(head, tail))
        implies wilson_items_inv_closed(p, tail.remove_one(inv_mod_fn(p)(head)))
