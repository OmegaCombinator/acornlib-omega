theorem legendre_symbol_neg_one_case_iff_nonzero_nonresidue(a: Nat, p: Nat) {
    legendre_symbol_neg_one_case(a, p) =
        (not a.congr_mod(Nat.0, p) and is_quadratic_nonresidue_mod(a, p))
