theorem wilson_remove_pair_residues(p: Nat, head: Nat, tail: List[Nat]) {
    wilson_pairable_list(p, List.cons(head, tail))
        implies wilson_items_are_residues(p, tail.remove_one(inv_mod_fn(p)(head)))
