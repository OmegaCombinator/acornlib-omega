theorem wilson_remove_pair_nonfixed(p: Nat, head: Nat, tail: List[Nat]) {
    wilson_pairable_list(p, List.cons(head, tail))
        implies wilson_items_nonfixed(p, tail.remove_one(inv_mod_fn(p)(head)))
