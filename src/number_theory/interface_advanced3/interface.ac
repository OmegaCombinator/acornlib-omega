theorem wilson_pairable_remove_inverse_pair(p: Nat, head: Nat, tail: List[Nat]) {
    p.is_prime and wilson_pairable_list(p, List.cons(head, tail))
        implies wilson_pairable_list(p, tail.remove_one(inv_mod_fn(p)(head)))
