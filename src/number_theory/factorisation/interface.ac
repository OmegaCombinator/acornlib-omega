theorem dirichlet_convolve_comm_positive(f: Nat -> Nat, g: Nat -> Nat, n: Nat) {
    Nat.0 < n implies dirichlet_convolve(f, g)(n) = dirichlet_convolve(g, f)(n)
}

theorem dirichlet_convolve_comm(f: Nat -> Nat, g: Nat -> Nat) {
    dirichlet_convolve(f, g) = dirichlet_convolve(g, f)
}

theorem sum_cons_nat(head: Nat, tail: List[Nat]) {
    sum(List.cons(head, tail)) = head + sum(tail)
}

theorem divisor_pair_product_divides(n: Nat, d: Nat, e: Nat) {
    d.divides(n) and e.divides(divisor_quotient(n, d)) implies (d * e).divides(n)
}

theorem divisor_quotient_pair_reassoc(n: Nat, d: Nat, e: Nat) {
    Nat.0 < n and d.divides(n) and e.divides(divisor_quotient(n, d)) implies
        divisor_quotient(n, d * e) = divisor_quotient(divisor_quotient(n, d), e)
}

theorem divisor_pair_product_in_divisor_list(n: Nat, d: Nat, e: Nat) {
    Nat.0 < n and divisor_list(n).contains(d) and
        divisor_list(divisor_quotient(n, d)).contains(e)
        implies divisor_list(n).contains(d * e)
}

define right_divisor_pair_block(n: Nat, d: Nat) -> List[Pair[Nat, Nat]] {
    map(divisor_list(divisor_quotient(n, d)), function(e: Nat) {
        Pair.new(d, e)
    })
}

define right_divisor_pair_list_from(n: Nat, outer: List[Nat]) -> List[Pair[Nat, Nat]] {
    match outer {
        List.nil {
            List.nil[Pair[Nat, Nat]]
        }
        List.cons(d, tail) {
            right_divisor_pair_block(n, d) + right_divisor_pair_list_from(n, tail)
        }
    }
}

define right_divisor_pair_list(n: Nat) -> List[Pair[Nat, Nat]] {
    right_divisor_pair_list_from(n, divisor_list(n))
}

define divisor_pair_assoc_term(f: Nat -> Nat, g: Nat -> Nat, h: Nat -> Nat, n: Nat) ->
        (Pair[Nat, Nat] -> Nat) {
    function(p: Pair[Nat, Nat]) {
        f(p.first) * g(p.second) * h(divisor_quotient(n, p.first * p.second))
    }
}

theorem right_divisor_pair_block_contains(n: Nat, d: Nat, e: Nat) {
    divisor_list(divisor_quotient(n, d)).contains(e)
        implies right_divisor_pair_block(n, d).contains(Pair.new(d, e))
}

theorem right_divisor_pair_block_contains_implies(n: Nat, d: Nat, p: Pair[Nat, Nat]) {
    right_divisor_pair_block(n, d).contains(p) implies
        p.first = d and divisor_list(divisor_quotient(n, d)).contains(p.second)
}

theorem right_divisor_pair_block_contains_iff(n: Nat, d: Nat, p: Pair[Nat, Nat]) {
    right_divisor_pair_block(n, d).contains(p) =
        (p.first = d and divisor_list(divisor_quotient(n, d)).contains(p.second))
}

theorem right_divisor_pair_list_from_contains_head(n: Nat, head: Nat, tail: List[Nat],
        e: Nat) {
    divisor_list(divisor_quotient(n, head)).contains(e) implies
        right_divisor_pair_list_from(n, List.cons(head, tail)).contains(Pair.new(head, e))
}

theorem right_divisor_pair_list_from_contains_tail(n: Nat, head: Nat, tail: List[Nat],
        p: Pair[Nat, Nat]) {
    right_divisor_pair_list_from(n, tail).contains(p) implies
        right_divisor_pair_list_from(n, List.cons(head, tail)).contains(p)
}

theorem right_divisor_pair_list_from_head_contains_implies(n: Nat, head: Nat,
        tail: List[Nat], p: Pair[Nat, Nat]) {
    right_divisor_pair_block(n, head).contains(p) implies
        List.cons(head, tail).contains(p.first) and
            divisor_list(divisor_quotient(n, p.first)).contains(p.second)
}

theorem right_divisor_pair_list_from_divisors_up_to_contains(n: Nat, k: Nat,
        d: Nat, e: Nat) {
    divisors_up_to(n, k).contains(d) and
        divisor_list(divisor_quotient(n, d)).contains(e) implies
        right_divisor_pair_list_from(n, divisors_up_to(n, k)).contains(Pair.new(d, e))
}

theorem right_divisor_pair_list_contains(n: Nat, d: Nat, e: Nat) {
    divisor_list(n).contains(d) and divisor_list(divisor_quotient(n, d)).contains(e)
        implies right_divisor_pair_list(n).contains(Pair.new(d, e))
}

theorem right_divisor_pair_list_from_divisors_up_to_contains_implies(n: Nat, k: Nat,
        p: Pair[Nat, Nat]) {
    right_divisor_pair_list_from(n, divisors_up_to(n, k)).contains(p) implies
        divisors_up_to(n, k).contains(p.first) and
            divisor_list(divisor_quotient(n, p.first)).contains(p.second)
}

theorem right_divisor_pair_list_contains_implies(n: Nat, p: Pair[Nat, Nat]) {
    right_divisor_pair_list(n).contains(p) implies
        divisor_list(n).contains(p.first) and
            divisor_list(divisor_quotient(n, p.first)).contains(p.second)
}

theorem right_divisor_pair_list_contains_iff(n: Nat, d: Nat, e: Nat) {
    right_divisor_pair_list(n).contains(Pair.new(d, e)) =
        (divisor_list(n).contains(d) and divisor_list(divisor_quotient(n, d)).contains(e))
}

define right_divisor_pair_block_from(n: Nat, d: Nat, inner: List[Nat]) -> List[Pair[Nat, Nat]] {
    map(inner, function(e: Nat) {
        Pair.new(d, e)
    })
}

define right_nested_inner_term(f: Nat -> Nat, g: Nat -> Nat, h: Nat -> Nat, n: Nat,
        d: Nat) -> (Nat -> Nat) {
    function(e: Nat) {
        f(d) * dirichlet_term(g, h, divisor_quotient(n, d))(e)
    }
}

theorem right_divisor_pair_block_eq_from(n: Nat, d: Nat) {
    right_divisor_pair_block(n, d) =
        right_divisor_pair_block_from(n, d, divisor_list(divisor_quotient(n, d)))
}

theorem right_nested_inner_term_eq_pair_assoc_term(f: Nat -> Nat, g: Nat -> Nat,
        h: Nat -> Nat, n: Nat, d: Nat, e: Nat) {
    Nat.0 < n and d.divides(n) and e.divides(divisor_quotient(n, d)) implies
        right_nested_inner_term(f, g, h, n, d)(e) =
            divisor_pair_assoc_term(f, g, h, n)(Pair.new(d, e))
}

theorem right_nested_inner_head_term_eq_pair_assoc_term(f: Nat -> Nat, g: Nat -> Nat,
        h: Nat -> Nat, n: Nat, d: Nat, e: Nat) {
    Nat.0 < n and d.divides(n) and e.divides(divisor_quotient(n, d)) implies
        f(d) * dirichlet_term(g, h, divisor_quotient(n, d))(e) =
            divisor_pair_assoc_term(f, g, h, n)(Pair.new(d, e))
}

theorem right_nested_inner_sum_divisors_up_to_eq_pair_block_from_sum(f: Nat -> Nat,
        g: Nat -> Nat, h: Nat -> Nat, n: Nat, d: Nat, k: Nat) {
    Nat.0 < n and d.divides(n) implies
        f(d) * sum(map(divisors_up_to(divisor_quotient(n, d), k),
            dirichlet_term(g, h, divisor_quotient(n, d)))) =
            sum(map(right_divisor_pair_block_from(n, d,
                    divisors_up_to(divisor_quotient(n, d), k)),
                divisor_pair_assoc_term(f, g, h, n)))
}

theorem right_nested_inner_sum_eq_pair_block_from_sum(f: Nat -> Nat, g: Nat -> Nat,
        h: Nat -> Nat, n: Nat, d: Nat) {
    Nat.0 < n and d.divides(n) implies
        f(d) * sum(map(divisor_list(divisor_quotient(n, d)),
            dirichlet_term(g, h, divisor_quotient(n, d)))) =
            sum(map(right_divisor_pair_block_from(n, d, divisor_list(divisor_quotient(n, d))),
                divisor_pair_assoc_term(f, g, h, n)))
}

theorem right_nested_outer_term_eq_pair_block_sum(f: Nat -> Nat, g: Nat -> Nat,
        h: Nat -> Nat, n: Nat, d: Nat) {
    Nat.0 < n and divisor_list(n).contains(d) implies
        dirichlet_term(f, dirichlet_convolve(g, h), n)(d) =
            sum(map(right_divisor_pair_block(n, d), divisor_pair_assoc_term(f, g, h, n)))
}

theorem right_nested_outer_sum_divisors_up_to_eq_pair_list_from_sum(f: Nat -> Nat,
        g: Nat -> Nat, h: Nat -> Nat, n: Nat, k: Nat) {
    Nat.0 < n implies
        sum(map(divisors_up_to(n, k), dirichlet_term(f, dirichlet_convolve(g, h), n))) =
            sum(map(right_divisor_pair_list_from(n, divisors_up_to(n, k)),
                divisor_pair_assoc_term(f, g, h, n)))
}

theorem right_nested_convolve_eq_right_pair_list_sum(f: Nat -> Nat, g: Nat -> Nat,
        h: Nat -> Nat, n: Nat) {
    Nat.0 < n implies
        dirichlet_convolve(f, dirichlet_convolve(g, h))(n) =
            sum(map(right_divisor_pair_list(n), divisor_pair_assoc_term(f, g, h, n)))
}

define left_divisor_pair_of(r: Nat) -> (Nat -> Pair[Nat, Nat]) {
    function(d: Nat) {
        Pair.new(d, divisor_quotient(r, d))
    }
}

define left_divisor_pair_block(n: Nat, r: Nat) -> List[Pair[Nat, Nat]] {
    map(divisor_list(r), left_divisor_pair_of(r))
}

define left_divisor_pair_list_from(n: Nat, outer: List[Nat]) -> List[Pair[Nat, Nat]] {
    match outer {
        List.nil {
            List.nil[Pair[Nat, Nat]]
        }
        List.cons(r, tail) {
            left_divisor_pair_block(n, r) + left_divisor_pair_list_from(n, tail)
        }
    }
}

define left_divisor_pair_list(n: Nat) -> List[Pair[Nat, Nat]] {
    left_divisor_pair_list_from(n, divisor_list(n))
}

theorem left_divisor_pair_block_contains(n: Nat, r: Nat, d: Nat) {
    divisor_list(r).contains(d) implies
        left_divisor_pair_block(n, r).contains(Pair.new(d, divisor_quotient(r, d)))
}

theorem left_divisor_pair_block_contains_implies(n: Nat, r: Nat, p: Pair[Nat, Nat]) {
    left_divisor_pair_block(n, r).contains(p) implies
        divisor_list(r).contains(p.first) and p.second = divisor_quotient(r, p.first)
}

theorem left_divisor_pair_block_contains_implies_first(n: Nat, r: Nat, p: Pair[Nat, Nat]) {
    left_divisor_pair_block(n, r).contains(p) implies divisor_list(r).contains(p.first)
}

theorem left_divisor_pair_block_contains_implies_second(n: Nat, r: Nat, p: Pair[Nat, Nat]) {
    left_divisor_pair_block(n, r).contains(p) implies p.second = divisor_quotient(r, p.first)
}

theorem left_divisor_pair_block_contains_iff(n: Nat, r: Nat, d: Nat, e: Nat) {
    left_divisor_pair_block(n, r).contains(Pair.new(d, e)) =
        (divisor_list(r).contains(d) and e = divisor_quotient(r, d))
}

theorem left_divisor_pair_block_contains_implies_product(n: Nat, r: Nat, p: Pair[Nat, Nat]) {
    left_divisor_pair_block(n, r).contains(p) implies p.first * p.second = r
}

theorem left_divisor_pair_block_contains_implies_inner_product(n: Nat, r: Nat,
        p: Pair[Nat, Nat]) {
    left_divisor_pair_block(n, r).contains(p) implies
        divisor_list(p.first * p.second).contains(p.first)
}

theorem left_divisor_pair_block_contains_implies_second_product(n: Nat, r: Nat,
        p: Pair[Nat, Nat]) {
    left_divisor_pair_block(n, r).contains(p) implies
        p.second = divisor_quotient(p.first * p.second, p.first)
}

theorem left_divisor_pair_list_from_contains_head(n: Nat, head: Nat, tail: List[Nat],
        d: Nat) {
    divisor_list(head).contains(d) implies
        left_divisor_pair_list_from(n, List.cons(head, tail)).contains(
            Pair.new(d, divisor_quotient(head, d)))
}

theorem left_divisor_pair_list_from_contains_tail(n: Nat, head: Nat, tail: List[Nat],
        p: Pair[Nat, Nat]) {
    left_divisor_pair_list_from(n, tail).contains(p) implies
        left_divisor_pair_list_from(n, List.cons(head, tail)).contains(p)
}

theorem left_divisor_pair_list_from_head_contains_implies_product(n: Nat, head: Nat,
        tail: List[Nat], p: Pair[Nat, Nat]) {
    left_divisor_pair_block(n, head).contains(p) implies
        List.cons(head, tail).contains(p.first * p.second)
}

theorem left_divisor_pair_list_from_head_contains_implies_first_product(n: Nat,
        head: Nat, tail: List[Nat], p: Pair[Nat, Nat]) {
    left_divisor_pair_block(n, head).contains(p) implies
        divisor_list(p.first * p.second).contains(p.first)
}

theorem left_divisor_pair_list_from_head_contains_implies_second_product(n: Nat,
        head: Nat, tail: List[Nat], p: Pair[Nat, Nat]) {
    left_divisor_pair_block(n, head).contains(p) implies
        p.second = divisor_quotient(p.first * p.second, p.first)
}

theorem left_divisor_pair_list_from_divisors_up_to_contains(n: Nat, k: Nat,
        r: Nat, d: Nat) {
    divisors_up_to(n, k).contains(r) and divisor_list(r).contains(d) implies
        left_divisor_pair_list_from(n, divisors_up_to(n, k)).contains(
            Pair.new(d, divisor_quotient(r, d)))
}

theorem left_divisor_pair_list_contains(n: Nat, r: Nat, d: Nat) {
    divisor_list(n).contains(r) and divisor_list(r).contains(d) implies
        left_divisor_pair_list(n).contains(Pair.new(d, divisor_quotient(r, d)))
}

theorem left_divisor_pair_list_from_divisors_up_to_contains_implies(n: Nat, k: Nat,
        p: Pair[Nat, Nat]) {
    left_divisor_pair_list_from(n, divisors_up_to(n, k)).contains(p) implies
        divisors_up_to(n, k).contains(p.first * p.second) and
            divisor_list(p.first * p.second).contains(p.first) and
            p.second = divisor_quotient(p.first * p.second, p.first)
}

theorem left_divisor_pair_list_contains_implies(n: Nat, p: Pair[Nat, Nat]) {
    left_divisor_pair_list(n).contains(p) implies
        divisor_list(n).contains(p.first * p.second) and
            divisor_list(p.first * p.second).contains(p.first) and
            p.second = divisor_quotient(p.first * p.second, p.first)
}

theorem left_pair_membership_implies_right_membership(n: Nat, p: Pair[Nat, Nat]) {
    left_divisor_pair_list(n).contains(p) implies right_divisor_pair_list(n).contains(p)
}

theorem right_pair_membership_implies_left_membership(n: Nat, p: Pair[Nat, Nat]) {
    right_divisor_pair_list(n).contains(p) implies left_divisor_pair_list(n).contains(p)
}

theorem right_left_pair_lists_same_contains(n: Nat, p: Pair[Nat, Nat]) {
    right_divisor_pair_list(n).contains(p) = left_divisor_pair_list(n).contains(p)
}

define left_divisor_pair_block_from(n: Nat, r: Nat, inner: List[Nat]) -> List[Pair[Nat, Nat]] {
    map(inner, left_divisor_pair_of(r))
}

theorem left_divisor_pair_block_eq_from(n: Nat, r: Nat) {
    left_divisor_pair_block(n, r) = left_divisor_pair_block_from(n, r, divisor_list(r))
}

theorem left_divisor_pair_block_from_cons(n: Nat, r: Nat, head: Nat, tail: List[Nat]) {
    left_divisor_pair_block_from(n, r, List.cons(head, tail)) =
        List.cons(Pair.new(head, divisor_quotient(r, head)),
            left_divisor_pair_block_from(n, r, tail))
}

theorem left_nested_inner_head_term_eq_pair_assoc_term(f: Nat -> Nat, g: Nat -> Nat,
        h: Nat -> Nat, n: Nat, r: Nat, d: Nat) {
    Nat.0 < n and r.divides(n) and d.divides(r) implies
        dirichlet_term(f, g, r)(d) * h(divisor_quotient(n, r)) =
            divisor_pair_assoc_term(f, g, h, n)(Pair.new(d, divisor_quotient(r, d)))
}

theorem left_nested_inner_sum_divisors_up_to_eq_pair_block_from_sum(f: Nat -> Nat,
        g: Nat -> Nat, h: Nat -> Nat, n: Nat, r: Nat, k: Nat) {
    Nat.0 < n and r.divides(n) implies
        sum(map(divisors_up_to(r, k), dirichlet_term(f, g, r))) * h(divisor_quotient(n, r)) =
            sum(map(left_divisor_pair_block_from(n, r, divisors_up_to(r, k)),
                divisor_pair_assoc_term(f, g, h, n)))
}

theorem left_nested_inner_sum_eq_pair_block_from_sum(f: Nat -> Nat, g: Nat -> Nat,
        h: Nat -> Nat, n: Nat, r: Nat) {
    Nat.0 < n and r.divides(n) implies
        sum(map(divisor_list(r), dirichlet_term(f, g, r))) * h(divisor_quotient(n, r)) =
            sum(map(left_divisor_pair_block_from(n, r, divisor_list(r)),
                divisor_pair_assoc_term(f, g, h, n)))
}

theorem left_nested_outer_term_eq_pair_block_sum(f: Nat -> Nat, g: Nat -> Nat,
        h: Nat -> Nat, n: Nat, r: Nat) {
    Nat.0 < n and divisor_list(n).contains(r) implies
        dirichlet_term(dirichlet_convolve(f, g), h, n)(r) =
            sum(map(left_divisor_pair_block(n, r), divisor_pair_assoc_term(f, g, h, n)))
}

theorem left_nested_outer_sum_divisors_up_to_eq_pair_list_from_sum(f: Nat -> Nat,
        g: Nat -> Nat, h: Nat -> Nat, n: Nat, k: Nat) {
    Nat.0 < n implies
        sum(map(divisors_up_to(n, k), dirichlet_term(dirichlet_convolve(f, g), h, n))) =
            sum(map(left_divisor_pair_list_from(n, divisors_up_to(n, k)),
                divisor_pair_assoc_term(f, g, h, n)))
}

theorem left_nested_convolve_eq_left_pair_list_sum(f: Nat -> Nat, g: Nat -> Nat,
        h: Nat -> Nat, n: Nat) {
    Nat.0 < n implies
        dirichlet_convolve(dirichlet_convolve(f, g), h)(n) =
            sum(map(left_divisor_pair_list(n), divisor_pair_assoc_term(f, g, h, n)))
}

theorem right_divisor_pair_block_unique(n: Nat, d: Nat) {
    right_divisor_pair_block(n, d).is_unique
}

theorem right_divisor_pair_list_from_divisors_up_to_unique(n: Nat, k: Nat) {
    right_divisor_pair_list_from(n, divisors_up_to(n, k)).is_unique
}

theorem right_divisor_pair_list_unique(n: Nat) {
    right_divisor_pair_list(n).is_unique
}

theorem left_divisor_pair_block_unique(n: Nat, r: Nat) {
    left_divisor_pair_block(n, r).is_unique
}

theorem left_divisor_pair_list_from_divisors_up_to_unique(n: Nat, k: Nat) {
    left_divisor_pair_list_from(n, divisors_up_to(n, k)).is_unique
}

theorem left_divisor_pair_list_unique(n: Nat) {
    left_divisor_pair_list(n).is_unique
}

theorem right_left_pair_lists_unique(n: Nat) {
    right_divisor_pair_list(n).is_unique and left_divisor_pair_list(n).is_unique
}

theorem right_left_pair_list_assoc_term_sums_eq(f: Nat -> Nat, g: Nat -> Nat,
        h: Nat -> Nat, n: Nat) {
    sum(map(right_divisor_pair_list(n), divisor_pair_assoc_term(f, g, h, n))) =
        sum(map(left_divisor_pair_list(n), divisor_pair_assoc_term(f, g, h, n)))
}

theorem dirichlet_convolve_assoc_positive(f: Nat -> Nat, g: Nat -> Nat,
        h: Nat -> Nat, n: Nat) {
    Nat.0 < n implies
        dirichlet_convolve(f, dirichlet_convolve(g, h))(n) =
            dirichlet_convolve(dirichlet_convolve(f, g), h)(n)
}

theorem dirichlet_convolve_assoc(f: Nat -> Nat, g: Nat -> Nat, h: Nat -> Nat) {
    dirichlet_convolve(f, dirichlet_convolve(g, h)) =
        dirichlet_convolve(dirichlet_convolve(f, g), h)
}

theorem dirichlet_convolve_comm_law(f: Nat -> Nat, g: Nat -> Nat) {
    dirichlet_convolve(f, g) = dirichlet_convolve(g, f)
}

theorem dirichlet_convolve_comm_pointwise(f: Nat -> Nat, g: Nat -> Nat, n: Nat) {
    dirichlet_convolve(f, g)(n) = dirichlet_convolve(g, f)(n)
}

theorem dirichlet_convolve_assoc_law(f: Nat -> Nat, g: Nat -> Nat, h: Nat -> Nat) {
    dirichlet_convolve(f, dirichlet_convolve(g, h)) =
        dirichlet_convolve(dirichlet_convolve(f, g), h)
}

theorem dirichlet_convolve_assoc_pointwise(f: Nat -> Nat, g: Nat -> Nat,
        h: Nat -> Nat, n: Nat) {
    dirichlet_convolve(f, dirichlet_convolve(g, h))(n) =
        dirichlet_convolve(dirichlet_convolve(f, g), h)(n)
}

theorem dirichlet_convolve_unit_right_law(f: Nat -> Nat, n: Nat) {
    Nat.0 < n implies dirichlet_convolve(f, nat_dirichlet_unit_fn)(n) = f(n)
}

theorem dirichlet_convolve_unit_left_law(f: Nat -> Nat, n: Nat) {
    Nat.0 < n implies dirichlet_convolve(nat_dirichlet_unit_fn, f)(n) = f(n)
}

theorem dirichlet_convolve_unit_right_fn(f: Nat -> Nat) {
    f(Nat.0) = Nat.0 implies dirichlet_convolve(f, nat_dirichlet_unit_fn) = f
}

theorem dirichlet_convolve_unit_left_fn(f: Nat -> Nat) {
    f(Nat.0) = Nat.0 implies dirichlet_convolve(nat_dirichlet_unit_fn, f) = f
}

theorem dirichlet_convolve_multiplicative_law(f: Nat -> Nat, g: Nat -> Nat) {
    is_multiplicative_nat_fn(f) and is_multiplicative_nat_fn(g)
        implies is_multiplicative_nat_fn(dirichlet_convolve(f, g))
}

theorem dirichlet_convolve_unit_multiplicative(f: Nat -> Nat) {
    is_multiplicative_nat_fn(f) implies
        is_multiplicative_nat_fn(dirichlet_convolve(f, nat_dirichlet_unit_fn))
}

theorem dsa_pow_order_reduce(p: Nat, q: Nat, g: Nat, k: Nat, r: Nat) {
    g.pow(q).mod(p) = Nat.1 implies g.pow(k * q + r).mod(p) = g.pow(r).mod(p)
}

theorem dsa_pow_mod_q(p: Nat, q: Nat, g: Nat, a: Nat) {
    g.pow(q).mod(p) = Nat.1 implies g.pow(a).mod(p) = g.pow(a.mod(q)).mod(p)
}

theorem dsa_y_pow_congr(p: Nat, g: Nat, x: Nat, y: Nat, b: Nat) {
    y = g.pow(x).mod(p) implies y.pow(b).congr_mod(g.pow(x * b), p)
}

theorem dsa_combine_pow(p: Nat, g: Nat, x: Nat, y: Nat, a: Nat, b: Nat) {
    y = g.pow(x).mod(p) implies
        (g.pow(a) * y.pow(b)).mod(p) = g.pow(a + x * b).mod(p)
}

theorem dsa_exp_mod_q_factor(q: Nat, h: Nat, x: Nat, r: Nat, sinv: Nat) {
    ((h * sinv).mod(q) + x * (r * sinv).mod(q)).mod(q) =
        ((h + x * r) * sinv).mod(q)
}

theorem dsa_k_times_s_congr(q: Nat, h: Nat, x: Nat, r: Nat,
                             k: Nat, kinv: Nat, s: Nat) {
    s.congr_mod(kinv * (h + x * r), q) and (k * kinv).congr_mod(Nat.1, q)
    implies (k * s).congr_mod(h + x * r, q)
}

theorem dsa_finish_congr(q: Nat, h: Nat, x: Nat, r: Nat,
                          k: Nat, s: Nat, sinv: Nat) {
    (k * s).congr_mod(h + x * r, q) and (s * sinv).congr_mod(Nat.1, q)
    implies ((h + x * r) * sinv).congr_mod(k, q)
}

theorem dsa_congr_to_eq(q: Nat, k: Nat, lhs: Nat) {
    k < q and lhs.congr_mod(k, q) implies lhs.mod(q) = k
}

theorem dsa_k_times_s_from_mod(q: Nat, h: Nat, x: Nat, r: Nat,
                                k: Nat, kinv: Nat, s: Nat) {
    Nat.1 < q and (k * kinv).mod(q) = Nat.1 and
    s = (kinv * (h + x * r)).mod(q)
    implies (k * s).congr_mod(h + x * r, q)
}

define is_dsa_params(p: Nat, q: Nat, g: Nat) -> Bool {
    p.is_prime and q.is_prime and q.divides(p - Nat.1) and
    Nat.1 < g and g < p and g.pow(q).mod(p) = Nat.1
}

theorem is_dsa_params_unfold(p: Nat, q: Nat, g: Nat) {
    is_dsa_params(p, q, g) = (p.is_prime and q.is_prime and
        q.divides(p - Nat.1) and Nat.1 < g and g < p and g.pow(q).mod(p) = Nat.1)
}

define is_dsa_keypair(p: Nat, q: Nat, g: Nat, x: Nat, y: Nat) -> Bool {
    Nat.0 < x and x < q and y = g.pow(x).mod(p)
}

theorem is_dsa_keypair_unfold(p: Nat, q: Nat, g: Nat, x: Nat, y: Nat) {
    is_dsa_keypair(p, q, g, x, y) = (Nat.0 < x and x < q and y = g.pow(x).mod(p))
}

define is_mod_inverse(k: Nat, kinv: Nat, q: Nat) -> Bool {
    (k * kinv).mod(q) = Nat.1
}

theorem is_mod_inverse_unfold(k: Nat, kinv: Nat, q: Nat) {
    is_mod_inverse(k, kinv, q) = ((k * kinv).mod(q) = Nat.1)
}

define dsa_sign_r(p: Nat, q: Nat, g: Nat, k: Nat) -> Nat {
    g.pow(k).mod(p).mod(q)
}

define dsa_sign_s(q: Nat, h: Nat, x: Nat, r: Nat, kinv: Nat) -> Nat {
    (kinv * (h + x * r)).mod(q)
}

theorem dsa_sign_r_lt(p: Nat, q: Nat, g: Nat, k: Nat) {
    q != Nat.0 implies dsa_sign_r(p, q, g, k) < q
}

theorem dsa_sign_s_lt(q: Nat, h: Nat, x: Nat, r: Nat, kinv: Nat) {
    q != Nat.0 implies dsa_sign_s(q, h, x, r, kinv) < q
}

define dsa_verify(p: Nat, q: Nat, g: Nat, y: Nat, h: Nat,
                  r: Nat, s: Nat, sinv: Nat) -> Bool {
    Nat.0 < r and r < q and Nat.0 < s and s < q and
    is_mod_inverse(s, sinv, q) and
    (g.pow((h * sinv).mod(q)) * y.pow((r * sinv).mod(q))).mod(p).mod(q) = r
}

theorem dsa_verify_exponent_eq(q: Nat, h: Nat, x: Nat, r: Nat,
                                k: Nat, kinv: Nat, s: Nat, sinv: Nat) {
    Nat.1 < q and k < q and
    (k * kinv).mod(q) = Nat.1 and
    (s * sinv).mod(q) = Nat.1 and
    s = (kinv * (h + x * r)).mod(q)
    implies
        ((h * sinv).mod(q) + x * (r * sinv).mod(q)).mod(q) = k
}

theorem dsa_pow_combine(p: Nat, q: Nat, g: Nat, x: Nat, y: Nat,
                         a: Nat, b: Nat, k: Nat) {
    y = g.pow(x).mod(p) and
    g.pow(q).mod(p) = Nat.1 and
    (a + x * b).mod(q) = k
    implies
        (g.pow(a) * y.pow(b)).mod(p) = g.pow(k).mod(p)
}

theorem dsa_verify_identity(p: Nat, q: Nat, g: Nat, x: Nat, y: Nat,
                             h: Nat, r: Nat, k: Nat, kinv: Nat,
                             s: Nat, sinv: Nat) {
    Nat.1 < q and
    g.pow(q).mod(p) = Nat.1 and
    y = g.pow(x).mod(p) and
    k < q and
    (k * kinv).mod(q) = Nat.1 and
    (s * sinv).mod(q) = Nat.1 and
    s = (kinv * (h + x * r)).mod(q)
    implies
        (g.pow((h * sinv).mod(q)) * y.pow((r * sinv).mod(q))).mod(p) =
            g.pow(k).mod(p)
}

theorem dsa_verifier_mod_q_eq_r(p: Nat, q: Nat, g: Nat, x: Nat, y: Nat,
                                 h: Nat, k: Nat, kinv: Nat, sinv: Nat) {
    Nat.1 < q and
    g.pow(q).mod(p) = Nat.1 and
    y = g.pow(x).mod(p) and
    k < q and
    (k * kinv).mod(q) = Nat.1 and
    (dsa_sign_s(q, h, x, dsa_sign_r(p, q, g, k), kinv) * sinv).mod(q) = Nat.1
    implies
        (g.pow((h * sinv).mod(q)) *
         y.pow((dsa_sign_r(p, q, g, k) * sinv).mod(q))).mod(p).mod(q) =
            dsa_sign_r(p, q, g, k)
}

theorem dsa_correctness(p: Nat, q: Nat, g: Nat, x: Nat, y: Nat,
                        k: Nat, kinv: Nat, h: Nat, sinv: Nat) {
    is_dsa_params(p, q, g) and
    is_dsa_keypair(p, q, g, x, y) and
    Nat.0 < k and k < q and
    is_mod_inverse(k, kinv, q) and
    is_mod_inverse(dsa_sign_s(q, h, x, dsa_sign_r(p, q, g, k), kinv), sinv, q) and
    Nat.0 < dsa_sign_r(p, q, g, k) and
    Nat.0 < dsa_sign_s(q, h, x, dsa_sign_r(p, q, g, k), kinv)
    implies
        dsa_verify(p, q, g, y, h,
                   dsa_sign_r(p, q, g, k),
                   dsa_sign_s(q, h, x, dsa_sign_r(p, q, g, k), kinv),
                   sinv)
}

define dsa_r_in_range(q: Nat, r: Nat) -> Bool {
    Nat.0 < r and r < q
}

define dsa_s_in_range(q: Nat, s: Nat) -> Bool {
    Nat.0 < s and s < q
}

define dsa_signature_components_in_range(q: Nat, r: Nat, s: Nat) -> Bool {
    dsa_r_in_range(q, r) and dsa_s_in_range(q, s)
}

define dsa_verify_core_equation(
    p: Nat,
    q: Nat,
    g: Nat,
    y: Nat,
    h: Nat,
    r: Nat,
    sinv: Nat
) -> Bool {
    (g.pow((h * sinv).mod(q)) * y.pow((r * sinv).mod(q))).mod(p).mod(q) = r
}

theorem dsa_r_in_range_pos(q: Nat, r: Nat) {
    dsa_r_in_range(q, r) implies Nat.0 < r
}

theorem dsa_r_in_range_lt(q: Nat, r: Nat) {
    dsa_r_in_range(q, r) implies r < q
}

theorem dsa_s_in_range_pos(q: Nat, s: Nat) {
    dsa_s_in_range(q, s) implies Nat.0 < s
}

theorem dsa_s_in_range_lt(q: Nat, s: Nat) {
    dsa_s_in_range(q, s) implies s < q
}

theorem dsa_signature_components_in_range_r(q: Nat, r: Nat, s: Nat) {
    dsa_signature_components_in_range(q, r, s) implies dsa_r_in_range(q, r)
}

theorem dsa_signature_components_in_range_s(q: Nat, r: Nat, s: Nat) {
    dsa_signature_components_in_range(q, r, s) implies dsa_s_in_range(q, s)
}

theorem dsa_signature_components_in_range_r_pos(q: Nat, r: Nat, s: Nat) {
    dsa_signature_components_in_range(q, r, s) implies Nat.0 < r
}

theorem dsa_signature_components_in_range_r_lt(q: Nat, r: Nat, s: Nat) {
    dsa_signature_components_in_range(q, r, s) implies r < q
}

theorem dsa_signature_components_in_range_s_pos(q: Nat, r: Nat, s: Nat) {
    dsa_signature_components_in_range(q, r, s) implies Nat.0 < s
}

theorem dsa_signature_components_in_range_s_lt(q: Nat, r: Nat, s: Nat) {
    dsa_signature_components_in_range(q, r, s) implies s < q
}

theorem dsa_verify_guards_of_verify(
    p: Nat,
    q: Nat,
    g: Nat,
    y: Nat,
    h: Nat,
    r: Nat,
    s: Nat,
    sinv: Nat
) {
    dsa_verify(p, q, g, y, h, r, s, sinv) implies
        dsa_signature_components_in_range(q, r, s) and is_mod_inverse(s, sinv, q)
}

theorem dsa_verify_signature_components_in_range_of_verify(
    p: Nat,
    q: Nat,
    g: Nat,
    y: Nat,
    h: Nat,
    r: Nat,
    s: Nat,
    sinv: Nat
) {
    dsa_verify(p, q, g, y, h, r, s, sinv) implies dsa_signature_components_in_range(q, r, s)
}

theorem dsa_verify_inverse_of_verify(
    p: Nat,
    q: Nat,
    g: Nat,
    y: Nat,
    h: Nat,
    r: Nat,
    s: Nat,
    sinv: Nat
) {
    dsa_verify(p, q, g, y, h, r, s, sinv) implies is_mod_inverse(s, sinv, q)
}

theorem dsa_verify_core_equation_of_verify(
    p: Nat,
    q: Nat,
    g: Nat,
    y: Nat,
    h: Nat,
    r: Nat,
    s: Nat,
    sinv: Nat
) {
    dsa_verify(p, q, g, y, h, r, s, sinv) implies
        dsa_verify_core_equation(p, q, g, y, h, r, sinv)
}

theorem dsa_verify_modulus_ne_zero(
    p: Nat,
    q: Nat,
    g: Nat,
    y: Nat,
    h: Nat,
    r: Nat,
    s: Nat,
    sinv: Nat
) {
    dsa_verify(p, q, g, y, h, r, s, sinv) implies q != Nat.0
}

theorem dsa_verify_of_guards_and_core_equation(
    p: Nat,
    q: Nat,
    g: Nat,
    y: Nat,
    h: Nat,
    r: Nat,
    s: Nat,
    sinv: Nat
) {
    dsa_signature_components_in_range(q, r, s) and
        is_mod_inverse(s, sinv, q) and
        dsa_verify_core_equation(p, q, g, y, h, r, sinv)
    implies dsa_verify(p, q, g, y, h, r, s, sinv)
}

theorem lcm_gcd_product(a: Nat, b: Nat) {
    a.gcd(b) * a.lcm(b) = a * b
}

theorem lcm_common_multiple_left(a: Nat, b: Nat) {
    a.divides(a.lcm(b))
}

theorem lcm_common_multiple_right(a: Nat, b: Nat) {
    b.divides(a.lcm(b))
}

theorem lcm_divides_common_multiple(a: Nat, b: Nat, c: Nat) {
    a.divides(c) and b.divides(c) implies a.lcm(b).divides(c)
}

theorem lcm_eq_mul_of_gcd_one(a: Nat, b: Nat) {
    a.gcd(b) = Nat.1 implies a.lcm(b) = a * b
}

theorem gcd_one_of_lcm_eq_mul(a: Nat, b: Nat) {
    a != Nat.0 and b != Nat.0 and a.lcm(b) = a * b implies a.gcd(b) = Nat.1
}

theorem lcm_eq_mul_iff_gcd_one(a: Nat, b: Nat) {
    a != Nat.0 and b != Nat.0 implies ((a.gcd(b) = Nat.1) = (a.lcm(b) = a * b))
}

theorem gcd_lcm_distrib_left(a: Nat, b: Nat, c: Nat) {
    (a.gcd(b)).lcm(a.gcd(c)).divides(a.gcd(b.lcm(c)))
}

theorem prod_divides(a1: Nat, a2: Nat, b1: Nat, b2: Nat) {
    a1.divides(b1) and a2.divides(b2) implies (a1 * a2).divides(b1 * b2)
}

theorem coprime_mul_divides(p: Nat, q: Nat, m: Nat) {
    p.coprime(q) and p.divides(m) and q.divides(m) implies (p * q).divides(m)
}

theorem div_of_divides_mul(d: Nat, x: Nat, y: Nat) {
    d != Nat.0 and d.divides(x * y) implies (d.div(d.gcd(x))).divides(y)
}

theorem gcd_coprime_factor(a: Nat, g: Nat, t: Nat) {
    a.coprime(g) implies a.gcd(g * t) = a.gcd(t)
}

theorem gcd_mul_coprime(a: Nat, x: Nat, y: Nat) {
    x.coprime(y) implies a.gcd(x * y) = a.gcd(x) * a.gcd(y)
}

theorem gcd_assoc(a: Nat, x: Nat, y: Nat) {
    (a.gcd(x)).gcd(a.gcd(y)) = a.gcd(x.gcd(y))
}

theorem lcm_cofactor(x: Nat, y: Nat, xp: Nat, yp: Nat) {
    x.gcd(y) != Nat.0 and x.gcd(y) * xp = x and x.gcd(y) * yp = y implies
        x.gcd(y) * xp * yp = x.lcm(y)
}

theorem gcd_lcm_identity(a: Nat, x: Nat, y: Nat) {
    a.gcd(x) * a.gcd(y) = a.gcd(x.gcd(y)) * a.gcd(x.lcm(y))
}

theorem gcd_lcm_distrib_right(a: Nat, b: Nat, c: Nat) {
    a.gcd(b.lcm(c)).divides((a.gcd(b)).lcm(a.gcd(c)))
}

theorem gcd_lcm_distrib(a: Nat, b: Nat, c: Nat) {
    a.gcd(b.lcm(c)) = (a.gcd(b)).lcm(a.gcd(c))
}

define prime_factor_count_upto(p: Nat, n: Nat) -> Nat {
    match n {
        Nat.zero {
            Nat.0
        }
        Nat.suc(k) {
            prime_factor_count_upto(p, k) + count_prime_factor(p, n)
        }
    }
}

theorem prime_factor_count_upto_zero(p: Nat) {
    prime_factor_count_upto(p, Nat.0) = Nat.0
}

theorem prime_factor_count_upto_step(p: Nat, n: Nat) {
    prime_factor_count_upto(p, n.suc) =
        prime_factor_count_upto(p, n) + count_prime_factor(p, n.suc)
}

theorem factorial_ne_zero(n: Nat) {
    n.factorial != Nat.0
}

theorem legendre_factorial(p: Nat, n: Nat) {
    count_prime_factor(p, n.factorial) = prime_factor_count_upto(p, n)
}

theorem mul_ne_zero(a: Nat, b: Nat) {
    a != Nat.0 and b != Nat.0 implies a * b != Nat.0
}

theorem binom_add_ne_zero(a: Nat, b: Nat) {
    (a + b).binom(a) != Nat.0
}

theorem legendre_binom_factorial(p: Nat, a: Nat, b: Nat) {
    count_prime_factor(p, (a + b).binom(a)) +
        count_prime_factor(p, a.factorial) +
        count_prime_factor(p, b.factorial) =
        count_prime_factor(p, (a + b).factorial)
}

theorem legendre_binom(p: Nat, a: Nat, b: Nat) {
    count_prime_factor(p, (a + b).binom(a)) +
        prime_factor_count_upto(p, a) +
        prime_factor_count_upto(p, b) =
        prime_factor_count_upto(p, a + b)
}

theorem one_lte_iff_ne_zero(x: Nat) {
    (Nat.1 <= x) = (x != Nat.0)
}

theorem prime_divides_iff_count_ne_zero(p: Nat, n: Nat) {
    p.is_prime and n != Nat.0 implies (
        p.divides(n) = (count_prime_factor(p, n) != Nat.0)
    )
}

theorem prime_divides_binom_iff(p: Nat, a: Nat, b: Nat) {
    p.is_prime implies (
        p.divides((a + b).binom(a)) =
            (count_prime_factor(p, (a + b).binom(a)) != Nat.0)
    )
}

theorem add_shuffle(a: Nat, b: Nat, c: Nat) {
    a.suc + (b + c) = a + b + (c + Nat.1)
}

theorem legendre_recurrence(p: Nat, n: Nat) {
    p.is_prime implies
        prime_factor_count_upto(p, n) =
            n.div(p) + prime_factor_count_upto(p, n.div(p))
}

theorem legendre_factorial_recurrence(p: Nat, n: Nat) {
    p.is_prime implies
        count_prime_factor(p, n.factorial) =
            n.div(p) + count_prime_factor(p, n.div(p).factorial)
}

define legendre_digit_sum_at(p: Nat, n: Nat) -> Bool {
    p * count_prime_factor(p, n.factorial) + digit_sum(p, n) =
        n + count_prime_factor(p, n.factorial)
}

theorem legendre_digit_sum_step_algebra(p: Nat, q: Nat, r: Nat, v: Nat, s: Nat) {
    p * v + s = q + v implies
        p * (q + v) + (r + s) = q * p + r + (q + v)
}

theorem legendre_digit_sum(p: Nat, n: Nat) {
    p.is_prime implies legendre_digit_sum_at(p, n)
}

theorem kummer_add_shuffle_left(x: Nat, y: Nat, z: Nat, w: Nat) {
    (x + y) + (z + w) = x + z + w + y
}

theorem kummer_add_shuffle_right(vc: Nat, a: Nat, va: Nat, b: Nat, vb: Nat) {
    vc + (a + va) + (b + vb) = a + b + (vc + va + vb)
}

theorem kummer_left_carry_algebra(
    p: Nat, vc: Nat, va: Nat, vb: Nat, vab: Nat, sab: Nat
) {
    vc + va + vb = vab implies
        (p * vc + sab) + (p * va + p * vb) = p * vab + sab
}

theorem kummer_right_carry_algebra(
    p: Nat, a: Nat, b: Nat, vc: Nat, va: Nat, vb: Nat, vab: Nat, sa: Nat, sb: Nat
) {
    vc + va + vb = vab and
    p * va + sa = a + va and
    p * vb + sb = b + vb implies
        a + b + vab = (vc + sa + sb) + (p * va + p * vb)
}

theorem kummer_digit_sum_of_legendre_digit_sum(
    p: Nat, a: Nat, b: Nat
) {
    legendre_digit_sum_at(p, a) and
    legendre_digit_sum_at(p, b) and
    legendre_digit_sum_at(p, a + b)
        implies
    p * count_prime_factor(p, (a + b).binom(a)) + digit_sum(p, a + b) =
        count_prime_factor(p, (a + b).binom(a)) + digit_sum(p, a) + digit_sum(p, b)
}

theorem kummer_digit_sum(p: Nat, a: Nat, b: Nat) {
    p.is_prime implies
        p * count_prime_factor(p, (a + b).binom(a)) + digit_sum(p, a + b) =
            count_prime_factor(p, (a + b).binom(a)) + digit_sum(p, a) + digit_sum(p, b)
}

define central_binom(n: Nat) -> Nat {
    (n + n).binom(n)
}

define falling_product_factor(n: Nat, i: Nat) -> Nat {
    n - i
}

define falling_product_factor_count(p: Nat, n: Nat, i: Nat) -> Nat {
    count_prime_factor(p, falling_product_factor(n, i))
}

define falling_product_factors(n: Nat, k: Nat) -> List[Nat] {
    map(k.suc.range, falling_product_factor(n))
}

define falling_product_factor_counts(p: Nat, n: Nat, k: Nat) -> List[Nat] {
    map(k.suc.range, falling_product_factor_count(p, n))
}

define falling_product(n: Nat, k: Nat) -> Nat {
    match k {
        Nat.zero {
            n
        }
        Nat.suc(j) {
            falling_product(n, j) * (n - k)
        }
    }
}

define falling_product_prime_count_sum(p: Nat, n: Nat, k: Nat) -> Nat {
    match k {
        Nat.zero {
            count_prime_factor(p, n)
        }
        Nat.suc(j) {
            falling_product_prime_count_sum(p, n, j) +
                count_prime_factor(p, n - k)
        }
    }
}

theorem central_binom_eq(n: Nat) {
    central_binom(n) = (n + n).binom(n)
}

theorem central_binom_zero {
    central_binom(Nat.0) = Nat.1
}

theorem central_binom_one {
    central_binom(Nat.1) = Nat.2
}

theorem central_binom_ne_zero(n: Nat) {
    central_binom(n) != Nat.0
}

theorem falling_product_zero(n: Nat) {
    falling_product(n, Nat.0) = n
}

theorem falling_product_suc(n: Nat, k: Nat) {
    falling_product(n, k.suc) = falling_product(n, k) * (n - k.suc)
}

theorem falling_product_factors_zero(n: Nat) {
    falling_product_factors(n, Nat.0) = List.singleton(n)
}

theorem falling_product_factors_suc(n: Nat, k: Nat) {
    falling_product_factors(n, k.suc) =
        falling_product_factors(n, k).append(n - k.suc)
}

theorem falling_product_factor_counts_zero(p: Nat, n: Nat) {
    falling_product_factor_counts(p, n, Nat.0) =
        List.singleton(count_prime_factor(p, n))
}

theorem falling_product_factor_counts_suc(p: Nat, n: Nat, k: Nat) {
    falling_product_factor_counts(p, n, k.suc) =
        falling_product_factor_counts(p, n, k).append(count_prime_factor(p, n - k.suc))
}

theorem falling_product_prime_count_sum_zero(p: Nat, n: Nat) {
    falling_product_prime_count_sum(p, n, Nat.0) = count_prime_factor(p, n)
}

theorem falling_product_prime_count_sum_suc(p: Nat, n: Nat, k: Nat) {
    falling_product_prime_count_sum(p, n, k.suc) =
        falling_product_prime_count_sum(p, n, k) + count_prime_factor(p, n - k.suc)
}

theorem falling_product_eq_product_factors(n: Nat, k: Nat) {
    falling_product(n, k) = product[Nat](falling_product_factors(n, k))
}

theorem falling_product_prime_count_sum_eq_sum_factor_counts(p: Nat, n: Nat, k: Nat) {
    falling_product_prime_count_sum(p, n, k) =
        sum[Nat](falling_product_factor_counts(p, n, k))
}

theorem falling_product_nonzero(n: Nat, k: Nat) {
    k < n implies falling_product(n, k) != Nat.0
}

theorem count_prime_factor_falling_product(p: Nat, n: Nat, k: Nat) {
    k < n implies
        count_prime_factor(p, falling_product(n, k)) =
        falling_product_prime_count_sum(p, n, k)
}

theorem falling_product_one(n: Nat) {
    falling_product(n, Nat.1) = n * (n - Nat.1)
}

theorem falling_product_two(n: Nat) {
