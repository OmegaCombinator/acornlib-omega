theorem rational_continued_fraction_some_value(
    numerator: Nat, denominator: Nat, cf: ContinuedFraction
) {
    denominator != Nat.0 and
        rational_continued_fraction(numerator, denominator) = Option.some(cf)
        implies cf.value =
