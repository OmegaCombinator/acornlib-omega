theorem least_non_divisor_at_least_two(n: Nat, m: Nat) {
    is_least_non_divisor(n, m) implies Nat.2 <= m
}

theorem least_non_divisor_unique(n: Nat, m: Nat, m2: Nat) {
    is_least_non_divisor(n, m) and is_least_non_divisor(n, m2) implies m = m2
}

theorem lt_mul_of_one_lt_right(a: Nat, b: Nat) {
    Nat.0 < a and Nat.1 < b implies a < a * b
}

theorem coprime_divisors_product_divides(a: Nat, b: Nat, n: Nat) {
    a.divides(n) and b.divides(n) and a.coprime(b) implies (a * b).divides(n)
}

theorem least_non_divisor_factors_not_coprime(n: Nat, m: Nat, a: Nat, b: Nat) {
    is_least_non_divisor(n, m) and m = a * b and Nat.1 < a and Nat.1 < b
        implies not a.coprime(b)
}

theorem least_non_divisor_proper_divisor_divides(n: Nat, m: Nat, d: Nat) {
    is_least_non_divisor(n, m) and d.divides(m) and d != m and d != Nat.0
        implies d.divides(n)
}

theorem prime_divides_factorial_imp_lte(p: Nat, n: Nat) {
    p.is_prime and p.divides(n.factorial) implies p <= n
}

theorem binom_central_max_left(n: Nat, k: Nat) {
    k <= n implies (n + n).binom(k) <= (n + n).binom(n)
}

theorem binom_central_max_right(n: Nat, k: Nat) {
    n <= k and k <= n + n implies (n + n).binom(k) <= (n + n).binom(n)
}

theorem binom_le_central(n: Nat, k: Nat) {
    k <= n + n implies (n + n).binom(k) <= (n + n).binom(n)
}

theorem central_binom_lower_bound(n: Nat) {
    Nat.4.pow(n) <= (n + n + Nat.1) * central_binom(n)
}

theorem not_divides_between_p_and_2p(p: Nat, k: Nat) {
    p.is_prime and p < k and k < p + p implies not p.divides(k)
}

theorem not_divides_between_2p_and_3p(p: Nat, k: Nat) {
    p.is_prime and p + p < k and k < Nat.3 * p implies not p.divides(k)
}

theorem suc_of_sub_suc(a: Nat, b: Nat) {
    b < a implies (a - b.suc).suc = a - b
}

theorem sub_sub_cancel(a: Nat, b: Nat, c: Nat) {
    b <= c and c <= a implies (a - b) - (c - b) = a - c
}

theorem sub_lt_sub(a: Nat, b: Nat, c: Nat) {
    a <= b and b < c implies b - a < c - a
}

theorem sub_lte_sub(a: Nat, b: Nat, c: Nat) {
    c <= b and b <= a implies a - b <= a - c
}

theorem sub_sub_assoc(a: Nat, b: Nat, c: Nat) {
    b + c <= a implies (a - b) - c = a - (b + c)
}

theorem add_sub_comm(a: Nat, b: Nat, c: Nat) {
    b <= a implies (a - b) + c = (a + c) - b
}

theorem suc_sub_suc_eq(a: Nat, b: Nat) {
    a < b implies b.suc - a.suc = b - a
}

theorem falling_product_split(n: Nat, k: Nat, a: Nat) {
    a < k and k < n implies falling_product(n, k) = falling_product(n, a) * falling_product(n - a.suc, k - a.suc)
}

theorem prime_lt_n_two_thirds_not_divides(p: Nat, n: Nat) {
    p.is_prime and Nat.2 < p and p < n and Nat.2 * n < Nat.3 * p
        implies not p.divides(central_binom(n))
}

theorem prime_eq_n_two_thirds_not_divides(p: Nat, n: Nat) {
    p.is_prime and Nat.2 < p and p = n and Nat.2 * n < Nat.3 * p
        implies not p.divides(central_binom(n))
}

theorem prime_above_two_thirds_not_divides(p: Nat, n: Nat) {
    p.is_prime and Nat.2 < p and p <= n and Nat.2 * n < Nat.3 * p
        implies not p.divides(central_binom(n))
}

theorem prime_factor_of_central_binom_at_most_2n(p: Nat, n: Nat) {
    p.is_prime and p.divides(central_binom(n)) implies p <= n + n
}

theorem prime_factor_of_central_binom_at_most_n(p: Nat, n: Nat) {
    p.is_prime and p.divides(central_binom(n))
        and (forall(q: Nat) {
            q.is_prime and n < q and q <= n + n implies not q.divides(central_binom(n))
        }) implies p <= n
}

theorem prime_factor_of_central_binom_two_thirds(p: Nat, n: Nat) {
    Nat.2 < n and p.is_prime and p.divides(central_binom(n))
        and (forall(q: Nat) {
            q.is_prime and n < q and q <= n + n implies not q.divides(central_binom(n))
        }) implies Nat.3 * p <= n + n
}

define coprime_with_all(head: Nat, tail: List[Nat]) -> Bool {
    match tail {
        List.nil {
            true
        }
        List.cons(t_head, t_tail) {
            head.coprime(t_head) and coprime_with_all(head, t_tail)
        }
    }
}

define pairwise_coprime(list: List[Nat]) -> Bool {
    match list {
        List.nil {
            true
        }
        List.cons(head, tail) {
            coprime_with_all(head, tail) and pairwise_coprime(tail)
        }
    }
}

theorem pairwise_coprime_nil {
    pairwise_coprime(List.nil[Nat])
}

theorem pairwise_coprime_singleton(a: Nat) {
    pairwise_coprime(List.cons(a, List.nil[Nat]))
}

theorem pairwise_coprime_cons_imp(head: Nat, tail: List[Nat]) {
    pairwise_coprime(List.cons(head, tail)) implies
        coprime_with_all(head, tail) and pairwise_coprime(tail)
}

theorem pairwise_coprime_cons(head: Nat, tail: List[Nat]) {
    coprime_with_all(head, tail) and pairwise_coprime(tail) implies
        pairwise_coprime(List.cons(head, tail))
}

theorem coprime_with_all_imp_coprime_product(a: Nat, list: List[Nat]) {
    coprime_with_all(a, list) implies a.coprime(product[Nat](list))
}

define satisfies_all(c: Nat, system: List[Pair[Nat, Nat]]) -> Bool {
    match system {
        List.nil {
            true
        }
        List.cons(head, tail) {
            c.congr_mod(head.second, head.first) and satisfies_all(c, tail)
        }
    }
}

theorem satisfies_all_nil(c: Nat) {
    satisfies_all(c, List.nil[Pair[Nat, Nat]])
}

theorem satisfies_all_cons_imp(c: Nat, head: Pair[Nat, Nat], tail: List[Pair[Nat, Nat]]) {
    satisfies_all(c, List.cons(head, tail)) implies
        c.congr_mod(head.second, head.first) and satisfies_all(c, tail)
}

theorem satisfies_all_cons_intro(c: Nat, head: Pair[Nat, Nat], tail: List[Pair[Nat, Nat]]) {
    c.congr_mod(head.second, head.first) and satisfies_all(c, tail) implies
        satisfies_all(c, List.cons(head, tail))
}

theorem nat_crt_list_nil {
    exists(c: Nat) { satisfies_all(c, List.nil[Pair[Nat, Nat]]) }
}

define system_moduli(system: List[Pair[Nat, Nat]]) -> List[Nat] {
    match system {
        List.nil {
            List.nil[Nat]
        }
        List.cons(head, tail) {
            List.cons(head.first, system_moduli(tail))
        }
    }
}

define system_modulus(system: List[Pair[Nat, Nat]]) -> Nat {
    product[Nat](system_moduli(system))
}

theorem system_modulus_nil {
    system_modulus(List.nil[Pair[Nat, Nat]]) = Nat.1
}

theorem system_modulus_cons(head: Pair[Nat, Nat], tail: List[Pair[Nat, Nat]]) {
    system_modulus(List.cons(head, tail)) = head.first * system_modulus(tail)
}

theorem nat_congr_mod_descend(m: Nat, k: Nat, x: Nat, y: Nat) {
    m.divides(k) and x.congr_mod(y, k) implies x.congr_mod(y, m)
}

theorem cons_modulus_split(c: Nat, c0: Nat, head: Pair[Nat, Nat], tail: List[Pair[Nat, Nat]]) {
    c.congr_mod(c0, system_modulus(List.cons(head, tail)))
        implies c.congr_mod(c0, head.first) and c.congr_mod(c0, system_modulus(tail))
}

theorem satisfies_all_descend(c: Nat, c0: Nat, system: List[Pair[Nat, Nat]]) {
    c.congr_mod(c0, system_modulus(system)) and satisfies_all(c0, system)
        implies satisfies_all(c, system)
}

theorem satisfies_all_descend_cons_step(
    c: Nat, c0: Nat, head: Pair[Nat, Nat], tail: List[Pair[Nat, Nat]]
) {
    satisfies_all(c, tail)
        and c.congr_mod(c0, system_modulus(List.cons(head, tail)))
        and satisfies_all(c0, List.cons(head, tail))
        implies satisfies_all(c, List.cons(head, tail))
}

define every_modulus_positive(system: List[Pair[Nat, Nat]]) -> Bool {
    match system {
        List.nil {
            true
        }
        List.cons(head, tail) {
            head.first != Nat.0 and every_modulus_positive(tail)
        }
    }
}

theorem every_modulus_positive_cons_imp(head: Pair[Nat, Nat], tail: List[Pair[Nat, Nat]]) {
    every_modulus_positive(List.cons(head, tail)) implies
        head.first != Nat.0 and every_modulus_positive(tail)
}

theorem every_modulus_positive_imp_modulus_nonzero(system: List[Pair[Nat, Nat]]) {
    every_modulus_positive(system) implies system_modulus(system) != Nat.0
}

theorem nat_crt_list_cons(head: Pair[Nat, Nat], tail: List[Pair[Nat, Nat]]) {
    pairwise_coprime(system_moduli(List.cons(head, tail)))
        and every_modulus_positive(List.cons(head, tail))
        and (exists(c0: Nat) { satisfies_all(c0, tail) })
        implies exists(c: Nat) { satisfies_all(c, List.cons(head, tail)) }
}

theorem nat_crt_list(system: List[Pair[Nat, Nat]]) {
    pairwise_coprime(system_moduli(system))
        and every_modulus_positive(system)
        implies exists(c: Nat) { satisfies_all(c, system) }
}

theorem nat_congr_mod_one(a: Nat, b: Nat) {
    a.congr_mod(b, Nat.1)
}

theorem cons_head_coprime_tail_system_modulus(head: Pair[Nat, Nat], tail: List[Pair[Nat, Nat]]) {
    pairwise_coprime(system_moduli(List.cons(head, tail))) implies
        head.first.coprime(system_modulus(tail))
}

theorem cons_solutions_congruent_mod_head(
    head: Pair[Nat, Nat], tail: List[Pair[Nat, Nat]], c1: Nat, c2: Nat
) {
    satisfies_all(c1, List.cons(head, tail))
        and satisfies_all(c2, List.cons(head, tail))
        implies c1.congr_mod(c2, head.first)
}

theorem combine_head_tail_congruence_mod_system_modulus(
    head: Pair[Nat, Nat], tail: List[Pair[Nat, Nat]], c1: Nat, c2: Nat
) {
    head.first.coprime(system_modulus(tail))
        and c1.congr_mod(c2, head.first)
        and c1.congr_mod(c2, system_modulus(tail))
        implies c1.congr_mod(c2, system_modulus(List.cons(head, tail)))
}

theorem satisfies_all_unique_mod_system_modulus(system: List[Pair[Nat, Nat]], c1: Nat, c2: Nat) {
    pairwise_coprime(system_moduli(system))
        and every_modulus_positive(system)
        and satisfies_all(c1, system)
        and satisfies_all(c2, system)
        implies c1.congr_mod(c2, system_modulus(system))
}

theorem congr_mod_below_system_modulus_eq(system: List[Pair[Nat, Nat]], c1: Nat, c2: Nat) {
    every_modulus_positive(system)
        and c1 < system_modulus(system)
        and c2 < system_modulus(system)
        and c1.congr_mod(c2, system_modulus(system))
        implies c1 = c2
}

theorem satisfies_all_unique_below_system_modulus(system: List[Pair[Nat, Nat]], c1: Nat, c2: Nat) {
    pairwise_coprime(system_moduli(system))
        and every_modulus_positive(system)
        and satisfies_all(c1, system)
        and satisfies_all(c2, system)
        and c1 < system_modulus(system)
        and c2 < system_modulus(system)
        implies c1 = c2
}

theorem satisfies_all_congruent_to_crt_list_solution(system: List[Pair[Nat, Nat]], c: Nat) {
    pairwise_coprime(system_moduli(system))
        and every_modulus_positive(system)
        and satisfies_all(c, system)
        implies exists(c0: Nat) {
            satisfies_all(c0, system) and c.congr_mod(c0, system_modulus(system))
        }
}

define congruence_class_contains(cl: Pair[Nat, Nat], x: Int) -> Bool {
    int_mod_rel(cl.first, x, Int.from_nat(cl.second))
}

define covers_int(system: List[Pair[Nat, Nat]], x: Int) -> Bool {
    match system {
        List.nil {
            false
        }
        List.cons(head, tail) {
            congruence_class_contains(head, x) or covers_int(tail, x)
        }
    }
}

theorem covers_int_nil_false(x: Int) {
    not covers_int(List.nil[Pair[Nat, Nat]], x)
}

theorem covers_int_cons_imp(head: Pair[Nat, Nat], tail: List[Pair[Nat, Nat]], x: Int) {
    covers_int(List.cons(head, tail), x)
        implies congruence_class_contains(head, x) or covers_int(tail, x)
}

theorem covers_int_cons_left(head: Pair[Nat, Nat], tail: List[Pair[Nat, Nat]], x: Int) {
    congruence_class_contains(head, x) implies covers_int(List.cons(head, tail), x)
}

theorem covers_int_cons_right(head: Pair[Nat, Nat], tail: List[Pair[Nat, Nat]], x: Int) {
    covers_int(tail, x) implies covers_int(List.cons(head, tail), x)
}

define covers_all_int(system: List[Pair[Nat, Nat]]) -> Bool {
    forall(x: Int) {
        covers_int(system, x)
    }
}

theorem covers_all_int_apply(system: List[Pair[Nat, Nat]], x: Int) {
    covers_all_int(system) implies covers_int(system, x)
}

theorem covers_all_int_intro(system: List[Pair[Nat, Nat]]) {
    (forall(x: Int) { covers_int(system, x) }) implies covers_all_int(system)
}

define is_covering_system(system: List[Pair[Nat, Nat]]) -> Bool {
    every_modulus_positive(system) and covers_all_int(system)
}

theorem covering_system_moduli_positive(system: List[Pair[Nat, Nat]]) {
    is_covering_system(system) implies every_modulus_positive(system)
}

theorem covering_system_covers_int(system: List[Pair[Nat, Nat]], x: Int) {
    is_covering_system(system) implies covers_int(system, x)
}

theorem covering_system_cons_of_tail(head: Pair[Nat, Nat], tail: List[Pair[Nat, Nat]]) {
    head.first != Nat.0 and is_covering_system(tail)
        implies is_covering_system(List.cons(head, tail))
}

theorem int_mod_rel_one(x: Int, y: Int) {
    int_mod_rel(Nat.1, x, y)
}

theorem int_mod_rel_symm(m: Nat, x: Int, y: Int) {
    int_mod_rel(m, x, y) implies int_mod_rel(m, y, x)
}

theorem int_mod_rel_trans(m: Nat, x: Int, y: Int, z: Int) {
    int_mod_rel(m, x, y) and int_mod_rel(m, y, z) implies int_mod_rel(m, x, z)
}

theorem congruence_class_contains_of_congruent(cl: Pair[Nat, Nat], x: Int, y: Int) {
    int_mod_rel(cl.first, x, y) and congruence_class_contains(cl, y)
        implies congruence_class_contains(cl, x)
}

theorem congruence_class_mod_one_contains(r: Nat, x: Int) {
    congruence_class_contains(Pair.new(Nat.1, r), x)
}

theorem singleton_mod_one_covering_system(r: Nat) {
    is_covering_system(List.cons(Pair.new(Nat.1, r), List.nil[Pair[Nat, Nat]]))
}

theorem head_modulus_divides_cons_modulus(head: Pair[Nat, Nat], tail: List[Pair[Nat, Nat]]) {
    head.first.divides(system_modulus(List.cons(head, tail)))
}

theorem tail_modulus_divides_cons_modulus(head: Pair[Nat, Nat], tail: List[Pair[Nat, Nat]]) {
    system_modulus(tail).divides(system_modulus(List.cons(head, tail)))
}

define covers_all_residues(system: List[Pair[Nat, Nat]]) -> Bool {
    forall(r: Nat) {
        r < system_modulus(system) implies covers_int(system, Int.from_nat(r))
    }
}

theorem covers_all_residues_intro(system: List[Pair[Nat, Nat]]) {
    (forall(r: Nat) {
        r < system_modulus(system) implies covers_int(system, Int.from_nat(r))
    }) implies covers_all_residues(system)
}

theorem covers_all_residues_apply(system: List[Pair[Nat, Nat]], r: Nat) {
    covers_all_residues(system) and r < system_modulus(system)
        implies covers_int(system, Int.from_nat(r))
}

theorem covering_system_covers_all_residues(system: List[Pair[Nat, Nat]]) {
    is_covering_system(system) implies covers_all_residues(system)
}

theorem normalized_representative_satisfies_all(system: List[Pair[Nat, Nat]], c: Nat) {
    every_modulus_positive(system) and satisfies_all(c, system)
        implies satisfies_all(c.mod(system_modulus(system)), system)
}

theorem normalized_representative_lt_system_modulus(system: List[Pair[Nat, Nat]], c: Nat) {
    every_modulus_positive(system) implies c.mod(system_modulus(system)) < system_modulus(system)
}

theorem normalized_crt_solution_exists(system: List[Pair[Nat, Nat]]) {
    pairwise_coprime(system_moduli(system)) and every_modulus_positive(system)
        implies exists(c: Nat) {
            satisfies_all(c, system) and c < system_modulus(system)
        }
}

theorem crt_canonical_solution_choice_exists(system: List[Pair[Nat, Nat]]) {
    exists(result: Nat) {
        pairwise_coprime(system_moduli(system)) and every_modulus_positive(system) implies
            satisfies_all(result, system) and result < system_modulus(system)
    }
}

let crt_canonical_solution(system: List[Pair[Nat, Nat]]) -> result: Nat satisfy {
    pairwise_coprime(system_moduli(system)) and every_modulus_positive(system) implies
        satisfies_all(result, system) and result < system_modulus(system)
}

theorem crt_canonical_satisfies_all(system: List[Pair[Nat, Nat]]) {
    pairwise_coprime(system_moduli(system)) and every_modulus_positive(system)
        implies satisfies_all(crt_canonical_solution(system), system)
}

theorem crt_canonical_lt_system_modulus(system: List[Pair[Nat, Nat]]) {
    pairwise_coprime(system_moduli(system)) and every_modulus_positive(system)
        implies crt_canonical_solution(system) < system_modulus(system)
}

theorem crt_canonical_congruent_to_solution(system: List[Pair[Nat, Nat]], c: Nat) {
    pairwise_coprime(system_moduli(system))
        and every_modulus_positive(system)
        and satisfies_all(c, system)
        implies crt_canonical_solution(system).congr_mod(c, system_modulus(system))
}

theorem solution_congruent_to_crt_canonical(system: List[Pair[Nat, Nat]], c: Nat) {
    pairwise_coprime(system_moduli(system))
        and every_modulus_positive(system)
        and satisfies_all(c, system)
        implies c.congr_mod(crt_canonical_solution(system), system_modulus(system))
}

theorem normalized_solution_eq_crt_canonical(system: List[Pair[Nat, Nat]], c: Nat) {
    pairwise_coprime(system_moduli(system))
        and every_modulus_positive(system)
        and satisfies_all(c, system)
        and c < system_modulus(system)
        implies c = crt_canonical_solution(system)
}

theorem crt_canonical_solution_unique(system: List[Pair[Nat, Nat]], c: Nat) {
    pairwise_coprime(system_moduli(system))
        and every_modulus_positive(system)
        implies ((satisfies_all(c, system) and c < system_modulus(system)) =
            (c = crt_canonical_solution(system)))
}

theorem congruence_class_contains_imp_in_residue_class(cl: Pair[Nat, Nat], k: Nat) {
    cl.second < cl.first and congruence_class_contains(cl, Int.from_nat(k))
        implies in_residue_class(cl.first, cl.second)(k)
}

theorem covers_int_imp_covers_nat(system: List[Pair[Nat, Nat]], k: Nat) {
    system_reduced(system) and covers_int(system, Int.from_nat(k))
        implies covers_nat(system)(k)
}

theorem covering_system_covers_nat(system: List[Pair[Nat, Nat]], k: Nat) {
    system_reduced(system) and is_covering_system(system)
        implies covers_nat(system)(k)
}

theorem count_upto_of_all(q: Nat -> Bool, n: Nat) {
    (forall(i: Nat) { q(i) }) implies count_upto(q, n) = n
}

theorem covering_system_density_ge_one(system: List[Pair[Nat, Nat]]) {
    system_reduced(system) and is_covering_system(system)
        implies Real.1 <= system_density_real(system)
}

define all_divide(list: List[Nat], n: Nat) -> Bool {
    forall(d: Nat) {
        list.contains(d) implies d.divides(n)
    }
}

theorem all_divide_cons_imp(head: Nat, tail: List[Nat], n: Nat) {
    all_divide(List.cons(head, tail), n) implies head.divides(n) and all_divide(tail, n)
}

theorem pairwise_coprime_product_divides(list: List[Nat], n: Nat) {
    pairwise_coprime(list) and all_divide(list, n) implies product[Nat](list).divides(n)
}

define range_pairwise_coprime(f: Nat -> Nat, n: Nat) -> Bool {
    forall(i: Nat, j: Nat) {
        i < n and j < n and i != j implies f(i).coprime(f(j))
    }
}

theorem coprime_range_prod(f: Nat -> Nat, a: Nat, n: Nat) {
    (forall(i: Nat) { i < n implies a.coprime(f(i)) })
        implies a.coprime(range_prod(f, n))
}

theorem range_pairwise_coprime_product_divides(f: Nat -> Nat, n: Nat, x: Nat) {
    range_pairwise_coprime(f, n) and (forall(i: Nat) { i < n implies f(i).divides(x) })
        implies range_prod(f, n).divides(x)
}

define prime_or_one(k: Nat) -> Nat {
    if k.is_prime {
        k
    } else {
        Nat.1
    }
}

theorem prime_or_one_prime(k: Nat) {
    k.is_prime implies prime_or_one(k) = k
}

theorem prime_or_one_composite(k: Nat) {
    not k.is_prime implies prime_or_one(k) = Nat.1
}

theorem prime_or_one_coprime(j: Nat, k: Nat) {
    j != k implies prime_or_one(j).coprime(prime_or_one(k))
}

define interval_prime_fn(a: Nat, i: Nat) -> Nat {
    prime_or_one(a + i)
}

theorem interval_prime_fn_pairwise_coprime(a: Nat, n: Nat) {
    range_pairwise_coprime(interval_prime_fn(a), n)
}

define primes_in_interval_divide(a: Nat, n: Nat, x: Nat) -> Bool {
    forall(i: Nat) {
        i < n and (a + i).is_prime implies (a + i).divides(x)
    }
}

theorem interval_prime_product_divides(a: Nat, n: Nat, x: Nat) {
    primes_in_interval_divide(a, n, x)
        implies range_prod(interval_prime_fn(a), n).divides(x)
}

theorem central_binom_prime_interval_product_divides(m: Nat) {
    range_prod(interval_prime_fn(m.suc.suc), m.suc).divides(central_binom(m.suc))
}

theorem prime_in_interval_divides_odd_binom(p: Nat, m: Nat) {
    p.is_prime and m.suc < p and p <= m + m.suc
        implies p.divides((m + m.suc).binom(m))
}

theorem odd_binom_prime_interval_product_divides(m: Nat) {
    range_prod(interval_prime_fn(m.suc.suc), m).divides((m + m.suc).binom(m))
}

theorem odd_prime_interval_product_lte(m: Nat) {
    range_prod(interval_prime_fn(m.suc.suc), m) <= Nat.4.pow(m)
}

define primorial(n: Nat) -> Nat {
    range_prod(prime_or_one, n.suc)
}

theorem primorial_zero {
    primorial(Nat.0) = Nat.1
}

theorem primorial_suc(n: Nat) {
    primorial(n.suc) = primorial(n) * prime_or_one(n.suc)
}

theorem prime_or_one_lte(x: Nat) {
    Nat.1 <= x implies prime_or_one(x) <= x
}

theorem prod_shift_prime_or_one(a: Nat) {
    prod_shift_fn(prime_or_one, a) = interval_prime_fn(a)
}

theorem primorial_odd_split(m: Nat) {
    (primorial(m + m.suc)
        = primorial(m.suc) * range_prod(interval_prime_fn(m.suc.suc), m))
}

theorem primorial_one {
    primorial(Nat.1) = Nat.1
}

theorem primorial_composite_step(j: Nat) {
    j.suc.is_composite implies primorial(j.suc) = primorial(j)
}

theorem double_is_composite(t: Nat) {
    Nat.1 < t implies (t + t).is_composite
}

theorem nat_parity(n: Nat) {
    exists(m: Nat) {
        n = m + m or n = m + m.suc
    }
}

theorem four_pow_mono(a: Nat, b: Nat) {
    a <= b implies Nat.4.pow(a) <= Nat.4.pow(b)
}

theorem lte_mul_pair(a: Nat, b: Nat, c: Nat, d: Nat) {
    a <= b and c <= d implies a * c <= b * d
}

theorem primorial_lte_four_pow(n: Nat) {
    primorial(n) <= Nat.4.pow(n)
}

define is_pell_solution(d: Int, x: Int, y: Int) -> Bool {
    x * x - d * (y * y) = Int.1
}

define pell_norm(d: Int, x: Int, y: Int) -> Int {
    x * x - d * (y * y)
}

theorem pell_trivial_solution(d: Int) {
    is_pell_solution(d, Int.1, Int.0)
}

theorem pell_two_square_identity {
    Int.3 * Int.3 - Int.2 * (Int.2 * Int.2) = Int.1
}

theorem pell_two_smallest {
    is_pell_solution(Int.2, Int.3, Int.2)
}

define pell_next_x(d: Int, x: Int, y: Int) -> Int {
    x * x + d * (y * y)
}

define pell_next_y(d: Int, x: Int, y: Int) -> Int {
    Int.2 * x * y
}

theorem pell_rearrange_flatten(a: Int, b: Int, c: Int, d: Int) {
    (a + b) - c - d = a + b - c - d
}

theorem pell_rearrange_regroup(a: Int, b: Int, c: Int, d: Int) {
    a - b - c + d = (a + d) - b - c
}

theorem pell_rearrange_sub_sum(a: Int, b: Int, c: Int) {
    a - (b + c) = a - b - c
}

theorem pell_rearrange_cancel(a: Int, b: Int, c: Int) {
    (a + b + c + c) - (c + c + c + c) = a + b - c - c
}

theorem pell_rearrange_sub_sub(a: Int, b: Int, c: Int, d: Int) {
    (a - b) - (c - d) = a - b - c + d
}

theorem pell_cross_term_eq(d: Int, x: Int, y: Int) {
    d * (x * y) * (x * y) = (x * x) * (d * (y * y))
}

theorem pell_square_identity(d: Int, x: Int, y: Int) {
    (x * x + d * (y * y)) * (x * x + d * (y * y)) -
        d * ((Int.2 * x * y) * (Int.2 * x * y)) =
    (x * x - d * (y * y)) * (x * x - d * (y * y))
}

theorem pell_solution_square(d: Int, x: Int, y: Int) {
    is_pell_solution(d, x, y) implies
        is_pell_solution(d, pell_next_x(d, x, y), pell_next_y(d, x, y))
}

define sqrt_two_continued_fraction_coefficients(n: Nat) -> Nat {
    if n = Nat.0 { Nat.1 } else { Nat.2 }
}

theorem sqrt_two_convergent_numerator_zero {
    continued_fraction_convergent_numerator(
        sqrt_two_continued_fraction_coefficients, Nat.0) = Nat.1
}

theorem sqrt_two_convergent_denominator_zero {
    continued_fraction_convergent_denominator(
        sqrt_two_continued_fraction_coefficients, Nat.0) = Nat.1
}

theorem sqrt_two_convergent_numerator_one {
    continued_fraction_convergent_numerator(
        sqrt_two_continued_fraction_coefficients, Nat.1) = Nat.3
}

theorem sqrt_two_convergent_denominator_one {
    continued_fraction_convergent_denominator(
        sqrt_two_continued_fraction_coefficients, Nat.1) = Nat.2
}

theorem sqrt_two_adjacent_cross_product {
    Int.from_nat(Nat.3) * Int.from_nat(Nat.1) -
        Int.from_nat(Nat.1) * Int.from_nat(Nat.2) = Int.1
}

theorem pell_two_fundamental_solution_from_convergents {
    is_pell_solution(Int.2,
        Int.from_nat(continued_fraction_convergent_numerator(
            sqrt_two_continued_fraction_coefficients, Nat.1)),
        Int.from_nat(continued_fraction_convergent_denominator(
            sqrt_two_continued_fraction_coefficients, Nat.1)))
}

theorem cf_pell_compose_step_numerator_comm(x: Nat, y: Nat) {
    x * Nat.2 + y = Nat.2 * x + y
}

theorem cf_pell_compose_step_numerator_expand(x: Nat, y: Nat) {
    Nat.2 * (x + Nat.2 * y) + x = (x + Nat.2 * y) + (x + Nat.2 * y) + x
}

theorem cf_pell_compose_step_numerator_assoc(x: Nat, y: Nat) {
    (x + Nat.2 * y) + (x + Nat.2 * y) + x =
        (x + Nat.2 * y) + ((x + Nat.2 * y) + x)
}

theorem cf_pell_compose_step_numerator_inner(x: Nat, y: Nat) {
    (x + Nat.2 * y) + x = Nat.2 * (x + y)
}

theorem cf_pell_compose_step_numerator_bridge(x: Nat, y: Nat) {
    (x + Nat.2 * y) + ((x + Nat.2 * y) + x) =
        (x + Nat.2 * y) + Nat.2 * (x + y)
}

theorem cf_pell_compose_step_denominator_expand(x: Nat, y: Nat) {
    Nat.2 * (x + y) + y = (x + y) + (x + y) + y
}

theorem cf_pell_compose_step_denominator_assoc(x: Nat, y: Nat) {
    (x + y) + (x + y) + y = (x + y) + ((x + y) + y)
}

theorem cf_pell_compose_step_denominator_bridge(x: Nat, y: Nat) {
    (x + y) + ((x + y) + y) = (x + y) + (x + Nat.2 * y)
}

theorem cf_pell_convergent_compose_step_zero {
    continued_fraction_convergent_numerator(
            sqrt_two_continued_fraction_coefficients, Nat.1) =
        continued_fraction_convergent_numerator(
            sqrt_two_continued_fraction_coefficients, Nat.0) +
            Nat.2 * continued_fraction_convergent_denominator(
                sqrt_two_continued_fraction_coefficients, Nat.0) and
    continued_fraction_convergent_denominator(
            sqrt_two_continued_fraction_coefficients, Nat.1) =
        continued_fraction_convergent_numerator(
            sqrt_two_continued_fraction_coefficients, Nat.0) +
            continued_fraction_convergent_denominator(
                sqrt_two_continued_fraction_coefficients, Nat.0)
}

theorem cf_pell_convergent_compose_step(n: Nat) {
    continued_fraction_convergent_numerator(
            sqrt_two_continued_fraction_coefficients, n.suc) =
        continued_fraction_convergent_numerator(
            sqrt_two_continued_fraction_coefficients, n) +
            Nat.2 * continued_fraction_convergent_denominator(
                sqrt_two_continued_fraction_coefficients, n) and
    continued_fraction_convergent_denominator(
            sqrt_two_continued_fraction_coefficients, n.suc) =
        continued_fraction_convergent_numerator(
            sqrt_two_continued_fraction_coefficients, n) +
            continued_fraction_convergent_denominator(
                sqrt_two_continued_fraction_coefficients, n)
}

theorem cf_pell_sub_pair_identity(a: Int, b: Int, c: Int, d: Int) {
    (a + b) - (c + d) = (a - c) + (b - d)
}

theorem cf_pell_norm_x2_regroup(x: Int, y: Int) {
    x * x - Int.2 * (x * x) = -x * x
}

theorem cf_pell_norm_y2_regroup(x: Int, y: Int) {
