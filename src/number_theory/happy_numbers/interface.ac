theorem frac_of_frac(x: Real) {
    frac(frac(x)) = frac(x)
}

theorem circular_distance_of_frac(x: Real) {
    circular_distance(x) = circular_distance(frac(x))
}

theorem cd_iff_frac_interval(x: Real, b: Real) {
    b <= circular_distance(x) = (b <= frac(x) and frac(x) <= Real.1 - b)
}

theorem lonely_runner_two_frac_view(t: Real) {
    (Real.1 / from_nat[Real](Nat.3) <= circular_distance(Real.1 * t)
        = (Real.1 / from_nat[Real](Nat.3) <= frac(Real.1 * t)
            and frac(Real.1 * t) <= from_nat[Real](Nat.2) / from_nat[Real](Nat.3)))
}

theorem lonely_runner_three_frac_view_one(t: Real) {
    (Real.1 / from_nat[Real](Nat.4) <= circular_distance(Real.1 * t)
        = (Real.1 / from_nat[Real](Nat.4) <= frac(Real.1 * t)
            and frac(Real.1 * t) <= from_nat[Real](Nat.3) / from_nat[Real](Nat.4)))
}

theorem lonely_runner_three_frac_view_two(t: Real) {
    (Real.1 / from_nat[Real](Nat.4) <= circular_distance(from_nat[Real](Nat.2) * t)
        = (Real.1 / from_nat[Real](Nat.4) <= frac(from_nat[Real](Nat.2) * t)
            and frac(from_nat[Real](Nat.2) * t) <= from_nat[Real](Nat.3) / from_nat[Real](Nat.4)))
}

theorem lonely_runner_two_speeds_01 {
    exists(t: Real) {
        Real.1 / from_nat[Real](Nat.3) <= circular_distance(Real.1 * t)
    }
}

theorem lonely_runner_two_restated {
    exists(t: Real) {
        Real.1 / from_nat[Real](Nat.3) <= circular_distance(Real.1 * t)
    }
}

theorem lonely_runner_two_frac_witness {
    exists(t: Real) {
        Real.1 / from_nat[Real](Nat.3) <= frac(Real.1 * t)
            and frac(Real.1 * t) <= from_nat[Real](Nat.2) / from_nat[Real](Nat.3)
    }
}

theorem lonely_runner_three_speeds_012 {
    exists(t: Real) {
        Real.1 / from_nat[Real](Nat.4) <= circular_distance(Real.1 * t)
            and Real.1 / from_nat[Real](Nat.4) <= circular_distance(from_nat[Real](Nat.2) * t)
    }
}

theorem lonely_runner_three_frac_witness {
    exists(t: Real) {
        Real.1 / from_nat[Real](Nat.4) <= frac(Real.1 * t)
            and frac(Real.1 * t) <= from_nat[Real](Nat.3) / from_nat[Real](Nat.4)
            and Real.1 / from_nat[Real](Nat.4) <= frac(from_nat[Real](Nat.2) * t)
            and frac(from_nat[Real](Nat.2) * t) <= from_nat[Real](Nat.3) / from_nat[Real](Nat.4)
    }
}

theorem lonely_runner_equispaced(n: Nat) {
    exists(t: Real) {
        forall(i: Nat) {
            Nat.1 <= i and i <= n implies
                Real.1 / from_nat[Real](n + Nat.2) <= circular_distance(from_nat[Real](i) * t)
        }
    }
}

theorem lonely_runner_equispaced_frac_view(n: Nat) {
    exists(t: Real) {
        forall(i: Nat) {
            Nat.1 <= i and i <= n implies
                Real.1 / from_nat[Real](n + Nat.2) <= frac(from_nat[Real](i) * t)
                and frac(from_nat[Real](i) * t)
                    <= from_nat[Real](n + Nat.1) / from_nat[Real](n + Nat.2)
        }
    }
}

theorem sum_filter_split2(l: List[Nat], p: Nat -> Bool, q: Nat -> Bool,
    f: Nat -> Int) {
    (forall(x: Nat) { l.contains(x) implies (q(x) = not p(x)) })
        implies sum(map(l, f)) =
            sum(map(l.filter(p), f)) + sum(map(l.filter(q), f))
}

theorem sum_filter_zero_removed(l: List[Nat], pred: Nat -> Bool, f: Nat -> Int) {
    (forall(x: Nat) { l.contains(x) and not pred(x) implies f(x) = Int.0 })
        implies sum(map(l, f)) = sum(map(l.filter(pred), f))
}

theorem int_sum_map_neg(l: List[Nat], f: Nat -> Int) {
    sum(map(l, function(x: Nat) { -f(x) })) = -sum(map(l, f))
}

theorem remove_one_length_suc[T](list: List[T], item: T) {
    list.contains(item) implies list.remove_one(item).length.suc = list.length
}

define not_divides_pred(p: Nat) -> (Nat -> Bool) {
    function(d: Nat) { not p.divides(d) }
}

define divides_pred(p: Nat) -> (Nat -> Bool) {
    function(d: Nat) { p.divides(d) }
}

theorem sum_split_by_p(l: List[Nat], p: Nat, f: Nat -> Int) {
    sum(map(l, f)) =
        sum(map(l.filter(not_divides_pred(p)), f)) + sum(map(l.filter(divides_pred(p)), f))
}

theorem int_modular_inverse_exists(a: Nat, n: Nat) {
    a.coprime(n) implies
        exists(b: Int) { int_mod_rel(n, b * Int.from_nat(a), Int.1) }
}

theorem nat_modular_inverse_exists_pos(a: Nat, n: Nat) {
    n != Nat.0 and a.coprime(n) implies exists(b: Nat) { (a * b).congr_mod(Nat.1, n) }
}

theorem nat_modular_inverse_exists_zero(a: Nat) {
    a.coprime(Nat.0) implies exists(b: Nat) { (a * b).congr_mod(Nat.1, Nat.0) }
}

theorem nat_modular_inverse_exists(a: Nat, n: Nat) {
    a.coprime(n) implies exists(b: Nat) { (a * b).congr_mod(Nat.1, n) }
}

theorem mod_inv_unique_left_scale(a: Nat, n: Nat, b1: Nat, b2: Nat) {
    (a * b2).congr_mod(Nat.1, n) implies (b1 * (a * b2)).congr_mod(b1, n)
}

theorem mod_inv_unique_right_scale(a: Nat, n: Nat, b1: Nat, b2: Nat) {
    (a * b1).congr_mod(Nat.1, n) implies ((a * b1) * b2).congr_mod(b2, n)
}

theorem mod_inv_assoc_swap(a: Nat, b1: Nat, b2: Nat) {
    b1 * (a * b2) = (a * b1) * b2
}

theorem mod_inv_unique_congr(a: Nat, n: Nat, b1: Nat, b2: Nat) {
    (a * b1).congr_mod(Nat.1, n) and (a * b2).congr_mod(Nat.1, n)
        implies b1.congr_mod(b2, n)
}

theorem is_mod_inv_iff_congr(a: Nat, b: Nat, n: Nat) {
    a.is_mod_inv(b, n) = (a * b).congr_mod(Nat.1, n)
}

theorem mod_inv_unique(a: Nat, n: Nat, b1: Nat, b2: Nat) {
    a.is_mod_inv(b1, n) and a.is_mod_inv(b2, n) implies b1.congr_mod(b2, n)
}

let mod_inv(a: Nat, n: Nat) -> b: Nat satisfy {
    if a.coprime(n) {
        a.is_mod_inv(b, n)
    } else {
        b = Nat.0
    }
}

theorem mod_inv_correct(a: Nat, n: Nat) {
    a.coprime(n) implies a.is_mod_inv(mod_inv(a, n), n)
}

theorem mod_inv_mul_congr_one(a: Nat, n: Nat) {
    a.coprime(n) implies (a * mod_inv(a, n)).congr_mod(Nat.1, n)
}

theorem mul_left_compat(a: Nat, x: Nat, y: Nat, n: Nat, c: Nat) {
    (a * x).congr_mod(a * y, n)
        implies (c * (a * x)).congr_mod(c * (a * y), n)
}

theorem mul_one_congr_left(c: Nat, n: Nat, x: Nat) {
    c.congr_mod(Nat.1, n) implies (c * x).congr_mod(x, n)
}

theorem cancel_coprime_pin(b: Nat, a: Nat, n: Nat, x: Nat, y: Nat) {
    (b * a).congr_mod(Nat.1, n)
        implies x.congr_mod((b * a) * x, n) and ((b * a) * y).congr_mod(y, n)
}

theorem cancel_one_chain_left(c: Nat, n: Nat, x: Nat, y: Nat) {
    c.congr_mod(Nat.1, n) and (c * x).congr_mod(c * y, n)
        implies x.congr_mod(c * y, n)
}

theorem cancel_one_chain_right(c: Nat, n: Nat, x: Nat, y: Nat) {
    c.congr_mod(Nat.1, n) and x.congr_mod(c * y, n)
        implies x.congr_mod(y, n)
}

theorem cancel_one_chain(c: Nat, n: Nat, x: Nat, y: Nat) {
    c.congr_mod(Nat.1, n) and (c * x).congr_mod(c * y, n)
        implies x.congr_mod(y, n)
}

theorem cancel_with_inverse_setup(a: Nat, b: Nat, n: Nat, x: Nat, y: Nat) {
    (a * x).congr_mod(a * y, n)
        implies ((b * a) * x).congr_mod((b * a) * y, n)
}

theorem cancel_with_inverse(a: Nat, b: Nat, n: Nat, x: Nat, y: Nat) {
    (b * a).congr_mod(Nat.1, n) and (a * x).congr_mod(a * y, n)
        implies x.congr_mod(y, n)
}

theorem cancel_coprime(a: Nat, n: Nat, x: Nat, y: Nat) {
    a.coprime(n) and (a * x).congr_mod(a * y, n)
        implies x.congr_mod(y, n)
}

theorem inverse_imp_product_coprime(a: Nat, b: Nat, n: Nat) {
    (a * b).congr_mod(Nat.1, n) implies (a * b).coprime(n)
}

theorem product_coprime_imp_right(a: Nat, b: Nat, n: Nat) {
    (a * b).coprime(n) implies b.coprime(n)
}

theorem inverse_imp_coprime(a: Nat, b: Nat, n: Nat) {
    (a * b).congr_mod(Nat.1, n) implies b.coprime(n)
}

theorem mod_inv_coprime(a: Nat, n: Nat) {
    a.coprime(n) implies (mod_inv(a, n)).coprime(n)
}

theorem coprime_mul_right_pair(a: Nat, b: Nat, n: Nat) {
    a.coprime(n) and b.coprime(n) implies (a * b).coprime(n)
}

theorem mod_inv_mul_product_congr_one(a: Nat, b: Nat, n: Nat) {
    a.coprime(n) and b.coprime(n) implies
        (a * b * (mod_inv(b, n) * mod_inv(a, n))).congr_mod(Nat.1, n)
}

theorem mod_inv_mul_congr(a: Nat, b: Nat, n: Nat) {
    a.coprime(n) and b.coprime(n) implies
        mod_inv(a * b, n).congr_mod(mod_inv(b, n) * mod_inv(a, n), n)
}

theorem mod_inv_one_congr(n: Nat) {
    mod_inv(Nat.1, n).congr_mod(Nat.1, n)
}

theorem mod_inv_congr(a: Nat, b: Nat, n: Nat) {
    a.congr_mod(b, n) and a.coprime(n) and b.coprime(n) implies
        mod_inv(a, n).congr_mod(mod_inv(b, n), n)
}

theorem mod_inv_involutive_congr(a: Nat, n: Nat) {
    a.coprime(n) implies mod_inv(mod_inv(a, n), n).congr_mod(a, n)
}

theorem prime_does_not_divide_below(p: Nat, m: Nat) {
    p.is_prime and Nat.0 < m and m < p implies not p.divides(m)
}

theorem prime_not_divides_factorial_step(p: Nat, k: Nat) {
    p.is_prime and not p.divides(k.factorial) and not p.divides(k.suc)
        implies not p.divides(k.suc.factorial)
}

define p_no_div_fact_pred(p: Nat) -> (Nat -> Bool) {
    function(x: Nat) {
        x < p implies not p.divides(x.factorial)
    }
}

theorem prime_no_div_fact_zero(p: Nat) {
    p.is_prime implies p_no_div_fact_pred(p)(Nat.0)
}

theorem prime_no_div_fact_step(p: Nat, k: Nat) {
    p.is_prime and p_no_div_fact_pred(p)(k) implies p_no_div_fact_pred(p)(k.suc)
}

theorem prime_does_not_divide_factorial(p: Nat, m: Nat) {
    p.is_prime and m < p implies not p.divides(m.factorial)
}

theorem prime_divides_mul(p: Nat, a: Nat, b: Nat) {
    p.is_prime and p.divides(a * b) implies p.divides(a) or p.divides(b)
}

theorem prime_divides_self_factorial(p: Nat) {
    p.is_prime implies p.divides(p.factorial)
}

theorem prime_divides_binom(p: Nat, k: Nat) {
    p.is_prime and Nat.0 < k and k < p implies p.divides(p.binom(k))
}

define divides_partial_pred(d: Nat, f: Nat -> Nat) -> (Nat -> Bool) {
    function(m: Nat) {
        (forall(k: Nat) { k < m implies d.divides(f(k)) })
            implies d.divides(partial[Nat](f, m))
    }
}

theorem divides_partial_nat_zero(d: Nat, f: Nat -> Nat) {
    divides_partial_pred(d, f)(Nat.0)
}

theorem divides_partial_nat_step(d: Nat, f: Nat -> Nat, m: Nat) {
    divides_partial_pred(d, f)(m)
        implies divides_partial_pred(d, f)(m.suc)
}

theorem sub_one_pred(p: Nat, pp: Nat) {
    pp.suc = p implies p - Nat.1 = pp
}

theorem suc_sub_two_pred(p: Nat, pp: Nat) {
    pp.suc = p implies p.suc - Nat.2 = pp
}

theorem suc_sub_two_eq_sub_one(p: Nat) {
    Nat.1 < p implies p.suc - Nat.2 = p - Nat.1
}

theorem suc_sub_one_eq(p: Nat) {
    p.suc - Nat.1 = p
}

theorem suc_geq_two(p: Nat) {
    Nat.1 < p implies p.suc >= Nat.2
}

theorem divides_partial_nat(d: Nat, f: Nat -> Nat, n: Nat) {
    (forall(k: Nat) { k < n implies d.divides(f(k)) })
        implies d.divides(partial[Nat](f, n))
}

theorem prime_divides_binomial_term_middle(p: Nat, a: Nat, b: Nat, k: Nat) {
    p.is_prime and Nat.0 < k and k < p
        implies p.divides(binomial_term(a, b, p, k))
}

theorem binomial_term_left_boundary(a: Nat, b: Nat, p: Nat) {
    binomial_term(a, b, p, Nat.0) = b.pow(p)
}

theorem binomial_term_right_boundary(a: Nat, b: Nat, p: Nat) {
    binomial_term(a, b, p, p) = a.pow(p)
}

theorem shifted_binom_term_div(p: Nat, a: Nat, b: Nat, k: Nat) {
    p.is_prime and k < p - Nat.1
        implies p.divides(compose(binomial_term(a, b, p), Nat.suc)(k))
}

theorem prime_divides_binomial_middle(p: Nat, a: Nat, b: Nat) {
    p.is_prime implies
        p.divides(partial[Nat](compose(binomial_term(a, b, p), Nat.suc), p - Nat.1))
}

theorem binomial_pow_split(a: Nat, b: Nat, p: Nat) {
    Nat.1 < p implies
        (a + b).pow(p) =
            b.pow(p) + partial[Nat](compose(binomial_term(a, b, p), Nat.suc), p - Nat.1) + a.pow(p)
}

theorem divides_imp_congr_zero(d: Nat, x: Nat) {
    d.divides(x) implies x.congr_mod(Nat.0, d)
}

theorem freshmans_dream(p: Nat, a: Nat, b: Nat) {
    p.is_prime implies (a + b).pow(p).congr_mod(a.pow(p) + b.pow(p), p)
}

define fermat_pred(p: Nat) -> (Nat -> Bool) {
    function(a: Nat) {
        a.pow(p).congr_mod(a, p)
    }
}

theorem fermat_base(p: Nat) {
    p.is_prime implies fermat_pred(p)(Nat.0)
}

theorem fermat_step(p: Nat, a: Nat) {
    p.is_prime and fermat_pred(p)(a) implies fermat_pred(p)(a.suc)
}

theorem fermat_pred_unfold(p: Nat, a: Nat) {
    fermat_pred(p)(a) = a.pow(p).congr_mod(a, p)
}

theorem fermats_little_run(p: Nat, a: Nat) {
    p.is_prime implies fermat_pred(p)(a)
}

theorem fermats_little_congr(p: Nat, a: Nat) {
    p.is_prime implies a.pow(p).congr_mod(a, p)
}

theorem fermats_little(p: Nat, a: Nat) {
    p.is_prime implies a.pow(p).mod(p) = a.mod(p)
}

theorem mul_pow_pred_eq_pow(m: Nat, p: Nat) {
    p.is_prime implies m * m.pow(p - Nat.1) = m.pow(p)
}

define rsa_pow_pred(m: Nat, p: Nat) -> (Nat -> Bool) {
    function(k: Nat) {
        m.pow(k * (p - Nat.1) + Nat.1).congr_mod(m, p)
    }
}

theorem rsa_pow_base(m: Nat, p: Nat) {
    rsa_pow_pred(m, p)(Nat.0)
}

theorem rsa_pow_step(m: Nat, p: Nat, k: Nat) {
    p.is_prime and rsa_pow_pred(m, p)(k) implies rsa_pow_pred(m, p)(k.suc)
}

theorem rsa_pow_run(p: Nat, m: Nat, k: Nat) {
    p.is_prime implies rsa_pow_pred(m, p)(k)
}

theorem rsa_pow_congr(p: Nat, m: Nat, k: Nat) {
    p.is_prime implies m.pow(k * (p - Nat.1) + Nat.1).congr_mod(m, p)
}

theorem fermat_euler_split(p: Nat, m: Nat) {
    p.is_prime
        implies (m * m.pow(p - Nat.1)).congr_mod(m * Nat.1, p)
}

theorem fermat_euler(p: Nat, m: Nat) {
    p.is_prime and m.coprime(p)
        implies m.pow(p - Nat.1).congr_mod(Nat.1, p)
}

theorem falling_product_factor_divides(n: Nat, k: Nat, i: Nat) {
    i <= k implies (n - i).divides(falling_product(n, k))
}

theorem prime_divides_falling_product_factor(n: Nat, k: Nat, q: Nat) {
    q.is_prime and q.divides(falling_product(n, k))
        implies exists(i: Nat) { i <= k and q.divides(n - i) }
}

theorem prime_factor_divides_falling_product(n: Nat, k: Nat, q: Nat, i: Nat) {
    i <= k and q.divides(n - i) implies q.divides(falling_product(n, k))
}

theorem prime_divides_falling_product_iff(n: Nat, k: Nat, q: Nat) {
    q.is_prime implies (q.divides(falling_product(n, k))
        = exists(i: Nat) { i <= k and q.divides(n - i) })
}

define nat_mobius(n: Nat) -> Int {
    if n = Nat.0 {
        Int.0
    } else {
        if prime_factorisation(n).is_unique {
            alternating_sign[Int](prime_factorisation(n).length)
        } else {
            Int.0
        }
    }
}

theorem nat_mobius_zero {
    nat_mobius(Nat.0) = Int.0
}

theorem count_le_length[T](list: List[T], item: T) {
    list.count(item) <= list.length
}

theorem list_length_zero_imp_nil[T](list: List[T]) {
    list.length = Nat.0 implies list = List.nil[T]
}

theorem unique_of_length_one[T](list: List[T]) {
    list.length = Nat.1 implies list.is_unique
}

theorem singleton_permutation_eq[T](x: T, list: List[T]) {
    is_permutation(List.singleton(x), list) implies list = List.singleton(x)
}

theorem prime_factorisation_one {
    prime_factorisation(Nat.1) = List.nil[Nat]
}

theorem prime_factorisation_prime(p: Nat) {
    p.is_prime implies prime_factorisation(p) = List.singleton(p)
}

theorem nat_mobius_one {
    nat_mobius(Nat.1) = Int.1
}

theorem nat_mobius_prime(p: Nat) {
    p.is_prime implies nat_mobius(p) = -Int.1
}

theorem list_member_divides_product(l: List[Nat], x: Nat) {
    l.contains(x) implies x.divides(product[Nat](l))
}

define append_unique_no_shared_pred[T](l2: List[T]) -> (List[T] -> Bool) {
    function(ls: List[T]) {
        ls.is_unique and l2.is_unique and
            (forall(x: T) { ls.contains(x) implies not l2.contains(x) })
            implies (ls + l2).is_unique
    }
}

theorem append_unique_of_no_shared_base[T](l2: List[T]) {
    (List.nil[T].is_unique and l2.is_unique and
        (forall(x: T) { List.nil[T].contains(x) implies not l2.contains(x) }))
        implies (List.nil[T] + l2).is_unique
}

theorem append_unique_of_no_shared_step[T](head: T, tail: List[T], l2: List[T]) {
    (tail.is_unique and l2.is_unique and
        (forall(x: T) { tail.contains(x) implies not l2.contains(x) })
        implies (tail + l2).is_unique) implies
        (List.cons(head, tail).is_unique and l2.is_unique and
            (forall(x: T) {
                List.cons(head, tail).contains(x) implies not l2.contains(x)
            })
            implies (List.cons(head, tail) + l2).is_unique)
}

theorem append_unique_of_no_shared[T](l1: List[T], l2: List[T]) {
    l1.is_unique and l2.is_unique and
        (forall(x: T) { l1.contains(x) implies not l2.contains(x) })
        implies (l1 + l2).is_unique
}

theorem permutation_of_unique_is_unique[T](a: List[T], b: List[T]) {
    is_permutation(a, b) and a.is_unique implies b.is_unique
}

theorem alternating_sign_add[R: Ring](m: Nat, n: Nat) {
    alternating_sign[R](m + n) = alternating_sign[R](m) * alternating_sign[R](n)
}

theorem int_alternating_sign_nonzero(k: Nat) {
    alternating_sign[Int](k) != Int.0
}

theorem nat_mobius_nonzero_iff_factorisation_unique(n: Nat) {
    Nat.0 < n implies (nat_mobius(n) != Int.0) = prime_factorisation(n).is_unique
}

theorem nat_le_add_right(x: Nat, y: Nat) {
    x <= x + y
}

theorem nat_mobius_mul_left_nonunique(a: Nat, b: Nat) {
    a != Nat.0 and b != Nat.0 and not prime_factorisation(a).is_unique
        implies nat_mobius(a * b) = nat_mobius(a) * nat_mobius(b)
}

theorem nat_mobius_mul_right_nonunique(a: Nat, b: Nat) {
    a != Nat.0 and b != Nat.0 and not prime_factorisation(b).is_unique
        implies nat_mobius(a * b) = nat_mobius(a) * nat_mobius(b)
}

theorem nat_mobius_mul_unique(a: Nat, b: Nat) {
    a != Nat.0 and b != Nat.0 and prime_factorisation(a).is_unique and
        prime_factorisation(b).is_unique and a.coprime(b)
        implies nat_mobius(a * b) = nat_mobius(a) * nat_mobius(b)
}

theorem nat_mobius_multiplicative_apply(a: Nat, b: Nat) {
    a.coprime(b) implies nat_mobius(a * b) = nat_mobius(a) * nat_mobius(b)
}

define nat_mobius_support(d: Nat) -> Bool {
    nat_mobius(d) != Int.0
}

define mul_by_nat(p: Nat) -> (Nat -> Nat) {
    function(x: Nat) { p * x }
}

theorem nat_mobius_remove_prime(x: Nat, p: Nat) {
    Nat.0 < x and p.is_prime and p.divides(x) and prime_factorisation(x).is_unique
        implies
            nat_mobius(divisor_quotient(x, p)) != Int.0
            and not p.divides(divisor_quotient(x, p))
            and nat_mobius(x) = -nat_mobius(divisor_quotient(x, p))
}

theorem mobius_pair_forward(n: Nat, p: Nat, d: Nat) {
    Nat.0 < n and p.is_prime and p.divides(n) and
        divisor_list(n).filter(nat_mobius_support).contains(d) and
        not p.divides(d)
        implies
            divisor_list(n).filter(nat_mobius_support).contains(p * d) and
            nat_mobius(p * d) = -nat_mobius(d)
}

theorem mobius_pair_backward(n: Nat, p: Nat, x: Nat) {
    Nat.0 < n and p.is_prime and p.divides(n) and
        divisor_list(n).filter(nat_mobius_support).contains(x) and
        p.divides(x)
        implies
            divisor_list(n).filter(nat_mobius_support).contains(divisor_quotient(x, p)) and
            not p.divides(divisor_quotient(x, p)) and
            x = p * divisor_quotient(x, p)
}

theorem mobius_pair_image_permutation(n: Nat, p: Nat) {
    Nat.0 < n and p.is_prime and p.divides(n) implies
        is_permutation(
            map(divisor_list(n).filter(nat_mobius_support).filter(not_divides_pred(p)),
                mul_by_nat(p)),
            divisor_list(n).filter(nat_mobius_support).filter(divides_pred(p)))
}

theorem nat_mobius_pair_sum(n: Nat, p: Nat) {
    Nat.0 < n and p.is_prime and p.divides(n) implies
        sum(map(divisor_list(n), nat_mobius)) = Int.0
}

theorem nat_mobius_pair_sum_imp(n: Nat, p: Nat) {
    (Nat.0 < n) implies (p.is_prime implies (p.divides(n) implies
        sum(map(divisor_list(n), nat_mobius)) = Int.0))
}

theorem nat_mobius_divisor_sum_one {
    sum(map(divisor_list(Nat.1), nat_mobius)) = Int.1
}

theorem nat_lt_one_of_nonzero_nonone(n: Nat) {
    n != Nat.0 and n != Nat.1 implies Nat.1 < n
}

theorem nat_mobius_divisor_sum_at_zero {
    sum(map(divisor_list(Nat.0), nat_mobius)) = Int.0
}

theorem nat_zero_lt_of_lt_one(n: Nat) {
    Nat.1 < n implies Nat.0 < n
}

theorem nat_mobius_divisor_sum_gt_one(n: Nat) {
    Nat.1 < n implies sum(map(divisor_list(n), nat_mobius)) = Int.0
}

theorem nat_mobius_divisor_sum_off_one(n: Nat) {
    n != Nat.1 implies sum(map(divisor_list(n), nat_mobius)) = Int.0
}

theorem nat_mobius_divisor_sum(n: Nat) {
    sum(map(divisor_list(n), nat_mobius)) = if n = Nat.1 { Int.1 } else { Int.0 }
}

define mertens(n: Nat) -> Int {
    sum(map(n.suc.range, nat_mobius))
}

theorem mertens_zero {
    mertens(Nat.0) = Int.0
}

theorem mertens_one {
    mertens(Nat.1) = Int.1
