    dirichlet_term_mul_coprime_divisors_hyp(f, g, a, b, d, e)
        implies dirichlet_term(f, g, a * b)(d * e) =
            dirichlet_term(f, g, a)(d) * dirichlet_term(f, g, b)(e)
}

define divisor_pair_mul(p: Pair[Nat, Nat]) -> Nat {
