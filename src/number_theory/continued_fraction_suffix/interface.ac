theorem division_algorithm(a: Nat, q: Nat, r: Nat, m: Nat) {
    a = q * m + r and r < m implies a.div(m) = q and a.mod(m) = r
}

theorem divides_iff_mod_zero(a: Nat, m: Nat) {
