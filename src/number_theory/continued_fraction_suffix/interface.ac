theorem dsa_sign_r_lt(p: Nat, q: Nat, g: Nat, k: Nat) {
    q != 0 implies dsa_sign_r(p, q, g, k) < q
}

theorem dsa_sign_s_lt(q: Nat, h: Nat, x: Nat, r: Nat, kinv: Nat) {
    q != 0 implies dsa_sign_s(q, h, x, r, kinv) < q
}

define dsa_verify(p: Nat, q: Nat, g: Nat, y: Nat, h: Nat,
                  r: Nat, s: Nat, sinv: Nat) -> Bool {
    0 < r and r < q and 0 < s and s < q and
    is_mod_inverse(s, sinv, q) and
    (g.pow((h * sinv).mod(q)) * y.pow((r * sinv).mod(q))).mod(p).mod(q) = r
}

theorem dsa_verify_exponent_eq(q: Nat, h: Nat, x: Nat, r: Nat,
                                k: Nat, kinv: Nat, s: Nat, sinv: Nat) {
    1 < q and k < q and
    (k * kinv).mod(q) = 1 and
    (s * sinv).mod(q) = 1 and
    s = (kinv * (h + x * r)).mod(q)
    implies
        ((h * sinv).mod(q) + x * (r * sinv).mod(q)).mod(q) = k
}

theorem dsa_pow_combine(p: Nat, q: Nat, g: Nat, x: Nat, y: Nat,
                         a: Nat, b: Nat, k: Nat) {
    y = g.pow(x).mod(p) and
    g.pow(q).mod(p) = 1 and
    (a + x * b).mod(q) = k
    implies
        (g.pow(a) * y.pow(b)).mod(p) = g.pow(k).mod(p)
}

theorem dsa_verify_identity(p: Nat, q: Nat, g: Nat, x: Nat, y: Nat,
                             h: Nat, r: Nat, k: Nat, kinv: Nat,
                             s: Nat, sinv: Nat) {
    1 < q and
    g.pow(q).mod(p) = 1 and
    y = g.pow(x).mod(p) and
    k < q and
    (k * kinv).mod(q) = 1 and
    (s * sinv).mod(q) = 1 and
    s = (kinv * (h + x * r)).mod(q)
    implies
        (g.pow((h * sinv).mod(q)) * y.pow((r * sinv).mod(q))).mod(p) =
            g.pow(k).mod(p)
}

theorem dsa_verifier_mod_q_eq_r(p: Nat, q: Nat, g: Nat, x: Nat, y: Nat,
                                 h: Nat, k: Nat, kinv: Nat, sinv: Nat) {
    Nat.1 < q and
    g.pow(q).mod(p) = 1 and
    y = g.pow(x).mod(p) and
    k < q and
    (k * kinv).mod(q) = 1 and
    (dsa_sign_s(q, h, x, dsa_sign_r(p, q, g, k), kinv) * sinv).mod(q) = 1
    implies
        (g.pow((h * sinv).mod(q)) *
         y.pow((dsa_sign_r(p, q, g, k) * sinv).mod(q))).mod(p).mod(q) =
            dsa_sign_r(p, q, g, k)
}

theorem dsa_correctness(p: Nat, q: Nat, g: Nat, x: Nat, y: Nat,
                        k: Nat, kinv: Nat, h: Nat, sinv: Nat) {
    is_dsa_params(p, q, g) and
    is_dsa_keypair(p, q, g, x, y) and
    0 < k and k < q and
    is_mod_inverse(k, kinv, q) and
    is_mod_inverse(dsa_sign_s(q, h, x, dsa_sign_r(p, q, g, k), kinv), sinv, q) and
    0 < dsa_sign_r(p, q, g, k) and
    0 < dsa_sign_s(q, h, x, dsa_sign_r(p, q, g, k), kinv)
    implies
        dsa_verify(p, q, g, y, h,
                   dsa_sign_r(p, q, g, k),
                   dsa_sign_s(q, h, x, dsa_sign_r(p, q, g, k), kinv),
                   sinv)
}

define dsa_r_in_range(q: Nat, r: Nat) -> Bool {
    0 < r and r < q
}

define dsa_s_in_range(q: Nat, s: Nat) -> Bool {
    0 < s and s < q
}

define dsa_signature_components_in_range(q: Nat, r: Nat, s: Nat) -> Bool {
    dsa_r_in_range(q, r) and dsa_s_in_range(q, s)
}

define dsa_verify_core_equation(
    p: Nat,
    q: Nat,
    g: Nat,
    y: Nat,
    h: Nat,
    r: Nat,
    sinv: Nat
) -> Bool {
    (g.pow((h * sinv).mod(q)) * y.pow((r * sinv).mod(q))).mod(p).mod(q) = r
}

theorem dsa_r_in_range_pos(q: Nat, r: Nat) {
    dsa_r_in_range(q, r) implies 0 < r
}

theorem dsa_r_in_range_lt(q: Nat, r: Nat) {
    dsa_r_in_range(q, r) implies r < q
}

theorem dsa_s_in_range_pos(q: Nat, s: Nat) {
    dsa_s_in_range(q, s) implies 0 < s
}

theorem dsa_s_in_range_lt(q: Nat, s: Nat) {
    dsa_s_in_range(q, s) implies s < q
}

theorem dsa_signature_components_in_range_r(q: Nat, r: Nat, s: Nat) {
    dsa_signature_components_in_range(q, r, s) implies dsa_r_in_range(q, r)
}

theorem dsa_signature_components_in_range_s(q: Nat, r: Nat, s: Nat) {
    dsa_signature_components_in_range(q, r, s) implies dsa_s_in_range(q, s)
}

theorem dsa_signature_components_in_range_r_pos(q: Nat, r: Nat, s: Nat) {
    dsa_signature_components_in_range(q, r, s) implies 0 < r
}

theorem dsa_signature_components_in_range_r_lt(q: Nat, r: Nat, s: Nat) {
    dsa_signature_components_in_range(q, r, s) implies r < q
}

theorem dsa_signature_components_in_range_s_pos(q: Nat, r: Nat, s: Nat) {
    dsa_signature_components_in_range(q, r, s) implies 0 < s
}

theorem dsa_signature_components_in_range_s_lt(q: Nat, r: Nat, s: Nat) {
    dsa_signature_components_in_range(q, r, s) implies s < q
}

theorem dsa_verify_guards_of_verify(
    p: Nat,
    q: Nat,
    g: Nat,
    y: Nat,
    h: Nat,
    r: Nat,
    s: Nat,
    sinv: Nat
) {
    dsa_verify(p, q, g, y, h, r, s, sinv) implies
        dsa_signature_components_in_range(q, r, s) and is_mod_inverse(s, sinv, q)
}

theorem dsa_verify_signature_components_in_range_of_verify(
    p: Nat,
    q: Nat,
    g: Nat,
    y: Nat,
    h: Nat,
    r: Nat,
    s: Nat,
    sinv: Nat
) {
    dsa_verify(p, q, g, y, h, r, s, sinv) implies dsa_signature_components_in_range(q, r, s)
}

theorem dsa_verify_inverse_of_verify(
    p: Nat,
    q: Nat,
    g: Nat,
    y: Nat,
    h: Nat,
    r: Nat,
    s: Nat,
    sinv: Nat
) {
    dsa_verify(p, q, g, y, h, r, s, sinv) implies is_mod_inverse(s, sinv, q)
}

theorem dsa_verify_core_equation_of_verify(
    p: Nat,
    q: Nat,
    g: Nat,
    y: Nat,
    h: Nat,
    r: Nat,
    s: Nat,
    sinv: Nat
) {
    dsa_verify(p, q, g, y, h, r, s, sinv) implies
        dsa_verify_core_equation(p, q, g, y, h, r, sinv)
}

theorem dsa_verify_modulus_ne_zero(
    p: Nat,
    q: Nat,
    g: Nat,
    y: Nat,
    h: Nat,
    r: Nat,
    s: Nat,
    sinv: Nat
) {
    dsa_verify(p, q, g, y, h, r, s, sinv) implies q != 0
}

theorem dsa_verify_of_guards_and_core_equation(
    p: Nat,
    q: Nat,
    g: Nat,
    y: Nat,
    h: Nat,
    r: Nat,
    s: Nat,
    sinv: Nat
) {
    dsa_signature_components_in_range(q, r, s) and
        is_mod_inverse(s, sinv, q) and
        dsa_verify_core_equation(p, q, g, y, h, r, sinv)
    implies dsa_verify(p, q, g, y, h, r, s, sinv)
}

define is_ecdsa_keypair[G: XCoord](gen: G, d: Nat, pub: G) -> Bool {
    pub = gen.pow(d)
}

theorem is_ecdsa_keypair_unfold[G: XCoord](gen: G, d: Nat, pub: G) {
    is_ecdsa_keypair(gen, d, pub) = (pub = gen.pow(d))
}

define is_mod_inv(k: Nat, kinv: Nat, n: Nat) -> Bool {
    (k * kinv).mod(n) = 1
}

attributes Nat {
    /// True when b is a modular inverse of self modulo n: their product is
    /// congruent to one modulo n.
    define is_mod_inv(self, b: Nat, n: Nat) -> Bool {
        (self * b).congr_mod(Nat.1, n)
    }
}

theorem is_mod_inv_unfold(k: Nat, kinv: Nat, n: Nat) {
    is_mod_inv(k, kinv, n) = ((k * kinv).mod(n) = 1)
}

define ecdsa_sign_r[G: XCoord](n: Nat, gen: G, k: Nat) -> Nat {
    gen.pow(k).x_coord.mod(n)
}

define ecdsa_sign_s(n: Nat, h: Nat, d: Nat, r: Nat, kinv: Nat) -> Nat {
    (kinv * (h + r * d)).mod(n)
}

theorem ecdsa_sign_r_lt[G: XCoord](n: Nat, gen: G, k: Nat) {
    n != 0 implies ecdsa_sign_r(n, gen, k) < n
}

theorem ecdsa_sign_s_lt(n: Nat, h: Nat, d: Nat, r: Nat, kinv: Nat) {
    n != 0 implies ecdsa_sign_s(n, h, d, r, kinv) < n
}

define ecdsa_verify[G: XCoord](n: Nat, gen: G, pub: G, h: Nat,
                               r: Nat, s: Nat, sinv: Nat) -> Bool {
    0 < r and r < n and 0 < s and s < n and
    is_mod_inv(s, sinv, n) and
    (gen.pow((h * sinv).mod(n)) * pub.pow((r * sinv).mod(n))).x_coord.mod(n) = r
}

define ecdsa_r_in_range(n: Nat, r: Nat) -> Bool {
    0 < r and r < n
}

define ecdsa_s_in_range(n: Nat, s: Nat) -> Bool {
    0 < s and s < n
}

define ecdsa_signature_components_in_range(n: Nat, r: Nat, s: Nat) -> Bool {
    ecdsa_r_in_range(n, r) and ecdsa_s_in_range(n, s)
}

define ecdsa_verify_public_guards(n: Nat, r: Nat, s: Nat, sinv: Nat) -> Bool {
    ecdsa_signature_components_in_range(n, r, s) and is_mod_inv(s, sinv, n)
}

define ecdsa_verify_core_equation[G: XCoord](
    n: Nat,
    gen: G,
    pub: G,
    h: Nat,
    r: Nat,
    sinv: Nat
) -> Bool {
    (gen.pow((h * sinv).mod(n)) * pub.pow((r * sinv).mod(n))).x_coord.mod(n) = r
}

theorem ecdsa_r_in_range_lt(n: Nat, r: Nat) {
    ecdsa_r_in_range(n, r) implies r < n
}

theorem ecdsa_s_in_range_lt(n: Nat, s: Nat) {
    ecdsa_s_in_range(n, s) implies s < n
}

theorem ecdsa_signature_components_in_range_r(n: Nat, r: Nat, s: Nat) {
    ecdsa_signature_components_in_range(n, r, s) implies ecdsa_r_in_range(n, r)
}

theorem ecdsa_signature_components_in_range_s(n: Nat, r: Nat, s: Nat) {
    ecdsa_signature_components_in_range(n, r, s) implies ecdsa_s_in_range(n, s)
}

theorem ecdsa_signature_components_in_range_r_lt(n: Nat, r: Nat, s: Nat) {
    ecdsa_signature_components_in_range(n, r, s) implies r < n
}

theorem ecdsa_signature_components_in_range_s_lt(n: Nat, r: Nat, s: Nat) {
    ecdsa_signature_components_in_range(n, r, s) implies s < n
}

theorem ecdsa_verify_public_guards_components(n: Nat, r: Nat, s: Nat, sinv: Nat) {
    ecdsa_verify_public_guards(n, r, s, sinv) implies
        ecdsa_signature_components_in_range(n, r, s)
}

theorem ecdsa_verify_public_guards_inverse(n: Nat, r: Nat, s: Nat, sinv: Nat) {
    ecdsa_verify_public_guards(n, r, s, sinv) implies is_mod_inv(s, sinv, n)
}

theorem ecdsa_verify_public_guards_of_verify[G: XCoord](
    n: Nat,
    gen: G,
    pub: G,
    h: Nat,
    r: Nat,
    s: Nat,
    sinv: Nat
) {
    ecdsa_verify(n, gen, pub, h, r, s, sinv) implies ecdsa_verify_public_guards(n, r, s, sinv)
}

theorem ecdsa_verify_r_in_range_of_verify[G: XCoord](
    n: Nat,
    gen: G,
    pub: G,
    h: Nat,
    r: Nat,
    s: Nat,
    sinv: Nat
) {
    ecdsa_verify(n, gen, pub, h, r, s, sinv) implies ecdsa_r_in_range(n, r)
}

theorem ecdsa_verify_s_in_range_of_verify[G: XCoord](
    n: Nat,
    gen: G,
    pub: G,
    h: Nat,
    r: Nat,
    s: Nat,
    sinv: Nat
) {
    ecdsa_verify(n, gen, pub, h, r, s, sinv) implies ecdsa_s_in_range(n, s)
}

theorem ecdsa_verify_inverse_of_verify[G: XCoord](
    n: Nat,
    gen: G,
    pub: G,
    h: Nat,
    r: Nat,
    s: Nat,
    sinv: Nat
) {
    ecdsa_verify(n, gen, pub, h, r, s, sinv) implies is_mod_inv(s, sinv, n)
}

theorem ecdsa_verify_core_equation_of_verify[G: XCoord](
    n: Nat,
    gen: G,
    pub: G,
    h: Nat,
    r: Nat,
    s: Nat,
    sinv: Nat
) {
    ecdsa_verify(n, gen, pub, h, r, s, sinv) implies
        ecdsa_verify_core_equation(n, gen, pub, h, r, sinv)
}

theorem ecdsa_verify_public_guards_modulus_ne_zero(n: Nat, r: Nat, s: Nat, sinv: Nat) {
    ecdsa_verify_public_guards(n, r, s, sinv) implies n != 0
}

theorem ecdsa_verify_modulus_ne_zero[G: XCoord](
    n: Nat,
    gen: G,
    pub: G,
    h: Nat,
    r: Nat,
    s: Nat,
    sinv: Nat
) {
    ecdsa_verify(n, gen, pub, h, r, s, sinv) implies n != 0
}

theorem ecdsa_verify_of_public_guards_and_core_equation[G: XCoord](
    n: Nat,
    gen: G,
    pub: G,
    h: Nat,
    r: Nat,
    s: Nat,
    sinv: Nat
) {
    ecdsa_verify_public_guards(n, r, s, sinv) and
        ecdsa_verify_core_equation(n, gen, pub, h, r, sinv)
    implies ecdsa_verify(n, gen, pub, h, r, s, sinv)
}

theorem one_divides(a: Nat) {
    Nat.1.divides(a)
}

define egz_wsum(f: Nat -> Nat, w: Nat -> Nat, n: Nat) -> Nat {
    partial(function(j: Nat) { f(w(j)) }, n)
}

theorem egz_wsum_one(f: Nat -> Nat, w: Nat -> Nat) {
    egz_wsum(f, w, Nat.1) = f(w(0))
}

theorem egz_wsum_two(f: Nat -> Nat, w: Nat -> Nat) {
    egz_wsum(f, w, Nat.2) = f(w(0)) + f(w(1))
}

theorem egz_wsum_three(f: Nat -> Nat, w: Nat -> Nat) {
    egz_wsum(f, w, Nat.3) = f(w(0)) + f(w(1)) + f(w(2))
}

theorem mod_two_lt(x: Nat) {
    x.mod(2) < Nat.2
}

define parity_of(f: Nat -> Nat, i: Nat) -> Nat {
    f(i).mod(2)
}

theorem even_sum_of_same_parity(x: Nat, y: Nat) {
    x.mod(2) = y.mod(2) implies Nat.2.divides(x + y)
}

theorem three_divides_of_equal_residues(f: Nat -> Nat, a: Nat, b: Nat, c: Nat, v: Nat) {
    f(a).mod(3) = v and f(b).mod(3) = v and f(c).mod(3) = v implies
    Nat.3.divides(f(a) + f(b) + f(c))
}

theorem three_divides_of_all_residues(f: Nat -> Nat, a: Nat, b: Nat, c: Nat) {
    f(a).mod(3) = Nat.0 and f(b).mod(3) = Nat.1 and f(c).mod(3) = Nat.2 implies
    Nat.3.divides(f(a) + f(b) + f(c))
}

theorem egz_n1(f: Nat -> Nat) {
    exists(i: Nat) {
        i < Nat.1 and Nat.1.divides(f(i))
    }
}

theorem egz_n2(f: Nat -> Nat) {
    exists(i: Nat, j: Nat) {
        i < j and j < Nat.3 and Nat.2.divides(f(i) + f(j))
    }
}

theorem egz_n3_equal(f: Nat -> Nat, a: Nat, b: Nat, c: Nat) {
    a < b and b < c and c < Nat.5 and
    f(a).mod(3) = f(b).mod(3) and f(b).mod(3) = f(c).mod(3) implies
    Nat.3.divides(f(a) + f(b) + f(c))
}

theorem egz_n3_all(f: Nat -> Nat, a: Nat, b: Nat, c: Nat) {
    a < Nat.5 and b < Nat.5 and c < Nat.5 and
    f(a).mod(3) = Nat.0 and f(b).mod(3) = Nat.1 and f(c).mod(3) = Nat.2 implies
    Nat.3.divides(f(a) + f(b) + f(c))
}

define mediant(p: Pair[Nat, Nat], q: Pair[Nat, Nat]) -> Pair[Nat, Nat] {
    Pair.new(p.first + q.first, p.second + q.second)
}

define det(p: Pair[Nat, Nat], q: Pair[Nat, Nat]) -> Nat {
    p.second * q.first - p.first * q.second
}

define insert_mediants(n: Nat, l: List[Pair[Nat, Nat]]) -> List[Pair[Nat, Nat]] {
    match l {
        List.nil {
            List.nil[Pair[Nat, Nat]]
        }
        List.cons(h, t) {
            match t {
                List.nil {
                    List.cons(h, List.nil[Pair[Nat, Nat]])
                }
                List.cons(h2, t2) {
                    if h.second + h2.second = n {
                        List.cons(h, List.cons(mediant(h, h2), insert_mediants(n, t)))
                    } else {
                        List.cons(h, insert_mediants(n, t))
                    }
                }
            }
        }
    }
}

define farey(n: Nat) -> List[Pair[Nat, Nat]] {
    match n {
        Nat.zero {
            List.cons(Pair.new(Nat.0, Nat.1), List.cons(Pair.new(Nat.1, Nat.1), List.nil[Pair[Nat, Nat]]))
        }
        Nat.suc(m) {
            insert_mediants(n, farey(m))
        }
    }
}

define is_consecutive(l: List[Pair[Nat, Nat]], x: Pair[Nat, Nat], y: Pair[Nat, Nat]) -> Bool {
    match l {
        List.nil {
            false
        }
        List.cons(h, t) {
            match t {
                List.nil {
                    false
                }
                List.cons(h2, t2) {
                    if h = x {
                        if h2 = y {
                            true
                        } else {
                            is_consecutive(t, x, y)
                        }
                    } else {
                        is_consecutive(t, x, y)
                    }
                }
            }
        }
    }
}

theorem insert_mediants_split(n: Nat, h: Pair[Nat, Nat], h2: Pair[Nat, Nat], t: List[Pair[Nat, Nat]]) {
    h.second + h2.second = n implies insert_mediants(n, List.cons(h, List.cons(h2, t))) = List.cons(h, List.cons(mediant(h, h2), insert_mediants(n, List.cons(h2, t))))
}

theorem insert_mediants_keep(n: Nat, h: Pair[Nat, Nat], h2: Pair[Nat, Nat], t: List[Pair[Nat, Nat]]) {
    h.second + h2.second != n implies insert_mediants(n, List.cons(h, List.cons(h2, t))) = List.cons(h, insert_mediants(n, List.cons(h2, t)))
}

theorem sub_cancel_add(a: Nat, b: Nat, c: Nat) {
    (a + b) - (a + c) = b - c
}

theorem sub_cancel_add_right(a: Nat, b: Nat, c: Nat) {
    (b + a) - (c + a) = b - c
}

theorem det_mediant_left(p: Pair[Nat, Nat], q: Pair[Nat, Nat]) {
    det(p, mediant(p, q)) = det(p, q)
}

theorem det_mediant_right(p: Pair[Nat, Nat], q: Pair[Nat, Nat]) {
    det(mediant(p, q), q) = det(p, q)
}

theorem farey_one {
    farey(Nat.1) = List.cons(Pair.new(Nat.0, Nat.1), List.cons(Pair.new(Nat.1, Nat.1), List.nil[Pair[Nat, Nat]]))
}

theorem farey_two {
    farey(Nat.2) = List.cons(Pair.new(Nat.0, Nat.1), List.cons(Pair.new(Nat.1, Nat.2), List.cons(Pair.new(Nat.1, Nat.1), List.nil[Pair[Nat, Nat]])))
}

theorem det_zero_one_one_two {
    det(Pair.new(Nat.0, Nat.1), Pair.new(Nat.1, Nat.2)) = Nat.1
}

theorem det_one_two_one_one {
    det(Pair.new(Nat.1, Nat.2), Pair.new(Nat.1, Nat.1)) = Nat.1
}

define unmediant_left(x: Pair[Nat, Nat], y: Pair[Nat, Nat]) -> Pair[Nat, Nat] {
    Pair.new(y.first - x.first, y.second - x.second)
}

define unmediant_right(x: Pair[Nat, Nat], y: Pair[Nat, Nat]) -> Pair[Nat, Nat] {
    Pair.new(x.first - y.first, x.second - y.second)
}

define cons_pair_farey(n: Nat, x: Pair[Nat, Nat], y: Pair[Nat, Nat]) -> Bool {
    match n {
        Nat.zero {
            x = Pair.new(Nat.0, Nat.1) and y = Pair.new(Nat.1, Nat.1)
        }
        Nat.suc(m) {
            (cons_pair_farey(m, x, y) and x.second + y.second != Nat.suc(m)) or
            ((cons_pair_farey(m, x, unmediant_left(x, y)) and y = mediant(x, unmediant_left(x, y)) and x.second + unmediant_left(x, y).second = Nat.suc(m)) or
             (cons_pair_farey(m, unmediant_right(x, y), y) and x = mediant(unmediant_right(x, y), y) and unmediant_right(x, y).second + y.second = Nat.suc(m)))
        }
    }
}

define figurate_triangular(n: Nat) -> Nat {
    (n * (n + Nat.1)).div(Nat.2)
}

define figurate_square(n: Nat) -> Nat {
    n * n
}

define figurate_pentagonal(n: Nat) -> Nat {
    (n * (Nat.3 * n - Nat.1)).div(Nat.2)
}

define figurate_pentagonal_doubled(n: Nat) -> Nat {
    n * (Nat.3 * n - Nat.1)
}

define figurate_octagonal(n: Nat) -> Nat {
    n * (Nat.3 * n - Nat.2)
}

theorem figurate_triangular_closed(n: Nat) {
    figurate_triangular(n) = triangular(n)
}

theorem figurate_triangular_one {
    figurate_triangular(Nat.1) = Nat.1
}

