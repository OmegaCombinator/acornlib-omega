define prime_or_one(k: Nat) -> Nat {
    if k.is_prime {
        k
    } else {
        Nat.1
    }
}

theorem prime_or_one_prime(k: Nat) {
    k.is_prime implies prime_or_one(k) = k
}

theorem prime_or_one_composite(k: Nat) {
    not k.is_prime implies prime_or_one(k) = Nat.1
}

theorem prime_or_one_coprime(j: Nat, k: Nat) {
    j != k implies prime_or_one(j).coprime(prime_or_one(k))
}

define interval_prime_fn(a: Nat, i: Nat) -> Nat {
    prime_or_one(a + i)
}

theorem interval_prime_fn_pairwise_coprime(a: Nat, n: Nat) {
    range_pairwise_coprime(interval_prime_fn(a), n)
}

define primes_in_interval_divide(a: Nat, n: Nat, x: Nat) -> Bool {
    forall(i: Nat) {
        i < n and (a + i).is_prime implies (a + i).divides(x)
    }
}

theorem interval_prime_product_divides(a: Nat, n: Nat, x: Nat) {
    primes_in_interval_divide(a, n, x)
        implies range_prod(interval_prime_fn(a), n).divides(x)
}

theorem central_binom_prime_interval_product_divides(m: Nat) {
    range_prod(interval_prime_fn(m.suc.suc), m.suc).divides(central_binom(m.suc))
}

define primorial(n: Nat) -> Nat {
    range_prod(prime_or_one, n.suc)
}

theorem primorial_zero {
    primorial(Nat.0) = Nat.1
}

theorem primorial_suc(n: Nat) {
    primorial(n.suc) = primorial(n) * prime_or_one(n.suc)
}

theorem prime_or_one_lte(x: Nat) {
    Nat.1 <= x implies prime_or_one(x) <= x
}

theorem prod_shift_prime_or_one(a: Nat) {
    prod_shift_fn(prime_or_one, a) = interval_prime_fn(a)
}

theorem primorial_odd_split(m: Nat) {
    (primorial(m + m.suc)
        = primorial(m.suc) * range_prod(interval_prime_fn(m.suc.suc), m))
}

theorem primorial_one {
    primorial(Nat.1) = Nat.1
}

theorem primorial_composite_step(j: Nat) {
    j.suc.is_composite implies primorial(j.suc) = primorial(j)
}

theorem double_is_composite(t: Nat) {
    Nat.1 < t implies (t + t).is_composite
}

theorem nat_parity(n: Nat) {
    exists(m: Nat) {
        n = m + m or n = m + m.suc
    }
}

theorem four_pow_mono(a: Nat, b: Nat) {
    a <= b implies Nat.4.pow(a) <= Nat.4.pow(b)
}

theorem lte_mul_pair(a: Nat, b: Nat, c: Nat, d: Nat) {
    a <= b and c <= d implies a * c <= b * d
}

theorem primorial_lte_four_pow(n: Nat) {
    primorial(n) <= Nat.4.pow(n)
}

theorem coprime_comm(a: Nat, b: Nat) {
    a.coprime(b) implies b.coprime(a)
}

theorem coprime_one_left(a: Nat) {
    Nat.1.coprime(a)
}

theorem coprime_one_right(a: Nat) {
    a.coprime(Nat.1)
}

theorem coprime_zero_left_imp_one(a: Nat) {
    Nat.0.coprime(a) implies a = Nat.1
}

theorem coprime_zero_right_imp_one(a: Nat) {
    a.coprime(Nat.0) implies a = Nat.1
}

theorem coprime_mul(a: Nat, b: Nat, c: Nat) {
    a.coprime(b) and a.coprime(c) implies a.coprime(b * c)
}

define coprime_pow_right_pred(a: Nat, n: Nat) -> (Nat -> Bool) {
    function(m: Nat) { a.coprime(n) implies a.pow(m).coprime(n) }
}

theorem coprime_pow_right_zero(a: Nat, n: Nat) {
    coprime_pow_right_pred(a, n)(Nat.0)
}

theorem coprime_pow_right_step(a: Nat, n: Nat, m: Nat) {
    coprime_pow_right_pred(a, n)(m) implies coprime_pow_right_pred(a, n)(m.suc)
}

theorem coprime_pow_right(a: Nat, n: Nat, m: Nat) {
    a.coprime(n) implies a.pow(m).coprime(n)
}

theorem coprime_pow_left(a: Nat, n: Nat, m: Nat) {
    a.coprime(n) implies a.coprime(n.pow(m))
}

theorem coprime_pow_pow(a: Nat, b: Nat, m: Nat, n: Nat) {
    a.coprime(b) implies a.pow(m).coprime(b.pow(n))
}

theorem coprime_square_right(a: Nat, n: Nat) {
    a.coprime(n) implies a.pow(Nat.2).coprime(n)
}

theorem coprime_square_left(a: Nat, n: Nat) {
    a.coprime(n) implies a.coprime(n.pow(Nat.2))
}

theorem coprime_square_square(a: Nat, b: Nat) {
    a.coprime(b) implies a.pow(Nat.2).coprime(b.pow(Nat.2))
}

theorem nat_divides_one_imp_one(d: Nat) {
    d.divides(Nat.1) implies d = Nat.1
}

theorem coprime_mul_imp_left(a: Nat, b: Nat, c: Nat) {
    a.coprime(b * c) implies a.coprime(b)
}

theorem coprime_mul_imp_right(a: Nat, b: Nat, c: Nat) {
    a.coprime(b * c) implies a.coprime(c)
}

theorem coprime_mul_iff(a: Nat, b: Nat, c: Nat) {
    a.coprime(b * c) implies (a.coprime(b) and a.coprime(c))
}

theorem coprime_of_divisors(a: Nat, b: Nat, d: Nat, e: Nat) {
    a.coprime(b) and d.divides(a) and e.divides(b) implies d.coprime(e)
}

theorem coprime_divides_of_divides_mul(a: Nat, b: Nat, c: Nat) {
    a.coprime(b) and a.divides(b * c) implies a.divides(c)
}

theorem gcd_divides_gcd_mod(k: Nat, n: Nat) {
    k.gcd(n).divides((k.mod(n)).gcd(n))
}

theorem gcd_mod_divides_gcd(k: Nat, n: Nat) {
    (k.mod(n)).gcd(n).divides(k.gcd(n))
}

theorem coprime_mod_imp(k: Nat, n: Nat) {
    k.coprime(n) implies (k.mod(n)).coprime(n)
}

theorem coprime_unmod_imp(k: Nat, n: Nat) {
    (k.mod(n)).coprime(n) implies k.coprime(n)
}

theorem coprime_mod_iff(k: Nat, n: Nat) {
    k.coprime(n) = (k.mod(n)).coprime(n)
}

let nat_one_arithmetic_fn: Nat -> Nat = function(n: Nat) { Nat.1 }

let nat_identity_arithmetic_fn: Nat -> Nat = function(n: Nat) { n }

define nat_power_arithmetic_fn(k: Nat) -> (Nat -> Nat) {
    function(n: Nat) { n.pow(k) }
}

define arithmetic_fn_mul(f: Nat -> Nat, g: Nat -> Nat) -> (Nat -> Nat) {
    function(n: Nat) { f(n) * g(n) }
}

define is_multiplicative_nat_fn(f: Nat -> Nat) -> Bool {
    f(Nat.1) = Nat.1 and forall(a: Nat, b: Nat) {
        a.coprime(b) implies f(a * b) = f(a) * f(b)
    }
}

define is_completely_multiplicative_nat_fn(f: Nat -> Nat) -> Bool {
    f(Nat.1) = Nat.1 and forall(a: Nat, b: Nat) {
        f(a * b) = f(a) * f(b)
    }
}

theorem completely_multiplicative_imp_multiplicative(f: Nat -> Nat) {
    is_completely_multiplicative_nat_fn(f) implies is_multiplicative_nat_fn(f)
}

theorem completely_multiplicative_nat_fn_apply(f: Nat -> Nat, a: Nat, b: Nat) {
    is_completely_multiplicative_nat_fn(f) implies f(a * b) = f(a) * f(b)
}

theorem multiplicative_nat_fn_apply(f: Nat -> Nat, a: Nat, b: Nat) {
    is_multiplicative_nat_fn(f) and a.coprime(b) implies f(a * b) = f(a) * f(b)
}

theorem nat_mul_swap_middle(a: Nat, b: Nat, c: Nat, d: Nat) {
    (a * b) * (c * d) = (a * c) * (b * d)
}

theorem nat_one_arithmetic_fn_completely_multiplicative {
    is_completely_multiplicative_nat_fn(nat_one_arithmetic_fn)
}

theorem nat_identity_arithmetic_fn_completely_multiplicative {
    is_completely_multiplicative_nat_fn(nat_identity_arithmetic_fn)
}

theorem nat_power_arithmetic_fn_completely_multiplicative(k: Nat) {
    is_completely_multiplicative_nat_fn(nat_power_arithmetic_fn(k))
}

theorem arithmetic_fn_mul_completely_multiplicative_apply(f: Nat -> Nat, g: Nat -> Nat,
    a: Nat, b: Nat) {
    is_completely_multiplicative_nat_fn(f) and is_completely_multiplicative_nat_fn(g)
        implies arithmetic_fn_mul(f, g)(a * b) =
            arithmetic_fn_mul(f, g)(a) * arithmetic_fn_mul(f, g)(b)
}

theorem arithmetic_fn_mul_multiplicative_apply(f: Nat -> Nat, g: Nat -> Nat,
    a: Nat, b: Nat) {
    is_multiplicative_nat_fn(f) and is_multiplicative_nat_fn(g)
        and a.coprime(b) implies arithmetic_fn_mul(f, g)(a * b) =
            arithmetic_fn_mul(f, g)(a) * arithmetic_fn_mul(f, g)(b)
}

theorem arithmetic_fn_mul_completely_multiplicative(f: Nat -> Nat, g: Nat -> Nat) {
    is_completely_multiplicative_nat_fn(f) and is_completely_multiplicative_nat_fn(g)
        implies is_completely_multiplicative_nat_fn(arithmetic_fn_mul(f, g))
}

theorem arithmetic_fn_mul_multiplicative(f: Nat -> Nat, g: Nat -> Nat) {
    is_multiplicative_nat_fn(f) and is_multiplicative_nat_fn(g)
        implies is_multiplicative_nat_fn(arithmetic_fn_mul(f, g))
}

let nat_zero_arithmetic_fn: Nat -> Nat = function(n: Nat) { Nat.0 }

define arithmetic_fn_add(f: Nat -> Nat, g: Nat -> Nat) -> (Nat -> Nat) {
    function(n: Nat) { f(n) + g(n) }
}

theorem arithmetic_fn_add_apply(f: Nat -> Nat, g: Nat -> Nat, n: Nat) {
    arithmetic_fn_add(f, g)(n) = f(n) + g(n)
}

theorem arithmetic_fn_add_comm(f: Nat -> Nat, g: Nat -> Nat) {
    arithmetic_fn_add(f, g) = arithmetic_fn_add(g, f)
}

theorem arithmetic_fn_mul_apply(f: Nat -> Nat, g: Nat -> Nat, n: Nat) {
    arithmetic_fn_mul(f, g)(n) = f(n) * g(n)
}

theorem arithmetic_fn_mul_comm(f: Nat -> Nat, g: Nat -> Nat) {
    arithmetic_fn_mul(f, g) = arithmetic_fn_mul(g, f)
}

define nat_dirichlet_unit_fn(n: Nat) -> Nat {
    if n = Nat.1 { Nat.1 } else { Nat.0 }
}

theorem nat_dirichlet_unit_fn_at_one {
    nat_dirichlet_unit_fn(Nat.1) = Nat.1
}

theorem nat_dirichlet_unit_fn_off_one(n: Nat) {
    n != Nat.1 implies nat_dirichlet_unit_fn(n) = Nat.0
}

theorem nat_mul_eq_one(a: Nat, b: Nat) {
    a * b = Nat.1 implies a = Nat.1 and b = Nat.1
}

theorem nat_dirichlet_unit_fn_completely_multiplicative {
    is_completely_multiplicative_nat_fn(nat_dirichlet_unit_fn)
}

theorem nat_dirichlet_unit_fn_multiplicative {
    is_multiplicative_nat_fn(nat_dirichlet_unit_fn)
}

theorem nat_one_arithmetic_fn_multiplicative {
    is_multiplicative_nat_fn(nat_one_arithmetic_fn)
}

theorem nat_identity_arithmetic_fn_multiplicative {
    is_multiplicative_nat_fn(nat_identity_arithmetic_fn)
}

theorem nat_power_arithmetic_fn_multiplicative(k: Nat) {
    is_multiplicative_nat_fn(nat_power_arithmetic_fn(k))
}

theorem arithmetic_fn_add_assoc(f: Nat -> Nat, g: Nat -> Nat, h: Nat -> Nat) {
    arithmetic_fn_add(arithmetic_fn_add(f, g), h) =
        arithmetic_fn_add(f, arithmetic_fn_add(g, h))
}

theorem arithmetic_fn_mul_assoc(f: Nat -> Nat, g: Nat -> Nat, h: Nat -> Nat) {
    arithmetic_fn_mul(arithmetic_fn_mul(f, g), h) =
        arithmetic_fn_mul(f, arithmetic_fn_mul(g, h))
}

theorem nat_zero_arithmetic_fn_apply(n: Nat) {
    nat_zero_arithmetic_fn(n) = Nat.0
}

theorem nat_one_arithmetic_fn_apply(n: Nat) {
    nat_one_arithmetic_fn(n) = Nat.1
}

theorem nat_identity_arithmetic_fn_apply(n: Nat) {
    nat_identity_arithmetic_fn(n) = n
}

theorem nat_power_arithmetic_fn_apply(k: Nat, n: Nat) {
    nat_power_arithmetic_fn(k)(n) = n.pow(k)
}

theorem arithmetic_fn_add_zero_left(f: Nat -> Nat) {
    arithmetic_fn_add(nat_zero_arithmetic_fn, f) = f
}

theorem arithmetic_fn_add_zero_right(f: Nat -> Nat) {
    arithmetic_fn_add(f, nat_zero_arithmetic_fn) = f
}

theorem arithmetic_fn_mul_one_left(f: Nat -> Nat) {
    arithmetic_fn_mul(nat_one_arithmetic_fn, f) = f
}

theorem arithmetic_fn_mul_one_right(f: Nat -> Nat) {
    arithmetic_fn_mul(f, nat_one_arithmetic_fn) = f
}

theorem arithmetic_fn_mul_zero_left(f: Nat -> Nat) {
    arithmetic_fn_mul(nat_zero_arithmetic_fn, f) = nat_zero_arithmetic_fn
}

theorem arithmetic_fn_mul_zero_right(f: Nat -> Nat) {
    arithmetic_fn_mul(f, nat_zero_arithmetic_fn) = nat_zero_arithmetic_fn
}

define positive_on_positive(f: Nat -> Nat) -> Bool {
    forall(n: Nat) { Nat.0 < n implies Nat.0 < f(n) }
}

theorem nat_one_arithmetic_fn_positive_on_positive {
    positive_on_positive(nat_one_arithmetic_fn)
}

theorem nat_identity_arithmetic_fn_positive_on_positive {
    positive_on_positive(nat_identity_arithmetic_fn)
}

theorem nat_power_arithmetic_fn_positive_on_positive(k: Nat) {
    positive_on_positive(nat_power_arithmetic_fn(k))
}

theorem is_multiplicative_nat_fn_at_one(f: Nat -> Nat) {
    is_multiplicative_nat_fn(f) implies f(Nat.1) = Nat.1
}

theorem is_completely_multiplicative_nat_fn_at_one(f: Nat -> Nat) {
    is_completely_multiplicative_nat_fn(f) implies f(Nat.1) = Nat.1
}

theorem arithmetic_fn_add_positive_on_positive_left(f: Nat -> Nat, g: Nat -> Nat) {
    positive_on_positive(f) implies positive_on_positive(arithmetic_fn_add(f, g))
}

theorem arithmetic_fn_add_positive_on_positive_right(f: Nat -> Nat, g: Nat -> Nat) {
    positive_on_positive(g) implies positive_on_positive(arithmetic_fn_add(f, g))
}

theorem arithmetic_fn_mul_positive_on_positive(f: Nat -> Nat, g: Nat -> Nat) {
    positive_on_positive(f) and positive_on_positive(g)
        implies positive_on_positive(arithmetic_fn_mul(f, g))
}

theorem lcm_zero_left(a: Nat) {
    Nat.0.lcm(a) = Nat.0
}

theorem lcm_zero_right(a: Nat) {
    a.lcm(Nat.0) = Nat.0
}

theorem lcm_divides_left(a: Nat, b: Nat) {
    a.divides(a.lcm(b))
}

theorem lcm_divides_right(a: Nat, b: Nat) {
    b.divides(a.lcm(b))
}

theorem lcm_comm(a: Nat, b: Nat) {
    a.lcm(b) = b.lcm(a)
}

theorem lcm_one_left(a: Nat) {
    Nat.1.lcm(a) = a
}

theorem lcm_one_right(a: Nat) {
    a.lcm(Nat.1) = a
}

theorem lcm_divides_of_common(a: Nat, b: Nat, c: Nat) {
    a.divides(c) and b.divides(c) implies a.lcm(b).divides(c)
}

theorem lcm_assoc(a: Nat, b: Nat, c: Nat) {
    (a.lcm(b)).lcm(c) = a.lcm(b.lcm(c))
}

theorem prime_factor_dichotomy(p: Nat, d: Nat, k: Nat) {
    p.is_prime and d * k = p implies (d = Nat.1 and k = p) or (d = p and k = Nat.1)
}

theorem prime_divisor_is_one_or_self(p: Nat, d: Nat) {
    p.is_prime and d.divides(p) implies d = Nat.1 or d = p
}

theorem coprime_of_distinct_primes(p: Nat, q: Nat) {
    p.is_prime and q.is_prime and p != q implies p.coprime(q)
}

define all_prime(list: List[Nat]) -> Bool {
    match list {
        List.nil {
            true
        }
        List.cons(head, tail) {
            head.is_prime and all_prime(tail)
        }
    }
}

theorem all_prime_nil {
    all_prime(List.nil[Nat])
}

theorem all_prime_cons_intro(head: Nat, tail: List[Nat]) {
    head.is_prime and all_prime(tail) implies all_prime(List.cons(head, tail))
}

theorem all_prime_cons_elim(head: Nat, tail: List[Nat]) {
    all_prime(List.cons(head, tail)) implies head.is_prime and all_prime(tail)
}

theorem prime_factorisation_exists(n: Nat) {
    Nat.1 <= n implies exists(factors: List[Nat]) {
        product[Nat](factors) = n and all_prime(factors)
    }
}

let prime_factorisation(n: Nat) -> factors: List[Nat] satisfy {
    if Nat.1 <= n {
        product[Nat](factors) = n and all_prime(factors)
    } else {
        factors = List.nil[Nat]
    }
}

theorem prime_factorisation_product(n: Nat) {
    Nat.1 <= n implies product[Nat](prime_factorisation(n)) = n
}

theorem prime_factorisation_all_prime(n: Nat) {
    Nat.1 <= n implies all_prime(prime_factorisation(n))
}

theorem prime_factorisation_zero {
    prime_factorisation(Nat.0) = List.nil[Nat]
}

theorem coprime_imp_no_shared_prime_factor(a: Nat, b: Nat, p: Nat) {
    a.coprime(b) and p.is_prime implies not (p.divides(a) and p.divides(b))
}

theorem not_coprime_imp_shared_prime_factor(a: Nat, b: Nat) {
    not a.coprime(b) implies
        exists(p: Nat) { p.is_prime and p.divides(a) and p.divides(b) }
}

theorem coprime_iff_no_shared_prime_factor(a: Nat, b: Nat) {
    a.coprime(b) = (forall(p: Nat) {
        p.is_prime implies not (p.divides(a) and p.divides(b))
    })
}

theorem prime_imp_no_proper_divisor_at(n: Nat, k: Nat) {
    n.is_prime and Nat.1 < k and k < n implies not k.divides(n)
}

theorem prime_imp_no_proper_divisor(n: Nat) {
    n.is_prime implies Nat.1 < n and forall(k: Nat) {
        Nat.1 < k and k < n implies not k.divides(n)
    }
}

theorem no_proper_divisor_imp_prime(n: Nat) {
    Nat.1 < n and (forall(k: Nat) {
        Nat.1 < k and k < n implies not k.divides(n)
    }) implies n.is_prime
}

theorem prime_iff_no_proper_divisor(n: Nat) {
    n.is_prime = (Nat.1 < n and forall(k: Nat) {
        Nat.1 < k and k < n implies not k.divides(n)
    })
}

theorem all_prime_remove_one_cons_eq(head: Nat, tail: List[Nat]) {
    all_prime(List.cons(head, tail)) implies all_prime(List.cons(head, tail).remove_one(head))
}

theorem all_prime_remove_one_cons_neq(head: Nat, tail: List[Nat], item: Nat) {
    all_prime(List.cons(head, tail)) and head != item and all_prime(tail.remove_one(item))
        implies all_prime(List.cons(head, tail).remove_one(item))
}

theorem all_prime_remove_one(list: List[Nat], item: Nat) {
    all_prime(list) implies all_prime(list.remove_one(item))
}

theorem all_prime_filter(list: List[Nat], pred: Nat -> Bool) {
    all_prime(list) implies all_prime(list.filter(pred))
}

theorem all_prime_product_nonzero(list: List[Nat]) {
    all_prime(list) implies product[Nat](list) != Nat.0
}

theorem prime_does_not_divide_one(p: Nat) {
    p.is_prime implies not p.divides(Nat.1)
}

theorem all_prime_product_eq_one_imp_nil(list: List[Nat]) {
    all_prime(list) and product[Nat](list) = Nat.1 implies list = List.nil[Nat]
}

theorem prime_divides_product_cons_step(head: Nat, tail: List[Nat], p: Nat) {
    (p.divides(product[Nat](tail)) implies tail.contains(p)) and
        head.is_prime and p.is_prime and p.divides(head * product[Nat](tail))
        implies List.cons(head, tail).contains(p)
}

theorem prime_divides_product_imp_contains(list: List[Nat], p: Nat) {
    all_prime(list) and p.is_prime and p.divides(product[Nat](list))
        implies list.contains(p)
}

theorem prime_factorisation_unique(l1: List[Nat], l2: List[Nat]) {
    all_prime(l1) and all_prime(l2) and product[Nat](l1) = product[Nat](l2)
        implies is_permutation(l1, l2)
}

theorem all_prime_append(left: List[Nat], right: List[Nat]) {
    all_prime(left) and all_prime(right) implies all_prime(left + right)
}

theorem all_prime_only_primes(list: List[Nat], x: Nat) {
    all_prime(list) and list.contains(x) implies x.is_prime
}

define count_prime_factor(p: Nat, n: Nat) -> Nat {
    prime_factorisation(n).count(p)
}

define selected_prime_factor_product(n: Nat, pred: Nat -> Bool) -> Nat {
    product[Nat](prime_factorisation(n).filter(pred))
}

theorem count_prime_factor_invariant(p: Nat, n: Nat, list: List[Nat]) {
    Nat.1 <= n and all_prime(list) and product[Nat](list) = n
        implies list.count(p) = count_prime_factor(p, n)
}

theorem selected_prime_factor_product_nonzero(n: Nat, pred: Nat -> Bool) {
    n != Nat.0 implies selected_prime_factor_product(n, pred) != Nat.0
}

theorem count_prime_factor_selected_product(
    p: Nat, n: Nat, pred: Nat -> Bool
) {
    n != Nat.0 implies count_prime_factor(
        p, selected_prime_factor_product(n, pred)) =
            if pred(p) { count_prime_factor(p, n) } else { Nat.0 }
}

theorem count_prime_factor_one(p: Nat) {
    count_prime_factor(p, Nat.1) = Nat.0
}

theorem count_prime_factor_non_prime(p: Nat, n: Nat) {
    not p.is_prime implies count_prime_factor(p, n) = Nat.0
}

theorem count_prime_factor_self(p: Nat) {
    p.is_prime implies count_prime_factor(p, p) = Nat.1
}

theorem count_prime_factor_mul(p: Nat, a: Nat, b: Nat) {
    a != Nat.0 and b != Nat.0 implies
        count_prime_factor(p, a * b) =
            count_prime_factor(p, a) + count_prime_factor(p, b)
}

theorem count_prime_factor_other_prime(p: Nat, q: Nat) {
    p.is_prime and q.is_prime and p != q implies count_prime_factor(p, q) = Nat.0
}

theorem divides_imp_count_prime_factor_le(p: Nat, a: Nat, b: Nat) {
    a != Nat.0 and b != Nat.0 and a.divides(b)
        implies count_prime_factor(p, a) <= count_prime_factor(p, b)
}

theorem count_prime_factor_ext(a: Nat, b: Nat) {
    a != Nat.0 and b != Nat.0 and
        (forall(p: Nat) {
            p.is_prime implies count_prime_factor(p, a) = count_prime_factor(p, b)
        })
        implies a = b
}

theorem count_divisor_quotient(head: Nat, b: Nat) {
    head.is_prime and b != Nat.0 and Nat.1 <= count_prime_factor(head, b)
        implies exists(q: Nat) {
            q != Nat.0 and head * q = b
        }
}

theorem product_all_prime_divides_step(head: Nat, tail: List[Nat], b: Nat) {
    head.is_prime and all_prime(tail) and b != Nat.0 and
    (forall(p: Nat) {
        p.is_prime implies List.cons(head, tail).count(p) <= count_prime_factor(p, b)
    }) and
    (forall(b2: Nat) {
        b2 != Nat.0 and (forall(p: Nat) {
            p.is_prime implies tail.count(p) <= count_prime_factor(p, b2)
        }) implies product[Nat](tail).divides(b2)
    })
    implies product[Nat](List.cons(head, tail)).divides(b)
}

theorem product_all_prime_divides(la: List[Nat]) {
    all_prime(la) implies forall(b: Nat) {
        b != Nat.0 and (forall(p: Nat) {
            p.is_prime implies la.count(p) <= count_prime_factor(p, b)
        }) implies product[Nat](la).divides(b)
    }
}

theorem count_prime_factor_le_imp_divides(a: Nat, b: Nat) {
    a != Nat.0 and b != Nat.0 and (forall(p: Nat) {
        p.is_prime implies count_prime_factor(p, a) <= count_prime_factor(p, b)
    }) implies a.divides(b)
}

theorem divides_iff_count_prime_factor_le(a: Nat, b: Nat) {
    a != Nat.0 and b != Nat.0 implies (
        a.divides(b) = forall(p: Nat) {
            p.is_prime implies count_prime_factor(p, a) <= count_prime_factor(p, b)
        }
    )
}

theorem count_prime_factor_pow(p: Nat, k: Nat) {
    p.is_prime implies count_prime_factor(p, p.pow(k)) = k
}

theorem count_prime_factor_pow_other(p: Nat, q: Nat, k: Nat) {
    p.is_prime and q.is_prime and p != q
        implies count_prime_factor(q, p.pow(k)) = Nat.0
}

theorem prime_pow_count_le_at(p: Nat, k: Nat, n: Nat, q: Nat) {
    p.is_prime and q.is_prime and k <= count_prime_factor(p, n)
        implies count_prime_factor(q, p.pow(k)) <= count_prime_factor(q, n)
}

theorem prime_pow_divides_imp_count_le(p: Nat, k: Nat, n: Nat) {
    p.is_prime and n != Nat.0 and p.pow(k).divides(n)
        implies k <= count_prime_factor(p, n)
}

theorem count_le_imp_prime_pow_divides(p: Nat, k: Nat, n: Nat) {
    p.is_prime and n != Nat.0 and k <= count_prime_factor(p, n)
        implies p.pow(k).divides(n)
}

theorem prime_pow_divides_iff(p: Nat, k: Nat, n: Nat) {
    p.is_prime and n != Nat.0 implies (
        p.pow(k).divides(n) = (k <= count_prime_factor(p, n))
    )
}

theorem count_prime_factor_gcd(p: Nat, a: Nat, b: Nat) {
    a != Nat.0 and b != Nat.0 implies
        count_prime_factor(p, a.gcd(b)) =
            count_prime_factor(p, a).min(count_prime_factor(p, b))
}

theorem nat_min_plus_max(a: Nat, b: Nat) {
    a.min(b) + a.max(b) = a + b
}

theorem lcm_nonzero(a: Nat, b: Nat) {
    a != Nat.0 and b != Nat.0 implies a.lcm(b) != Nat.0
}

theorem count_prime_factor_gcd_plus_lcm(p: Nat, a: Nat, b: Nat) {
    a != Nat.0 and b != Nat.0 implies
        count_prime_factor(p, a.gcd(b)) + count_prime_factor(p, a.lcm(b)) =
            count_prime_factor(p, a) + count_prime_factor(p, b)
}

theorem count_prime_factor_lcm(p: Nat, a: Nat, b: Nat) {
    a != Nat.0 and b != Nat.0 implies
        count_prime_factor(p, a.lcm(b)) =
            count_prime_factor(p, a).max(count_prime_factor(p, b))
}

define lcm_left_prime_pred(a: Nat, b: Nat) -> (Nat -> Bool) {
    function(p: Nat) {
        count_prime_factor(p, b) < count_prime_factor(p, a)
    }
}

define lcm_right_prime_pred(a: Nat, b: Nat) -> (Nat -> Bool) {
    function(p: Nat) {
        count_prime_factor(p, a) <= count_prime_factor(p, b)
    }
}

define lcm_left_coprime_factor(a: Nat, b: Nat) -> Nat {
    selected_prime_factor_product(a, lcm_left_prime_pred(a, b))
}

define lcm_right_coprime_factor(a: Nat, b: Nat) -> Nat {
    selected_prime_factor_product(b, lcm_right_prime_pred(a, b))
}

theorem coprime_factors_mul_lcm(a: Nat, b: Nat) {
    a != Nat.0 and b != Nat.0 implies exists(left: Nat, right: Nat) {
        left != Nat.0 and right != Nat.0
            and left.divides(a) and right.divides(b)
            and left.coprime(right) and left * right = a.lcm(b)
    }
}

define divisors_up_to(n: Nat, k: Nat) -> List[Nat] {
    match k {
        Nat.zero {
            List.nil[Nat]
        }
        Nat.suc(j) {
            if k.divides(n) {
                List.cons(k, divisors_up_to(n, j))
            } else {
                divisors_up_to(n, j)
            }
        }
    }
}

define divisor_list(n: Nat) -> List[Nat] {
    divisors_up_to(n, n)
}

theorem divisors_up_to_suc_yes(n: Nat, k: Nat) {
    k.suc.divides(n)
        implies divisors_up_to(n, k.suc) =
            List.cons(k.suc, divisors_up_to(n, k))
}

theorem divisors_up_to_suc_no(n: Nat, k: Nat) {
    not k.suc.divides(n)
        implies divisors_up_to(n, k.suc) = divisors_up_to(n, k)
}

theorem divisors_up_to_zero(n: Nat) {
    divisors_up_to(n, Nat.0) = List.nil[Nat]
}

define divisor_sum_fn(f: Nat -> Nat) -> (Nat -> Nat) {
    function(n: Nat) { sum(map(divisor_list(n), f)) }
}

theorem divisor_sum_fn_apply(f: Nat -> Nat, n: Nat) {
    divisor_sum_fn(f)(n) = sum(map(divisor_list(n), f))
}

theorem divisor_list_zero {
    divisor_list(Nat.0) = List.nil[Nat]
}

theorem divisor_list_one {
    divisor_list(Nat.1) = List.cons(Nat.1, List.nil[Nat])
}

define nat_tau(n: Nat) -> Nat {
    divisor_list(n).length
}

define nat_sigma(n: Nat) -> Nat {
    sum(divisor_list(n))
}

theorem nat_tau_zero {
    nat_tau(Nat.0) = Nat.0
}

theorem nat_tau_one {
    nat_tau(Nat.1) = Nat.1
}

theorem nat_sigma_zero {
    nat_sigma(Nat.0) = Nat.0
}

theorem one_divides_nat(n: Nat) {
    Nat.1.divides(n)
}

theorem divisors_up_to_one(n: Nat) {
    divisors_up_to(n, Nat.1) = List.cons(Nat.1, List.nil[Nat])
}

theorem prime_strict_below_not_divides(p: Nat, k: Nat) {
    p.is_prime and Nat.1 < k and k < p implies not k.divides(p)
}

theorem divisors_up_to_prime_step(p: Nat, x: Nat) {
    p.is_prime and Nat.1 <= x and x.suc < p
        implies divisors_up_to(p, x.suc) = divisors_up_to(p, x)
}

define divisors_up_to_prime_offset_pred(p: Nat, y: Nat) -> Bool {
    Nat.1 + y < p implies
        divisors_up_to(p, Nat.1 + y) = List.cons(Nat.1, List.nil[Nat])
}

theorem divisors_up_to_prime_offset_base(p: Nat) {
    divisors_up_to_prime_offset_pred(p, Nat.0)
}

theorem divisors_up_to_prime_offset_step(p: Nat, y: Nat) {
    p.is_prime and divisors_up_to_prime_offset_pred(p, y)
        implies divisors_up_to_prime_offset_pred(p, y.suc)
}

theorem divisors_up_to_prime_offset(p: Nat, j: Nat) {
    p.is_prime implies divisors_up_to_prime_offset_pred(p, j)
}

theorem prime_eq_suc_suc(p: Nat) {
    p.is_prime implies exists(r: Nat) { r.suc.suc = p }
}

theorem divisors_up_to_prime_at_pred(r: Nat) {
    r.suc.suc.is_prime
        implies divisors_up_to(r.suc.suc, r.suc) = List.cons(Nat.1, List.nil[Nat])
}

theorem nat_sigma_one {
    nat_sigma(Nat.1) = Nat.1
}

theorem divisors_up_to_prime_at(r: Nat) {
    r.suc.suc.is_prime implies
        divisors_up_to(r.suc.suc, r.suc.suc) =
            List.cons(r.suc.suc, List.cons(Nat.1, List.nil[Nat]))
}

theorem divisor_list_prime(p: Nat) {
    p.is_prime implies divisor_list(p) = List.cons(p, List.cons(Nat.1, List.nil[Nat]))
}

theorem nat_tau_prime(p: Nat) {
    p.is_prime implies nat_tau(p) = Nat.2
}

theorem divisor_sum_fn_at_zero(f: Nat -> Nat) {
    divisor_sum_fn(f)(Nat.0) = Nat.0
}

theorem divisor_sum_fn_at_one(f: Nat -> Nat) {
    divisor_sum_fn(f)(Nat.1) = f(Nat.1)
}

theorem divisor_sum_fn_at_prime(f: Nat -> Nat, p: Nat) {
    p.is_prime implies divisor_sum_fn(f)(p) = f(p) + f(Nat.1)
}

theorem arithmetic_fn_add_eq_add_fn(f: Nat -> Nat, g: Nat -> Nat) {
    arithmetic_fn_add(f, g) = add_fn[Nat, Nat](f, g)
}

theorem divisor_sum_fn_add(f: Nat -> Nat, g: Nat -> Nat, n: Nat) {
    divisor_sum_fn(arithmetic_fn_add(f, g))(n) =
        divisor_sum_fn(f)(n) + divisor_sum_fn(g)(n)
}

theorem sum_map_nat_one_arithmetic_fn_eq_length(l: List[Nat]) {
    sum(map(l, nat_one_arithmetic_fn)) = l.length
}

theorem divisor_sum_fn_nat_one_arithmetic_fn_eq_tau(n: Nat) {
    divisor_sum_fn(nat_one_arithmetic_fn)(n) = nat_tau(n)
}

theorem sum_map_nat_identity_arithmetic_fn_eq_sum(l: List[Nat]) {
    sum(map(l, nat_identity_arithmetic_fn)) = sum(l)
}

theorem sum_map_nat_zero_arithmetic_fn_eq_zero(l: List[Nat]) {
    sum(map(l, nat_zero_arithmetic_fn)) = Nat.0
}

theorem divisor_sum_fn_nat_zero_arithmetic_fn(n: Nat) {
    divisor_sum_fn(nat_zero_arithmetic_fn)(n) = nat_zero_arithmetic_fn(n)
}

theorem divisor_sum_fn_nat_identity_arithmetic_fn_eq_sigma(n: Nat) {
    divisor_sum_fn(nat_identity_arithmetic_fn)(n) = nat_sigma(n)
}

theorem nat_sigma_prime(p: Nat) {
    p.is_prime implies nat_sigma(p) = p + Nat.1
}

theorem divisors_up_to_member(n: Nat, k: Nat, d: Nat) {
    divisors_up_to(n, k).contains(d) implies
        (Nat.0 < d and d <= k and d.divides(n))
}

theorem divisor_list_contains_implies(n: Nat, d: Nat) {
    divisor_list(n).contains(d) implies (Nat.0 < d and d.divides(n))
}

theorem divisors_up_to_complete(n: Nat, k: Nat, d: Nat) {
    Nat.0 < d and d <= k and d.divides(n)
        implies divisors_up_to(n, k).contains(d)
}

theorem divisor_list_contains_of(n: Nat, d: Nat) {
    Nat.0 < n and d.divides(n) and Nat.0 < d
        implies divisor_list(n).contains(d)
}

define divisors_up_to_unique_pred(n: Nat, k: Nat) -> Bool {
    divisors_up_to(n, k).is_unique
}

theorem divisors_up_to_unique_base(n: Nat) {
    divisors_up_to_unique_pred(n, Nat.0)
}

theorem divisors_up_to_unique_step(n: Nat, k: Nat) {
    divisors_up_to_unique_pred(n, k)
        implies divisors_up_to_unique_pred(n, k.suc)
}

theorem divisors_up_to_unique(n: Nat, k: Nat) {
    divisors_up_to_unique_pred(n, k)
}

theorem divisor_list_is_unique(n: Nat) {
    divisor_list(n).is_unique
}

define is_prime_power_base_of(n: Nat) -> (Nat -> Bool) {
    function(p: Nat) {
        p.is_prime and exists(k: Nat) {
            Nat.1 <= k and p.pow(k) = n
        }
    }
}

define is_prime_power(n: Nat) -> Bool {
    exists(p: Nat) {
        is_prime_power_base_of(n)(p)
    }
}

define prime_power_base(n: Nat) -> Nat {
    choose_witness(is_prime_power_base_of(n))
}

define von_mangoldt(n: Nat) -> Real {
    if is_prime_power(n) {
        (from_nat[Real](prime_power_base(n))).log.get_or_else(Real.0)
    } else {
        Real.0
    }
}

theorem nat_one_lte_imp_ne_zero(a: Nat) {
    Nat.1 <= a implies a != Nat.0
}

theorem nat_ne_zero_imp_suc(a: Nat) {
    a != Nat.0 implies exists(b: Nat) { a = b.suc }
}

theorem prime_divides_pow_imp_divides_base(q: Nat, p: Nat, k: Nat) {
    q.is_prime and k != Nat.0 and q.divides(p.pow(k)) implies q.divides(p)
}

theorem prime_power_representation_unique(p: Nat, k: Nat, q: Nat, j: Nat) {
    p.is_prime and q.is_prime and Nat.1 <= k and Nat.1 <= j and q.pow(j) = p.pow(k)
        implies q = p
}

theorem is_prime_power_base_of_prime_power(p: Nat, k: Nat) {
    p.is_prime and Nat.1 <= k implies is_prime_power_base_of(p.pow(k))(p)
}

theorem is_prime_power_of_prime_power(p: Nat, k: Nat) {
    p.is_prime and Nat.1 <= k implies is_prime_power(p.pow(k))
}

theorem prime_power_base_of_prime_power(p: Nat, k: Nat) {
    p.is_prime and Nat.1 <= k implies prime_power_base(p.pow(k)) = p
}

theorem von_mangoldt_prime_power(p: Nat, k: Nat) {
    p.is_prime and Nat.1 <= k implies
        von_mangoldt(p.pow(k)) = (from_nat[Real](p)).log.get_or_else(Real.0)
}

theorem von_mangoldt_prime_power_log(p: Nat, k: Nat) {
    p.is_prime and Nat.1 <= k implies
        (from_nat[Real](p)).log = Option.some(von_mangoldt(p.pow(k)))
}

theorem nat_pow_divides_self(a: Nat, n: Nat) {
    a != Nat.0 and n != Nat.0 implies a.divides(a.pow(n))
}

theorem prime_pow_eq_prime_imp_eq(p: Nat, m: Nat, q: Nat) {
    p.is_prime and q.is_prime and p.pow(m) = q implies p = q
}

theorem not_is_prime_power_one {
    not is_prime_power(Nat.1)
}

theorem von_mangoldt_one {
    von_mangoldt(Nat.1) = Real.0
}

theorem not_is_prime_power_prime_mul(p: Nat, q: Nat) {
    p.is_prime and q.is_prime and p != q implies not is_prime_power(p * q)
}

theorem von_mangoldt_prime_mul(p: Nat, q: Nat) {
    p.is_prime and q.is_prime and p != q implies von_mangoldt(p * q) = Real.0
}

define pow_list(p: Nat, k: Nat) -> List[Nat] {
    match k {
        Nat.zero {
            List.cons(Nat.1, List.nil[Nat])
        }
        Nat.suc(j) {
            List.cons(p.pow(k), pow_list(p, j))
        }
    }
}

theorem nat_pow_gte_one(a: Nat, n: Nat) {
    a != Nat.0 implies Nat.1 <= a.pow(n)
}

theorem nat_pow_gt_one(a: Nat, n: Nat) {
    Nat.1 < a and n != Nat.0 implies Nat.1 < a.pow(n)
}

theorem nat_pow_eq_one_imp_zero(a: Nat, d: Nat) {
    Nat.1 < a and a.pow(d) = Nat.1 implies d = Nat.0
}

theorem nat_pow_eq_imp_eq_exp(a: Nat, e: Nat, f: Nat) {
    Nat.1 < a and a.pow(e) = a.pow(f) implies e = f
}

theorem nat_pow_divides_pow(a: Nat, e: Nat, k: Nat) {
    a != Nat.0 and e <= k implies a.pow(e).divides(a.pow(k))
}

theorem from_nat_real_pow(p: Nat, k: Nat) {
    from_nat[Real](p.pow(k)) = from_nat[Real](p).pow(k)
}

theorem divisor_of_prime_power_count_bounded(p: Nat, k: Nat, d: Nat) {
    p.is_prime and Nat.0 < d and d.divides(p.pow(k)) implies
        count_prime_factor(p, d) <= k
}

theorem divisor_of_prime_power_eq_pow(p: Nat, k: Nat, d: Nat) {
    p.is_prime and Nat.0 < d and d.divides(p.pow(k)) implies
        d = p.pow(count_prime_factor(p, d))
}

theorem divisor_of_prime_power_is_power(p: Nat, k: Nat, d: Nat) {
    p.is_prime and Nat.0 < d and d.divides(p.pow(k)) implies
        exists(e: Nat) { e <= k and d = p.pow(e) }
}

theorem nat_lte_imp_lte_suc(a: Nat, b: Nat) {
    a <= b implies a <= b.suc
}

theorem nat_lte_suc_imp_lte_of_ne(a: Nat, b: Nat) {
    a <= b.suc and a != b.suc implies a <= b
}

theorem pow_list_contains_imp_power(p: Nat, k: Nat, d: Nat) {
    Nat.1 < p and pow_list(p, k).contains(d) implies
        exists(e: Nat) { e <= k and d = p.pow(e) }
}

theorem power_imp_pow_list_contains(p: Nat, k: Nat, d: Nat) {
    Nat.1 < p and exists(e: Nat) { e <= k and d = p.pow(e) } implies
        pow_list(p, k).contains(d)
}

theorem pow_list_unique(p: Nat, k: Nat) {
    Nat.1 < p implies pow_list(p, k).is_unique
}

theorem pow_list_contains_imp_divisor_list(p: Nat, k: Nat, d: Nat) {
    p.is_prime and pow_list(p, k).contains(d) implies divisor_list(p.pow(k)).contains(d)
}

theorem divisor_list_pow_contains_imp_pow_list(p: Nat, k: Nat, d: Nat) {
    p.is_prime and divisor_list(p.pow(k)).contains(d) implies pow_list(p, k).contains(d)
}

theorem divisor_list_prime_power_sum_eq_pow_list_sum(p: Nat, k: Nat) {
    p.is_prime implies
        sum(map(divisor_list(p.pow(k)), von_mangoldt)) =
            sum(map(pow_list(p, k), von_mangoldt))
}

theorem pow_list_sum_von_mangoldt_zero(p: Nat) {
    p.is_prime implies
        sum(map(pow_list(p, Nat.0), von_mangoldt)) =
            from_nat[Real](Nat.0) * (from_nat[Real](p)).log.get_or_else(Real.0)
}

theorem pow_list_sum_von_mangoldt_suc(p: Nat, x: Nat) {
    p.is_prime and
        sum(map(pow_list(p, x), von_mangoldt)) =
            from_nat[Real](x) * (from_nat[Real](p)).log.get_or_else(Real.0)
        implies
            sum(map(pow_list(p, x.suc), von_mangoldt)) =
                from_nat[Real](x.suc) * (from_nat[Real](p)).log.get_or_else(Real.0)
}

theorem pow_list_sum_von_mangoldt(p: Nat, k: Nat) {
    p.is_prime implies
        sum(map(pow_list(p, k), von_mangoldt)) =
            from_nat[Real](k) * (from_nat[Real](p)).log.get_or_else(Real.0)
}

theorem log_value_pow_nat(p: Nat, k: Nat) {
    p != Nat.0 implies
        (from_nat[Real](p.pow(k))).log.get_or_else(Real.0) =
            from_nat[Real](k) * (from_nat[Real](p)).log.get_or_else(Real.0)
}

theorem von_mangoldt_divisor_sum_prime_power(p: Nat, k: Nat) {
    p.is_prime implies
        sum(map(divisor_list(p.pow(k)), von_mangoldt)) =
            (from_nat[Real](p.pow(k))).log.get_or_else(Real.0)
}

define prime_mul_divisors(p: Nat, q: Nat) -> List[Nat] {
    List.cons(p * q, List.cons(p, List.cons(q, List.cons(Nat.1, List.nil[Nat]))))
}

theorem nat_mul_pos_of_pos(a: Nat, b: Nat) {
    Nat.0 < a and Nat.0 < b implies Nat.0 < a * b
}

theorem divisor_of_prime_mul(p: Nat, q: Nat, d: Nat) {
    p.is_prime and q.is_prime and p != q and Nat.0 < d and d.divides(p * q) implies
        prime_mul_divisors(p, q).contains(d)
}

theorem divisor_list_prime_mul_contains_imp(p: Nat, q: Nat, d: Nat) {
    p.is_prime and q.is_prime and p != q and divisor_list(p * q).contains(d)
        implies prime_mul_divisors(p, q).contains(d)
}

theorem prime_mul_contains_imp_divisor_list(p: Nat, q: Nat, d: Nat) {
    p.is_prime and q.is_prime and p != q and prime_mul_divisors(p, q).contains(d)
        implies divisor_list(p * q).contains(d)
}

theorem prime_mul_divisors_unique(p: Nat, q: Nat) {
    p.is_prime and q.is_prime and p != q implies prime_mul_divisors(p, q).is_unique
}

theorem divisor_list_prime_mul_sum_eq_list_sum(p: Nat, q: Nat) {
    p.is_prime and q.is_prime and p != q implies
        sum(map(divisor_list(p * q), von_mangoldt)) =
            sum(map(prime_mul_divisors(p, q), von_mangoldt))
}

theorem prime_mul_list_sum_von_mangoldt(p: Nat, q: Nat) {
    p.is_prime and q.is_prime and p != q implies
        sum(map(prime_mul_divisors(p, q), von_mangoldt)) =
            (from_nat[Real](p)).log.get_or_else(Real.0) + (from_nat[Real](q)).log.get_or_else(Real.0)
}

theorem log_value_mul_nat(p: Nat, q: Nat) {
    p != Nat.0 and q != Nat.0 implies
        (from_nat[Real](p * q)).log.get_or_else(Real.0) =
            (from_nat[Real](p)).log.get_or_else(Real.0) + (from_nat[Real](q)).log.get_or_else(Real.0)
}

theorem von_mangoldt_divisor_sum_prime_mul(p: Nat, q: Nat) {
    p.is_prime and q.is_prime and p != q implies
        sum(map(divisor_list(p * q), von_mangoldt)) =
            (from_nat[Real](p * q)).log.get_or_else(Real.0)
}

define chebyshev_theta_weight(n: Nat) -> Real {
    if n.is_prime {
        (from_nat[Real](n)).log.get_or_else(Real.0)
    } else {
        Real.0
    }
}

define chebyshev_theta(x: Nat) -> Real {
    range_sum(chebyshev_theta_weight, x.suc)
}

define chebyshev_psi_weight(n: Nat) -> Real {
    if is_prime_power(n) {
        (from_nat[Real](prime_power_base(n))).log.get_or_else(Real.0)
    } else {
        Real.0
    }
}

define chebyshev_psi(x: Nat) -> Real {
