theorem falling_product_binomial_central_binom_carrywise_bound_of_divides(
    n: Nat, k: Nat
) {
    k < n and falling_product(n, k).divides(central_binom(n))
        implies falling_product_binomial_central_binom_carrywise_bound(n, k)
}

attributes Nat {
    /// True if this number is congruent to b modulo n. Defined as the equality
    /// of the two values' remainders when divided by n. This avoids the
    /// truncating subtraction on Nat that the divisibility-based form would
    /// require.
    define congr_mod(self, b: Nat, n: Nat) -> Bool {
        self.mod(n) = b.mod(n)
    }
}

theorem congr_mod_refl(a: Nat, n: Nat) {
    a.congr_mod(a, n)
}

theorem congr_mod_symm(a: Nat, b: Nat, n: Nat) {
    a.congr_mod(b, n) implies b.congr_mod(a, n)
}

theorem congr_mod_trans(a: Nat, b: Nat, c: Nat, n: Nat) {
    a.congr_mod(b, n) and b.congr_mod(c, n) implies a.congr_mod(c, n)
}

theorem mod_congr_mod_self(a: Nat, n: Nat) {
    a.mod(n).congr_mod(a, n)
}

theorem mul_geq_when_pos(d: Nat, n: Nat) {
    d != Nat.0 implies n <= d * n
}

theorem mod_unique(q1: Nat, q2: Nat, r1: Nat, r2: Nat, n: Nat) {
    n != Nat.0 and q1 * n + r1 = q2 * n + r2 and r1 < n and r2 < n
        implies r1 = r2
}

theorem mod_lt(a: Nat, n: Nat) {
    n != Nat.0 implies a.mod(n) < n
}

theorem mod_add_mul(q: Nat, n: Nat, r: Nat) {
    (q * n + r).mod(n) = r.mod(n)
}

theorem mod_add_eq(a: Nat, b: Nat, n: Nat) {
    (a + b).mod(n) = (a.mod(n) + b.mod(n)).mod(n)
}

theorem mod_mul_left_eq(a: Nat, b: Nat, n: Nat) {
    (a * b).mod(n) = (a.mod(n) * b).mod(n)
}

theorem mod_mul_right_eq(a: Nat, b: Nat, n: Nat) {
    (a * b).mod(n) = (a * b.mod(n)).mod(n)
}

theorem mod_mul_eq(a: Nat, b: Nat, n: Nat) {
    (a * b).mod(n) = (a.mod(n) * b.mod(n)).mod(n)
}

theorem congr_mod_add(a: Nat, b: Nat, c: Nat, d: Nat, n: Nat) {
    a.congr_mod(c, n) and b.congr_mod(d, n) implies (a + b).congr_mod(c + d, n)
}

theorem congr_mod_mul(a: Nat, b: Nat, c: Nat, d: Nat, n: Nat) {
    a.congr_mod(c, n) and b.congr_mod(d, n) implies (a * b).congr_mod(c * d, n)
}

theorem congr_mod_pow_step(a: Nat, b: Nat, n: Nat, x: Nat) {
    a.congr_mod(b, n) and a.pow(x).congr_mod(b.pow(x), n)
        implies a.pow(x.suc).congr_mod(b.pow(x.suc), n)
}

theorem congr_mod_pow(a: Nat, b: Nat, n: Nat, k: Nat) {
    a.congr_mod(b, n) implies a.pow(k).congr_mod(b.pow(k), n)
}

theorem congr_mod_zero_of_divides(d: Nat, x: Nat) {
    d.divides(x) implies x.congr_mod(Nat.0, d)
}

theorem divides_of_congr_mod_zero(d: Nat, x: Nat) {
    x.congr_mod(Nat.0, d) implies d.divides(x)
}

theorem congr_mod_zero_iff_divides(d: Nat, x: Nat) {
    x.congr_mod(Nat.0, d) = d.divides(x)
}

theorem nat_bezout(a: Nat, b: Nat) {
    exists(x: Int, y: Int) {
        x * Int.from_nat(a) + y * Int.from_nat(b) = Int.from_nat(a.gcd(b))
    }
}

theorem mul_from_nat(a: Nat, b: Nat) {
    Int.from_nat(a) * Int.from_nat(b) = Int.from_nat(a * b)
}

theorem int_from_nat_sub_eq(a: Nat, b: Nat) {
    b <= a implies Int.from_nat(a) - Int.from_nat(b) = Int.from_nat(a - b)
}

theorem nat_divides_diff_imp_congr(a: Nat, b: Nat, n: Nat) {
    b <= a and n.divides(a - b) implies a.congr_mod(b, n)
}

theorem int_mod_rel_imp_nat_congr_mod_le(a: Nat, b: Nat, n: Nat) {
    b <= a and int_mod_rel(n, Int.from_nat(a), Int.from_nat(b)) implies a.congr_mod(b, n)
}

theorem int_mod_rel_imp_nat_congr_mod(a: Nat, b: Nat, n: Nat) {
    int_mod_rel(n, Int.from_nat(a), Int.from_nat(b)) implies a.congr_mod(b, n)
}

theorem nat_congr_mod_imp_int_mod_rel(a: Nat, b: Nat, n: Nat) {
    a.congr_mod(b, n) implies int_mod_rel(n, Int.from_nat(a), Int.from_nat(b))
}

theorem nat_congr_mod_iff_int_mod_rel(a: Nat, b: Nat, n: Nat) {
    a.congr_mod(b, n) = int_mod_rel(n, Int.from_nat(a), Int.from_nat(b))
}

theorem int_modular_inverse_exists(a: Nat, n: Nat) {
    a.coprime(n) implies
        exists(b: Int) { int_mod_rel(n, b * Int.from_nat(a), Int.1) }
}

theorem nat_modular_inverse_exists_pos(a: Nat, n: Nat) {
    n != Nat.0 and a.coprime(n) implies exists(b: Nat) { (a * b).congr_mod(Nat.1, n) }
}

theorem nat_modular_inverse_exists_zero(a: Nat) {
    a.coprime(Nat.0) implies exists(b: Nat) { (a * b).congr_mod(Nat.1, Nat.0) }
}

theorem nat_modular_inverse_exists(a: Nat, n: Nat) {
    a.coprime(n) implies exists(b: Nat) { (a * b).congr_mod(Nat.1, n) }
}

attributes Nat {
    /// True when b is a modular inverse of self modulo n: their product is
    /// congruent to one modulo n.
    define is_mod_inv(self, b: Nat, n: Nat) -> Bool {
        (self * b).congr_mod(Nat.1, n)
    }
}

theorem mod_inv_unique_left_scale(a: Nat, n: Nat, b1: Nat, b2: Nat) {
    (a * b2).congr_mod(Nat.1, n) implies (b1 * (a * b2)).congr_mod(b1, n)
}

theorem mod_inv_unique_right_scale(a: Nat, n: Nat, b1: Nat, b2: Nat) {
    (a * b1).congr_mod(Nat.1, n) implies ((a * b1) * b2).congr_mod(b2, n)
}

theorem mod_inv_assoc_swap(a: Nat, b1: Nat, b2: Nat) {
    b1 * (a * b2) = (a * b1) * b2
}

theorem mod_inv_unique_congr(a: Nat, n: Nat, b1: Nat, b2: Nat) {
    (a * b1).congr_mod(Nat.1, n) and (a * b2).congr_mod(Nat.1, n)
        implies b1.congr_mod(b2, n)
}

theorem is_mod_inv_iff_congr(a: Nat, b: Nat, n: Nat) {
    a.is_mod_inv(b, n) = (a * b).congr_mod(Nat.1, n)
}

theorem mod_inv_unique(a: Nat, n: Nat, b1: Nat, b2: Nat) {
    a.is_mod_inv(b1, n) and a.is_mod_inv(b2, n) implies b1.congr_mod(b2, n)
}

let mod_inv(a: Nat, n: Nat) -> b: Nat satisfy {
    if a.coprime(n) {
        a.is_mod_inv(b, n)
    } else {
        b = Nat.0
    }
}

theorem mod_inv_correct(a: Nat, n: Nat) {
    a.coprime(n) implies a.is_mod_inv(mod_inv(a, n), n)
}

theorem mod_inv_mul_congr_one(a: Nat, n: Nat) {
    a.coprime(n) implies (a * mod_inv(a, n)).congr_mod(Nat.1, n)
}

theorem mul_left_compat(a: Nat, x: Nat, y: Nat, n: Nat, c: Nat) {
    (a * x).congr_mod(a * y, n)
        implies (c * (a * x)).congr_mod(c * (a * y), n)
}

theorem mul_one_congr_left(c: Nat, n: Nat, x: Nat) {
    c.congr_mod(Nat.1, n) implies (c * x).congr_mod(x, n)
}

theorem cancel_coprime_pin(b: Nat, a: Nat, n: Nat, x: Nat, y: Nat) {
    (b * a).congr_mod(Nat.1, n)
        implies x.congr_mod((b * a) * x, n) and ((b * a) * y).congr_mod(y, n)
}

theorem cancel_one_chain_left(c: Nat, n: Nat, x: Nat, y: Nat) {
    c.congr_mod(Nat.1, n) and (c * x).congr_mod(c * y, n)
        implies x.congr_mod(c * y, n)
}

theorem cancel_one_chain_right(c: Nat, n: Nat, x: Nat, y: Nat) {
    c.congr_mod(Nat.1, n) and x.congr_mod(c * y, n)
        implies x.congr_mod(y, n)
}

theorem cancel_one_chain(c: Nat, n: Nat, x: Nat, y: Nat) {
    c.congr_mod(Nat.1, n) and (c * x).congr_mod(c * y, n)
        implies x.congr_mod(y, n)
}

theorem cancel_with_inverse_setup(a: Nat, b: Nat, n: Nat, x: Nat, y: Nat) {
    (a * x).congr_mod(a * y, n)
        implies ((b * a) * x).congr_mod((b * a) * y, n)
}

theorem cancel_with_inverse(a: Nat, b: Nat, n: Nat, x: Nat, y: Nat) {
    (b * a).congr_mod(Nat.1, n) and (a * x).congr_mod(a * y, n)
        implies x.congr_mod(y, n)
}

theorem cancel_coprime(a: Nat, n: Nat, x: Nat, y: Nat) {
    a.coprime(n) and (a * x).congr_mod(a * y, n)
        implies x.congr_mod(y, n)
}

theorem inverse_imp_product_coprime(a: Nat, b: Nat, n: Nat) {
    (a * b).congr_mod(Nat.1, n) implies (a * b).coprime(n)
}

theorem product_coprime_imp_right(a: Nat, b: Nat, n: Nat) {
    (a * b).coprime(n) implies b.coprime(n)
}

theorem inverse_imp_coprime(a: Nat, b: Nat, n: Nat) {
    (a * b).congr_mod(Nat.1, n) implies b.coprime(n)
}

theorem mod_inv_coprime(a: Nat, n: Nat) {
    a.coprime(n) implies (mod_inv(a, n)).coprime(n)
}

theorem coprime_mul_right_pair(a: Nat, b: Nat, n: Nat) {
    a.coprime(n) and b.coprime(n) implies (a * b).coprime(n)
}

theorem mod_inv_mul_product_congr_one(a: Nat, b: Nat, n: Nat) {
    a.coprime(n) and b.coprime(n) implies
        (a * b * (mod_inv(b, n) * mod_inv(a, n))).congr_mod(Nat.1, n)
}

theorem mod_inv_mul_congr(a: Nat, b: Nat, n: Nat) {
    a.coprime(n) and b.coprime(n) implies
        mod_inv(a * b, n).congr_mod(mod_inv(b, n) * mod_inv(a, n), n)
}

theorem mod_inv_one_congr(n: Nat) {
    mod_inv(Nat.1, n).congr_mod(Nat.1, n)
}

theorem mod_inv_congr(a: Nat, b: Nat, n: Nat) {
    a.congr_mod(b, n) and a.coprime(n) and b.coprime(n) implies
        mod_inv(a, n).congr_mod(mod_inv(b, n), n)
}

theorem mod_inv_involutive_congr(a: Nat, n: Nat) {
    a.coprime(n) implies mod_inv(mod_inv(a, n), n).congr_mod(a, n)
}

theorem prime_does_not_divide_below(p: Nat, m: Nat) {
    p.is_prime and Nat.0 < m and m < p implies not p.divides(m)
}

theorem prime_not_divides_factorial_step(p: Nat, k: Nat) {
    p.is_prime and not p.divides(k.factorial) and not p.divides(k.suc)
        implies not p.divides(k.suc.factorial)
}

define p_no_div_fact_pred(p: Nat) -> (Nat -> Bool) {
    function(x: Nat) {
        x < p implies not p.divides(x.factorial)
    }
}

theorem prime_no_div_fact_zero(p: Nat) {
    p.is_prime implies p_no_div_fact_pred(p)(Nat.0)
}

theorem prime_no_div_fact_step(p: Nat, k: Nat) {
    p.is_prime and p_no_div_fact_pred(p)(k) implies p_no_div_fact_pred(p)(k.suc)
}

theorem prime_does_not_divide_factorial(p: Nat, m: Nat) {
    p.is_prime and m < p implies not p.divides(m.factorial)
}

theorem prime_divides_mul(p: Nat, a: Nat, b: Nat) {
    p.is_prime and p.divides(a * b) implies p.divides(a) or p.divides(b)
}

theorem prime_divides_self_factorial(p: Nat) {
    p.is_prime implies p.divides(p.factorial)
}

theorem prime_divides_binom(p: Nat, k: Nat) {
    p.is_prime and Nat.0 < k and k < p implies p.divides(p.binom(k))
}

define divides_partial_pred(d: Nat, f: Nat -> Nat) -> (Nat -> Bool) {
    function(m: Nat) {
        (forall(k: Nat) { k < m implies d.divides(f(k)) })
            implies d.divides(partial[Nat](f, m))
    }
}

theorem divides_partial_nat_zero(d: Nat, f: Nat -> Nat) {
    divides_partial_pred(d, f)(Nat.0)
}

theorem divides_partial_nat_step(d: Nat, f: Nat -> Nat, m: Nat) {
    divides_partial_pred(d, f)(m)
        implies divides_partial_pred(d, f)(m.suc)
}

theorem sub_one_pred(p: Nat, pp: Nat) {
    pp.suc = p implies p - Nat.1 = pp
}

theorem suc_sub_two_pred(p: Nat, pp: Nat) {
    pp.suc = p implies p.suc - Nat.2 = pp
}

theorem suc_sub_two_eq_sub_one(p: Nat) {
    Nat.1 < p implies p.suc - Nat.2 = p - Nat.1
}

theorem suc_sub_one_eq(p: Nat) {
    p.suc - Nat.1 = p
}

theorem suc_geq_two(p: Nat) {
    Nat.1 < p implies p.suc >= Nat.2
}

theorem divides_partial_nat(d: Nat, f: Nat -> Nat, n: Nat) {
    (forall(k: Nat) { k < n implies d.divides(f(k)) })
        implies d.divides(partial[Nat](f, n))
}

theorem prime_divides_binomial_term_middle(p: Nat, a: Nat, b: Nat, k: Nat) {
    p.is_prime and Nat.0 < k and k < p
        implies p.divides(binomial_term(a, b, p, k))
}

theorem binomial_term_left_boundary(a: Nat, b: Nat, p: Nat) {
    binomial_term(a, b, p, Nat.0) = b.pow(p)
}

theorem binomial_term_right_boundary(a: Nat, b: Nat, p: Nat) {
    binomial_term(a, b, p, p) = a.pow(p)
}

theorem shifted_binom_term_div(p: Nat, a: Nat, b: Nat, k: Nat) {
    p.is_prime and k < p - Nat.1
        implies p.divides(compose(binomial_term(a, b, p), Nat.suc)(k))
}

theorem prime_divides_binomial_middle(p: Nat, a: Nat, b: Nat) {
    p.is_prime implies
        p.divides(partial[Nat](compose(binomial_term(a, b, p), Nat.suc), p - Nat.1))
}

theorem binomial_pow_split(a: Nat, b: Nat, p: Nat) {
    Nat.1 < p implies
        (a + b).pow(p) =
            b.pow(p) + partial[Nat](compose(binomial_term(a, b, p), Nat.suc), p - Nat.1) + a.pow(p)
}

theorem divides_imp_congr_zero(d: Nat, x: Nat) {
    d.divides(x) implies x.congr_mod(Nat.0, d)
}

theorem freshmans_dream(p: Nat, a: Nat, b: Nat) {
    p.is_prime implies (a + b).pow(p).congr_mod(a.pow(p) + b.pow(p), p)
}

define fermat_pred(p: Nat) -> (Nat -> Bool) {
    function(a: Nat) {
        a.pow(p).congr_mod(a, p)
    }
}

theorem fermat_base(p: Nat) {
    p.is_prime implies fermat_pred(p)(Nat.0)
}

theorem fermat_step(p: Nat, a: Nat) {
    p.is_prime and fermat_pred(p)(a) implies fermat_pred(p)(a.suc)
}

theorem fermat_pred_unfold(p: Nat, a: Nat) {
    fermat_pred(p)(a) = a.pow(p).congr_mod(a, p)
}

theorem fermats_little_run(p: Nat, a: Nat) {
    p.is_prime implies fermat_pred(p)(a)
}

theorem fermats_little_congr(p: Nat, a: Nat) {
    p.is_prime implies a.pow(p).congr_mod(a, p)
}

theorem fermats_little(p: Nat, a: Nat) {
    p.is_prime implies a.pow(p).mod(p) = a.mod(p)
}

theorem mul_pow_pred_eq_pow(m: Nat, p: Nat) {
    p.is_prime implies m * m.pow(p - Nat.1) = m.pow(p)
}

define rsa_pow_pred(m: Nat, p: Nat) -> (Nat -> Bool) {
    function(k: Nat) {
        m.pow(k * (p - Nat.1) + Nat.1).congr_mod(m, p)
    }
}

theorem rsa_pow_base(m: Nat, p: Nat) {
    rsa_pow_pred(m, p)(Nat.0)
}

theorem rsa_pow_step(m: Nat, p: Nat, k: Nat) {
    p.is_prime and rsa_pow_pred(m, p)(k) implies rsa_pow_pred(m, p)(k.suc)
}

theorem rsa_pow_run(p: Nat, m: Nat, k: Nat) {
    p.is_prime implies rsa_pow_pred(m, p)(k)
}

theorem rsa_pow_congr(p: Nat, m: Nat, k: Nat) {
    p.is_prime implies m.pow(k * (p - Nat.1) + Nat.1).congr_mod(m, p)
}

theorem fermat_euler_split(p: Nat, m: Nat) {
    p.is_prime
        implies (m * m.pow(p - Nat.1)).congr_mod(m * Nat.1, p)
}

theorem fermat_euler(p: Nat, m: Nat) {
    p.is_prime and m.coprime(p)
        implies m.pow(p - Nat.1).congr_mod(Nat.1, p)
}

theorem prime_divides_factorial_imp_lte(p: Nat, n: Nat) {
    p.is_prime and p.divides(n.factorial) implies p <= n
}

theorem prime_in_interval_divides_central_binom(p: Nat, m: Nat) {
    p.is_prime and m.suc < p and p <= m.suc + m.suc
        implies p.divides(central_binom(m.suc))
}

define prime_or_one(k: Nat) -> Nat {
    if k.is_prime {
        k
    } else {
        Nat.1
    }
}

theorem prime_or_one_prime(k: Nat) {
    k.is_prime implies prime_or_one(k) = k
}

theorem prime_or_one_composite(k: Nat) {
    not k.is_prime implies prime_or_one(k) = Nat.1
}

theorem prime_or_one_coprime(j: Nat, k: Nat) {
    j != k implies prime_or_one(j).coprime(prime_or_one(k))
}

define interval_prime_fn(a: Nat, i: Nat) -> Nat {
    prime_or_one(a + i)
}

theorem interval_prime_fn_pairwise_coprime(a: Nat, n: Nat) {
    range_pairwise_coprime(interval_prime_fn(a), n)
}

define primes_in_interval_divide(a: Nat, n: Nat, x: Nat) -> Bool {
    forall(i: Nat) {
        i < n and (a + i).is_prime implies (a + i).divides(x)
    }
}

theorem interval_prime_product_divides(a: Nat, n: Nat, x: Nat) {
    primes_in_interval_divide(a, n, x)
        implies range_prod(interval_prime_fn(a), n).divides(x)
}

theorem central_binom_prime_interval_product_divides(m: Nat) {
    range_prod(interval_prime_fn(m.suc.suc), m.suc).divides(central_binom(m.suc))
}

define primorial(n: Nat) -> Nat {
    range_prod(prime_or_one, n.suc)
}

theorem primorial_zero {
    primorial(Nat.0) = Nat.1
}

theorem primorial_suc(n: Nat) {
    primorial(n.suc) = primorial(n) * prime_or_one(n.suc)
}

theorem prime_or_one_lte(x: Nat) {
    Nat.1 <= x implies prime_or_one(x) <= x
}

theorem prod_shift_prime_or_one(a: Nat) {
    prod_shift_fn(prime_or_one, a) = interval_prime_fn(a)
}

theorem primorial_odd_split(m: Nat) {
    (primorial(m + m.suc)
        = primorial(m.suc) * range_prod(interval_prime_fn(m.suc.suc), m))
}

theorem primorial_one {
    primorial(Nat.1) = Nat.1
}
