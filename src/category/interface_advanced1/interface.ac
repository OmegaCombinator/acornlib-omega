theorem compose_functor_assoc_eq[O1, M1, O2, M2, O3, M3, O4, M4](
    f: Functor[O3, M3, O4, M4],
    g: Functor[O2, M2, O3, M3],
    h: Functor[O1, M1, O2, M2],
    gh: Functor[O1, M1, O3, M3],
    fg: Functor[O2, M2, O4, M4],
    left: Functor[O1, M1, O4, M4],
    right: Functor[O1, M1, O4, M4]
) {
    compose_functor(g, h) = Option.some(gh)
    and compose_functor(f, g) = Option.some(fg)
    and compose_functor(f, gh) = Option.some(left)
    and compose_functor(fg, h) = Option.some(right)
    implies left = right
}

theorem compose_functor_composable_left[O1, M1, O2, M2, O3, M3, O4, M4](
    f: Functor[O3, M3, O4, M4],
    g: Functor[O2, M2, O3, M3],
    h: Functor[O1, M1, O2, M2],
    gh: Functor[O1, M1, O3, M3]
) {
    g.src_cat = h.dst_cat and f.src_cat = g.dst_cat
    and compose_functor(g, h) = Option.some(gh)
    implies f.src_cat = gh.dst_cat
}

theorem compose_functor_composable_right[O1, M1, O2, M2, O3, M3, O4, M4](
    f: Functor[O3, M3, O4, M4],
    g: Functor[O2, M2, O3, M3],
    h: Functor[O1, M1, O2, M2],
    fg: Functor[O2, M2, O4, M4]
) {
    g.src_cat = h.dst_cat and f.src_cat = g.dst_cat
    and compose_functor(f, g) = Option.some(fg)
    implies fg.src_cat = h.dst_cat
}

theorem compose_functor_assoc_some[O1, M1, O2, M2, O3, M3, O4, M4](
    f: Functor[O3, M3, O4, M4],
    g: Functor[O2, M2, O3, M3],
    h: Functor[O1, M1, O2, M2]
) {
    g.src_cat = h.dst_cat and f.src_cat = g.dst_cat implies
    exists(left: Functor[O1, M1, O4, M4], right: Functor[O1, M1, O4, M4]) {
        exists(gh: Functor[O1, M1, O3, M3], fg: Functor[O2, M2, O4, M4]) {
            compose_functor(g, h) = Option.some(gh)
            and compose_functor(f, g) = Option.some(fg)
            and compose_functor(f, gh) = Option.some(left)
            and compose_functor(fg, h) = Option.some(right)
            and left = right
        }
    }
}

theorem is_iso_pair_cancel_left[O, M](c: Category[O, M], f: M, inv: M, h: M, k: M) {
    is_iso_pair(c, f, inv) and c.src(f) = c.dst(h) and c.src(f) = c.dst(k)
    and c.compose(f, h) = c.compose(f, k) implies h = k
}

theorem is_iso_pair_cancel_right[O, M](c: Category[O, M], f: M, inv: M, h: M, k: M) {
    is_iso_pair(c, f, inv) and c.src(h) = c.dst(f) and c.src(k) = c.dst(f)
    and c.compose(h, f) = c.compose(k, f) implies h = k
}

theorem is_iso_pair_inverse_unique[O, M](c: Category[O, M], f: M, g: M, h: M) {
    is_iso_pair(c, f, g) and is_iso_pair(c, f, h) implies g = h
}

theorem iso_inv_eq_of_cat_hom_eq[O, M](e: Iso[O, M], h: Iso[O, M]) {
    e.cat = h.cat and e.hom = h.hom implies e.inv = h.inv
}

theorem iso_eq_of_cat_hom_eq[O, M](e: Iso[O, M], h: Iso[O, M]) {
    e.cat = h.cat and e.hom = h.hom implies e = h
}

define discrete_compose[O](f: O, g: O) -> O {
    f
}

theorem discrete_is_category[O](anchor: O) {
    is_category[O, O](identity_fn[O], identity_fn[O], identity_fn[O], discrete_compose[O])
}

let discrete_category[O](anchor: O) -> result: Category[O, O] satisfy {
    Category[O, O].new(identity_fn[O], identity_fn[O], identity_fn[O], discrete_compose[O])
        = Option.some(result)
}

theorem discrete_category_src[O](anchor: O) {
    discrete_category(anchor).src = identity_fn[O]
}

theorem discrete_category_dst[O](anchor: O) {
    discrete_category(anchor).dst = identity_fn[O]
}

theorem discrete_category_identity[O](anchor: O) {
    discrete_category(anchor).identity = identity_fn[O]
}

theorem discrete_category_compose[O](anchor: O) {
    discrete_category(anchor).compose = discrete_compose[O]
}

theorem discrete_category_src_apply[O](anchor: O, x: O) {
    discrete_category(anchor).src(x) = x
}

theorem discrete_category_dst_apply[O](anchor: O, x: O) {
    discrete_category(anchor).dst(x) = x
}

theorem discrete_category_identity_apply[O](anchor: O, x: O) {
    discrete_category(anchor).identity(x) = x
}

theorem discrete_category_compose_apply[O](anchor: O, f: O, g: O) {
    discrete_category(anchor).compose(f, g) = f
}

define discrete_functor_mor_map[O, O2, M2](d: Category[O2, M2], f: O -> O2, x: O) -> M2 {
    d.identity(f(x))
}

theorem discrete_functor_src_axiom[O, O2, M2](
    anchor: O, d: Category[O2, M2], f: O -> O2
) {
    functor_src_axiom(discrete_category(anchor), d, f, discrete_functor_mor_map(d, f))
}

theorem discrete_functor_dst_axiom[O, O2, M2](
    anchor: O, d: Category[O2, M2], f: O -> O2
) {
    functor_dst_axiom(discrete_category(anchor), d, f, discrete_functor_mor_map(d, f))
}

theorem discrete_functor_identity_axiom[O, O2, M2](
    anchor: O, d: Category[O2, M2], f: O -> O2
) {
    functor_identity_axiom(discrete_category(anchor), d, f, discrete_functor_mor_map(d, f))
}

theorem discrete_functor_compose_axiom[O, O2, M2](
    anchor: O, d: Category[O2, M2], f: O -> O2
) {
    functor_compose_axiom(discrete_category(anchor), d, f, discrete_functor_mor_map(d, f))
}

theorem discrete_functor_is_functor[O, O2, M2](
    anchor: O, d: Category[O2, M2], f: O -> O2
) {
    is_functor(discrete_category(anchor), d, f, discrete_functor_mor_map(d, f))
}

let discrete_functor[O, O2, M2](anchor: O, d: Category[O2, M2], f: O -> O2) -> result: Functor[O, O, O2, M2] satisfy {
    Functor[O, O, O2, M2].new(discrete_category(anchor), d, f, discrete_functor_mor_map(d, f)) =
        Option.some(result)
}

theorem discrete_functor_src_cat[O, O2, M2](anchor: O, d: Category[O2, M2], f: O -> O2) {
    discrete_functor(anchor, d, f).src_cat = discrete_category(anchor)
}

theorem discrete_functor_dst_cat[O, O2, M2](anchor: O, d: Category[O2, M2], f: O -> O2) {
    discrete_functor(anchor, d, f).dst_cat = d
}

theorem discrete_functor_obj_map[O, O2, M2](anchor: O, d: Category[O2, M2], f: O -> O2) {
    discrete_functor(anchor, d, f).obj_map = f
}

theorem discrete_functor_mor_map_eq[O, O2, M2](anchor: O, d: Category[O2, M2], f: O -> O2) {
    discrete_functor(anchor, d, f).mor_map = discrete_functor_mor_map(d, f)
}

theorem discrete_functor_mor_map_apply[O, O2, M2](
    anchor: O, d: Category[O2, M2], f: O -> O2, x: O
) {
    discrete_functor(anchor, d, f).mor_map(x) = d.identity(f(x))
}

theorem discrete_functor_obj_map_apply[O, O2, M2](
    anchor: O, d: Category[O2, M2], f: O -> O2, x: O
) {
    discrete_functor(anchor, d, f).obj_map(x) = f(x)
}

theorem discrete_functor_identity_obj_map[O](anchor: O) {
    discrete_functor(anchor, discrete_category(anchor), identity_fn[O]).obj_map = identity_fn[O]
}

theorem discrete_functor_identity_mor_map_apply[O](anchor: O, x: O) {
    discrete_functor(anchor, discrete_category(anchor), identity_fn[O]).mor_map(x) = x
}

define opposite_compose[O, M](c: Category[O, M], f: M, g: M) -> M {
    c.compose(g, f)
}

theorem opposite_is_category[O, M](c: Category[O, M]) {
    is_category[O, M](c.dst, c.src, c.identity, opposite_compose(c))
}

let opposite_category[O, M](c: Category[O, M]) -> result: Category[O, M] satisfy {
    Category[O, M].new(c.dst, c.src, c.identity, opposite_compose(c)) = Option.some(result)
}

theorem opposite_category_src[O, M](c: Category[O, M]) {
    opposite_category(c).src = c.dst
}

theorem opposite_category_dst[O, M](c: Category[O, M]) {
    opposite_category(c).dst = c.src
}

theorem opposite_category_identity[O, M](c: Category[O, M]) {
    opposite_category(c).identity = c.identity
}

theorem opposite_category_compose[O, M](c: Category[O, M]) {
    opposite_category(c).compose = opposite_compose(c)
}

theorem opposite_category_involutive[O, M](c: Category[O, M]) {
    opposite_category(opposite_category(c)) = c
}

inductive UnitType {
    /// The unique inhabitant.
    point
}

theorem unit_type_unique(x: UnitType) {
    x = UnitType.point
}

theorem unit_type_eq(x: UnitType, y: UnitType) {
    x = y
}

let terminal_category: Category[UnitType, UnitType] = discrete_category(UnitType.point)

/// The source map of the terminal category is the identity function.

theorem terminal_category_src {
    terminal_category.src = identity_fn[UnitType]
}

theorem terminal_category_dst {
    terminal_category.dst = identity_fn[UnitType]
}

theorem terminal_category_identity {
    terminal_category.identity = identity_fn[UnitType]
}

theorem terminal_category_object_unique(x: UnitType) {
    x = UnitType.point
}

theorem terminal_category_morphism_unique(f: UnitType) {
    f = UnitType.point
}

theorem terminal_category_morphism_eq(f: UnitType, g: UnitType) {
    f = g
}

theorem opposite_terminal_category {
    opposite_category(terminal_category) = terminal_category
}

theorem unique_functor_to_terminal_category[O, M](f: Functor[O, M, UnitType, UnitType]) {
    f.dst_cat = terminal_category implies
        f = constant_functor(f.src_cat, terminal_category, UnitType.point)
}

theorem terminal_category_endofunctor_unique(f: Functor[UnitType, UnitType, UnitType, UnitType]) {
    f.src_cat = terminal_category and f.dst_cat = terminal_category
        implies f = constant_functor(terminal_category, terminal_category, UnitType.point)
}

theorem functor_to_terminal_obj_map_unique[O, M](
    f: Functor[O, M, UnitType, UnitType], x: O
) {
    f.dst_cat = terminal_category implies f.obj_map(x) = UnitType.point
}

theorem functor_to_terminal_mor_map_unique[O, M](
    f: Functor[O, M, UnitType, UnitType], m: M
) {
    f.dst_cat = terminal_category implies f.mor_map(m) = UnitType.point
}
