theorem complex_exp_term_from_real(x: Real, n: Nat) {
    complex_exp_term(Complex.from_real(x), n) = Complex.from_real(exp_term(x, n))
}

theorem complex_exp_term_from_real_re(x: Real, n: Nat) {
