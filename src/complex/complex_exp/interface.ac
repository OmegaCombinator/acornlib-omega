theorem complex_geom_re_abs_le(z: Complex, n: Nat) {
    z.pow(n).re.abs <= z.modulus.pow(n)
}

theorem complex_geom_im_abs_le(z: Complex, n: Nat) {
    z.pow(n).im.abs <= z.modulus.pow(n)
