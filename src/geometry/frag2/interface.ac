}

theorem point3_on_plane_eq_dot[T: CommRing](p: Point3[T], n: Point3[T], x: Point3[T]) {
    p.on_plane(n, x) = (n.dot(x.sub(p)) = T.0)
}

theorem point3_on_sphere_eq_dist_sq[T: CommRing](center: Point3[T], radius_sq: T, p: Point3[T]) {
    center.on_sphere(radius_sq, p) = (p.dist_sq(center) = radius_sq)
}

define point3_dist_to_plane_sq[T: OrderedField](p: Point3[T], n: Point3[T], x: Point3[T]) -> T {
    n.dot(x.sub(p)) * n.dot(x.sub(p)) * n.norm_sq.inverse
}

theorem point3_plane_normal_orthogonal_chord[T: CommRing](
    p: Point3[T], n: Point3[T], x: Point3[T], y: Point3[T]
) {
    p.on_plane(n, x) and p.on_plane(n, y) implies n.dot(x.sub(y)) = T.0
}

theorem point3_dist_to_plane_sq_of_plane_point[T: OrderedField](
    p: Point3[T], n: Point3[T], x: Point3[T]
) {
    p.on_plane(n, x) implies point3_dist_to_plane_sq(p, n, x) = T.0
}

define point3_parallelogram_area_sq[T: CommRing](u: Point3[T], v: Point3[T]) -> T {
    u.cross(v).norm_sq
}

define point3_parallelepiped_volume_sq[T: CommRing](u: Point3[T], v: Point3[T], w: Point3[T]) -> T {
    u.dot(v.cross(w)) * u.dot(v.cross(w))
}

theorem point3_parallelogram_area_sq_eq_lagrange[T: CommRing](u: Point3[T], v: Point3[T]) {
    point3_parallelogram_area_sq(u, v) = u.norm_sq * v.norm_sq - u.dot(v) * u.dot(v)
}

theorem point3_parallelepiped_volume_sq_rotate[T: CommRing](u: Point3[T], v: Point3[T], w: Point3[T]) {
    point3_parallelepiped_volume_sq(u, v, w) = point3_parallelepiped_volume_sq(v, w, u)
}

theorem point3_parallelepiped_volume_sq_rotate2[T: CommRing](u: Point3[T], v: Point3[T], w: Point3[T]) {
    point3_parallelepiped_volume_sq(u, v, w) = point3_parallelepiped_volume_sq(w, u, v)
}

theorem point3_parallelepiped_volume_sq_repeat[T: CommRing](u: Point3[T], v: Point3[T]) {
    point3_parallelepiped_volume_sq(u, v, v) = T.0
}

define affine_product_fst[P, Q](p: Pair[P, Q]) -> P {
    p.first
}

define affine_product_snd[P, Q](p: Pair[P, Q]) -> Q {
    p.second
}

theorem affine_map_product_fst_constraint[V: AddCommGroup, W: AddCommGroup, P, Q](
    a: AffineSpace[V, P], b: AffineSpace[W, Q]) {
    affine_map_constraint(
        affine_space_product(a, b), a, affine_product_fst[P, Q])
}

theorem affine_map_product_snd_constraint[V: AddCommGroup, W: AddCommGroup, P, Q](
    a: AffineSpace[V, P], b: AffineSpace[W, Q]) {
    affine_map_constraint(
        affine_space_product(a, b), b, affine_product_snd[P, Q])
}

let affine_map_product_fst[V: AddCommGroup, W: AddCommGroup, P, Q](a: AffineSpace[V, P], b: AffineSpace[W, Q]) -> result: AffineMap[Pair[V, W], Pair[P, Q], V, P] satisfy {
    AffineMap.new(
        affine_space_product(a, b), a, affine_product_fst[P, Q]) =
        Option.some(result)
}

let affine_map_product_snd[V: AddCommGroup, W: AddCommGroup, P, Q](a: AffineSpace[V, P], b: AffineSpace[W, Q]) -> result: AffineMap[Pair[V, W], Pair[P, Q], W, Q] satisfy {
    AffineMap.new(
        affine_space_product(a, b), b, affine_product_snd[P, Q]) =
        Option.some(result)
}

theorem affine_map_product_fst_apply[V: AddCommGroup, W: AddCommGroup, P, Q](
    a: AffineSpace[V, P], b: AffineSpace[W, Q], p: Pair[P, Q]) {
    affine_map_product_fst(a, b).to_fun(p) = p.first
}

theorem affine_map_product_snd_apply[V: AddCommGroup, W: AddCommGroup, P, Q](
    a: AffineSpace[V, P], b: AffineSpace[W, Q], p: Pair[P, Q]) {
    affine_map_product_snd(a, b).to_fun(p) = p.second
}

theorem affine_map_product_fst_src[V: AddCommGroup, W: AddCommGroup, P, Q](
    a: AffineSpace[V, P], b: AffineSpace[W, Q]) {
    affine_map_product_fst(a, b).src = affine_space_product(a, b)
}

theorem affine_map_product_fst_dst[V: AddCommGroup, W: AddCommGroup, P, Q](
    a: AffineSpace[V, P], b: AffineSpace[W, Q]) {
    affine_map_product_fst(a, b).dst = a
}

theorem affine_map_product_snd_src[V: AddCommGroup, W: AddCommGroup, P, Q](
    a: AffineSpace[V, P], b: AffineSpace[W, Q]) {
    affine_map_product_snd(a, b).src = affine_space_product(a, b)
}

theorem affine_map_product_snd_dst[V: AddCommGroup, W: AddCommGroup, P, Q](
    a: AffineSpace[V, P], b: AffineSpace[W, Q]) {
    affine_map_product_snd(a, b).dst = b
}

theorem affine_map_product_fst_preimage_eq[V: AddCommGroup, W: AddCommGroup, P, Q](
    a: AffineSpace[V, P], b: AffineSpace[W, Q],
    s: AffineSubspace[V, P],
    pre: AffineSubspace[Pair[V, W], Pair[P, Q]]
) {
    s.space = a
        and affine_map_preimage(affine_map_product_fst(a, b), s) =
            Option.some(pre)
        implies pre = affine_subspace_product(s, affine_subspace_univ(b))
}

theorem affine_map_product_fst_preimage[V: AddCommGroup, W: AddCommGroup, P, Q](
    a: AffineSpace[V, P], b: AffineSpace[W, Q],
    s: AffineSubspace[V, P]
) {
    s.space = a implies
        affine_map_preimage(affine_map_product_fst(a, b), s) =
            Option.some(affine_subspace_product(s, affine_subspace_univ(b)))
}

theorem affine_map_product_snd_preimage_eq[V: AddCommGroup, W: AddCommGroup, P, Q](
    a: AffineSpace[V, P], b: AffineSpace[W, Q],
    s: AffineSubspace[W, Q],
    pre: AffineSubspace[Pair[V, W], Pair[P, Q]]
) {
    s.space = b
        and affine_map_preimage(affine_map_product_snd(a, b), s) =
            Option.some(pre)
        implies pre = affine_subspace_product(affine_subspace_univ(a), s)
}

theorem affine_map_product_snd_preimage[V: AddCommGroup, W: AddCommGroup, P, Q](
    a: AffineSpace[V, P], b: AffineSpace[W, Q],
    s: AffineSubspace[W, Q]
) {
    s.space = b implies
        affine_map_preimage(affine_map_product_snd(a, b), s) =
            Option.some(affine_subspace_product(affine_subspace_univ(a), s))
}

define affine_map_product_fun[V1: AddCommGroup, P1, V2: AddCommGroup, P2, W1: AddCommGroup, Q1, W2: AddCommGroup, Q2](
    f: AffineMap[V1, P1, V2, P2], g: AffineMap[W1, Q1, W2, Q2],
    p: Pair[P1, Q1]
) -> Pair[P2, Q2] {
    Pair.new(f.to_fun(p.first), g.to_fun(p.second))
}

theorem affine_map_product_fun_apply[V1: AddCommGroup, P1, V2: AddCommGroup, P2, W1: AddCommGroup, Q1, W2: AddCommGroup, Q2](
    f: AffineMap[V1, P1, V2, P2], g: AffineMap[W1, Q1, W2, Q2],
    p: Pair[P1, Q1]
) {
    affine_map_product_fun(f, g, p) =
        Pair.new(f.to_fun(p.first), g.to_fun(p.second))
}

theorem affine_map_product_constraint[V1: AddCommGroup, P1, V2: AddCommGroup, P2, W1: AddCommGroup, Q1, W2: AddCommGroup, Q2](
    f: AffineMap[V1, P1, V2, P2], g: AffineMap[W1, Q1, W2, Q2]
) {
    affine_map_constraint(
        affine_space_product(f.src, g.src), affine_space_product(f.dst, g.dst),
        affine_map_product_fun(f, g))
}

let affine_map_product[V1: AddCommGroup, P1, V2: AddCommGroup, P2, W1: AddCommGroup, Q1, W2: AddCommGroup, Q2](f: AffineMap[V1, P1, V2, P2], g: AffineMap[W1, Q1, W2, Q2]) -> result: AffineMap[Pair[V1, W1], Pair[P1, Q1], Pair[V2, W2], Pair[P2, Q2]] satisfy {
    AffineMap.new(
        affine_space_product(f.src, g.src), affine_space_product(f.dst, g.dst),
        affine_map_product_fun(f, g)) = Option.some(result)
}

theorem affine_map_product_apply[V1: AddCommGroup, P1, V2: AddCommGroup, P2, W1: AddCommGroup, Q1, W2: AddCommGroup, Q2](
    f: AffineMap[V1, P1, V2, P2], g: AffineMap[W1, Q1, W2, Q2],
    p: Pair[P1, Q1]
) {
    affine_map_product(f, g).to_fun(p) =
        Pair.new(f.to_fun(p.first), g.to_fun(p.second))
}

theorem affine_map_product_src[V1: AddCommGroup, P1, V2: AddCommGroup, P2, W1: AddCommGroup, Q1, W2: AddCommGroup, Q2](
    f: AffineMap[V1, P1, V2, P2], g: AffineMap[W1, Q1, W2, Q2]
) {
    affine_map_product(f, g).src = affine_space_product(f.src, g.src)
}

theorem affine_map_product_dst[V1: AddCommGroup, P1, V2: AddCommGroup, P2, W1: AddCommGroup, Q1, W2: AddCommGroup, Q2](
    f: AffineMap[V1, P1, V2, P2], g: AffineMap[W1, Q1, W2, Q2]
) {
    affine_map_product(f, g).dst = affine_space_product(f.dst, g.dst)
}

theorem affine_map_product_id[V: AddCommGroup, W: AddCommGroup, P, Q](
    a: AffineSpace[V, P], b: AffineSpace[W, Q]
) {
    affine_map_product(affine_map_id(a), affine_map_id(b)) =
        affine_map_id(affine_space_product(a, b))
}

theorem affine_map_product_compose[V1: AddCommGroup, P1, V2: AddCommGroup, P2, V3: AddCommGroup, P3, W1: AddCommGroup, Q1, W2: AddCommGroup, Q2, W3: AddCommGroup, Q3](
    f1: AffineMap[V1, P1, V2, P2], f2: AffineMap[V2, P2, V3, P3],
    g1: AffineMap[W1, Q1, W2, Q2], g2: AffineMap[W2, Q2, W3, Q3],
    fcomp: AffineMap[V1, P1, V3, P3], gcomp: AffineMap[W1, Q1, W3, Q3]
) {
    affine_map_compose(f1, f2) = Option.some(fcomp)
    and affine_map_compose(g1, g2) = Option.some(gcomp)
    implies affine_map_compose(
        affine_map_product(f1, g1), affine_map_product(f2, g2)) =
        Option.some(affine_map_product(fcomp, gcomp))
}

theorem affine_map_product_fst_natural[V1: AddCommGroup, P1, V2: AddCommGroup, P2, W1: AddCommGroup, Q1, W2: AddCommGroup, Q2](
    f: AffineMap[V1, P1, V2, P2], g: AffineMap[W1, Q1, W2, Q2]
) {
    affine_map_compose(
        affine_map_product(f, g), affine_map_product_fst(f.dst, g.dst)) =
        affine_map_compose(affine_map_product_fst(f.src, g.src), f)
}

theorem affine_map_product_snd_natural[V1: AddCommGroup, P1, V2: AddCommGroup, P2, W1: AddCommGroup, Q1, W2: AddCommGroup, Q2](
    f: AffineMap[V1, P1, V2, P2], g: AffineMap[W1, Q1, W2, Q2]
) {
    affine_map_compose(
        affine_map_product(f, g), affine_map_product_snd(f.dst, g.dst)) =
        affine_map_compose(affine_map_product_snd(f.src, g.src), g)
}

define affine_span_product_src[P, Q](
    src1: P -> Bool, src2: Q -> Bool, x: Pair[P, Q]) -> Bool {
    src1(x.first) and src2(x.second)
}

theorem affine_span_product_src_iff[P, Q](
    src1: P -> Bool, src2: Q -> Bool, x: Pair[P, Q]
) {
    affine_span_product_src(src1, src2, x) =
        (src1(x.first) and src2(x.second))
}

theorem affine_span_product_src_mem_product_spans[V: AddCommGroup, W: AddCommGroup, P, Q](
    a: AffineSpace[V, P],
    b: AffineSpace[W, Q],
    src1: P -> Bool,
    src2: Q -> Bool,
    x: Pair[P, Q]
) {
    affine_span_product_src(src1, src2, x) implies
        affine_subspace_product(
            affine_span(a, src1), affine_span(b, src2)).contains(x)
}

theorem affine_span_product_subset_product_spans[V: AddCommGroup, W: AddCommGroup, P, Q](
    a: AffineSpace[V, P],
    b: AffineSpace[W, Q],
    src1: P -> Bool,
    src2: Q -> Bool
) {
    affine_subspace_subset(
        affine_span(
            affine_space_product(a, b),
            affine_span_product_src(src1, src2)),
        affine_subspace_product(
            affine_span(a, src1), affine_span(b, src2)))
}

theorem ptolemy_nonneg_sq_eq[T: OrderedField](x: T, y: T) {
    T.0 <= x and T.0 <= y and x * x = y * y implies x = y
}

theorem ptolemy_point_add_sub_right_cancel[T: AddCommGroup](p: Point2[T], q: Point2[T]) {
    p.add(q).sub(p) = q
}

theorem ptolemy_point_sub_add_same_base[T: AddCommGroup](a: Point2[T], u: Point2[T], v: Point2[T]) {
    a.add(u).sub(a.add(v)) = u.sub(v)
}

theorem point2_norm_sq_add_eq_sub_of_orthogonal[T: CommRing](u: Point2[T], v: Point2[T]) {
    u.orthogonal(v) implies u.add(v).norm_sq = u.sub(v).norm_sq
}

define is_rectangle[T: OrderedField](a: Point2[T], b: Point2[T], c: Point2[T], d: Point2[T]) -> Bool {
    b.sub(a).orthogonal(d.sub(a)) and c = a.add(b.sub(a)).add(d.sub(a))
}

theorem is_rectangle_apply[T: OrderedField](a: Point2[T], b: Point2[T], c: Point2[T], d: Point2[T]) {
    is_rectangle(a, b, c, d) implies
        b.sub(a).orthogonal(d.sub(a)) and c = a.add(b.sub(a)).add(d.sub(a))
}

theorem point2_rectangle_diagonal_pythagoras[T: OrderedField](
    a: Point2[T], b: Point2[T], c: Point2[T], d: Point2[T]
) {
    is_rectangle(a, b, c, d) implies
    c.sub(a).norm_sq = b.sub(a).norm_sq + c.sub(b).norm_sq
}

theorem ptolemy_rectangle_squared[T: OrderedField](
    a: Point2[T], b: Point2[T], c: Point2[T], d: Point2[T]
) {
    is_rectangle(a, b, c, d) implies
    a.dist_sq(c) = a.dist_sq(b) + b.dist_sq(c)
}

theorem point2_rectangle_opposite_sides_dist_sq_eq[T: OrderedField](
    a: Point2[T], b: Point2[T], c: Point2[T], d: Point2[T]
) {
    is_rectangle(a, b, c, d) implies
    c.dist_sq(d) = a.dist_sq(b) and d.dist_sq(a) = b.dist_sq(c)
}

theorem point2_rectangle_diagonals_dist_sq_eq[T: OrderedField](
    a: Point2[T], b: Point2[T], c: Point2[T], d: Point2[T]
) {
    is_rectangle(a, b, c, d) implies a.dist_sq(c) = b.dist_sq(d)
}

theorem ptolemy_rectangle[T: OrderedField](
    a: Point2[T], b: Point2[T], c: Point2[T], d: Point2[T],
    w: T, x: T, y: T, z: T, p: T, q: T
) {
    is_rectangle(a, b, c, d) and
    w * w = a.dist_sq(b) and x * x = b.dist_sq(c) and
    y * y = c.dist_sq(d) and z * z = d.dist_sq(a) and
    p * p = a.dist_sq(c) and q * q = b.dist_sq(d) and
    w >= T.0 and x >= T.0 and y >= T.0 and z >= T.0 and p >= T.0 and q >= T.0
    implies p * q = w * y + x * z
}

theorem ptolemy_smul_add[T: CommRing](scalar: T, p: Point2[T], q: Point2[T]) {
    p.add(q).smul(scalar) = p.smul(scalar).add(q.smul(scalar))
}

theorem ptolemy_smul_sub[T: CommRing](scalar: T, p: Point2[T], q: Point2[T]) {
    p.sub(q).smul(scalar) = p.smul(scalar).sub(q.smul(scalar))
}

theorem ptolemy_smul_scalar_sub[T: CommRing](a: T, b: T, p: Point2[T]) {
    p.smul(a).sub(p.smul(b)) = p.smul(a - b)
}

theorem ptolemy_one_plus_one_neq_zero[T: OrderedField] {
    T.1 + T.1 != T.0
}

theorem ptolemy_half_plus_half[T: OrderedField] {
    (T.1 + T.1).inverse + (T.1 + T.1).inverse = T.1
}

theorem point2_rectangle_concyclic[T: OrderedField](
    a: Point2[T], b: Point2[T], c: Point2[T], d: Point2[T]
) {
    is_rectangle(a, b, c, d) implies concyclic4(a, b, c, d)
}

define is_tangent_at[T: OrderedField](
    center: Point2[T], radius_sq: T, p: Point2[T], t: Point2[T]
) -> Bool {
    center.on_circle(radius_sq, t) and p.sub(t).orthogonal(t.sub(center))
}

theorem is_tangent_at_apply[T: OrderedField](
    center: Point2[T], radius_sq: T, p: Point2[T], t: Point2[T]
) {
    is_tangent_at(center, radius_sq, p, t) implies
        center.on_circle(radius_sq, t) and p.sub(t).orthogonal(t.sub(center))
}

theorem is_tangent_at_intro[T: OrderedField](
    center: Point2[T], radius_sq: T, p: Point2[T], t: Point2[T]
) {
    center.on_circle(radius_sq, t) and p.sub(t).orthogonal(t.sub(center))
        implies is_tangent_at(center, radius_sq, p, t)
}

theorem circle_add_sub_commute[T: AddCommGroup](a: Point2[T], v: Point2[T], b: Point2[T]) {
    a.add(v).sub(b) = a.sub(b).add(v)
}

theorem circle_quadratic_move_term[T: OrderedField](x: T, y: T, z: T) {
    x + y + z = T.0 implies x + z = -y
}

theorem circle_equality_sub_rhs_zero[T: OrderedField](x: T, y: T) {
    x = y implies x - y = T.0
}

theorem circle_equality_sub_both_sides[T: OrderedField](x: T, y: T, z: T) {
    x = y implies x - z = y - z
}

theorem circle_quadratic_rearrange[T: OrderedField](d2: T, w: T, d: T, s: T, r: T) {
    (d2 + s * s * w + s * d + s * d) - r = w * s * s + (d + d) * s + (d2 - r)
}

theorem circle_secant_product_square[T: OrderedField](w: T, s: T, t: T) {
    (s * s * w) * (t * t * w) = (w * s * t) * (w * s * t)
}

theorem circle_difference_factor[T: OrderedField](u: T, c: T, s: T, t: T) {
    (u * s + c * t) - (u * t + c * s) = u * (s - t) - c * (s - t)
}

theorem circle_factor_move[T: OrderedField](u: T, c: T, s: T, t: T) {
    u * s + c * t = u * t + c * s implies
    u * (s - t) = c * (s - t)
}

theorem circle_equality_to_zero_product[T: OrderedField](u: T, c: T, s: T, t: T) {
    u * (s - t) = c * (s - t) implies
    (s - t) * (u - c) = T.0
}

theorem circle_quadratic_root_product[T: OrderedField](a: T, b: T, c: T, s: T, t: T) {
    a * s * s + b * s + c = T.0 and
    a * t * t + b * t + c = T.0 and
    s != t
    implies a * s * t = c
}

theorem point2_tangent_secant_power[T: OrderedField](
    o: Point2[T], radius_sq: T,
    p: Point2[T], a: Point2[T],
    b: Point2[T], c: Point2[T],
    w: Point2[T], s: T, t: T
) {
    o.on_circle(radius_sq, a) and
    p.sub(a).orthogonal(a.sub(o)) and
    p.add(w.smul(s)) = b and
    p.add(w.smul(t)) = c and
    o.on_circle(radius_sq, b) and
    o.on_circle(radius_sq, c) and
    s != t
    implies
    p.dist_sq(a) * p.dist_sq(a) = p.dist_sq(b) * p.dist_sq(c)
}

theorem triangle_real_two_neq_zero {
    Real.1 + Real.1 != Real.0
}

theorem triangle_double_zero_cancel(x: Real) {
    (Real.1 + Real.1) * x = Real.0 implies x = Real.0
}

theorem triangle_real_add_sub_cancel_middle(a: Real, b: Real, c: Real) {
    (a + b) - (b + c) = a - c
}

theorem triangle_real_sub_sub_same_base(x: Real, y: Real, z: Real) {
    (x - z) - (y - z) = x - y
}

theorem triangle_real_sub_sub_same_left(x: Real, y: Real, z: Real) {
    (x - y) - (x - z) = z - y
}

theorem triangle_mul_zero_cancel(b: Real, x: Real) {
    b * x = Real.0 and b != Real.0 implies x = Real.0
}

theorem triangle_sub_add_right_cancel(p: Point2[Real], q: Point2[Real]) {
    p.sub(q).add(q) = p
}

theorem triangle_add_sub_right_cancel(p: Point2[Real], q: Point2[Real]) {
    p.add(q).sub(q) = p
}

theorem triangle_sub_sub_swap(p: Point2[Real], q: Point2[Real], r: Point2[Real]) {
    p.sub(q).sub(r) = p.sub(r).sub(q)
}

theorem triangle_sub_cong_left(x: Point2[Real], y: Point2[Real], z: Point2[Real]) {
    x = y implies x.sub(z) = y.sub(z)
}

theorem triangle_double_sub_distrib(m: Point2[Real], g: Point2[Real]) {
    m.sub(g).add(m.sub(g)) = m.add(m).sub(g.add(g))
}

define triangle_centroid(
    a: Point2[Real], b: Point2[Real], c: Point2[Real], g: Point2[Real]
) -> Bool {
    a.add(b).add(c) = g.add(g).add(g)
}

theorem triangle_centroid_eq(
