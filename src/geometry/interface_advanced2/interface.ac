theorem point2_add_sub_rearrange[T: AddCommGroup](a: T, b: T, c: T) {
    (a + b) - c = b + (a - c)
}

theorem point2_sub_sub_rearrange[T: AddCommGroup](x: T, y: T, z: T) {
    x - (y - z) = z - (y - x)
