theorem lattice_point_count_of_lattice_set(s: FiniteSet[Point2[Real]]) {
    (forall(p: Point2[Real]) {
        s.contains(p) implies is_lattice_point(p)
    }) implies lattice_point_count(s) = fs_card(s)
}

