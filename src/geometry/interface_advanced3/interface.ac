structure Point3[T] {
    /// The x-coordinate.
    x: T

    /// The y-coordinate.
    y: T

    /// The z-coordinate.
    z: T
}

let point3_zero[T: AddCommMonoid]: Point3[T] = Point3.new(T.0, T.0, T.0)

/// Rebuilding a point from its coordinates gives the original point.
theorem point3_eta[T](p: Point3[T]) {
    Point3.new(p.x, p.y, p.z) = p
}

theorem point3_ext[T](p: Point3[T], q: Point3[T]) {
    p.x = q.x and p.y = q.y and p.z = q.z implies p = q
}

theorem point3_new_x[T](x: T, y: T, z: T) {
    Point3.new(x, y, z).x = x
}

theorem point3_new_y[T](x: T, y: T, z: T) {
    Point3.new(x, y, z).y = y
}

theorem point3_new_z[T](x: T, y: T, z: T) {
    Point3.new(x, y, z).z = z
}

attributes Point3[T: AddCommMonoid] {
    /// The origin of the coordinate space.
    let zero: Point3[T] = point3_zero[T]

    /// The componentwise sum of two points.
    define add(self, other: Point3[T]) -> Point3[T] {
        Point3.new(self.x + other.x, self.y + other.y, self.z + other.z)
    }
}

theorem point3_zero_x[T: AddCommMonoid] {
    point3_zero[T].x = T.0
}

theorem point3_zero_y[T: AddCommMonoid] {
    point3_zero[T].y = T.0
}

theorem point3_zero_z[T: AddCommMonoid] {
    point3_zero[T].z = T.0
}

theorem point3_add_x[T: AddCommMonoid](p: Point3[T], q: Point3[T]) {
    p.add(q).x = p.x + q.x
}

theorem point3_add_y[T: AddCommMonoid](p: Point3[T], q: Point3[T]) {
    p.add(q).y = p.y + q.y
}

theorem point3_add_z[T: AddCommMonoid](p: Point3[T], q: Point3[T]) {
    p.add(q).z = p.z + q.z
}

theorem point3_add_comm[T: AddCommMonoid](p: Point3[T], q: Point3[T]) {
    p.add(q) = q.add(p)
}

theorem point3_add_assoc[T: AddCommMonoid](p: Point3[T], q: Point3[T], r: Point3[T]) {
    p.add(q).add(r) = p.add(q.add(r))
}

theorem point3_add_zero_right[T: AddCommMonoid](p: Point3[T]) {
    p.add(point3_zero[T]) = p
}

theorem point3_add_zero_left[T: AddCommMonoid](p: Point3[T]) {
    point3_zero[T].add(p) = p
}

attributes Point3[T: AddCommGroup] {
    /// The componentwise additive inverse of a point.
    define neg(self) -> Point3[T] {
        Point3.new(-self.x, -self.y, -self.z)
    }

    /// The componentwise difference of two points.
    define sub(self, other: Point3[T]) -> Point3[T] {
        Point3.new(self.x - other.x, self.y - other.y, self.z - other.z)
    }

    /// Translation by a coordinate displacement.
    define translate(self, displacement: Point3[T]) -> Point3[T] {
        self.add(displacement)
    }
}

theorem point3_neg_x[T: AddCommGroup](p: Point3[T]) {
    p.neg.x = -p.x
}

theorem point3_neg_y[T: AddCommGroup](p: Point3[T]) {
    p.neg.y = -p.y
}

theorem point3_neg_z[T: AddCommGroup](p: Point3[T]) {
    p.neg.z = -p.z
}

theorem point3_sub_x[T: AddCommGroup](p: Point3[T], q: Point3[T]) {
    p.sub(q).x = p.x - q.x
}

theorem point3_sub_y[T: AddCommGroup](p: Point3[T], q: Point3[T]) {
    p.sub(q).y = p.y - q.y
}

theorem point3_sub_z[T: AddCommGroup](p: Point3[T], q: Point3[T]) {
    p.sub(q).z = p.z - q.z
}

theorem point3_translate_x[T: AddCommGroup](p: Point3[T], displacement: Point3[T]) {
    p.translate(displacement).x = p.x + displacement.x
}

theorem point3_translate_y[T: AddCommGroup](p: Point3[T], displacement: Point3[T]) {
    p.translate(displacement).y = p.y + displacement.y
}

theorem point3_translate_z[T: AddCommGroup](p: Point3[T], displacement: Point3[T]) {
    p.translate(displacement).z = p.z + displacement.z
}

theorem point3_sub_self[T: AddCommGroup](p: Point3[T]) {
    p.sub(p) = point3_zero[T]
}

theorem point3_add_neg_right[T: AddCommGroup](p: Point3[T]) {
    p.add(p.neg) = point3_zero[T]
}

attributes Point3[T: CommRing] {
    /// Scalar multiplication of all three coordinates.
    define smul(self, scalar: T) -> Point3[T] {
        Point3.new(scalar * self.x, scalar * self.y, scalar * self.z)
    }

    /// The dot product of two coordinate points.
    define dot(self, other: Point3[T]) -> T {
        self.x * other.x + self.y * other.y + self.z * other.z
    }

    /// The vector cross product of two coordinate points.
    define cross(self, other: Point3[T]) -> Point3[T] {
        Point3.new(
            self.y * other.z - self.z * other.y,
            self.z * other.x - self.x * other.z,
            self.x * other.y - self.y * other.x)
    }

    /// The squared coordinate norm.
    define norm_sq(self) -> T {
        self.dot(self)
    }

    /// The squared coordinate distance to another point.
    define dist_sq(self, other: Point3[T]) -> T {
        self.sub(other).norm_sq
    }

    /// The point with parameter `t` on the directed line to `other`.
    define param_line(self, other: Point3[T], t: T) -> Point3[T] {
        self.add(other.sub(self).smul(t))
    }
}

theorem point3_smul_x[T: CommRing](p: Point3[T], scalar: T) {
    p.smul(scalar).x = scalar * p.x
}

theorem point3_smul_y[T: CommRing](p: Point3[T], scalar: T) {
    p.smul(scalar).y = scalar * p.y
}

theorem point3_smul_z[T: CommRing](p: Point3[T], scalar: T) {
    p.smul(scalar).z = scalar * p.z
}

theorem point3_dot_comm[T: CommRing](p: Point3[T], q: Point3[T]) {
    p.dot(q) = q.dot(p)
}

theorem point3_cross_x[T: CommRing](a: Point3[T], b: Point3[T]) {
    a.cross(b).x = a.y * b.z - a.z * b.y
}

theorem point3_cross_y[T: CommRing](a: Point3[T], b: Point3[T]) {
    a.cross(b).y = a.z * b.x - a.x * b.z
}

theorem point3_cross_z[T: CommRing](a: Point3[T], b: Point3[T]) {
    a.cross(b).z = a.x * b.y - a.y * b.x
}

theorem point3_cross_self[T: CommRing](p: Point3[T]) {
    p.cross(p) = point3_zero[T]
}

theorem point3_cross_zero_left[T: CommRing](p: Point3[T]) {
    point3_zero[T].cross(p) = point3_zero[T]
}

theorem point3_cross_zero_right[T: CommRing](p: Point3[T]) {
    p.cross(point3_zero[T]) = point3_zero[T]
}

theorem point3_add_pair_rearrange[T: AddCommGroup](a: T, b: T, c: T, d: T) {
    (a + b) + (c + d) = (a + c) + (b + d)
}

theorem point3_add_four_last_next_to_first[T: AddCommGroup](a: T, b: T, c: T, d: T) {
    a + b + c + d = (a + d) + (b + c)
}

theorem point3_scalar_sub_through[T: AddCommGroup](x: T, y: T, z: T) {
    (y - x) + (z - y) = z - x
}

theorem point3_scalar_sub_reverse_neg[T: AddCommGroup](x: T, y: T) {
    x - y = -(y - x)
}

theorem point3_scalar_sub_pair_rearrange[T: AddCommGroup](a: T, b: T, c: T, d: T) {
    (a + b) - (c + d) = (a - c) + (b - d)
}

theorem point3_scalar_rev_sub_pair[T: AddCommGroup](a: T, b: T, c: T, d: T) {
    (a - c) + (b - d) = (a + b) - (c + d)
}

theorem point3_scalar_sub_of_sub[T: AddCommGroup](a: T, b: T, c: T, d: T) {
    (a - b) - (c - d) = (a - b) + (d - c)
}

theorem point3_scalar_sub_same_base[T: AddCommGroup](a: T, b: T, c: T) {
    (c - a) - (b - a) = c - b
}

theorem point3_scalar_add_sub_cancel[T: AddCommGroup](x: T, y: T, z: T) {
    (x + y) - (x + z) = y - z
}

theorem point3_scalar_add_sub_cancel3[T: AddCommGroup](x: T, y: T, z: T, a: T, b: T) {
    (x + y + a) - (x + z + b) = (y + a) - (z + b)
}

theorem point3_scalar_cyclic_cancel[T: AddCommGroup](a: T, b: T, c: T) {
    (a - b) + (c - a) + (b - c) = T.0
}

theorem point3_ring_square_add[T: CommRing](x: T, y: T) {
    (x + y) * (x + y) = x * x + x * y + (x * y + y * y)
}

theorem point3_ring_square_sub[T: CommRing](x: T, y: T) {
    (x - y) * (x - y) = x * x - x * y - y * x + y * y
}

theorem point3_scalar_dist_sub_left[T: CommRing](x: T, a: T, b: T) {
    x * (a - b) = x * a - x * b
}

theorem point3_scalar_dist_sub_right[T: CommRing](a: T, b: T, x: T) {
    (a - b) * x = a * x - b * x
}

theorem point3_scalar_dist_sum3[T: CommRing](x: T, a: T, b: T, c: T) {
    x * (a + b + c) = x * a + x * b + x * c
}

theorem point3_scalar_prod_rearrange3[T: CommRing](x: T, y: T, z: T) {
    x * (y * z) = y * x * z
}

attributes Point3[T: CommRing] {
    /// True when two points are orthogonal as coordinate vectors.
    define orthogonal(self, other: Point3[T]) -> Bool {
        self.dot(other) = T.0
    }
}

theorem point3_sub_reverse_neg[T: AddCommGroup](p: Point3[T], q: Point3[T]) {
    p.sub(q) = q.sub(p).neg
}

theorem point3_sub_eq_add_neg[T: AddCommGroup](p: Point3[T], q: Point3[T]) {
    p.sub(q) = p.add(q.neg)
}

theorem point3_sub_add_sub[T: AddCommGroup](a: Point3[T], b: Point3[T], c: Point3[T], d: Point3[T]) {
    a.add(b).sub(c.add(d)) = a.sub(c).add(b.sub(d))
}

theorem point3_sub_through[T: AddCommGroup](a: Point3[T], b: Point3[T], c: Point3[T]) {
    b.sub(a).add(c.sub(b)) = c.sub(a)
}

theorem point3_sub_zero_right[T: AddCommGroup](p: Point3[T]) {
    p.sub(point3_zero[T]) = p
}

theorem point3_sub_same_base[T: AddCommGroup](a: Point3[T], b: Point3[T], c: Point3[T]) {
    c.sub(a).sub(b.sub(a)) = c.sub(b)
}

theorem point3_dot_zero_left[T: CommRing](p: Point3[T]) {
    point3_zero[T].dot(p) = T.0
}

theorem point3_dot_zero_right[T: CommRing](p: Point3[T]) {
    p.dot(point3_zero[T]) = T.0
}

theorem point3_dot_neg_left[T: CommRing](p: Point3[T], q: Point3[T]) {
    p.neg.dot(q) = -p.dot(q)
}

theorem point3_dot_neg_right[T: CommRing](p: Point3[T], q: Point3[T]) {
    p.dot(q.neg) = -p.dot(q)
}

theorem point3_dot_add_left[T: CommRing](a: Point3[T], b: Point3[T], c: Point3[T]) {
    a.add(b).dot(c) = a.dot(c) + b.dot(c)
}

theorem point3_dot_add_right[T: CommRing](a: Point3[T], b: Point3[T], c: Point3[T]) {
    a.dot(b.add(c)) = a.dot(b) + a.dot(c)
}

theorem point3_dot_sub_left[T: CommRing](a: Point3[T], b: Point3[T], c: Point3[T]) {
    a.sub(b).dot(c) = a.dot(c) - b.dot(c)
}

theorem point3_dot_sub_right[T: CommRing](a: Point3[T], b: Point3[T], c: Point3[T]) {
    a.dot(b.sub(c)) = a.dot(b) - a.dot(c)
}

theorem point3_dot_smul_left[T: CommRing](scalar: T, a: Point3[T], b: Point3[T]) {
    a.smul(scalar).dot(b) = scalar * a.dot(b)
}

theorem point3_dot_smul_right[T: CommRing](scalar: T, a: Point3[T], b: Point3[T]) {
    a.dot(b.smul(scalar)) = scalar * a.dot(b)
}

theorem point3_norm_sq_smul[T: CommRing](scalar: T, p: Point3[T]) {
    p.smul(scalar).norm_sq = scalar * scalar * p.norm_sq
}

theorem point3_norm_sq_nonneg[T: OrderedField](p: Point3[T]) {
    p.norm_sq >= T.0
}

theorem point3_norm_sq_zero[T: CommRing](p: Point3[T]) {
    p = point3_zero[T] implies p.norm_sq = T.0
}

theorem point3_norm_sq_neg[T: CommRing](p: Point3[T]) {
    p.neg.norm_sq = p.norm_sq
}

theorem point3_norm_sq_add_expansion[T: CommRing](a: Point3[T], b: Point3[T]) {
    a.add(b).norm_sq = a.norm_sq + b.norm_sq + a.dot(b) + a.dot(b)
}

theorem point3_norm_sq_sub_expansion[T: CommRing](a: Point3[T], b: Point3[T]) {
    a.sub(b).norm_sq = a.norm_sq + b.norm_sq - a.dot(b) - a.dot(b)
}

theorem point3_dist_sq_self[T: CommRing](p: Point3[T]) {
    p.dist_sq(p) = T.0
}

theorem point3_dist_sq_comm[T: CommRing](p: Point3[T], q: Point3[T]) {
    p.dist_sq(q) = q.dist_sq(p)
}

theorem point3_dist_sq_eq_norm_sq_sub[T: CommRing](p: Point3[T], q: Point3[T]) {
    p.dist_sq(q) = p.sub(q).norm_sq
}

theorem point3_dist_sq_zero_right[T: CommRing](p: Point3[T]) {
    p.dist_sq(point3_zero[T]) = p.norm_sq
}

theorem point3_cross_neg_left[T: CommRing](a: Point3[T], b: Point3[T]) {
    a.neg.cross(b) = a.cross(b).neg
}

theorem point3_cross_neg_right[T: CommRing](a: Point3[T], b: Point3[T]) {
    a.cross(b.neg) = a.cross(b).neg
}

theorem point3_cross_swap[T: CommRing](a: Point3[T], b: Point3[T]) {
    a.cross(b) = b.cross(a).neg
}

theorem point3_cross_add_left[T: CommRing](a: Point3[T], b: Point3[T], c: Point3[T]) {
    a.add(b).cross(c) = a.cross(c).add(b.cross(c))
}

theorem point3_cross_add_right[T: CommRing](a: Point3[T], b: Point3[T], c: Point3[T]) {
    a.cross(b.add(c)) = a.cross(b).add(a.cross(c))
}

theorem point3_cross_smul_left[T: CommRing](scalar: T, a: Point3[T], b: Point3[T]) {
    a.smul(scalar).cross(b) = a.cross(b).smul(scalar)
}

theorem point3_cross_smul_right[T: CommRing](scalar: T, a: Point3[T], b: Point3[T]) {
    a.cross(b.smul(scalar)) = a.cross(b).smul(scalar)
}

theorem point3_cross_sub_left[T: CommRing](a: Point3[T], b: Point3[T], c: Point3[T]) {
    a.sub(b).cross(c) = a.cross(c).sub(b.cross(c))
}

theorem point3_cross_sub_right[T: CommRing](a: Point3[T], b: Point3[T], c: Point3[T]) {
    a.cross(b.sub(c)) = a.cross(b).sub(a.cross(c))
}

theorem point3_orthogonal_comm[T: CommRing](p: Point3[T], q: Point3[T]) {
    p.orthogonal(q) = q.orthogonal(p)
}

theorem point3_orthogonal_neg_left[T: CommRing](p: Point3[T], q: Point3[T]) {
    p.neg.orthogonal(q) = p.orthogonal(q)
}

theorem point3_orthogonal_neg_right[T: CommRing](p: Point3[T], q: Point3[T]) {
    p.orthogonal(q.neg) = p.orthogonal(q)
}

theorem point3_orthogonal_smul_left[T: CommRing](scalar: T, p: Point3[T], q: Point3[T]) {
    p.orthogonal(q) implies p.smul(scalar).orthogonal(q)
}

theorem point3_orthogonal_smul_right[T: CommRing](scalar: T, p: Point3[T], q: Point3[T]) {
    p.orthogonal(q) implies p.orthogonal(q.smul(scalar))
}

theorem point3_pythagoras_vectors[T: CommRing](p: Point3[T], q: Point3[T]) {
    p.orthogonal(q) implies p.add(q).norm_sq = p.norm_sq + q.norm_sq
}

theorem point3_pythagoras_points_from_ab[T: CommRing](a: Point3[T], b: Point3[T], c: Point3[T]) {
    b.sub(a).orthogonal(c.sub(b)) implies
    c.sub(a).norm_sq = b.sub(a).norm_sq + c.sub(b).norm_sq
}

theorem point3_pythagoras_points[T: CommRing](a: Point3[T], b: Point3[T], c: Point3[T]) {
    a.sub(b).orthogonal(c.sub(b)) implies
    c.sub(a).norm_sq = b.sub(a).norm_sq + c.sub(b).norm_sq
}

theorem point3_cross_orthogonal_left[T: CommRing](u: Point3[T], v: Point3[T]) {
    u.cross(v).dot(u) = T.0
}

theorem point3_cross_orthogonal_right[T: CommRing](u: Point3[T], v: Point3[T]) {
    u.cross(v).dot(v) = T.0
}

theorem point3_scalar_triple_rotate[T: CommRing](u: Point3[T], v: Point3[T], w: Point3[T]) {
    u.dot(v.cross(w)) = v.dot(w.cross(u))
}

theorem point3_scalar_triple_rotate2[T: CommRing](u: Point3[T], v: Point3[T], w: Point3[T]) {
    u.dot(v.cross(w)) = w.dot(u.cross(v))
}

theorem point3_scalar_triple_mixed[T: CommRing](u: Point3[T], v: Point3[T], w: Point3[T]) {
    u.cross(v).dot(w) = u.dot(v.cross(w))
}

theorem point3_vector_triple_product[T: CommRing](u: Point3[T], v: Point3[T], w: Point3[T]) {
    u.cross(v.cross(w)) = v.smul(u.dot(w)).sub(w.smul(u.dot(v)))
}

theorem point3_cross_norm_sq_identity[T: CommRing](u: Point3[T], v: Point3[T]) {
    u.cross(v).norm_sq = u.norm_sq * v.norm_sq - u.dot(v) * u.dot(v)
}

theorem point3_nonneg_gap_imp_le[T: OrderedField](a: T, b: T) {
    T.0 <= a - b implies b <= a
}

theorem point3_cauchy_schwarz[T: OrderedField](u: Point3[T], v: Point3[T]) {
    u.dot(v) * u.dot(v) <= u.norm_sq * v.norm_sq
}

define point3_cos_angle_sq[T: OrderedField](u: Point3[T], v: Point3[T]) -> T {
    u.dot(v) * u.dot(v) * (u.norm_sq * v.norm_sq).inverse
}

theorem point3_cos_angle_sq_le_one[T: OrderedField](u: Point3[T], v: Point3[T]) {
    u.norm_sq * v.norm_sq != T.0 implies point3_cos_angle_sq(u, v) <= T.1
}

theorem point3_sub_sub_eq_sub_add[T: AddCommGroup](x: T, y: T, z: T) {
    x - y - z = x - (y + z)
}

theorem point3_sub_sub_rearrange[T: AddCommGroup](x: T, y: T, z: T) {
    x - (y - z) = z - (y - x)
}

theorem point3_sub_eq_sub_imp_sub_eq[T: AddCommGroup](sum: T, removed: T, x: T) {
    x = sum - removed implies sum - x = removed
}

theorem point3_law_of_cosines_dist_sq[T: CommRing](a: Point3[T], b: Point3[T], c: Point3[T]) {
    b.dist_sq(c) =
        a.dist_sq(b) + a.dist_sq(c) -
        b.sub(a).dot(c.sub(a)) - b.sub(a).dot(c.sub(a))
}

theorem point3_double_dot_from_dist_sq[T: CommRing](a: Point3[T], b: Point3[T], c: Point3[T]) {
    b.sub(a).dot(c.sub(a)) + b.sub(a).dot(c.sub(a)) =
        a.dist_sq(b) + a.dist_sq(c) - b.dist_sq(c)
}

attributes Point3[T: CommRing] {
    /// True when `x` lies on the plane through `self` with normal `n`.
    define on_plane(self, n: Point3[T], x: Point3[T]) -> Bool {
        n.dot(x.sub(self)) = T.0
    }

    /// True when `p` lies on the sphere with this center and squared radius.
    define on_sphere(self, radius_sq: T, p: Point3[T]) -> Bool {
        p.dist_sq(self) = radius_sq
    }
}

theorem point3_on_plane_eq_dot[T: CommRing](p: Point3[T], n: Point3[T], x: Point3[T]) {
    p.on_plane(n, x) = (n.dot(x.sub(p)) = T.0)
}

theorem point3_on_sphere_eq_dist_sq[T: CommRing](center: Point3[T], radius_sq: T, p: Point3[T]) {
    center.on_sphere(radius_sq, p) = (p.dist_sq(center) = radius_sq)
}

define point3_dist_to_plane_sq[T: OrderedField](p: Point3[T], n: Point3[T], x: Point3[T]) -> T {
    n.dot(x.sub(p)) * n.dot(x.sub(p)) * n.norm_sq.inverse
}

theorem point3_plane_normal_orthogonal_chord[T: CommRing](
    p: Point3[T], n: Point3[T], x: Point3[T], y: Point3[T]
) {
    p.on_plane(n, x) and p.on_plane(n, y) implies n.dot(x.sub(y)) = T.0
}

theorem point3_dist_to_plane_sq_of_plane_point[T: OrderedField](
    p: Point3[T], n: Point3[T], x: Point3[T]
) {
    p.on_plane(n, x) implies point3_dist_to_plane_sq(p, n, x) = T.0
}

define point3_parallelogram_area_sq[T: CommRing](u: Point3[T], v: Point3[T]) -> T {
    u.cross(v).norm_sq
}

define point3_parallelepiped_volume_sq[T: CommRing](u: Point3[T], v: Point3[T], w: Point3[T]) -> T {
    u.dot(v.cross(w)) * u.dot(v.cross(w))
}

theorem point3_parallelogram_area_sq_eq_lagrange[T: CommRing](u: Point3[T], v: Point3[T]) {
    point3_parallelogram_area_sq(u, v) = u.norm_sq * v.norm_sq - u.dot(v) * u.dot(v)
}

theorem point3_parallelepiped_volume_sq_rotate[T: CommRing](u: Point3[T], v: Point3[T], w: Point3[T]) {
    point3_parallelepiped_volume_sq(u, v, w) = point3_parallelepiped_volume_sq(v, w, u)
}

theorem point3_parallelepiped_volume_sq_rotate2[T: CommRing](u: Point3[T], v: Point3[T], w: Point3[T]) {
    point3_parallelepiped_volume_sq(u, v, w) = point3_parallelepiped_volume_sq(w, u, v)
}

theorem point3_parallelepiped_volume_sq_repeat[T: CommRing](u: Point3[T], v: Point3[T]) {
    point3_parallelepiped_volume_sq(u, v, v) = T.0
}

define affine_product_fst[P, Q](p: Pair[P, Q]) -> P {
    p.first
}

define affine_product_snd[P, Q](p: Pair[P, Q]) -> Q {
    p.second
}

theorem affine_map_product_fst_constraint[V: AddCommGroup, W: AddCommGroup, P, Q](
    a: AffineSpace[V, P], b: AffineSpace[W, Q]) {
    affine_map_constraint(
        affine_space_product(a, b), a, affine_product_fst[P, Q])
}

theorem affine_map_product_snd_constraint[V: AddCommGroup, W: AddCommGroup, P, Q](
    a: AffineSpace[V, P], b: AffineSpace[W, Q]) {
    affine_map_constraint(
        affine_space_product(a, b), b, affine_product_snd[P, Q])
}

let affine_map_product_fst[V: AddCommGroup, W: AddCommGroup, P, Q](a: AffineSpace[V, P], b: AffineSpace[W, Q]) -> result: AffineMap[Pair[V, W], Pair[P, Q], V, P] satisfy {
    AffineMap.new(
        affine_space_product(a, b), a, affine_product_fst[P, Q]) =
        Option.some(result)
}

let affine_map_product_snd[V: AddCommGroup, W: AddCommGroup, P, Q](a: AffineSpace[V, P], b: AffineSpace[W, Q]) -> result: AffineMap[Pair[V, W], Pair[P, Q], W, Q] satisfy {
    AffineMap.new(
        affine_space_product(a, b), b, affine_product_snd[P, Q]) =
        Option.some(result)
}

theorem affine_map_product_fst_apply[V: AddCommGroup, W: AddCommGroup, P, Q](
    a: AffineSpace[V, P], b: AffineSpace[W, Q], p: Pair[P, Q]) {
    affine_map_product_fst(a, b).to_fun(p) = p.first
}

theorem affine_map_product_snd_apply[V: AddCommGroup, W: AddCommGroup, P, Q](
    a: AffineSpace[V, P], b: AffineSpace[W, Q], p: Pair[P, Q]) {
    affine_map_product_snd(a, b).to_fun(p) = p.second
}

theorem affine_map_product_fst_src[V: AddCommGroup, W: AddCommGroup, P, Q](
    a: AffineSpace[V, P], b: AffineSpace[W, Q]) {
    affine_map_product_fst(a, b).src = affine_space_product(a, b)
}

theorem affine_map_product_fst_dst[V: AddCommGroup, W: AddCommGroup, P, Q](
    a: AffineSpace[V, P], b: AffineSpace[W, Q]) {
    affine_map_product_fst(a, b).dst = a
}

theorem affine_map_product_snd_src[V: AddCommGroup, W: AddCommGroup, P, Q](
    a: AffineSpace[V, P], b: AffineSpace[W, Q]) {
    affine_map_product_snd(a, b).src = affine_space_product(a, b)
}

theorem affine_map_product_snd_dst[V: AddCommGroup, W: AddCommGroup, P, Q](
    a: AffineSpace[V, P], b: AffineSpace[W, Q]) {
    affine_map_product_snd(a, b).dst = b
}

theorem affine_map_product_fst_preimage_eq[V: AddCommGroup, W: AddCommGroup, P, Q](
    a: AffineSpace[V, P], b: AffineSpace[W, Q],
    s: AffineSubspace[V, P],
    pre: AffineSubspace[Pair[V, W], Pair[P, Q]]
) {
    s.space = a
        and affine_map_preimage(affine_map_product_fst(a, b), s) =
            Option.some(pre)
        implies pre = affine_subspace_product(s, affine_subspace_univ(b))
}

theorem affine_map_product_fst_preimage[V: AddCommGroup, W: AddCommGroup, P, Q](
    a: AffineSpace[V, P], b: AffineSpace[W, Q],
    s: AffineSubspace[V, P]
) {
    s.space = a implies
        affine_map_preimage(affine_map_product_fst(a, b), s) =
            Option.some(affine_subspace_product(s, affine_subspace_univ(b)))
}

theorem affine_map_product_snd_preimage_eq[V: AddCommGroup, W: AddCommGroup, P, Q](
    a: AffineSpace[V, P], b: AffineSpace[W, Q],
    s: AffineSubspace[W, Q],
    pre: AffineSubspace[Pair[V, W], Pair[P, Q]]
) {
    s.space = b
        and affine_map_preimage(affine_map_product_snd(a, b), s) =
            Option.some(pre)
        implies pre = affine_subspace_product(affine_subspace_univ(a), s)
}

theorem affine_map_product_snd_preimage[V: AddCommGroup, W: AddCommGroup, P, Q](
    a: AffineSpace[V, P], b: AffineSpace[W, Q],
    s: AffineSubspace[W, Q]
) {
    s.space = b implies
        affine_map_preimage(affine_map_product_snd(a, b), s) =
            Option.some(affine_subspace_product(affine_subspace_univ(a), s))
}

define affine_map_product_fun[V1: AddCommGroup, P1, V2: AddCommGroup, P2, W1: AddCommGroup, Q1, W2: AddCommGroup, Q2](
    f: AffineMap[V1, P1, V2, P2], g: AffineMap[W1, Q1, W2, Q2],
    p: Pair[P1, Q1]
) -> Pair[P2, Q2] {
    Pair.new(f.to_fun(p.first), g.to_fun(p.second))
}

theorem affine_map_product_fun_apply[V1: AddCommGroup, P1, V2: AddCommGroup, P2, W1: AddCommGroup, Q1, W2: AddCommGroup, Q2](
    f: AffineMap[V1, P1, V2, P2], g: AffineMap[W1, Q1, W2, Q2],
    p: Pair[P1, Q1]
) {
    affine_map_product_fun(f, g, p) =
        Pair.new(f.to_fun(p.first), g.to_fun(p.second))
}

theorem affine_map_product_constraint[V1: AddCommGroup, P1, V2: AddCommGroup, P2, W1: AddCommGroup, Q1, W2: AddCommGroup, Q2](
    f: AffineMap[V1, P1, V2, P2], g: AffineMap[W1, Q1, W2, Q2]
) {
    affine_map_constraint(
        affine_space_product(f.src, g.src), affine_space_product(f.dst, g.dst),
        affine_map_product_fun(f, g))
}

let affine_map_product[V1: AddCommGroup, P1, V2: AddCommGroup, P2, W1: AddCommGroup, Q1, W2: AddCommGroup, Q2](f: AffineMap[V1, P1, V2, P2], g: AffineMap[W1, Q1, W2, Q2]) -> result: AffineMap[Pair[V1, W1], Pair[P1, Q1], Pair[V2, W2], Pair[P2, Q2]] satisfy {
    AffineMap.new(
        affine_space_product(f.src, g.src), affine_space_product(f.dst, g.dst),
        affine_map_product_fun(f, g)) = Option.some(result)
}

theorem affine_map_product_apply[V1: AddCommGroup, P1, V2: AddCommGroup, P2, W1: AddCommGroup, Q1, W2: AddCommGroup, Q2](
    f: AffineMap[V1, P1, V2, P2], g: AffineMap[W1, Q1, W2, Q2],
    p: Pair[P1, Q1]
) {
    affine_map_product(f, g).to_fun(p) =
        Pair.new(f.to_fun(p.first), g.to_fun(p.second))
}

theorem affine_map_product_src[V1: AddCommGroup, P1, V2: AddCommGroup, P2, W1: AddCommGroup, Q1, W2: AddCommGroup, Q2](
    f: AffineMap[V1, P1, V2, P2], g: AffineMap[W1, Q1, W2, Q2]
) {
    affine_map_product(f, g).src = affine_space_product(f.src, g.src)
}

theorem affine_map_product_dst[V1: AddCommGroup, P1, V2: AddCommGroup, P2, W1: AddCommGroup, Q1, W2: AddCommGroup, Q2](
    f: AffineMap[V1, P1, V2, P2], g: AffineMap[W1, Q1, W2, Q2]
) {
    affine_map_product(f, g).dst = affine_space_product(f.dst, g.dst)
}

theorem affine_map_product_id[V: AddCommGroup, W: AddCommGroup, P, Q](
    a: AffineSpace[V, P], b: AffineSpace[W, Q]
) {
    affine_map_product(affine_map_id(a), affine_map_id(b)) =
        affine_map_id(affine_space_product(a, b))
}

theorem affine_map_product_compose[V1: AddCommGroup, P1, V2: AddCommGroup, P2, V3: AddCommGroup, P3, W1: AddCommGroup, Q1, W2: AddCommGroup, Q2, W3: AddCommGroup, Q3](
    f1: AffineMap[V1, P1, V2, P2], f2: AffineMap[V2, P2, V3, P3],
    g1: AffineMap[W1, Q1, W2, Q2], g2: AffineMap[W2, Q2, W3, Q3],
    fcomp: AffineMap[V1, P1, V3, P3], gcomp: AffineMap[W1, Q1, W3, Q3]
) {
    affine_map_compose(f1, f2) = Option.some(fcomp)
    and affine_map_compose(g1, g2) = Option.some(gcomp)
    implies affine_map_compose(
        affine_map_product(f1, g1), affine_map_product(f2, g2)) =
        Option.some(affine_map_product(fcomp, gcomp))
}

theorem affine_map_product_fst_natural[V1: AddCommGroup, P1, V2: AddCommGroup, P2, W1: AddCommGroup, Q1, W2: AddCommGroup, Q2](
    f: AffineMap[V1, P1, V2, P2], g: AffineMap[W1, Q1, W2, Q2]
) {
    affine_map_compose(
        affine_map_product(f, g), affine_map_product_fst(f.dst, g.dst)) =
        affine_map_compose(affine_map_product_fst(f.src, g.src), f)
}

theorem affine_map_product_snd_natural[V1: AddCommGroup, P1, V2: AddCommGroup, P2, W1: AddCommGroup, Q1, W2: AddCommGroup, Q2](
    f: AffineMap[V1, P1, V2, P2], g: AffineMap[W1, Q1, W2, Q2]
) {
    affine_map_compose(
        affine_map_product(f, g), affine_map_product_snd(f.dst, g.dst)) =
        affine_map_compose(affine_map_product_snd(f.src, g.src), g)
}

define affine_span_product_src[P, Q](
    src1: P -> Bool, src2: Q -> Bool, x: Pair[P, Q]) -> Bool {
    src1(x.first) and src2(x.second)
}

theorem affine_span_product_src_iff[P, Q](
    src1: P -> Bool, src2: Q -> Bool, x: Pair[P, Q]
) {
    affine_span_product_src(src1, src2, x) =
        (src1(x.first) and src2(x.second))
}

theorem affine_span_product_src_mem_product_spans[V: AddCommGroup, W: AddCommGroup, P, Q](
    a: AffineSpace[V, P],
    b: AffineSpace[W, Q],
    src1: P -> Bool,
    src2: Q -> Bool,
    x: Pair[P, Q]
) {
    affine_span_product_src(src1, src2, x) implies
        affine_subspace_product(
            affine_span(a, src1), affine_span(b, src2)).contains(x)
}

theorem affine_span_product_subset_product_spans[V: AddCommGroup, W: AddCommGroup, P, Q](
    a: AffineSpace[V, P],
    b: AffineSpace[W, Q],
    src1: P -> Bool,
    src2: Q -> Bool
) {
    affine_subspace_subset(
        affine_span(
            affine_space_product(a, b),
            affine_span_product_src(src1, src2)),
        affine_subspace_product(
            affine_span(a, src1), affine_span(b, src2)))
}

theorem triangle_real_two_neq_zero {
    Real.1 + Real.1 != Real.0
}

theorem triangle_double_zero_cancel(x: Real) {
    (Real.1 + Real.1) * x = Real.0 implies x = Real.0
}

theorem triangle_real_add_sub_cancel_middle(a: Real, b: Real, c: Real) {
    (a + b) - (b + c) = a - c
}

theorem triangle_real_sub_sub_same_base(x: Real, y: Real, z: Real) {
    (x - z) - (y - z) = x - y
}

theorem triangle_real_sub_sub_same_left(x: Real, y: Real, z: Real) {
    (x - y) - (x - z) = z - y
}

theorem triangle_mul_zero_cancel(b: Real, x: Real) {
    b * x = Real.0 and b != Real.0 implies x = Real.0
}

theorem triangle_sub_add_right_cancel(p: Point2[Real], q: Point2[Real]) {
    p.sub(q).add(q) = p
}

theorem triangle_add_sub_right_cancel(p: Point2[Real], q: Point2[Real]) {
    p.add(q).sub(q) = p
}

theorem triangle_sub_sub_swap(p: Point2[Real], q: Point2[Real], r: Point2[Real]) {
    p.sub(q).sub(r) = p.sub(r).sub(q)
}

theorem triangle_sub_cong_left(x: Point2[Real], y: Point2[Real], z: Point2[Real]) {
    x = y implies x.sub(z) = y.sub(z)
}

theorem triangle_double_sub_distrib(m: Point2[Real], g: Point2[Real]) {
    m.sub(g).add(m.sub(g)) = m.add(m).sub(g.add(g))
}

define triangle_centroid(
    a: Point2[Real], b: Point2[Real], c: Point2[Real], g: Point2[Real]
) -> Bool {
    a.add(b).add(c) = g.add(g).add(g)
}

theorem triangle_centroid_eq(
    a: Point2[Real], b: Point2[Real], c: Point2[Real], g: Point2[Real]
) {
    triangle_centroid(a, b, c, g) = (a.add(b).add(c) = g.add(g).add(g))
}

define triangle_midpoint(a: Point2[Real], b: Point2[Real], m: Point2[Real]) -> Bool {
    a.add(b) = m.add(m)
}

theorem triangle_midpoint_eq(a: Point2[Real], b: Point2[Real], m: Point2[Real]) {
    triangle_midpoint(a, b, m) = (a.add(b) = m.add(m))
}

theorem triangle_centroid_double_sum(
    a: Point2[Real], b: Point2[Real], c: Point2[Real],
    g: Point2[Real], m: Point2[Real]
) {
    triangle_midpoint(b, c, m) and triangle_centroid(a, b, c, g)
    implies
    g.add(g).add(g) = a.add(m.add(m))
}

theorem triangle_trisection_of_double_sum(
    a: Point2[Real], m: Point2[Real], g: Point2[Real]
) {
    g.add(g).add(g) = a.add(m.add(m))
    implies
    g.sub(a) = m.sub(g).add(m.sub(g))
}

theorem triangle_centroid_median_trisection(
    a: Point2[Real], b: Point2[Real], c: Point2[Real],
    g: Point2[Real], m: Point2[Real]
) {
    triangle_midpoint(b, c, m) and triangle_centroid(a, b, c, g)
    implies
    g.sub(a) = m.sub(g).add(m.sub(g))
}

theorem triangle_trisection_collinear(
    a: Point2[Real], m: Point2[Real], g: Point2[Real]
) {
    g.sub(a) = m.sub(g).add(m.sub(g))
    implies
    a.collinear(g, m)
}

theorem triangle_centroid_on_median(
    a: Point2[Real], b: Point2[Real], c: Point2[Real],
    g: Point2[Real], m: Point2[Real]
) {
    triangle_midpoint(b, c, m) and triangle_centroid(a, b, c, g)
    implies
    a.collinear(g, m)
}

define triangle_circumcenter(
    o: Point2[Real], a: Point2[Real], b: Point2[Real], c: Point2[Real]
) -> Bool {
    a.dist_sq(o) = b.dist_sq(o) and b.dist_sq(o) = c.dist_sq(o)
}

theorem triangle_circumcenter_eq(
    o: Point2[Real], a: Point2[Real], b: Point2[Real], c: Point2[Real]
) {
    triangle_circumcenter(o, a, b, c) =
        (a.dist_sq(o) = b.dist_sq(o) and b.dist_sq(o) = c.dist_sq(o))
}

define triangle_circumcircle(
    o: Point2[Real], radius_sq: Real,
    a: Point2[Real], b: Point2[Real], c: Point2[Real]
) -> Bool {
    a.sub(o).norm_sq = radius_sq and
    b.sub(o).norm_sq = radius_sq and
    c.sub(o).norm_sq = radius_sq
}

theorem triangle_circumcircle_eq(
    o: Point2[Real], radius_sq: Real,
    a: Point2[Real], b: Point2[Real], c: Point2[Real]
) {
    triangle_circumcircle(o, radius_sq, a, b, c) =
        (a.sub(o).norm_sq = radius_sq and
         b.sub(o).norm_sq = radius_sq and
         c.sub(o).norm_sq = radius_sq)
}

theorem triangle_norm_sq_sub_sq(p: Point2[Real], q: Point2[Real]) {
    p.norm_sq - q.norm_sq = p.sub(q).dot(p.add(q))
}

theorem triangle_sub_sub_same_base(
    x: Point2[Real], y: Point2[Real], z: Point2[Real]
) {
    x.sub(z).sub(y.sub(z)) = x.sub(y)
}
