}

define point2_norm(p: Point2[Real]) -> Real {
    match (p.norm_sq).sqrt {
        Option.some(y) {
            y
        }
        Option.none {
            Real.0
        }
    }
}

theorem point2_norm_spec(p: Point2[Real]) {
