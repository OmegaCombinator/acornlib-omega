theorem point2_polygon_area2_reverse_triple_neg[T: OrderedField](a: Point2[T], b: Point2[T], c: Point2[T]) {
    point2_polygon_area2(reverse(List.cons(a, List.cons(b, List.cons(c, List.nil[Point2[T]]))))) =
