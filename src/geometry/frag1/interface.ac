        }
        List.cons(first, tail) {
            match tail {
                List.nil {
                    true
                }
                List.cons(second, rest) {
                    point2_weak_left_turn_chain(first, second, rest)
                }
            }
        }
    }
}

define point2_all_weak_right_turns[T: OrderedField](points: List[Point2[T]]) -> Bool {
