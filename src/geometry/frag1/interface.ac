theorem point2_triangle_area2_param_line_zero[T: OrderedField](a: Point2[T], b: Point2[T], t: T) {
    a.triangle_area2(b, a.param_line(b, t)) = T.0
}

theorem point2_triangle_area2_param_line_zero_middle[T: OrderedField](a: Point2[T], b: Point2[T], t: T) {
    a.triangle_area2(a.param_line(b, t), b) = T.0
}

theorem point2_triangle_area2_param_line_zero_first[T: OrderedField](a: Point2[T], b: Point2[T], t: T) {
    a.param_line(b, t).triangle_area2(a, b) = T.0
}

theorem point2_triangle_param_line_collinear[T: OrderedField](a: Point2[T], b: Point2[T], t: T) {
    a.collinear(b, a.param_line(b, t))
}

theorem point2_scalar_sub_same_base[T: AddCommGroup](a: T, b: T, c: T) {
    (c - a) - (b - a) = c - b
}

theorem point2_sub_same_base[T: AddCommGroup](a: Point2[T], b: Point2[T], c: Point2[T]) {
    c.sub(a).sub(b.sub(a)) = c.sub(b)
}

theorem point2_cancel_sub_add[T: AddCommGroup](x: T, m: T, z: T) {
    (x - m) + (m + z) = x + z
}

theorem point2_add_sub_rearrange[T: AddCommGroup](a: T, b: T, c: T) {
    (a + b) - c = b + (a - c)
}

theorem point2_sub_sub_rearrange[T: AddCommGroup](x: T, y: T, z: T) {
    x - (y - z) = z - (y - x)
}

theorem point2_sub_sub_eq_sub_add[T: AddCommGroup](x: T, y: T, z: T) {
    x - y - z = x - (y + z)
}

theorem point2_add_sub_right_cancel[T: AddCommGroup](x: T, d: T) {
    x + d - d = x
}

theorem point2_sub_eq_sub_imp_sub_eq[T: AddCommGroup](sum: T, removed: T, x: T) {
    x = sum - removed implies sum - x = removed
}

theorem point2_four_sum_sub_four_from_sum[T: AddCommGroup](a: T, d: T, p: T) {
    a + d = p implies p + p + (p + p) - (d + d + (d + d)) = a + a + (a + a)
}

theorem point2_lagrange_cancel_middle[T: AddCommGroup](x: T, y: T, z: T, w: T, m: T, n: T) {
    (x - m - n + y) + (z + m + n + w) = x + y + z + w
}

theorem point2_lagrange_scalar_identity[T: CommRing](a: T, b: T, c: T, d: T) {
    (a * d - b * c) * (a * d - b * c) + (a * c + b * d) * (a * c + b * d) =
        (a * a + b * b) * (c * c + d * d)
}

theorem point2_ring_square_sub[T: CommRing](x: T, y: T) {
    (x - y) * (x - y) = x * x - x * y - y * x + y * y
}

theorem point2_ring_difference_of_squares[T: CommRing](x: T, y: T) {
    (x + y) * (x - y) = x * x - y * y
}

theorem point2_lagrange_identity[T: CommRing](u: Point2[T], v: Point2[T]) {
    u.cross(v) * u.cross(v) + u.dot(v) * u.dot(v) = u.norm_sq * v.norm_sq
}

define heron_linear_product[T: CommRing](x: T, y: T, z: T) -> T {
    (x + y + z) * (-x + y + z) * (x - y + z) * (x + y - z)
}

theorem heron_first_pair_difference[T: CommRing](x: T, y: T, z: T) {
    (x + y + z) * (-x + y + z) = (y + z) * (y + z) - x * x
}

theorem heron_second_pair_difference[T: CommRing](x: T, y: T, z: T) {
    (x - y + z) * (x + y - z) = x * x - (y - z) * (y - z)
}

theorem heron_sum_and_diff_square_expansions[T: CommRing](y: T, z: T) {
    (y + z) * (y + z) = y * y + z * z + (y * z + y * z) and
    (y - z) * (y - z) = y * y + z * z - (y * z + y * z)
}

theorem heron_linear_product_difference_of_squares[T: CommRing](x: T, y: T, z: T) {
    heron_linear_product(x, y, z) =
        (y * z + y * z) * (y * z + y * z) -
        (y * y + z * z - x * x) * (y * y + z * z - x * x)
}

theorem point2_double_square_difference_from_sum[T: CommRing](area: T, dot: T, prod: T) {
    area * area + dot * dot = prod * prod implies
        (prod + prod) * (prod + prod) - (dot + dot) * (dot + dot) =
        (area + area) * (area + area)
}

theorem heron_from_lagrange_scalar[T: CommRing](area: T, dot: T, x: T, y: T, z: T) {
    y * y + z * z - x * x = dot + dot and
    area * area + dot * dot = (y * z) * (y * z)
    implies heron_linear_product(x, y, z) = (area + area) * (area + area)
}

theorem point2_heron_vectors[T: CommRing](u: Point2[T], v: Point2[T], x: T, y: T, z: T) {
    x * x = v.sub(u).norm_sq and y * y = v.norm_sq and z * z = u.norm_sq implies
        heron_linear_product(x, y, z) = (u.cross(v) + u.cross(v)) * (u.cross(v) + u.cross(v))
}

theorem point2_heron_triangle_squared[T: OrderedField](a: Point2[T], b: Point2[T], c: Point2[T], x: T, y: T, z: T) {
    x * x = c.sub(b).norm_sq and y * y = c.sub(a).norm_sq and z * z = b.sub(a).norm_sq implies
        heron_linear_product(x, y, z) =
        (a.triangle_area2(b, c) + a.triangle_area2(b, c)) *
        (a.triangle_area2(b, c) + a.triangle_area2(b, c))
}

theorem point2_law_of_cosines_dist_sq[T: CommRing](a: Point2[T], b: Point2[T], c: Point2[T]) {
    b.dist_sq(c) =
        a.dist_sq(b) + a.dist_sq(c) -
        b.sub(a).dot(c.sub(a)) - b.sub(a).dot(c.sub(a))
}

theorem point2_double_dot_from_dist_sq[T: CommRing](a: Point2[T], b: Point2[T], c: Point2[T]) {
    b.sub(a).dot(c.sub(a)) + b.sub(a).dot(c.sub(a)) =
        a.dist_sq(b) + a.dist_sq(c) - b.dist_sq(c)
}

define point2_translate_points[T: OrderedField](points: List[Point2[T]], v: Point2[T]) -> List[Point2[T]] {
    match points {
        List.nil {
            List.nil[Point2[T]]
        }
        List.cons(head, tail) {
            List.cons(head.translate(v), point2_translate_points(tail, v))
        }
    }
}

define point2_polygon_chain_area2[T: OrderedField](anchor: Point2[T], previous: Point2[T], rest: List[Point2[T]]) -> T {
    match rest {
        List.nil {
            T.0
        }
        List.cons(next, tail) {
            anchor.triangle_area2(previous, next) + point2_polygon_chain_area2(anchor, next, tail)
        }
    }
}

define point2_polygon_area2[T: OrderedField](points: List[Point2[T]]) -> T {
    match points {
        List.nil {
            T.0
        }
        List.cons(first, tail) {
            point2_polygon_chain_area2(first, first, tail)
        }
    }
}

define point2_polygon_ccw[T: OrderedField](points: List[Point2[T]]) -> Bool {
    point2_polygon_area2(points) > T.0
}

define point2_polygon_cw[T: OrderedField](points: List[Point2[T]]) -> Bool {
    point2_polygon_area2(points) < T.0
}

define point2_polygon_area2_zero[T: OrderedField](points: List[Point2[T]]) -> Bool {
    point2_polygon_area2(points) = T.0
}

theorem point2_translate_points_nil[T: OrderedField](v: Point2[T]) {
    point2_translate_points(List.nil[Point2[T]], v) = List.nil[Point2[T]]
}

theorem point2_translate_points_cons[T: OrderedField](head: Point2[T], tail: List[Point2[T]], v: Point2[T]) {
    point2_translate_points(List.cons(head, tail), v) =
    List.cons(head.translate(v), point2_translate_points(tail, v))
}

theorem point2_polygon_chain_area2_nil[T: OrderedField](anchor: Point2[T], previous: Point2[T]) {
    point2_polygon_chain_area2(anchor, previous, List.nil[Point2[T]]) = T.0
}

theorem point2_polygon_chain_area2_single[T: OrderedField](anchor: Point2[T], previous: Point2[T], next: Point2[T]) {
    point2_polygon_chain_area2(anchor, previous, List.cons(next, List.nil[Point2[T]])) =
    anchor.triangle_area2(previous, next)
}

theorem point2_polygon_area2_nil[T: OrderedField] {
    point2_polygon_area2(List.nil[Point2[T]]) = T.0
}

theorem point2_polygon_area2_single[T: OrderedField](a: Point2[T]) {
    point2_polygon_area2(List.cons(a, List.nil[Point2[T]])) = T.0
}

theorem point2_polygon_area2_pair[T: OrderedField](a: Point2[T], b: Point2[T]) {
    point2_polygon_area2(List.cons(a, List.cons(b, List.nil[Point2[T]]))) = T.0
}

theorem point2_polygon_area2_triple[T: OrderedField](a: Point2[T], b: Point2[T], c: Point2[T]) {
    point2_polygon_area2(List.cons(a, List.cons(b, List.cons(c, List.nil[Point2[T]])))) =
    a.triangle_area2(b, c)
}

theorem point2_polygon_area2_quad[T: OrderedField](a: Point2[T], b: Point2[T], c: Point2[T], d: Point2[T]) {
    point2_polygon_area2(List.cons(a, List.cons(b, List.cons(c, List.cons(d, List.nil[Point2[T]]))))) =
    a.triangle_area2(b, c) + a.triangle_area2(c, d)
}

theorem point2_polygon_chain_area2_translate[T: OrderedField](
    anchor: Point2[T],
    previous: Point2[T],
    rest: List[Point2[T]],
    v: Point2[T]
) {
    point2_polygon_chain_area2(anchor.translate(v), previous.translate(v), point2_translate_points(rest, v)) =
    point2_polygon_chain_area2(anchor, previous, rest)
}

theorem point2_polygon_area2_translate[T: OrderedField](points: List[Point2[T]], v: Point2[T]) {
    point2_polygon_area2(point2_translate_points(points, v)) = point2_polygon_area2(points)
}

theorem point2_polygon_ccw_translate[T: OrderedField](points: List[Point2[T]], v: Point2[T]) {
    point2_polygon_ccw(point2_translate_points(points, v)) = point2_polygon_ccw(points)
}

theorem point2_polygon_cw_translate[T: OrderedField](points: List[Point2[T]], v: Point2[T]) {
    point2_polygon_cw(point2_translate_points(points, v)) = point2_polygon_cw(points)
}

theorem point2_polygon_area2_zero_translate[T: OrderedField](points: List[Point2[T]], v: Point2[T]) {
    point2_polygon_area2_zero(point2_translate_points(points, v)) = point2_polygon_area2_zero(points)
}

define point2_polyline_chain_contains[T: OrderedField](previous: Point2[T], rest: List[Point2[T]], p: Point2[T]) -> Bool {
    match rest {
        List.nil {
            false
        }
        List.cons(next, tail) {
            if previous.on_segment(next, p) {
                true
            } else {
                point2_polyline_chain_contains(next, tail, p)
            }
        }
    }
}

define point2_polyline_contains[T: OrderedField](points: List[Point2[T]], p: Point2[T]) -> Bool {
    match points {
        List.nil {
            false
        }
        List.cons(first, tail) {
            match tail {
                List.nil {
                    false
                }
                List.cons(second, rest) {
                    point2_polyline_chain_contains(first, List.cons(second, rest), p)
                }
            }
        }
    }
}

theorem point2_polyline_chain_contains_nil[T: OrderedField](previous: Point2[T], p: Point2[T]) {
    not point2_polyline_chain_contains(previous, List.nil[Point2[T]], p)
}

theorem point2_polyline_chain_contains_single[T: OrderedField](previous: Point2[T], next: Point2[T], p: Point2[T]) {
    point2_polyline_chain_contains(previous, List.cons(next, List.nil[Point2[T]]), p) =
    previous.on_segment(next, p)
}

theorem point2_polyline_chain_contains_start[T: OrderedField](previous: Point2[T], next: Point2[T], tail: List[Point2[T]]) {
    point2_polyline_chain_contains(previous, List.cons(next, tail), previous)
}

theorem point2_polyline_chain_contains_next[T: OrderedField](previous: Point2[T], next: Point2[T], tail: List[Point2[T]]) {
    point2_polyline_chain_contains(previous, List.cons(next, tail), next)
}

theorem point2_polyline_chain_contains_first_edge[T: OrderedField](previous: Point2[T], next: Point2[T], tail: List[Point2[T]], p: Point2[T]) {
    previous.on_segment(next, p) implies point2_polyline_chain_contains(previous, List.cons(next, tail), p)
}

theorem point2_polyline_chain_contains_tail[T: OrderedField](previous: Point2[T], next: Point2[T], tail: List[Point2[T]], p: Point2[T]) {
    not previous.on_segment(next, p) and point2_polyline_chain_contains(next, tail, p) implies
    point2_polyline_chain_contains(previous, List.cons(next, tail), p)
}

theorem point2_polyline_contains_nil[T: OrderedField](p: Point2[T]) {
    not point2_polyline_contains(List.nil[Point2[T]], p)
}

theorem point2_polyline_contains_single_point[T: OrderedField](a: Point2[T], p: Point2[T]) {
    not point2_polyline_contains(List.cons(a, List.nil[Point2[T]]), p)
}

theorem point2_polyline_contains_pair[T: OrderedField](a: Point2[T], b: Point2[T], p: Point2[T]) {
    point2_polyline_contains(List.cons(a, List.cons(b, List.nil[Point2[T]])), p) = a.on_segment(b, p)
}

theorem point2_polyline_contains_pair_start[T: OrderedField](a: Point2[T], b: Point2[T]) {
    point2_polyline_contains(List.cons(a, List.cons(b, List.nil[Point2[T]])), a)
}

theorem point2_polyline_contains_pair_end[T: OrderedField](a: Point2[T], b: Point2[T]) {
    point2_polyline_contains(List.cons(a, List.cons(b, List.nil[Point2[T]])), b)
}

theorem point2_polyline_contains_first[T: OrderedField](a: Point2[T], b: Point2[T], rest: List[Point2[T]]) {
    point2_polyline_contains(List.cons(a, List.cons(b, rest)), a)
}

theorem point2_polyline_contains_second[T: OrderedField](a: Point2[T], b: Point2[T], rest: List[Point2[T]]) {
    point2_polyline_contains(List.cons(a, List.cons(b, rest)), b)
