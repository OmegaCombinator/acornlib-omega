theorem point2_triangle_area2_zero_translate[T: OrderedField](a: Point2[T], b: Point2[T], c: Point2[T], v: Point2[T]) {
    (a.translate(v).triangle_area2(b.translate(v), c.translate(v)) = T.0) =
