theorem point2_triangle_ccw_translate[T: OrderedField](a: Point2[T], b: Point2[T], c: Point2[T], v: Point2[T]) {
    a.translate(v).triangle_ccw(b.translate(v), c.translate(v)) = a.triangle_ccw(b, c)
