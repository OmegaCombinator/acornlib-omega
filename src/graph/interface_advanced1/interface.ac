    f2: U -> V,
    e2: V -> U,
    x: U
) {
    (forall(a: V) { e1(f1(a)) = a }) and (forall(a: U) { e2(f2(a)) = a }) implies
        compose(e2, e1, compose(f1, f2, x)) = x
