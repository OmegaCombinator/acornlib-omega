theorem planar_edge_bound[V](g: SimpleGraph[V], s: FiniteSet[V]) {
    is_planar(g) and Nat.3 <= fs_card(s) implies
        edge_count(g, s) <= Nat.3 * fs_card(s) - Nat.6
