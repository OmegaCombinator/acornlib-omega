}

theorem bipartition_same_side_not_neighbor[V](
    g: SimpleGraph[V], t: FiniteSet[V], part: V -> Bool, v: V, w: V
) {
    is_bipartition(g, t, part) and t.contains(v) and part(v) = part(w)
        implies not neighborhood(g, t, v).contains(w)
}

