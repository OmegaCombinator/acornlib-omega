    Nat.4 < Nat.5 and Nat.5 < Nat.6 and Nat.6 < Nat.7 and Nat.7 < Nat.8 and Nat.8 < Nat.9
}

theorem petersen_lt_imp_ne(a: Nat, b: Nat) {
