let k22_matching: FiniteSet[Pair[Nat, Nat]] = fs_insert(
    fs_insert(FiniteSet.empty[Pair[Nat, Nat]], Pair.new(Nat.0, Nat.2)), Pair.new(Nat.1, Nat.3))

/// The two-edge set of K_{2,2} is a matching.

theorem k22_matching_is_matching {
    is_matching(k22, range_set(Nat.4), k22_matching)
}

theorem k22_matching_card {
    fs_card(k22_matching) = Nat.2
}

theorem k22_matching_size_at_most_two(m: FiniteSet[Pair[Nat, Nat]]) {
    is_matching(k22, range_set(Nat.4), m) implies fs_card(m) <= Nat.2
}

theorem k22_matching_size_pred_two {
    matching_size_pred(k22, range_set(Nat.4))(Nat.2)
}

theorem k22_matching_size_pred_bounded(n: Nat) {
    matching_size_pred(k22, range_set(Nat.4))(n) implies n <= Nat.2
}

theorem k22_maximum_matching_size {
    maximum_matching_size(k22, range_set(Nat.4)) = Nat.2
}

let k22_cover: FiniteSet[Nat] = fs_insert(fs_insert(FiniteSet.empty[Nat], Nat.0), Nat.1)

/// An edge of K_{2,2} meets the cover {0, 1}.

theorem k22_adj_covered(x: Nat, y: Nat) {
    k22.adj(x, y) implies k22_cover.contains(x) or k22_cover.contains(y)
}

theorem k22_cover_is_vertex_cover {
    is_vertex_cover(k22, range_set(Nat.4), k22_cover)
}

theorem k22_cover_subset {
    k22_cover.subset_eq(range_set(Nat.4))
}

theorem k22_cover_card {
    fs_card(k22_cover) = Nat.2
}

theorem k22_cover_size_pred_two {
    cover_size_pred(k22, range_set(Nat.4))(Nat.2)
}

theorem k22_cover_size_pred_bounded(n: Nat) {
    cover_size_pred(k22, range_set(Nat.4))(n) implies Nat.2 <= n
}

theorem k22_vertex_cover_number {
    vertex_cover_number(k22, range_set(Nat.4)) = Nat.2
}

theorem konig_on_k22 {
    is_bipartite(k22, range_set(Nat.4)) and
        maximum_matching_size(k22, range_set(Nat.4)) = vertex_cover_number(k22, range_set(Nat.4))
}

define is_maximal_clique_in[V](
    g: SimpleGraph[V], s: FiniteSet[V], c: FiniteSet[V]
) -> Bool {
    c.subset_eq(s) and is_clique_in(g, c) and forall(d: FiniteSet[V]) {
        c.subset_eq(d) and d.subset_eq(s) and is_clique_in(g, d) implies d = c
    }
}

theorem is_maximal_clique_in_clique[V](
    g: SimpleGraph[V], s: FiniteSet[V], c: FiniteSet[V]
) {
    is_maximal_clique_in(g, s, c) implies c.subset_eq(s) and is_clique_in(g, c)
}

theorem is_maximal_clique_in_apply[V](
    g: SimpleGraph[V], s: FiniteSet[V], c: FiniteSet[V], d: FiniteSet[V]
) {
    is_maximal_clique_in(g, s, c) and c.subset_eq(d) and d.subset_eq(s)
        and is_clique_in(g, d)
        implies d = c
}

theorem diamond_free_cross_adj[V](
    g: SimpleGraph[V], s: FiniteSet[V], c: FiniteSet[V], e: FiniteSet[V],
    x: V, y: V, u: V, v: V
) {
    is_diamond_free(g, s) and g.adj(x, y)
        and c.subset_eq(s) and is_clique_in(g, c) and c.contains(x) and c.contains(y)
        and e.subset_eq(s) and is_clique_in(g, e) and e.contains(x) and e.contains(y)
        and c.contains(u) and e.contains(v)
        and u != x and u != y and v != x and v != y and u != v
        implies g.adj(u, v)
}

theorem diamond_free_clique_union[V](
    g: SimpleGraph[V], s: FiniteSet[V], c: FiniteSet[V], e: FiniteSet[V], x: V, y: V
) {
    is_diamond_free(g, s) and g.adj(x, y)
        and c.subset_eq(s) and is_clique_in(g, c) and c.contains(x) and c.contains(y)
        and e.subset_eq(s) and is_clique_in(g, e) and e.contains(x) and e.contains(y)
        implies is_clique_in(g, fs_union(c, e))
}

theorem diamond_free_maximal_clique_unique[V](
    g: SimpleGraph[V], s: FiniteSet[V], c: FiniteSet[V], e: FiniteSet[V], x: V, y: V
) {
    is_diamond_free(g, s) and g.adj(x, y)
        and is_maximal_clique_in(g, s, c) and c.contains(x) and c.contains(y)
        and is_maximal_clique_in(g, s, e) and e.contains(x) and e.contains(y)
        implies c = e
}

define is_minimal_dominating_set[V](
    g: SimpleGraph[V], s: FiniteSet[V], d: FiniteSet[V]
) -> Bool {
    is_dominating_set(g, s, d) and forall(v: V) {
        d.contains(v) implies not is_dominating_set(g, s, fs_remove(d, v))
    }
}

theorem is_minimal_dominating_set_dominating[V](
    g: SimpleGraph[V], s: FiniteSet[V], d: FiniteSet[V]
) {
    is_minimal_dominating_set(g, s, d) implies is_dominating_set(g, s, d)
}

theorem is_minimal_dominating_set_apply[V](
    g: SimpleGraph[V], s: FiniteSet[V], d: FiniteSet[V], v: V
) {
    is_minimal_dominating_set(g, s, d) and d.contains(v)
        implies not is_dominating_set(g, s, fs_remove(d, v))
}

theorem is_minimal_dominating_set_intro[V](
    g: SimpleGraph[V], s: FiniteSet[V], d: FiniteSet[V]
) {
    is_dominating_set(g, s, d) and (forall(v: V) {
        d.contains(v) implies not is_dominating_set(g, s, fs_remove(d, v))
    }) implies is_minimal_dominating_set(g, s, d)
}

theorem minimal_dominating_witness[V](
    g: SimpleGraph[V], s: FiniteSet[V], d: FiniteSet[V], v: V
) {
    is_minimal_dominating_set(g, s, d) and d.contains(v)
        implies exists(u: V) { s.contains(u) and not is_dominated(g, fs_remove(d, v), u) }
}

theorem positive_degree_witness[V](g: SimpleGraph[V], s: FiniteSet[V], v: V) {
    Nat.0 < degree(g, s, v) implies exists(w: V) { s.contains(w) and g.adj(v, w) }
}

theorem minimal_dominating_neighbor_outside[V](
    g: SimpleGraph[V], s: FiniteSet[V], d: FiniteSet[V], v: V
) {
    has_no_isolated_vertices(g, s) and is_minimal_dominating_set(g, s, d) and s.contains(v)
        and d.contains(v)
        implies has_neighbor_in(g, fs_difference(s, d), v)
}

theorem minimal_dominating_complement_dominates[V](
    g: SimpleGraph[V], s: FiniteSet[V], d: FiniteSet[V]
) {
    has_no_isolated_vertices(g, s) and is_minimal_dominating_set(g, s, d)
        implies is_dominating_set(g, s, fs_difference(s, d))
}

theorem fs_difference_subset[T](s: FiniteSet[T], d: FiniteSet[T]) {
    fs_difference(s, d).subset_eq(s)
}

theorem minimum_dominating_is_minimal[V](
    g: SimpleGraph[V], s: FiniteSet[V], d: FiniteSet[V]
) {
    d.subset_eq(s) and is_dominating_set(g, s, d) and fs_card(d) = domination_number(g, s)
        implies is_minimal_dominating_set(g, s, d)
}

theorem domination_number_double_le_card[V](g: SimpleGraph[V], s: FiniteSet[V]) {
    has_no_isolated_vertices(g, s)
        implies Nat.2 * domination_number(g, s) <= fs_card(s)
}

theorem neighbor_exists_of_positive_degree[V](
    g: SimpleGraph[V], s: FiniteSet[V], v: V
) {
    Nat.0 < degree(g, s, v) implies exists(w: V) { s.contains(w) and g.adj(v, w) }
}

theorem neighbor_exists_of_no_isolated[V](
    g: SimpleGraph[V], s: FiniteSet[V], v: V
) {
    has_no_isolated_vertices(g, s) and s.contains(v) implies exists(w: V) { s.contains(w) and g.adj(v, w) }
}

theorem degree_zero_of_no_neighbor[V](
    g: SimpleGraph[V], s: FiniteSet[V], v: V
) {
    (forall(w: V) { not (s.contains(w) and g.adj(v, w)) }) implies degree(g, s, v) = Nat.0
}

theorem neighborhood_contains_of_ambient_subset[V](
    g: SimpleGraph[V], s: FiniteSet[V], t: FiniteSet[V], v: V, w: V
) {
    t.subset_eq(s) and neighborhood(g, t, v).contains(w) implies neighborhood(g, s, v).contains(w)
}

theorem independent_neighborhood_empty[V](
    g: SimpleGraph[V], t: FiniteSet[V], v: V, w: V
) {
    is_independent_in(g, t) and t.contains(v) implies not neighborhood(g, t, v).contains(w)
}

theorem clique_neighborhood_contains[V](
    g: SimpleGraph[V], t: FiniteSet[V], v: V, w: V
) {
    is_clique_in(g, t) and t.contains(v) and t.contains(w) and v != w
        implies neighborhood(g, t, v).contains(w)
}

theorem bipartition_neighborhood_opposite[V](
    g: SimpleGraph[V], t: FiniteSet[V], part: V -> Bool, v: V, w: V
) {
    is_bipartition(g, t, part) and t.contains(v) and neighborhood(g, t, v).contains(w)
        implies part(v) != part(w)
}

theorem vertex_cover_neighborhood_contains[V](
    g: SimpleGraph[V], s: FiniteSet[V], c: FiniteSet[V], v: V, w: V
) {
    is_vertex_cover(g, s, c) and s.contains(v) and not c.contains(v)
        and neighborhood(g, s, v).contains(w) implies c.contains(w)
}

theorem neighborhood_symmetric[V](g: SimpleGraph[V], s: FiniteSet[V], v: V, w: V) {
    s.contains(v) and neighborhood(g, s, v).contains(w) implies neighborhood(g, s, w).contains(v)
}

theorem neighborhood_excludes_center[V](g: SimpleGraph[V], s: FiniteSet[V], v: V) {
    not neighborhood(g, s, v).contains(v)
}

theorem bipartition_same_side_not_neighbor[V](
    g: SimpleGraph[V], t: FiniteSet[V], part: V -> Bool, v: V, w: V
) {
    is_bipartition(g, t, part) and t.contains(v) and part(v) = part(w)
        implies not neighborhood(g, t, v).contains(w)
}

theorem path_prefix_can_force(n: Nat, k: Nat) {
    k.suc < n implies can_force(path_graph, range_set(n), range_set(k.suc), k, k.suc)
}

theorem path_derived_set_step(n: Nat, k: Nat) {
    k.suc < n implies
        (derived_set(path_graph, range_set(n), range_set(k.suc)) = range_set(k.suc.suc))
}

theorem path_forcing_iterate_prefix(n: Nat, k: Nat) {
    k.suc <= n implies
        (forcing_iterate(path_graph, range_set(n), range_set(Nat.1), k) = range_set(k.suc))
}

theorem path_singleton_is_zero_forcing(n: Nat) {
    Nat.1 <= n implies is_zero_forcing_set(path_graph, range_set(n.suc), range_set(Nat.1))
}

theorem path_zero_forcing_number_le_one(n: Nat) {
    Nat.1 <= n implies zero_forcing_number(path_graph, range_set(n.suc)) <= Nat.1
}

theorem path_zero_forcing_number(n: Nat) {
    Nat.1 <= n implies zero_forcing_number(path_graph, range_set(n.suc)) = Nat.1
}

theorem fs_subset_eq_of_same_card[T](s: FiniteSet[T], t: FiniteSet[T]) {
    s.subset_eq(t) and fs_card(s) = fs_card(t) implies s = t
}

theorem fs_card_lt_of_proper_subset[T](s: FiniteSet[T], t: FiniteSet[T]) {
    s.subset_eq(t) and s != t implies fs_card(s) < fs_card(t)
}

theorem derived_set_card_grows[V](g: SimpleGraph[V], s: FiniteSet[V], b: FiniteSet[V]) {
    b.subset_eq(s) and derived_set(g, s, b) != b implies fs_card(b) < fs_card(derived_set(g, s, b))
}

define strictly_growing_upto[V](
    g: SimpleGraph[V], s: FiniteSet[V], b: FiniteSet[V], n: Nat
) -> Bool {
    forall(k: Nat) {
        k < n implies forcing_iterate(g, s, b, k.suc) != forcing_iterate(g, s, b, k)
    }
}

theorem strictly_growing_upto_apply[V](
    g: SimpleGraph[V], s: FiniteSet[V], b: FiniteSet[V], n: Nat, k: Nat
) {
    strictly_growing_upto(g, s, b, n) and k < n
        implies forcing_iterate(g, s, b, k.suc) != forcing_iterate(g, s, b, k)
}

theorem strictly_growing_upto_weaken[V](
    g: SimpleGraph[V], s: FiniteSet[V], b: FiniteSet[V], n: Nat, m: Nat
) {
    strictly_growing_upto(g, s, b, n) and m <= n implies strictly_growing_upto(g, s, b, m)
}

theorem forcing_iterate_card_bound[V](
    g: SimpleGraph[V], s: FiniteSet[V], b: FiniteSet[V], n: Nat
) {
    b.subset_eq(s) and strictly_growing_upto(g, s, b, n)
        implies fs_card(b) + n <= fs_card(forcing_iterate(g, s, b, n))
}

theorem forcing_iterate_becomes_stationary[V](
    g: SimpleGraph[V], s: FiniteSet[V], b: FiniteSet[V]
) {
    b.subset_eq(s) implies not strictly_growing_upto(g, s, b, fs_card(s).suc)
}

theorem forcing_iterate_fixed_point_exists[V](
    g: SimpleGraph[V], s: FiniteSet[V], b: FiniteSet[V]
) {
    b.subset_eq(s) implies exists(k: Nat) {
        k <= fs_card(s) and forcing_iterate(g, s, b, k.suc) = forcing_iterate(g, s, b, k)
    }
}

theorem complete_graph_can_force_last[V](
    s: FiniteSet[V], v: V, u: V
) {
    s.contains(v) and fs_remove(s, v).contains(u)
        implies can_force(complete_graph[V], s, fs_remove(s, v), u, v)
}

theorem complete_graph_derived_set_all[V](s: FiniteSet[V], v: V, u: V) {
    s.contains(v) and fs_remove(s, v).contains(u)
        implies derived_set(complete_graph[V], s, fs_remove(s, v)) = s
}

theorem complete_graph_remove_is_zero_forcing[V](s: FiniteSet[V], v: V, u: V) {
    s.contains(v) and fs_remove(s, v).contains(u)
        implies is_zero_forcing_set(complete_graph[V], s, fs_remove(s, v))
}

theorem complete_graph_zero_forcing_number_lt[V](s: FiniteSet[V], v: V, u: V) {
    s.contains(v) and s.contains(u) and u != v
        implies zero_forcing_number(complete_graph[V], s) < fs_card(s)
}

theorem complete_graph_two_white_blocks_forcing[V](
    s: FiniteSet[V], b: FiniteSet[V], w1: V, w2: V
) {
    s.contains(w1) and not b.contains(w1) and s.contains(w2) and not b.contains(w2)
        and w1 != w2
        implies is_forcing_closed(complete_graph[V], s, b)
}

theorem complete_graph_zero_forcing_set_card[V](s: FiniteSet[V], b: FiniteSet[V]) {
    b.subset_eq(s) and is_zero_forcing_set(complete_graph[V], s, b)
        implies fs_card(fs_difference(s, b)) < Nat.2
}

theorem walk_concat[V](g: SimpleGraph[V], a: V, m: V, b: V, w1: List[V], w2: List[V]) {
    simple_graph_walk(g, a, m, w1) and simple_graph_walk(g, m, b, w2)
        implies simple_graph_walk(g, a, b, w1 + w2)
}

theorem walk_reverse[V](g: SimpleGraph[V], a: V, b: V, steps: List[V]) {
    simple_graph_walk(g, a, b, steps)
        implies simple_graph_walk(g, b, a, rev_walk_targets(steps, a))
}

define graph_distance[V](g: SimpleGraph[V], x: V, y: V, n: Nat) -> Bool {
    exists(steps: List[V]) {
        simple_graph_walk(g, x, y, steps) and steps.length = n and
            forall(shorter: List[V]) {
                simple_graph_walk(g, x, y, shorter) implies n <= shorter.length
            }
    }
}

theorem graph_distance_adj[V](g: SimpleGraph[V], x: V, y: V) {
    g.adj(x, y) implies graph_distance(g, x, y, Nat.1)
}

theorem walk_contains_path[V](g: SimpleGraph[V], a: V, b: V, steps: List[V]) {
    simple_graph_walk(g, a, b, steps) implies exists(steps2: List[V]) {
        simple_graph_path(g, a, b, steps2)
    }
}
