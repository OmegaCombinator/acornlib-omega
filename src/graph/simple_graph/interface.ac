theorem simple_graph_hom_preimage_induced_exists[V, W](f: SimpleGraphHom[V, W], t: Set[W]) {
    exists(h: SimpleGraphHom[V, W]) {
        h.src = simple_graph_hom_preimage(f, t) and h.dst = induced_subgraph(f.dst, t) and h.map = f.map
    }
