theorem simple_graph_hom_induced_image_exists[V, W](f: SimpleGraphHom[V, W], s: Set[V]) {
    exists(h: SimpleGraphHom[V, W]) {
        h.src = induced_subgraph(f.src, s) and h.dst = simple_graph_hom_image(f, s) and h.map = f.map
    }
