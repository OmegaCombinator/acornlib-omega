    k <= Nat.1 implies (k = Nat.0 or k = Nat.1)
}

theorem from_nat_sq_sum_eq_one(m: Nat, n: Nat) {
    from_nat[Real](m) * from_nat[Real](m) + from_nat[Real](n) * from_nat[Real](n) = Real.1
    implies (m = Nat.1 and n = Nat.0) or (m = Nat.0 and n = Nat.1)
