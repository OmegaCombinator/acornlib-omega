theorem simple_graph_iso_new_map[V, W](
    g: SimpleGraph[V],
    h: SimpleGraph[W],
    f: V -> W,
    e: W -> V,
    i: SimpleGraphIso[V, W]
) {
    SimpleGraphIso[V, W].new(g, h, f, e) = Option.some(i) implies i.map = f
