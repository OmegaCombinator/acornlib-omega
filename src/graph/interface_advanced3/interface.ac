    g: SimpleGraph[V],
    color: V -> C,
    relabel: C -> D
) {
    simple_graph_coloring(g, color) and is_injective_fn(relabel)
    implies simple_graph_coloring(g, compose(relabel, color))
}

theorem simple_graph_coloring_of_color_relabel[V, C, D](
    g: SimpleGraph[V],
