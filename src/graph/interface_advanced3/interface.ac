define path_adj(x: Nat, y: Nat) -> Bool {
    x.suc = y or y.suc = x
}

theorem path_adj_is_symmetric {
    is_symmetric(path_adj)
}

theorem path_adj_is_irreflexive {
    is_irreflexive(path_adj)
}

theorem path_adj_constraint {
    is_symmetric(path_adj) and is_irreflexive(path_adj)
}

theorem path_graph_exists {
    exists(g: SimpleGraph[Nat]) { SimpleGraph.new(path_adj) = Option.some(g) }
}

let path_graph: SimpleGraph[Nat] satisfy {
    SimpleGraph.new(path_adj) = Option.some(path_graph)
}

theorem path_graph_adj_iff(x: Nat, y: Nat) {
    path_graph.adj(x, y) = (x.suc = y or y.suc = x)
}

theorem path_graph_adj_suc(x: Nat) {
    path_graph.adj(x, x.suc)
}

theorem path_graph_adj_ne(x: Nat, y: Nat) {
    path_graph.adj(x, y) implies x != y
}

theorem path_graph_neighbor_cases(x: Nat, y: Nat) {
    path_graph.adj(x, y) implies (y = x.suc or y.suc = x)
}

theorem path_graph_neighbors_not_adj(x: Nat, y: Nat, z: Nat) {
    path_graph.adj(x, y) and path_graph.adj(x, z) and y != z
        implies not path_graph.adj(y, z)
}

theorem path_graph_has_no_common_neighbor(s: FiniteSet[Nat], x: Nat, y: Nat) {
    path_graph.adj(x, y) implies has_no_common_neighbor(path_graph, s, x, y)
}

theorem path_graph_is_triangle_free(s: FiniteSet[Nat]) {
    is_triangle_free(path_graph, s)
}

define offset_vertex(p: Pair[Nat, Nat]) -> Nat {
    p.first + p.second - Nat.1
}

theorem three_offsets_lt {
    Nat.0 < Nat.3 and Nat.1 < Nat.3 and Nat.2 < Nat.3
}

theorem path_dominated_is_offset(d: FiniteSet[Nat], v: Nat) {
    is_dominated(path_graph, d, v)
        implies has_preimage_in(finite_set_product(d, range_set(Nat.3)), offset_vertex, v)
}

theorem path_range_covered_by_dominating(n: Nat, d: FiniteSet[Nat]) {
    is_dominating_set(path_graph, range_set(n), d)
        implies is_covered_by_image(range_set(n),
            finite_set_product(d, range_set(Nat.3)), offset_vertex)
}

theorem path_dominating_set_card_bound(n: Nat, d: FiniteSet[Nat]) {
    is_dominating_set(path_graph, range_set(n), d) implies n <= Nat.3 * fs_card(d)
}

theorem path_domination_number_lower_bound(n: Nat) {
    n <= Nat.3 * domination_number(path_graph, range_set(n))
}

define cycle_offset_vertex(n: Nat, p: Pair[Nat, Nat]) -> Nat {
    (p.first + n + p.second - Nat.1).mod(n)
}

theorem cycle_offset_self(n: Nat, w: Nat) {
    w < n implies cycle_offset_vertex(n, Pair.new(w, Nat.1)) = w
}

theorem cycle_offset_suc(n: Nat, w: Nat) {
    n != Nat.0 implies cycle_offset_vertex(n, Pair.new(w, Nat.2)) = w.suc.mod(n)
}

theorem cycle_offset_pred(n: Nat, v: Nat, w: Nat) {
    v < n and v.suc.mod(n) = w implies cycle_offset_vertex(n, Pair.new(w, Nat.0)) = v
}

theorem cycle_dominated_is_offset(n: Nat, d: FiniteSet[Nat], v: Nat) {
    n != Nat.0 and v < n and d.subset_eq(range_set(n))
        and is_dominated(cycle_graph(n), d, v)
        implies has_preimage_in(finite_set_product(d, range_set(Nat.3)),
            cycle_offset_vertex(n), v)
}

theorem cycle_range_covered_by_dominating(n: Nat, d: FiniteSet[Nat]) {
    n != Nat.0 and d.subset_eq(range_set(n))
        and is_dominating_set(cycle_graph(n), range_set(n), d)
        implies is_covered_by_image(range_set(n),
            finite_set_product(d, range_set(Nat.3)), cycle_offset_vertex(n))
}

theorem cycle_dominating_set_card_bound(n: Nat, d: FiniteSet[Nat]) {
    d.subset_eq(range_set(n)) and is_dominating_set(cycle_graph(n), range_set(n), d)
        implies n <= Nat.3 * fs_card(d)
}

theorem cycle_domination_number_lower_bound(n: Nat) {
    n <= Nat.3 * domination_number(cycle_graph(n), range_set(n))
}

