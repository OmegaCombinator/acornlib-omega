define has_independent_neighbor_triple[V](
    g: SimpleGraph[V], s: FiniteSet[V], a: V
) -> Bool {
    exists(x: V, y: V, z: V) {
        neighborhood(g, s, a).contains(x) and neighborhood(g, s, a).contains(y)
            and neighborhood(g, s, a).contains(z)
            and x != y and x != z and y != z
            and not g.adj(x, y) and not g.adj(x, z) and not g.adj(y, z)
    }
}

theorem has_independent_neighbor_triple_intro[V](
    g: SimpleGraph[V], s: FiniteSet[V], a: V, x: V, y: V, z: V
) {
    neighborhood(g, s, a).contains(x) and neighborhood(g, s, a).contains(y)
        and neighborhood(g, s, a).contains(z)
        and x != y and x != z and y != z
        and not g.adj(x, y) and not g.adj(x, z) and not g.adj(y, z)
        implies has_independent_neighbor_triple(g, s, a)
}

theorem has_independent_neighbor_triple_witness[V](
    g: SimpleGraph[V], s: FiniteSet[V], a: V
) {
    has_independent_neighbor_triple(g, s, a) implies exists(x: V, y: V, z: V) {
        neighborhood(g, s, a).contains(x) and neighborhood(g, s, a).contains(y)
            and neighborhood(g, s, a).contains(z)
            and x != y and x != z and y != z
            and not g.adj(x, y) and not g.adj(x, z) and not g.adj(y, z)
    }
}

define is_claw_free[V](g: SimpleGraph[V], s: FiniteSet[V]) -> Bool {
    forall(a: V) {
        (s.contains(a) implies not has_independent_neighbor_triple(g, s, a))
    }
}

theorem is_claw_free_apply[V](g: SimpleGraph[V], s: FiniteSet[V], a: V) {
    is_claw_free(g, s) and s.contains(a)
        implies not has_independent_neighbor_triple(g, s, a)
}

theorem is_claw_free_intro[V](g: SimpleGraph[V], s: FiniteSet[V]) {
    (forall(a: V) {
        (s.contains(a) implies not has_independent_neighbor_triple(g, s, a))
    }) implies is_claw_free(g, s)
}

theorem is_claw_free_no_claw[V](
    g: SimpleGraph[V], s: FiniteSet[V], a: V, x: V, y: V, z: V
) {
    is_claw_free(g, s) and s.contains(a) and s.contains(x) and s.contains(y)
        and s.contains(z) and g.adj(a, x) and g.adj(a, y) and g.adj(a, z)
        and x != y and x != z and y != z
        implies g.adj(x, y) or g.adj(x, z) or g.adj(y, z)
}

theorem is_claw_free_of_subset[V](
    g: SimpleGraph[V], s: FiniteSet[V], r: FiniteSet[V]
) {
    r.subset_eq(s) and is_claw_free(g, s) implies is_claw_free(g, r)
}

theorem complete_graph_is_claw_free[V](s: FiniteSet[V]) {
    is_claw_free(complete_graph[V], s)
}

define has_nonadjacent_common_neighbors[V](
    g: SimpleGraph[V], s: FiniteSet[V], x: V, y: V
) -> Bool {
    exists(z: V, w: V) {
        common_neighborhood(g, s, x, y).contains(z)
            and common_neighborhood(g, s, x, y).contains(w)
            and z != w and not g.adj(z, w)
    }
}

theorem has_nonadjacent_common_neighbors_intro[V](
    g: SimpleGraph[V], s: FiniteSet[V], x: V, y: V, z: V, w: V
) {
    common_neighborhood(g, s, x, y).contains(z)
        and common_neighborhood(g, s, x, y).contains(w)
        and z != w and not g.adj(z, w)
        implies has_nonadjacent_common_neighbors(g, s, x, y)
}

theorem has_nonadjacent_common_neighbors_witness[V](
    g: SimpleGraph[V], s: FiniteSet[V], x: V, y: V
) {
    has_nonadjacent_common_neighbors(g, s, x, y) implies exists(z: V, w: V) {
        common_neighborhood(g, s, x, y).contains(z)
            and common_neighborhood(g, s, x, y).contains(w)
            and z != w and not g.adj(z, w)
    }
}

define is_diamond_free[V](g: SimpleGraph[V], s: FiniteSet[V]) -> Bool {
    forall(x: V, y: V) {
        (s.contains(x) and s.contains(y) and g.adj(x, y)
            implies not has_nonadjacent_common_neighbors(g, s, x, y))
    }
}

theorem is_diamond_free_apply[V](
    g: SimpleGraph[V], s: FiniteSet[V], x: V, y: V
) {
    is_diamond_free(g, s) and s.contains(x) and s.contains(y) and g.adj(x, y)
        implies not has_nonadjacent_common_neighbors(g, s, x, y)
}

theorem is_diamond_free_intro[V](g: SimpleGraph[V], s: FiniteSet[V]) {
    (forall(x: V, y: V) {
        (s.contains(x) and s.contains(y) and g.adj(x, y)
            implies not has_nonadjacent_common_neighbors(g, s, x, y))
    }) implies is_diamond_free(g, s)
}

theorem is_diamond_free_no_diamond[V](
    g: SimpleGraph[V], s: FiniteSet[V], x: V, y: V, z: V, w: V
) {
    is_diamond_free(g, s) and s.contains(x) and s.contains(y) and s.contains(z)
        and s.contains(w) and g.adj(x, y) and g.adj(x, z) and g.adj(y, z)
        and g.adj(x, w) and g.adj(y, w) and z != w
        implies g.adj(z, w)
}

theorem is_diamond_free_of_subset[V](
    g: SimpleGraph[V], s: FiniteSet[V], r: FiniteSet[V]
) {
    r.subset_eq(s) and is_diamond_free(g, s) implies is_diamond_free(g, r)
}

theorem triangle_free_is_diamond_free[V](g: SimpleGraph[V], s: FiniteSet[V]) {
    is_triangle_free(g, s) implies is_diamond_free(g, s)
}

theorem complete_graph_is_diamond_free[V](s: FiniteSet[V]) {
    is_diamond_free(complete_graph[V], s)
}

let four_vertices: FiniteSet[Nat] = range_set(Nat.4)

/// The four labels are in increasing order.
///
/// Comparisons between numerals are not free, so the ladder is stated once and the distinctness
/// of the labels is read off it.
theorem four_labels_ordered {
    Nat.0 < Nat.1 and Nat.1 < Nat.2 and Nat.2 < Nat.3 and Nat.3 < Nat.4
}

theorem four_labels_lt {
    Nat.0 < Nat.4 and Nat.1 < Nat.4 and Nat.2 < Nat.4 and Nat.3 < Nat.4
}

theorem four_labels_distinct {
    Nat.0 != Nat.1 and Nat.0 != Nat.2 and Nat.0 != Nat.3
        and Nat.1 != Nat.2 and Nat.1 != Nat.3 and Nat.2 != Nat.3
}

theorem four_vertices_contains(x: Nat) {
    x < Nat.4 implies four_vertices.contains(x)
}

define diamond_adj(x: Nat, y: Nat) -> Bool {
    x != y and not (x = Nat.0 and y = Nat.3) and not (x = Nat.3 and y = Nat.0)
}

theorem diamond_adj_is_symmetric {
    is_symmetric(diamond_adj)
}

theorem diamond_adj_is_irreflexive {
    is_irreflexive(diamond_adj)
}

theorem diamond_adj_constraint {
    is_symmetric(diamond_adj) and is_irreflexive(diamond_adj)
}

theorem diamond_graph_exists {
    exists(g: SimpleGraph[Nat]) { SimpleGraph.new(diamond_adj) = Option.some(g) }
}

let diamond_graph: SimpleGraph[Nat] satisfy {
    SimpleGraph.new(diamond_adj) = Option.some(diamond_graph)
}

theorem diamond_graph_adj_iff(x: Nat, y: Nat) {
    diamond_graph.adj(x, y)
        = (x != y and not (x = Nat.0 and y = Nat.3) and not (x = Nat.3 and y = Nat.0))
}

theorem diamond_graph_zero_three_not_adj {
    not diamond_graph.adj(Nat.0, Nat.3)
}

theorem diamond_graph_adj_of_ne(x: Nat, y: Nat) {
    x != y and not (x = Nat.0 and y = Nat.3) and not (x = Nat.3 and y = Nat.0)
        implies diamond_graph.adj(x, y)
}

theorem diamond_graph_not_diamond_free {
    not is_diamond_free(diamond_graph, four_vertices)
}

define claw_adj(x: Nat, y: Nat) -> Bool {
    (x = Nat.0 and y != Nat.0) or (y = Nat.0 and x != Nat.0)
}

theorem claw_adj_is_symmetric {
    is_symmetric(claw_adj)
}

theorem claw_adj_is_irreflexive {
    is_irreflexive(claw_adj)
}

theorem claw_adj_constraint {
    is_symmetric(claw_adj) and is_irreflexive(claw_adj)
}

theorem claw_graph_exists {
    exists(g: SimpleGraph[Nat]) { SimpleGraph.new(claw_adj) = Option.some(g) }
}

let claw_graph: SimpleGraph[Nat] satisfy {
    SimpleGraph.new(claw_adj) = Option.some(claw_graph)
}

theorem claw_graph_adj_iff(x: Nat, y: Nat) {
    claw_graph.adj(x, y) = ((x = Nat.0 and y != Nat.0) or (y = Nat.0 and x != Nat.0))
}

theorem claw_graph_center_adj(y: Nat) {
    y != Nat.0 implies claw_graph.adj(Nat.0, y)
}

theorem claw_graph_leaves_not_adj(x: Nat, y: Nat) {
    x != Nat.0 and y != Nat.0 implies not claw_graph.adj(x, y)
}

theorem claw_graph_not_claw_free {
    not is_claw_free(claw_graph, four_vertices)
}

theorem claw_graph_is_triangle_free {
    is_triangle_free(claw_graph, four_vertices)
}

define is_walk_edge[V](start: V, steps: List[V], x: V, y: V) -> Bool {
    match steps {
        List.nil[V] {
            false
        }
        List.cons(next, rest) {
            (start = x and next = y) or is_walk_edge(next, rest, x, y)
        }
    }
}

theorem is_walk_edge_nil[V](start: V, x: V, y: V) {
    is_walk_edge(start, List.nil[V], x, y) = false
}

theorem is_walk_edge_dir1[V](start: V, next: V, rest: List[V], x: V, y: V) {
    is_walk_edge(start, List.cons(next, rest), x, y) implies
        ((start = x and next = y) or is_walk_edge(next, rest, x, y))
}

theorem is_walk_edge_dir2[V](start: V, next: V, rest: List[V], x: V, y: V) {
    ((start = x and next = y) or is_walk_edge(next, rest, x, y)) implies
        is_walk_edge(start, List.cons(next, rest), x, y)
}

theorem is_walk_edge_cons[V](start: V, next: V, rest: List[V], x: V, y: V) {
    is_walk_edge(start, List.cons(next, rest), x, y) =
        ((start = x and next = y) or is_walk_edge(next, rest, x, y))
}

theorem is_walk_edge_false_of_second_absent[V](prev: V, xs: List[V], x: V, y: V) {
    (forall(w: V) { xs.contains(w) implies w != y }) implies not is_walk_edge(prev, xs, x, y)
}

theorem is_walk_edge_false_of_first_absent[V](prev: V, xs: List[V], x: V, y: V) {
    (forall(w: V) { xs.contains(w) implies w != x }) and prev != x implies not is_walk_edge(prev, xs, x, y)
}

define has_chord[V](g: SimpleGraph[V], start: V, steps: List[V]) -> Bool {
    exists(x: V, y: V) {
        simple_graph_walk_vertices(start, steps).contains(x) and
        simple_graph_walk_vertices(start, steps).contains(y) and
        x != y and
        g.adj(x, y) and
        not is_walk_edge(start, steps, x, y) and
        not is_walk_edge(start, steps, y, x)
    }
}

theorem has_chord_intro[V](g: SimpleGraph[V], start: V, steps: List[V], x: V, y: V) {
    simple_graph_walk_vertices(start, steps).contains(x) and
    simple_graph_walk_vertices(start, steps).contains(y) and
    x != y and g.adj(x, y) and
    not is_walk_edge(start, steps, x, y) and
    not is_walk_edge(start, steps, y, x) implies has_chord(g, start, steps)
}

define is_chordal[V](g: SimpleGraph[V], s: FiniteSet[V]) -> Bool {
    forall(start: V, steps: List[V]) {
        simple_graph_cycle(g, start, steps) and
        Nat.4 <= steps.length and
        (forall(x: V) { simple_graph_walk_vertices(start, steps).contains(x) implies s.contains(x) }) implies has_chord(g, start, steps)
    }
}

theorem is_chordal_apply[V](g: SimpleGraph[V], s: FiniteSet[V], start: V, steps: List[V]) {
