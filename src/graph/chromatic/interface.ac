define is_bipartition[V](g: SimpleGraph[V], s: FiniteSet[V], part: V -> Bool) -> Bool {
    forall(x: V, y: V) {
        s.contains(x) and s.contains(y) and g.adj(x, y) implies part(x) != part(y)
    }
}

theorem is_bipartition_apply[V](
    g: SimpleGraph[V], s: FiniteSet[V], part: V -> Bool, x: V, y: V
) {
    is_bipartition(g, s, part) and s.contains(x) and s.contains(y) and g.adj(x, y)
        implies part(x) != part(y)
}

theorem is_bipartition_intro[V](g: SimpleGraph[V], s: FiniteSet[V], part: V -> Bool) {
    (forall(x: V, y: V) {
        s.contains(x) and s.contains(y) and g.adj(x, y) implies part(x) != part(y)
    }) implies is_bipartition(g, s, part)
}

theorem is_bipartition_same_side_not_adj[V](
    g: SimpleGraph[V], s: FiniteSet[V], part: V -> Bool, x: V, y: V
) {
    is_bipartition(g, s, part) and s.contains(x) and s.contains(y) and part(x) = part(y)
        implies not g.adj(x, y)
}

theorem is_bipartition_of_subset[V](
    g: SimpleGraph[V], s: FiniteSet[V], t: FiniteSet[V], part: V -> Bool
) {
    t.subset_eq(s) and is_bipartition(g, s, part) implies is_bipartition(g, t, part)
}

define is_bipartite[V](g: SimpleGraph[V], s: FiniteSet[V]) -> Bool {
    exists(part: V -> Bool) {
        is_bipartition(g, s, part)
    }
}

theorem is_bipartite_intro[V](g: SimpleGraph[V], s: FiniteSet[V], part: V -> Bool) {
    is_bipartition(g, s, part) implies is_bipartite(g, s)
}

theorem is_bipartite_witness[V](g: SimpleGraph[V], s: FiniteSet[V]) {
    is_bipartite(g, s) implies exists(part: V -> Bool) { is_bipartition(g, s, part) }
}

theorem is_bipartite_of_subset[V](g: SimpleGraph[V], s: FiniteSet[V], t: FiniteSet[V]) {
    t.subset_eq(s) and is_bipartite(g, s) implies is_bipartite(g, t)
}

define has_no_isolated_vertices[V](g: SimpleGraph[V], s: FiniteSet[V]) -> Bool {
    forall(v: V) {
        s.contains(v) implies Nat.0 < degree(g, s, v)
    }
}

theorem has_no_isolated_vertices_apply[V](g: SimpleGraph[V], s: FiniteSet[V], v: V) {
    has_no_isolated_vertices(g, s) and s.contains(v) implies Nat.0 < degree(g, s, v)
}

theorem has_no_isolated_vertices_intro[V](g: SimpleGraph[V], s: FiniteSet[V]) {
    (forall(v: V) { s.contains(v) implies Nat.0 < degree(g, s, v) })
        implies has_no_isolated_vertices(g, s)
}

theorem degree_positive_of_adj[V](g: SimpleGraph[V], s: FiniteSet[V], v: V, w: V) {
    s.contains(w) and g.adj(v, w) implies Nat.0 < degree(g, s, v)
}

define has_independent_neighbor_triple[V](
    g: SimpleGraph[V], s: FiniteSet[V], a: V
) -> Bool {
    exists(x: V, y: V, z: V) {
        neighborhood(g, s, a).contains(x) and neighborhood(g, s, a).contains(y)
            and neighborhood(g, s, a).contains(z)
            and x != y and x != z and y != z
            and not g.adj(x, y) and not g.adj(x, z) and not g.adj(y, z)
    }
}

theorem has_independent_neighbor_triple_intro[V](
    g: SimpleGraph[V], s: FiniteSet[V], a: V, x: V, y: V, z: V
) {
    neighborhood(g, s, a).contains(x) and neighborhood(g, s, a).contains(y)
        and neighborhood(g, s, a).contains(z)
        and x != y and x != z and y != z
        and not g.adj(x, y) and not g.adj(x, z) and not g.adj(y, z)
        implies has_independent_neighbor_triple(g, s, a)
}

theorem has_independent_neighbor_triple_witness[V](
    g: SimpleGraph[V], s: FiniteSet[V], a: V
) {
    has_independent_neighbor_triple(g, s, a) implies exists(x: V, y: V, z: V) {
        neighborhood(g, s, a).contains(x) and neighborhood(g, s, a).contains(y)
            and neighborhood(g, s, a).contains(z)
            and x != y and x != z and y != z
            and not g.adj(x, y) and not g.adj(x, z) and not g.adj(y, z)
    }
}

define is_claw_free[V](g: SimpleGraph[V], s: FiniteSet[V]) -> Bool {
    forall(a: V) {
        (s.contains(a) implies not has_independent_neighbor_triple(g, s, a))
    }
}

theorem is_claw_free_apply[V](g: SimpleGraph[V], s: FiniteSet[V], a: V) {
    is_claw_free(g, s) and s.contains(a)
        implies not has_independent_neighbor_triple(g, s, a)
}

theorem is_claw_free_intro[V](g: SimpleGraph[V], s: FiniteSet[V]) {
    (forall(a: V) {
        (s.contains(a) implies not has_independent_neighbor_triple(g, s, a))
    }) implies is_claw_free(g, s)
}

theorem is_claw_free_no_claw[V](
    g: SimpleGraph[V], s: FiniteSet[V], a: V, x: V, y: V, z: V
) {
    is_claw_free(g, s) and s.contains(a) and s.contains(x) and s.contains(y)
        and s.contains(z) and g.adj(a, x) and g.adj(a, y) and g.adj(a, z)
        and x != y and x != z and y != z
        implies g.adj(x, y) or g.adj(x, z) or g.adj(y, z)
}

theorem is_claw_free_of_subset[V](
    g: SimpleGraph[V], s: FiniteSet[V], r: FiniteSet[V]
) {
    r.subset_eq(s) and is_claw_free(g, s) implies is_claw_free(g, r)
}

theorem complete_graph_is_claw_free[V](s: FiniteSet[V]) {
    is_claw_free(complete_graph[V], s)
}

define diamond4_adj(x: Fin[Nat.4], y: Fin[Nat.4]) -> Bool {
    x.value != y.value
        and (x.value = Nat.0 or x.value = Nat.1 or y.value = Nat.0 or y.value = Nat.1)
}

theorem diamond4_adj_is_symmetric {
    is_symmetric(diamond4_adj)
}

theorem diamond4_adj_is_irreflexive {
    is_irreflexive(diamond4_adj)
}

theorem diamond4_adj_constraint {
    SimpleGraph.constraint(diamond4_adj)
}

theorem diamond4_graph_exists {
    exists(g: SimpleGraph[Fin[Nat.4]]) { SimpleGraph.new(diamond4_adj) = Option.some(g) }
}

let diamond4_graph: SimpleGraph[Fin[Nat.4]] satisfy {
    SimpleGraph.new(diamond4_adj) = Option.some(diamond4_graph)
}

theorem diamond4_graph_adj_iff(x: Fin[Nat.4], y: Fin[Nat.4]) {
    diamond4_graph.adj(x, y) = (x.value != y.value
        and (x.value = Nat.0 or x.value = Nat.1 or y.value = Nat.0 or y.value = Nat.1))
}

define has_neighbor_in[V](g: SimpleGraph[V], d: FiniteSet[V], v: V) -> Bool {
    exists(w: V) {
        d.contains(w) and g.adj(w, v)
    }
}

theorem has_neighbor_in_intro[V](g: SimpleGraph[V], d: FiniteSet[V], v: V, w: V) {
    d.contains(w) and g.adj(w, v) implies has_neighbor_in(g, d, v)
}

theorem has_neighbor_in_witness[V](g: SimpleGraph[V], d: FiniteSet[V], v: V) {
    has_neighbor_in(g, d, v) implies exists(w: V) { d.contains(w) and g.adj(w, v) }
}

define is_dominated[V](g: SimpleGraph[V], d: FiniteSet[V], v: V) -> Bool {
    d.contains(v) or has_neighbor_in(g, d, v)
}

theorem is_dominated_of_contains[V](g: SimpleGraph[V], d: FiniteSet[V], v: V) {
    d.contains(v) implies is_dominated(g, d, v)
}

theorem is_dominated_of_adj[V](g: SimpleGraph[V], d: FiniteSet[V], v: V, w: V) {
    d.contains(w) and g.adj(w, v) implies is_dominated(g, d, v)
}

define is_dominating_set[V](g: SimpleGraph[V], s: FiniteSet[V], d: FiniteSet[V]) -> Bool {
    forall(v: V) {
        s.contains(v) implies is_dominated(g, d, v)
    }
}

theorem is_dominating_set_apply[V](
    g: SimpleGraph[V], s: FiniteSet[V], d: FiniteSet[V], v: V
) {
    is_dominating_set(g, s, d) and s.contains(v) implies is_dominated(g, d, v)
}

theorem is_dominating_set_intro[V](g: SimpleGraph[V], s: FiniteSet[V], d: FiniteSet[V]) {
    (forall(v: V) { s.contains(v) implies is_dominated(g, d, v) })
        implies is_dominating_set(g, s, d)
}

theorem is_dominating_set_self[V](g: SimpleGraph[V], s: FiniteSet[V]) {
    is_dominating_set(g, s, s)
}

theorem is_dominated_of_subset[V](
    g: SimpleGraph[V], c: FiniteSet[V], d: FiniteSet[V], v: V
) {
    c.subset_eq(d) and is_dominated(g, c, v) implies is_dominated(g, d, v)
}

theorem is_dominating_set_of_subset[V](
    g: SimpleGraph[V], s: FiniteSet[V], c: FiniteSet[V], d: FiniteSet[V]
) {
    c.subset_eq(d) and is_dominating_set(g, s, c) implies is_dominating_set(g, s, d)
}

theorem is_dominating_set_of_smaller_ambient[V](
    g: SimpleGraph[V], s: FiniteSet[V], t: FiniteSet[V], d: FiniteSet[V]
) {
    t.subset_eq(s) and is_dominating_set(g, s, d) implies is_dominating_set(g, t, d)
}

define dominating_size_pred[V](g: SimpleGraph[V], s: FiniteSet[V]) -> (Nat -> Bool) {
    function(n: Nat) {
        exists(d: FiniteSet[V]) {
            d.subset_eq(s) and is_dominating_set(g, s, d) and fs_card(d) = n
        }
    }
}

theorem dominating_size_pred_intro[V](
    g: SimpleGraph[V], s: FiniteSet[V], d: FiniteSet[V]
) {
    d.subset_eq(s) and is_dominating_set(g, s, d) implies dominating_size_pred(g, s)(fs_card(d))
}

theorem dominating_size_pred_ambient[V](g: SimpleGraph[V], s: FiniteSet[V]) {
    dominating_size_pred(g, s)(fs_card(s))
}

let domination_number[V](g: SimpleGraph[V], s: FiniteSet[V]) -> result: Nat satisfy {
    is_min(dominating_size_pred(g, s), result)
}

theorem domination_number_attained[V](g: SimpleGraph[V], s: FiniteSet[V]) {
    dominating_size_pred(g, s)(domination_number(g, s))
}

theorem domination_number_is_least[V](
    g: SimpleGraph[V], s: FiniteSet[V], d: FiniteSet[V]
) {
    d.subset_eq(s) and is_dominating_set(g, s, d) implies domination_number(g, s) <= fs_card(d)
}

theorem domination_number_le_ambient[V](g: SimpleGraph[V], s: FiniteSet[V]) {
    domination_number(g, s) <= fs_card(s)
}

define adjacent_pair[V](g: SimpleGraph[V]) -> (Pair[V, V] -> Bool) {
    function(p: Pair[V, V]) {
        g.adj(p.first, p.second)
    }
}

theorem adjacent_pair_eq[V](g: SimpleGraph[V], p: Pair[V, V]) {
    adjacent_pair(g)(p) = g.adj(p.first, p.second)
}

define directed_edges[V](g: SimpleGraph[V], s: FiniteSet[V]) -> FiniteSet[Pair[V, V]] {
    finite_set_filter(finite_set_product(s, s), adjacent_pair(g))
}

theorem directed_edges_contains_eq[V](
    g: SimpleGraph[V], s: FiniteSet[V], p: Pair[V, V]
) {
    directed_edges(g, s).contains(p) = (s.contains(p.first) and s.contains(p.second) and g.adj(p.first, p.second))
}

theorem directed_edges_contains_pair[V](
    g: SimpleGraph[V], s: FiniteSet[V], x: V, y: V
) {
    s.contains(x) and s.contains(y) and g.adj(x, y) implies directed_edges(g, s).contains(Pair.new(x, y))
}

theorem directed_edges_subset[V](g: SimpleGraph[V], s: FiniteSet[V]) {
    directed_edges(g, s).subset_eq(finite_set_product(s, s))
}

theorem directed_edges_first[V](g: SimpleGraph[V], s: FiniteSet[V], p: Pair[V, V]) {
    directed_edges(g, s).contains(p) implies s.contains(p.first)
}

theorem directed_edges_second[V](g: SimpleGraph[V], s: FiniteSet[V], p: Pair[V, V]) {
    directed_edges(g, s).contains(p) implies s.contains(p.second)
}

theorem directed_edges_adj[V](g: SimpleGraph[V], s: FiniteSet[V], p: Pair[V, V]) {
    directed_edges(g, s).contains(p) implies g.adj(p.first, p.second)
}

theorem directed_edges_ne[V](g: SimpleGraph[V], s: FiniteSet[V], p: Pair[V, V]) {
    directed_edges(g, s).contains(p) implies p.first != p.second
}

theorem directed_edges_reverse[V](
    g: SimpleGraph[V], s: FiniteSet[V], x: V, y: V
) {
    directed_edges(g, s).contains(Pair.new(x, y)) implies directed_edges(g, s).contains(Pair.new(y, x))
}

theorem directed_edges_no_loop[V](g: SimpleGraph[V], s: FiniteSet[V], v: V) {
    not directed_edges(g, s).contains(Pair.new(v, v))
}

define directed_edge_count[V](g: SimpleGraph[V], s: FiniteSet[V]) -> Nat {
    fs_card(directed_edges(g, s))
}

theorem directed_edge_count_eq[V](g: SimpleGraph[V], s: FiniteSet[V]) {
    directed_edge_count(g, s) = fs_card(directed_edges(g, s))
}

define degree_fn[V](g: SimpleGraph[V], s: FiniteSet[V]) -> (V -> Nat) {
    function(v: V) {
        degree(g, s, v)
    }
}

theorem degree_fn_eq[V](g: SimpleGraph[V], s: FiniteSet[V], v: V) {
    degree_fn(g, s)(v) = degree(g, s, v)
}

define degree_sum[V](g: SimpleGraph[V], s: FiniteSet[V]) -> Nat {
    finite_set_sum(s, degree_fn(g, s))
}

theorem degree_sum_eq[V](g: SimpleGraph[V], s: FiniteSet[V]) {
    degree_sum(g, s) = finite_set_sum(s, degree_fn(g, s))
}

define first_is[V](v: V) -> (Pair[V, V] -> Bool) {
    function(p: Pair[V, V]) {
        p.first = v
    }
}

theorem first_is_eq[V](v: V, p: Pair[V, V]) {
    first_is(v)(p) = (p.first = v)
}

define directed_edges_from[V](
    g: SimpleGraph[V], s: FiniteSet[V], v: V
) -> FiniteSet[Pair[V, V]] {
    finite_set_filter(directed_edges(g, s), first_is(v))
}

theorem directed_edges_from_contains_eq[V](
    g: SimpleGraph[V], s: FiniteSet[V], v: V, p: Pair[V, V]
) {
    directed_edges_from(g, s, v).contains(p) = (directed_edges(g, s).contains(p) and p.first = v)
}

theorem directed_edges_from_contains_pair[V](
    g: SimpleGraph[V], s: FiniteSet[V], v: V, w: V
) {
    s.contains(v) and neighborhood(g, s, v).contains(w) implies directed_edges_from(g, s, v).contains(Pair.new(v, w))
}

theorem directed_edges_from_second_is_neighbor[V](
    g: SimpleGraph[V], s: FiniteSet[V], v: V, p: Pair[V, V]
) {
    directed_edges_from(g, s, v).contains(p) implies neighborhood(g, s, v).contains(p.second)
}

theorem directed_edges_from_subset[V](g: SimpleGraph[V], s: FiniteSet[V], v: V) {
    directed_edges_from(g, s, v).subset_eq(directed_edges(g, s))
}

theorem directed_edges_from_card_le[V](g: SimpleGraph[V], s: FiniteSet[V], v: V) {
    fs_card(directed_edges_from(g, s, v)) <= directed_edge_count(g, s)
}

theorem fs_card_disjoint_union[T](a: FiniteSet[T], b: FiniteSet[T]) {
    a.is_disjoint(b) implies fs_card(fs_union(a, b)) = fs_card(a) + fs_card(b)
}

define first_in[V](t: FiniteSet[V]) -> (Pair[V, V] -> Bool) {
    function(p: Pair[V, V]) {
        t.contains(p.first)
    }
}

theorem first_in_eq[V](t: FiniteSet[V], p: Pair[V, V]) {
    first_in(t)(p) = t.contains(p.first)
}

define directed_edges_from_set[V](
    g: SimpleGraph[V], s: FiniteSet[V], t: FiniteSet[V]
) -> FiniteSet[Pair[V, V]] {
    finite_set_filter(directed_edges(g, s), first_in(t))
}

theorem directed_edges_from_set_contains_eq[V](
    g: SimpleGraph[V], s: FiniteSet[V], t: FiniteSet[V], p: Pair[V, V]
) {
    directed_edges_from_set(g, s, t).contains(p) = (directed_edges(g, s).contains(p) and t.contains(p.first))
}

theorem directed_edges_from_set_insert_forward[V](
    g: SimpleGraph[V], s: FiniteSet[V], t: FiniteSet[V], v: V, p: Pair[V, V]
) {
    directed_edges_from_set(g, s, fs_insert(t, v)).contains(p) implies directed_edges_from(g, s, v).contains(p) or directed_edges_from_set(g, s, t).contains(p)
}

theorem directed_edges_from_set_insert_backward[V](
    g: SimpleGraph[V], s: FiniteSet[V], t: FiniteSet[V], v: V, p: Pair[V, V]
) {
    directed_edges_from(g, s, v).contains(p) or directed_edges_from_set(g, s, t).contains(p) implies directed_edges_from_set(g, s, fs_insert(t, v)).contains(p)
}

theorem directed_edges_from_disjoint[V](
    g: SimpleGraph[V], s: FiniteSet[V], t: FiniteSet[V], v: V
) {
    not t.contains(v) implies directed_edges_from(g, s, v).is_disjoint(directed_edges_from_set(g, s, t))
}

define pair_with[V](v: V) -> (V -> Pair[V, V]) {
    function(w: V) {
        Pair.new(v, w)
    }
}

theorem pair_with_eq[V](v: V, w: V) {
    pair_with(v)(w) = Pair.new(v, w)
}

theorem pair_with_injective[V](v: V) {
    is_injective_fn(pair_with(v))
}

theorem directed_edges_from_is_image[V](
    g: SimpleGraph[V], s: FiniteSet[V], v: V
) {
    s.contains(v) implies directed_edges_from(g, s, v) = fs_image(neighborhood(g, s, v), pair_with(v))
}

theorem directed_edges_from_cardinality_is[V](g: SimpleGraph[V], s: FiniteSet[V], v: V) {
    s.contains(v) implies directed_edges_from(g, s, v).cardinality_is(fs_card(neighborhood(g, s, v)))
}

theorem directed_edges_from_card[V](g: SimpleGraph[V], s: FiniteSet[V], v: V) {
    s.contains(v) implies fs_card(directed_edges_from(g, s, v)) = degree(g, s, v)
}

theorem directed_edges_from_set_insert[V](
    g: SimpleGraph[V], s: FiniteSet[V], t: FiniteSet[V], v: V
) {
    directed_edges_from_set(g, s, fs_insert(t, v)) = fs_union(directed_edges_from(g, s, v), directed_edges_from_set(g, s, t))
}

theorem directed_edges_from_set_empty[V](g: SimpleGraph[V], s: FiniteSet[V]) {
    directed_edges_from_set(g, s, FiniteSet.empty[V]) = FiniteSet.empty[Pair[V, V]]
}

theorem directed_edges_from_set_empty_card[V](g: SimpleGraph[V], s: FiniteSet[V]) {
    fs_card(directed_edges_from_set(g, s, FiniteSet.empty[V])) = Nat.0
}

theorem graph_embedding_adj_forward[V, W](
    g: SimpleGraph[V], h: SimpleGraph[W], f: V -> W, x: V, y: V
) {
    is_graph_embedding(g, h, f) and g.adj(x, y) implies h.adj(f(x), f(y))
}

theorem graph_embedding_adj_backward[V, W](
    g: SimpleGraph[V], h: SimpleGraph[W], f: V -> W, x: V, y: V
) {
    is_graph_embedding(g, h, f) and h.adj(f(x), f(y)) implies g.adj(x, y)
}

theorem graph_embedding_adj_eq[V, W](
    g: SimpleGraph[V], h: SimpleGraph[W], f: V -> W, x: V, y: V
) {
    is_graph_embedding(g, h, f) implies h.adj(f(x), f(y)) = g.adj(x, y)
}

theorem is_graph_embedding_intro[V, W](
    g: SimpleGraph[V], h: SimpleGraph[W], f: V -> W
) {
    is_graph_hom(g, h, f) and reflects_graph_adj(g, h, f) and is_injective_fn(f)
        implies is_graph_embedding(g, h, f)
}

theorem is_graph_embedding_of_adj_eq[V, W](
    g: SimpleGraph[V], h: SimpleGraph[W], f: V -> W
) {
    (forall(x: V, y: V) { h.adj(f(x), f(y)) = g.adj(x, y) }) and is_injective_fn(f)
        implies is_graph_embedding(g, h, f)
}

define contains_induced[V, W](h: SimpleGraph[W], g: SimpleGraph[V]) -> Bool {
    exists(f: V -> W) {
        is_graph_embedding(g, h, f)
    }
}

theorem contains_induced_intro[V, W](
    h: SimpleGraph[W], g: SimpleGraph[V], m: V -> W
) {
    is_graph_embedding(g, h, m) implies contains_induced(h, g)
}

theorem contains_induced_witness[V, W](h: SimpleGraph[W], g: SimpleGraph[V]) {
    contains_induced(h, g) implies exists(f: V -> W) { is_graph_embedding(g, h, f) }
}

define is_free_of[V, W](h: SimpleGraph[W], g: SimpleGraph[V]) -> Bool {
    not contains_induced(h, g)
}

theorem is_free_of_apply[V, W](
    h: SimpleGraph[W], g: SimpleGraph[V], f: V -> W
) {
    is_free_of(h, g) implies not is_graph_embedding(g, h, f)
}

theorem is_free_of_intro[V, W](h: SimpleGraph[W], g: SimpleGraph[V]) {
    (forall(f: V -> W) { not is_graph_embedding(g, h, f) }) implies is_free_of(h, g)
}

theorem is_free_of_embedded[U, V, W](
    h: SimpleGraph[W], k: SimpleGraph[V], g: SimpleGraph[U], f: V -> W
) {
    is_free_of(h, g) and is_graph_embedding(k, h, f) implies is_free_of(k, g)
}

theorem is_graph_iso_pair_is_embedding[V, W](
    g: SimpleGraph[V], h: SimpleGraph[W], f: V -> W, e: W -> V
) {
    is_graph_iso_pair(g, h, f, e) implies is_graph_embedding(g, h, f)
}

theorem is_free_of_iso[U, V, W](
    h: SimpleGraph[W], k: SimpleGraph[V], g: SimpleGraph[U], f: V -> W, e: W -> V
) {
    is_free_of(h, g) and is_graph_iso_pair(k, h, f, e) implies is_free_of(k, g)
}

theorem lt_four_cases(k: Nat) {
    k < Nat.4 implies (k = Nat.0 or k = Nat.1 or k = Nat.2 or k = Nat.3)
}

theorem claw4_value_cases(x: Fin[Nat.4]) {
    x.value = Nat.0 or x.value = Nat.1 or x.value = Nat.2 or x.value = Nat.3
}

theorem claw4_eq_of_value_eq(x: Fin[Nat.4], y: Fin[Nat.4]) {
    x.value = y.value implies x = y
}

define claw_map[V](a: V, b: V, c: V, d: V) -> (Fin[Nat.4] -> V) {
    function(x: Fin[Nat.4]) {
        if x.value = Nat.0 {
            a
        } else {
            if x.value = Nat.1 {
                b
            } else {
                if x.value = Nat.2 {
                    c
                } else {
                    d
                }
            }
        }
    }
}

theorem claw_map_zero[V](a: V, b: V, c: V, d: V, x: Fin[Nat.4]) {
    x.value = Nat.0 implies claw_map(a, b, c, d)(x) = a
}

theorem claw_map_one[V](a: V, b: V, c: V, d: V, x: Fin[Nat.4]) {
    x.value = Nat.1 implies claw_map(a, b, c, d)(x) = b
}

theorem claw_map_two[V](a: V, b: V, c: V, d: V, x: Fin[Nat.4]) {
    x.value = Nat.2 implies claw_map(a, b, c, d)(x) = c
}

theorem claw_map_three[V](a: V, b: V, c: V, d: V, x: Fin[Nat.4]) {
    x.value = Nat.3 implies claw_map(a, b, c, d)(x) = d
}

theorem claw_map_leaf[V](a: V, b: V, c: V, d: V, x: Fin[Nat.4]) {
    x.value != Nat.0 implies (claw_map(a, b, c, d)(x) = b
        or claw_map(a, b, c, d)(x) = c or claw_map(a, b, c, d)(x) = d)
}

theorem claw_map_cases[V](a: V, b: V, c: V, d: V, x: Fin[Nat.4]) {
    (x.value = Nat.0 and claw_map(a, b, c, d)(x) = a)
        or (x.value = Nat.1 and claw_map(a, b, c, d)(x) = b)
        or (x.value = Nat.2 and claw_map(a, b, c, d)(x) = c)
        or (x.value = Nat.3 and claw_map(a, b, c, d)(x) = d)
}

define four_distinct[V](a: V, b: V, c: V, d: V) -> Bool {
    a != b and a != c and a != d and b != c and b != d and c != d
}

theorem claw_map_injective[V](a: V, b: V, c: V, d: V) {
    four_distinct(a, b, c, d) implies is_injective_fn(claw_map(a, b, c, d))
}

theorem leaves_not_adj_extra[V](g: SimpleGraph[V], b: V, c: V, d: V) {
    not g.adj(b, c) and not g.adj(b, d) and not g.adj(c, d)
        implies not g.adj(c, b) and not g.adj(d, b) and not g.adj(d, c)
            and not g.adj(b, b) and not g.adj(c, c) and not g.adj(d, d)
}

theorem claw_map_is_embedding[V](g: SimpleGraph[V], a: V, b: V, c: V, d: V) {
    g.adj(a, b) and g.adj(a, c) and g.adj(a, d)
        and b != c and b != d and c != d
        and not g.adj(b, c) and not g.adj(b, d) and not g.adj(c, d)
        implies is_graph_embedding(claw4_graph, g, claw_map(a, b, c, d))
}

theorem contains_induced_claw_of_triple[V](
    g: SimpleGraph[V], s: FiniteSet[V], a: V
) {
    has_independent_neighbor_triple(g, s, a) implies contains_induced(g, claw4_graph)
}

theorem is_claw_free_of_free_of_claw[V](g: SimpleGraph[V], s: FiniteSet[V]) {
    is_free_of(g, claw4_graph) implies is_claw_free(g, s)
}

theorem claw4_witness(k: Nat) {
    k < Nat.4 implies exists(i: Fin[Nat.4]) { i.value = k }
}

theorem claw4_labels {
    Nat.0 < Nat.4 and Nat.1 < Nat.4 and Nat.2 < Nat.4 and Nat.3 < Nat.4
        and Nat.0 != Nat.1 and Nat.0 != Nat.2 and Nat.0 != Nat.3
        and Nat.1 != Nat.2 and Nat.1 != Nat.3 and Nat.2 != Nat.3
}

define claw_witness_set[V](a: V, b: V, c: V, d: V) -> FiniteSet[V] {
    fs_insert(fs_insert(fs_insert(fs_insert(FiniteSet.empty[V], a), b), c), d)
}

theorem claw_witness_set_contains[V](a: V, b: V, c: V, d: V) {
    claw_witness_set(a, b, c, d).contains(a) and claw_witness_set(a, b, c, d).contains(b)
        and claw_witness_set(a, b, c, d).contains(c)
        and claw_witness_set(a, b, c, d).contains(d)
}

theorem triple_of_contains_induced_claw[V](g: SimpleGraph[V]) {
    contains_induced(g, claw4_graph) implies exists(s: FiniteSet[V], a: V) {
        s.contains(a) and has_independent_neighbor_triple(g, s, a)
    }
}

theorem free_of_claw_of_is_claw_free[V](g: SimpleGraph[V]) {
    (forall(s: FiniteSet[V]) { is_claw_free(g, s) }) implies is_free_of(g, claw4_graph)
}

theorem free_of_claw_iff_claw_free[V](g: SimpleGraph[V]) {
    is_free_of(g, claw4_graph) = forall(s: FiniteSet[V]) { is_claw_free(g, s) }
}

define handshake_holds[V](
    g: SimpleGraph[V], s: FiniteSet[V], t: FiniteSet[V]
) -> Bool {
    t.subset_eq(s) implies finite_set_sum(t, degree_fn(g, s)) = fs_card(directed_edges_from_set(g, s, t))
}

theorem handshake_holds_empty[V](g: SimpleGraph[V], s: FiniteSet[V]) {
    handshake_holds(g, s, FiniteSet.empty[V])
}

theorem handshake_holds_insert[V](
    g: SimpleGraph[V], s: FiniteSet[V], t: FiniteSet[V], v: V
) {
    handshake_holds(g, s, t) and not t.contains(v) implies handshake_holds(g, s, fs_insert(t, v))
}

theorem handshake_lemma[V](g: SimpleGraph[V], s: FiniteSet[V]) {
    degree_sum(g, s) = fs_card(directed_edges_from_set(g, s, s))
}

theorem iso_pair_adj_forward[V, W](
    g: SimpleGraph[V], h: SimpleGraph[W], f: V -> W, e: W -> V, x: V, y: V
) {
    is_graph_iso_pair(g, h, f, e) and g.adj(x, y) implies h.adj(f(x), f(y))
}

theorem iso_pair_adj_backward[V, W](
    g: SimpleGraph[V], h: SimpleGraph[W], f: V -> W, e: W -> V, x: V, y: V
) {
    is_graph_iso_pair(g, h, f, e) and h.adj(f(x), f(y)) implies g.adj(x, y)
}

define mapped_vertices[V, W](s: FiniteSet[V], f: V -> W) -> FiniteSet[W] {
    fs_image(s, f)
}

define mapped_neighborhood[V, W](
    h: SimpleGraph[W], s: FiniteSet[V], f: V -> W, v: V
) -> FiniteSet[W] {
    neighborhood(h, mapped_vertices(s, f), f(v))
}

define neighborhood_mapped[V, W](
    g: SimpleGraph[V], s: FiniteSet[V], f: V -> W, v: V
) -> FiniteSet[W] {
    fs_image(neighborhood(g, s, v), f)
}

theorem mapped_neighborhood_contains_eq[V, W](
    h: SimpleGraph[W], s: FiniteSet[V], f: V -> W, v: V, y: W
) {
    mapped_neighborhood(h, s, f, v).contains(y) = (mapped_vertices(s, f).contains(y) and h.adj(f(v), y))
}

theorem neighborhood_mapped_contains_eq[V, W](
    g: SimpleGraph[V], s: FiniteSet[V], f: V -> W, v: V, y: W
) {
    neighborhood_mapped(g, s, f, v).contains(y) = exists(u: V) {
        neighborhood(g, s, v).contains(u) and y = f(u)
    }
}

theorem mapped_vertices_contains_eq[V, W](s: FiniteSet[V], f: V -> W, y: W) {
    mapped_vertices(s, f).contains(y) = exists(u: V) { s.contains(u) and y = f(u) }
}

theorem iso_neighborhood_image_forward[V, W](
    g: SimpleGraph[V], h: SimpleGraph[W], f: V -> W, e: W -> V, s: FiniteSet[V], v: V, y: W
) {
    is_graph_iso_pair(g, h, f, e) and mapped_neighborhood(h, s, f, v).contains(y) implies neighborhood_mapped(g, s, f, v).contains(y)
}

theorem iso_neighborhood_image_backward[V, W](
    g: SimpleGraph[V], h: SimpleGraph[W], f: V -> W, e: W -> V, s: FiniteSet[V], v: V, y: W
) {
    is_graph_iso_pair(g, h, f, e) and neighborhood_mapped(g, s, f, v).contains(y) implies mapped_neighborhood(h, s, f, v).contains(y)
}

theorem iso_neighborhood_image_iff[V, W](
    g: SimpleGraph[V], h: SimpleGraph[W], f: V -> W, e: W -> V, s: FiniteSet[V], v: V, y: W
) {
    is_graph_iso_pair(g, h, f, e) implies mapped_neighborhood(h, s, f, v).contains(y) = neighborhood_mapped(g, s, f, v).contains(y)
}

theorem iso_neighborhood_image[V, W](
    g: SimpleGraph[V], h: SimpleGraph[W], f: V -> W, e: W -> V, s: FiniteSet[V], v: V
) {
    is_graph_iso_pair(g, h, f, e) implies mapped_neighborhood(h, s, f, v) = neighborhood_mapped(g, s, f, v)
}

theorem iso_degree_eq[V, W](
    g: SimpleGraph[V], h: SimpleGraph[W], f: V -> W, e: W -> V, s: FiniteSet[V], v: V
) {
    is_graph_iso_pair(g, h, f, e) implies degree(h, mapped_vertices(s, f), f(v)) = degree(g, s, v)
}

define is_minimal_dominating_set[V](
    g: SimpleGraph[V], s: FiniteSet[V], d: FiniteSet[V]
) -> Bool {
    is_dominating_set(g, s, d) and forall(v: V) {
        d.contains(v) implies not is_dominating_set(g, s, fs_remove(d, v))
    }
}

theorem is_minimal_dominating_set_dominating[V](
    g: SimpleGraph[V], s: FiniteSet[V], d: FiniteSet[V]
) {
    is_minimal_dominating_set(g, s, d) implies is_dominating_set(g, s, d)
}

theorem is_minimal_dominating_set_apply[V](
    g: SimpleGraph[V], s: FiniteSet[V], d: FiniteSet[V], v: V
) {
    is_minimal_dominating_set(g, s, d) and d.contains(v)
        implies not is_dominating_set(g, s, fs_remove(d, v))
}

theorem is_minimal_dominating_set_intro[V](
    g: SimpleGraph[V], s: FiniteSet[V], d: FiniteSet[V]
) {
    is_dominating_set(g, s, d) and (forall(v: V) {
        d.contains(v) implies not is_dominating_set(g, s, fs_remove(d, v))
    }) implies is_minimal_dominating_set(g, s, d)
}

theorem minimal_dominating_witness[V](
    g: SimpleGraph[V], s: FiniteSet[V], d: FiniteSet[V], v: V
) {
    is_minimal_dominating_set(g, s, d) and d.contains(v)
        implies exists(u: V) { s.contains(u) and not is_dominated(g, fs_remove(d, v), u) }
}

theorem positive_degree_witness[V](g: SimpleGraph[V], s: FiniteSet[V], v: V) {
    Nat.0 < degree(g, s, v) implies exists(w: V) { s.contains(w) and g.adj(v, w) }
}

theorem minimal_dominating_neighbor_outside[V](
    g: SimpleGraph[V], s: FiniteSet[V], d: FiniteSet[V], v: V
) {
    has_no_isolated_vertices(g, s) and is_minimal_dominating_set(g, s, d) and s.contains(v)
        and d.contains(v)
        implies has_neighbor_in(g, fs_difference(s, d), v)
}

theorem minimal_dominating_complement_dominates[V](
    g: SimpleGraph[V], s: FiniteSet[V], d: FiniteSet[V]
) {
    has_no_isolated_vertices(g, s) and is_minimal_dominating_set(g, s, d)
        implies is_dominating_set(g, s, fs_difference(s, d))
}

theorem fs_difference_subset[T](s: FiniteSet[T], d: FiniteSet[T]) {
    fs_difference(s, d).subset_eq(s)
}

theorem minimum_dominating_is_minimal[V](
    g: SimpleGraph[V], s: FiniteSet[V], d: FiniteSet[V]
) {
    d.subset_eq(s) and is_dominating_set(g, s, d) and fs_card(d) = domination_number(g, s)
        implies is_minimal_dominating_set(g, s, d)
}

theorem domination_number_double_le_card[V](g: SimpleGraph[V], s: FiniteSet[V]) {
    has_no_isolated_vertices(g, s)
        implies Nat.2 * domination_number(g, s) <= fs_card(s)
}

define is_dominating_subset[V](
    g: SimpleGraph[V], s: FiniteSet[V], d: FiniteSet[V]
) -> Bool {
    d.subset_eq(s) and is_dominating_set(g, s, d)
}

theorem is_dominating_subset_apply[V](
    g: SimpleGraph[V], s: FiniteSet[V], d: FiniteSet[V]
) {
    is_dominating_subset(g, s, d) implies d.subset_eq(s) and is_dominating_set(g, s, d)
}

theorem is_dominating_subset_intro[V](
    g: SimpleGraph[V], s: FiniteSet[V], d: FiniteSet[V]
) {
    d.subset_eq(s) and is_dominating_set(g, s, d) implies is_dominating_subset(g, s, d)
}

theorem dominating_subset_card_lower_bound[V](
    g: SimpleGraph[V], s: FiniteSet[V], d: FiniteSet[V]
) {
    is_dominating_subset(g, s, d) implies domination_number(g, s) <= fs_card(d)
}

define is_minimum_dominating_set[V](
    g: SimpleGraph[V], s: FiniteSet[V], d: FiniteSet[V]
) -> Bool {
    is_dominating_subset(g, s, d) and fs_card(d) = domination_number(g, s)
}

theorem is_minimum_dominating_set_apply[V](
    g: SimpleGraph[V], s: FiniteSet[V], d: FiniteSet[V]
) {
    is_minimum_dominating_set(g, s, d)
        implies is_dominating_subset(g, s, d) and fs_card(d) = domination_number(g, s)
}

theorem is_minimum_dominating_set_intro[V](
    g: SimpleGraph[V], s: FiniteSet[V], d: FiniteSet[V]
) {
    is_dominating_subset(g, s, d) and fs_card(d) = domination_number(g, s)
        implies is_minimum_dominating_set(g, s, d)
}

theorem minimum_dominating_set_exists[V](g: SimpleGraph[V], s: FiniteSet[V]) {
    exists(d: FiniteSet[V]) { is_minimum_dominating_set(g, s, d) }
}

theorem is_minimum_dominating_set_of_lte[V](
    g: SimpleGraph[V], s: FiniteSet[V], d: FiniteSet[V], e: FiniteSet[V]
) {
    is_minimum_dominating_set(g, s, e) and is_dominating_subset(g, s, d)
        and fs_card(d) <= fs_card(e)
        implies is_minimum_dominating_set(g, s, d)
}

theorem minimum_dominating_sets_same_size[V](
    g: SimpleGraph[V], s: FiniteSet[V], d: FiniteSet[V], e: FiniteSet[V]
) {
    is_minimum_dominating_set(g, s, d) and is_minimum_dominating_set(g, s, e)
        implies fs_card(d) = fs_card(e)
}

define has_unique_minimum_dominating_set[V](g: SimpleGraph[V], s: FiniteSet[V]) -> Bool {
    forall(d: FiniteSet[V], e: FiniteSet[V]) {
        (is_minimum_dominating_set(g, s, d) and is_minimum_dominating_set(g, s, e)
            implies d = e)
    }
}

theorem has_unique_minimum_dominating_set_apply[V](
    g: SimpleGraph[V], s: FiniteSet[V], d: FiniteSet[V], e: FiniteSet[V]
) {
    has_unique_minimum_dominating_set(g, s) and is_minimum_dominating_set(g, s, d)
        and is_minimum_dominating_set(g, s, e)
        implies d = e
}

theorem has_unique_minimum_dominating_set_intro[V](g: SimpleGraph[V], s: FiniteSet[V]) {
    (forall(d: FiniteSet[V], e: FiniteSet[V]) {
        (is_minimum_dominating_set(g, s, d) and is_minimum_dominating_set(g, s, e)
            implies d = e)
    }) implies has_unique_minimum_dominating_set(g, s)
}

theorem unique_minimum_dominating_set_eq[V](
    g: SimpleGraph[V], s: FiniteSet[V], d: FiniteSet[V], e: FiniteSet[V]
) {
    has_unique_minimum_dominating_set(g, s) and is_minimum_dominating_set(g, s, e)
        and is_dominating_subset(g, s, d) and fs_card(d) <= fs_card(e)
        implies d = e
}

theorem dominating_set_contains_some[V](
    g: SimpleGraph[V], s: FiniteSet[V], d: FiniteSet[V], v: V
) {
    is_dominating_set(g, s, d) and s.contains(v) implies exists(w: V) { d.contains(w) }
}

theorem dominating_set_card_positive[V](
    g: SimpleGraph[V], s: FiniteSet[V], d: FiniteSet[V], v: V
) {
    is_dominating_set(g, s, d) and s.contains(v) implies Nat.1 <= fs_card(d)
}

theorem domination_number_positive[V](g: SimpleGraph[V], s: FiniteSet[V], v: V) {
    s.contains(v) implies Nat.1 <= domination_number(g, s)
}

theorem empty_graph_is_dominated_eq[V](d: FiniteSet[V], v: V) {
    is_dominated(empty_graph[V], d, v) = d.contains(v)
}

theorem empty_graph_dominating_subset_eq[V](s: FiniteSet[V], d: FiniteSet[V]) {
    is_dominating_subset(empty_graph[V], s, d) implies d = s
}

theorem empty_graph_domination_number[V](s: FiniteSet[V]) {
    domination_number(empty_graph[V], s) = fs_card(s)
}

theorem complete_graph_singleton_dominates[V](s: FiniteSet[V], v: V) {
    is_dominating_set(complete_graph[V], s, FiniteSet.empty[V].insert(v))
}

theorem complete_graph_domination_number[V](s: FiniteSet[V], v: V) {
    s.contains(v) implies domination_number(complete_graph[V], s) = Nat.1
}

define has_all_edges_of[V](h: SimpleGraph[V], g: SimpleGraph[V]) -> Bool {
    forall(x: V, y: V) {
        g.adj(x, y) implies h.adj(x, y)
    }
}

theorem has_all_edges_of_apply[V](
    h: SimpleGraph[V], g: SimpleGraph[V], x: V, y: V
) {
    has_all_edges_of(h, g) and g.adj(x, y) implies h.adj(x, y)
}

theorem has_all_edges_of_intro[V](h: SimpleGraph[V], g: SimpleGraph[V]) {
    (forall(x: V, y: V) { g.adj(x, y) implies h.adj(x, y) }) implies has_all_edges_of(h, g)
}

theorem complete_graph_has_all_edges[V](g: SimpleGraph[V]) {
    has_all_edges_of(complete_graph[V], g)
}

theorem is_dominated_of_has_all_edges[V](
    h: SimpleGraph[V], g: SimpleGraph[V], d: FiniteSet[V], v: V
) {
    has_all_edges_of(h, g) and is_dominated(g, d, v) implies is_dominated(h, d, v)
}

theorem is_dominating_set_of_has_all_edges[V](
    h: SimpleGraph[V], g: SimpleGraph[V], s: FiniteSet[V], d: FiniteSet[V]
) {
    has_all_edges_of(h, g) and is_dominating_set(g, s, d) implies is_dominating_set(h, s, d)
}

theorem domination_number_antitone_in_edges[V](
    h: SimpleGraph[V], g: SimpleGraph[V], s: FiniteSet[V]
) {
    has_all_edges_of(h, g) implies domination_number(h, s) <= domination_number(g, s)
}

theorem complete_graph_domination_number_least[V](g: SimpleGraph[V], s: FiniteSet[V]) {
    domination_number(complete_graph[V], s) <= domination_number(g, s)
}

theorem has_all_edges_of_trans[V](
    k: SimpleGraph[V], h: SimpleGraph[V], g: SimpleGraph[V]
) {
    has_all_edges_of(k, h) and has_all_edges_of(h, g) implies has_all_edges_of(k, g)
}

define has_all_edges_of_on[V](h: SimpleGraph[V], g: SimpleGraph[V], s: FiniteSet[V]) -> Bool {
    forall(x: V, y: V) {
        s.contains(x) and s.contains(y) and g.adj(x, y) implies h.adj(x, y)
    }
}

theorem has_all_edges_of_on_apply[V](
    h: SimpleGraph[V], g: SimpleGraph[V], s: FiniteSet[V], x: V, y: V
) {
    has_all_edges_of_on(h, g, s) and s.contains(x) and s.contains(y) and g.adj(x, y)
        implies h.adj(x, y)
}

theorem has_all_edges_of_on_intro[V](
    h: SimpleGraph[V], g: SimpleGraph[V], s: FiniteSet[V]
) {
    (forall(x: V, y: V) {
        s.contains(x) and s.contains(y) and g.adj(x, y) implies h.adj(x, y)
    }) implies has_all_edges_of_on(h, g, s)
}

theorem is_dominated_of_has_all_edges_on[V](
    h: SimpleGraph[V], g: SimpleGraph[V], s: FiniteSet[V], d: FiniteSet[V], v: V
) {
    has_all_edges_of_on(h, g, s) and d.subset_eq(s) and s.contains(v)
        and is_dominated(g, d, v) implies is_dominated(h, d, v)
}

theorem is_dominating_set_of_has_all_edges_on[V](
    h: SimpleGraph[V], g: SimpleGraph[V], s: FiniteSet[V], d: FiniteSet[V]
) {
    has_all_edges_of_on(h, g, s) and d.subset_eq(s) and is_dominating_set(g, s, d)
        implies is_dominating_set(h, s, d)
}

theorem domination_number_antitone_in_edges_on[V](
    h: SimpleGraph[V], g: SimpleGraph[V], s: FiniteSet[V]
) {
    has_all_edges_of_on(h, g, s) implies domination_number(h, s) <= domination_number(g, s)
}

theorem neighbor_exists_of_positive_degree[V](
    g: SimpleGraph[V], s: FiniteSet[V], v: V
) {
    Nat.0 < degree(g, s, v) implies exists(w: V) { s.contains(w) and g.adj(v, w) }
}

theorem neighbor_exists_of_no_isolated[V](
    g: SimpleGraph[V], s: FiniteSet[V], v: V
) {
    has_no_isolated_vertices(g, s) and s.contains(v) implies exists(w: V) { s.contains(w) and g.adj(v, w) }
}

theorem degree_zero_of_no_neighbor[V](
    g: SimpleGraph[V], s: FiniteSet[V], v: V
) {
    (forall(w: V) { not (s.contains(w) and g.adj(v, w)) }) implies degree(g, s, v) = Nat.0
}

define max_degree_at_most[V](g: SimpleGraph[V], s: FiniteSet[V], n: Nat) -> Bool {
    forall(v: V) {
        s.contains(v) implies degree(g, s, v) <= n
    }
}

theorem max_degree_at_most_apply[V](g: SimpleGraph[V], s: FiniteSet[V], n: Nat, v: V) {
    max_degree_at_most(g, s, n) and s.contains(v) implies degree(g, s, v) <= n
}

theorem max_degree_at_most_intro[V](g: SimpleGraph[V], s: FiniteSet[V], n: Nat) {
    (forall(v: V) { s.contains(v) implies degree(g, s, v) <= n })
        implies max_degree_at_most(g, s, n)
}

define min_degree_at_least[V](g: SimpleGraph[V], s: FiniteSet[V], n: Nat) -> Bool {
    forall(v: V) {
        s.contains(v) implies n <= degree(g, s, v)
    }
}

theorem min_degree_at_least_apply[V](g: SimpleGraph[V], s: FiniteSet[V], n: Nat, v: V) {
    min_degree_at_least(g, s, n) and s.contains(v) implies n <= degree(g, s, v)
}

theorem min_degree_at_least_intro[V](g: SimpleGraph[V], s: FiniteSet[V], n: Nat) {
    (forall(v: V) { s.contains(v) implies n <= degree(g, s, v) })
        implies min_degree_at_least(g, s, n)
}

define is_regular[V](g: SimpleGraph[V], s: FiniteSet[V], k: Nat) -> Bool {
    forall(v: V) {
        s.contains(v) implies degree(g, s, v) = k
    }
}

theorem is_regular_apply[V](g: SimpleGraph[V], s: FiniteSet[V], k: Nat, v: V) {
    is_regular(g, s, k) and s.contains(v) implies degree(g, s, v) = k
}

theorem is_regular_intro[V](g: SimpleGraph[V], s: FiniteSet[V], k: Nat) {
    (forall(v: V) { s.contains(v) implies degree(g, s, v) = k }) implies is_regular(g, s, k)
}

define is_cubic[V](g: SimpleGraph[V], s: FiniteSet[V]) -> Bool {
    is_regular(g, s, Nat.3)
}

theorem cubic_is_regular_three[V](g: SimpleGraph[V], s: FiniteSet[V]) {
    is_cubic(g, s) implies is_regular(g, s, Nat.3)
}

theorem cubic_of_regular_three[V](g: SimpleGraph[V], s: FiniteSet[V]) {
    is_regular(g, s, Nat.3) implies is_cubic(g, s)
}

theorem cubic_degree[V](g: SimpleGraph[V], s: FiniteSet[V], v: V) {
    is_cubic(g, s) and s.contains(v) implies degree(g, s, v) = Nat.3
}

theorem regular_max_degree_at_most[V](g: SimpleGraph[V], s: FiniteSet[V], k: Nat) {
    is_regular(g, s, k) implies max_degree_at_most(g, s, k)
}

theorem regular_min_degree_at_least[V](g: SimpleGraph[V], s: FiniteSet[V], k: Nat) {
    is_regular(g, s, k) implies min_degree_at_least(g, s, k)
}

theorem regular_of_bounds[V](g: SimpleGraph[V], s: FiniteSet[V], k: Nat) {
    max_degree_at_most(g, s, k) and min_degree_at_least(g, s, k) implies is_regular(g, s, k)
}

theorem max_degree_at_most_weaken[V](g: SimpleGraph[V], s: FiniteSet[V], m: Nat, n: Nat) {
    max_degree_at_most(g, s, m) and m <= n implies max_degree_at_most(g, s, n)
}

theorem min_degree_at_least_weaken[V](g: SimpleGraph[V], s: FiniteSet[V], m: Nat, n: Nat) {
    min_degree_at_least(g, s, m) and n <= m implies min_degree_at_least(g, s, n)
}

theorem min_degree_at_least_zero[V](g: SimpleGraph[V], s: FiniteSet[V]) {
    min_degree_at_least(g, s, Nat.0)
}

theorem cubic_max_degree_three[V](g: SimpleGraph[V], s: FiniteSet[V]) {
    is_cubic(g, s) implies max_degree_at_most(g, s, Nat.3)
}

theorem cubic_min_degree_three[V](g: SimpleGraph[V], s: FiniteSet[V]) {
    is_cubic(g, s) implies min_degree_at_least(g, s, Nat.3)
}

theorem degree_le_ambient[V](g: SimpleGraph[V], s: FiniteSet[V], v: V) {
    degree(g, s, v) <= fs_card(s)
}

theorem max_degree_at_most_ambient[V](g: SimpleGraph[V], s: FiniteSet[V]) {
    max_degree_at_most(g, s, fs_card(s))
}

theorem regular_degree_le_ambient[V](g: SimpleGraph[V], s: FiniteSet[V], k: Nat, v: V) {
    is_regular(g, s, k) and s.contains(v) implies k <= fs_card(s)
}

theorem degree_le_of_ambient_bound[V](g: SimpleGraph[V], s: FiniteSet[V], v: V, n: Nat) {
    fs_card(s) <= n implies degree(g, s, v) <= n
}

theorem neighborhood_card_le[V](g: SimpleGraph[V], s: FiniteSet[V], v: V, n: Nat) {
    fs_card(s) <= n implies fs_card(neighborhood(g, s, v)) <= n
}

define is_vertex_cover[V](g: SimpleGraph[V], s: FiniteSet[V], c: FiniteSet[V]) -> Bool {
    forall(x: V, y: V) {
        s.contains(x) and s.contains(y) and g.adj(x, y) implies c.contains(x) or c.contains(y)
    }
}

theorem is_vertex_cover_apply[V](
    g: SimpleGraph[V], s: FiniteSet[V], c: FiniteSet[V], x: V, y: V
) {
    is_vertex_cover(g, s, c) and s.contains(x) and s.contains(y) and g.adj(x, y) implies c.contains(x) or c.contains(y)
}

theorem is_vertex_cover_intro[V](g: SimpleGraph[V], s: FiniteSet[V], c: FiniteSet[V]) {
    (forall(x: V, y: V) {
        s.contains(x) and s.contains(y) and g.adj(x, y) implies c.contains(x) or c.contains(y)
    }) implies is_vertex_cover(g, s, c)
}

theorem is_vertex_cover_self[V](g: SimpleGraph[V], s: FiniteSet[V]) {
    is_vertex_cover(g, s, s)
}

theorem is_vertex_cover_of_subset[V](
    g: SimpleGraph[V], s: FiniteSet[V], c: FiniteSet[V], d: FiniteSet[V]
) {
    c.subset_eq(d) and is_vertex_cover(g, s, c) implies is_vertex_cover(g, s, d)
}

theorem is_vertex_cover_of_smaller_ambient[V](
    g: SimpleGraph[V], s: FiniteSet[V], t: FiniteSet[V], c: FiniteSet[V]
) {
    t.subset_eq(s) and is_vertex_cover(g, s, c) implies is_vertex_cover(g, t, c)
}

define common_neighborhood[V](
    g: SimpleGraph[V], s: FiniteSet[V], u: V, v: V
) -> FiniteSet[V] {
    finite_set_filter(neighborhood(g, s, u), neighbor_pred(g, v))
}

theorem common_neighborhood_contains_eq[V](
    g: SimpleGraph[V], s: FiniteSet[V], u: V, v: V, w: V
) {
    common_neighborhood(g, s, u, v).contains(w) = (s.contains(w) and g.adj(u, w) and g.adj(v, w))
}

theorem common_neighborhood_subset[V](g: SimpleGraph[V], s: FiniteSet[V], u: V, v: V) {
    common_neighborhood(g, s, u, v).subset_eq(neighborhood(g, s, u))
}

theorem common_neighborhood_adj_left[V](
    g: SimpleGraph[V], s: FiniteSet[V], u: V, v: V, w: V
) {
    common_neighborhood(g, s, u, v).contains(w) implies g.adj(u, w)
}

theorem common_neighborhood_adj_right[V](
    g: SimpleGraph[V], s: FiniteSet[V], u: V, v: V, w: V
) {
    common_neighborhood(g, s, u, v).contains(w) implies g.adj(v, w)
}

define picks_neighbor[V](g: SimpleGraph[V], s: FiniteSet[V], pick: V -> V, v: V) -> Bool {
    s.contains(pick(v)) and g.adj(v, pick(v))
}

theorem picks_neighbor_contains[V](
    g: SimpleGraph[V], s: FiniteSet[V], pick: V -> V, v: V
) {
    picks_neighbor(g, s, pick, v) implies s.contains(pick(v))
}

theorem picks_neighbor_adj[V](
    g: SimpleGraph[V], s: FiniteSet[V], pick: V -> V, v: V
) {
    picks_neighbor(g, s, pick, v) implies g.adj(v, pick(v))
}

define has_neighbor_map[V](g: SimpleGraph[V], s: FiniteSet[V], pick: V -> V) -> Bool {
    forall(v: V) {
        s.contains(v) implies picks_neighbor(g, s, pick, v)
    }
}

theorem has_neighbor_map_apply[V](
    g: SimpleGraph[V], s: FiniteSet[V], pick: V -> V, v: V
) {
    has_neighbor_map(g, s, pick) and s.contains(v) implies picks_neighbor(g, s, pick, v)
}

theorem vertex_cover_is_dominating[V](
    g: SimpleGraph[V], s: FiniteSet[V], c: FiniteSet[V], pick: V -> V
) {
    has_neighbor_map(g, s, pick) and is_vertex_cover(g, s, c) implies is_dominating_set(g, s, c)
}

theorem domination_number_le_cover[V](
    g: SimpleGraph[V], s: FiniteSet[V], c: FiniteSet[V], pick: V -> V
) {
    has_neighbor_map(g, s, pick) and c.subset_eq(s) and is_vertex_cover(g, s, c)
        implies domination_number(g, s) <= fs_card(c)
}

define cover_size_pred[V](g: SimpleGraph[V], s: FiniteSet[V]) -> (Nat -> Bool) {
    function(n: Nat) {
        exists(c: FiniteSet[V]) {
            c.subset_eq(s) and is_vertex_cover(g, s, c) and fs_card(c) = n
        }
    }
}

theorem cover_size_pred_intro[V](
    g: SimpleGraph[V], s: FiniteSet[V], c: FiniteSet[V]
) {
    c.subset_eq(s) and is_vertex_cover(g, s, c) implies cover_size_pred(g, s)(fs_card(c))
}

theorem cover_size_pred_ambient[V](g: SimpleGraph[V], s: FiniteSet[V]) {
    cover_size_pred(g, s)(fs_card(s))
}

let vertex_cover_number[V](g: SimpleGraph[V], s: FiniteSet[V]) -> result: Nat satisfy {
    is_min(cover_size_pred(g, s), result)
}

theorem vertex_cover_number_attained[V](g: SimpleGraph[V], s: FiniteSet[V]) {
    cover_size_pred(g, s)(vertex_cover_number(g, s))
}

theorem vertex_cover_number_is_least[V](
    g: SimpleGraph[V], s: FiniteSet[V], c: FiniteSet[V]
) {
    c.subset_eq(s) and is_vertex_cover(g, s, c) implies vertex_cover_number(g, s) <= fs_card(c)
}

theorem vertex_cover_number_le_ambient[V](g: SimpleGraph[V], s: FiniteSet[V]) {
    vertex_cover_number(g, s) <= fs_card(s)
}

theorem vertex_cover_number_le_of_cover[V](
    g: SimpleGraph[V], s: FiniteSet[V], c: FiniteSet[V], n: Nat
) {
    c.subset_eq(s) and is_vertex_cover(g, s, c) and fs_card(c) <= n
        implies vertex_cover_number(g, s) <= n
}

define is_independent_in[V](g: SimpleGraph[V], t: FiniteSet[V]) -> Bool {
    forall(x: V, y: V) {
        t.contains(x) and t.contains(y) implies not g.adj(x, y)
    }
}

theorem is_independent_in_apply[V](g: SimpleGraph[V], t: FiniteSet[V], x: V, y: V) {
    is_independent_in(g, t) and t.contains(x) and t.contains(y) implies not g.adj(x, y)
}

theorem is_independent_in_intro[V](g: SimpleGraph[V], t: FiniteSet[V]) {
    (forall(x: V, y: V) {
        t.contains(x) and t.contains(y) implies not g.adj(x, y)
    }) implies is_independent_in(g, t)
}

theorem is_independent_in_of_subset[V](g: SimpleGraph[V], t: FiniteSet[V], r: FiniteSet[V]) {
    r.subset_eq(t) and is_independent_in(g, t) implies is_independent_in(g, r)
}

define is_clique_in[V](g: SimpleGraph[V], t: FiniteSet[V]) -> Bool {
    forall(x: V, y: V) {
        t.contains(x) and t.contains(y) and x != y implies g.adj(x, y)
    }
}

theorem is_clique_in_apply[V](g: SimpleGraph[V], t: FiniteSet[V], x: V, y: V) {
    is_clique_in(g, t) and t.contains(x) and t.contains(y) and x != y implies g.adj(x, y)
}

theorem is_clique_in_intro[V](g: SimpleGraph[V], t: FiniteSet[V]) {
    (forall(x: V, y: V) {
        t.contains(x) and t.contains(y) and x != y implies g.adj(x, y)
    }) implies is_clique_in(g, t)
}

theorem is_clique_in_of_subset[V](g: SimpleGraph[V], t: FiniteSet[V], r: FiniteSet[V]) {
    r.subset_eq(t) and is_clique_in(g, t) implies is_clique_in(g, r)
}

theorem clique_and_independent_no_two[V](g: SimpleGraph[V], t: FiniteSet[V], x: V, y: V) {
    is_clique_in(g, t) and is_independent_in(g, t) and t.contains(x) and t.contains(y) implies x = y
}

theorem vertex_cover_of_independent_complement[V](
    g: SimpleGraph[V], s: FiniteSet[V], t: FiniteSet[V]
) {
    is_independent_in(g, t) implies is_vertex_cover(g, s, fs_difference(s, t))
}

define opposite_part[V](part: V -> Bool) -> (V -> Bool) {
    function(v: V) {
        not part(v)
    }
}

theorem opposite_part_eq[V](part: V -> Bool, v: V) {
    opposite_part(part)(v) = not part(v)
}

define bipartite_side[V](s: FiniteSet[V], part: V -> Bool) -> FiniteSet[V] {
    finite_set_filter(s, part)
}

theorem bipartite_side_contains_eq[V](s: FiniteSet[V], part: V -> Bool, v: V) {
    bipartite_side(s, part).contains(v) = (s.contains(v) and part(v))
}

theorem bipartite_side_subset[V](s: FiniteSet[V], part: V -> Bool) {
    bipartite_side(s, part).subset_eq(s)
}

theorem bipartite_side_independent[V](
    g: SimpleGraph[V], s: FiniteSet[V], part: V -> Bool
) {
    is_bipartition(g, s, part) implies is_independent_in(g, bipartite_side(s, part))
}

theorem is_bipartition_opposite[V](
    g: SimpleGraph[V], s: FiniteSet[V], part: V -> Bool
) {
    is_bipartition(g, s, part) implies is_bipartition(g, s, opposite_part(part))
}

theorem bipartite_other_side_independent[V](
    g: SimpleGraph[V], s: FiniteSet[V], part: V -> Bool
) {
    is_bipartition(g, s, part) implies is_independent_in(g, bipartite_side(s, opposite_part(part)))
}

theorem bipartite_sides_cover[V](s: FiniteSet[V], part: V -> Bool, v: V) {
    s.contains(v) implies bipartite_side(s, part).contains(v) or bipartite_side(s, opposite_part(part)).contains(v)
}

theorem bipartite_sides_disjoint[V](s: FiniteSet[V], part: V -> Bool, v: V) {
    not (bipartite_side(s, part).contains(v) and bipartite_side(s, opposite_part(part)).contains(v))
}

theorem bipartite_neighborhood_opposite_side[V](
    g: SimpleGraph[V], s: FiniteSet[V], part: V -> Bool, v: V, w: V
) {
    is_bipartition(g, s, part) and s.contains(v) and part(v) and neighborhood(g, s, v).contains(w) implies bipartite_side(s, opposite_part(part)).contains(w)
}

theorem bipartite_neighborhood_first_side[V](
    g: SimpleGraph[V], s: FiniteSet[V], part: V -> Bool, v: V, w: V
) {
    is_bipartition(g, s, part) and s.contains(v) and not part(v) and neighborhood(g, s, v).contains(w) implies bipartite_side(s, part).contains(w)
}

theorem bipartite_no_neighbor_same_side[V](
    g: SimpleGraph[V], s: FiniteSet[V], part: V -> Bool, v: V, w: V
) {
    is_bipartition(g, s, part) and s.contains(v) and part(v) and bipartite_side(s, part).contains(w) implies not neighborhood(g, s, v).contains(w)
}

theorem bipartite_neighborhood_disjoint_from_side[V](
    g: SimpleGraph[V], s: FiniteSet[V], part: V -> Bool, v: V, w: V
) {
    is_bipartition(g, s, part) and s.contains(v) and part(v) implies not (neighborhood(g, s, v).contains(w) and bipartite_side(s, part).contains(w))
}

theorem clique_is_independent_in_complement[V](g: SimpleGraph[V], t: FiniteSet[V]) {
    is_clique_in(g, t) implies is_independent_in(graph_complement(g), t)
}

theorem independent_in_complement_is_clique[V](g: SimpleGraph[V], t: FiniteSet[V]) {
    is_independent_in(graph_complement(g), t) implies is_clique_in(g, t)
}

theorem clique_iff_independent_in_complement[V](g: SimpleGraph[V], t: FiniteSet[V]) {
    is_clique_in(g, t) = is_independent_in(graph_complement(g), t)
}

theorem independent_is_clique_in_complement[V](g: SimpleGraph[V], t: FiniteSet[V]) {
    is_independent_in(g, t) implies is_clique_in(graph_complement(g), t)
}

theorem clique_in_complement_is_independent[V](g: SimpleGraph[V], t: FiniteSet[V]) {
    is_clique_in(graph_complement(g), t) implies is_independent_in(g, t)
}

theorem independent_iff_clique_in_complement[V](g: SimpleGraph[V], t: FiniteSet[V]) {
    is_independent_in(g, t) = is_clique_in(graph_complement(g), t)
}

theorem clique_in_complement_of_independent[V](g: SimpleGraph[V], t: FiniteSet[V]) {
    is_independent_in(g, t) implies is_clique_in(graph_complement(g), t)
}

theorem independent_of_clique_in_complement[V](g: SimpleGraph[V], t: FiniteSet[V]) {
    is_clique_in(graph_complement(g), t) implies is_independent_in(g, t)
}

theorem independent_in_complement_of_clique[V](g: SimpleGraph[V], t: FiniteSet[V]) {
    is_clique_in(g, t) implies is_independent_in(graph_complement(g), t)
}

theorem clique_of_independent_in_complement[V](g: SimpleGraph[V], t: FiniteSet[V]) {
    is_independent_in(graph_complement(g), t) implies is_clique_in(g, t)
}

theorem independent_of_vertex_cover_complement[V](
    g: SimpleGraph[V], s: FiniteSet[V], c: FiniteSet[V]
) {
    is_vertex_cover(g, s, c) implies is_independent_in(g, fs_difference(s, c))
}

theorem vertex_cover_partitions_ambient[V](
    g: SimpleGraph[V], s: FiniteSet[V], c: FiniteSet[V], v: V
) {
    s.contains(v) implies c.contains(v) or fs_difference(s, c).contains(v)
}

theorem vertex_cover_complement_disjoint[V](
    g: SimpleGraph[V], s: FiniteSet[V], c: FiniteSet[V], v: V
) {
    not (c.contains(v) and fs_difference(s, c).contains(v))
}

define is_independent_subset[V](
    g: SimpleGraph[V], s: FiniteSet[V], t: FiniteSet[V]
) -> Bool {
    t.subset_eq(s) and is_independent_in(g, t)
}

theorem is_independent_subset_apply[V](
    g: SimpleGraph[V], s: FiniteSet[V], t: FiniteSet[V]
) {
    is_independent_subset(g, s, t) implies t.subset_eq(s) and is_independent_in(g, t)
}

theorem is_independent_subset_intro[V](
    g: SimpleGraph[V], s: FiniteSet[V], t: FiniteSet[V]
) {
    t.subset_eq(s) and is_independent_in(g, t) implies is_independent_subset(g, s, t)
}

define is_maximal_independent_in[V](
    g: SimpleGraph[V], s: FiniteSet[V], t: FiniteSet[V]
) -> Bool {
    is_independent_subset(g, s, t) and forall(v: V) {
        s.contains(v) and not t.contains(v) implies not is_independent_in(g, t.insert(v))
    }
}

theorem is_maximal_independent_in_apply[V](
    g: SimpleGraph[V], s: FiniteSet[V], t: FiniteSet[V], v: V
) {
    is_maximal_independent_in(g, s, t) and s.contains(v) and not t.contains(v)
        implies not is_independent_in(g, t.insert(v))
}

theorem is_maximal_independent_in_subset[V](
    g: SimpleGraph[V], s: FiniteSet[V], t: FiniteSet[V]
) {
    is_maximal_independent_in(g, s, t) implies is_independent_subset(g, s, t)
}

theorem is_maximal_independent_in_intro[V](
    g: SimpleGraph[V], s: FiniteSet[V], t: FiniteSet[V]
) {
    is_independent_subset(g, s, t) and (forall(v: V) {
        s.contains(v) and not t.contains(v) implies not is_independent_in(g, t.insert(v))
    }) implies is_maximal_independent_in(g, s, t)
}

theorem independent_insert_adj_at_new[V](
    g: SimpleGraph[V], t: FiniteSet[V], v: V
) {
    is_independent_in(g, t) and not is_independent_in(g, t.insert(v))
        implies exists(w: V) { t.contains(w) and g.adj(w, v) }
}

theorem maximal_independent_is_dominating[V](
    g: SimpleGraph[V], s: FiniteSet[V], t: FiniteSet[V]
) {
    is_maximal_independent_in(g, s, t) implies is_dominating_set(g, s, t)
}

theorem domination_number_le_maximal_independent[V](
    g: SimpleGraph[V], s: FiniteSet[V], t: FiniteSet[V]
) {
    is_maximal_independent_in(g, s, t) implies domination_number(g, s) <= fs_card(t)
}

define is_independent_dominating_set[V](
    g: SimpleGraph[V], s: FiniteSet[V], t: FiniteSet[V]
) -> Bool {
    is_independent_subset(g, s, t) and is_dominating_set(g, s, t)
}

theorem is_independent_dominating_set_apply[V](
    g: SimpleGraph[V], s: FiniteSet[V], t: FiniteSet[V]
) {
    is_independent_dominating_set(g, s, t)
        implies is_independent_subset(g, s, t) and is_dominating_set(g, s, t)
}

theorem is_independent_dominating_set_intro[V](
    g: SimpleGraph[V], s: FiniteSet[V], t: FiniteSet[V]
) {
    is_independent_subset(g, s, t) and is_dominating_set(g, s, t)
        implies is_independent_dominating_set(g, s, t)
}

theorem maximal_independent_is_independent_dominating[V](
    g: SimpleGraph[V], s: FiniteSet[V], t: FiniteSet[V]
) {
    is_maximal_independent_in(g, s, t) implies is_independent_dominating_set(g, s, t)
}

theorem domination_number_le_independent_dominating[V](
    g: SimpleGraph[V], s: FiniteSet[V], t: FiniteSet[V]
) {
    is_independent_dominating_set(g, s, t) implies domination_number(g, s) <= fs_card(t)
}

theorem finite_induced_adj_eq[V](g: SimpleGraph[V], s: FiniteSet[V], x: V, y: V) {
    induced_subgraph(g, s.underlying_set).adj(x, y) = (g.adj(x, y) and s.contains(x) and s.contains(y))
}

theorem finite_induced_adj_imp[V](g: SimpleGraph[V], s: FiniteSet[V], x: V, y: V) {
    induced_subgraph(g, s.underlying_set).adj(x, y) implies g.adj(x, y)
}

theorem finite_induced_adj_contains[V](g: SimpleGraph[V], s: FiniteSet[V], x: V, y: V) {
    induced_subgraph(g, s.underlying_set).adj(x, y) implies s.contains(x) and s.contains(y)
}

theorem is_independent_in_induced[V](g: SimpleGraph[V], s: FiniteSet[V], t: FiniteSet[V]) {
    is_independent_in(g, t) implies is_independent_in(induced_subgraph(g, s.underlying_set), t)
}

theorem is_clique_in_of_induced[V](g: SimpleGraph[V], s: FiniteSet[V], t: FiniteSet[V]) {
    is_clique_in(induced_subgraph(g, s.underlying_set), t) implies is_clique_in(g, t)
}

theorem is_clique_in_induced_of_subset[V](
    g: SimpleGraph[V], s: FiniteSet[V], t: FiniteSet[V]
) {
    t.subset_eq(s) and is_clique_in(g, t) implies is_clique_in(induced_subgraph(g, s.underlying_set), t)
}

theorem is_bipartition_induced[V](
    g: SimpleGraph[V], s: FiniteSet[V], t: FiniteSet[V], part: V -> Bool
) {
    is_bipartition(g, t, part) implies is_bipartition(induced_subgraph(g, s.underlying_set), t, part)
}

theorem is_vertex_cover_induced[V](
    g: SimpleGraph[V], s: FiniteSet[V], t: FiniteSet[V], c: FiniteSet[V]
) {
    is_vertex_cover(g, t, c) implies is_vertex_cover(induced_subgraph(g, s.underlying_set), t, c)
}

define pairs_share_vertex[V](p: Pair[V, V], q: Pair[V, V]) -> Bool {
    p.first = q.first or p.first = q.second or p.second = q.first or p.second = q.second
}

define is_matching[V](g: SimpleGraph[V], s: FiniteSet[V], m: FiniteSet[Pair[V, V]]) -> Bool {
    m.subset_eq(directed_edges(g, s)) and forall(p: Pair[V, V], q: Pair[V, V]) {
        m.contains(p) and m.contains(q) and pairs_share_vertex(p, q) implies p = q
    }
}

define matching_size[V](g: SimpleGraph[V], s: FiniteSet[V], m: FiniteSet[Pair[V, V]]) -> Nat {
    fs_card(m)
}

define matching_vertices[V](m: FiniteSet[Pair[V, V]]) -> FiniteSet[V] {
    fs_union(fs_image(m, pair_first[V, V]), fs_image(m, pair_second[V, V]))
}

define is_perfect_matching[V](g: SimpleGraph[V], s: FiniteSet[V], m: FiniteSet[Pair[V, V]]) -> Bool {
    is_matching(g, s, m) and forall(v: V) {
        s.contains(v) implies exists(p: Pair[V, V]) {
            m.contains(p) and (p.first = v or p.second = v)
        }
    }
}

theorem is_matching_apply_edge[V](g: SimpleGraph[V], s: FiniteSet[V], m: FiniteSet[Pair[V, V]], p: Pair[V, V]) {
    is_matching(g, s, m) and m.contains(p) implies directed_edges(g, s).contains(p)
}

theorem is_matching_apply_disjoint[V](g: SimpleGraph[V], s: FiniteSet[V], m: FiniteSet[Pair[V, V]], p: Pair[V, V], q: Pair[V, V]) {
    is_matching(g, s, m) and m.contains(p) and m.contains(q) and pairs_share_vertex(p, q) implies p = q
}

theorem is_matching_intro[V](g: SimpleGraph[V], s: FiniteSet[V], m: FiniteSet[Pair[V, V]]) {
    m.subset_eq(directed_edges(g, s)) and forall(p: Pair[V, V], q: Pair[V, V]) {
        m.contains(p) and m.contains(q) and pairs_share_vertex(p, q) implies p = q
    } implies is_matching(g, s, m)
}

theorem matching_pair_ne[V](g: SimpleGraph[V], s: FiniteSet[V], m: FiniteSet[Pair[V, V]], p: Pair[V, V]) {
    is_matching(g, s, m) and m.contains(p) implies p.first != p.second
}

theorem matching_pair_components_in[V](g: SimpleGraph[V], s: FiniteSet[V], m: FiniteSet[Pair[V, V]], p: Pair[V, V]) {
    is_matching(g, s, m) and m.contains(p) implies s.contains(p.first) and s.contains(p.second)
}

theorem matching_first_locally_injective[V](g: SimpleGraph[V], s: FiniteSet[V], m: FiniteSet[Pair[V, V]], p: Pair[V, V], q: Pair[V, V]) {
    is_matching(g, s, m) and m.contains(p) and m.contains(q) and p.first = q.first implies p = q
}

theorem matching_second_locally_injective[V](g: SimpleGraph[V], s: FiniteSet[V], m: FiniteSet[Pair[V, V]], p: Pair[V, V], q: Pair[V, V]) {
    is_matching(g, s, m) and m.contains(p) and m.contains(q) and p.second = q.second implies p = q
}

theorem fs_card_image_eq_of_locally_injective[T, U](s: FiniteSet[T], f: T -> U) {
    (forall(x: T, y: T) {
        s.contains(x) and s.contains(y) and f(x) = f(y) implies x = y
    }) implies fs_card(fs_image(s, f)) = fs_card(s)
}

theorem matching_first_image_card[V](g: SimpleGraph[V], s: FiniteSet[V], m: FiniteSet[Pair[V, V]]) {
    is_matching(g, s, m) implies fs_card(fs_image(m, pair_first[V, V])) = fs_card(m)
}

theorem matching_second_image_card[V](g: SimpleGraph[V], s: FiniteSet[V], m: FiniteSet[Pair[V, V]]) {
    is_matching(g, s, m) implies fs_card(fs_image(m, pair_second[V, V])) = fs_card(m)
}

theorem matching_images_disjoint[V](g: SimpleGraph[V], s: FiniteSet[V], m: FiniteSet[Pair[V, V]]) {
    is_matching(g, s, m) implies fs_image(m, pair_first[V, V]).is_disjoint(fs_image(m, pair_second[V, V]))
}

theorem matching_vertices_card[V](g: SimpleGraph[V], s: FiniteSet[V], m: FiniteSet[Pair[V, V]]) {
    is_matching(g, s, m) implies fs_card(matching_vertices(m)) = fs_card(m) + fs_card(m)
}

theorem matching_first_image_subset_ambient[V](g: SimpleGraph[V], s: FiniteSet[V], m: FiniteSet[Pair[V, V]]) {
    is_matching(g, s, m) implies fs_image(m, pair_first[V, V]).subset_eq(s)
}

theorem matching_second_image_subset_ambient[V](g: SimpleGraph[V], s: FiniteSet[V], m: FiniteSet[Pair[V, V]]) {
    is_matching(g, s, m) implies fs_image(m, pair_second[V, V]).subset_eq(s)
}

theorem matching_vertices_subset_ambient[V](g: SimpleGraph[V], s: FiniteSet[V], m: FiniteSet[Pair[V, V]]) {
    is_matching(g, s, m) implies matching_vertices(m).subset_eq(s)
}

theorem matching_size_le_half_vertices[V](g: SimpleGraph[V], s: FiniteSet[V], m: FiniteSet[Pair[V, V]]) {
    is_matching(g, s, m) implies fs_card(m) + fs_card(m) <= fs_card(s)
}

theorem matching_size_le_vertices[V](g: SimpleGraph[V], s: FiniteSet[V], m: FiniteSet[Pair[V, V]]) {
    is_matching(g, s, m) implies fs_card(m) <= fs_card(s)
}

define matching_size_pred[V](g: SimpleGraph[V], s: FiniteSet[V]) -> (Nat -> Bool) {
    function(n: Nat) {
        exists(m: FiniteSet[Pair[V, V]]) {
            is_matching(g, s, m) and fs_card(m) = n
        }
    }
}

theorem matching_size_pred_intro[V](g: SimpleGraph[V], s: FiniteSet[V], m: FiniteSet[Pair[V, V]]) {
    is_matching(g, s, m) implies matching_size_pred(g, s)(fs_card(m))
}

theorem empty_set_is_matching[V](g: SimpleGraph[V], s: FiniteSet[V]) {
    is_matching(g, s, FiniteSet.empty[Pair[V, V]])
}

theorem matching_size_pred_zero[V](g: SimpleGraph[V], s: FiniteSet[V]) {
    matching_size_pred(g, s)(Nat.0)
}

theorem matching_size_pred_bounded[V](g: SimpleGraph[V], s: FiniteSet[V]) {
    is_upper_bound_of(matching_size_pred(g, s), fs_card(s))
}

let maximum_matching_size[V](g: SimpleGraph[V], s: FiniteSet[V]) -> result: Nat satisfy {
    is_max(matching_size_pred(g, s), result)
}

theorem maximum_matching_size_attained[V](g: SimpleGraph[V], s: FiniteSet[V]) {
    matching_size_pred(g, s)(maximum_matching_size(g, s))
}

theorem maximum_matching_size_is_greatest[V](g: SimpleGraph[V], s: FiniteSet[V], m: FiniteSet[Pair[V, V]]) {
    is_matching(g, s, m) implies fs_card(m) <= maximum_matching_size(g, s)
}

theorem maximum_matching_exists[V](g: SimpleGraph[V], s: FiniteSet[V]) {
    exists(m: FiniteSet[Pair[V, V]]) {
        is_matching(g, s, m) and fs_card(m) = maximum_matching_size(g, s)
    }
}

theorem is_perfect_matching_apply_cover[V](g: SimpleGraph[V], s: FiniteSet[V], m: FiniteSet[Pair[V, V]], v: V) {
    is_perfect_matching(g, s, m) and s.contains(v) implies exists(p: Pair[V, V]) {
        m.contains(p) and (p.first = v or p.second = v)
    }
}

theorem perfect_matching_is_matching[V](g: SimpleGraph[V], s: FiniteSet[V], m: FiniteSet[Pair[V, V]]) {
    is_perfect_matching(g, s, m) implies is_matching(g, s, m)
}

theorem is_perfect_matching_intro[V](g: SimpleGraph[V], s: FiniteSet[V], m: FiniteSet[Pair[V, V]]) {
    is_matching(g, s, m) and (forall(v: V) {
        s.contains(v) implies exists(p: Pair[V, V]) {
            m.contains(p) and (p.first = v or p.second = v)
        }
    }) implies is_perfect_matching(g, s, m)
}

theorem perfect_matching_vertices_cover[V](g: SimpleGraph[V], s: FiniteSet[V], m: FiniteSet[Pair[V, V]]) {
    is_perfect_matching(g, s, m) implies matching_vertices(m) = s
}

theorem perfect_matching_size[V](g: SimpleGraph[V], s: FiniteSet[V], m: FiniteSet[Pair[V, V]]) {
    is_perfect_matching(g, s, m) implies fs_card(s) = fs_card(m) + fs_card(m)
}

define neighborhood_of_set[V](g: SimpleGraph[V], s: FiniteSet[V], t: FiniteSet[V]) -> FiniteSet[V] {
    fs_image(directed_edges_from_set(g, s, t), pair_second[V, V])
}

theorem neighborhood_of_set_contains_of_adj[V](g: SimpleGraph[V], s: FiniteSet[V], t: FiniteSet[V], x: V, y: V) {
    t.contains(x) and s.contains(x) and s.contains(y) and g.adj(x, y)
        implies neighborhood_of_set(g, s, t).contains(y)
}

theorem neighborhood_of_set_contains_imp_adj[V](g: SimpleGraph[V], s: FiniteSet[V], t: FiniteSet[V], y: V) {
    neighborhood_of_set(g, s, t).contains(y) implies exists(x: V) {
        t.contains(x) and s.contains(x) and s.contains(y) and g.adj(x, y)
    }
}

define covers_vertex[V](m: FiniteSet[Pair[V, V]], v: V) -> Bool {
    exists(p: Pair[V, V]) {
        m.contains(p) and (p.first = v or p.second = v)
    }
}

define covers[V](m: FiniteSet[Pair[V, V]], t: FiniteSet[V]) -> Bool {
    forall(v: V) {
        t.contains(v) implies covers_vertex(m, v)
    }
}

theorem covers_apply[V](m: FiniteSet[Pair[V, V]], t: FiniteSet[V], v: V) {
    covers(m, t) and t.contains(v) implies exists(p: Pair[V, V]) {
        m.contains(p) and (p.first = v or p.second = v)
    }
}

theorem covers_intro[V](m: FiniteSet[Pair[V, V]], t: FiniteSet[V]) {
    (forall(v: V) {
        t.contains(v) implies covers_vertex(m, v)
    }) implies covers(m, t)
}

theorem covers_of_subset[V](m: FiniteSet[Pair[V, V]], t: FiniteSet[V], side: FiniteSet[V]) {
    covers(m, side) and t.subset_eq(side) implies covers(m, t)
}

define covers_vertex_pred[V](m: FiniteSet[Pair[V, V]], v: V) -> (Pair[V, V] -> Bool) {
    function(p: Pair[V, V]) {
        m.contains(p) and (p.first = v or p.second = v)
    }
}

theorem covers_vertex_witness[V](m: FiniteSet[Pair[V, V]], t: FiniteSet[V], v: V) {
    covers(m, t) and t.contains(v) implies exists(p: Pair[V, V]) {
        finite_set_witness_predicate(m, covers_vertex_pred(m, v), p)
    }
}

define covering_pair[V](m: FiniteSet[Pair[V, V]], v: V) -> Pair[V, V] {
    choose_from_finite_set_or_default(m, covers_vertex_pred(m, v), Pair.new(v, v))
}

define matching_partner[V](m: FiniteSet[Pair[V, V]], v: V) -> V {
    if covering_pair(m, v).first = v {
        covering_pair(m, v).second
    } else {
        covering_pair(m, v).first
    }
}

theorem matching_partner_pair_contains[V](m: FiniteSet[Pair[V, V]], t: FiniteSet[V], v: V) {
    covers(m, t) and t.contains(v) implies m.contains(covering_pair(m, v))
}

theorem matching_partner_pair_covers[V](m: FiniteSet[Pair[V, V]], t: FiniteSet[V], v: V) {
    covers(m, t) and t.contains(v) implies covers_vertex_pred(m, v)(covering_pair(m, v))
}

theorem matching_partner_ne[V](g: SimpleGraph[V], s: FiniteSet[V], m: FiniteSet[Pair[V, V]], t: FiniteSet[V], v: V) {
    is_matching(g, s, m) and covers(m, t) and t.contains(v) implies matching_partner(m, v) != v
}

theorem matching_partner_in_neighborhood[V](g: SimpleGraph[V], s: FiniteSet[V], m: FiniteSet[Pair[V, V]], t: FiniteSet[V], v: V) {
    is_matching(g, s, m) and covers(m, t) and t.contains(v)
        implies neighborhood_of_set(g, s, t).contains(matching_partner(m, v))
}

theorem matching_partner_locally_injective[V](g: SimpleGraph[V], s: FiniteSet[V], m: FiniteSet[Pair[V, V]], t: FiniteSet[V], v: V, w: V) {
    is_matching(g, s, m) and covers(m, t) and t.contains(v) and t.contains(w) and
        matching_partner(m, v) = matching_partner(m, w) implies v = w
}

define matching_partner_fn[V](m: FiniteSet[Pair[V, V]]) -> (V -> V) {
    function(v: V) {
        matching_partner(m, v)
    }
}

theorem matching_covering_neighborhood_bound[V](g: SimpleGraph[V], s: FiniteSet[V], m: FiniteSet[Pair[V, V]], t: FiniteSet[V]) {
    is_matching(g, s, m) and covers(m, t) implies
        fs_card(t) <= fs_card(neighborhood_of_set(g, s, t))
}

theorem hall_necessary_condition[V](g: SimpleGraph[V], s: FiniteSet[V], part: V -> Bool) {
    is_bipartition(g, s, part) and exists(m: FiniteSet[Pair[V, V]]) {
        is_matching(g, s, m) and covers(m, bipartite_side(s, part))
    } implies forall(t: FiniteSet[V]) {
        t.subset_eq(bipartite_side(s, part)) implies
            fs_card(t) <= fs_card(neighborhood_of_set(g, s, t))
    }
}

define cover_vertex_pred[V](c: FiniteSet[V], p: Pair[V, V]) -> (V -> Bool) {
    function(v: V) {
        c.contains(v) and (v = p.first or v = p.second)
    }
}

define cover_vertex_of[V](c: FiniteSet[V], p: Pair[V, V]) -> V {
    choose_from_finite_set_or_default(c, cover_vertex_pred(c, p), p.first)
}

define cover_vertex_fn[V](c: FiniteSet[V]) -> (Pair[V, V] -> V) {
    function(p: Pair[V, V]) {
        cover_vertex_of(c, p)
    }
}

theorem cover_vertex_witness_exists[V](g: SimpleGraph[V], s: FiniteSet[V], c: FiniteSet[V], p: Pair[V, V]) {
    is_vertex_cover(g, s, c) and directed_edges(g, s).contains(p) implies
        exists(v: V) {
            finite_set_witness_predicate(c, cover_vertex_pred(c, p), v)
        }
}

theorem cover_vertex_of_contains[V](g: SimpleGraph[V], s: FiniteSet[V], c: FiniteSet[V], p: Pair[V, V]) {
    is_vertex_cover(g, s, c) and directed_edges(g, s).contains(p) implies c.contains(cover_vertex_of(c, p))
}

theorem cover_vertex_of_on_pair[V](g: SimpleGraph[V], s: FiniteSet[V], c: FiniteSet[V], p: Pair[V, V]) {
    is_vertex_cover(g, s, c) and directed_edges(g, s).contains(p) implies
        (cover_vertex_of(c, p) = p.first or cover_vertex_of(c, p) = p.second)
}

theorem cover_vertex_of_locally_injective[V](g: SimpleGraph[V], s: FiniteSet[V], c: FiniteSet[V],
    m: FiniteSet[Pair[V, V]], p: Pair[V, V], q: Pair[V, V]) {
    is_vertex_cover(g, s, c) and is_matching(g, s, m) and m.contains(p) and m.contains(q) and
        cover_vertex_of(c, p) = cover_vertex_of(c, q) implies p = q
}

theorem vertex_cover_bounds_matching[V](g: SimpleGraph[V], s: FiniteSet[V], c: FiniteSet[V],
    m: FiniteSet[Pair[V, V]]) {
    is_vertex_cover(g, s, c) and is_matching(g, s, m) implies fs_card(m) <= fs_card(c)
}

theorem maximum_matching_size_le_vertex_cover_number[V](g: SimpleGraph[V], s: FiniteSet[V]) {
    maximum_matching_size(g, s) <= vertex_cover_number(g, s)
}

theorem min_unique(f: Nat -> Bool, m: Nat, m2: Nat) {
    is_min(f, m) and is_min(f, m2) implies m = m2
}

theorem double_lte_three(n: Nat) {
    n + n <= Nat.3 implies n <= Nat.1
}

theorem double_lte_four(n: Nat) {
    n + n <= Nat.4 implies n <= Nat.2
}

theorem single_pair_matching_is_matching[V](g: SimpleGraph[V], s: FiniteSet[V], a: Pair[V, V]) {
    directed_edges(g, s).contains(a) implies
        is_matching(g, s, fs_insert(FiniteSet.empty[Pair[V, V]], a))
}

theorem pairs_share_vertex_sym[V](p: Pair[V, V], q: Pair[V, V]) {
    pairs_share_vertex(p, q) = pairs_share_vertex(q, p)
}

theorem share_false_of_eq[V](p: Pair[V, V], q: Pair[V, V], a: Pair[V, V], b: Pair[V, V]) {
    p = a and q = b and not pairs_share_vertex(a, b) implies pairs_share_vertex(p, q) = false
}

theorem two_pair_matching_is_matching[V](g: SimpleGraph[V], s: FiniteSet[V], a: Pair[V, V], b: Pair[V, V]) {
    directed_edges(g, s).contains(a) and directed_edges(g, s).contains(b) and
        not pairs_share_vertex(a, b)
        implies is_matching(g, s, fs_insert(fs_insert(FiniteSet.empty[Pair[V, V]], a), b))
}

theorem pairs_not_share_of_ne_components[V](a: Pair[V, V], b: Pair[V, V]) {
    a.first != b.first and a.first != b.second and a.second != b.first and a.second != b.second
        implies not pairs_share_vertex(a, b)
}

theorem part_false_of_ne[V](v: V, a: V, b: V) {
    v != a and v != b implies (v = a or v = b) = false
}

define path3_part(v: Nat) -> Bool {
    v = Nat.1
}

define path3_adj(x: Nat, y: Nat) -> Bool {
    path3_part(x) != path3_part(y)
}

theorem path3_adj_is_symmetric {
    is_symmetric(path3_adj)
}

theorem path3_adj_is_irreflexive {
    is_irreflexive(path3_adj)
}

theorem path3_adj_constraint {
    is_symmetric(path3_adj) and is_irreflexive(path3_adj)
}

theorem path3_graph_exists {
    exists(g: SimpleGraph[Nat]) { SimpleGraph.new(path3_adj) = Option.some(g) }
}

let path3: SimpleGraph[Nat] satisfy {
    SimpleGraph.new(path3_adj) = Option.some(path3)
}

theorem path3_adj_eq(x: Nat, y: Nat) {
    path3.adj(x, y) = (path3_part(x) != path3_part(y))
}

theorem path3_is_bipartition {
    is_bipartition(path3, range_set(Nat.3), path3_part)
}

theorem path3_is_bipartite {
    is_bipartite(path3, range_set(Nat.3))
}

theorem path3_vertices_lt {
    Nat.0 < Nat.3 and Nat.1 < Nat.3
}

theorem path3_vertex_zero {
    range_set(Nat.3).contains(Nat.0)
}

theorem path3_vertex_one {
    range_set(Nat.3).contains(Nat.1)
}

theorem path3_edge01 {
    path3.adj(Nat.0, Nat.1)
}

theorem path3_directed_edge01 {
    directed_edges(path3, range_set(Nat.3)).contains(Pair.new(Nat.0, Nat.1))
}

let path3_matching: FiniteSet[Pair[Nat, Nat]] = fs_insert(FiniteSet.empty[Pair[Nat, Nat]], Pair.new(Nat.0, Nat.1))

theorem path3_matching_is_matching {
    is_matching(path3, range_set(Nat.3), path3_matching)
}

theorem path3_matching_card {
    fs_card(path3_matching) = Nat.1
}
