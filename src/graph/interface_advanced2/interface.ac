theorem bool_ne_eq_flip(x: Bool, y: Bool, z: Bool) {
    x != y implies (x = z) = not (y = z)
}

define walk_in_set[V](s: FiniteSet[V], steps: List[V]) -> Bool {
    match steps {
        List.nil {
            true
        }
        List.cons(head, tail) {
            s.contains(head) and walk_in_set(s, tail)
        }
    }
}

theorem walk_in_set_cons_head[V](s: FiniteSet[V], h: V, t: List[V]) {
    walk_in_set(s, List.cons(h, t)) implies s.contains(h)
}

theorem walk_in_set_cons_tail[V](s: FiniteSet[V], h: V, t: List[V]) {
    walk_in_set(s, List.cons(h, t)) implies walk_in_set(s, t)
}

theorem walk_in_set_cons[V](s: FiniteSet[V], h: V, t: List[V]) {
    walk_in_set(s, List.cons(h, t)) = (s.contains(h) and walk_in_set(s, t))
}

theorem walk_in_set_nil[V](s: FiniteSet[V]) {
    walk_in_set(s, List.nil[V])
}

theorem walk_in_set_singleton[V](s: FiniteSet[V], y: V) {
    s.contains(y) implies walk_in_set(s, List.singleton(y))
}

theorem bool_ne_false(p: Bool) {
    (p != false) = p
}

theorem bool_ne_not(p: Bool, q: Bool) {
    not (p != q) = (p != not q)
}

theorem nat_odd_add(a: Nat, b: Nat) {
    nat_odd(a + b) = (nat_odd(a) != nat_odd(b))
}

theorem simple_graph_walk_concat[V](
    g: SimpleGraph[V], a: V, m: V, b: V, w1: List[V], w2: List[V]
) {
    simple_graph_walk(g, a, m, w1) and simple_graph_walk(g, m, b, w2)
        implies simple_graph_walk(g, a, b, w1 + w2)
}

theorem simple_graph_walk_concat_split[V](g: SimpleGraph[V], a: V, b: V, w1: List[V], w2: List[V]) {
    simple_graph_walk(g, a, b, w1 + w2) implies exists(m: V) {
        simple_graph_walk(g, a, m, w1) and simple_graph_walk(g, m, b, w2)
    }
}

theorem walk_in_set_left[V](s: FiniteSet[V], w1: List[V], w2: List[V]) {
    walk_in_set(s, w1 + w2) implies walk_in_set(s, w1)
}

theorem walk_in_set_right[V](s: FiniteSet[V], w1: List[V], w2: List[V]) {
    walk_in_set(s, w1 + w2) implies walk_in_set(s, w2)
}

theorem walk_in_set_concat[V](s: FiniteSet[V], w1: List[V], w2: List[V]) {
    walk_in_set(s, w1) and walk_in_set(s, w2) implies walk_in_set(s, w1 + w2)
}

theorem bool_ne_eq_trans[V](part: V -> Bool, a: V, b: V, next: V, tail: List[V]) {
    part(a) != part(next) and (part(next) = part(b)) = not nat_odd(tail.length) and
        nat_odd(List.cons(next, tail).length) = not nat_odd(tail.length)
        implies (part(a) = part(b)) = not nat_odd(List.cons(next, tail).length)
}

theorem bipartition_walk_color_flip[V](
    g: SimpleGraph[V], s: FiniteSet[V], part: V -> Bool, x: V, y: V, steps: List[V]
) {
    is_bipartition(g, s, part) and simple_graph_walk(g, x, y, steps) and s.contains(x) and
        walk_in_set(s, steps)
        implies (part(x) = part(y)) = not nat_odd(steps.length)
}

theorem is_bipartition_no_odd_closed_walk[V](
    g: SimpleGraph[V], s: FiniteSet[V], part: V -> Bool, x: V, steps: List[V]
) {
    is_bipartition(g, s, part) and simple_graph_closed_walk(g, x, steps) and s.contains(x) and
        walk_in_set(s, steps)
        implies not nat_odd(steps.length)
}

define has_odd_cycle[V](g: SimpleGraph[V], s: FiniteSet[V]) -> Bool {
    exists(start: V, steps: List[V]) {
        s.contains(start) and simple_graph_cycle(g, start, steps) and nat_odd(steps.length) and
            walk_in_set(s, steps)
    }
}

theorem is_bipartite_no_odd_cycle[V](g: SimpleGraph[V], s: FiniteSet[V]) {
    is_bipartite(g, s) implies not has_odd_cycle(g, s)
}

define rev_walk_targets[V](steps: List[V], start: V) -> List[V] {
    match steps {
        List.nil {
            List.nil[V]
        }
        List.cons(head, tail) {
            rev_walk_targets(tail, head) + List.cons(start, List.nil[V])
        }
    }
}

theorem simple_graph_walk_reverse[V](g: SimpleGraph[V], a: V, b: V, steps: List[V]) {
    simple_graph_walk(g, a, b, steps) implies simple_graph_walk(g, b, a, rev_walk_targets(steps, a))
}

theorem rev_walk_targets_in_set[V](s: FiniteSet[V], steps: List[V], start: V) {
    walk_in_set(s, steps) and s.contains(start) implies walk_in_set(s, rev_walk_targets(steps, start))
}

theorem nat_odd_ne_zero(n: Nat) {
    nat_odd(n) implies n != Nat.0
}

theorem bool_ne_of_not_and(a: Bool, b: Bool) {
    not a and b implies a != b
}

define has_odd_closed_walk[V](g: SimpleGraph[V], s: FiniteSet[V]) -> Bool {
    exists(x: V, steps: List[V]) {
        simple_graph_closed_walk(g, x, steps) and nat_odd(steps.length) and
            walk_in_set(s, steps)
    }
}

theorem rev_walk_targets_length[V](steps: List[V], start: V) {
    rev_walk_targets(steps, start).length = steps.length
}

theorem bool_ne_of_and_not(a: Bool, b: Bool) {
    a and not b implies a != b
}

define odd_walk_from[V](g: SimpleGraph[V], s: FiniteSet[V], r: V, x: V) -> Bool {
    exists(steps: List[V]) {
        simple_graph_walk(g, r, x, steps) and walk_in_set(s, steps) and nat_odd(steps.length)
    }
}

define walk_reachable_from[V](g: SimpleGraph[V], s: FiniteSet[V], r: V) -> Bool {
    forall(x: V) {
        s.contains(x) implies exists(steps: List[V]) {
            simple_graph_walk(g, r, x, steps) and walk_in_set(s, steps)
        }
    }
}

theorem odd_walk_unique[V](
    g: SimpleGraph[V], s: FiniteSet[V], r: V, x: V, even_steps: List[V], odd_steps: List[V]
) {
    s.contains(r) and
    simple_graph_walk(g, r, x, even_steps) and walk_in_set(s, even_steps) and
        not nat_odd(even_steps.length) and
    simple_graph_walk(g, r, x, odd_steps) and walk_in_set(s, odd_steps) and
        nat_odd(odd_steps.length)
        implies has_odd_closed_walk(g, s)
}

theorem is_bipartition_of_parity_coloring[V](g: SimpleGraph[V], s: FiniteSet[V], r: V) {
    s.contains(r) and walk_reachable_from(g, s, r) and not has_odd_closed_walk(g, s) implies
        is_bipartition(g, s, odd_walk_from(g, s, r))
}

theorem is_bipartite_of_no_odd_closed_walk[V](g: SimpleGraph[V], s: FiniteSet[V], r: V) {
    s.contains(r) and walk_reachable_from(g, s, r) and not has_odd_closed_walk(g, s)
        implies is_bipartite(g, s)
}

define simple_graph_coloring[V, C](g: SimpleGraph[V], color: V -> C) -> Bool {
    forall(x: V, y: V) {
        g.adj(x, y) implies color(x) != color(y)
    }
}

theorem simple_graph_coloring_adj_ne[V, C](g: SimpleGraph[V], color: V -> C, x: V, y: V) {
    simple_graph_coloring(g, color) and g.adj(x, y) implies color(x) != color(y)
}

theorem empty_graph_coloring[V, C](color: V -> C) {
    simple_graph_coloring(empty_graph[V], color)
}

theorem simple_graph_hom_pullback_coloring[V, W, C](f: SimpleGraphHom[V, W], color: W -> C) {
    simple_graph_coloring(f.dst, color) implies simple_graph_coloring(f.src, compose(color, f.map))
}

theorem complete_graph_coloring_imp_injective[V, C](color: V -> C) {
    simple_graph_coloring(complete_graph[V], color) implies is_injective_fn(color)
}

theorem injective_imp_complete_graph_coloring[V, C](color: V -> C) {
    is_injective_fn(color) implies simple_graph_coloring(complete_graph[V], color)
}

theorem simple_graph_coloring_eq_graph_hom_to_complete[V, C](g: SimpleGraph[V], color: V -> C) {
    simple_graph_coloring(g, color) = is_graph_hom(g, complete_graph[C], color)
}

define cycle_adj(n: Nat, x: Nat, y: Nat) -> Bool {
    x != y and (x.suc.mod(n) = y or y.suc.mod(n) = x)
}

theorem cycle_adj_is_symmetric(n: Nat) {
    is_symmetric(cycle_adj(n))
}

theorem cycle_adj_is_irreflexive(n: Nat) {
    is_irreflexive(cycle_adj(n))
}

theorem cycle_adj_constraint(n: Nat) {
    is_symmetric(cycle_adj(n)) and is_irreflexive(cycle_adj(n))
}

let cycle_graph(n: Nat) -> result: SimpleGraph[Nat] satisfy {
    SimpleGraph.new(cycle_adj(n)) = Option.some(result)
}

theorem cycle_graph_adj_iff(n: Nat, x: Nat, y: Nat) {
    cycle_graph(n).adj(x, y) = (x != y and (x.suc.mod(n) = y or y.suc.mod(n) = x))
}

theorem cycle_graph_adj_suc(n: Nat, x: Nat) {
    x.suc < n implies cycle_graph(n).adj(x, x.suc)
}

theorem cycle_graph_adj_wrap(x: Nat) {
    Nat.2 <= x implies cycle_graph(x.suc).adj(x, Nat.0)
}

theorem cycle_graph_adj_ne(n: Nat, x: Nat, y: Nat) {
    cycle_graph(n).adj(x, y) implies x != y
}

define is_proper_coloring_on[V, C](g: SimpleGraph[V], s: FiniteSet[V], color: V -> C) -> Bool {
    forall(x: V, y: V) {
        s.contains(x) and s.contains(y) and g.adj(x, y) implies color(x) != color(y)
    }
}

theorem is_proper_coloring_on_apply[V, C](
    g: SimpleGraph[V], s: FiniteSet[V], color: V -> C, x: V, y: V
) {
    is_proper_coloring_on(g, s, color) and s.contains(x) and s.contains(y) and g.adj(x, y)
        implies color(x) != color(y)
}

theorem is_proper_coloring_on_intro[V, C](g: SimpleGraph[V], s: FiniteSet[V], color: V -> C) {
    (forall(x: V, y: V) {
        s.contains(x) and s.contains(y) and g.adj(x, y) implies color(x) != color(y)
    }) implies is_proper_coloring_on(g, s, color)
}

theorem is_proper_coloring_on_of_simple_graph_coloring[V, C](
    g: SimpleGraph[V], s: FiniteSet[V], color: V -> C
) {
    simple_graph_coloring(g, color) implies is_proper_coloring_on(g, s, color)
}

define is_k_colorable[V](g: SimpleGraph[V], s: FiniteSet[V], k: Nat) -> Bool {
    exists(color: V -> Nat) {
        is_proper_coloring_on(g, s, color) and forall(v: V) {
            s.contains(v) implies color(v) < k
        }
    }
}

theorem is_k_colorable_intro[V](g: SimpleGraph[V], s: FiniteSet[V], k: Nat, color: V -> Nat) {
    is_proper_coloring_on(g, s, color) and forall(v: V) { s.contains(v) implies color(v) < k }
        implies is_k_colorable(g, s, k)
}

theorem is_k_colorable_witness[V](g: SimpleGraph[V], s: FiniteSet[V], k: Nat) {
    is_k_colorable(g, s, k) implies exists(color: V -> Nat) {
        is_proper_coloring_on(g, s, color) and forall(v: V) {
            s.contains(v) implies color(v) < k
        }
    }
}

theorem is_k_colorable_mono[V](g: SimpleGraph[V], s: FiniteSet[V], k1: Nat, k2: Nat) {
    is_k_colorable(g, s, k1) and k1 <= k2 implies is_k_colorable(g, s, k2)
}

theorem nat_lt_two_cases(n: Nat) {
    n < Nat.2 implies n = Nat.0 or n = Nat.1
}

theorem nat_lt_two_one_of_ne_zero(n: Nat) {
    n < Nat.2 and n != Nat.0 implies n = Nat.1
}

theorem two_color_ne_imp_one_eq_ne(a: Nat, b: Nat) {
    a < Nat.2 and b < Nat.2 and a != b implies (a = Nat.1) != (b = Nat.1)
}

define part_of_two_color[V](color: V -> Nat) -> (V -> Bool) {
    function(v: V) {
        color(v) = Nat.1
    }
}

theorem part_of_two_color_eq[V](color: V -> Nat, v: V) {
    part_of_two_color(color)(v) = (color(v) = Nat.1)
}

define two_color_of_part[V](part: V -> Bool) -> (V -> Nat) {
    function(v: V) {
        if part(v) {
            Nat.1
        } else {
            Nat.0
        }
    }
}

theorem two_color_of_part_eq[V](part: V -> Bool, v: V) {
    two_color_of_part(part)(v) = if part(v) { Nat.1 } else { Nat.0 }
}

theorem is_k_colorable_two_imp_is_bipartite[V](g: SimpleGraph[V], s: FiniteSet[V]) {
    is_k_colorable(g, s, Nat.2) implies is_bipartite(g, s)
}

theorem is_bipartite_imp_is_k_colorable_two[V](g: SimpleGraph[V], s: FiniteSet[V]) {
    is_bipartite(g, s) implies is_k_colorable(g, s, Nat.2)
}

theorem is_k_colorable_two_eq_is_bipartite[V](g: SimpleGraph[V], s: FiniteSet[V]) {
    is_k_colorable(g, s, Nat.2) = is_bipartite(g, s)
}

define is_chromatic_number[V](g: SimpleGraph[V], s: FiniteSet[V], k: Nat) -> Bool {
    is_k_colorable(g, s, k) and forall(j: Nat) {
        j < k implies not is_k_colorable(g, s, j)
    }
}

theorem is_chromatic_number_apply[V](g: SimpleGraph[V], s: FiniteSet[V], k: Nat) {
    is_chromatic_number(g, s, k) implies
        is_k_colorable(g, s, k) and forall(j: Nat) {
            j < k implies not is_k_colorable(g, s, j)
        }
}

theorem is_chromatic_number_intro[V](g: SimpleGraph[V], s: FiniteSet[V], k: Nat) {
    is_k_colorable(g, s, k) and forall(j: Nat) {
        j < k implies not is_k_colorable(g, s, j)
    } implies is_chromatic_number(g, s, k)
}

theorem is_chromatic_number_k_colorable[V](g: SimpleGraph[V], s: FiniteSet[V], k: Nat) {
    is_chromatic_number(g, s, k) implies is_k_colorable(g, s, k)
}

theorem is_chromatic_number_not_k_colorable_below[V](
    g: SimpleGraph[V], s: FiniteSet[V], k: Nat, j: Nat
) {
    is_chromatic_number(g, s, k) and j < k implies not is_k_colorable(g, s, j)
}

theorem is_chromatic_number_unique[V](g: SimpleGraph[V], s: FiniteSet[V], k1: Nat, k2: Nat) {
    is_chromatic_number(g, s, k1) and is_chromatic_number(g, s, k2) implies k1 = k2
}

define nat_range_set(n: Nat) -> FiniteSet[Nat] {
    fs_from_list(n.range)
}

theorem nat_range_set_contains_eq(n: Nat, x: Nat) {
    nat_range_set(n).contains(x) = (x < n)
}

theorem nat_range_set_card(n: Nat) {
    fs_card(nat_range_set(n)) = n
}

define nat_identity(v: Nat) -> Nat { v }

theorem nat_identity_eq(v: Nat) {
    nat_identity(v) = v
}

theorem map_unique_length_le_of_contains[T, U](items: List[T], targets: List[U], f: T -> U) {
    forall(x: T) {
        items.contains(x) implies targets.contains(f(x))
    } implies map(items, f).unique.length <= targets.length
}

theorem complete_graph_nat_range_is_k_colorable(n: Nat) {
    is_k_colorable(complete_graph[Nat], nat_range_set(n), n)
}

theorem complete_graph_nat_range_not_k_colorable_below(n: Nat, k: Nat) {
    k < n implies not is_k_colorable(complete_graph[Nat], nat_range_set(n), k)
}

theorem complete_graph_nat_range_chromatic_number(n: Nat) {
    is_chromatic_number(complete_graph[Nat], nat_range_set(n), n)
}

theorem bool_ne_not_self(x: Bool) {
    x != not x
}

theorem cycle_graph_even_suc_parity_ne(n: Nat, x: Nat, y: Nat) {
    not nat_odd(n) and x < n and y < n and x.suc.mod(n) = y
        implies nat_odd(x) != nat_odd(y)
}

theorem cycle_graph_even_adj_parity_ne(n: Nat, x: Nat, y: Nat) {
    not nat_odd(n) and x < n and y < n and cycle_graph(n).adj(x, y)
        implies nat_odd(x) != nat_odd(y)
}

theorem cycle_graph_even_bipartition(n: Nat) {
    not nat_odd(n) implies is_bipartition(cycle_graph(n), nat_range_set(n), nat_odd)
}

theorem cycle_graph_even_is_k_colorable_two(n: Nat) {
    not nat_odd(n) implies is_k_colorable(cycle_graph(n), nat_range_set(n), Nat.2)
}

theorem nat_lt_one_eq_zero(n: Nat) {
    n < Nat.1 implies n = Nat.0
}

theorem not_is_k_colorable_zero[V](g: SimpleGraph[V], s: FiniteSet[V], v: V) {
    s.contains(v) implies not is_k_colorable(g, s, Nat.0)
}

theorem not_is_k_colorable_one_of_adj[V](g: SimpleGraph[V], s: FiniteSet[V], x: V, y: V) {
    s.contains(x) and s.contains(y) and g.adj(x, y) implies not is_k_colorable(g, s, Nat.1)
}

theorem cycle_graph_even_chromatic_number(n: Nat) {
    Nat.3 <= n and not nat_odd(n) implies
        is_chromatic_number(cycle_graph(n), nat_range_set(n), Nat.2)
}

theorem proper_two_color_imp_is_bipartition[V](
    g: SimpleGraph[V], s: FiniteSet[V], color: V -> Nat
) {
    is_proper_coloring_on(g, s, color) and forall(v: V) {
        s.contains(v) implies color(v) < Nat.2
    } implies is_bipartition(g, s, part_of_two_color(color))
}

define nat_inc(v: Nat) -> Nat { v.suc }

theorem nat_inc_eq(v: Nat) {
    nat_inc(v) = v.suc
}

theorem nat_inc_injective {
    is_injective_fn(nat_inc)
}

theorem nat_sub_one_suc(n: Nat) {
    Nat.0 < n implies (n - Nat.1).suc = n
}

theorem nat_two_le_sub_one(n: Nat) {
    Nat.3 <= n implies Nat.2 <= n - Nat.1
}

theorem cycle_graph_walk_range(n: Nat, k: Nat) {
    k < n implies simple_graph_walk(cycle_graph(n), Nat.0, k, map(k.range, nat_inc))
}

theorem cycle_graph_closed_walk_all(n: Nat) {
    Nat.3 <= n implies
        simple_graph_walk(cycle_graph(n), Nat.0, Nat.0,
            map((n - Nat.1).range, nat_inc).append(Nat.0))
}

theorem walk_in_set_of_all_targets_in[V](s: FiniteSet[V], steps: List[V]) {
    (forall(v: V) { steps.contains(v) implies s.contains(v) }) implies walk_in_set(s, steps)
}

theorem cycle_graph_walk_all_in_set(n: Nat) {
    Nat.3 <= n implies
        walk_in_set(nat_range_set(n), map((n - Nat.1).range, nat_inc).append(Nat.0))
}

theorem cycle_graph_odd_closed_walk(n: Nat) {
    Nat.3 <= n and nat_odd(n) implies
        simple_graph_closed_walk(cycle_graph(n), Nat.0,
            map((n - Nat.1).range, nat_inc).append(Nat.0))
}

theorem cycle_graph_odd_not_k_colorable_two(n: Nat) {
    Nat.3 <= n and nat_odd(n) implies not is_k_colorable(cycle_graph(n), nat_range_set(n), Nat.2)
}

define cycle_three_color(n: Nat) -> (Nat -> Nat) {
    function(v: Nat) {
        if v = n - Nat.1 {
            Nat.2
        } else {
            if nat_odd(v) {
                Nat.1
            } else {
                Nat.0
            }
        }
    }
}

theorem cycle_three_color_eq(n: Nat, v: Nat) {
    cycle_three_color(n)(v) = if v = n - Nat.1 {
        Nat.2
    } else {
        if nat_odd(v) {
            Nat.1
        } else {
            Nat.0
        }
    }
}

theorem cycle_three_color_last(n: Nat) {
    cycle_three_color(n)(n - Nat.1) = Nat.2
}

theorem cycle_three_color_parity(n: Nat, v: Nat) {
    v != n - Nat.1 and nat_odd(v) implies cycle_three_color(n)(v) = Nat.1
}

theorem cycle_three_color_even(n: Nat, v: Nat) {
    v != n - Nat.1 and not nat_odd(v) implies cycle_three_color(n)(v) = Nat.0
}

theorem nat_suc_eq_cancel(a: Nat, b: Nat) {
    a.suc = b.suc implies a = b
}

theorem nat_sub_one_ne_zero(n: Nat) {
    Nat.3 <= n implies n - Nat.1 != Nat.0
}

theorem cycle_graph_three_suc_color_ne(n: Nat, x: Nat, y: Nat) {
    Nat.3 <= n and x < n and y < n and x.suc.mod(n) = y
        implies cycle_three_color(n)(x) != cycle_three_color(n)(y)
}

theorem cycle_graph_three_adj_color_ne(n: Nat, x: Nat, y: Nat) {
    Nat.3 <= n and x < n and y < n and cycle_graph(n).adj(x, y)
        implies cycle_three_color(n)(x) != cycle_three_color(n)(y)
}

theorem cycle_three_color_lt_three(n: Nat, v: Nat) {
    Nat.3 <= n implies cycle_three_color(n)(v) < Nat.3
}

theorem cycle_graph_odd_is_k_colorable_three(n: Nat) {
    Nat.3 <= n implies is_k_colorable(cycle_graph(n), nat_range_set(n), Nat.3)
}

theorem nat_lt_three_cases(n: Nat) {
    n < Nat.3 implies n = Nat.0 or n = Nat.1 or n = Nat.2
}

theorem cycle_graph_odd_chromatic_number(n: Nat) {
    Nat.3 <= n and nat_odd(n) implies
        is_chromatic_number(cycle_graph(n), nat_range_set(n), Nat.3)
}

theorem find_first_idx_injective_of_unique[T](list: List[T], x: T, y: T) {
    list.is_unique and list.contains(x) and list.contains(y) and
        list.find_first_idx(x) = list.find_first_idx(y) implies x = y
}

theorem find_first_idx_lt_of_contains[T](list: List[T], item: T) {
    list.contains(item) implies list.find_first_idx(item) < list.length
}

define list_index[V](items: List[V]) -> (V -> Nat) {
    function(v: V) {
        items.find_first_idx(v)
    }
}

theorem list_index_eq[V](items: List[V], v: V) {
    list_index(items)(v) = items.find_first_idx(v)
}

theorem is_k_colorable_of_card[V](g: SimpleGraph[V], s: FiniteSet[V]) {
    is_k_colorable(g, s, fs_card(s))
}

define chromatic_size_pred[V](g: SimpleGraph[V], s: FiniteSet[V]) -> (Nat -> Bool) {
    function(k: Nat) {
        is_k_colorable(g, s, k)
    }
}

theorem chromatic_size_pred_eq[V](g: SimpleGraph[V], s: FiniteSet[V], k: Nat) {
    chromatic_size_pred(g, s)(k) = is_k_colorable(g, s, k)
}

let chromatic_number[V](g: SimpleGraph[V], s: FiniteSet[V]) -> result: Nat satisfy {
    is_min(chromatic_size_pred(g, s), result)
}

theorem chromatic_number_is_chromatic_number[V](g: SimpleGraph[V], s: FiniteSet[V]) {
    is_chromatic_number(g, s, chromatic_number(g, s))
}

theorem complete_graph_chromatic_number_value(n: Nat) {
    chromatic_number(complete_graph[Nat], nat_range_set(n)) = n
}

define is_forest[V](g: SimpleGraph[V], s: FiniteSet[V]) -> Bool {
    is_acyclic(g, s)
}

theorem forest_acyclic[V](g: SimpleGraph[V], s: FiniteSet[V]) {
    is_forest(g, s) implies is_acyclic(g, s)
}

theorem forest_of_acyclic[V](g: SimpleGraph[V], s: FiniteSet[V]) {
    is_acyclic(g, s) implies is_forest(g, s)
}

theorem forest_subset[V](g: SimpleGraph[V], s: FiniteSet[V], t: FiniteSet[V]) {
    is_forest(g, s) and t.subset_eq(s) implies is_forest(g, t)
}

theorem forest_of_card_le_two[V](g: SimpleGraph[V], s: FiniteSet[V]) {
    fs_card(s) <= Nat.2 implies is_forest(g, s)
}

theorem forest_has_edge[V](g: SimpleGraph[V], s: FiniteSet[V]) {
    is_forest(g, s) and is_tree(g, s) and Nat.2 <= fs_card(s) implies
        exists(x: V, y: V) {
            s.contains(x) and s.contains(y) and x != y and g.adj(x, y)
        }
}

define walk_last[V](start: V, steps: List[V]) -> V {
    match steps {
        List.nil[V] { start }
        List.cons(head, tail) { walk_last(head, tail) }
    }
}

define walk_penultimate[V](start: V, steps: List[V]) -> V {
    match steps {
        List.nil[V] { start }
        List.cons(head, tail) {
            match tail {
                List.nil[V] { start }
                List.cons(head2, tail2) { walk_penultimate(head, tail) }
            }
        }
    }
}

define simple_graph_path_in[V](g: SimpleGraph[V], s: FiniteSet[V], start: V, steps: List[V]) -> Bool {
    simple_graph_path(g, start, walk_last(start, steps), steps) and s.contains(start) and
        (forall(x: V) { steps.contains(x) implies s.contains(x) })
}

theorem walk_finish_eq_last[V](g: SimpleGraph[V], a: V, b: V, steps: List[V]) {
    simple_graph_walk(g, a, b, steps) implies b = walk_last(a, steps)
}

theorem walk_last_in[V](start: V, steps: List[V]) {
    walk_last(start, steps) = start or steps.contains(walk_last(start, steps))
}

theorem path_in_walk[V](g: SimpleGraph[V], s: FiniteSet[V], a: V, steps: List[V]) {
    simple_graph_path_in(g, s, a, steps) implies
        simple_graph_walk(g, a, walk_last(a, steps), steps)
}

theorem path_in_path[V](g: SimpleGraph[V], s: FiniteSet[V], a: V, steps: List[V]) {
    simple_graph_path_in(g, s, a, steps) implies
        simple_graph_path(g, a, walk_last(a, steps), steps)
}

theorem path_in_start_in[V](g: SimpleGraph[V], s: FiniteSet[V], a: V, steps: List[V]) {
    simple_graph_path_in(g, s, a, steps) implies s.contains(a)
}

theorem path_in_steps_in[V](g: SimpleGraph[V], s: FiniteSet[V], a: V, steps: List[V], x: V) {
    simple_graph_path_in(g, s, a, steps) implies (steps.contains(x) implies s.contains(x))
}

theorem path_in_vertices_unique[V](g: SimpleGraph[V], s: FiniteSet[V], a: V, steps: List[V]) {
    simple_graph_path_in(g, s, a, steps) implies
        simple_graph_walk_vertices(a, steps).is_unique
}

theorem path_in_endpoint_in[V](g: SimpleGraph[V], s: FiniteSet[V], a: V, steps: List[V]) {
    simple_graph_path_in(g, s, a, steps) implies s.contains(walk_last(a, steps))
}

theorem path_in_intro[V](g: SimpleGraph[V], s: FiniteSet[V], a: V, steps: List[V]) {
    simple_graph_path(g, a, walk_last(a, steps), steps) and s.contains(a) and
        (forall(x: V) { steps.contains(x) implies s.contains(x) })
        implies simple_graph_path_in(g, s, a, steps)
}

theorem walk_penultimate_adj[V](g: SimpleGraph[V], a: V, b: V, steps: List[V]) {
    simple_graph_walk(g, a, b, steps) and Nat.1 <= steps.length implies
        g.adj(walk_penultimate(a, steps), b)
}

theorem walk_penultimate_vertex[V](start: V, steps: List[V]) {
    walk_penultimate(start, steps) = start or steps.contains(walk_penultimate(start, steps))
}

theorem append_unique[T](xs: List[T], u: T) {
    xs.is_unique and not xs.contains(u) implies xs.append(u).is_unique
}

theorem path_in_extend[V](g: SimpleGraph[V], s: FiniteSet[V], a: V, steps: List[V], u: V) {
    simple_graph_path_in(g, s, a, steps) and s.contains(u) and g.adj(walk_last(a, steps), u) and
        u != a and not steps.contains(u)
        implies simple_graph_path_in(g, s, a, steps.append(u))
}

theorem drop_cons[T](h: T, t: List[T], n: Nat) {
    List.cons(h, t).drop(n + Nat.1) = t.drop(n)
}

theorem drop_nil[T](n: Nat) {
    List.nil[T].drop(n) = List.nil[T]
}

theorem sub_suc_suc(a: Nat, b: Nat) {
    b <= a implies (a + Nat.1) - (b + Nat.1) = a - b
}

theorem drop_preserves_unique[T](xs: List[T], n: Nat) {
    xs.is_unique implies xs.drop(n).is_unique
}

theorem drop_contains[T](xs: List[T], n: Nat, y: T) {
    xs.drop(n).contains(y) implies xs.contains(y)
}

define drop_len_plus[T](xs: List[T], n: Nat) -> Nat {
    xs.drop(n).length + n
}

theorem drop_length[T](xs: List[T], n: Nat) {
    n <= xs.length implies xs.length = drop_len_plus(xs, n)
}

theorem get_idx_cons[T](h: T, t: List[T], n: Nat) {
    List.cons(h, t).get_idx(n + Nat.1) = t.get_idx(n)
}

theorem find_first_idx_cons[T](head: T, tail: List[T], item: T) {
    head != item implies List.cons(head, tail).find_first_idx(item) = Nat.1 + tail.find_first_idx(item)
}

theorem find_first_idx_works[T](xs: List[T], item: T) {
    xs.contains(item) implies xs.get_idx(xs.find_first_idx(item)) = Option.some(item)
}

define greedy_guard[V](g: SimpleGraph[V], s: FiniteSet[V], a: V, steps: List[V], u: V) -> Bool {
    s.contains(u) and g.adj(walk_last(a, steps), u) and u != a and not steps.contains(u)
}

define greedy_chosen[V](g: SimpleGraph[V], s: FiniteSet[V], a: V, steps: List[V]) -> V {
    choose_or_default(function(u: V) { greedy_guard(g, s, a, steps, u) }, a)
}

define greedy_path[V](g: SimpleGraph[V], s: FiniteSet[V], a: V, steps: List[V], fuel: Nat) -> List[V] {
    match fuel {
        Nat.zero { steps }
        Nat.suc(f) {
            if exists(u: V) { greedy_guard(g, s, a, steps, u) } {
                greedy_path(g, s, a, steps.append(greedy_chosen(g, s, a, steps)), f)
            } else {
                steps
            }
        }
    }
}

theorem greedy_path_preserves_path[V](g: SimpleGraph[V], s: FiniteSet[V], a: V, steps: List[V], fuel: Nat) {
    simple_graph_path_in(g, s, a, steps) implies
        simple_graph_path_in(g, s, a, greedy_path(g, s, a, steps, fuel))
}

theorem append_length_one[T](xs: List[T], u: T) {
    xs.append(u).length = xs.length + Nat.1
}

theorem greedy_path_length_ge[V](g: SimpleGraph[V], s: FiniteSet[V], a: V, steps: List[V], fuel: Nat) {
    steps.length <= greedy_path(g, s, a, steps, fuel).length
}

theorem unique_list_le_card[T](items: List[T], s: FiniteSet[T]) {
    items.is_unique and (forall(x: T) { items.contains(x) implies s.contains(x) })
        implies items.length <= fs_card(s)
}

theorem path_vertices_le_card[V](g: SimpleGraph[V], s: FiniteSet[V], a: V, steps: List[V]) {
    simple_graph_path_in(g, s, a, steps) implies
        simple_graph_walk_vertices(a, steps).length <= fs_card(s)
}

define greedy_stuck[V](g: SimpleGraph[V], s: FiniteSet[V], a: V, steps: List[V]) -> Bool {
    forall(u: V) {
        s.contains(u) and g.adj(walk_last(a, steps), u) implies (u = a or steps.contains(u))
    }
}

theorem greedy_path_stuck_or_exhausted[V](g: SimpleGraph[V], s: FiniteSet[V], a: V, steps: List[V], fuel: Nat) {
    greedy_stuck(g, s, a, greedy_path(g, s, a, steps, fuel)) or
    (greedy_path(g, s, a, steps, fuel).length = steps.length + fuel)
}

theorem greedy_path_maximal[V](g: SimpleGraph[V], s: FiniteSet[V], a: V, steps: List[V], fuel: Nat) {
    simple_graph_path_in(g, s, a, steps) and fs_card(s) < steps.length + fuel
        implies greedy_stuck(g, s, a, greedy_path(g, s, a, steps, fuel))
}

theorem length_zero_imp_nil[T](xs: List[T]) {
    xs.length = Nat.0 implies xs = List.nil[T]
}

theorem find_first_idx_contains[T](xs: List[T], item: T) {
    xs.contains(item) implies xs.find_first_idx(item) < xs.length
}

theorem penultimate_idx[V](start: V, steps: List[V]) {
    Nat.2 <= steps.length implies
        steps.get_idx(steps.length - Nat.2) = Option.some(walk_penultimate(start, steps))
}

theorem lte_suc_ne_imp_lte(a: Nat, b: Nat) {
    a <= b + Nat.1 and a != b + Nat.1 implies a <= b
}

theorem singleton_length[T](u: T) {
    List.singleton(u).length = Nat.1
}

theorem path_endpoint_leaf_one[V](g: SimpleGraph[V], s: FiniteSet[V], a: V, r: List[V]) {
    simple_graph_path_in(g, s, a, r) and r.length = Nat.1 and greedy_stuck(g, s, a, r)
        implies exists(v: V) { s.contains(v) and is_leaf(g, s, v) }
}

theorem unique_not_contains_drop_suc[T](xs: List[T], w: T) {
    xs.is_unique and xs.contains(w) implies
        not xs.drop(xs.find_first_idx(w) + Nat.1).contains(w)
}

theorem lt_add_cancel_left(a: Nat, b: Nat, c: Nat) {
    a + b < a + c implies b < c
}

theorem walk_suffix_at[V](g: SimpleGraph[V], a: V, b: V, steps: List[V], w: V) {
    (simple_graph_walk(g, a, b, steps) and steps.contains(w) implies
        simple_graph_walk(g, w, b, steps.drop(steps.find_first_idx(w) + Nat.1)))
}

theorem cycle_of_start_edge[V](g: SimpleGraph[V], s: FiniteSet[V], a: V, r: List[V]) {
    simple_graph_path_in(g, s, a, r) and Nat.2 <= r.length and g.adj(walk_last(a, r), a)
        implies simple_graph_cycle(g, walk_last(a, r), simple_graph_walk_vertices(a, r))
}

theorem cycle_of_inner_edge[V](g: SimpleGraph[V], s: FiniteSet[V], a: V, r: List[V], w: V, j: Nat) {
    simple_graph_path_in(g, s, a, r) and s.contains(w) and r.contains(w) and
        j = r.find_first_idx(w) and j + Nat.2 < r.length and g.adj(walk_last(a, r), w)
        implies simple_graph_cycle(g, walk_last(a, r), List.cons(w, r.drop(j + Nat.1)))
}

theorem path_endpoint_leaf_many[V](g: SimpleGraph[V], s: FiniteSet[V], a: V, r: List[V]) {
    simple_graph_path_in(g, s, a, r) and Nat.2 <= r.length and greedy_stuck(g, s, a, r) and is_acyclic(g, s)
        implies exists(v: V) { s.contains(v) and is_leaf(g, s, v) }
}

theorem path_endpoint_leaf[V](g: SimpleGraph[V], s: FiniteSet[V], a: V, r: List[V]) {
    simple_graph_path_in(g, s, a, r) and Nat.1 <= r.length and greedy_stuck(g, s, a, r) and is_acyclic(g, s)
        implies exists(v: V) { s.contains(v) and is_leaf(g, s, v) }
}

theorem forest_has_leaf[V](g: SimpleGraph[V], s: FiniteSet[V]) {
    is_acyclic(g, s) and Nat.1 <= directed_edge_count(g, s) implies
        exists(v: V) { s.contains(v) and is_leaf(g, s, v) }
}

theorem directed_edges_mono[V](g: SimpleGraph[V], s: FiniteSet[V], t: FiniteSet[V]) {
    s.subset_eq(t) implies directed_edges(g, s).subset_eq(directed_edges(g, t))
}

theorem edges_remove_leaf[V](g: SimpleGraph[V], s: FiniteSet[V], v: V) {
    is_leaf(g, s, v) and s.contains(v) implies
        directed_edge_count(g, s) = directed_edge_count(g, fs_remove(s, v)) + Nat.2
}

theorem fs_card_zero_of_no_members[T](s: FiniteSet[T]) {
    (forall(x: T) { not s.contains(x) }) implies fs_card(s) = Nat.0
}

theorem not_one_lte_imp_zero(x: Nat) {
    not (Nat.1 <= x) implies x = Nat.0
}

define forest_edges_bound_at[V](g: SimpleGraph[V], n: Nat) -> Bool {
    forall(s: FiniteSet[V]) {
        fs_card(s) = n implies (is_acyclic(g, s) implies
            directed_edge_count(g, s) <= Nat.2 * fs_card(s) - Nat.2)
    }
}

theorem forest_edges_bound[V](g: SimpleGraph[V], s: FiniteSet[V]) {
    is_acyclic(g, s) implies directed_edge_count(g, s) <= Nat.2 * fs_card(s) - Nat.2
}

theorem reachable_mono_on[V](g: SimpleGraph[V], s: FiniteSet[V], t: FiniteSet[V], x: V, y: V) {
    t.subset_eq(s) and simple_graph_reachable(induced_subgraph(g, t.underlying_set), x, y)
        implies simple_graph_reachable(induced_subgraph(g, s.underlying_set), x, y)
}

theorem fs_card_one_members_eq[T](s: FiniteSet[T]) {
    fs_card(s) = Nat.1 implies (forall(x: T, y: T) { s.contains(x) and s.contains(y) implies x = y })
}

define forest_tree_at[V](g: SimpleGraph[V], n: Nat) -> Bool {
    forall(s: FiniteSet[V]) {
        fs_card(s) = n implies
            ((is_acyclic(g, s) and Nat.1 <= fs_card(s) and
                directed_edge_count(g, s) = Nat.2 * fs_card(s) - Nat.2)
            implies simple_graph_connected_on(g, s))
    }
}

theorem two_mul_sub_two_pos(n: Nat) {
    Nat.2 <= n implies Nat.1 <= Nat.2 * n - Nat.2
}

define forest_tree_shift_at[V](g: SimpleGraph[V], m: Nat) -> Bool {
    forall(s: FiniteSet[V]) {
        fs_card(s) = m + Nat.1 implies
            ((is_acyclic(g, s) and Nat.1 <= fs_card(s) and
                directed_edge_count(g, s) = Nat.2 * fs_card(s) - Nat.2)
            implies simple_graph_connected_on(g, s))
    }
}

theorem forest_tree_of_edge_count[V](g: SimpleGraph[V], s: FiniteSet[V]) {
    is_acyclic(g, s) and Nat.1 <= fs_card(s) and
        directed_edge_count(g, s) = Nat.2 * fs_card(s) - Nat.2
        implies simple_graph_connected_on(g, s)
}

define add_edge_adj[V](g: SimpleGraph[V], x: V, y: V) -> (V -> V -> Bool) {
    function(a: V, b: V) {
        g.adj(a, b) or (((a = x and b = y) or (a = y and b = x)) and a != b)
    }
}

theorem add_edge_adj_symmetric_case[V](g: SimpleGraph[V], x: V, y: V, a: V, b: V) {
    add_edge_adj(g, x, y)(a, b) and not g.adj(a, b) and not (a = x and b = y)
        implies (a = y and b = x)
}

theorem add_edge_adj_symmetric[V](g: SimpleGraph[V], x: V, y: V) {
    is_symmetric(add_edge_adj(g, x, y))
}

theorem add_edge_adj_irreflexive[V](g: SimpleGraph[V], x: V, y: V) {
    is_irreflexive(add_edge_adj(g, x, y))
}

let add_edge_graph[V](g: SimpleGraph[V], x: V, y: V) -> result: SimpleGraph[V] satisfy {
    SimpleGraph.new(add_edge_adj(g, x, y)) = Option.some(result)
}

theorem is_k_colorable_card_bound[V](g: SimpleGraph[V], s: FiniteSet[V]) {
    is_k_colorable(g, s, fs_card(s))
}

theorem chromatic_number_le_card[V](g: SimpleGraph[V], s: FiniteSet[V]) {
    chromatic_number(g, s) <= fs_card(s)
}

theorem is_k_colorable_two_imp_no_odd_cycle[V](g: SimpleGraph[V], s: FiniteSet[V]) {
    is_k_colorable(g, s, Nat.2) implies not has_odd_cycle(g, s)
}

theorem bool_ne_not_left(p: Bool, q: Bool) {
    p != q and not p implies q
}

theorem nonempty_length_pos[T](xs: List[T]) {
    xs != List.nil[T] implies Nat.0 < xs.length
}

theorem not_closed_walk_length_one[V](g: SimpleGraph[V], x: V, steps: List[V]) {
    simple_graph_closed_walk(g, x, steps) implies not (steps.length = Nat.1)
}

theorem walk_targets_contains_finish_of_nonempty[V](
    g: SimpleGraph[V], a: V, b: V, steps: List[V]
) {
    simple_graph_walk(g, a, b, steps) and steps.length > Nat.0 implies steps.contains(b)
}

theorem walk_in_set_contains_member[V](s: FiniteSet[V], steps: List[V], v: V) {
    walk_in_set(s, steps) and steps.contains(v) implies s.contains(v)
}

theorem not_unique_imp_two_occurrences[T](xs: List[T]) {
    not xs.is_unique implies exists(w: T) {
        xs.contains(w) and xs.drop(xs.find_first_idx(w) + Nat.1).contains(w)
    }
}

theorem walk_canonical_split[V](g: SimpleGraph[V], a: V, b: V, c: V, steps: List[V]) {
    simple_graph_walk(g, a, b, steps) and steps.contains(c) implies
        exists(pre: List[V], suf: List[V]) {
            steps = pre + suf and simple_graph_walk(g, a, c, pre) and simple_graph_walk(g, c, b, suf) and
            pre != List.nil[V] and suf = steps.drop(steps.find_first_idx(c) + Nat.1)
        }
}

theorem has_odd_closed_walk_imp_has_odd_cycle[V](g: SimpleGraph[V], s: FiniteSet[V]) {
    has_odd_closed_walk(g, s) implies has_odd_cycle(g, s)
}

theorem is_k_colorable_two_of_no_odd_cycle[V](
    g: SimpleGraph[V], s: FiniteSet[V], r: V
) {
    s.contains(r) and walk_reachable_from(g, s, r) and not has_odd_cycle(g, s)
        implies is_k_colorable(g, s, Nat.2)
}

theorem is_k_colorable_two_eq_no_odd_cycle[V](
    g: SimpleGraph[V], s: FiniteSet[V], r: V
) {
    s.contains(r) and walk_reachable_from(g, s, r) implies
        (is_k_colorable(g, s, Nat.2) = not has_odd_cycle(g, s))
}

theorem induced_walk_imp_base_walk_in_set[V](
    g: SimpleGraph[V], s: FiniteSet[V], a: V, b: V, steps: List[V]
) {
    simple_graph_walk(induced_subgraph(g, s.underlying_set), a, b, steps) implies
        simple_graph_walk(g, a, b, steps) and walk_in_set(s, steps)
}

theorem connected_on_imp_walk_reachable_helper[V](g: SimpleGraph[V], s: FiniteSet[V], r: V) {
    simple_graph_connected_on(g, s) and s.contains(r) implies
        forall(x: V) {
            s.contains(x) implies exists(steps: List[V]) {
                simple_graph_walk(g, r, x, steps) and walk_in_set(s, steps)
            }
        }
}

theorem connected_on_imp_walk_reachable_from[V](g: SimpleGraph[V], s: FiniteSet[V], r: V) {
    simple_graph_connected_on(g, s) and s.contains(r) implies walk_reachable_from(g, s, r)
}

theorem acyclic_imp_no_odd_cycle[V](g: SimpleGraph[V], s: FiniteSet[V]) {
    is_acyclic(g, s) implies not has_odd_cycle(g, s)
}

theorem empty_set_two_colorable[V](g: SimpleGraph[V], s: FiniteSet[V]) {
    (forall(r: V) { not s.contains(r) }) implies is_k_colorable(g, s, Nat.2)
}

theorem tree_is_k_colorable_two[V](g: SimpleGraph[V], s: FiniteSet[V]) {
    is_tree(g, s) implies is_k_colorable(g, s, Nat.2)
}

theorem graph_handshake_lemma[V](g: SimpleGraph[V], s: FiniteSet[V]) {
    degree_sum(g, s) = fs_card(directed_edges_from_set(g, s, s))
}

theorem graph_handshake_directed[V](g: SimpleGraph[V], s: FiniteSet[V]) {
    degree_sum(g, s) = directed_edge_count(g, s)
}

theorem walk_has_path[V](g: SimpleGraph[V], a: V, b: V, steps: List[V]) {
    simple_graph_walk(g, a, b, steps) implies exists(steps2: List[V]) {
        simple_graph_path(g, a, b, steps2)
    }
}

theorem walk_imp_path[V](g: SimpleGraph[V], a: V, b: V) {
    exists(steps: List[V]) { simple_graph_walk(g, a, b, steps) } implies
    exists(steps: List[V]) { simple_graph_path(g, a, b, steps) }
}

define walk_connected[V](g: SimpleGraph[V], x: V, y: V) -> Bool {
    exists(steps: List[V]) {
        simple_graph_walk(g, x, y, steps)
    }
}

theorem walk_connected_refl[V](g: SimpleGraph[V], x: V) {
    walk_connected(g, x, x)
}

theorem walk_connected_symmetric[V](g: SimpleGraph[V], x: V, y: V) {
    walk_connected(g, x, y) implies walk_connected(g, y, x)
}

theorem walk_connected_transitive[V](g: SimpleGraph[V], x: V, y: V, z: V) {
    walk_connected(g, x, y) and walk_connected(g, y, z) implies walk_connected(g, x, z)
}

theorem walk_connected_iff_reachable[V](g: SimpleGraph[V], x: V, y: V) {
    walk_connected(g, x, y) = simple_graph_reachable(g, x, y)
}

theorem walk_connected_eq_reachable[V](g: SimpleGraph[V]) {
    walk_connected(g) = simple_graph_reachable(g)
}

theorem walk_connected_is_equivalence[V](g: SimpleGraph[V]) {
    is_equivalence(walk_connected(g))
}

theorem reachable_is_equivalence[V](g: SimpleGraph[V]) {
    is_equivalence(simple_graph_reachable(g))
}

theorem graph_tree_connected[V](g: SimpleGraph[V], s: FiniteSet[V]) {
    is_tree(g, s) implies simple_graph_connected_on(g, s)
}

theorem graph_tree_acyclic[V](g: SimpleGraph[V], s: FiniteSet[V]) {
    is_tree(g, s) implies is_acyclic(g, s)
}

theorem graph_tree_of_edge_count[V](g: SimpleGraph[V], s: FiniteSet[V]) {
    is_acyclic(g, s) and Nat.1 <= fs_card(s) and
        directed_edge_count(g, s) = Nat.2 * fs_card(s) - Nat.2
        implies simple_graph_connected_on(g, s)
}

theorem graph_forest_edges_bound[V](g: SimpleGraph[V], s: FiniteSet[V]) {
    is_acyclic(g, s) implies directed_edge_count(g, s) <= Nat.2 * fs_card(s) - Nat.2
}

theorem graph_bipartite_no_odd_cycle[V](g: SimpleGraph[V], s: FiniteSet[V]) {
    is_bipartite(g, s) implies not has_odd_cycle(g, s)
}

let six_vertices: FiniteSet[Nat] = range_set(Nat.6)

/// The five vertices `{0, ..., 4}` on which the lower bound lives.

let five_vertices: FiniteSet[Nat] = range_set(Nat.5)

/// The labels of the six vertices are ordered, and each is below the bound.
///
/// Comparisons between numerals are not free, so the ladder is stated once and read off.

theorem six_labels_lt {
    Nat.0 < Nat.1 and Nat.1 < Nat.2 and Nat.2 < Nat.3 and Nat.3 < Nat.4 and Nat.4 < Nat.5
    and Nat.5 < Nat.6
    and Nat.0 < Nat.6 and Nat.1 < Nat.6 and Nat.2 < Nat.6 and Nat.3 < Nat.6 and Nat.4 < Nat.6
}

theorem six_labels_distinct {
    Nat.0 != Nat.1 and Nat.0 != Nat.2 and Nat.0 != Nat.3 and Nat.0 != Nat.4 and Nat.0 != Nat.5
    and Nat.1 != Nat.2 and Nat.1 != Nat.3 and Nat.1 != Nat.4 and Nat.1 != Nat.5
    and Nat.2 != Nat.3 and Nat.2 != Nat.4 and Nat.2 != Nat.5
    and Nat.3 != Nat.4 and Nat.3 != Nat.5
    and Nat.4 != Nat.5
}

theorem six_vertices_contains(x: Nat) {
    x < Nat.6 implies six_vertices.contains(x)
}

theorem five_vertices_contains(x: Nat) {
    x < Nat.5 implies five_vertices.contains(x)
}

theorem six_neighbor_of_zero(x: Nat) {
    six_vertices.contains(x) and x != Nat.0 implies
        neighborhood(complete_graph[Nat], six_vertices, Nat.0).contains(x)
}

define is_edge_2_coloring[V](g: SimpleGraph[V], color: (V, V) -> Bool) -> Bool {
    forall(x: V, y: V) {
        g.adj(x, y) implies color(x, y) = color(y, x)
    }
}

theorem edge_2_coloring_comm[V](g: SimpleGraph[V], color: (V, V) -> Bool, x: V, y: V) {
    is_edge_2_coloring(g, color) and g.adj(x, y) implies color(x, y) = color(y, x)
}

define has_red_triangle[V](color: (V, V) -> Bool, s: FiniteSet[V]) -> Bool {
    exists(x: V, y: V, z: V) {
        s.contains(x) and s.contains(y) and s.contains(z) and x != y and x != z and y != z
        and color(x, y) and color(x, z) and color(y, z)
    }
}

theorem has_red_triangle_intro[V](color: (V, V) -> Bool, s: FiniteSet[V], x: V, y: V, z: V) {
    s.contains(x) and s.contains(y) and s.contains(z) and x != y and x != z and y != z
    and color(x, y) and color(x, z) and color(y, z)
    implies has_red_triangle(color, s)
}

define has_blue_triangle[V](color: (V, V) -> Bool, s: FiniteSet[V]) -> Bool {
    exists(x: V, y: V, z: V) {
        s.contains(x) and s.contains(y) and s.contains(z) and x != y and x != z and y != z
        and not color(x, y) and not color(x, z) and not color(y, z)
    }
}

theorem has_blue_triangle_intro[V](color: (V, V) -> Bool, s: FiniteSet[V], x: V, y: V, z: V) {
    s.contains(x) and s.contains(y) and s.contains(z) and x != y and x != z and y != z
    and not color(x, y) and not color(x, z) and not color(y, z)
    implies has_blue_triangle(color, s)
}

define has_mono_triangle[V](color: (V, V) -> Bool, s: FiniteSet[V]) -> Bool {
    has_red_triangle(color, s) or has_blue_triangle(color, s)
}

define three_edges_from_zero_share_color(color: (Nat, Nat) -> Bool) -> Bool {
    exists(x: Nat, y: Nat, z: Nat) {
        six_vertices.contains(x) and six_vertices.contains(y) and six_vertices.contains(z)
        and x != Nat.0 and y != Nat.0 and z != Nat.0
        and x != y and x != z and y != z
        and color(Nat.0, x) = color(Nat.0, y) and color(Nat.0, y) = color(Nat.0, z)
