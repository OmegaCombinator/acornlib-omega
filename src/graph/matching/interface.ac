define is_diamond_free[V](g: SimpleGraph[V], s: FiniteSet[V]) -> Bool {
    forall(x: V, y: V) {
        (s.contains(x) and s.contains(y) and g.adj(x, y)
            implies not has_nonadjacent_common_neighbors(g, s, x, y))
