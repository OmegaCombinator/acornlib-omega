theorem diamond_pairs[V](g: SimpleGraph[V], a: V, b: V, c: V, d: V) {
    is_diamond_at(g, a, b, c, d) implies
        not g.adj(a, a)
            and g.adj(a, b)
            and g.adj(a, c)
            and g.adj(a, d)
            and g.adj(b, a)
            and not g.adj(b, b)
            and g.adj(b, c)
            and g.adj(b, d)
            and g.adj(c, a)
            and g.adj(c, b)
            and not g.adj(c, c)
            and not g.adj(c, d)
            and g.adj(d, a)
            and g.adj(d, b)
            and not g.adj(d, c)
            and not g.adj(d, d)
