theorem is_diamond_at_intro[V](g: SimpleGraph[V], a: V, b: V, c: V, d: V) {
    g.adj(a, b) and g.adj(a, c) and g.adj(a, d) and g.adj(b, c) and g.adj(b, d)
        and c != d and not g.adj(c, d) implies is_diamond_at(g, a, b, c, d)
