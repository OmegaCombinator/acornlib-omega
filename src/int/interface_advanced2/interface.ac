theorem int_divides_neg(a: Int, b: Int) {
    a.divides(b) implies a.divides(-b)
}

theorem int_divides_add(a: Int, b: Int, c: Int) {
    a.divides(b) and a.divides(c) implies a.divides(b + c)
}

theorem int_divides_sub(a: Int, b: Int, c: Int) {
    a.divides(b) and a.divides(c) implies a.divides(b - c)
