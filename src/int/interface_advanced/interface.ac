/// Interface fragment: integer arithmetic extensions.

define is_coprime(a: Int, b: Int) -> Bool {
    a.gcd(b) = Int.1
}

theorem is_coprime_apply(a: Int, b: Int) {
    is_coprime(a, b) implies a.gcd(b) = Int.1
}

theorem is_coprime_intro(a: Int, b: Int) {
    a.gcd(b) = Int.1 implies is_coprime(a, b)
}

theorem is_coprime_symm(a: Int, b: Int) {
    is_coprime(a, b) implies is_coprime(b, a)
}

theorem is_coprime_one_right(a: Int) {
    is_coprime(a, Int.1)
}

theorem coprime_bezout(a: Int, b: Int) {
    is_coprime(a, b) implies exists(u: Int, v: Int) { u * a + v * b = Int.1 }
}

theorem coprime_of_bezout(a: Int, b: Int, u: Int, v: Int) {
    u * a + v * b = Int.1 implies is_coprime(a, b)
}

theorem divides_of_coprime(a: Int, x: Int, y: Int) {
    a.divides(x * y) and is_coprime(a, y) implies a.divides(x)
}

theorem coprime_mul(a: Int, x: Int, y: Int) {
    is_coprime(a, x) and is_coprime(a, y) implies is_coprime(a, x * y)
}

theorem coprime_pow(a: Int, b: Int, n: Nat) {
    is_coprime(a, b) implies is_coprime(a, b.pow(n))
}

theorem divides_of_coprime_pow(a: Int, x: Int, b: Int, n: Nat) {
    a.divides(x * b.pow(n)) and is_coprime(a, b) implies a.divides(x)
}

theorem int_divides_self(a: Int) {
    a.divides(a)
}

theorem int_one_divides(a: Int) {
    Int.1.divides(a)
}

theorem int_divides_zero(a: Int) {
    a.divides(0)
}

theorem int_neg_divides(a: Int, b: Int) {
    a.divides(b) implies (-a).divides(b)
}

theorem int_divides_neg(a: Int, b: Int) {
    a.divides(b) implies a.divides(-b)
}

theorem int_divides_add(a: Int, b: Int, c: Int) {
    a.divides(b) and a.divides(c) implies a.divides(b + c)
}

theorem int_divides_sub(a: Int, b: Int, c: Int) {
    a.divides(b) and a.divides(c) implies a.divides(b - c)
}

theorem int_divides_mul(a: Int, b: Int, c: Int) {
    a.divides(b) implies a.divides(b * c)
}

attributes Int {
    /// True if this integer and b have no common factor greater than one.
    define coprime(self, b: Int) -> Bool { self.gcd(b) = 1 }
}

theorem int_coprime_comm(a: Int, b: Int) {
    a.coprime(b) implies b.coprime(a)
}

theorem int_coprime_one_left(a: Int) {
    Int.1.coprime(a)
}

theorem int_coprime_one_right(a: Int) {
    a.coprime(Int.1)
}

theorem int_coprime_divides_of_divides_mul(a: Int, b: Int, c: Int) {
    a.coprime(b) and a.divides(b * c) implies a.divides(c)
}

theorem nat_coprime_iff_int_coprime(a: Nat, b: Nat) {
    a.coprime(b) = Int.from_nat(a).coprime(Int.from_nat(b))
}

theorem int_divides_antisymm(a: Int, b: Int) {
    a != 0 and b != 0 and a.divides(b) and b.divides(a) implies abs(a) = abs(b)
}

theorem nat_is_prime_iff_int_is_prime(n: Nat) {
    n.is_prime = is_prime(Int.from_nat(n))
}

theorem int_is_prime_iff_abs_is_prime(a: Int) {
    is_prime(a) = abs(a).is_prime
}

theorem int_divides_add_left_iff(a: Int, b: Int, c: Int) {
    a.divides(b) implies (a.divides(b + c) = a.divides(c))
}

theorem int_divides_add_right_iff(a: Int, b: Int, c: Int) {
    a.divides(c) implies (a.divides(b + c) = a.divides(b))
}

theorem int_divides_add_left_replace_iff(a: Int, b: Int, c: Int, d: Int) {
    a.divides(b) and a.divides(c) implies
        (a.divides(b + d) = a.divides(c + d))
}

theorem int_divides_add_right_replace_iff(a: Int, b: Int, c: Int, d: Int) {
    a.divides(c) and a.divides(d) implies
        (a.divides(b + c) = a.divides(b + d))
}

theorem int_divides_trans(a: Int, b: Int, c: Int) {
    a.divides(b) and b.divides(c) implies a.divides(c)
}

theorem int_neg_divides_iff(a: Int, b: Int) {
    (-a).divides(b) = a.divides(b)
}

theorem int_divides_neg_iff(a: Int, b: Int) {
    a.divides(-b) = a.divides(b)
}

theorem int_neg_divides_neg_iff(a: Int, b: Int) {
    (-a).divides(-b) = a.divides(b)
}

theorem int_divides_iff_abs_divides(a: Int, b: Int) {
    a.divides(b) = abs(a).divides(abs(b))
}

theorem int_divides_abs_right(a: Int, b: Int) {
    a.divides(b) implies a.divides(Int.from_nat(abs(b)))
}

theorem int_self_divides_abs(a: Int) {
    a.divides(Int.from_nat(abs(a)))
}

theorem int_abs_divides_self(a: Int) {
    Int.from_nat(abs(a)).divides(a)
}

theorem int_zero_divides_iff(a: Int) {
    Int.0.divides(a) = (a = Int.0)
}

theorem int_divides_add_cancel_left(a: Int, b: Int, c: Int) {
    a.divides(b) and a.divides(b + c) implies a.divides(c)
}

theorem int_divides_add_cancel_right(a: Int, b: Int, c: Int) {
    a.divides(c) and a.divides(b + c) implies a.divides(b)
}

theorem int_divides_mul_left_factor(a: Int, b: Int, c: Int) {
    a.divides(b) implies a.divides(c * b)
}

theorem int_divides_mul_self_left(a: Int, b: Int) {
    a.divides(a * b)
}

theorem int_divides_mul_self_right(a: Int, b: Int) {
    a.divides(b * a)
}

theorem int_gcd_neg_left(a: Int, b: Int) {
    (-a).gcd(b) = a.gcd(b)
}

theorem int_gcd_neg_right(a: Int, b: Int) {
    a.gcd(-b) = a.gcd(b)
}

theorem int_gcd_neg_neg(a: Int, b: Int) {
    (-a).gcd(-b) = a.gcd(b)
}

theorem int_gcd_divides_abs_left(a: Int, b: Int) {
    a.gcd(b).divides(Int.from_nat(abs(a)))
}

theorem int_gcd_divides_abs_right(a: Int, b: Int) {
    a.gcd(b).divides(Int.from_nat(abs(b)))
}

theorem int_common_divisor_divides_gcd(a: Int, b: Int, d: Int) {
    d.divides(a) and d.divides(b) implies d.divides(a.gcd(b))
}

theorem nat_gcd_self(a: Nat) {
    a.gcd(a) = a
}

theorem int_gcd_zero_left(a: Int) {
    Int.0.gcd(a) = Int.from_nat(abs(a))
}

theorem int_gcd_zero_right(a: Int) {
    a.gcd(Int.0) = Int.from_nat(abs(a))
}

theorem int_gcd_self(a: Int) {
    a.gcd(a) = Int.from_nat(abs(a))
}

theorem nat_lcm_zero_left_for_int_lcm(a: Nat) {
    Nat.0.lcm(a) = Nat.0
}

theorem nat_lcm_zero_right_for_int_lcm(a: Nat) {
    a.lcm(Nat.0) = Nat.0
}

theorem nat_lcm_comm_for_int_lcm(a: Nat, b: Nat) {
    a.lcm(b) = b.lcm(a)
}

theorem nat_lcm_self_for_int_lcm(a: Nat) {
    a.lcm(a) = a
}

theorem nat_lcm_divides_left_for_int_lcm(a: Nat, b: Nat) {
    a.divides(a.lcm(b))
}

theorem nat_lcm_divides_right_for_int_lcm(a: Nat, b: Nat) {
    b.divides(a.lcm(b))
}

theorem nat_coprime_divides_of_divides_mul_for_int_lcm(a: Nat, b: Nat, c: Nat) {
    a.coprime(b) and a.divides(b * c) implies a.divides(c)
}

theorem nat_lcm_divides_of_common_left_zero_for_int_lcm(b: Nat, c: Nat) {
    Nat.0.divides(c) implies Nat.0.lcm(b).divides(c)
}

theorem nat_lcm_divides_of_common_right_zero_for_int_lcm(a: Nat, c: Nat) {
    Nat.0.divides(c) implies a.lcm(Nat.0).divides(c)
}

theorem nat_lcm_divides_of_common_nonzero_for_int_lcm(a: Nat, b: Nat, c: Nat) {
    a != Nat.0 and b != Nat.0 and a.divides(c) and b.divides(c)
        implies a.lcm(b).divides(c)
}

theorem nat_lcm_divides_of_common_for_int_lcm(a: Nat, b: Nat, c: Nat) {
    a.divides(c) and b.divides(c) implies a.lcm(b).divides(c)
}

theorem int_unit_abs_eq_one(u: Int) {
    is_unit(u) implies abs(u) = Nat.1
}

theorem is_unit_abs_eq_one(u: Int) {
    is_unit(u) implies abs(u) = Nat.1
}

theorem is_unit_eq_one_or_neg_one(u: Int) {
    is_unit(u) implies u = 1 or u = -1
}

theorem is_unit_of_eq_one_or_neg_one(u: Int) {
    u = 1 or u = -1 implies is_unit(u)
}

theorem is_unit_iff(u: Int) {
    is_unit(u) = (u = 1 or u = -1)
}
