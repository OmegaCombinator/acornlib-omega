define function_order_lte[X, A: PartialOrder](f: X -> A, g: X -> A) -> Bool {
    forall(x: X) {
        f(x) <= g(x)
    }
}

define function_order_lt[X, A: PartialOrder](f: X -> A, g: X -> A) -> Bool {
    forall(x: X) {
        f(x) < g(x)
    }
}

