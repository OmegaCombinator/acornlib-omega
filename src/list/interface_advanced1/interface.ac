define list_min[T: LinearOrder](head: T, tail: List[T]) -> T {
    match tail {
        List.nil {
            head
        }
        List.cons(next, rest) {
            head.min(list_min(next, rest))
        }
    }
}

theorem list_min_is_lower_bound[T: LinearOrder](head: T, tail: List[T]) {
