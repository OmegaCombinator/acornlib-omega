theorem list_max_contains_bounded_above[T: LinearOrder](head: T, tail: List[T]) {
    lib(order).is_bounded_above(List.cons(head, tail).contains)
}

theorem list_contains_closed_interval_min_max[T: LinearOrder](head: T, tail: List[T], item: T) {
    List.cons(head, tail).contains(item) implies
    closed_interval(list_min(head, tail), list_max(head, tail), item)
}

theorem list_has_interval_bound[T: LinearOrder](head: T, tail: List[T]) {
    exists(lower: T, upper: T) {
        is_interval_bound(List.cons(head, tail), lower, upper)
    }
}

theorem unique_cons_head_not_in_tail[T](head: T, tail: List[T]) {
    List.cons(head, tail).is_unique implies not tail.contains(head)
}

theorem unique_cons_head_fresh[T](head: T, tail: List[T], item: T) {
    List.cons(head, tail).is_unique and tail.contains(item) implies head != item
}

theorem unique_cons_parts[T](head: T, tail: List[T]) {
    List.cons(head, tail).is_unique implies tail.is_unique and not tail.contains(head)
}

theorem pigeonhole_unique_map_in[T, U](items: List[T], f: T -> U) {
    items.is_unique and not map(items, f).is_unique implies
    exists(x: T, y: T) {
        items.contains(x) and items.contains(y) and x != y and f(x) = f(y)
    }
}

theorem locally_injective_map_is_unique[T, U](items: List[T], f: T -> U) {
    items.is_unique and (forall(x: T, y: T) {
        items.contains(x) and items.contains(y) and f(x) = f(y) implies x = y
    }) implies map(items, f).is_unique
}

define list_take[T](items: List[T], n: Nat) -> List[T] {
    match n {
        Nat.zero {
            List.nil[T]
        }
        Nat.suc(pred) {
            match items {
                List.nil {
                    List.nil[T]
                }
                List.cons(head, tail) {
                    List.cons(head, list_take(tail, pred))
                }
            }
        }
    }
}

theorem list_take_zero[T](items: List[T]) {
    list_take(items, Nat.0) = List.nil[T]
}

theorem list_take_nil[T](n: Nat) {
    list_take(List.nil[T], n) = List.nil[T]
}

theorem list_drop_nil[T](n: Nat) {
    List.nil[T].drop(n) = List.nil[T]
}

theorem list_take_cons_suc[T](head: T, tail: List[T], n: Nat) {
    list_take(List.cons(head, tail), n.suc) = List.cons(head, list_take(tail, n))
}

theorem list_drop_cons_suc[T](head: T, tail: List[T], n: Nat) {
    List.cons(head, tail).drop(n.suc) = tail.drop(n)
}

theorem list_take_append_drop[T](items: List[T], n: Nat) {
    list_take(items, n) + items.drop(n) = items
}

theorem list_take_length_at_most[T](items: List[T], n: Nat) {
    list_take(items, n).length <= items.length
}

theorem list_take_contains_imp_contains[T](items: List[T], n: Nat, x: T) {
    list_take(items, n).contains(x) implies items.contains(x)
}

theorem list_drop_length_nil[T](items: List[T]) {
    items.drop(items.length) = List.nil[T]
}

theorem list_take_length[T](items: List[T]) {
    list_take(items, items.length) = items
}

theorem list_range_length(n: Nat) {
    n.range.length = n
}

theorem list_range_contains_iff_lt(n: Nat, x: Nat) {
    n.range.contains(x) = (x < n)
}

theorem list_range_is_unique(n: Nat) {
    n.range.is_unique
}

define shift_range_list(a: Nat, xs: List[Nat]) -> List[Nat] {
    map(xs, function(x: Nat) { a + x })
}

define list_nat_length(xs: List[Nat]) -> Nat {
    xs.length
}

theorem shift_range_list_length(a: Nat, xs: List[Nat]) {
    shift_range_list(a, xs).length = xs.length
}

theorem map_shift_range_list_length(a: Nat, blocks: List[List[Nat]]) {
    map(map(blocks, shift_range_list(a)), list_nat_length) = map(blocks, list_nat_length)
}

define ranges(items: List[Nat]) -> List[List[Nat]] {
    match items {
        List.nil {
            List.nil[List[Nat]]
        }
        List.cons(a, tail) {
            List.cons(a.range, map(ranges(tail), shift_range_list(a)))
        }
    }
}

theorem ranges_length(items: List[Nat]) {
    map(ranges(items), list_nat_length) = items
}

theorem sum_map_add_split[T, A: AddCommMonoid](left: List[T], right: List[T], f: T -> A) {
    sum(map(left + right, f)) = sum(map(left, f)) + sum(map(right, f))
}

theorem sum_map_add_split_comm[T, A: AddCommMonoid](left: List[T], right: List[T], f: T -> A) {
    sum(map(right, f)) + sum(map(left, f)) = sum(map(left + right, f))
}

theorem sum_map_take_drop[T, A: AddCommMonoid](items: List[T], n: Nat, f: T -> A) {
    sum(map(items, f)) = sum(map(list_take(items, n), f)) + sum(map(items.drop(n), f))
}

theorem sum_map_take_drop_comm[T, A: AddCommMonoid](items: List[T], n: Nat, f: T -> A) {
    sum(map(items.drop(n), f)) + sum(map(list_take(items, n), f)) = sum(map(items, f))
}

theorem sum_map_take_length[T, A: AddCommMonoid](items: List[T], f: T -> A) {
    sum(map(list_take(items, items.length), f)) = sum(map(items, f))
}

theorem sum_map_drop_length[T, A: AddCommMonoid](items: List[T], f: T -> A) {
    sum(map(items.drop(items.length), f)) = A.0
}

theorem partial_interval_sum[A: AddCommMonoid](f: Nat -> A, a: Nat, b: Nat) {
    a <= b implies partial(f, b) = partial(f, a) + sum(map(a.until(b), f))
}

theorem partial_interval_sum_comm[A: AddCommMonoid](f: Nat -> A, a: Nat, b: Nat) {
    a <= b implies sum(map(a.until(b), f)) + partial(f, a) = partial(f, b)
}

theorem partial_add_offset_sum[A: AddCommMonoid](f: Nat -> A, a: Nat, k: Nat) {
    partial(f, a + k) = partial(f, a) + sum(map(a.until(a + k), f))
}

theorem partial_add_offset_sum_comm[A: AddCommMonoid](f: Nat -> A, a: Nat, k: Nat) {
    sum(map(a.until(a + k), f)) + partial(f, a) = partial(f, a + k)
}

theorem partial_interval_suc[A: AddCommMonoid](f: Nat -> A, n: Nat) {
    partial(f, n.suc) = partial(f, n) + sum(map(n.until(n.suc), f))
}

theorem partial_range_take_drop_sum[A: AddCommMonoid](f: Nat -> A, n: Nat, k: Nat) {
    partial(f, n) = sum(map(list_take(n.range, k), f)) + sum(map(n.range.drop(k), f))
}

theorem sum_map_take_range_length[A: AddCommMonoid](f: Nat -> A, n: Nat) {
    sum(map(list_take(n.range, n), f)) = partial(f, n)
}

theorem sum_map_drop_range_length[A: AddCommMonoid](f: Nat -> A, n: Nat) {
    sum(map(n.range.drop(n), f)) = A.0
}

theorem reverse_nil[T] {
    reverse(List.nil[T]) = List.nil[T]
}

theorem reverse_singleton[T](item: T) {
    reverse(List.singleton(item)) = List.singleton(item)
}

theorem reverse_cons_eq_append[T](head: T, tail: List[T]) {
    reverse(List.cons(head, tail)) = reverse(tail) + List.singleton(head)
}

theorem reverse_append_item[T](items: List[T], item: T) {
    reverse(items.append(item)) = List.cons(item, reverse(items))
}

theorem reverse_append_singleton[T](items: List[T], item: T) {
    reverse(items + List.singleton(item)) = List.cons(item, reverse(items))
}

theorem reverse_eq_nil_imp_nil[T](items: List[T]) {
    reverse(items) = List.nil[T] implies items = List.nil[T]
}

theorem reverse_nil_of_eq_nil[T](items: List[T]) {
    items = List.nil[T] implies reverse(items) = List.nil[T]
}

theorem reverse_eq_nil_iff[T](items: List[T]) {
    (reverse(items) = List.nil[T]) = (items = List.nil[T])
}

theorem list_drop_contains_imp_contains[T](items: List[T], n: Nat, x: T) {
    items.drop(n).contains(x) implies items.contains(x)
}

theorem list_take_drop_length_add[T](items: List[T], n: Nat) {
    list_take(items, n).length + items.drop(n).length = items.length
}

theorem list_drop_length_at_most[T](items: List[T], n: Nat) {
    items.drop(n).length <= items.length
}

theorem list_take_drop_count_add[T](items: List[T], n: Nat, x: T) {
    list_take(items, n).count(x) + items.drop(n).count(x) = items.count(x)
}

theorem list_take_drop_filter_add[T](items: List[T], n: Nat, pred: T -> Bool) {
    list_take(items, n).filter(pred) + items.drop(n).filter(pred) = items.filter(pred)
}

theorem list_take_filter_contains_imp_filter_contains[T](items: List[T], n: Nat,
    pred: T -> Bool, x: T) {
    list_take(items, n).filter(pred).contains(x) implies items.filter(pred).contains(x)
}

theorem list_drop_filter_contains_imp_filter_contains[T](items: List[T], n: Nat,
    pred: T -> Bool, x: T) {
    items.drop(n).filter(pred).contains(x) implies items.filter(pred).contains(x)
}

theorem list_take_drop_map_add[T, U](items: List[T], n: Nat, f: T -> U) {
    map[T, U](list_take(items, n), f) + map[T, U](items.drop(n), f) = map[T, U](items, f)
}

theorem list_take_drop_sum_add[A: AddCommMonoid](items: List[A], n: Nat) {
    sum[A](list_take(items, n)) + sum[A](items.drop(n)) = sum[A](items)
}

theorem list_take_drop_sum_map_add[T, A: AddCommMonoid](items: List[T], n: Nat,
    f: T -> A) {
    sum[A](map[T, A](list_take(items, n), f)) + sum[A](map[T, A](items.drop(n), f)) =
        sum[A](map[T, A](items, f))
}

theorem list_take_drop_product_mul[A: CommMonoid](items: List[A], n: Nat) {
    product[A](list_take(items, n)) * product[A](items.drop(n)) = product[A](items)
}

theorem list_take_drop_fold_right_monoid_mul[T, A: Monoid](items: List[T], n: Nat,
    f: T -> A) {
    fold_right_monoid[T, A](list_take(items, n), f) *
        fold_right_monoid[T, A](items.drop(n), f) = fold_right_monoid[T, A](items, f)
}
